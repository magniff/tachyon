// Constant folding computes what the machine computes: wrapping at every
// width, x / 0 == 0 and x % 0 == x, MIN / -1 wraps, shift amounts modulo 32
// (types up to 32 bits) or 64, saturating float-to-int conversions, NaN
// comparisons. The folded function must print what -O0 prints.
// EXPECT: wrap: -128 0 65535 -2147483648 0
// EXPECT: div: 0 7 0 -7 -128 0 -9223372036854775808
// EXPECT: shift: 0 2 1 -1 1 2
// EXPECT: conv: 127 -1 -1 0 0 4294967295 18446744073709551611 9223372036854775807
// EXPECT: nan: 0 1 0 0 0 0
// EXPECT: neg: -0 0
// CHECK-OPT: 1
// CHECK: fn folded:
// CHECK-NOT: div
// CHECK-NOT: rem
// CHECK-NOT: shl
// CHECK-NOT: conv
// CHECK: fn main:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn folded() {
    let a: i8 = 127;
    let b: u8 = 255;
    let c: u16 = 0;
    let d: i32 = 2147483647;
    let e: u32 = 4294967295;
    unsafe {
        printf(c"wrap: %d %d %d %d %d\n", (a + 1i8) as i32, (b + 1u8) as i32, (c - 1u16) as i32,
               d + 1, (e + 1) as i32);
    }
    let zero: i32 = 0;
    let seven: i32 = 7;
    let m8: i8 = -128;
    let m64: i64 = -9223372036854775807 - 1;
    unsafe {
        printf(c"div: %d %d %d %d %d %d %ld\n", seven / zero, seven % zero, (seven as u32 / 0u32) as i32,
               0 - seven, (m8 / -1i8) as i32, (m8 % -1i8) as i32, m64 / -1);
    }
    let one: i8 = 1;
    let minus: i16 = -1;
    let x: u32 = 1;
    unsafe {
        printf(c"shift: %d %d %d %d %d %d\n", (one << 8u8) as i32, (one << 33u8) as i32, (x << 32u32) as i32,
               (minus >> 20u8) as i32, (1u64 << 64u64) as i32, (x << 33u32) as i32);
    }
    let big: f64 = 1e10;
    let nan: f64 = 0.0 / 0.0;
    unsafe {
        printf(c"conv: %d %d %d %d %u %u %lu %ld\n", 127.9 as i8 as i32, big as i8 as i32, big as i16 as i32,
               nan as i32, nan as u32, -1.0 as u32, -5.0 as u64, 1e30 as i64);
        printf(c"nan: %d %d %d %d %d %d\n", (nan == nan) as i32, (nan != nan) as i32, (nan < 1.0) as i32,
               (nan >= 1.0) as i32, (1.0 > nan) as i32, (nan <= nan) as i32);
    }
    let z: f64 = 0.0;
    unsafe { printf(c"neg: %g %g\n", -z, z); }
}

fn main() -> i32 {
    folded();
    0
}
