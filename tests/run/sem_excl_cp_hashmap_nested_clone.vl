// XFAIL: OVERSTRICT HashMap<K, Vec<T>>::get_mut does not instantiate (std's p[0..1] on *V indexes the Vec)
// EXPECT: 1 2
fn main(gpa: Gpa) {
    var a: HashMap<i64, Vec<i64>> = HashMap::new_in(gpa); var e: Vec<i64> = Vec::new_in(gpa);
    e.push(1); a.insert(1, e); var b = a.clone();
    match b.get_mut(1) { Some(v) => { v[0].push(2); } None => {} } println(
        f"{a.get(1).unwrap().len()} {b.get(1).unwrap().len()}");
}
