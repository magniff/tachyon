// one generic with two closure instances: a sink one owning an R and one borrowing it
// FLAGS: --check-alloc
// EXPECT: 1
// EXPECT: drop 2
// EXPECT: 2
// EXPECT: 1
// EXPECT: drop 1
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn call<F: FnMut() -> i64>(f: sink F) -> i64 { f() }

fn main() {
    let a = R { id: 1 };
    let b = R { id: 2 };
    println(f"{call(|| a.id)}");
    println(f"{call(sink || b.id)}");
    println(f"{a.id}");
}
