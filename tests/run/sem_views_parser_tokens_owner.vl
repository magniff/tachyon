// (0.25 semantics audit, views) The guide's parser (guide views): its
// tokens view the input, and `name` (views(*self)) returns a token's text,
// a view of the input. Growing the input while that text is used is
// own.conflict. The element read `self.toks[self.pos]` drops what the
// token views, so it is accepted: a use after free.
// XFAIL: SOUNDNESS the guide's parser: a token's text read through self.toks[i] loses its origin
// ERROR: error[own.conflict]
struct Tok { text: [u8], kind: i64 }
struct Parser { toks: Vec<Tok>, pos: i64 }
impl Parser {
    fn name(inout self) -> [u8] {
        let t = self.toks[self.pos];
        self.pos += 1;
        t.text
    }
}
fn main(gpa: Gpa) {
    var src = Buf::new_in(gpa);
    src.push_str("let x");
    var p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: src.as_slice()[0..3], kind: 0 });
    let a = p.name();
    src.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(a);
}
