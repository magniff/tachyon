// (0.25) the scope's body changes a variable a thread borrows (sync.scope_write),
// and, when a thread borrows a view, any variable (what it views is not known
// to the check)
use std::thread;

// ERROR: [sync.scope_write]: the closure given to 'thread::scope' changes 'n'
// ERROR: [sync.scope_write]: the closure given to 'thread::scope' changes 'v'
// ERROR: [sync.scope_write]: the closure given to 'thread::scope' changes 'w'
fn main(gpa: Gpa) {
    var n = 0;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var w: Vec<i64> = Vec::new_in(gpa);
    w.push(1);
    thread::scope(|sc| { sc.spawn(|| n + 1); n += 1; 0 });
    thread::scope(|sc| { sc.spawn(|| v[0]); v.push(2); 0 });
    let s = w.as_slice();
    thread::scope(|sc| { sc.spawn(|| s[0]); w.push(2); 0 });
}
