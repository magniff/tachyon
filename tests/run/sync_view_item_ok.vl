// (0.25) owned items cross a channel and live in a Mutex; scoped threads
// still borrow views of data that outlives the scope; a lock's closure
// returns plain values and owned copies
use std::thread;
use std::sync::{Mutex, mpsc};

// EXPECT: 6 3 2 abc
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 1..4 { v.push(i); }
    let (tx, rx) = mpsc::channel_in::<Vec<i64>>(gpa);
    tx.send(v.as_slice().to_vec_in(gpa)).unwrap();
    let got = rx.recv().unwrap();
    let s = v.as_slice();
    let total = thread::scope(|sc| { let h = sc.spawn(|| s[0] + s[1] + s[2]); h.join() });
    let m = Mutex::new(got);
    let n = m.with(|d| d.len());
    let c = m.with(|d| d.as_slice().to_vec_in(gpa));
    let t = Mutex::new("abc".to_string_in(gpa));
    let txt = t.with(|x| x.clone());
    println(f"{total} {n} {c[1]} {txt}");
}
