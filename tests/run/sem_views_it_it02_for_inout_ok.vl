// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: [2, 3]
// XFAIL: OVERSTRICT for inout x in &v (D-T3c) is a parser error naming 'inout' as a keyword
// EXPECT: [2, 3]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    for inout x in &v { x += 1; }
    println(f"{v:?}");
    0
}
