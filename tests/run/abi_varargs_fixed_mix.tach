// Variadic calls beyond printf's single fixed argument: snprintf has three
// fixed arguments, a call may pass no variadic arguments at all, and more
// than eight narrow (i32) variadic values must each take a full 8-byte slot
// where the platform passes variadic arguments on the stack (Apple arm64).
// EXPECT: -42-ab-2.500 12
// EXPECT: no variadic arguments
// EXPECT: -3 -2 -1 0 1 2 3 4 5 6 7 8
// EXPECT: -9000000000 4000000000 -1.5 -8999999999 4000000001 -3.0
// EXPECT: [0:0.0][1:0.5][2:1.0]
extern fn printf(format: *u8, ...) -> i32;
extern fn snprintf(buf: *u8, n: u64, format: *u8, ...) -> i32;
extern fn malloc(n: u64) -> *u8;

fn main() -> i64 {
    let buf = malloc(64);
    let n = snprintf(buf, 64, "%d-%s-%.3f".0, 0 - 42, "ab".0, 2.5);
    printf("%s %d\n".0, buf, n);
    printf("no variadic arguments\n".0);
    let a: i32 = 0 - 3;
    printf("%d %d %d %d %d %d %d %d %d %d %d %d\n".0, a, a + 1, a + 2, a + 3, a + 4, a + 5, a + 6, a + 7, a + 8, a + 9, a + 10, a + 11);
    let big: i64 = 0 - 9000000000;
    let u: u32 = 4000000000;
    let f: f32 = 0.0 - 1.5;
    printf("%lld %u %.1f %lld %u %.1f\n".0, big, u, f, big + 1, u + 1, f * 2.0);
    let i: i32 = 0;
    loop {
        if i == 3 { break; };
        printf("[%d:%.1f]".0, i, i as f64 * 0.5);
        i += 1;
    }
    printf("\n".0);
    0
}
