// 0.17: `.len()` on a slice and an array, as on Vec, Buf and HashMap;
// the field `.len` of a slice stays.
// EXPECT: 3 3 4 2 5 5
const KEYWORDS: [i64; 4] = [1, 2, 3, 4];

struct Row { cells: [i64; 5] }

fn count(s: [i64]) -> i64 { s.len() }

fn main() -> i32 {
    let s = "abc";
    let a = [7, 8];
    let r = Row { cells: [0; 5] };
    println(f"{s.len()} {s.len} {KEYWORDS.len()} {a.len()} {r.cells.len()} {count(r.cells[..])}");
    0
}
