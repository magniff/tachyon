// 0.10: many vectors live across calls: spilled to 16-byte slots (and
// on AArch64 never kept in d8-d15, whose upper halves calls do not keep).
// EXPECT: 3346355.0745391846 47404
// EXPECT: 3673510.9180512428 55440
// EXPECT: 4012891.4682769775 60764
// EXPECT: 4364496.7252163887 65096
// EXPECT: 4728326.6888694763 67276
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn noise(x: f64) -> f64 {
    let mut t = x;
    for i in 0..10 {
        t = t * 1.5 + i as f64;
    }
    t
}

#[inline(never)]
fn work(seed: f64) -> f64 {
    let v0 = v2f64(0.0 + seed, 0.5 * seed);
    let v1 = v2f64(1.0 + seed, 1.5 * seed);
    let v2 = v2f64(2.0 + seed, 2.5 * seed);
    let v3 = v2f64(3.0 + seed, 3.5 * seed);
    let v4 = v2f64(4.0 + seed, 4.5 * seed);
    let v5 = v2f64(5.0 + seed, 5.5 * seed);
    let v6 = v2f64(6.0 + seed, 6.5 * seed);
    let v7 = v2f64(7.0 + seed, 7.5 * seed);
    let v8 = v2f64(8.0 + seed, 8.5 * seed);
    let v9 = v2f64(9.0 + seed, 9.5 * seed);
    let v10 = v2f64(10.0 + seed, 10.5 * seed);
    let v11 = v2f64(11.0 + seed, 11.5 * seed);
    let v12 = v2f64(12.0 + seed, 12.5 * seed);
    let v13 = v2f64(13.0 + seed, 13.5 * seed);
    let v14 = v2f64(14.0 + seed, 14.5 * seed);
    let v15 = v2f64(15.0 + seed, 15.5 * seed);
    let v16 = v2f64(16.0 + seed, 16.5 * seed);
    let v17 = v2f64(17.0 + seed, 17.5 * seed);
    let v18 = v2f64(18.0 + seed, 18.5 * seed);
    let v19 = v2f64(19.0 + seed, 19.5 * seed);
    let v20 = v2f64(20.0 + seed, 20.5 * seed);
    let v21 = v2f64(21.0 + seed, 21.5 * seed);
    let v22 = v2f64(22.0 + seed, 22.5 * seed);
    let v23 = v2f64(23.0 + seed, 23.5 * seed);
    let z = noise(seed);
    let w0 = v0 * v2f64::splat(z) + v1;
    let w1 = v1 * v2f64::splat(z) + v2;
    let w2 = v2 * v2f64::splat(z) + v3;
    let w3 = v3 * v2f64::splat(z) + v4;
    let w4 = v4 * v2f64::splat(z) + v5;
    let w5 = v5 * v2f64::splat(z) + v6;
    let w6 = v6 * v2f64::splat(z) + v7;
    let w7 = v7 * v2f64::splat(z) + v8;
    let w8 = v8 * v2f64::splat(z) + v9;
    let w9 = v9 * v2f64::splat(z) + v10;
    let w10 = v10 * v2f64::splat(z) + v11;
    let w11 = v11 * v2f64::splat(z) + v12;
    let w12 = v12 * v2f64::splat(z) + v13;
    let w13 = v13 * v2f64::splat(z) + v14;
    let w14 = v14 * v2f64::splat(z) + v15;
    let w15 = v15 * v2f64::splat(z) + v16;
    let w16 = v16 * v2f64::splat(z) + v17;
    let w17 = v17 * v2f64::splat(z) + v18;
    let w18 = v18 * v2f64::splat(z) + v19;
    let w19 = v19 * v2f64::splat(z) + v20;
    let w20 = v20 * v2f64::splat(z) + v21;
    let w21 = v21 * v2f64::splat(z) + v22;
    let w22 = v22 * v2f64::splat(z) + v23;
    let w23 = v23 * v2f64::splat(z) + v0;
    let mut acc = v2f64::splat(0.0);
    acc = acc + w0 - v0;
    acc = acc + w1 - v1;
    acc = acc + w2 - v2;
    acc = acc + w3 - v3;
    acc = acc + w4 - v4;
    acc = acc + w5 - v5;
    acc = acc + w6 - v6;
    acc = acc + w7 - v7;
    acc = acc + w8 - v8;
    acc = acc + w9 - v9;
    acc = acc + w10 - v10;
    acc = acc + w11 - v11;
    acc = acc + w12 - v12;
    acc = acc + w13 - v13;
    acc = acc + w14 - v14;
    acc = acc + w15 - v15;
    acc = acc + w16 - v16;
    acc = acc + w17 - v17;
    acc = acc + w18 - v18;
    acc = acc + w19 - v19;
    acc = acc + w20 - v20;
    acc = acc + w21 - v21;
    acc = acc + w22 - v22;
    acc = acc + w23 - v23;
    let q = noise(acc.lane(0));
    acc.sum() + q
}

#[inline(never)]
fn iwork(seed: i32) -> i32 {
    let v0 = v4i32(0 + seed, 0 * seed, seed - 0, 0);
    let v1 = v4i32(1 + seed, 1 * seed, seed - 1, 1);
    let v2 = v4i32(2 + seed, 2 * seed, seed - 2, 2);
    let v3 = v4i32(3 + seed, 3 * seed, seed - 3, 3);
    let v4 = v4i32(4 + seed, 4 * seed, seed - 4, 4);
    let v5 = v4i32(5 + seed, 5 * seed, seed - 5, 5);
    let v6 = v4i32(6 + seed, 6 * seed, seed - 6, 6);
    let v7 = v4i32(7 + seed, 7 * seed, seed - 7, 7);
    let v8 = v4i32(8 + seed, 8 * seed, seed - 8, 8);
    let v9 = v4i32(9 + seed, 9 * seed, seed - 9, 9);
    let v10 = v4i32(10 + seed, 10 * seed, seed - 10, 10);
    let v11 = v4i32(11 + seed, 11 * seed, seed - 11, 11);
    let v12 = v4i32(12 + seed, 12 * seed, seed - 12, 12);
    let v13 = v4i32(13 + seed, 13 * seed, seed - 13, 13);
    let v14 = v4i32(14 + seed, 14 * seed, seed - 14, 14);
    let v15 = v4i32(15 + seed, 15 * seed, seed - 15, 15);
    let v16 = v4i32(16 + seed, 16 * seed, seed - 16, 16);
    let v17 = v4i32(17 + seed, 17 * seed, seed - 17, 17);
    let v18 = v4i32(18 + seed, 18 * seed, seed - 18, 18);
    let v19 = v4i32(19 + seed, 19 * seed, seed - 19, 19);
    let v20 = v4i32(20 + seed, 20 * seed, seed - 20, 20);
    let v21 = v4i32(21 + seed, 21 * seed, seed - 21, 21);
    let v22 = v4i32(22 + seed, 22 * seed, seed - 22, 22);
    let v23 = v4i32(23 + seed, 23 * seed, seed - 23, 23);
    let z = noise(seed as f64) as i32;
    let w0 = v0 * v4i32::splat(z) ^ v1;
    let w1 = v1 * v4i32::splat(z) ^ v2;
    let w2 = v2 * v4i32::splat(z) ^ v3;
    let w3 = v3 * v4i32::splat(z) ^ v4;
    let w4 = v4 * v4i32::splat(z) ^ v5;
    let w5 = v5 * v4i32::splat(z) ^ v6;
    let w6 = v6 * v4i32::splat(z) ^ v7;
    let w7 = v7 * v4i32::splat(z) ^ v8;
    let w8 = v8 * v4i32::splat(z) ^ v9;
    let w9 = v9 * v4i32::splat(z) ^ v10;
    let w10 = v10 * v4i32::splat(z) ^ v11;
    let w11 = v11 * v4i32::splat(z) ^ v12;
    let w12 = v12 * v4i32::splat(z) ^ v13;
    let w13 = v13 * v4i32::splat(z) ^ v14;
    let w14 = v14 * v4i32::splat(z) ^ v15;
    let w15 = v15 * v4i32::splat(z) ^ v16;
    let w16 = v16 * v4i32::splat(z) ^ v17;
    let w17 = v17 * v4i32::splat(z) ^ v18;
    let w18 = v18 * v4i32::splat(z) ^ v19;
    let w19 = v19 * v4i32::splat(z) ^ v20;
    let w20 = v20 * v4i32::splat(z) ^ v21;
    let w21 = v21 * v4i32::splat(z) ^ v22;
    let w22 = v22 * v4i32::splat(z) ^ v23;
    let w23 = v23 * v4i32::splat(z) ^ v0;
    let mut acc = v4i32::splat(0);
    acc = acc + (w0 & v0);
    acc = acc + (w1 & v1);
    acc = acc + (w2 & v2);
    acc = acc + (w3 & v3);
    acc = acc + (w4 & v4);
    acc = acc + (w5 & v5);
    acc = acc + (w6 & v6);
    acc = acc + (w7 & v7);
    acc = acc + (w8 & v8);
    acc = acc + (w9 & v9);
    acc = acc + (w10 & v10);
    acc = acc + (w11 & v11);
    acc = acc + (w12 & v12);
    acc = acc + (w13 & v13);
    acc = acc + (w14 & v14);
    acc = acc + (w15 & v15);
    acc = acc + (w16 & v16);
    acc = acc + (w17 & v17);
    acc = acc + (w18 & v18);
    acc = acc + (w19 & v19);
    acc = acc + (w20 & v20);
    acc = acc + (w21 & v21);
    acc = acc + (w22 & v22);
    acc = acc + (w23 & v23);
    acc.sum()
}

fn main() -> i32 {
    for s in 0..5 {
        unsafe { printf(c"%.17g %d\n", work(s as f64 * 0.25), iwork(s as i32)); }
    }
    0
}
