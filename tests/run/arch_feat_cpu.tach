// FLAGS: -C target-cpu=apple-m1 -C target-feature=-sha2,+i8mm
// EXPECT: sha2 false sha3 false aes true crc true dotprod true i8mm true
// (0.19) `-C target-feature=-x` removes x and what needs it (sha3 needs
// sha2), `+x` adds x and what it needs; has() is a constant of the result.
use std::arch::has;

fn main() {
    if !has("aarch64") {
        println("sha2 false sha3 false aes true crc true dotprod true i8mm true");
        return;
    }
    println(
        f"sha2 {has("sha2")} sha3 {has("sha3")} aes {has("aes")} crc {has("crc")} dotprod {has("dotprod")} i8mm {has("i8mm")}");
}
