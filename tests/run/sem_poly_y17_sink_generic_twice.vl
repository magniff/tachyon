// passing the same owned value to a sink T twice: own.moved per instance; i64 copies
// ERROR: [own.moved]: 'v' is used here after it moved into 'take(sink x)'
fn take<T>(x: sink T) -> i64 { 1 }

fn main(gpa: Gpa) {
    let n = 1;
    println(f"{take(n) + take(n)}");
    var v: Vec<i64> = Vec::new_in(gpa);
    println(f"{take(v) + take(v)}");
}
