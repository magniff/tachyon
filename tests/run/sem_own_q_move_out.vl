// (0.25) `v.last()?` is a borrowed copy, as `v.last().unwrap()`: moving it
// (into a sink parameter) is own.move_out; reading a field of it is fine.
// ERROR: it is a copy of an element 'v.last()'
struct T { id: i64, w: Vec<i64> }
fn take(t: sink T) -> i64 { t.id }
fn read(v: Vec<T>) -> Option<i64> { Some(v.last()?.id) }
fn keep(v: Vec<T>) -> Option<i64> { Some(take(v.last()?)) }
fn main() -> i32 { 0 }
