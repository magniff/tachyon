// Eq's eq is #[pure]: an impl that reads a static var is rejected.
// ERROR: 'V::eq' implements 'Eq::eq', which is #[pure], but it uses a static (global)
static var CALLS: i64 = 0;
struct V { n: i64 }

impl Eq for V {
    fn eq(self, o: V) -> bool { CALLS += 1; self.n == o.n }
}

fn main() -> i32 {
    println(V { n: 1 } == V { n: 2 });
    0
}
