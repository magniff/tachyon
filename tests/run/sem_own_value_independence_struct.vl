// sem-own: `var b = a.clone()` of a struct with a Vec; and `var b = a` of a plain struct: independent copies.
// EXPECT: 1 2
// EXPECT: 0 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct Pt { x: i64, y: i64 }
#[derive(Clone)]
struct H { v: Vec<i64> }

fn main(gpa: Gpa) {
    var p = Pt { x: 1, y: 1 };
    var q = p;
    q.y = 2;
    println(f"{p.y} {q.y}");
    let h = H { v: Vec::new_in(gpa) };
    var k = h.clone();
    k.v.push(1);
    println(f"{h.v.len()} {k.v.len()}");
}
