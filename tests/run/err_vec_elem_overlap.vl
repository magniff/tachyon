// (0.25) `&v[i]` of a Vec is an exclusive loan of an element: next to v
// passed let, as a slice, or as the receiver, it conflicts (-O2 assumed
// them apart), as `&a[0]` next to `a[..]` of an array does.
struct P { x: i64 }
fn f(a: inout i64, v: [i64]) -> i64 { let before = v[0]; a = 5; before * 100 + v[0] }
fn g(a: inout i64, v: Vec<i64>) -> i64 { let before = v[0]; a = 5; before * 100 + v[0] }
fn h(a: inout i64, v: [P]) -> i64 { let before = v[0].x; a = 5; before * 100 + v[0].x }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(f"{f(&v[0], v)}");
    println(f"{g(&v[0], v)}");
    println(f"{f(&v[0], v.as_slice())}");
    var ps: Vec<P> = Vec::new_in(gpa);
    ps.push(P { x: 1 });
    println(f"{h(&ps[0].x, ps)}");
}
// ERROR: own.conflict
