// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of static G, then a call that writes G
// ERROR: error[own.static]
static var G: [i64; 4] = [1, 2, 3, 4];
fn bump() { G[0] = 9; }

fn main() -> i32 {
    let s = G[0..1];
    bump();
    println(s[0]);
    0
}
