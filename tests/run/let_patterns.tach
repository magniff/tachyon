// let patterns: `_`, (nested) tuple destructuring and `mut` bindings.
// EXPECT: 9 2 1 2.5 30 107 8 7 5
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn divmod(a: i64, b: i64) -> (i64, i64) {
    (a / b, a % b)
}

fn main() -> i64 {
    let (q, r) = divmod(47, 5);
    let ((a, b), mut c, _) = ((1, 2.5), 3, 99);
    c *= 10;
    let _ = divmod(1, 1);
    let t = (7, 8);
    let (mut x, y) = t;
    x += 100;
    let (one,) = (5,);
    unsafe { printf(c"%ld %ld %ld %.1f %ld %ld %ld %ld %ld\n", q, r, a, b, c, x, y, t.0, one); }
    0
}
