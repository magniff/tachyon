// the closure capturing n inout and &n passed to the same call
// ERROR: [own.conflict]: 'n' has an inout access, '|| { n += 1; }', and another one, '&n', in the same call
fn run<F: FnMut()>(f: sink F, k: inout i64) { f(); k += 100; f(); }

fn main() {
    var n = 0;
    run(|| { n += 1; }, &n);
    println(f"{n}");
}
