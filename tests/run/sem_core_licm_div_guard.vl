// A guarded division by an invariant: defined anyway (x / 0 == 0).
// FLAGS: -O2
// EXPECT: 5
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    var t = 0;
    var k = 0;
    let d = Z;
    while k < 5 + Z { if d != 0 { t += 100 / d; } else { t += 1; } k += 1; }
    println(t);
    0
}
