// a sink closure moving its capture out on one call only: the R dropped once, by the move or the closure's drop
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: 1
// EXPECT: drop 2
// EXPECT: 0
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn eat(r: sink R) -> i64 { r.id }
fn run<F: FnMut(bool) -> i64>(f: sink F, k: bool) -> i64 { f(false) + f(k) }

fn main() {
    let a = R { id: 1 };
    let b = R { id: 2 };
    println(f"{run(sink |m: bool| if m { eat(a) } else { 0 }, true)}");
    println(f"{run(sink |m: bool| if m { eat(b) } else { 0 }, false)}");
    println("end");
}
