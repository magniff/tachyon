// a closure given to a user generic function stores a captured view into a captured Vec
// ERROR: [own.escape]: 'out' is used here, but 'v', which it views, was dropped
fn twice<F: FnMut(i64)>(f: F) { var g = f; g(1); g(2); }

fn main(gpa: Gpa) {
    var out: Vec<[i64]> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(7);
        let s = v.as_slice();
        twice(|i: i64| out.push(s));
    }
    println(f"{out[0][0]}");
}
