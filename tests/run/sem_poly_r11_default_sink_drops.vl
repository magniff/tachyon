// a default sink-self method calling let and inout methods, the value dropped once inside it
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: 200
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

trait C {
    fn get(self) -> i64;
    fn bump(inout self);
    fn finish(sink self) -> i64 { self.bump(); self.get() * 100 }
}

impl C for R {
    fn get(self) -> i64 { self.id }
    fn bump(inout self) { self.id += 1; }
}

fn main() {
    let r = R { id: 1 };
    println(f"{r.finish()}");
    println("end");
}
