// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a Vec<G> declared first holding views of a later Vec
// ERROR: error[own.drop_view]
struct G { s: [i64] }
impl Drop for G { fn drop(inout self) { println(self.s[0]); } }

fn main(gpa: Gpa) -> i32 {
    var keep: Vec<G> = Vec::new_in(gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    keep.push(G { s: v.as_slice() });
    println(keep.len());
    0
}
