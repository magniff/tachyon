// EXPECT: first 3
// EXPECT: next 3 4
// EXPECT: count 4
// EXPECT: sum 18
// EXPECT: max 6 min 3
// EXPECT: empty
// EXPECT: generic count 4 sum 18
// EXPECT: words 3
// 0.14: associated types. A user iterator (`impl Iterator for Counter`,
// `type Item = i64;`), `I::Item` in a generic signature, the trait's
// default `count`/`sum`/`max`/`min` on it, and an `Item = [u8]` iterator
// whose `sum` (which needs `0 as [u8]`) is never used, so never checked.
use std::print_int;

struct Counter { n: i64, end: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(self: *Counter) -> Option<i64> {
        if self.n < self.end {
            let v = self.n;
            self.n += 1;
            Some(v)
        } else {
            None
        }
    }
}

fn first<I: Iterator>(it: I) -> Option<I::Item> {
    let mut it = it;
    it.next()
}

// The items' type through the parameter: `I::Item` in the body too.
fn total<I: Iterator>(it: I) -> I::Item {
    let mut it = it;
    let mut s: I::Item = 0;
    while let Some(x) = it.next() {
        s += x;
    }
    s
}

struct Words { text: [u8], pos: i64 }

impl Iterator for Words {
    type Item = [u8];

    fn next(self: *Words) -> Option<[u8]> {
        let s = self.text;
        while self.pos < s.len && s[self.pos] == ' ' {
            self.pos += 1;
        }
        if self.pos == s.len {
            return None;
        }
        let start = self.pos;
        while self.pos < s.len && s[self.pos] != ' ' {
            self.pos += 1;
        }
        Some(s[start..self.pos])
    }
}

fn main() -> i32 {
    match first(Counter { n: 3, end: 7 }) {
        Some(x) => {
            print("first ");
            print_int(x);
            println("");
        }
        None => println("none"),
    }
    let mut c = Counter { n: 3, end: 7 };
    let a = c.next().unwrap();
    let b = c.next().unwrap();
    print("next ");
    print_int(a);
    print(" ");
    print_int(b);
    println("");
    print("count ");
    print_int(Counter { n: 3, end: 7 }.count());
    println("");
    print("sum ");
    print_int(Counter { n: 3, end: 7 }.sum());
    println("");
    print("max ");
    print_int(Counter { n: 3, end: 7 }.max().unwrap());
    print(" min ");
    print_int(Counter { n: 3, end: 7 }.min().unwrap());
    println("");
    match first(Counter { n: 7, end: 7 }) {
        Some(_) => println("not empty"),
        None => println("empty"),
    }
    print("generic count ");
    print_int(Counter { n: 3, end: 7 }.count());
    print(" sum ");
    print_int(total(Counter { n: 3, end: 7 }));
    println("");
    print("words ");
    print_int(Words { text: "  one two  three ", pos: 0 }.count());
    println("");
    0
}
