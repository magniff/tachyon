// sem-own: `?` on Err returns early: the locals declared before it dropped, in reverse order; the ones after never made.
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: r -1
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: r 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn f(ok: bool, gpa: Gpa) -> Result<i64, i64> {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    let r: Result<i64, i64> = if ok { Ok(3) } else { Err(-1) };
    let n = r?;
    let c = mk(n, gpa);
    Ok(c.id)
}

fn main(gpa: Gpa) {
    println(f"r {match f(false, gpa) { Ok(x) => x, Err(e) => e }}");
    println(f"r {match f(true, gpa) { Ok(x) => x, Err(e) => e }}");
}
