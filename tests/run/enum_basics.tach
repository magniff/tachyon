// Enums: fieldless (with discriminants and casts) and with fields.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

enum Color { Red, Green, Blue }
enum Code { Ok = 200, NotFound = 404, Teapot = 418, Low = -3 }
enum Shape { Circle(f64), Rect(f64, f64), Empty }
enum Small { A(u8), B(u8, u8), C }

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.0 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => 0.0,
    }
}

fn name(c: Color) -> *u8 {
    match c {
        Color::Red => c"red",
        Color::Green => c"green",
        Color::Blue => c"blue",
    }
}

static DEFAULT: Color = Color::Green;
static UNIT: Shape = Shape::Rect(1.0, 2.5);

fn main() {
    let c = Color::Blue;
    printf(c"%s %s %s\n", name(Color::Red), name(c), name(DEFAULT));
    printf(c"%d %d %d %d\n", Color::Red as i32, Color::Blue as i32, Code::Teapot as i32, Code::Low as i64);
    printf(c"%d %d\n", (c == Color::Blue) as i32, (c != Color::Blue) as i32);
    let shapes: [Shape; 4] = [Shape::Circle(2.0), Shape::Rect(3.0, 4.0), Shape::Empty, UNIT];
    let mut total = 0.0;
    for i in 0..4 {
        let a = area(shapes[i]);
        printf(c"%.2f ", a);
        total += a;
    }
    printf(c"| %.2f\n", total);
    let s = Small::B(7, 9);
    let t = Small::A(3);
    let k = match s {
        Small::A(x) => x as i64,
        Small::B(x, y) => (x as i64) * 10 + y as i64,
        Small::C => -1,
    };
    let m = match t { Small::A(x) => x as i64, _ => 0 };
    printf(c"%ld %ld\n", k, m);
}

// EXPECT: red blue green
// EXPECT: 0 2 418 -3
// EXPECT: 1 0
// EXPECT: 12.00 12.00 0.00 2.50 | 26.50
// EXPECT: 79 3
