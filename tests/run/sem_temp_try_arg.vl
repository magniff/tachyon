// (0.25, conventions.md §2.2 "Temporaries") An owned value an argument
// moves into a callee is dropped, once, when a later argument leaves the
// statement first (`?`, `return`, `break`); when the call is made, the
// callee owns it. Each D says when it is dropped.
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: r -1
// EXPECT: eat 2
// EXPECT: drop 2
// EXPECT: r 9
// EXPECT: drop 4
// EXPECT: drop 3
// EXPECT: r -1
// EXPECT: drop 5
// EXPECT: loop 1
// EXPECT: drop 6
// EXPECT: ret -2
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) -> i64 { println(f"eat {d.id}"); d.id }
fn bad(gpa: Gpa) -> Result<i64, i64> { Err(-1) }
fn good(gpa: Gpa) -> Result<i64, i64> { Ok(7) }
fn two(a: sink D, n: i64) -> i64 { a.id + n }
fn three(a: sink D, b: sink D, n: i64) -> i64 { a.id + b.id + n }
fn f1(gpa: Gpa) -> Result<i64, i64> { Ok(two(mk(1, gpa), bad(gpa)?)) }
fn f2(gpa: Gpa) -> Result<i64, i64> { Ok(eat(mk(2, gpa)) + good(gpa)?) }
fn f3(gpa: Gpa) -> Result<i64, i64> { Ok(three(mk(3, gpa), mk(4, gpa), bad(gpa)?)) }

fn f4(gpa: Gpa) -> i64 {
    var n = 0;
    while n < 3 {
        n += 1;
        two(mk(4 + n, gpa), if n == 1 { break } else { 0 });
    }
    println(f"loop {n}");
    two(mk(6, gpa), if n == 1 { return -2 } else { 0 })
}

fn main(gpa: Gpa) {
    println(f"r {match f1(gpa) { Ok(x) => x, Err(e) => e }}");
    println(f"r {match f2(gpa) { Ok(x) => x, Err(e) => e }}");
    println(f"r {match f3(gpa) { Ok(x) => x, Err(e) => e }}");
    println(f"ret {f4(gpa)}");
    println("end");
}
