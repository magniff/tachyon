// (0.21) Scope::spawn is called directly in the closure given to
// thread::scope, where what its threads borrow is checked.
// ERROR: 's.spawn' is called outside the closure given to 'thread::scope'

use std::thread;

fn start(s: inout thread::Scope, k: i64) {
    s.spawn(sink || k * 2);
}

fn main() {
    thread::scope(|s| {
        start(&s, 4);
        0
    });
    println("done");
}
