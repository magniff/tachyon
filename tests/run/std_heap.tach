// 0.18.1: std's priority queues, BinaryHeap (largest first) and MinHeap
// (smallest first), in the prelude: push, pop, peek, from_vec,
// into_sorted_vec, clear, owned elements (dropped once: --check-alloc),
// tuples and text as elements.
// FLAGS: --check-alloc
// EXPECT: len 7 peek 9
// EXPECT: 9 8 8 5 3 2 1
// EXPECT: (0,2) (2,7) (4,0) (4,1)
// EXPECT: 1 1 2 3 4 5 6 9
// EXPECT: min 1 8 1
// EXPECT: 1 1 2 3 4 5 6 9
// EXPECT: true true true
// EXPECT: 2 2 4
// EXPECT: 1 true
// EXPECT: apple fig pear
// EXPECT: 9 7 5 3
// EXPECT: ok 2000
struct Job { pri: i64, data: Vec<i64> }

impl Eq for Job {
    fn eq(self, o: Job) -> bool { self.pri == o.pri }
}

impl Ord for Job {
    fn cmp(self, o: Job) -> i64 { self.pri - o.pri }
}

fn show(v: Vec<i64>) {
    var b = Buf::new_in(v.allocator());
    for x in v.iter() {
        b.push_fmt(f"{x} ");
    }
    println(trim(b.as_slice()));
}

fn main(gpa: Gpa) -> i32 {
    var h: BinaryHeap<i64> = BinaryHeap::new_in(gpa);
    for x in [5, 1, 8, 3, 9, 2, 8] {
        h.push(x);
    }
    println(f"len {h.len()} peek {h.peek().unwrap()}");
    var out: Vec<i64> = Vec::new_in(gpa);
    while let Some(x) = h.pop() {
        out.push(x);
    }
    show(out);

    var m: MinHeap<(i64, i64)> = MinHeap::with_capacity_in(4, gpa);
    m.push((4, 1));
    m.push((0, 2));
    m.push((4, 0));
    m.push((2, 7));
    var b = Buf::new_in(gpa);
    while let Some((d, u)) = m.pop() {
        b.push_fmt(f"({d},{u}) ");
    }
    println(trim(b.as_slice()));

    var v: Vec<i64> = Vec::new_in(gpa);
    for x in [3, 1, 4, 1, 5, 9, 2, 6] {
        v.push(x);
    }
    let w = v.clone();
    let sorted = BinaryHeap::from_vec(v).into_sorted_vec();
    show(sorted);
    let mh = MinHeap::from_vec(w);
    println(f"min {mh.peek().unwrap()} {mh.as_slice().len} {mh.as_slice()[0]}");
    let sorted2 = mh.into_sorted_vec();
    show(sorted2);

    var e: MinHeap<i64> = MinHeap::new_in(gpa);
    println(f"{e.is_empty()} {e.pop().is_none()} {e.peek().is_none()}");

    // owned elements: each dropped once
    var t: BinaryHeap<Job> = BinaryHeap::new_in(gpa);
    for k in 0..5 {
        var x: Vec<i64> = Vec::new_in(gpa);
        x.push(k);
        t.push(Job { pri: k % 3, data: x });
    }
    if let Some(j) = t.peek() {
        print(f"{j.pri} ");
    }
    let top = t.pop().unwrap();
    println(f"{top.data[0]} {t.len()}");
    var t2 = t;
    t2.clear();
    t2.push(Job { pri: 1, data: Vec::new_in(gpa) });
    println(f"{t2.len()} {t2.capacity() >= 1}");

    var words: MinHeap<[u8]> = MinHeap::new_in(gpa);
    words.push("pear");
    words.push("apple");
    words.push("fig");
    var wb = Buf::new_in(gpa);
    while let Some(s) = words.pop() {
        wb.push_str(s);
        wb.push(' ');
    }
    println(trim(wb.as_slice()));

    var odd: BinaryHeap<i64> = BinaryHeap::new_in(gpa);
    for x in [3, 9, 5, 7] {
        odd.push(x);
    }
    let raw = odd.into_vec();
    show(raw);

    // many: against a sort
    var state = 7u64;
    var big: MinHeap<i64> = MinHeap::new_in(gpa);
    var all: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..2000 {
        state = state * 6364136223846793005u64 + 1442695040888963407u64;
        let x = (state >> 40) as i64 % 500;
        big.push(x);
        all.push(x);
    }
    all.sort();
    var same = true;
    for i in 0..all.len() {
        if big.pop().unwrap() != all[i] {
            same = false;
        }
    }
    println(f"{if same { "ok" } else { "bad" }} {all.len()}");
    0
}
