// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) (see the program)
// EXPECT: 5
struct H { b: Buf }
impl H { fn new(gpa: Gpa) -> H { var b = Buf::new_in(gpa); b.push_str("hi"); H { b: b } }
    fn len(self) -> i64 { self.b.len() } }
fn mk(gpa: Gpa) -> H { H::new(gpa) }

fn main(gpa: Gpa) -> i32 {
    let s = String::from_in("hello", gpa); println(s.len());
    0
}
