// (0.22) #[derive(Debug, Clone)] rejects a struct with an array field
// ("'[i64; 3]' has no Debug"), though arrays copy, compare and print:
// std::gpu's EntryPoint, VertexLayout and PipelineState derive only Eq.
// XFAIL: derive Debug and Clone over array fields (0.22)
// EXPECT: P { a: [1, 2, 3] }

#[derive(Debug, Clone)]
struct P {
    a: [i64; 3],
}

fn main() {
    let p = P { a: [1, 2, 3] };
    let q = p.clone();
    println(f"{q:?}");
}
