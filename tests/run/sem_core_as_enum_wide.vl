// An i64 whose low byte is a valid discriminant is still not one.
// EXIT: 101
// STDERR: invalid value 261 for enum Level
static var Z: i64 = 0;

#[repr(u8)]
enum Level { Low = 1, Mid = 5, High = 9 }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let v = 256 + 5 + Z;                 // low byte 5
    let l = v as Level;
    println(f"not reached {l as i64}");
    0
}
