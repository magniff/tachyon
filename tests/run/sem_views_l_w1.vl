// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) (see the program)
// EXPECT: 3
struct H { b: Buf }
impl H { fn from(s: [u8], gpa: Gpa) -> H { var b = Buf::new_in(gpa); b.push_str(s); H { b: b } }
    fn num(n: i64, gpa: Gpa) -> H { var b = Buf::new_in(gpa); b.push_int(n); H { b: b } }
    fn len(self) -> i64 { self.b.len() } }
fn mkf(s: [u8], gpa: Gpa) -> H { H::from(s, gpa) }

fn main(gpa: Gpa) -> i32 {
    println(H::from("hey", gpa).len());
    0
}
