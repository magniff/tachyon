// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 5 (a literal view is static)
// XFAIL: OVERSTRICT a string literal (a static view) cannot go to thread::spawn
// EXPECT: 5
use std::thread;
fn main(gpa: Gpa) -> i32 {
    let w: str = "hello";
    let h = thread::spawn(sink || w.len());
    println(h.join());
    0
}
