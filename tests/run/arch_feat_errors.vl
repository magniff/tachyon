// FLAGS: -C target-cpu=generic
// ERROR: error[arch.declared]: 'too_small' is #[target_feature(enable = "neon")], but 'hw' (from '__crc32cd' at
// ERROR: edit patch
// ERROR: error[arch.feature]: 'by_or' needs crc (from '__crc32cd' at
// ERROR: error[arch.feature]: 'by_local' needs crc
// ERROR: error[arch.feature]: 'apply<closure(u32) -> u32 at
// ERROR: error[arch.fn_pointer]: 'hw' needs crc (from '__crc32cd' at
// ERROR: error[arch.feature]: 'hw' needs crc (from '__crc32cd' at
// ERROR: --new 'let f = if std::arch::detect("crc") { hw(1, 2) } else { hw_portable(1, 2) };'
// ERROR: -C target-feature=+crc
// ERROR: query features hw --why crc
// ERROR: error[arch.feature]: 'declared' needs crc, which 'main' does not know here
// ERROR: error[arch.feature]: '__crc32cd' needs crc, which 'main' does not know here
// ERROR-COUNT: 8
// (0.19) The feature analysis (docs/design/arch.md §2.4), with crc not in
// the build (Armv8.0): a call is legal where the callee's features are
// known (the then branch of a has/detect guard, `&&` included; the rest of
// a block after `if !G { return }` or `assert(G)`; the else branch of `if
// !G`; a #[target_feature] function); requirements are inferred through
// helpers, generic instances and closures; `||` and a bool kept in a local
// give nothing; errors appear in entry points, declarations and `fn`
// values, with the call wrapped in a detect() branch and its fallback.
use std::arch::{detect, has};
use std::arch::aarch64::__crc32cd;

fn hw(c: u32, x: u64) -> u32 {
    __crc32cd(c, x)
}

fn hw_portable(c: u32, x: u64) -> u32 {
    c ^ x as u32
}

fn by_then(c: u32) -> u32 {
    if detect("crc") && c > 0 {
        return hw(c, 1);
    }
    0
}

fn by_return(c: u32) -> u32 {
    if !detect("crc") {
        return 0;
    }
    hw(c, 2)
}

fn by_assert(c: u32) -> u32 {
    assert(detect("crc"));
    hw(c, 3)
}

fn by_else(c: u32) -> u32 {
    if !detect("crc") { 0 } else { hw(c, 4) }
}

fn by_has(c: u32) -> u32 {
    if has("crc") { hw(c, 5) } else { 0 }
}

#[target_feature(enable = "crc")]
fn declared(c: u32) -> u32 {
    hw(c, 6)
}

#[target_feature(enable = "neon")]
fn too_small(c: u32) -> u32 {
    hw(c, 7)
}

fn by_or(c: u32) -> u32 {
    if detect("crc") || c > 0 {
        return hw(c, 8);
    }
    0
}

fn by_local(c: u32) -> u32 {
    let ok = detect("crc");
    if ok {
        return hw(c, 9);
    }
    0
}

fn apply<F: Fn(u32) -> u32>(f: F, c: u32) -> u32 {
    f(c)
}

fn main() {
    let a = by_then(1) + by_return(1) + by_assert(1) + by_else(1) + by_has(1) + too_small(1);
    let b = if detect("crc") { declared(1) + apply(|c| hw(c, 10), 1) } else { 0 };
    let c = by_or(1);
    let d = by_local(1);
    let e = apply(|c| hw(c, 11), 1);
    let p = hw;
    let f = hw(1, 2);
    let g = declared(2);
    __crc32cd(1, 1);
    println(f"{a} {b} {c} {d} {e} {f} {g}");
}
