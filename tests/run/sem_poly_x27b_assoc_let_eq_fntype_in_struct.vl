// fn(T) and fn(let T) in a generic struct field: one type
// FLAGS: --check-alloc
// EXPECT: 1
struct Ops<T> { f: T }
fn len(v: Vec<i64>) -> i64 { v.len() }

fn main(gpa: Gpa) {
    var o = Ops { f: len };
    let g: fn(Vec<i64>) -> i64 = len;
    o.f = g;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(f"{(o.f)(v)}");
}
