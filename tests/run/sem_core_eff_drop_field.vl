// Dropping a struct drops its fields.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(inout self) { println("dropped"); } }
struct Outer { inner: Noisy, k: i64 }

#[no_io]
fn quiet(o: sink Outer) -> i64 { o.k }

fn main() -> i32 {
    println(quiet(Outer { inner: Noisy { n: 1 }, k: 2 }));
    0
}
