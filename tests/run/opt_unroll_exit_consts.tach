// 0.18: the run-time unroller does not count a constant that only a loop's
// exits read: a check's site and kind, passed to the failure on its cold
// path. bench/iterchain's dot (two streams zipped, a check on each) fell
// from four copies of its body to two when 0.18's check sites gave the
// loop such a constant, 5.8% more instructions over the benchmark.
// (iterchain's functions, smaller sizes.)
// EXPECT: 516274191 5406 5638977 17903 51 10057
// CHECK: fn dot:
// CHECK: = mul
// CHECK: = mul
// CHECK: = mul
// CHECK: = mul
// CHECK: = mul
// CHECK: fn enumerate_sum:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

#[inline(never)]
fn filter_map_sum(v: Vec<i64>, r: i64) -> i64 {
    v.iter().filter(|x| x & 1 == 0).map(|x| x * x + r).sum()
}

#[inline(never)]
fn dot(v: Vec<i64>, w: Vec<i64>, r: i64) -> i64 {
    v.iter().zip(w.iter()).map(|(a, b)| a * b + r).sum()
}

#[inline(never)]
fn enumerate_sum(v: Vec<i64>, r: i64) -> i64 {
    v.iter().enumerate().map(|(i, x)| i * x + r).sum()
}

#[inline(never)]
fn max_count(v: Vec<i64>, r: i64) -> i64 {
    v.iter().map(|x| x ^ r).max().unwrap() + v.iter().filter(|x| x > r).count()
}

#[inline(never)]
fn take_loop(v: Vec<i64>, n: i64) -> i64 {
    var t = 0;
    for x in v.iter().take(n) {
        t += x;
    }
    t
}

#[inline(never)]
fn collect_sort(v: Vec<i64>, m: i64, r: i64, gpa: Gpa) -> i64 {
    var u = v.iter().take(m).map(|x| x ^ r).collect_in(gpa);
    u.sort_by(|a, b| b.cmp(a));
    u.get(0) - u.get(m - 1) + u.get(m / 2)
}

fn main(gpa: Gpa) -> i32 {
    let n = 4096;
    let reps = 3;
    var v: Vec<i64> = Vec::with_capacity_in(n, gpa);
    var w: Vec<i64> = Vec::with_capacity_in(n, gpa);
    for i in 0..n {
        v.push(i * 2654435761 % 1000003 % 1001 - 500);
        w.push(i % 17 - 8);
    }
    var c1 = 0;
    var c2 = 0;
    var c3 = 0;
    var c4 = 0;
    var c5 = 0;
    for r in 0..reps {
        c1 += filter_map_sum(v, r);
        c2 += dot(v, w, r);
        c3 += enumerate_sum(v, r);
        c4 += max_count(v, r * 4999);
        c5 += take_loop(v, n - r);
    }
    var c6 = 0;
    for r in 0..10 {
        c6 += collect_sort(v, 1024, r, gpa);
    }
    unsafe { printf(c"%ld %ld %ld %ld %ld %ld\n", c1, c2, c3, c4, c5, c6); }
    0
}
