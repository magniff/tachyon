// fn(sink Vec) given where fn(Vec) is expected: rejected (the caller keeps and drops it too)
// ERROR: got 'fn(sink Vec<i64>) -> i64'
// XFAIL: DIAG a fn(sink T) type prints as 'fn(Vec<i64>)', a let one as 'fn(let Vec<i64>)'
fn eat(v: sink Vec<i64>) -> i64 { v.len() }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let f: fn(Vec<i64>) -> i64 = eat;
    println(f"{f(v)} {v.len()}");
}
