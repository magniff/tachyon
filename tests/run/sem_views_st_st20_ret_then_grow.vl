// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: the result views s, s grows before the return
// ERROR: error[own.conflict]
fn f(s: inout String) -> str {
    let w = s.as_str();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"); w
}

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    let r = f(&s);
    println(r);
    0
}
