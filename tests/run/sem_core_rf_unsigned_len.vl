// a u64 index compared with the length as u64 then indexed + 1.
// EXIT: 101
// STDERR: index out of bounds: index 8, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64], i: u64) -> i64 { if i < s.len() as u64 { s[i + 1] } else { 0 } }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s, (7 + Z) as u64));
    0
}
