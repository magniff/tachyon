// 0.17: fields are matched by name in a variant's pattern only.
// ERROR: 'P' is not an enum variant: only variants are matched by field name ('E::V { a, .. }'); bind the struct and read its fields ('p => p.x')
struct P { x: i64 }

fn main() -> i32 {
    match (P { x: 1 }) { P { x } => x as i32 }
}
