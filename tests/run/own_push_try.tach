// A call's `?` argument (0.18.1): `v.push(p.item()?)` is not a conflict.
// The `?`'s early return drops `v`, but the return skips the call; the
// drops and scope ends inside an argument never change what an earlier
// argument (the two-phase receiver) borrows.
// EXPECT: 4 [1, 2, 3, 4]
// EXPECT: none
// EXPECT: 2
struct P { pos: i64, end: i64 }

impl P {
    fn item(inout self) -> Option<i64> {
        if self.pos == self.end { return None; }
        self.pos += 1;
        Some(self.pos)
    }
}

fn next(p: inout P) -> Result<i64, [u8]> {
    match p.item() { Some(x) => Ok(x), None => Err("end") }
}

fn items(p: inout P, gpa: Gpa) -> Option<Vec<i64>> {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(p.item()?);
    v.push(next(&p).ok()?);
    let o = Some(3);
    v.push(o?);
    v.push(match p.item() { Some(x) => x + 1, None => return None });
    Some(v)
}

fn all(p: inout P, gpa: Gpa) -> Result<i64, [u8]> {
    var n = 0;
    loop {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(next(&p)?);
        n += v.len();
    }
    Ok(n)
}

fn main(gpa: Gpa) -> i32 {
    var p = P { pos: 0, end: 3 };
    let v = items(&p, gpa).unwrap();
    println(f"{v.len()} {v:?}");
    var q = P { pos: 0, end: 1 };
    match items(&q, gpa) { Some(_) => println("some"), None => println("none") }
    var r = P { pos: 0, end: 2 };
    match all(&r, gpa) { Ok(n) => println(n), Err(_) => println(r.pos) }
    0
}
