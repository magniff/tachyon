// 0.16 T1: --verify-effects (the effects against the IR) on a program
// with a source of each effect, C's table and declarations, callbacks,
// allocators, closures and fn values; tests/query/effects016.q has the
// sets inferred for the same program.
// FLAGS: --verify-effects
// EXPECT: yg
// EXPECT: !!17
extern "C" {
    fn putchar(c: i32) -> i32;
    fn malloc(n: u64) -> *u8;
    fn free(p: *u8);
    fn labs(x: i64) -> i64;
    fn qsort(base: *u8, n: u64, size: u64, cmp: extern "C" fn(*u8, *u8) -> i32);
    #[link_name = "labs"]
    #[effects(io)]
    fn mystery(x: i64) -> i64;
    #[link_name = "llabs"]
    #[pure]
    fn ext_pure(x: i64) -> i64;
}

static mut COUNT: i64 = 0;
static LIMIT: i64 = 10;

enum Color { Red, Green }

fn add(a: i64, b: i64) -> i64 { a + b + LIMIT }
fn bump() { COUNT += 1; }
fn address() -> *i64 { &COUNT }
fn at(s: [i64], i: i64) -> i64 { s[i] }
fn part(s: [i64]) -> [i64] { s[1..] }
fn whole(s: [i64]) -> [i64] { s[..] }
fn color(x: i64) -> Color { x as Color }

fn sum(s: [i64]) -> i64 {
    let mut t = 0;
    for i in 0..s.len { t += s[i]; }
    for x in s { t += x; }
    let a = [1, 2, 3];
    for i in 0..3 { t += a[i]; }
    for x in a { t += x; }
    t + a[2]
}

fn same(a: [i64; 3], b: [i64; 3], s: [u8], r: [u8]) -> bool { a == b && s == r }

fn spin(n: i64) -> i64 {
    let mut k = n;
    while k > 0 { k -= 1; }
    k
}

fn forever() -> i64 { loop { return 1; } }
fn fact(n: i64) -> i64 { if n <= 1 { 1 } else { n * fact(n - 1) } }
fn even(n: i64) -> bool { if n == 0 { true } else { odd(n - 1) } }
fn odd(n: i64) -> bool { if n == 0 { false } else { even(n - 1) } }
fn deref(p: *i64) -> i64 { unsafe { *(p as *i64) } }
fn raw_index(mut q: *i64) -> i64 { unsafe { q[1] } }
unsafe fn trusted() -> i64 { 1 }
fn calls_c() -> i64 { unsafe { labs(-3) + ext_pure(2) } }
fn declared() -> i64 { unsafe { mystery(1) } }
fn heap() { unsafe { free(malloc(8)); } }
fn out(c: u8) { unsafe { putchar(c as i32); } }
extern "C" fn by_c(a: *u8, b: *u8) -> i32 { bump(); 0 }

fn sorter() {
    let mut a = [3u8, 1u8];
    unsafe { qsort(&a[0], 2, 1, by_c); }
}

fn main(gpa: Gpa) -> i32 {
    let v = [1, 2, 3];
    let k = t0();
    let t = add(1, 2) + at(v[..], 0) + sum(v[..]) + part(v[..]).len + whole(v[..]).len + spin(3)
        + forever() + fact(3) + calls_c() + unsafe { trusted() } + deref(&k) + raw_index(&k);
    if same(v, v, "ab", "ab") && even(4) {
        out('y');
    }
    bump();
    match color(1) {
        Color::Green => out('g'),
        Color::Red => out('r'),
    }
    heap();
    sorter();
    out('\n');
    let n = allocators(gpa);
    out('0' + (n / 10) as u8);
    out('0' + (n % 10) as u8);
    out('\n');
    if t > 0 && address() != 0 as *i64 { 0 } else { 1 }
}

fn t0() -> i64 { 5 }

struct Bump { base: *u8, used: i64, cap: i64 }

impl Allocator for Bump {
    fn try_alloc(self: *Bump, size: i64, align: i64) -> *u8 {
        if self.used + size > self.cap {
            return 0 as *u8;
        }
        let p = unsafe { (self.base as i64 + self.used) as *u8 };
        self.used += size;
        p
    }

    unsafe fn try_resize(self: *Bump, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        let q = self.try_alloc(new_size, align);
        if q != 0 as *u8 {
            for i in 0..(if old_size < new_size { old_size } else { new_size }) {
                q[i] = p[i];
            }
        }
        q
    }

    unsafe fn free(self: *Bump, p: *u8, size: i64, align: i64) {}
}

fn fill<A: Allocator>(v: *Vec<i64, A>) { v.push(1); }

fn in_scope(a: *Arena) -> i64 { a.scope(|s| 1) }

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }
fn double(x: i64) -> i64 { x * 2 }
fn shout(x: i64) -> i64 { out('!'); x }
fn hof<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { f(x) }

fn allocators(gpa: Gpa) -> i64 {
    let mut g: Vec<i64> = Vec::new_in(gpa);
    fill(&g);
    let mut buf = [0u8; 4096];
    let b = Bump { base: &buf[0], used: 0, cap: 4096 };
    let mut w: Vec<i64, Bump> = Vec::new_in(b);
    fill(&w);
    let k = 2;
    hof(|x| x + k, 1) + hof(|x| shout(x), 2) + apply(double, 3) + apply(shout, 4) + g.len()
        + w.len()
}
