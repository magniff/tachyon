// An unwrap of None under a never-true condition in a loop.
// FLAGS: -O2
// EXPECT: 0
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var t = 0;
    var k = 0;
    let o: Option<i64> = None;
    while k < 5 + Z { if k > 100 { t += o.unwrap(); } k += 1; }
    println(t);
    0
}
