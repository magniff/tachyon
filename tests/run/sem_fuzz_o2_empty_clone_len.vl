// (0.25, the semantics fuzzer) At -O2 the clone of an empty Vec field
// reads as non-empty in a later loop: `w25.len() > 0` holds and `o12`
// lines are printed; -O0 and -O1 print none. Found by
// tools/semfuzz/semfuzz.py (seed 1508), shrunk and reduced by hand.
// FLAGS: -O2
// EXPECT: o9 0
// EXPECT: o11 7

struct T { id: i64, v: i64 }

impl Clone for T {
    fn clone(self) -> T { T { id: 0, v: self.v } }
}

#[derive(Clone)]
struct S { t: T, w: Vec<T> }

fn vsig(w: Vec<T>) -> i64 {
    var h = 7;
    for x in w { h = h * 31 + x.id * 100; }
    h
}

fn run(gpa: Gpa) {
    var s20 = S { t: T { id: 1, v: 2 }, w: Vec::new_in(gpa) };
    var w25 = s20.w.clone();
    for i32 in 0..1 {
        println(f"o9 {i32}");
    }
    println(f"o11 {vsig(w25)}");
    for i37 in 0..2 {
        if w25.len() > 0 {
            println(f"o12 {i37}");
        }
    }
}

fn main(gpa: Gpa) -> i32 { run(gpa); 0 }
