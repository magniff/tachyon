// std::cli (0.24): --help prints the help on stdout and exits with 0.
// ARGS: --name x --help
// EXPECT: hello
// EXPECT:
// EXPECT: usage: hello [options] <file>...
// EXPECT:
// EXPECT: arguments:
// EXPECT:   <file>...          what to greet
// EXPECT:
// EXPECT: options:
// EXPECT:       --name <NAME>  [default: you]
// EXPECT:   -h, --help         print this help
use std::env;
use std::cli::{Arg, Command};

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("hello", gpa)
        .arg(Arg::option("name").default("you"))
        .arg(Arg::positional("file").multiple().required().help("what to greet"));
    let m = cmd.parse_or_exit(env::args());
    println(f"hello {m.get("name").unwrap()}");
    0
}
