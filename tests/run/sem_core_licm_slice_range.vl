// A guarded subslice in a loop.
// FLAGS: -O2
// EXPECT: 0
static var Z: i64 = 0;



fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    let a = [1, 2, 3];
    var t = 0;
    var k = 0;
    while k < 5 + Z { if k > 100 { t += a[i..i + 1].len(); } k += 1; }
    println(t);
    0
}
