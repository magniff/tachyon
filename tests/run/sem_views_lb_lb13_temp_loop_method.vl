// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a view of a loop iteration's temporary receiver, kept past it
// XFAIL: SOUNDNESS a view of a loop iteration's temporary receiver outlives it: wrong values
// ERROR: error[own.escape]
struct E { name: [u8; 4], len: i64 }
impl E { fn nm(self) -> [u8] { self.name[..self.len] } }
fn mk(c: u8) -> E { E { name: [c, c, c, c], len: 4 } }
fn main(gpa: Gpa) -> i32 {
    var keep: Vec<[u8]> = Vec::new_in(gpa);
    for i in 0..3 {
        keep.push(mk('a' + i as u8).nm());
    }
    println(f"{keep.get(0)} {keep.get(1)} {keep.get(2)}");
    0
}
