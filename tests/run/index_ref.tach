// A reference to an integer indexes (0.18.1): a `sort_by` closure's
// parameters are `&i64`, and `keys[a]` reads through `a`; so do the ends
// of a range, `s[*i..]` written `s[i..]`.
// EXPECT: 1 2 0
// EXPECT: llo
fn main(gpa: Gpa) {
    let keys = [30, 10, 20];
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(0);
    v.push(1);
    v.push(2);
    v.sort_by(|a, b| keys[a] - keys[b]);
    println(f"{v[0]} {v[1]} {v[2]}");
    let s = "hello";
    let i = 2;
    let r = &i;
    println(s[r..]);
}
