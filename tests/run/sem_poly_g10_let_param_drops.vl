// let T and sink T per instance: a let param of an owned T is borrowed (no drop inside),
// a sink one dropped in the callee; plain T copied
// (0.25, fix25f) the temporary given to look drops at its statement's end
// FLAGS: --check-alloc
// EXPECT: look
// EXPECT: look
// EXPECT: take
// EXPECT: drop 1
// EXPECT: after take
// EXPECT: look
// EXPECT: take
// EXPECT: look
// EXPECT: drop 3
// EXPECT: end
// EXPECT: drop 2
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn look<T>(x: T) { println("look"); }
fn take<T>(x: sink T) { println("take"); }

fn main() {
    let a = R { id: 1 };
    look(a);
    look(a);
    take(a);
    println("after take");
    look(5);
    take(5);
    let b = R { id: 2 };
    look(R { id: 3 });
    println("end");
}
