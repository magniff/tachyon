// ? inside a call taking inout of x and let of x (plain: copy)
// EXPECT: 12
fn parse(s: i64) -> Result<i64, i64> { if s > 0 { Ok(s) } else { Err(s) } }
fn add(a: inout i64, b: i64) { a += b; }
fn go(x: inout i64) -> Result<i64, i64> { add(&x, parse(x + 5)?); Ok(x) }
fn main() { var x = 3; match go(&x) { Ok(n) => println(f"{n + 1}"), Err(e) => println(f"e{e}") } }
