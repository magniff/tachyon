// 0.11: the SLP vectorizer. Stores to the lanes of one 16-byte vector,
// their values packed: a struct of floats updated field by field, four
// i32 fields from two other structs; left alone when the memory between
// does not allow it (two pointers that may be the same, a lane reading
// another lane's new value, a call in between) or when it does not pay.
// EXPECT: 1.5000000000000004 1.7500000000000009
// EXPECT: 46 56 66 76
// EXPECT: 184 224 264 304 | 5 18 58 179
// EXPECT: 3 9 | 6 14 1
// EXPECT: 7 9 11 13
// CHECK: fn step:
// CHECK: v2f64 = load
// CHECK: vbin.mul
// CHECK: vbin.add
// CHECK: store
// CHECK: fn mix:
// CHECK-NOT: vbin
// CHECK: fn add4:
// CHECK: v4i32 = load
// CHECK: vbin.add
// CHECK: fn chain:
// CHECK-NOT: v2f64
// CHECK: fn main:
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

struct P { x: f64, y: f64, vx: f64, vy: f64 }
struct Q { a: i32, b: i32, c: i32, d: i32 }
struct R { u: i64, v: i64 }

#[inline(never)]
fn step(p: *P, dt: f64) {
    p.x += dt * p.vx;
    p.y += dt * p.vy;
}

// q and r may be the same struct, or overlap: not packed.
#[inline(never)]
fn mix(q: *Q, r: *Q) {
    q.a = q.a + r.a * 3;
    q.b = q.b + r.b * 3;
    q.c = q.c + r.c * 3;
    q.d = q.d + r.d * 3;
}

struct T { x: Q, y: Q, o: Q }

// Three structs at known offsets of one: no overlap.
#[inline(never)]
fn add4(t: *T) {
    t.o.a = t.x.a + t.y.a;
    t.o.b = t.x.b + t.y.b;
    t.o.c = t.x.c + t.y.c;
    t.o.d = t.x.d + t.y.d;
}

// The second lane reads the first's new value.
#[inline(never)]
fn chain(p: *P) {
    p.x = p.vx * 2.0;
    p.y = p.x * 3.0;
}

static mut CALLS: i64 = 0;

#[inline(never)]
fn bump(r: *R) -> i64 {
    CALLS += 1;
    r.u + 1
}

// A call between the stores (it reads the first).
#[inline(never)]
fn with_call(r: *R) {
    r.u = r.v * 3;
    r.v = bump(r) * 2;
}

fn main() -> i32 {
    let mut p = P { x: 1.0, y: 2.0, vx: 0.5, vy: -0.25 };
    for _ in 0..10 {
        step(&p, 0.1);
    }
    unsafe { printf(c"%.17g %.17g\n", p.x, p.y); }
    let mut q = Q { a: 1, b: 2, c: 3, d: 4 };
    let r = Q { a: 5, b: 6, c: 7, d: 8 };
    for _ in 0..3 {
        mix(&q, &r);
    }
    unsafe { printf(c"%d %d %d %d\n", q.a, q.b, q.c, q.d); }
    // The same struct twice, and two that overlap (an array of i32s seen
    // as Qs at offsets 0 and 1).
    mix(&q, &q);
    let mut w: [i32; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let w0 = unsafe { &w[0] as *i32 as *Q };
    let w1 = unsafe { &w[1] as *i32 as *Q };
    unsafe { mix(w1, w0); }
    unsafe { printf(c"%d %d %d %d | %d %d %d %d\n", q.a, q.b, q.c, q.d, w[1], w[2], w[3], w[4]); }
    let mut c = P { x: 0.0, y: 0.0, vx: 1.5, vy: 0.0 };
    chain(&c);
    let mut s = R { u: 1, v: 2 };
    with_call(&s);
    unsafe { printf(c"%.0f %.0f | %ld %ld %ld\n", c.x, c.y, s.u, s.v, CALLS); }
    let mut t = T {
        x: Q { a: 3, b: 4, c: 5, d: 6 }, y: Q { a: 4, b: 5, c: 6, d: 7 },
        o: Q { a: 0, b: 0, c: 0, d: 0 }
    };
    add4(&t);
    unsafe { printf(c"%d %d %d %d\n", t.o.a, t.o.b, t.o.c, t.o.d); }
    0
}
