// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a (borrowed: the result views it) and b alias arr
// ERROR: error[own.conflict]
fn f(a: [i64; 4], b: inout [i64; 4]) -> [i64] { b[0] = 9; a[..] }

fn main() -> i32 {
    var arr = [1, 2, 3, 4];
    let s = f(arr, &arr);
    println(s[0]);
    0
}
