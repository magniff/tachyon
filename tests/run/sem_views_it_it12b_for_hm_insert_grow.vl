// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: insert (growing the table) while iterating
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    for i in 0..8 { m.insert(i, i); }
    var n = 0;
    for (k, x) in m.iter() {
        if k < 8 { for j in 0..50 { m.insert(k * 1000 + j + 8, x); } } n += 1;
    }
    println(m.len());
    0
}
