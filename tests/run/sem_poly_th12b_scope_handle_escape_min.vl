// a scoped thread's handle returned out of thread::scope and joined after it
// ERROR: [sync.
// XFAIL: SOUNDNESS thread::scope(|sc| sc.spawn(|| 7)).join() after the scope: segfault at -O0, trap at -O2
use std::thread;

fn main() {
    let h = thread::scope(|sc| sc.spawn(|| 7));
    println(f"{h.join()}");
}
