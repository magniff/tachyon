// A trait with type parameters (0.15), implemented for one type with
// several arguments: a method call picks the impl whose function takes
// the arguments' types (an untyped literal: the one impl of its kind),
// through a pointer too; a bound with an argument; an associated function
// of a generic trait called on the type.
// EXPECT: 6 8
// EXPECT: 1 2
// EXPECT: 30 40
// EXPECT: 8
trait Scale<T> {
    fn scale(self: *Self, by: T) -> Self;
}

trait Make<T> {
    fn make(x: T, y: T) -> Self;
}

struct V { x: i64, y: i64 }

impl Scale<i64> for V {
    fn scale(self: *V, by: i64) -> V { V { x: self.x * by, y: self.y * by } }
}

impl Scale<f64> for V {
    fn scale(self: *V, by: f64) -> V {
        V { x: (self.x as f64 * by) as i64, y: (self.y as f64 * by) as i64 }
    }
}

impl Make<i64> for V {
    fn make(x: i64, y: i64) -> V { V { x: x, y: y } }
}

impl Make<bool> for V {
    fn make(x: bool, y: bool) -> V { V { x: x as i64 + 7, y: y as i64 } }
}

fn grow<T: Scale<i64>>(t: &T) -> T {
    t.scale(10)
}

fn halve(p: &V) -> V {
    p.scale(0.5)
}

fn show(v: V) {
    std::print_int(v.x);
    print(" ");
    std::print_int(v.y);
    println("");
}

fn main() {
    let v = V { x: 3, y: 4 };
    show(v.scale(2));
    show(halve(&v));
    show(grow(&v));
    std::print_int(V::make(true, false).x);
    println("");
}
