// libc's qsort calling back into an extern "C" vole comparison function.
// EXPECT: 99 42 7 7 5 0 -3 -100
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn qsort(base: *u8, n: u64, size: u64, cmp: extern "C" fn(*u8, *u8) -> i32);
}

extern "C" fn by_value_desc(a: *u8, b: *u8) -> i32 {
    let x = unsafe { *(a as *i64) };
    let y = unsafe { *(b as *i64) };
    if x < y { 1 } else if x > y { -1 } else { 0 }
}

fn main() -> i64 {
    let data: [i64; 8] = [5, -3, 99, 0, 42, -100, 7, 7];
    unsafe {
        qsort(&data as *u8, 8, 8, by_value_desc);
        printf(c"%ld %ld %ld %ld %ld %ld %ld %ld\n", data[0], data[1], data[2], data[3], data[4],
            data[5], data[6], data[7]);
    }
    0
}
