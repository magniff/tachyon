// sem-own: position over owned items drops each item it looked at.
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: pos 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let p = (0..3).map(|i| mk(i, gpa)).position(|d| d.id == 1);
    println(f"pos {p.unwrap_or(-1)}");
}
