// C's mem*/str* have no effects but read and write memory: calls are not
// removed or value-numbered across a store.
// EXPECT: 3 1 4 2 65 120
extern "C" {
    fn strlen(s: *u8) -> u64;
    fn memset(p: *u8, c: i32, n: u64) -> *u8;
    fn memcpy(d: *u8, s: *u8, n: u64) -> *u8;
}

fn main() -> i32 {
    var buf: [u8; 8] = [104, 105, 33, 0, 0, 0, 0, 0];
    let p = &buf as *u8;
    let a = unsafe { strlen(p) };
    unsafe { p[1] = 0; }
    let b = unsafe { strlen(p) };
    unsafe { memset(p, 120, 4); }
    let c = unsafe { strlen(p) };
    var src: [u8; 8] = [65, 66, 0, 0, 0, 0, 0, 0];
    unsafe { memcpy(p, &src as *u8, 3); }
    let d = unsafe { strlen(p) };
    println(f"{a} {b} {c} {d} {buf[0]} {buf[3]}");
    0
}
