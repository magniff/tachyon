// sem-own: `var t = w[0].1;`: own.move_out.
// XFAIL: SOUNDNESS accepted: a field (or tuple part) of a Vec element moved out, then freed twice (`w[0].f`, `w[0].1`)
// ERROR: own.move_out
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var w: Vec<(i64, D)> = Vec::new_in(gpa);
    w.push((1, mk(1, gpa)));
    var t = w[0].1;
}
