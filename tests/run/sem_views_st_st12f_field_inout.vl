// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a field String grown while a view into it is used
// ERROR: error[own.conflict]
struct P { name: String }
fn main(gpa: Gpa) -> i32 {
    var p = P { name: String::from_in("hello", gpa) };
    let w = p.name.as_str();
    p.name.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(w);
    0
}
