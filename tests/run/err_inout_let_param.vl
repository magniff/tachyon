// (0.25) A let parameter of a plain type is a copy, read-only: `&x` to an
// inout parameter, an `inout self` method on it, and the same in a
// generic body are own.readonly, with `x: inout T` as the fix.
struct C { n: i64 }
impl C { fn inc(inout self) { self.n += 1; } }
trait Inc { fn up(inout self); }
impl Inc for C { fn up(inout self) { self.n += 1; } }
fn bump(n: inout i64) { n += 1; }
fn f(x: i64) -> i64 { bump(&x); x }
fn g(c: C) -> i64 { c.inc(); c.n }
fn h<T: Inc>(t: T) { t.up(); }
fn main() { let c = C { n: 1 }; h(c); println(f"{f(1)} {g(c)}"); }
// ERROR: '&x' changes 'x', a let parameter: it is read-only
// ERROR: try: x: inout i64
// ERROR: 'c.inc()' changes 'c', a let parameter
// ERROR: try: c: inout C
// ERROR: 't.up()' changes 't', a let parameter
