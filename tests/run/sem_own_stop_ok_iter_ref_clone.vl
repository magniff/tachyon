// sem-own (iterator stopgap): iter_ref().map(|x| x.clone()) collected, with a Clone impl: each copy dropped once.
// EXPECT: 2
// EXPECT: drop 101
// EXPECT: drop 102
// EXPECT: drop 1
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn two(gpa: Gpa) -> Vec<D> {
    var w: Vec<D> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn idof(d: D) -> i64 { d.id }
impl Clone for D { fn clone(self) -> D { D { id: self.id + 100, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let w = two(gpa);
    let c: Vec<D> = w.iter_ref().map(|x| x.clone()).collect_in(gpa);
    println(f"{c.len()}");
}
