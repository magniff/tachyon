// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(ds)`; s grows while it is used
// ERROR: error[own.conflict]
struct D { title: str }
fn f(ds: Vec<D>) -> str { ds[0].title }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var ds: Vec<D> = Vec::new_in(gpa); ds.push(D { title: w });
    let r = f(ds);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
