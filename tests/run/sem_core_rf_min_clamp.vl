// a clamp written wrong (max instead of min) is still checked.
// EXIT: 101
// STDERR: index out of bounds: index 8, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64], i: i64) -> i64 { let j = if i > s.len() - 1 { i } else { s.len() - 1 }; s[j] }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s, 8 + Z));
    0
}
