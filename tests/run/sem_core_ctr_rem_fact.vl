// requires n > 0 makes x % n in 0..n only for x >= 0: -1 % 3 == -1.
// EXPECT: 20
// EXIT: 101
// STDERR: index out of bounds: index -1, length 3
static var Z: i64 = 0;

fn pick(a: [i64], x: i64, n: i64) -> i64
    requires n > 0 && n <= a.len()
{
    a[x % n]
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [10, 20, 30];
    println(pick(a[..], 4 + Z, 3));
    println(pick(a[..], -1 + Z, 3));
    0
}
