// sem-own: collecting a user Iterator of owned items: each dropped once with the Vec.
// EXPECT: n 2
// EXPECT: drop 2
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct Pop { v: Vec<D> }
impl Iterator for Pop { type Item = D; fn next(inout self) -> Option<D> { self.v.pop() } }

fn main(gpa: Gpa) {
    var p = Pop { v: Vec::new_in(gpa) };
    p.v.push(mk(1, gpa));
    p.v.push(mk(2, gpa));
    let c: Vec<D> = p.collect_in(gpa);
    println(f"n {c.len()}");
}
