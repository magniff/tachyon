// A checked array index under a condition that never holds, in a while
// loop: -O2's LICM hoists the element's load into the preheader, above
// its bounds check, so safe code reads a[-2^40] (a segfault).
// FLAGS: -O2
// XFAIL: SOUNDNESS -O2 LICM hoists a guarded array load above its bounds check (segfault)
// EXPECT: 0
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    let a = [1, 2, 3];
    var t = 0;
    var k = 0;
    while k < 5 + Z {
        if k > 100 { t += a[i]; }
        k += 1;
    }
    println(t);
    0
}
