// Types aligned above 16 (0.5): frames realigned at every level, so locals,
// temporaries, parameters and results are aligned; statics too; C's
// convention for them (by reference on AArch64, at an aligned stack offset
// on x86-64).
// CSOURCE: tests/c/align_over16.c
// EXPECT: locals ok
// EXPECT: array ok
// EXPECT: nested ok
// EXPECT: page ok
// EXPECT: static ok
// EXPECT: param ok 11
// EXPECT: result ok 7 -7
// EXPECT: c_take_a64 78
// EXPECT: c_take_a32 13
// EXPECT: c_make_a64 5 -5
// EXPECT: c_check_ptr 3
// EXPECT: c_call_tachyon 27
// EXPECT: size 64 64 32 128
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn c_take_a64(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, s: A64, h: i64) -> i64;
    fn c_take_a32(s: A32, k: f64) -> i64;
    fn c_make_a64(x: i64) -> A64;
    fn c_check_ptr(p: *A64) -> i64;
    fn c_call_tachyon(x: i64) -> i64;
}

#[repr(C, align(64))]
struct A64 { x: i64, y: i64 }

#[repr(C, align(32))]
struct A32 { d: f64, i: i32 }

#[repr(C, align(4096))]
struct Page { first: u8 }

struct Holder { tag: u8, inner: A64, after: i32 }

static GLOBAL: A64 = A64 { x: 1, y: 2 };

fn aligned(p: &u8, align: u64) -> bool {
    (p as u64) % align == 0
}

fn report(label: &mut u8, ok: bool) {
    unsafe { printf(c"%s %s\n", label, if ok { c"ok" } else { c"misaligned" }); }
}

fn take(a: A64, k: i64) -> i64 {
    let copy = a;
    if unsafe { !aligned(&*(&copy as *u8), 64) } {
        return -1;
    }
    copy.x * k + copy.y
}

fn make(x: i64) -> A64 {
    A64 { x: x, y: 0 - x }
}

extern "C" fn tachyon_take_a64(a: i64, s: A64, b: i64) -> i64 {
    a + s.x + s.y * 10 + b
}

extern "C" fn tachyon_make_a64(x: i64) -> A64 {
    A64 { x: x, y: x / 2 }
}

fn main() -> i32 {
    let mut pad: u8 = 1;
    let a = A64 { x: 3, y: 4 };
    let mut b: A32 = A32 { d: 1.5, i: 7 };
    pad += 1;
    unsafe { report(&mut *(c"locals"), aligned(&*(&a as *u8), 64) && aligned(&*(&b as *u8), 32)); }
    let arr: [A64; 3] = [A64 { x: 1, y: 1 }, A64 { x: 2, y: 2 }, A64 { x: 3, y: 3 }];
    unsafe {
        report(&mut *(c"array"),
            aligned(&*(&arr[0] as *u8), 64) && aligned(&*(&arr[1] as *u8), 64)
                && aligned(&*(&arr[2] as *u8), 64));
    }
    let h = Holder { tag: pad, inner: A64 { x: 5, y: 6 }, after: 9 };
    unsafe {
        report(&mut *(c"nested"),
            aligned(&*(&h.inner as *u8), 64) && h.inner.y == 6 && h.after == 9);
    }
    let page = Page { first: 1 };
    unsafe {
        report(&mut *(c"page"), aligned(&*(&page as *u8), 4096) && page.first == 1);
        report(&mut *(c"static"), aligned(&*(&GLOBAL as *u8), 64));
    }
    let t = take(a, 2);
    unsafe { printf(c"param %s %ld\n", if t >= 0 { c"ok" } else { c"misaligned" }, t + 1); }
    let r = make(7);
    unsafe {
        printf(c"result %s %ld %ld\n",
            if aligned(&*(&r as *u8), 64) { c"ok" } else { c"misaligned" }, r.x, r.y);
        printf(c"c_take_a64 %ld\n", c_take_a64(1, 2, 3, 4, 5, 6, 7, a, 3));
    }
    b.i = 10;
    unsafe { printf(c"c_take_a32 %ld\n", c_take_a32(b, 2.0)); }
    let m = unsafe { c_make_a64(5) };
    unsafe {
        printf(c"c_make_a64 %ld %ld\n", m.x, m.y);
        printf(c"c_check_ptr %ld\n", c_check_ptr(&GLOBAL));
        printf(c"c_call_tachyon %ld\n", c_call_tachyon(4));
        printf(c"size %ld %ld %ld %ld\n", size_of(A64), align_of(A64), size_of(A32),
            size_of(Holder));
    }
    0
}
