// A generic function dropping a T whose Drop prints, checked per instance.
// ERROR: 'eat' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(inout self) { println("dropped"); } }

#[no_io]
fn eat<T>(x: sink T) -> i64 { 1 }

fn main() -> i32 {
    println(eat(Noisy { n: 4 }));
    0
}
