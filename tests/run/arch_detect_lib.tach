// FLAGS: -C target-cpu=generic
// CSOURCE: tests/c/arch_detect_lib.c
// EXPECT: crc 3808858755, agree 1, twice 42
// (0.19 T3) Code entered from C, with no tachyon main to fill the run-time
// feature word first: each detect asks std for it (filled at the first
// one). The answers are the machine's; what is printed is not (and
// TACHYON_ARCH_DISABLE=all gives the same, by the fallbacks).
use std::arch::detect;
use std::arch::aarch64::__crc32cd;

fn crc_bits(c0: u32, x: u64) -> u32 {
    let mut c = c0 ^ x as u32;
    let rest = x >> 32;
    for k in 0..64 {
        if k == 32 {
            c ^= rest as u32;
        }
        c = if (c & 1) != 0 { (c >> 1) ^ 0x82f63b78 } else { c >> 1 };
    }
    c
}

extern "C" fn crc_checked() -> u32 {
    // "12345678" then "9", CRC-32C
    let x: u64 = 0x3837363534333231;
    let mut c: u32 = if detect("crc") { __crc32cd(0xffffffff, x) } else { crc_bits(0xffffffff, x) };
    c ^= 0x39;
    for _ in 0..8 {
        c = if (c & 1) != 0 { (c >> 1) ^ 0x82f63b78 } else { c >> 1 };
    }
    ~c
}

extern "C" fn words_agree() -> i32 {
    if detect("sha3") && !detect("sha2") { 0 } else { 1 }
}

// (0.19.0) A parameter and a detect: the call that fills the word goes
// after the parameter is taken.
extern "C" fn twice(x: i32) -> i32 {
    if detect("crc") { x * 2 } else { x + x }
}
