// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of an element of an owned Vec<Vec>, kept past the for, then cleared
// XFAIL: OVERSTRICT a view of a for loop's borrowed element is own.escape when kept past the loop
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var vv: Vec<Vec<i64>> = Vec::new_in(gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    vv.push(v);
    let u: Vec<i64> = Vec::new_in(gpa);
    var keep = u.as_slice();
    for x in vv { keep = x.as_slice(); }
    vv.clear();
    println(keep[0]);
    0
}
