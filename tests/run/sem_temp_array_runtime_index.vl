// (0.25) An owned element moved out of an array temporary by a run-time
// index: the other elements would have no owner left, own.partial (by a
// constant index the rest is dropped: sem_own_temp_array_index_of_call).
// ERROR: error[own.partial]: 'ma(gpa)[i]' moves an element out of a temporary array by a run-time index
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn ma(gpa: Gpa) -> [D; 2] { [mk(1, gpa), mk(2, gpa)] }

fn main(gpa: Gpa) {
    let i = 1;
    let b = ma(gpa)[i];
    println(f"got {b.id}");
}
