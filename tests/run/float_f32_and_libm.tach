// f32 constants, implicit fmod/pow, and f32 promotion for variadics.
// EXPECT: 1.000000 1.5 1024
// EXPECT: 1.5 8
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let x: f32 = 2.0;
    let y: f32 = 0.5;
    let a: f64 = 5.5;
    let b: f64 = 2.0;
    let e: f64 = 10.0;
    printf("%f %.1f %.0f\n".0, x * y, a % b, b ** e);
    let p: f32 = 5.5;
    let q: f32 = 2.0;
    let r: f32 = 3.0;
    printf("%.1f %.0f\n".0, p % q, q ** r);
    0
}
