// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: zip of two Vec<str> items kept
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    var r: str = "";
    for (a, b) in v.iter().zip(v.iter()) { r = b; }
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
