// XFAIL: SOUNDNESS two scoped threads each take &a[..] as an inout slice: a data race (counts vary run to run)
// two scoped threads write one array through inout slices: a data race
// ERROR: sync
use std::thread;
fn bump(s: inout [i64]) { for i in 0..1000000 { s[0] += 1; } }
fn main() { var a = [0, 0]; thread::scope(|sc| { let x = sc.spawn(|| { bump(&a[..]); 0 }); let y = sc.spawn(|| { bump(&a[..]); 0 }); x.join() + y.join() }); println(f"{a[0]}"); }
