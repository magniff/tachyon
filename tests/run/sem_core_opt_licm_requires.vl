// A call whose requires fails, under a condition that never holds, in a loop.
// EXPECT: 10
static var Z: i64 = 0;

fn half(x: i64) -> i64
    requires x > 0
{
    x / 2
}

#[inline(never)]
fn half_ni(x: i64) -> i64
    requires x > 0
{
    x / 2
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let x = Z;
    var s = 0;
    for k in 0..10 + Z {
        if k > 100 { s += half(x) + half_ni(x); }
        s += 1;
    }
    let o: Option<i64> = if Z == 1 { Some(3) } else { None };
    for k in 0..10 + Z {
        if o.is_some() { s += o.unwrap(); }
    }
    println(s);
    0
}
