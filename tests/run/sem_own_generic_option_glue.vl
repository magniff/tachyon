// sem-own: Option<T> drop glue in a generic fn instantiated with D: Some dropped once, None nothing.
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn hold<T>(o: sink Option<T>) {}

fn main(gpa: Gpa) {
    hold(Some(mk(1, gpa)));
    hold::<D>(None);
    println("end");
}
