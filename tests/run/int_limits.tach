// `i64::MAX`, `u8::MIN` (0.15): the limits of the primitive integer types
// are builtin constants (literals of the type), in constants, statics,
// generic arguments and widening too; std's `I64_MAX` ... are the same.
// EXPECT: 9223372036854775807 -9223372036854775808 0 4294967295
// EXPECT: 2147483647 18446744073709551615 -128 true 32766
// EXPECT: 255 65535 -2147483648 true 2147483647 -32768
// EXPECT: 0 0 0 0 127
const BIG: i64 = i64::MAX;
const SMALL: i64 = i64::MIN;
static LIM: [u32; 2] = [u32::MIN, u32::MAX];

fn larger<T: Ord>(a: T, b: T) -> T {
    if a < b { b } else { a }
}

fn main() {
    let a: i64 = i32::MAX;
    let b = u64::MAX;
    let c = i8::MIN;
    let d: i64 = -9223372036854775808i64;
    println(f"{BIG} {SMALL} {LIM[0]} {LIM[1]}");
    println(f"{a} {b} {c} {d == SMALL} {i16::MAX - 1}");
    println(
        f"{u8::MAX} {u16::MAX} {i32::MIN} {std::I64_MAX == i64::MAX} {larger(i32::MAX, 5)} {i16::MIN}");
    println(f"{u8::MIN} {u16::MIN} {u32::MIN} {u64::MIN} {std::I8_MAX}");
}
