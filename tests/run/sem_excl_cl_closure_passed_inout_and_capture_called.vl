// XFAIL: SOUNDNESS run(&g, &n) with g capturing n: -O0 prints 105, -O2 101
// the closure is called inside the callee that also has n inout (through a generic helper)
// ERROR: own.conflict
fn run<F: FnMut()>(f: inout F, x: inout i64) -> i64 { let b = x; f(); b * 100 + x }
fn main() { var n = 1; var g = || { n = 5; }; let r = run(&g, &n); println(f"{r}"); }
