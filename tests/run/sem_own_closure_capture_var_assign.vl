// sem-own: a closure capturing a var inout, assigning a new owned value:
// the old value dropped by the assignment, the new one at scope end.
// EXPECT: drop 1
// EXPECT: id 2
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    var d = mk(1, gpa);
    let set = || { d = mk(2, gpa); };
    set();
    println(f"id {d.id}");
    println("end");
}
