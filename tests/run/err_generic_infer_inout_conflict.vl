// (0.25.1) Two `inout [T]` lent by Vecs of two element types: T is the
// first one's, and the second does not fit.
// ERROR: expected 'inout [i64]', got 'inout Vec<u8>'
fn both<T>(x: inout [T], y: inout [T]) -> i64 { x.len() + y.len() }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    var w: Vec<u8> = Vec::new_in(gpa);
    both(&v, &w);
}
