// Vec::get out of range fails its requires at the caller.
// EXIT: 101
// STDERR: index out of bounds: index 1, length 1
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(v.get(1 + Z));
    println("not reached");
    0
}
