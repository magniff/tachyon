// sem-own: `?` after a partial move: only the unmoved field dropped on the early return.
// EXPECT: eat 2
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: r -1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct P { a: D, b: D }
fn g() -> Result<i64, i64> { Err(-1) }

fn f(gpa: Gpa) -> Result<i64, i64> {
    let p = P { a: mk(1, gpa), b: mk(2, gpa) };
    eat(p.b);
    let n = g()?;
    Ok(n)
}

fn main(gpa: Gpa) {
    println(f"r {match f(gpa) { Ok(x) => x, Err(e) => e }}");
}
