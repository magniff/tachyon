// two scoped threads write one array element through inout: a data race
// ERROR: sync
use std::thread;
fn bump(n: inout i64) { n += 1; }

fn main() {
    var a = [0, 0];
    thread::scope(|sc| {
        let x = sc.spawn(|| { for i in 0..1000000 { bump(&a[0]); } 0 });
        let y = sc.spawn(|| { for i in 0..1000000 { bump(&a[0]); } 0 }); x.join() + y.join()
    }); println(f"{a[0]}");
}
