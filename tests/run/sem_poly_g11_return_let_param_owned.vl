// returning a let parameter: a copy for i64, but for an owned T a move out of a borrow (must be rejected)
// ERROR: [own.move_out]: cannot move 'x'
fn keep<T>(x: T) -> T { x }

fn main(gpa: Gpa) {
    println(f"{keep(5)}");
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let w = keep(v);
    println(f"{w.len()} {v.len()}");
}
