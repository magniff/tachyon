// returning an element of a let Vec<T>: fine for i64, own.move_out for T = Vec<i64>
// ERROR: [own.move_out]: cannot move 'v[0]'
fn first<T>(v: Vec<T>) -> T { v[0] }

fn main(gpa: Gpa) {
    var a: Vec<i64> = Vec::new_in(gpa);
    a.push(4);
    println(f"{first(a)}");
    var b: Vec<Vec<i64>> = Vec::new_in(gpa);
    b.push(a.clone());
    let x = first(b);
    println(f"{x.len()}");
}
