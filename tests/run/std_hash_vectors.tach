// (0.20) foldhash and SipHash-1-3, bit for bit: FixedState's FoldHasher
// against the foldhash crate (0.2.0, its fast FixedState), SipHashState
// with keys 0 and 0 against Rust's DefaultHasher, over 100000 random
// sequences of writes (u8, u16, u32, u64, and bytes of 0 to 700, through
// both of foldhash's paths); the expected values come from
// tests/std/oracle/hash_vectors.rs, the same program in Rust.
// EXPECT: 6908261415171690783 11485087932207604273 17851761772755616924
// EXPECT: 700135835039845336 16444146117739723962 17520994923203274661 14284583924638565874
// EXPECT: 13646096770106105413 2206609067086327257 11114430376347968748
// EXPECT: 13646096770106105413 13743199064115861684 3122822046900624816 15978721864741801140
// EXPECT: fold 9997316127848575358
// EXPECT: sip 1184135850818188038
// EXPECT: true true
use std::hash::{FixedState, FoldHasher, RandomState, SipHashState, SipHasher13};

fn xorshift(x: &mut u64) -> u64 {
    let mut v = *x;
    v ^= v << 13;
    v ^= v >> 7;
    v ^= v << 17;
    *x = v;
    v
}

fn feed_fold(h: &mut FoldHasher, rng: &mut u64, pool: [u8]) {
    let ops = 1 + xorshift(rng) % 5;
    for _ in 0..ops {
        let r = xorshift(rng);
        let x = xorshift(rng);
        match r % 6 {
            0 => h.write_u8(x as u8),
            1 => h.write_u16(x as u16),
            2 => h.write_u32(x as u32),
            3 => h.write_u64(x),
            4 => {
                let n = (x % 41) as i64;
                let at = ((x >> 16) % (1024 - 40)) as i64;
                h.write(pool[at..at + n]);
            }
            _ => {
                let n = (x % 701) as i64;
                let at = ((x >> 16) % (1024 - 700)) as i64;
                h.write(pool[at..at + n]);
            }
        }
    }
}

fn feed_sip(h: &mut SipHasher13, rng: &mut u64, pool: [u8]) {
    let ops = 1 + xorshift(rng) % 5;
    for _ in 0..ops {
        let r = xorshift(rng);
        let x = xorshift(rng);
        match r % 6 {
            0 => h.write_u8(x as u8),
            1 => h.write_u16(x as u16),
            2 => h.write_u32(x as u32),
            3 => h.write_u64(x),
            4 => {
                let n = (x % 41) as i64;
                let at = ((x >> 16) % (1024 - 40)) as i64;
                h.write(pool[at..at + n]);
            }
            _ => {
                let n = (x % 701) as i64;
                let at = ((x >> 16) % (1024 - 700)) as i64;
                h.write(pool[at..at + n]);
            }
        }
    }
}

fn rotl5(x: u64) -> u64 {
    (x << 5) | (x >> 59)
}

fn main() -> i32 {
    let fs = FixedState::new();
    println(f"{fs.hash_u64(0)} {fs.hash_u64(1)} {fs.hash_u64(12345)}");
    let words = ["", "a", "hello world!", "the quick brown fox jumps over the lazy dog"];
    println(
        f"{fs.hash_bytes(words[0])} {fs.hash_bytes(words[1])} {fs.hash_bytes(words[2])} {fs.hash_bytes(words[3])}");
    let ss = SipHashState::with_keys(0, 0);
    println(f"{ss.hash_u64(0)} {ss.hash_u64(1)} {ss.hash_u64(12345)}");
    println(
        f"{ss.hash_bytes(words[0])} {ss.hash_bytes(words[1])} {ss.hash_bytes(words[2])} {ss.hash_bytes(words[3])}");
    let mut rng = 0x2545f4914f6cdd1du64;
    let mut pool = [0u8; 1024];
    for i in 0..1024 {
        pool[i] = xorshift(&mut rng) as u8;
    }
    let mut fold = 0u64;
    let mut sip = 0u64;
    for _ in 0..100000 {
        let save = rng;
        let mut h = fs.build_hasher();
        feed_fold(&mut h, &mut rng, pool[..]);
        fold = rotl5(fold) ^ h.finish();
        rng = save;
        let mut s = ss.build_hasher();
        feed_sip(&mut s, &mut rng, pool[..]);
        sip = rotl5(sip) ^ s.finish();
    }
    println(f"fold {fold}");
    println(f"sip {sip}");
    // (the shortcuts agree with the hashers; random states differ)
    let mut h = fs.build_hasher();
    h.write_u64(words[3].len as u64);
    h.write(words[3]);
    let r = RandomState::new();
    let q = RandomState::new();
    println(
        f"{h.finish() == fs.hash_bytes(words[3])} {r.hash_u64(1) != q.hash_u64(1) || r.hash_bytes(words[3]) != q.hash_bytes(words[3])}");
    0
}
