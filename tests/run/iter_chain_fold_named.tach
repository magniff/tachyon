// The sources' `fold` (0.14), counted loops, with named functions as
// the function argument (a fn type satisfies an FnMut bound), and map
// with one.
// EXPECT: fold 45 55 -10 6 330
// EXPECT: map 10 2 18 | 3 | 30
use std::HashMap;

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn sub(a: i64, b: i64) -> i64 {
    a - b
}

fn add_entry(a: i64, e: (i64, i64)) -> i64 {
    a + e.0 * e.1
}

fn double(x: i64) -> i64 {
    x * 2
}

fn show(x: i64) {
    print(" ");
    std::print_int(x);
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    let mut m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(10, 3);
    m.insert(20, 15);
    print("fold");
    show((0..10).fold(0, add));
    show((1..=10).fold(0, add));
    show((1..=4).fold(0, sub));
    let mut it = v.iter();
    it.next();
    it.next();
    show(it.fold(-13, add));
    show(m.iter().fold(0, add_entry));
    println("");
    print("map");
    for x in v.iter().take(3).map(double) {
        show(x);
    }
    print(" |");
    show(v.iter().take(3).map(double).count());
    print(" |");
    show(v.iter().take(3).map(double).sum());
    println("");
    0
}
