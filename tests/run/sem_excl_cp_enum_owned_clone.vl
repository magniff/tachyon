// EXPECT: 1 2
#[derive(Clone)]
enum E { A(Vec<i64>), B }
fn len(e: E) -> i64 { match e { E::A(v) => v.len(), E::B => 0 } }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa); v.push(1);
    let a = E::A(v); var b = a.clone();
    match &b { E::A(w) => { w.push(2); } E::B => {} }
    println(f"{len(a)} {len(b)}");
}
