// The Iterator trait on std's sources and a user type (0.14), without
// closures: enumerate, zip and take, `for` over a chain (the `next`
// path), their exact_len and at, the consumers that call next, and a
// generic function bounded by Iterator. (map and filter need closures:
// iter_chain_*.)
// EXPECT: enumerate 5 101 209
// EXPECT: zip 15 12 21 | 0 1 2
// EXPECT: take 0 1 2 | 5 1 9
// EXPECT: len 3 2 8 2 3
// EXPECT: counter 4 10 1 4 | 5 6 3
// EXPECT: first 5 none
struct Counter { n: i64, limit: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(self: *Counter) -> Option<i64> {
        if self.n < self.limit {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

fn first<I: Iterator>(it: I) -> Option<I::Item> {
    let mut i = it;
    i.next()
}

fn show(x: i64) {
    print(" ");
    std::print_int(x);
}

fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    defer v.free();
    v.push(5);
    v.push(1);
    v.push(9);
    print("enumerate");
    for (i, x) in v.iter().enumerate() {
        show(i * 100 + x);
    }
    println("");
    print("zip");
    for (a, b) in v.iter().zip(10..20) {
        show(a + b);
    }
    print(" |");
    for (a, b) in (0..3).zip(v.iter()) {
        show(a);
    }
    println("");
    print("take");
    for x in (0..10).take(3) {
        show(x);
    }
    print(" |");
    for x in v.as_slice().iter().take(5) {
        show(x);
    }
    println("");
    print("len");
    show(v.iter().enumerate().exact_len());
    let mut z = v.iter().zip(7..9);
    show(z.exact_len());
    show(z.at(1).1);
    show(v.iter().take(2).exact_len());
    show((0..10).take(3).exact_len());
    println("");
    print("counter");
    show(Counter { n: 0, limit: 4 }.count());
    show(Counter { n: 0, limit: 4 }.sum());
    show(Counter { n: 0, limit: 4 }.min().unwrap());
    show(Counter { n: 0, limit: 4 }.max().unwrap());
    print(" |");
    let mut c = Counter { n: 0, limit: 6 }.collect();
    defer c.free();
    show(c.len() - 1);
    show(c.get(5));
    show(Counter { n: 0, limit: 3 }.enumerate().count());
    println("");
    print("first");
    show(first(v.iter().zip(0..=3).enumerate()).unwrap().1.0);
    if first(Counter { n: 0, limit: 0 }).is_none() {
        print(" none");
    }
    println("");
    0
}
