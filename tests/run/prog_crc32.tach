// Bitwise CRC-32 (IEEE) of a few strings.
// EXPECT: 414fa339 cbf43926 00000000
extern fn printf(format: *u8, ...) -> i32;

fn crc32(p: *u8, n: u64) -> u32 {
    let crc: u32 = 0xFFFFFFFF;
    let i: u64 = 0;
    loop {
        if i == n { break; };
        crc = crc ^ *((p as u64 + i) as *u8) as u32;
        let k = 0;
        loop {
            if k == 8 { break; };
            let mask: u32 = 0 - (crc & 1);
            crc = (crc >> 1) ^ (0xEDB88320 & mask);
            k += 1;
        }
        i += 1;
    }
    ~crc
}

fn main() -> i64 {
    let a = "The quick brown fox jumps over the lazy dog";
    let b = "123456789";
    let c = "";
    printf("%08x %08x %08x\n".0, crc32(a.0, a.1), crc32(b.0, b.1), crc32(c.0, c.1));
    0
}
