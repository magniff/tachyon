// Bitwise CRC-32 (IEEE) of a few strings.
// EXPECT: 414fa339 cbf43926 00000000
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn crc32(p: *u8, n: u64) -> u32 {
    var crc: u32 = 0xFFFFFFFF;
    var i: u64 = 0;
    while i != n {
        unsafe { crc = crc ^ p[i] as u32; }
        var k = 0;
        while k != 8 {
            let mask: u32 = 0 - (crc & 1);
            crc = (crc >> 1) ^ (0xEDB88320 & mask);
            k += 1;
        }
        i += 1;
    }
    ~crc
}

fn main() -> i64 {
    let a = "The quick brown fox jumps over the lazy dog";
    let b = "123456789";
    let c = "";
    unsafe {
        printf(c"%08x %08x %08x\n", crc32(&*a.ptr, (a.len as u64)), crc32(&*b.ptr, (b.len as u64)),
            crc32(&*c.ptr, (c.len as u64)));
    }
    0
}
