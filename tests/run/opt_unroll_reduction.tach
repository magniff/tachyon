// 0.15: the run-time unroller keeps a reduction on one accumulator per
// copy (unroll.tach's split_reduction), combined after the unrolled loop:
// the copies then run side by side instead of each waiting for the one
// before. Sums (and differences), products, xor, and, or of integers that
// wrap (i32 here), through conditional updates too, and a maximum of
// unsigned numbers (no vector comparison: the selects combine). Every
// length from 0 to 20; integer arithmetic wraps, so the order of the
// operations does not change the results.
// EXPECT: 0 7 1 0 -1 0 3 0
// EXPECT: 1500003 -1381308482 -1000001 -18500037 -18500037 1584 3 0
// EXPECT: 1644407 -1711596486 144403144403 20089525 -20630517 3760 12105675798371893251 0
// EXPECT: 1288810 -1319824311 102698794283691585 33179732 12582913 3824 12105675798371893251 0
// EXPECT: 1288810 1213501056 3093937766555885187 -25166383 8388609 4080 12105675798371893251 0
// EXPECT: 1500002 -2016175040 -8233631171909972909 -32979447 1 4080 13835058055282163724 211192
// EXPECT: 777978 -1953108688 1973513429751283355 20768885 1 4080 13835058055282163724 -510832
// EXPECT: 978339 -1253203553 8083565718181551485 18439354 1 4080 13835058055282163724 -310471
// EXPECT: -505419 -245419941 8585496215326290849 944024 1 4080 15564440312192434197 -310471
// EXPECT: -350183 -949805961 7754339338344311485 -2471330 1 4080 15564440312192434197 -310471
// EXPECT: -700364 758559446 1779512229061957343 -14680505 1 4080 15564440312192434197 -310471
// EXPECT: -700364 1905944477 1221387605504650541 10311930 1 4080 17293822569102704670 -310471
// EXPECT: -494588 -1018980707 -8042800329837435827 15300074 1 4080 17293822569102704670 -104695
// EXPECT: -1227444 941270285 -7911173104156657931 -2594210 1 4080 17293822569102704670 -837551
// EXPECT: -1043331 934084012 -4512283429867358493 -340903 1 4080 17293822569102704670 -653438
// EXPECT: -2510841 -1369499832 -6218548207449520305 -17899517 1 4080 17293822569102704670 -653438
// EXPECT: -2344773 502147716 -8428311962339628093 20971261 1 4080 17293822569102704670 -653438
// EXPECT: -2689538 -2112696653 9004485967009371569 33381292 1 4080 17293822569102704670 -653438
// EXPECT: -2689538 598879626 -62344779360823757 -24982439 1 4080 17293822569102704670 -653438
// EXPECT: -2489178 928836938 -5970854445923840733 -17575407 1 4080 17293822569102704670 -453078
// EXPECT: -3232866 -853530438 1937134621206853899 31310589 1 4080 17293822569102704670 -1196766
// CHECK: fn dot:
// CHECK: +24
// CHECK: cmp.ne
// CHECK: cmp.eq
// CHECK: i64 = add
// CHECK: i64 = add
// CHECK: i64 = add
// CHECK: fn umax:
// CHECK: +24
// CHECK: cmp.ne
// CHECK: cmp.eq
// CHECK: sel
// CHECK: sel
// CHECK: sel
// CHECK: fn main:
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn dot(a: [i64], b: [i64]) -> i64 {
    let mut t = 0;
    for k in 0..a.len {
        t += a[k] * b[k];
    }
    t
}

#[inline(never)]
fn negdot(a: [i32], b: [i32]) -> i32 {
    let mut t: i32 = 7;
    for k in 0..a.len {
        t -= a[k] * b[k];
    }
    t
}

#[inline(never)]
fn product(a: [i64]) -> i64 {
    let mut t = 1;
    for k in 0..a.len {
        t *= a[k] * 2 + 1;
    }
    t
}

#[inline(never)]
fn bits(a: [i64], x: &mut i64, y: &mut i64, z: &mut i64) {
    let mut p = 0;
    let mut q = -1;
    let mut r = 0;
    for k in 0..a.len {
        let v = a[k] * 37;
        p ^= v;
        q &= v | 1;
        r |= v & 4080;
    }
    unsafe {
        *x = p;
        *y = q;
        *z = r;
    }
}

#[inline(never)]
fn umax(a: [u64]) -> u64 {
    let mut m: u64 = 3;
    for k in 0..a.len {
        let x = a[k] * 3;
        if x > m {
            m = x;
        }
    }
    m
}

#[inline(never)]
fn filtered(a: [i64], b: [i64]) -> i64 {
    let mut t = 0;
    for k in 0..a.len {
        if b[k] > 0 {
            t += a[k] * b[k];
        }
    }
    t
}

fn main() -> i32 {
    let mut a: [i64; 20] = [0; 20];
    let mut b: [i64; 20] = [0; 20];
    let mut c: [i32; 20] = [0; 20];
    let mut u: [u64; 20] = [0; 20];
    for i in 0..20 {
        a[i] = (i * 2654435761) % 1000003 - 500001;
        b[i] = i % 7 - 3;
        c[i] = (a[i] * 4099) as i32;
        u[i] = ((i * 7 % 20) as u64 << 59) | i as u64;
    }
    for n in 0..21 {
        let mut x = 0;
        let mut y = 0;
        let mut z = 0;
        bits(a[0..n], &mut x, &mut y, &mut z);
        unsafe {
            printf(c"%ld %d %ld %ld %ld %ld %lu %ld\n", dot(a[0..n], b[0..n]),
                negdot(c[0..n], c[0..n]), product(a[0..n]), x, y, z, umax(u[0..n]),
                filtered(a[0..n], b[0..n]));
        }
    }
    0
}
