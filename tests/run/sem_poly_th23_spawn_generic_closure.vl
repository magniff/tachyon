// a generic function spawning a thread that calls F: instantiated with a closure borrowing a local
// ERROR: [sync.not_send]: 'thread::spawn' moves 'f'
use std::thread;

fn go<F: Fn() -> i64>(f: sink F) -> i64 {
    let h = thread::spawn(sink || f());
    h.join()
}

fn main() {
    var n = 3;
    println(f"{go(|| n)}");
}
