// Recursive quicksort (Lomuto) over an array of pseudo-random numbers.
// EXPECT: 1 -500 -500 -17 498
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn at(a: *i64, i: i64) -> *i64 { unsafe { &a[i] } }

fn swap(a: *i64, i: i64, j: i64) {
    let t = unsafe { *at(a, i) };
    unsafe {
        *at(a, i) = *at(a, j);
        *at(a, j) = t;
    }
}

fn partition(a: *i64, lo: i64, hi: i64) -> i64 {
    let pivot = unsafe { *at(a, hi) };
    var i = lo;
    var j = lo;
    while j < hi {
        if unsafe { *at(a, j) < pivot } {
            swap(a, i, j);
            i += 1;
        }
        j += 1;
    }
    swap(a, i, hi);
    i
}

fn quicksort(a: *i64, lo: i64, hi: i64) {
    if lo < hi {
        let p = partition(a, lo, hi);
        quicksort(a, lo, p - 1);
        quicksort(a, p + 1, hi);
    }
}

fn main() -> i64 {
    var data: [i64; 200] = [0; 200];
    var seed: u64 = 12345;
    var i = 0;
    while i != 200 {
        seed = seed * 6364136223846793005 + 1442695040888963407;
        data[i] = ((seed >> 33) % 1000) as i64 - 500;
        i += 1;
    }
    let base = &data as *i64;
    unsafe { quicksort(base, 0, 199); }
    var ok = true;
    i = 1;
    while i != 200 {
        if data[i - 1] > data[i] { ok = false; }
        i += 1;
    }
    unsafe { printf(c"%d %ld %ld %ld %ld\n", ok, data[0], data[1], data[100], data[199]); }
    0
}
