// Recursive quicksort (Lomuto) over an array of pseudo-random numbers.
// EXPECT: 1 -500 -500 -17 498
extern fn printf(format: *u8, ...) -> i32;

fn at(a: *i64, i: i64) -> *i64 { (a as u64 + (i * 8) as u64) as *i64 }

fn swap(a: *i64, i: i64, j: i64) {
    let t = *at(a, i);
    *at(a, i) = *at(a, j);
    *at(a, j) = t;
}

fn partition(a: *i64, lo: i64, hi: i64) -> i64 {
    let pivot = *at(a, hi);
    let i = lo;
    let j = lo;
    loop {
        if j >= hi { break; };
        if *at(a, j) < pivot {
            swap(a, i, j);
            i += 1;
        };
        j += 1;
    }
    swap(a, i, hi);
    i
}

fn quicksort(a: *i64, lo: i64, hi: i64) {
    if lo < hi {
        let p = partition(a, lo, hi);
        quicksort(a, lo, p - 1);
        quicksort(a, p + 1, hi);
    };
}

fn main() -> i64 {
    let data: [i64; 200] = [0; 200];
    let seed: u64 = 12345;
    let i = 0;
    loop {
        if i == 200 { break; };
        seed = seed * 6364136223846793005 + 1442695040888963407;
        data[i] = ((seed >> 33) % 1000) as i64 - 500;
        i += 1;
    }
    let base = &data as *i64;
    quicksort(base, 0, 199);
    let ok = true;
    i = 1;
    loop {
        if i == 200 { break; };
        if data[i - 1] > data[i] { ok = false; };
        i += 1;
    }
    printf("%d %ld %ld %ld %ld\n".0, ok, data[0], data[1], data[100], data[199]);
    0
}
