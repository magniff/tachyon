// Block layout (0.6): a block that calls a `#[cold]` function is cold,
// laid out after the function's hot path (which falls through to its
// return). The frame is set up on the cold path only.
// EXPECT: error 7 (7 7 7)
// EXPECT: 10 -1
// EXPECT: error 3 (3 3 3)
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

// (Called twice, and large: not inlined.)
#[cold]
fn report(code: i64) -> i64 {
    let a = code * 3;
    let b = a / 3;
    let c = b + a - a;
    unsafe { printf(c"error %ld (%ld %ld %ld)\n", code, b, c, a / 3); }
    let mut k = 0;
    while k < code / 1000 {
        unsafe {
            printf(c"%ld %ld %ld %ld %ld %ld\n", k, k + 1, k + 2, k + 3, k * 7, k * 11);
            printf(c"%ld %ld %ld %ld %ld %ld\n", k, k - 1, k - 2, k - 3, k / 7, k % 11);
            printf(c"%ld %ld %ld %ld %ld %ld\n", k, k ^ 1, k | 2, k & 3, k << 2, k >> 1);
        }
        k += 1;
    }
    -1
}

fn check(x: i64) -> i64 {
    if x < 0 {
        return report(0 - x);
    }
    x * 2
}

fn main() -> i32 {
    let c: fn(i64) -> i64 = check;
    let a = c(5);
    let b = c(-7);
    unsafe { printf(c"%ld %ld\n", a, b); }
    report(3);
    0
}

// ASM(aarch64-macos): check:
// ASM-NOT(aarch64-macos): stp x29
// ASM(aarch64-macos): lsl x0, x0, #1
// ASM(aarch64-macos): ret
// ASM(aarch64-macos): stp x29
// ASM(aarch64-macos): _tachyon.report
