// A u64 index of 2^64 - 1 (-1 as i64) is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 3
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3];
    let i: u64 = 18446744073709551615 + Z as u64;
    println(a[i]);
    println("not reached");
    0
}
