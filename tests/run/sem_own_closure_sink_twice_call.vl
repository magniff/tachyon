// sem-own: a sink closure moving its capture out, called twice: the second
// call stops (exit 101), not a double drop.
// EXIT: 101
// EXPECT: drop 1
// EXPECT: first 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let d = mk(1, gpa);
    var f = sink || { let i = d.id; drop(d); i };
    println(f"first {f()}");
    println(f"second {f()}");
}
