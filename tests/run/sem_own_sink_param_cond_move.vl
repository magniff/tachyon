// sem-own: a sink parameter moved on one path: dropped on the other (drop flag).
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: keep 2
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn f(d: sink D, c: bool) { if c { eat(d); } else { println(f"keep {d.id}"); } }

fn main(gpa: Gpa) {
    f(mk(1, gpa), true);
    f(mk(2, gpa), false);
}
