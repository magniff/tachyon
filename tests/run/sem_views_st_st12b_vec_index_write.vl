// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: v[0] written while a slice of v is used
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let sl = v.as_slice();
    v[0] = 9;
    println(sl[0]);
    0
}
