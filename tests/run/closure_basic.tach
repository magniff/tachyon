// 0.14: closures: captures, calls, parameters from the context.
// EXPECT: 11
// EXPECT: 5 42 2
// EXPECT: 42 81
// EXPECT: 111 103
// EXPECT: 7
fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
    f(x)
}

fn call(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

struct Holder<F> {
    f: F,
}

fn main() -> i64 {
    let k = 10;
    std::print_int(apply(| x | x + k, 1));
    println("");
    // written types, a pattern parameter, a field holding a closure
    let add = | a: i64, b: i64 | a + b;
    let pair = | (a, b): (i64, i64) | a * b;
    let h = Holder { f: | x: i64 | x - 1 };
    std::print_int(add(2, 3));
    print(" ");
    std::print_int(pair((6, 7)));
    print(" ");
    std::print_int((h.f)(3));
    println("");
    // a closure that captures nothing is a plain `fn`
    std::print_int(call(| x | x * 2, 21));
    print(" ");
    let sq = | x: i64 | x * x;
    let fp: fn(i64) -> i64 = sq;
    std::print_int(fp(9));
    println("");
    // nested closures, and a `move` closure leaving the block it is made in
    let outer = | x: i64 | {
        let inner = | y: i64 | x + y + k;
        inner(100)
    };
    let plus = {
        let j = k - 7;
        move | x: i64 | x + j + 90
    };
    std::print_int(outer(1));
    print(" ");
    std::print_int(plus(10));
    println("");
    // `return` returns from the closure
    let first = | x: i64 | -> i64 {
        if x > 5 {
            return 7;
        }
        x
    };
    std::print_int(first(9));
    println("");
    0
}
