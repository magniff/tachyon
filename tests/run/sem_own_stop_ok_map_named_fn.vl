// sem-own (iterator stopgap): a named let fn given to map: should be accepted (the 0.24 notes list it as a known overbreadth).
// XFAIL: DIAG/OVERSTRICT a let fn refused for map: the message prints the bound as FnMut(D), not FnMut(sink D)
// EXPECT: 3
// EXPECT: drop 1
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn two(gpa: Gpa) -> Vec<D> {
    var w: Vec<D> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn idof(d: D) -> i64 { d.id }
impl Clone for D { fn clone(self) -> D { D { id: self.id + 100, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let w = two(gpa);
    let s: i64 = w.iter().map(idof).sum();
    println(f"{s}");
}
