// sem-own: a trait method `fn put(inout self, x: sink Self::Item)` through a generic: the item dropped once.
// EXPECT: n 1
// EXPECT: drop 7
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
trait Sinkish { type Item; fn put(inout self, x: sink Self::Item); fn n(self) -> i64; }
struct Bag { v: Vec<D> }

impl Sinkish for Bag {
    type Item = D;
    fn put(inout self, x: sink D) { self.v.push(x); } fn n(self) -> i64 { self.v.len() }
}

fn fill<S: Sinkish>(s: inout S, x: sink S::Item) { s.put(x); }

fn main(gpa: Gpa) {
    var b = Bag { v: Vec::new_in(gpa) };
    fill(&b, mk(7, gpa));
    println(f"n {b.n()}");
}
