// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello (through a fn value)
// EXPECT: hello
// EXPECT: 7
struct E { name: [u8; 8], len: i64 }
fn nm(e: E) -> [u8] { e.name[..e.len] }
fn clobber() -> i64 { let z = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 };
    let g: fn(E) -> [u8] = nm;
    let n = g(e);
    let k = clobber();
    println(n);
    println(k);
    0
}
