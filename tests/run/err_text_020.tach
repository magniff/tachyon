// 0.20 (B5, B6): text's errors name the form to write: bytes become a
// `str` only checked (`as str` and a literal that is not UTF-8 are
// errors), the Rust forms that allocate are alloc.explicit with the `_in`
// form, a String goes where a `str` does as itself (a temporary one
// through `.as_str()`), and a `str` method on bytes says what `str` is.
// ERROR: 'as str' does not check that bytes are UTF-8
// ERROR: try: str::from_utf8(b)?
// ERROR: '"\xff"' is '[u8]' where 'str' goes
// ERROR: try: str::from_utf8("\xff")?
// ERROR: try: String::new_in(gpa)
// ERROR: try: to_uppercase_in(gpa)
// ERROR: expected 'str', got 'String'
// ERROR: try: (owned.clone()).as_str()
// ERROR: try: collect_in(gpa)
// ERROR: try: get_in(name, gpa)
// ERROR: 'env::var' is Rust's name; std's is 'env::get'
// ERROR: no method 'trim_start' on type '[u8]'
// ERROR: help: `[u8]` is bytes; text is `str` (UTF-8)
// ERROR-COUNT: 9
fn shout(s: str) -> i64 { s.len() }

fn main(gpa: Gpa) -> i32 {
    let b: [u8] = "abc";
    let t = b as str;
    let u: str = "\xff";
    let s = String::new();
    let up = "abc".to_uppercase();
    let owned = String::from_in("x", gpa);
    let n = shout(owned) + shout(owned.clone());
    let w = "a b".split_whitespace().collect();
    let v = std::env::get("HOME");
    let r = std::env::var("PATH");
    let m = b.trim_start();
    0
}
