// sem-own: Iterator's provided methods take `self` (let), but consume the
// iterator by calling `next(inout self)` on a bit copy of it. A user
// iterator that owns a Vec is then freed twice: by the consumer (the copy)
// and at its own scope end. --check-alloc: double free; -O2: abort.
// XFAIL: SOUNDNESS a let-self Iterator method (count, collect_in, take, ...) on an owning user iterator frees it twice
// EXPECT: n 2
struct Pop { v: Vec<i64> }
impl Iterator for Pop { type Item = i64; fn next(inout self) -> Option<i64> { self.v.pop() } }

fn main(gpa: Gpa) {
    var p = Pop { v: Vec::new_in(gpa) };
    p.v.push(1);
    p.v.push(2);
    let n = p.count();
    println(f"n {n}");
}
