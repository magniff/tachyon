// match &e binds inout; arms change the payload; the scrutinee is used after
// EXPECT: 11 5
enum E { A(i64), B(i64, i64) }
fn get(e: E) -> i64 { match e { E::A(n) => n, E::B(a, b) => a + b } }
fn main() { var e = E::A(1); var f = E::B(2, 2); match &e { E::A(n) => { n += 10; } E::B(a, b) => { a += 1; } } match &f { E::A(n) => { n += 10; } E::B(a, b) => { a += 1; } } println(f"{get(e)} {get(f)}"); }
