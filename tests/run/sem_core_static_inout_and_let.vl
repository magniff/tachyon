// an inout and a let access of one static: f(&G, G) overlaps.
// FLAGS: -O2
// EXPECT: 1
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn f(x: inout Big, y: Big) -> i64 { x.a = 10; y.a }

fn main() -> i32 { println(f(&G, G)); 0 }
