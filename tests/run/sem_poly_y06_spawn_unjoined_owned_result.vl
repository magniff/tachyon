// a detached thread's owned result: dropped once (or the process ends); no double free
// FLAGS: --check-alloc
// EXPECT: 1
use std::thread;

fn main(gpa: Gpa) {
    let h = thread::spawn(sink || { var v: Vec<i64> = Vec::new_in(gpa); v.push(1); v });
    let v = h.join();
    println(f"{v.len()}");
}
