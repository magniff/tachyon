// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.escape: inout result into a local
// ERROR: error[own.escape]
fn mid(v: inout Vec<i64>, gpa: Gpa) -> inout [i64] { var w: Vec<i64> = Vec::new_in(gpa); w.push(1); &w[0..1] }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    let m = mid(&v, gpa);
    m[0] = 5;
    0
}
