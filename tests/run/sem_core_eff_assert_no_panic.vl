// assert may fail and stop the program (exit 101): a #[no_panic] function
// with one must be rejected. It is accepted (its effects are unknown).
// XFAIL: WRONG #[no_panic] with an assert is accepted
// ERROR: 'calm' is #[no_panic], but it may panic
#[no_panic]
fn calm(x: i64) -> i64 { assert(x > 0); x }

fn main() -> i32 {
    println(calm(4));
    println(calm(0));
    0
}
