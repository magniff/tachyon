// sem-own: while let on a var Option moved and assigned each iteration: each value once.
// EXPECT: it 1
// EXPECT: drop 1
// EXPECT: it 2
// EXPECT: drop 2
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var o: Option<D> = Some(mk(1, gpa));
    var n = 1;
    while let Some(d) = o {
        println(f"it {d.id}");
        n += 1;
        o = if n < 3 { Some(mk(n, gpa)) } else { None };
    }
    println("end");
}
