// A requires about self.items.len() goes stale after the body pops.
// EXIT: 101
// STDERR: index out of bounds: index 1, length 1
static var Z: i64 = 0;

struct Stack { items: Vec<i64> }

impl Stack {
    #[inline(never)]
    fn second_pop(inout self, i: i64) -> i64
        requires 0 <= i && i < self.items.len()
    {
        self.items.pop();
        self.items[i]
    }
}

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var s = Stack { items: Vec::new_in(gpa) };
    s.items.push(1); s.items.push(2);
    println(s.second_pop(1 + Z));
    0
}
