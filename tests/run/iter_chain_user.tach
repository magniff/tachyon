// A user type implementing Iterator gets the trait's adapters and
// consumers (0.14); closures that change captured variables; HashMap
// chains; sort_by with a closure on a Vec and on a slice.
// XFAIL: until closures (T1) are merged and compiler/std/iter_t1t2.tach replaces iter.tach
// EXPECT: counter 55 5 15
// EXPECT: for_each 10 3
// EXPECT: map 50 3 20
// EXPECT: sorted 9 7 5 3 2 1 | 1 2 3 5 7 9 | 90 70 50
use std::HashMap;

struct Counter { n: i64, limit: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(self: *Counter) -> Option<i64> {
        if self.n < self.limit {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

fn show(label: [u8], x: i64) {
    print(label);
    std::print_int(x);
}

fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    defer v.free();
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    v.push(2);

    show("counter ", Counter { n: 0, limit: 5 }.map(| x | x * x).sum());
    show(" ", Counter { n: 0, limit: 5 }.zip(v.iter()).count());
    show(" ", Counter { n: 0, limit: 5 }.fold(0, | a, x | a + x));
    println("");

    let mut total = 0;
    let mut calls = 0;
    (0..5).for_each(| x | total += x);
    v.iter().take(3).for_each(| x | calls += 1);
    show("for_each ", total);
    show(" ", calls);
    println("");

    let mut m: HashMap<i64, i64> = HashMap::new();
    defer m.free();
    m.insert(1, 10);
    m.insert(2, 20);
    show("map ", m.iter().map(| (k, x) | k * x).sum());
    show(" ", m.keys().sum());
    show(" ", m.values().max().unwrap());
    println("");

    print("sorted");
    v.sort_by(| a, b | b.cmp(a));
    for x in v {
        show(" ", x);
    }
    print(" |");
    v.as_slice().sort_by(| a, b | *a - *b);
    for x in v {
        show(" ", x);
    }
    print(" |");
    let mut w = v.iter().map(| x | x * 10).collect();
    defer w.free();
    w.sort_by(| a, b | b.cmp(a));
    for x in w.iter().take(3) {
        show(" ", x);
    }
    println("");
    0
}
