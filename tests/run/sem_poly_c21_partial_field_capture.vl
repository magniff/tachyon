// a closure capturing var p (inout) while p.y is assigned: p is the captured variable
// ERROR: [own.conflict]: 'p.y = 30' writes 'p' while 'c'
struct P { x: i64, y: i64 }

fn main() {
    var p = P { x: 1, y: 2 };
    let c = || { p.x += 1; };
    p.y = 30;
    c();
    println(f"{p.x} {p.y}");
}
