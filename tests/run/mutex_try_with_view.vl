// try_with's closure returns a view of the locked data
// ERROR: [sync.view_item]: the closure given to the lock returns [i64], a view
use std::sync::Mutex;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let s = m.try_with(|d| d.as_slice());
    println(f"{s.is_some()}");
}
