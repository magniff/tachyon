// 0.17 (value semantics, T2): own.static (a view of a static across a
// call that writes statics) and own.readonly (a write through '&T' or
// '[T]'). 0.20: a let parameter of a plain type is a copy, so 'p' is a Vec.
// FLAGS: --values=error
// ERROR: writes through 's', a '[i64]'
// ERROR: writes through 'p', a 'let Vec<i64>'
// ERROR: 'intern(5)' writes statics (its effects include global) while 't'
static var TABLE: [i64; 4] = [1, 2, 3, 4];
static var COUNT: i64 = 0;

fn intern(x: i64) -> i64 {
    unsafe {
        COUNT += 1;
        TABLE[0] = x;
    }
    COUNT
}

fn zero(s: [i64]) { s[0] = 0; }
fn set(p: Vec<i64>, q: sink Vec<i64>) { p = q; }

fn main(gpa: Gpa) {
    unsafe {
        let t = TABLE[..];
        intern(5);
        println(f"{t[0]}");
    }
    var a = [1, 2];
    zero(a[..]);
    var b: Vec<i64> = Vec::new_in(gpa);
    set(b, Vec::new_in(gpa));
    println(f"{a[0]} {b.len()}");
}
