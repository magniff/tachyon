// 0.17: `.len` and `.len()` are both the length: on std's Vec, Buf and
// HashMap (`v.len` reads as `v.len()`; their field is sealed or absent),
// on a slice (`s.len()` is the field) and on an array place.
// EXPECT: 3 3 3 3 2 2 1 1 4 4 3
fn total(v: &Vec<i64>) -> i64 {
    v.len + v.len()
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    let mut b = Buf::new_in(gpa);
    b.push_str("ab");
    let mut m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(7, 1);
    let s = "abcd";
    let a = [1, 2, 3];
    println(
        f"{v.len} {v.len()} {v.as_slice().len()} {v.as_slice().len} {b.len} {b.len()} {m.len} {m.len()} {s.len} {s.len()} {a.len}");
    if total(&v) != 6 || a.len != a.len() { return 1; }
    0
}
