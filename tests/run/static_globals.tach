// Global variables: `static` and `static mut` with constant initializers
// (scalars, arrays, structs, tuples, pointers).
// EXPECT: 115 17 -3 0.25 ok 7 42 8
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct Config { level: i32, ratio: f64, name: (u8, u8) }

const N: u64 = 4;
static mut COUNTER: i64 = 0;
static PRIMES: [i64; N] = [2, 3, 5, 7];
static CONFIG: Config = Config { ratio: 0.25, level: -3, name: ('o', 'k') };
static mut TABLE: [u8; 2 * N] = [7; 2 * N];
static mut TARGET: *i64 = 0 as *i64;

fn bump(by: i64) -> i64 {
    COUNTER += by;
    COUNTER
}

fn main() -> i64 {
    bump(5);
    bump(10);
    let mut sum = 0;
    for i in 0..N { sum += PRIMES[i]; }
    TABLE[3] = 42;
    let p = &TABLE[0];
    p[7] += 1;
    TARGET = &COUNTER;
    *TARGET += 100;
    printf(
        c"%ld %ld %d %.2f %c%c %d %d %d\n",
        COUNTER, sum, CONFIG.level, CONFIG.ratio, CONFIG.name.0 as i32, CONFIG.name.1 as i32,
        TABLE[0] as i32, TABLE[3] as i32, TABLE[7] as i32,
    );
    0
}
