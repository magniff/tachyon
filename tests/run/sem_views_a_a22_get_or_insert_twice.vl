fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    let a = m.get_or_insert(1, 0);
    let b = m.get_or_insert(2, 0);
    a[0] += 1;
    b[0] += 1;
    println(m.len());
    0
}
