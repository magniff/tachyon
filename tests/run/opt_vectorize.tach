// CHECK: fn sum_i32:
// CHECK: v4i32 = load
// CHECK: vbin.add
// CHECK: vsum
// CHECK: fn sum_u8:
// CHECK: v16i8 = load
// CHECK: fn xor_i64:
// CHECK: vbin.xor
// CHECK: fn prod_i32:
// CHECK: vbin.mul
// CHECK: fn axpy:
// CHECK: v2f64 = load
// CHECK: vbin.mul
// CHECK: vbin.add
// CHECK: store
// CHECK: fn scale_f32:
// CHECK: vneg
// CHECK: vbin.div
// CHECK: fn fill:
// CHECK: vsplat
// CHECK: fn stencil:
// CHECK: v2f64 = load
// CHECK: fn copy_shift:
// CHECK: v4i32 = load
// 0.10: loops the vectorizer takes (and some it must not), compared at
// every level.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn sum_i32(s: [i32]) -> i32 {
    let mut t: i32 = 0;
    for i in 0..s.len as i64 {
        t += s[i];
    }
    t
}

#[inline(never)]
fn sum_u8(s: [u8]) -> u8 {
    let mut t: u8 = 0;
    for i in 0..s.len as i64 {
        t += s[i];
    }
    t
}

#[inline(never)]
fn xor_i64(s: [i64]) -> i64 {
    let mut t: i64 = 77;
    for i in 0..s.len as i64 {
        t ^= s[i];
    }
    t
}

#[inline(never)]
fn and_or(s: [u16]) -> u64 {
    let mut a: u16 = 65535;
    let mut o: u16 = 0;
    for i in 0..s.len as i64 {
        a &= s[i];
        o |= s[i];
    }
    (a as u64) << 16 | o as u64
}

#[inline(never)]
fn prod_i32(s: [i32]) -> i32 {
    let mut p: i32 = 1;
    for i in 0..s.len as i64 {
        p *= s[i];
    }
    p
}

#[inline(never)]
fn sub_i16(s: [i16]) -> i16 {
    let mut t: i16 = 1000;
    for i in 0..s.len as i64 {
        t -= s[i];
    }
    t
}

#[inline(never)]
fn axpy(a: f64, x: [f64], y: [f64]) {
    for i in 0..x.len as i64 {
        y[i] = y[i] + a * x[i];
    }
}

#[inline(never)]
fn scale_f32(x: [f32], k: f32, out: [f32]) {
    for i in 0..out.len as i64 {
        out[i] = -(x[i] * k) / (x[i] + 1.0);
    }
}

#[inline(never)]
fn fill(s: [i8], v: i8) {
    for i in 0..s.len as i64 {
        s[i] = v;
    }
}

#[inline(never)]
fn stencil(src: [f64], dst: [f64], n: i64) {
    for j in 1..n - 1 {
        dst[j] = 0.25 * (src[j - 1] + src[j + 1] + 2.0 * src[j]);
    }
}

#[inline(never)]
fn copy_shift(a: [i32], b: [i32]) {
    for i in 0..a.len as i64 {
        b[i] = a[i] + 1;
    }
}

fn main() -> i32 {
    let mut ints: [i32; 37] = [0; 37];
    for i in 0..37 {
        ints[i] = (i * 7919 % 1000 - 500) as i32;
    }
    for n in 0..37 {
        unsafe { printf(c"%d,", sum_i32(ints[0..n])); }
    }
    unsafe { printf(c"\n%d\n", prod_i32(ints[3..20])); }
    let mut bytes: [u8; 100] = [0; 100];
    for i in 0..100 {
        bytes[i] = (i * 37 + 11) as u8;
    }
    for start in 0..5 {
        unsafe { printf(c"%d,", sum_u8(bytes[start..100 - start]) as i32); }
    }
    let mut longs: [i64; 9] = [0; 9];
    for i in 0..9 {
        longs[i] = i * 1234567 - 99;
    }
    let mut halves: [u16; 21] = [0; 21];
    let mut shorts: [i16; 21] = [0; 21];
    for i in 0..21 {
        halves[i] = (65535 - i * 3) as u16;
        shorts[i] = (i * 1111) as i16;
    }
    unsafe { printf(c"\n%ld %lx %d\n", xor_i64(longs[0..9]), and_or(halves[0..21]), sub_i16(shorts[0..21]) as i32); }
    let mut x: [f64; 13] = [0.0; 13];
    let mut y: [f64; 13] = [0.0; 13];
    for i in 0..13 {
        x[i] = i as f64 * 0.5;
        y[i] = 1.0 / (i as f64 + 1.0);
    }
    axpy(3.0, x[0..13], y[0..13]);
    // Overlapping: y shifted by one against itself.
    axpy(0.5, y[0..12], y[1..13]);
    axpy(2.0, y[1..13], y[0..12]);
    for i in 0..13 {
        unsafe { printf(c"%.17g,", y[i]); }
    }
    let mut f: [f32; 11] = [0.0; 11];
    let mut g: [f32; 11] = [0.0; 11];
    for i in 0..11 {
        f[i] = i as f32 - 4.5;
    }
    scale_f32(f[0..11], 1.25, g[0..11]);
    scale_f32(f[0..10], 0.75, f[1..11]);
    unsafe { printf(c"\n"); }
    for i in 0..11 {
        unsafe { printf(c"%.9g/%.9g,", g[i] as f64, f[i] as f64); }
    }
    let mut cs: [i8; 40] = [0; 40];
    fill(cs[3..38], -7);
    let mut t = 0;
    for i in 0..40 {
        t = t * 3 + cs[i] as i64;
    }
    unsafe { printf(c"\n%ld\n", t); }
    let mut grid: [f64; 30] = [0.0; 30];
    let mut out: [f64; 30] = [0.0; 30];
    for i in 0..30 {
        grid[i] = (i * i % 7) as f64;
    }
    stencil(grid[0..30], out[0..30], 30);
    stencil(out[0..30], out[0..30], 30);
    stencil(grid[0..30], grid[1..30], 29);
    for i in 0..30 {
        unsafe { printf(c"%g/%g,", out[i], grid[i]); }
    }
    let mut a: [i32; 20] = [0; 20];
    for i in 0..20 {
        a[i] = i as i32;
    }
    copy_shift(a[0..19], a[1..20]);
    unsafe { printf(c"\n%d %d %d\n", a[0], a[10], a[19]); }
    // A check that fails part way: the stores before it happen.
    let mut short: [i32; 6] = [0; 6];
    copy_shift(a[0..10], short[0..6]);
    0
}
