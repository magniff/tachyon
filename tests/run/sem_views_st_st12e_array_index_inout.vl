// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: an array element String grown while a view into it is used
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var a = [String::from_in("hello", gpa), String::from_in("x", gpa)];
    let w = a[0].as_str();
    a[0].push_str(
        "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(w);
    0
}
