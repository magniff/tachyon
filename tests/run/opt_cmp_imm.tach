// Comparisons whose result is a value (not fused into a branch) compare
// with an immediate when the constant fits (0.6): no register holds the
// constant. A jump table over cases that start at 0 is indexed by the
// value itself.
// EXPECT: 1 0 1 0 1
// EXPECT: 30 31 32 33 34 -1
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn flags(x: i64, y: u64) -> i64 {
    let a = (x == 7) as i64;
    let b = (x < -3) as i64;
    let c = (y >= 100) as i64;
    a * 100 + b * 10 + c
}

fn code(op: i64) -> i64 {
    match op {
        0 => 30,
        1 => 31,
        2 => 32,
        3 => 33,
        4 => 34,
        _ => -1,
    }
}

fn main() -> i32 {
    let f: fn(i64, u64) -> i64 = flags;
    let g: fn(i64) -> i64 = code;
    printf(c"%ld %ld %ld %ld %ld\n", f(7, 3) / 100, f(0, 0), f(-5, 0) / 10, f(3, 99), f(9, 100));
    printf(c"%ld %ld %ld %ld %ld %ld\n", g(0), g(1), g(2), g(3), g(4), g(77));
    0
}

// ASM(aarch64-macos): flags:
// ASM(aarch64-macos): cmp x0, #7
// ASM(aarch64-macos): cmn x0, #3
// ASM(aarch64-macos): cmp x1, #100
// ASM(aarch64-macos): code:
// ASM(aarch64-macos): cmp x0, #4
// ASM(aarch64-macos): ldrsw x16, [x17, x0, lsl #2]
// ASM(x86_64-linux): flags:
// ASM(x86_64-linux): cmpq $7, %rdi
// ASM(x86_64-linux): cmpq $100, %rsi
// ASM(x86_64-macos): code:
// ASM(x86_64-macos): cmpq $4, %rdi
// ASM(x86_64-macos): movslq (%r10,%rdi,4), %r11
