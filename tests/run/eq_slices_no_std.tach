// EXIT: 0
// 0.14: == on slices is the compiler's own (length, then each element),
// like arrays: a program that names nothing of std (so std is not
// loaded) compares `[u8]`, `[i64]`, slices of slices, and structs and
// enums holding them. Each check that fails sets a bit of the exit code.
struct Named { name: [u8], ns: [i64] }

enum Tok { Word([u8]), Num(i64) }

fn bit(ok: bool, k: i64) -> i64 {
    if ok { 0 } else { 1 << k }
}

fn main() -> i64 {
    let text = "add sub add";
    let a = text[0..3];
    let b = text[8..11];
    let c = text[4..7];
    let mut bad = bit(a == b, 0) | bit(a != c, 1) | bit(a == "add", 2) | bit("ad" != a, 3);
    let xs = [1, 2, 3, 1, 2];
    bad |= bit(xs[0..2] == xs[3..5], 4) | bit(xs[0..2] != xs[1..3], 5)
        | bit(xs[0..0] == xs[5..5], 6) | bit(xs[0..2] != xs[0..3], 7);
    let n1 = Named { name: a, ns: xs[0..2] };
    let n2 = Named { name: b, ns: xs[3..5] };
    let n3 = Named { name: b, ns: xs[2..4] };
    bad |= bit(n1 == n2, 8) | bit(n1 != n3, 9);
    bad |= bit(Tok::Word(a) == Tok::Word(b), 10) | bit(Tok::Word(a) != Tok::Word(c), 11)
        | bit(Tok::Word(a) != Tok::Num(1), 12);
    let words = [a, c, b];
    bad |= bit(words[0..1] == words[2..3], 13) | bit(words[0..2] != words[1..3], 14);
    bad
}
