// EXPECT: some 4 none
// EXPECT: none some 9
// 0.9: `if c { Some(x) } else { None }` (either way round) takes the
// type of the branch that has one.
fn pick(c: bool, x: i64) -> i64 {
    let a = if c { Some(x) } else { None };
    let b = if c { None } else { Some(x * x) };
    match (a, b) {
        (Some(v), None) => v,
        (None, Some(v)) => -v,
        _ => 0,
    }
}

fn main() -> i32 {
    let x = pick(true, 4);
    print(if x == 4 { "some 4" } else { "wrong" });
    let y = if x > 10 { Option::Some(1) } else { Option::None };
    println(if y.is_none() { " none" } else { " some" });
    let z = pick(false, 3);
    let w = if z < 0 { None } else { Some(0) };
    print(if w.is_none() { "none" } else { "some" });
    println(if z == -9 { " some 9" } else { " wrong" });
    0
}
