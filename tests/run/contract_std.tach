// (0.18) std's clauses: a failure in std names the caller's line, with
// std's message as before (Option::unwrap, Vec::get, Vec::insert, ...).
// EXIT: 101
// EXPECT: 30
// STDERR: contract_std.tach:20:13: called unwrap on None

fn find(v: [i64], x: i64) -> Option<i64> {
    for i in 0..v.len() {
        if v[i] == x { return Some(i); }
    }
    None
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(10);
    v.insert(0, 30);
    std::print_int(v.get(find(v.as_slice(), 30).unwrap()));
    println("");
    let k = find(v.as_slice(), 99).unwrap();
    std::print_int(k);
    0
}
