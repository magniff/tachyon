// ok: closures over captures, through std's iterators
// EXPECT: 10 ccc 3 0
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..5 { v.push(i); }
    var total = 0;
    v.iter().for_each(|x| total += x);
    let words: str = "a bb ccc";
    var longest: str = "";
    for w in words.split_ascii_whitespace() { if w.len() > longest.len() { longest = w; } }
    let lens = (0..3).map(|i| v[i] * 2).collect_in(gpa);
    let s = v.as_slice();
    let first = (0..1).map(|i| s[i]).collect_in(gpa);
    println(f"{total} {longest} {lens.len()} {first[0]}");
}
