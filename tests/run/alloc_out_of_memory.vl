// 0.16: sizes are checked: a capacity whose bytes are above ALLOC_LIMIT
// (2^62) is out of memory, Err from the try_ functions, a stop otherwise.
// EXPECT: Err(OutOfMemory) Err(OutOfMemory) 0
// EXIT: 101
// STDERR: out of memory
use std::ALLOC_LIMIT;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    let big = v.try_reserve(ALLOC_LIMIT / 4);
    let huge = v.try_reserve(9223372036854775807);
    println(f"{big:?} {huge:?} {v.capacity()}");
    let w: Vec<i64> = Vec::with_capacity_in(ALLOC_LIMIT, gpa);
    println("not reached");
}
