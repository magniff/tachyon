// sem-own: a thread returning an owned value: dropped once by the joiner.
// EXPECT: got 3
// EXPECT: drop 3
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    {
        let h = std::thread::spawn(sink || mk(3, gpa));
        let d = h.join();
        println(f"got {d.id}");
    }
    println("end");
}
