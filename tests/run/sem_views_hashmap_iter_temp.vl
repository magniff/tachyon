// (0.25 semantics audit, views) The item of a temporary HashMap iterator
// keeps what the map's keys and values view: `m.values().next()`,
// `m.keys().next()`, `m.iter().next().unwrap().1` view s here. A `for`
// over m.values() is caught; the chained forms are not.
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    var m: HashMap<i64, str> = HashMap::new_in(gpa);
    m.insert(1, s.as_str());
    let r = m.values().next().unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
