// Loop strength reduction (strided addresses become pointer induction
// variables: no multiplication or shift left in the loop), tail recursion
// elimination with an accumulator (fib keeps one call of two; sum none),
// unswitching on an invariant condition, and a bounds check in a loop that
// still fails where it should, after all of it.
// EXPECT: 4860 9 55 5050 165 -165
// EXPECT: 8
// EXIT: 101
// STDERR: index out of bounds: index 8, length 8
// CHECK: fn column:
// CHECK: load
// CHECK-NOT: mul
// CHECK-NOT: shl
// CHECK: branch
// CHECK: fn fib:
// CHECK: call fib
// CHECK-NOT: call fib
// CHECK: fn sum:
// CHECK-NOT: call sum
// CHECK: fn main:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

// Sums column c of an n x n matrix.
fn column(m: *i64, n: i64, c: i64) -> i64 {
    let mut s = 0;
    for r in 0..n {
        unsafe { s += m[r * n + c]; }
    }
    s
}

fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn sum(n: i64) -> i64 {
    if n == 0 { 0 } else { n + sum(n - 1) }
}

// flip is invariant: the loop is unswitched on it.
fn signed_sum(a: *i64, n: i64, flip: bool) -> i64 {
    let mut s = 0;
    for i in 0..n {
        if flip {
            unsafe { s -= a[i]; }
        } else {
            unsafe { s += a[i]; }
        }
    }
    s
}

fn last_ok(s: [i64]) -> i64 {
    let mut t = 0;
    for i in 0..s.len as i64 + 1 {
        t = s[i];
    }
    t
}

fn main() -> i32 {
    let mut m: [i64; 100] = [0; 100];
    for i in 0..100 {
        m[i] = i * 10;
    }
    let mut v: [i64; 10] = [0; 10];
    for i in 0..10 {
        v[i] = 3 * (i + 1);
    }
    let col = unsafe { column };
    let f = fib;
    let su = sum;
    let ss = unsafe { signed_sum };
    unsafe {
        printf(c"%ld %ld %ld %ld %ld %ld\n", col(&m[0], 10, 4) - 40, f(6) + 1, f(10), su(100),
            ss(&v[0], 10, false), ss(&v[0], 10, true));
    }
    let w: [i64; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    let lo = last_ok;
    unsafe {
        printf(c"%ld\n", w[7]);
        printf(c"%ld\n", lo(w[..]));
    }
    0
}
