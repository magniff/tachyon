// EXPECT: (1, 9) (2, 1) (2, 5) (3, 0)
// EXPECT: lt true true false
// EXPECT: map 12 7 len 2
// EXPECT: cmp -1 1 0 -1
// EXPECT: clone 5 2.5 1 3
// EXPECT: deep 1 2
// EXPECT: words a 2 a 3 b 1
// 0.15: tuples of Ord, Hash or Clone types (2 to 6 elements) are Ord
// (lexicographic: `<` and std::sort), Hash (HashMap keys) and Clone
// (element-wise) without an impl; floats, pointers and fieldless enums
// have `cmp`, and every type that copies (numbers, pointers, slices,
// fieldless enums, tuples and arrays of them) has `clone`.
use std::{HashMap, sort};

enum Dir { North, South }

fn main(gpa: Gpa) {
    let mut v: Vec<(i64, i64)> = Vec::new_in(gpa);
    defer v.free();
    v.push((2, 5));
    v.push((3, 0));
    v.push((1, 9));
    v.push((2, 1));
    sort(v.as_slice());
    for i in 0..v.len() {
        let t = v.get(i);
        if i > 0 {
            print(" ");
        }
        print("(");
        std::print_int(t.0);
        print(", ");
        std::print_int(t.1);
        print(")");
    }
    println("");

    let a = (1, "b", 2u8);
    let b = (1, "c", 0u8);
    let c = (1, 2, 3, 4, 5, 6);
    let d = (1, 2, 3, 4, 5, 7);
    print("lt ");
    print(if a < b { "true " } else { "false " });
    print(if c < d { "true " } else { "false " });
    println(if d <= c { "true" } else { "false" });

    let mut m: HashMap<(i64, [u8]), i64> = HashMap::new_in(gpa);
    defer m.free();
    m.insert((1, "x"), 5);
    m.insert((1, "y"), 7);
    m.insert((1, "x"), 12);
    print("map ");
    std::print_int(m.get((1, "x")).unwrap());
    print(" ");
    std::print_int(m.get((1, "y")).unwrap());
    print(" len ");
    std::print_int(m.len());
    println("");

    let x = 1.5;
    let y = 2.5;
    let p = &x;
    let q = &y;
    let n = Dir::North;
    let s = Dir::South;
    print("cmp ");
    std::print_int(x.cmp(&y));
    print(" ");
    std::print_int(s.cmp(&n));
    print(" ");
    std::print_int(std::cmp_of(&p, &p));
    print(" ");
    std::print_int(a.cmp(&b));
    println("");

    let k: i64 = 5;
    let z = (2.5, 'a');
    let arr = [1, 2, 3];
    let arr2 = arr.clone();
    let z2 = z.clone();
    print("clone ");
    std::print_int(k.clone());
    unsafe {
        let r = q.clone();
        if r == 2.5 && z2.0 == 2.5 {
            print(" 2.5 ");
        }
    }
    std::print_int(arr2[0]);
    print(" ");
    std::print_int(arr2[2]);
    println("");

    let mut xs: Vec<i64> = Vec::new_in(gpa);
    xs.push(1);
    let pair = (xs, 0);
    let mut pair2 = pair.clone();
    pair2.0.push(2);
    print("deep ");
    std::print_int(pair.0.len());
    print(" ");
    std::print_int(pair2.0.len());
    println("");

    // (a [u8] element compares its bytes)
    let mut w: Vec<([u8], i64)> = Vec::new_in(gpa);
    defer w.free();
    w.push(("b", 1));
    w.push(("a", 2));
    w.push(("a", 3));
    sort(w.as_slice());
    print("words");
    for e in w {
        print(" ");
        print(e.0);
        print(" ");
        std::print_int(e.1);
    }
    println("");
}
