// (0.24, conventions.md: let is a borrow) A let parameter of a copyable
// type with storage (an array, a struct holding one) whose view the result
// may hold is passed by reference, so the view is of the caller's value:
// right at -O0 too, where nothing is inlined. Without such a result it is
// copied, the optimization.
// EXPECT: AAA BB AAA
// EXPECT: 66
struct D { buf: [u8; 16], n: i64 }

impl D {
    fn name(self) -> [u8] { self.buf[0..self.n] }
    fn first(self) -> u8 { self.buf[0] }
}

fn head(a: [u8; 4], n: i64) -> [u8] { a[0..n] }

fn by_name(f: fn(D) -> [u8], d: D) -> [u8] { f(d) }

fn main() {
    let d = D { buf: [65; 16], n: 3 };
    let e: [u8; 4] = [66, 66, 66, 66];
    println(f"{d.name()} {head(e, 2)} {by_name(D::name, d)}");
    println(f"{e[0]}");
}
