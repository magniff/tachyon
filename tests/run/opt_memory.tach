// Memory optimizations: loads forwarded across blocks along the dominator
// tree, dead stores, loads through copies, constant local tables as
// read-only data (and their loads at known offsets as constants).
// CHECK-OPT: 1
// (0.17: #[inline(never)]: -O1 inlines small leaf functions)
// CHECK: fn across_blocks
// CHECK: load
// CHECK-NOT: load
// CHECK: ret
// CHECK: fn dead_stores
// CHECK: store
// CHECK-NOT: store
// CHECK: ret
// CHECK: fn table
// CHECK: saddr
// CHECK-NOT: store
// CHECK: ret
// CHECK: fn table_const
// CHECK-NOT: load
// CHECK: ret
// CHECK: fn through_copy
// CHECK-NOT: memcpy
// CHECK: ret
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
}

struct Big { a: [i64; 20], n: i64 }

#[inline(never)]
fn across_blocks(p: *i64, c: bool) -> i64 {
    unsafe {
        let x = *p;
        var y = 0;
        if c {
            y = *p + 1;
        } else {
            y = *p * 2;
        }
        y + *p + x
    }
}

#[inline(never)]
fn dead_stores(p: inout i64, v: i64) {
    p = 1;
    p = 2;
    p = v;
}

#[inline(never)]
fn table(i: u64) -> u32 {
    let t: [u32; 8] = [3, 1, 4, 1, 5, 9, 2, 6];
    t[i & 7]
}

#[inline(never)]
fn table_const() -> u32 {
    let t: [u32; 8] = [3, 1, 4, 1, 5, 9, 2, 6];
    t[5] * 10 + t[2]
}

#[inline(never)]
fn through_copy(p: Big) -> i64 {
    let b = p;
    b.a[3] + b.a[7] + b.n
}

fn main() {
    let p = unsafe { malloc(8) as *i64 };
    unsafe {
        *p = 20;
        printf(c"%ld %ld\n", across_blocks(p, true), across_blocks(p, false));
        dead_stores(&*p, 7);
        printf(c"%ld\n", *p);
    }
    var s: u32 = 0;
    for i in 0..10 {
        s = s * 3 + table(i as u64);
    }
    unsafe { printf(c"%u %u\n", s, table_const()); }
    var big = Big { a: [0; 20], n: 5 };
    for i in 0..20 {
        big.a[i] = i as i64 * 11;
    }
    unsafe { printf(c"%ld\n", through_copy(big)); }
}

// EXPECT: 61 80
// EXPECT: 7
// EXPECT: 77149 94
// EXPECT: 115
