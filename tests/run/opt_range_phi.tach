// 0.11: ranges through phis (range.tach). An induction variable with a
// step of 2, one with a step read from memory, a decreasing one and the
// root and children of a heap's sift-down (the previous iteration's child,
// `child + 1 < end && s[child] < s[child + 1]`) are in ranges that drop
// their bounds checks; a range through a phi never drops a check that can
// fail: in `over`, i + 2 reaches 64.
// EXPECT: 367 119 213 4950
// EXPECT: 0 10 1
// EXIT: 101
// STDERR: index out of bounds: index 64, length 64
// CHECK: fn step2:
// CHECK-NOT: rt.panic
// CHECK: fn jumpy:
// CHECK-NOT: rt.panic
// CHECK: fn down:
// CHECK-NOT: rt.panic
// CHECK: fn heap:
// CHECK-NOT: rt.panic
// CHECK: fn over:
// CHECK: rt.panic
// CHECK: fn unknown:
// CHECK: rt.panic
// CHECK: fn main:
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

// i in [0, 61]: i and i + 1 are below 64.
#[inline(never)]
fn step2(a: [i64; 64]) -> i64 {
    let mut t = 0;
    let mut i = 0;
    while i < 62 {
        t += a[i] + a[i + 1];
        i += 2;
    }
    t
}

// i grows by 1 to 4, below 60 in the loop: i + 3 is below 64.
#[inline(never)]
fn jumpy(a: [i64; 64]) -> i64 {
    let mut t = 0;
    let mut i = 0;
    while i < 60 {
        t += a[i + 3];
        i += 1 + (a[i] & 3);
    }
    t
}

// i from 64 down to 0: i - 1 in [0, 63].
#[inline(never)]
fn down(a: [i64; 64]) -> i64 {
    let mut t = 0;
    let mut i = 64;
    while i > 0 {
        i -= 1;
        t += a[i] * (i & 1);
    }
    t
}

fn sift(s: &mut [i64], start: i64, end: i64) {
    let mut root = start;
    loop {
        let mut child = 2 * root + 1;
        if child >= end {
            return;
        }
        if child + 1 < end && s[child] < s[child + 1] {
            child += 1;
        }
        if !(s[root] < s[child]) {
            return;
        }
        let t = s[root];
        s[root] = s[child];
        s[child] = t;
        root = child;
    }
}

// A heap of 100: root and child stay below 100.
#[inline(never)]
fn heap(mut a: [i64; 100]) -> i64 {
    let s = &mut a[0..100];
    let n = s.len;
    let mut start = n / 2;
    while start > 0 {
        start -= 1;
        sift(s, start, n);
    }
    let mut sum = 0;
    for k in 0..100 {
        sum += s[k];
    }
    sum
}

// i reaches 62: i + 2 is 64, past the end.
#[inline(never)]
fn over(a: [i64; 64], limit: i64) -> i64 {
    let mut t = 0;
    let mut i = 0;
    while i < 64 {
        if i >= limit {
            t += a[i + 2];
        }
        i += 2;
    }
    t
}

// n is unknown: the check stays.
#[inline(never)]
fn unknown(a: [i64; 64], n: i64) -> i64 {
    let mut t = 0;
    let mut i = 0;
    while i < n {
        t += a[i];
        i += 2;
    }
    t
}

fn main() -> i32 {
    let mut a: [i64; 64] = [0; 64];
    for k in 0..64 {
        a[k] = k * 7 % 13;
    }
    let mut h: [i64; 100] = [0; 100];
    for k in 0..100 {
        h[k] = (k * 37) % 100;
    }
    unsafe { printf(c"%ld %ld %ld %ld\n", step2(a), jumpy(a), down(a), heap(h)); }
    unsafe { printf(c"%ld %ld %ld\n", over(a, 70), unknown(a, 10), unknown(a, 3)); }
    over(a, 60);
    0
}
