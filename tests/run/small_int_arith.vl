// 8-bit multiply, divide and remainder.
// EXPECT: 255 35 5
// EXPECT: -14 -2
// EXPECT: 60000 3
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: u8 = 15;
    let b: u8 = 17;
    let n: u8 = 250;
    let d: u8 = 7;
    unsafe { printf(c"%d %d %d\n", a * b, n / d, n % d); }
    let m: i8 = (0 - 100) as i8;
    let k: i8 = 7;
    unsafe { printf(c"%d %d\n", m / k, m % k); }
    let w: u16 = 60000;
    let v: u16 = 7;
    unsafe { printf(c"%d %d\n", w / (1 as u16), w % v); }
    0
}
