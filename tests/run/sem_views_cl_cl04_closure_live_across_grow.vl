// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: c captures s by access and is used after s grows
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    let c = || s.len();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(c());
    0
}
