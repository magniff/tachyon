// The early return of `?` drops the locals alive there.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(inout self) { println("dropped"); } }

#[no_io]
fn quiet(r: Result<i64, i64>) -> Result<i64, i64> {
    let n = Noisy { n: 1 };
    let x = r?;
    Ok(x + n.n)
}

fn main() -> i32 {
    println(quiet(Err(3)).is_ok());
    0
}
