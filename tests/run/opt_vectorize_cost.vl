// PROFILE: 0.11, the vectorizer's cost model
// EXPECT: 2998000 744
// The same loop vectorized where it runs long and left alone where the
// profile says it runs two iterations an entry (fewer than a vector's
// four lanes); a constant trip count of 20 bytes takes one vector of 16
// (not two a vector iteration, which would never run).
// CHECK: fn add_short:
// CHECK-NOT: v4i32
// CHECK: fn add_long:
// CHECK: v4i32 = load
// CHECK: fn fill20:
// CHECK-NOT: +16 v16i8
// CHECK: v16i8 = vsplat
// CHECK-NOT: +16 v16i8
// CHECK: fn main:
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn add_short(a: inout [i32], b: [i32]) {
    for i in 0..a.len {
        a[i] += b[i];
    }
}

#[inline(never)]
fn add_long(a: inout [i32], b: [i32]) {
    for i in 0..a.len {
        a[i] += b[i];
    }
}

#[inline(never)]
fn fill20(x: u8, out: inout [u8]) {
    var d: [u8; 20] = [0; 20];
    for i in 0..20 {
        d[i] = x;
    }
    for i in 0..out.len {
        out[i] = d[i % 20];
    }
}

fn main() -> i32 {
    var a: [i32; 1000] = [0; 1000];
    var b: [i32; 1000] = [0; 1000];
    for i in 0..1000 {
        b[i] = (i % 7) as i32;
    }
    for k in 0..1000 {
        add_short(&a[k % 998..k % 998 + 2], b[0..2]);
    }
    for _ in 0..1000 {
        add_long(&a[..], b[..]);
    }
    var s1 = 0;
    for i in 0..1000 {
        s1 += a[i] as i64;
    }
    var c: [u8; 10] = [0; 10];
    var s2 = 0;
    for k in 0..127 {
        fill20(k as u8, &c[..]);
        s2 += c[9] as i64 / 10;
    }
    unsafe { printf(c"%ld %ld\n", s1, s2); }
    0
}
