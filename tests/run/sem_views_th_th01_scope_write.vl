// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) sync.scope_write: v grown while a scoped thread reads its slice
// ERROR: error[sync.scope_write]
use std::thread;

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = v.as_slice();
    let t = thread::scope(|sc| {
        let a = sc.spawn(|| s[0]);
        v.push(2);
        a.join()
    });
    println(t);
    0
}
