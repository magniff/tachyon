// sem-own: a sink closure returning its capture's field: allowed once (the closure's flag), called twice stops (exit 101).
// XFAIL: OVERSTRICT a sink closure may move a whole capture out (guide), but not a field of one
// EXIT: 0
// EXPECT: drop 1
// EXPECT: 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct P { a: D }

fn main(gpa: Gpa) {
    let p = P { a: mk(1, gpa) };
    var f = sink || p.a;
    let x = f();
    println(f"{x.id}");
}
