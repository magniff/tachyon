// The loop optimizer: rotation, unrolling of constant trip counts, exit
// values and the deletion of loops that only compute them, and loops
// whose trip count depends on wrapping arithmetic (evaluated exactly).
// EXPECT: 285 0 50 7 0 30 13 138 -10 8
// A rotated loop has two tests: the guard and the latch's.
// CHECK: fn squares:
// CHECK: cmp.
// CHECK: cmp.
// CHECK: fn count_to:
// CHECK: cmp.gt
// CHECK-NOT: cmp
// CHECK: fn weights:
// CHECK-NOT: phi
// CHECK-NOT: branch
// CHECK: fn wrapping:
// CHECK: const 13
// CHECK-NOT: branch
// CHECK: fn down:
// CHECK: cmp.gt
// CHECK: cmp.gt
// CHECK: fn main:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

// A rotated loop: its test is at the end, the guard before it.
fn squares(n: i64) -> i64 {
    let mut s = 0;
    let mut i = 0;
    while i < n {
        s += i * i;
        i += 1;
    }
    s
}

// Counts to n: the loop computes nothing else, so its exit values
// replace it (n when it runs, 0 when it does not).
fn count_to(n: i64) -> i64 {
    let mut k = 0;
    let mut twice = 0;
    while k < n {
        k += 1;
        twice += 2;
    }
    k + twice - n
}

// Four trips: unrolled, no loop left.
fn weights(a: *i64) -> i64 {
    let mut s = 0;
    for i in 0..4 {
        s += a[i] * (i + 1);
    }
    s
}

// A u8 counter wrapping around: 250, 251, ..., 255, 0, 1, 2, 3: 10 trips.
fn wrapping() -> i64 {
    let mut c: u8 = 250;
    let mut n = 0;
    while c != 4 {
        c += 1;
        n += 1;
    }
    n + c as i64 - 1
}

// Down by threes, signed.
fn down(start: i64) -> i64 {
    let mut i = start;
    let mut steps = 0;
    while i > -10 {
        i -= 3;
        steps += 1;
    }
    steps * 10 + i + 10
}

fn main() -> i32 {
    let mut a: [i64; 4] = [1, 2, 3, 4];
    // Through pointers, so the functions are kept (and their IR checked).
    let sq = squares;
    let ct = count_to;
    let wt = weights;
    let wr = wrapping;
    let dn = down;
    printf(c"%ld %ld %ld %ld %ld %ld %ld %ld %ld %ld\n", sq(10), sq(0), ct(25), ct(-7), ct(0), wt(&a[0]),
           wr(), dn(30), dn(-20), dn(-9));
    0
}
