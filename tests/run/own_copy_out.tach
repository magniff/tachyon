// (0.17, T7) What err_own_copy_out's try: lines give: a copy (`.clone()`),
// the value taken out with an empty one left (`std::take`, `v.take()`),
// replaced (`std::replace`), removed (`v.remove(i)`), or borrowed (`&v[i]`).
// Nothing is freed twice, nothing leaks.
// FLAGS: --check-alloc
// EXPECT: x y z 3 1 0 w 2
struct S { f: Buf }

fn first_clone(v: &Vec<Buf>) -> Buf { v[0].clone() }
fn take_field(s: &mut S) -> Buf { s.f.take() }
fn swap_in(s: &mut S, b: Buf) -> Buf { std::replace(&mut s.f, b) }
fn len_of(b: &Buf) -> i64 { b.len() }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<Buf> = Vec::new_in(gpa);
    v.push(Buf::from_in("x", gpa));
    v.push(Buf::from_in("y", gpa));
    v.push(Buf::from_in("z", gpa));
    let a = first_clone(&v);
    let b = v.remove(1);
    let c = v.get(1).clone();
    let mut s = S { f: Buf::from_in("abc", gpa) };
    let t = take_field(&mut s);
    let old = swap_in(&mut s, Buf::from_in("w", gpa));
    println(f"{a} {b} {c} {t.len()} {len_of(&v[0])} {old.len()} {s.f} {v.len()}");
    0
}
