// a sink-self trait method, the receiver used after
// ERROR: [own.moved]: 'r.id' is used here after 'r' moved into 'R::eat(sink self)'
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
trait E { fn eat(sink self) -> i64; }
impl E for R { fn eat(sink self) -> i64 { self.id } }

fn main() {
    let r = R { id: 1 };
    let a = r.eat();
    println(f"{a} {r.id}");
}
