// sem-own: a match expression moving one of several owned locals, chosen at run time.
// EXPECT: got 2
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    let c = mk(3, gpa);
    let k = 1;
    {
        let d = match k { 0 => a, 1 => b, _ => c };
        println(f"got {d.id}");
    }
}
