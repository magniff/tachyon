// a generic with a let T calling an inout-self method, T owned: the caller's let value changes through a let borrow,
// while a view of it is held
// ERROR: [own.readonly]: writes through 'x', a 'let Vec<i64>', which is read-only
trait B { fn grow(inout self); }
impl B for Vec<i64> { fn grow(inout self) { for i in 0..1000 { self.push(i); } } }
fn use_it<T: B>(x: T) { x.grow(); }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(7);
    let s = v.as_slice();
    use_it(v);
    println(f"{s[0]} {v.len()}");
}
