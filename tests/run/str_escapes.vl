// String escapes produce the right bytes, and `.len` is the byte length.
// EXPECT: a	b\c"d
// EXPECT: 8
// EXPECT: 3 121
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn write(fd: i32, buf: *u8, n: u64) -> i64;
}

fn main() -> i64 {
    let s = "a\tb\\c\"d\n";
    unsafe {
        write(1, s.ptr, (s.len as u64));
        printf(c"%lu\n", (s.len as u64));
    }
    let z = "x\0y";
    unsafe { printf(c"%lu %d\n", (z.len as u64), z.ptr[2]); }
    0
}
