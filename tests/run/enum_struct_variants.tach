// EXPECT: move 3 4; line 1 2 to 5 6; quit
// EXPECT: x=3 only
// EXPECT: px=1 py=2
// EXPECT: if let 7
// EXPECT: order c a b 3 1 2
// EXPECT: while let 2 1 0
// EXPECT: generic 5 [u8]=hi
// EXPECT: used 9
// EXPECT: self 11
// EXPECT: let 4 5
// EXPECT: tuple any
// EXPECT: nested 6
// EXPECT: Move { x: 3, y: 4 } Text { s: "hi", n: 2 } Quit Pair(1, 2)
// EXPECT: eq true false lt true
// EXPECT: clone 3 4 hash same
// 0.17: struct-like enum variants: `V { a: A, b: B }` laid out as `V(A, B)`;
// literals with shorthands and in any order (evaluated in the order written);
// patterns `V { a, b: p, .. }` in match, if let, while let and let; derives.
use std::{Fmt, hash_of};

#[derive(Eq, Ord, Hash, Debug, Clone)]
enum Cmd {
    Move { x: i64, y: i64 },
    Text { s: [u8], n: i64 },
    Quit,
    Pair(i64, i64),
}

enum Shape { Line { from: (i64, i64), to: (i64, i64) }, Dot }

enum Opt<T> { Some2 { value: T }, None2 }

enum One { Only { a: i64, b: i64 } }

enum Outer { In { cmd: Cmd, k: i64 }, Out }

mod m {
    pub enum Ev { Key { code: i64 }, Tick }
}

use m::Ev::Key;

impl Cmd {
    fn twice(n: i64) -> Cmd {
        Self::Move { x: n, y: n }
    }
}

static mut TRACE: i64 = 0;

fn note(c: u8, v: i64) -> i64 {
    unsafe {
        TRACE += 1;
    }
    print(" ");
    let mut s = [0u8; 1];
    s[0] = c;
    print(s[0..1]);
    v
}

fn show<T: std::Debug>(x: &T) {
    let mut f = Fmt::to_fd(1);
    f.debug(x);
}

fn describe(c: Cmd) {
    match c {
        Cmd::Move { x, y } => print(f"move {x} {y}"),
        Cmd::Text { s, .. } => print(s),
        Cmd::Quit => print("quit"),
        Cmd::Pair(a, b) => print(f"pair {a} {b}"),
    }
}

fn main() {
    let x = 3;
    describe(Cmd::Move { x, y: 4 });
    print("; ");
    let sh = Shape::Line { to: (5, 6), from: (1, 2) };
    match sh {
        Shape::Line { from: (a, b), to: (c, d) } => print(f"line {a} {b} to {c} {d}; "),
        Shape::Dot => print("dot"),
    }
    describe(Cmd::Quit);
    println("");

    match (Cmd::Move { x: 3, y: 9 }) {
        Cmd::Move { x, .. } if x == 3 => println(f"x={x} only"),
        _ => println("other"),
    }
    match (Cmd::Move { y: 2, x: 1 }) {
        Cmd::Move { x: px, y: py } => println(f"px={px} py={py}"),
        _ => println("other"),
    }
    if let Cmd::Text { n, s: _ } = (Cmd::Text { s: "t", n: 7 }) {
        println(f"if let {n}");
    }

    // Evaluated in the order written: c, a, b.
    print("order");
    let t = Cmd::Text { n: note('c', 3), s: "" };
    let _ = t;
    let m = Cmd::Move { y: note('a', 2), x: note('b', 1) };
    if let Cmd::Move { x, y } = m {
        println(f" {unsafe { TRACE }} {x} {y}");
    }

    let mut cur = Opt::Some2 { value: 2 };
    print("while let");
    while let Opt::Some2 { value } = cur {
        print(f" {value}");
        cur = if value > 0 { Opt::Some2 { value: value - 1 } } else { Opt::None2 };
    }
    println("");

    let g: Opt<[u8]> = Opt::Some2 { value: "hi" };
    let h = Opt::Some2 { value: 5 };
    if let (Opt::Some2 { value: a }, Opt::Some2 { value: b }) = (h, g) {
        println(f"generic {a} [u8]={b}");
    }

    let k = Key { code: 9 };
    match k {
        Key { code } => println(f"used {code}"),
        m::Ev::Tick => println("tick"),
    }
    match Cmd::twice(11) {
        Cmd::Move { x, .. } => println(f"self {x}"),
        _ => println("other"),
    }
    let One::Only { a, b } = (One::Only { a: 4, b: 5 });
    println(f"let {a} {b}");
    match Cmd::Pair(1, 2) {
        Cmd::Pair { .. } => println("tuple any"),
        _ => println("other"),
    }
    let o = Outer::In { cmd: Cmd::Move { x: 6, y: 0 }, k: 1 };
    match o {
        Outer::In { cmd: Cmd::Move { x, y: 0 }, k: 1 } => println(f"nested {x}"),
        Outer::In { .. } => println("in"),
        Outer::Out => println("out"),
    }

    let all = [Cmd::Move { x: 3, y: 4 }, Cmd::Text { s: "hi", n: 2 }, Cmd::Quit, Cmd::Pair(1, 2)];
    for i in 0..4 {
        if i > 0 {
            print(" ");
        }
        show(&all[i]);
    }
    println("");
    let p = Cmd::Move { x: 1, y: 2 };
    let q = Cmd::Move { x: 1, y: 2 };
    let r = Cmd::Move { x: 1, y: 3 };
    println(f"eq {p == q} {p == r} lt {p < r}");
    let c = Cmd::Move { x: 3, y: 4 };
    let d = std::clone_of(&c);
    let same = hash_of(&c) == hash_of(&d);
    match d {
        Cmd::Move { x, y } => println(
            f"clone {x} {y} hash {if same { "same" } else { "differs" }}"),
        _ => println("other"),
    }
}
