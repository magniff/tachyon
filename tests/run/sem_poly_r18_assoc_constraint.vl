// a bound I: Iterator<Item = i64> given an iterator of R: rejected naming the bound
// ERROR: [type error]: 'Gen::Item' is 'R', but the bound 'I: Iterator<Item = i64>'
struct R { id: i64 }
struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;
    fn next(inout self) -> Option<R> { None }
}

fn total<I: Iterator<Item = i64>>(it: sink I) -> i64 { it.sum() }
fn main() { println(f"{total(Gen { n: 3 })}"); }
