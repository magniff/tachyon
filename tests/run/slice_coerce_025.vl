// (0.25) A Vec, a Buf or an array given to a generic `[T]` (or `inout
// [T]`) parameter binds T to its element type, as for a non-generic
// `[i64]`; and a temporary one (an array literal, a call's result) is
// viewed as a slice for the call, as a named one is.
// EXPECT: 1
// EXPECT: 3
// EXPECT: 120
// EXPECT: 9
// EXPECT: 8
// EXPECT: 9
// EXPECT: 48
// EXPECT: 2
// EXPECT: 3
// EXPECT: 51
fn count<T: Copy>(xs: [T]) -> i64 { xs.len() }
fn first<T: Copy>(xs: [T]) -> T { xs[0] }
fn bump<T: Copy>(xs: inout [T], v: T) { xs[0] = v; }
fn mk(gpa: Gpa) -> Vec<i64> { var v: Vec<i64> = Vec::new_in(gpa); v.push(7); v.push(41); v }
fn sum(xs: [i64]) -> i64 { var t = 0; for x in xs { t += x; } t }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let a = [1, 2, 3];
    var b = Buf::new_in(gpa);
    b.push_str("xy");
    println(count(v));
    println(count(a));
    println(first(b));
    bump(&v, 9);
    println(v[0]);
    var arr = [5, 6];
    bump(&arr, 8);
    println(arr[0]);
    println(sum([4, 5]));
    println(sum(mk(gpa)));
    println(count(mk(gpa)));
    println(first([3, 4]));
    let k = sum(mk(gpa)) + sum([1; 3]);
    println(k);
    0
}
