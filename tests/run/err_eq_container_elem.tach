// `==` on a Vec or HashMap needs == on its elements (0.15: their contents
// are compared, no longer their pointers).
// ERROR: cannot compare 'Vec<U>' with ==: it holds a 'U', which has no ==
// ERROR: cannot compare 'HashMap<i64, U>' with ==: it holds a 'U', which has no ==
use std::HashMap;

union U { a: i64, b: f64 }

fn main() {
    let a: Vec<U> = Vec::new();
    let x = a == a;
    let m: HashMap<i64, U> = HashMap::new();
    let y = m == m;
}
