// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict through a generic: n views e
// ERROR: error[own.conflict]
struct E { name: [u8; 8], len: i64 }
trait N { fn nm(self) -> [u8]; }
impl N for E { fn nm(self) -> [u8] { self.name[..self.len] } }
fn call<X: N>(x: X) -> [u8] { x.nm() }

fn main() -> i32 {
    var e = E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 };
    let n = call(e);
    e.name[0] = 'J';
    println(n);
    0
}
