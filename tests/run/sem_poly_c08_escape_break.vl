// a closure borrowing a var of the loop body escapes through break's value
// ERROR: sink
// XFAIL: DIAG the escape help says 'write `move`' (sink ||), then a cascade 'cannot call non-function type !'
fn main() {
    let c = loop {
        var n = 7;
        n += 1;
        break || n;
    };
    println(f"{c()}");
}
