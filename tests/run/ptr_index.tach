// Indexing through pointers: p[i] reads and writes the i-th element, and
// &p[i] is its address.
// EXPECT: 465 25 400
// EXPECT: 69 c n
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
    fn free(p: *u8);
}

struct Pt { x: i32, y: i32 }

fn sum(p: *i64, n: i64) -> i64 {
    let mut s = 0;
    for i in 0..n { s += p[i]; }
    s
}

fn main() -> i64 {
    let mut arr = [10, 20, 30, 40];
    let p = &arr[0];
    p[3] = 400;
    let q = &p[1];
    q[0] += 5;
    printf(c"%ld %ld %ld\n", sum(p, 4), arr[1], arr[3]);

    let pts = malloc(4 * 8) as *Pt;
    for i in 0..4 {
        pts[i] = Pt { x: i as i32, y: (i * i) as i32 };
    }
    pts[2].y = -1;
    let mut acc: i32 = 0;
    for i in 0..4 { acc += pts[i].x * 10 + pts[i].y; }
    let bytes = c"tachyon";
    let idx: u8 = 2;
    printf(c"%d %c %c\n", acc, bytes[idx] as i32, bytes[6u8] as i32);
    free(pts as *u8);
    0
}
