// EXPECT: 2 3
// 0.9: writing a union's field, and taking its address, are safe; only
// reading one is unsafe.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[repr(C)]
union U { a: i64, b: f64 }

#[repr(C)]
struct Holder { u: U, n: i64 }

fn main() -> i32 {
    var u = U { a: 1 };
    u.a = 2;
    var h = Holder { u: U { a: 0 }, n: 0 };
    h.u.a = 3;
    let pa = u.a;
    unsafe {
        printf(c"%ld %ld\n", pa, h.u.a);
    }
    0
}
