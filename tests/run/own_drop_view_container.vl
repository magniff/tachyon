// (0.25) a generic Drop type in a container, its type argument a struct
// holding a view, moved into a longer-lived Vec: own.drop_view at its impl
// (the Vec's drop would run G's after the Vec it views is freed)
// ERROR: [own.drop_view]: 'G<P>' holds views (a type argument is one) and cannot implement Drop
struct P { s: [i64] }
struct G<T> { x: T }
impl<T> Drop for G<T> { fn drop(inout self) { println("G"); } }

fn main(gpa: Gpa) {
    var gs: Vec<G<P>> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(1);
        gs.push(G { x: P { s: v.as_slice() } });
    }
}
// ERROR-COUNT: 1
