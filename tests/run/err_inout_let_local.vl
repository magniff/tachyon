// (0.25) An inout access needs a mutable place: a let local, its field,
// element or tuple part, given `&` to an inout parameter, bound `inout r =
// &..`, matched `match &..`, swapped or set through a generic is
// own.readonly, naming the binding, with `var` as the fix.
struct S { n: i64 }
fn bump(n: inout i64) { n += 1; }
fn set<T>(x: inout T, v: sink T) { x = v; }
fn main() {
    let n = 1;
    bump(&n);
    let s = S { n: 1 };
    bump(&s.n);
    let a = [1, 2, 3];
    bump(&a[1]);
    let t = (1, 2);
    bump(&t.0);
    let m = 2;
    inout r = &m;
    r += 1;
    let o: Option<i64> = Some(1);
    match &o { Some(k) => { k += 1; } None => {} }
    let x = 1;
    var y = 2;
    std::swap(&x, &y);
    let g = 3;
    set(&g, 5);
    let (p, q) = (1, 2);
    bump(&p);
    println(f"{n} {s.n} {a[1]} {t.0} {m} {x} {y} {g} {p} {q}");
}
// ERROR: '&n' changes 'n', a let binding: it is read-only
// ERROR: try: var n = ...
// ERROR: '&s.n' changes 's', a let binding
// ERROR: '&a[1]' changes 'a', a let binding
// ERROR: '&t.0' changes 't', a let binding
// ERROR: '&m' changes 'm', a let binding
// ERROR: '&o' changes 'o', a let binding
// ERROR: '&x' changes 'x', a let binding
// ERROR: '&g' changes 'g', a let binding
// ERROR: '&p' changes 'p', a let binding
