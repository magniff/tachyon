// sem-own: a closure's let (default) parameter only reads its argument: the
// caller keeps it and drops it once.
// EXPECT: got 1
// EXPECT: end
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let f = |d: D| println(f"got {d.id}");
    let x = mk(1, gpa);
    f(x);
    println("end");
}
