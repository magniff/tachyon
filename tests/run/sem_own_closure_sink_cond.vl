// sem-own: a sink closure created on one branch only (a conditional move of d).
// EXPECT: drop 3
// EXPECT: r 3
// EXPECT: n
// EXPECT: drop 4
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn call<F: FnMut() -> i64>(f: sink F) -> i64 { f() }

fn run(id: i64, c: bool, gpa: Gpa) {
    let d = mk(id, gpa);
    if c { let r = call(sink || d.id); println(f"r {r}"); } else { println("n"); }
}

fn main(gpa: Gpa) { run(3, true, gpa); run(4, false, gpa); }
