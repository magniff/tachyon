// old(e) is e at entry; the ensures sees the change.
// EXIT: 101
// STDERR: ensures failed: 'v.len() == old(v.len()) + 2' of 'push2': v.len() = 1
fn push2(v: inout Vec<i64>)
    ensures v.len() == old(v.len()) + 2
{
    v.push(1);
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    push2(&v);
    println("not reached");
    0
}
