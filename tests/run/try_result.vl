// `e?` on a Result (0.15): the Ok value, or `return Err(conv(e))`: the
// error itself, an integer error widened (i32 into i64), or converted by
// the function's error type's From impls (two of them on one enum).
// EXPECT: 41
// EXPECT: parse error at 3
// EXPECT: io error 10
// EXPECT: code -5
// EXPECT: 12
enum ParseError { Bad(i64) }
enum IoError { Closed(i64) }
enum AppError { Parse(ParseError), Io(IoError) }

impl From<ParseError> for AppError {
    fn from(e: ParseError) -> AppError { AppError::Parse(e) }
}

impl From<IoError> for AppError {
    fn from(e: IoError) -> AppError { AppError::Io(e) }
}

fn parse(x: i64) -> Result<i64, ParseError> {
    if x < 0 { Err(ParseError::Bad(-x)) } else { Ok(x * 10) }
}

fn read(x: i64) -> Result<i64, IoError> {
    if x > 100 { Err(IoError::Closed(x - 100)) } else { Ok(x + 1) }
}

fn run(x: i64) -> Result<i64, AppError> {
    let v = parse(x)?;
    let w = read(v)?;
    Ok(w)
}

fn small(x: i64) -> Result<i64, i32> {
    if x < 0 { Err(x as i32) } else { Ok(x) }
}

// (the error widened: i32 into i64)
fn wide(x: i64) -> Result<i64, i64> {
    let v = small(x)?;
    Ok(v * 2)
}

fn report(r: Result<i64, AppError>) {
    match r {
        Ok(v) => std::print_int(v),
        Err(AppError::Parse(ParseError::Bad(at))) => {
            print("parse error at ");
            std::print_int(at);
        }
        Err(AppError::Io(IoError::Closed(n))) => {
            print("io error ");
            std::print_int(n);
        }
    }
    println("");
}

fn main() {
    report(run(4));
    report(run(-3));
    report(run(11));
    match wide(-5) {
        Ok(v) => std::print_int(v),
        Err(e) => {
            print("code ");
            std::print_int(e);
        }
    }
    println("");
    match wide(6) {
        Ok(v) => std::print_int(v),
        Err(_) => print("?"),
    }
    println("");
}
