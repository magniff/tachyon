// 0.25: any, all, position and find (inout self) drop the items they pass
// over; find returns the one it found; the rest stay in the iterator and
// drop with it.
// FLAGS: --check-alloc
// EXPECT: any true
// EXPECT: any true
// EXPECT: any: made 7 dropped 7
// EXPECT: position 1
// EXPECT: found 3
// EXPECT: all false
// EXPECT: end: made 20 dropped 20
static var MADE: i64 = 0;
static var DROPS: i64 = 0;
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { DROPS += 1; } }
impl Eq for D { fn eq(self, o: Self) -> bool { self.id == o.id } }
impl Ord for D { fn cmp(self, o: Self) -> i64 { self.id - o.id } }

fn mk(id: i64, gpa: Gpa) -> D {
    MADE += 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

// Makes D 1, 2, ..., n, one per call to next.
struct Gen { n: i64, k: i64, gpa: Gpa }

impl Iterator for Gen {
    type Item = D;

    fn next(inout self) -> Option<D> {
        if self.k >= self.n { return None; }
        self.k += 1;
        Some(mk(self.k, self.gpa))
    }
}

fn gen(n: i64, gpa: Gpa) -> Gen { Gen { n: n, k: 0, gpa: gpa } }
// Owns D 1..n (pops n first): the ones it has not given out drop with it.
struct Pop { v: Vec<D> }

impl Iterator for Pop {
    type Item = D;
    fn next(inout self) -> Option<D> { self.v.pop() }
}

fn pop(n: i64, gpa: Gpa) -> Pop {
    var v: Vec<D> = Vec::new_in(gpa);
    for i in 1..=n { v.push(mk(i, gpa)); }
    Pop { v: v }
}

fn report(what: [u8]) {
    println(f"{what}: made {MADE} dropped {DROPS}");
}

fn main(gpa: Gpa) {
    var p = pop(5, gpa);
    let a = p.any(|d| d.id == 4);
    println(f"any {a}");
    drop(p);
    var g = gen(3, gpa);
    let b = g.any(|d| d.id == 2);
    println(f"any {b}");
    report("any");
    let k = pop(5, gpa).position(|d| d.id == 4).unwrap_or(-1);
    println(f"position {k}");
    match gen(5, gpa).find(|d| d.id == 3) { Some(d) => println(f"found {d.id}"), None => {} }
    let c = pop(5, gpa).all(|d| d.id > 4);
    println(f"all {c}");
    drop(g);
    report("end");
}
