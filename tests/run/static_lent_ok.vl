// (0.25) A static lent to a callee that does not reach it by name, or
// passed as a copy (a plain let), is fine; one static lent while the
// callee changes another is fine too.
static var G: i64 = 1;
static var H: i64 = 10;
fn bump(x: inout i64) { x += 1; }
fn seth(x: inout i64) -> i64 { x += 1; H = 20; x }
fn copy_then_write(x: i64) -> i64 { G = 7; x }
fn main() {
    bump(&G);
    let a = seth(&G);
    let b = copy_then_write(G);
    println(f"{G} {H} {a} {b}");
}
// EXPECT: 7 20 3 3
