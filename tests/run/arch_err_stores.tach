// ERROR: error[own.readonly]: 'vst1q_u32' writes into 'state', a '[u32]', which is read-only: its slice parameter is '&mut [u32]'
// ERROR: refactor signature neon --type state '&mut [u32]'
// ERROR: error[own.readonly]: '_mm_storeu_si128' writes into 's', a '[u8]', which is read-only
// ERROR: error[own.readonly]: 'vst1_u8' writes into 'out[..]', a '[u8]', which is read-only
// ERROR: arch_err_stores.tach:31 --old 'vst1_u8(out[..], 8, vdup_n_u8(1))' --new 'vst1_u8(&mut out[..], 8, vdup_n_u8(1))'
// ERROR: error[own.readonly]: 'vst2q_u8' writes into 'v.as_slice()', a '[u8]', which is read-only
// ERROR: --new 'vst2q_u8(v.as_mut_slice(), 0, (a, a))'
// ERROR: error[own.readonly]: '_mm256_storeu_si256' writes into 'b[0..32]', a '[u8]', which is read-only
// ERROR: --new '_mm256_storeu_si256(&mut b[0..32], 0, w)'
// ERROR-COUNT: 5
// (0.19.1) A store intrinsic writes its slice, so the slice is `&mut [T]`:
// a read-only `[T]` (a `[T]` parameter, `a[..]`, `v.as_slice()`) is
// own.readonly in every family (NEON's one- and two-register stores,
// x86's 128- and 256-bit ones), with the edit that makes the view
// exclusive or the parameter `&mut [T]`.
use std::arch::aarch64::{
    uint32x4_t, uint8x16_t, vdup_n_u8, vdupq_n_u32, vdupq_n_u8, vst1_u8, vst1q_u32, vst2q_u8,
};
use std::arch::x86_64::{__m128i, __m256i, _mm256_storeu_si256, _mm_storeu_si128};

fn neon(state: [u32], x: uint32x4_t) {
    vst1q_u32(state, 0, x);
}

fn x86(s: [u8], v: __m128i) {
    _mm_storeu_si128(s, 0, v);
}

fn main(gpa: Gpa) {
    let mut out: [u8; 16] = [0; 16];
    vst1_u8(out[..], 8, vdup_n_u8(1));
    let mut v: Vec<u8> = Vec::filled_in(32, 0, gpa);
    let a: uint8x16_t = vdupq_n_u8(2);
    vst2q_u8(v.as_slice(), 0, (a, a));
    let mut b: [u8; 32] = [0; 32];
    let w = __m256i::from_bits(v32u8::splat(3));
    if std::arch::has("avx") {
        _mm256_storeu_si256(b[0..32], 0, w);
    }
    let mut st: [u32; 4] = [0; 4];
    neon(st[..], vdupq_n_u32(1));
    if std::arch::has("sse2") {
        x86(b[..], __m128i::from_bits(a));
    }
}
