// 0.16: a closure in Arena::scope that allocates from a captured Gpa adds
// alloc(Gpa): only the arena's own use of Gpa is discharged.
// ERROR: 'from_gpa' is #[effects(alloc(Arena), panic)], but it allocates from Gpa
// ERROR-COUNT: 1
#[effects(alloc(Arena), panic)]
fn from_gpa(a: *Arena, gpa: Gpa) -> i64 {
    a.scope(|s| {
        let mut v: Vec<i64> = Vec::new_in(gpa);
        v.push(1);
        let n = v.len();
        v.free();
        n
    })
}

fn main(gpa: Gpa) -> i32 {
    let mut a = Arena::new_in(gpa);
    println(f"{from_gpa(&a, gpa)}");
    0
}
