// (0.21) thread::spawn's closure must move what it uses: the thread may
// outlive the caller's variables.
// ERROR: the closure given to 'thread::spawn' borrows 'n', but the thread may outlive it
// ERROR: help: move it into the thread (`move ||`)

use std::thread;

fn main() {
    let mut n = 5;
    n += 1;
    let h = thread::spawn(|| n + 1);
    println(f"{h.join()}");
}
