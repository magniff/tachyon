// A guarded inner index of a nested array.
// FLAGS: -O2
// EXPECT: 0
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var t = 0;
    var k = 0;
    let g = [[1, 2], [3, 4]];
    let i = -1099511627776 + Z;
    while k < 5 + Z { if k > 100 { t += g[0][i]; } k += 1; }
    println(t);
    0
}
