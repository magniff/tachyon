// 0.17: the stable sorts are in the prelude, as sort and sort_by: no `use`
// (sort_stable and sort_stable_by allocate: their error names the `_in` form).
// EXPECT: 1 1 2 3 | b1 a2 c2
struct Item { name: [u8], k: i64 }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    v.push(2);
    v.push(1);
    sort_stable_in(v.as_mut_slice(), gpa);
    var items: Vec<Item> = Vec::new_in(gpa);
    items.push(Item { name: "a", k: 2 });
    items.push(Item { name: "b", k: 1 });
    items.push(Item { name: "c", k: 2 });
    sort_stable_by_in(items.as_mut_slice(), |x, y| x.k - y.k, gpa);
    let i = items.as_slice();
    println(
        f"{v[0]} {v[1]} {v[2]} {v[3]} | {i[0].name}{i[0].k} {i[1].name}{i[1].k} {i[2].name}{i[2].k}");
    0
}
