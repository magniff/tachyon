// FLAGS: --values=error
// EXPECT: 40 41 20 1
// EXPECT: 194.000000 194.000000
// (0.17) Reference parameters under --values=error (docs/design/
// value-semantics.md §4, "Optimizer work"): a `&T` parameter is frozen for
// the call, so its loads are kept across a call and across stores through a
// `&mut T`; a `&mut [T]` parameter shares no memory with another reference
// parameter, so the vector loop needs no run-time overlap test (no address
// comparison `from u64`) and no scalar fallback loop.
// CHECK: fn twice:
// CHECK: load v1
// CHECK: call tick
// CHECK-NOT: load
// CHECK: ret
// CHECK: fn bump:
// CHECK: load v2
// CHECK-NOT: load
// CHECK: ret
// CHECK: fn axpy:
// CHECK-NOT: from u64
// CHECK-NOT: : f64 = load
// CHECK: fn main:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

static var COUNT: i64 = 0;

#[inline(never)]
fn tick() {
    unsafe { COUNT += 1; }
}

#[inline(never)]
fn twice(x: i64) -> i64 {
    let a = x;
    tick();
    a + x
}

#[inline(never)]
fn bump(dst: inout i64, src: i64) -> i64 {
    dst = src + 1;
    dst = dst + src;
    src
}

#[inline(never)]
fn axpy(x: [f64], y: inout [f64], k: f64) {
    for i in 0..y.len {
        y[i] = y[i] + k * x[i];
    }
}

fn main() -> i32 {
    let v = 20;
    var w = 1;
    let r = twice(v);
    let s = bump(&w, v);
    unsafe { printf(c"%ld %ld %ld %ld\n", r, w, s, COUNT); }
    let a: [f64; 64] = [64.0; 64];
    var b: [f64; 64] = [2.0; 64];
    axpy(a[..], &b[..], 3.0);
    unsafe { printf(c"%f %f\n", b[0], b[63]); }
    0
}
