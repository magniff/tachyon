// sem-own: HashMap::insert over a key, its result discarded: the old value is dropped at the statement end.
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
use std::HashMap;

fn main(gpa: Gpa) {
    var m: HashMap<i64, D> = HashMap::new_in(gpa);
    m.insert(1, mk(1, gpa));
    m.insert(1, mk(2, gpa));
    println("end");
}
