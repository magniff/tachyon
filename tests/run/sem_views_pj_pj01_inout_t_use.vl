// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 2 (an inout projection, written through)
// XFAIL: OVERSTRICT -> let T / -> inout T projections (D21) are rejected: 'references as results come in 0.17.1'
// EXPECT: 2
fn top(v: inout Vec<i64>) -> inout i64 { &v[0] }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    inout t = top(&v);
    t += 1;
    println(v[0]);
    0
}
