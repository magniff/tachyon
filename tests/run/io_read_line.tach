// read_line (0.15) returns Result<bool, IoError>: Ok(true) for a line
// (an empty one too), Ok(false) at the end of input, which leaves `line`
// empty; the last line needs no '\n'.
// STDIN: first
// STDIN:
// STDIN: third, last
// EXPECT: [first] [] [third, last] end []
// EXPECT: still end
use std::{Buf, read_line};

fn main(gpa: Gpa) {
    let mut line = Buf::new_in(gpa);
    defer line.free();
    loop {
        match read_line(&line) {
            Ok(true) => {
                print("[");
                print(line.as_slice());
                print("] ");
            }
            Ok(false) => break,
            Err(_) => {
                println("read error");
                return;
            }
        }
    }
    print("end [");
    print(line.as_slice());
    println("]");
    println(if read_line(&line).unwrap_or(true) { "more" } else { "still end" });
}
