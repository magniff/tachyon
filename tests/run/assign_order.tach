// An assignment evaluates its right-hand side first, then the place; a
// compound assignment then reads the old value (since 0.3).
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
    fn realloc(p: *u8, size: u64) -> *u8;
}

static var LOG: [i64; 16] = [0; 16];
static var N: i64 = 0;

fn note(x: i64) -> i64 {
    LOG[N] = x;
    N += 1;
    x
}

struct P { x: i64, y: i64 }

static var PS: *P = 0 as *P;
static var CAP: i64 = 0;

// Grows (moves) PS, as a parser growing its node array would.
fn grow() -> i64 {
    CAP *= 4;
    unsafe { PS = realloc(PS as *u8, (CAP * 16) as u64) as *P; }
    7
}

fn main() {
    var a: [i64; 4] = [0; 4];
    a[note(1)] = note(2);
    a[note(3)] += note(5);
    for i in 0..N {
        unsafe { printf(c"%ld ", LOG[i]); }
    }
    unsafe { printf(c"| %ld %ld %ld\n", a[1], a[2], a[3]); }

    CAP = 1;
    unsafe {
        PS = malloc(16) as *P;
        PS[0] = P { x: 1, y: 2 };
        PS[0].y = grow();
        PS[0].x += grow();
        printf(c"%ld %ld\n", PS[0].x, PS[0].y);
    }

    var x = 1;
    x += {
        x = 5;
        1
    };
    unsafe { printf(c"%ld\n", x); }

    var y = 10;
    let p = &y as *i64;
    unsafe {
        *p -= {
            *p = 100;
            1
        };
        printf(c"%ld\n", y);
    }

    var s = P { x: 3, y: 4 };
    var t = P { x: 0, y: 0 };
    t = {
        s.x = 30;
        s
    };
    unsafe { printf(c"%ld %ld\n", t.x, t.y); }
}

// EXPECT: 2 1 5 3 | 2 0 5
// EXPECT: 8 7
// EXPECT: 6
// EXPECT: 99
// EXPECT: 30 4
