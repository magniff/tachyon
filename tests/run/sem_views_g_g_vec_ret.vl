// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `o.get(0)`; s grows while it is used
// ERROR: error[own.conflict]
fn mk(w: str, gpa: Gpa) -> Vec<str> { var v: Vec<str> = Vec::new_in(gpa); v.push(w); v }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let o = mk(w, gpa);
    let r = o.get(0);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
