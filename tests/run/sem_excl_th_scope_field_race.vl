// ERROR: sync
use std::thread;
struct S { n: i64 }
fn bump(n: inout i64) { n += 1; }
fn main() { var s = S { n: 0 }; thread::scope(|sc| { let x = sc.spawn(|| { for i in 0..1000000 { bump(&s.n); } 0 }); let y = sc.spawn(|| { for i in 0..1000000 { bump(&s.n); } 0 }); x.join() + y.join() }); println(f"{s.n}"); }
