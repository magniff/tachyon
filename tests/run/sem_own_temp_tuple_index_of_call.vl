// sem-own: a tuple element moved out of a call result: the rest dropped once.
// EXPECT: drop 1
// EXPECT: got 2
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn mt(gpa: Gpa) -> (D, D) { (mk(1, gpa), mk(2, gpa)) }

fn main(gpa: Gpa) {
    let b = mt(gpa).1;
    println(f"got {b.id}");
}
