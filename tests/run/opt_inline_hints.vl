// The inliner honours the hints (0.6): `#[inline(never)]` keeps a tiny
// function's calls, `#[cold]` keeps a function out of its callers (and
// its call sites cold), `#[inline]` inlines a function the cost model
// would not (it has two call sites and is big).
// EXPECT: 3 4 1 100
// CHECK: fn tiny:
// CHECK: fn main:
// CHECK: call tiny
// CHECK: call report
// CHECK-NOT: call big
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

#[inline(never)]
fn tiny(x: i64) -> i64 {
    x + 1
}

#[cold]
fn report(code: i64) -> i64 {
    unsafe { printf(c"failure %ld\n", code); }
    code
}

#[inline]
fn big(x: i64) -> i64 {
    var t = 0;
    for i in 0..x {
        t += i * 3 + 1;
        t ^= i & 7;
        t += (i << 2) - (i >> 1);
        t = t % 1000003;
        t += i * i - 2 * i;
        t = t % 1000003;
    }
    t / 100 + x * 0 + 1
}

fn main() -> i32 {
    let a = tiny(2);
    let b = tiny(3);
    let c = if a > 100 { report(a) } else { big(1) };
    let d = if b > 100 { report(b) } else { big(10) * 0 + 100 };
    unsafe { printf(c"%ld %ld %ld %ld\n", a, b, c, d); }
    0
}
