// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.moved (or conflict): a move-only view used after it moved
// XFAIL: SOUNDNESS a move-only view (inout field) is copied, not moved: two exclusive accesses
// ERROR: error[own.moved]
struct P { q: inout Vec<i64> }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    var p = P { q: &v };
    var p2 = p;
    p.q.push(1);
    p2.q.push(2);
    println(v.len());
    0
}
