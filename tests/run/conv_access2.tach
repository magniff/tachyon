// 0.20 T1: a temporary passed to a let parameter that borrows, `let x =
// part;` borrowing an element (conventions.md D13), `match &x` binding
// inout accesses, a `sink |..|` closure taking its captures.
// FLAGS: --syntax=0.20
// EXPECT: 1 1 2
// EXPECT: 3 40
// EXPECT: 1
enum St { Run(i64), Stop }

struct M { st: St }

fn make(gpa: Gpa) -> Vec<i64> {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v
}

fn total(v: Vec<i64>) -> i64 { v.len() }

fn first(rows: Vec<Vec<i64>>) -> i64 {
    let row = rows[0];
    row.len()
}

fn tick(m: inout M) {
    match &m.st {
        St::Run(n) => n += 1,
        St::Stop => {}
    }
}

fn show(m: M) -> i64 {
    match m.st {
        St::Run(n) => n,
        St::Stop => 0,
    }
}

fn main(gpa: Gpa) {
    var rows: Vec<Vec<i64>> = Vec::new_in(gpa);
    rows.push(make(gpa));
    let row = rows[0];
    println(f"{total(make(gpa))} {first(rows)} {row.len() + rows.len()}");
    var m = M { st: St::Run(1) };
    tick(&m);
    tick(&m);
    var o: Option<i64> = Some(4);
    match &o {
        Some(x) => x *= 10,
        None => {}
    }
    println(f"{show(m)} {o.unwrap()}");
    let f = sink || rows.len();
    println(f());
}
