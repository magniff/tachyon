// An f-string calls a Display impl that prints.
// ERROR: 'show' is #[effects(alloc(Gpa))], but it does io
use std::{Display, Fmt};
struct Loud { n: i64 }

impl Display for Loud {
    fn fmt(self, f: inout Fmt) { println("io"); f.int(self.n); }
}

#[effects(alloc(Gpa))]
fn show(x: Loud, gpa: Gpa) -> i64 { format_in(f"{x}", gpa).len() }

fn main(gpa: Gpa) -> i32 {
    println(show(Loud { n: 5 }, gpa));
    0
}
