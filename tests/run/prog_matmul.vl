// Integer and floating-point matrix multiplication with 2D arrays.
// EXPECT: 70 50 10 -50 | 0.307417
// EXPECT: 150 98 -6 -162 | 1.016333
// EXPECT: 230 146 -22 -274 | 2.656677
// EXPECT: 310 194 -38 -386 | 12.095238
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    var a: [[i64; 4]; 4] = [[0; 4]; 4];
    var b: [[i64; 4]; 4] = [[0; 4]; 4];
    var c: [[i64; 4]; 4] = [[0; 4]; 4];
    var f: [[f64; 4]; 4] = [[0.0; 4]; 4];
    var i = 0;
    while i != 4 {
        var j = 0;
        while j != 4 {
            a[i][j] = i * 4 + j + 1;
            b[i][j] = (i - j) * (i + j + 1);
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i != 4 {
        var j = 0;
        while j != 4 {
            var k = 0;
            var s = 0;
            var fs: f64 = 0.0;
            while k != 4 {
                s += a[i][k] * b[k][j];
                fs += a[i][k] as f64 * 0.5 / (b[k][j] as f64 + 10.5);
                k += 1;
            }
            c[i][j] = s;
            f[i][j] = fs;
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i != 4 {
        unsafe {
            printf(c"%ld %ld %ld %ld | %.6f\n", c[i][0], c[i][1], c[i][2], c[i][3], f[i][i]);
        }
        i += 1;
    }
    0
}
