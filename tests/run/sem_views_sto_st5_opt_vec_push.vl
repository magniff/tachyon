// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text stored with `?`; s grows while it is used
// (0.25, after fix25c: refused first because `l`, a let binding, is pushed
// to: own.readonly; the stored view's own.moved is not reached)
// ERROR: error[own.readonly]
struct D { t: str }
struct B { l: Vec<str> }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var o: Option<Vec<str>> = Some(Vec::new_in(gpa)); if let Some(l) = o { l.push(w); }
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(o.unwrap().len());
    0
}
