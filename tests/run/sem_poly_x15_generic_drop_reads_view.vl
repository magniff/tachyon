// a generic Drop that reads its field, T = [i64] viewing a Vec declared after it
// ERROR: [own.drop_view]
trait Show { fn show(self) -> i64; }
impl Show for [i64] { fn show(self) -> i64 { self[0] } }
struct G<T: Show> { x: T }
impl<T: Show> Drop for G<T> { fn drop(inout self) { println(f"drop G {self.x.show()}"); } }

fn main(gpa: Gpa) {
    let arr = [1, 1];
    var g = G { x: arr[..] };
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..100 { v.push(i + 1000); }
    g = G { x: v.as_slice() };
    println("end");
}
