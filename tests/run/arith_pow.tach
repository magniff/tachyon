// Integer exponentiation with `**`.
// EXPECT: 1024 1 1000000000000000000 -8 16
// EXPECT: 7 2401
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let two: i64 = 2;
    let three: i64 = 3;
    let ten: i64 = 10;
    let m: i64 = 0 - 2;
    printf("%ld %ld %ld %ld %ld\n".0, two ** 10, three ** 0, ten ** 18, m ** 3, m ** 4);
    let b: i64 = 7;
    printf("%ld %ld\n".0, b ** 1, b ** 2 ** 2);
    0
}
