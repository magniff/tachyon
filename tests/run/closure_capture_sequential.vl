// (0.25) The closure model's fine cases: calls in a row, reads after the
// last call, two closures used one after the other, a closure that only
// reads n while n is read too, and a value passed as a parameter instead
// of captured.
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    var add = |x: i64| v.push(x);
    add(1);
    add(2);
    println(f"{v.len()}");
    var n = 0;
    var f = || { n += 10; };
    f();
    var g = || { n += 100; };
    g();
    println(f"{n}");
    let peek = || n * 2;
    println(f"{n} {peek()}");
    var bump = |m: inout i64| { m += 1; };
    bump(&n);
    bump(&n);
    println(f"{n}");
}
// EXPECT: 2
// EXPECT: 110
// EXPECT: 110 220
// EXPECT: 112
