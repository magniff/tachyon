// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: BTreeMap insert while iterating
// ERROR: error[own.conflict]
use std::collections::btree_map::BTreeMap;

fn main(gpa: Gpa) -> i32 {
    var m: BTreeMap<i64, i64> = BTreeMap::new_in(gpa);
    for i in 0..40 { m.insert(i, i); }
    for (k, x) in m.iter() { m.insert(k + 1000, x); }
    println(m.len());
    0
}
