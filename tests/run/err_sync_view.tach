// (0.21) A view cannot move to a thread that may outlive what it views.
// ERROR: 'thread::spawn' moves 's' ([i64] is a view) to a thread that may outlive what it views

use std::thread;

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = v.as_slice();
    let h = thread::spawn(move || s.len());
    println(f"{h.join()}");
}
