// sem-own: `for x in v` over an owned Vec of owned items: each item dropped
// once (in the body, or with the Vec), never twice.
// EXPECT: it 1
// EXPECT: it 2
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    var v: Vec<D> = Vec::new_in(gpa);
    v.push(mk(1, gpa));
    v.push(mk(2, gpa));
    for x in v { println(f"it {x.id}"); }
    println("end");
}
