// a let receiver (owned) and a closure argument that reallocates it
// ERROR: own.conflict
struct S { v: Vec<i64> }
impl S { fn peek<F: FnMut()>(self, w: F) -> i64 { let s = self.v.as_slice(); w(); s[0] } }
fn main(gpa: Gpa) { var s = S { v: Vec::new_in(gpa) }; s.v.push(1); let r = s.peek(|| { for i in 0..1000 { s.v.push(i); } }); println(f"{r}"); }
