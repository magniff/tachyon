// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: v pushed inside a for inout over it
// XFAIL: OVERSTRICT for inout x in &v (D-T3c) is a parser error naming 'inout' as a keyword
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    for inout x in &v { x += 1; v.push(1); }
    println(v.len());
    0
}
