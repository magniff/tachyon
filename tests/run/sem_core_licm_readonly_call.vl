// A readonly call in a loop whose argument changes in the loop.
// FLAGS: -O2
// EXPECT: 15
static var Z: i64 = 0;
#[inline(never)]
fn first(v: Vec<i64>) -> i64 { v[0] }
fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var t = 0;
    var k = 0;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    while k < 5 + Z { t += first(v); v[0] += 1; k += 1; }
    println(t);
    0
}
