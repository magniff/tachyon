// sem-own: `return` from nested blocks and a loop drops every live local once, innermost first.
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: r 7
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn f(gpa: Gpa) -> i64 {
    let a = mk(1, gpa);
    {
        let b = mk(2, gpa);
        loop {
            let c = mk(3, gpa);
            return 7;
        }
    }
}

fn main(gpa: Gpa) {
    println(f"r {f(gpa)}");
}
