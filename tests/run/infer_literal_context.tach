// Literals take their type from context: annotations, the other operand,
// struct fields and arguments, including negative values.
// EXPECT: 255 -128 -7 4 247 2147483653 -600 -1.5
// EXPECT: -5 65535 1.5 -11745
// EXPECT: 18446744073709551614 0 -9223372036854775808
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct S { a: i8, b: u16, c: f32 }

fn take(x: i16, y: u8) -> i64 { x as i64 * 1000 + y as i64 }

fn main() -> i64 {
    let a: u8 = 200 + 55;
    let b: i8 = -128;
    let c: i32 = 0 - 7;
    let x: u8 = 3;
    let d = 1 + x;
    let e = 250 - x;
    let f: u32 = (1 << 31) | 5;
    let g: i16 = -(300 * 2);
    let h: f32 = -1.5;
    let s = S { a: -5, b: 65535, c: 0.5 * 3.0 };
    printf(c"%d %d %d %d %d %u %d %.1f\n", a, b, c, d, e, f, g, h);
    printf(c"%d %d %.1f %ld\n", s.a, s.b, s.c, take(-12, 255));
    let big: u64 = 18446744073709551615 - 1;
    let t = 0 == x;
    let k: i64 = -9223372036854775807 - 1;
    printf(c"%lu %d %ld\n", big, t, k);
    0
}
