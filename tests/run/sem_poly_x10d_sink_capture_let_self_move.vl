// a sink closure capturing a let self moves it out
// ERROR: [own.move_out]: cannot move 'self'
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn eat(r: sink R) -> i64 { r.id }
impl R { fn n(self) -> i64 { let c = sink || eat(self); c() } }

fn main() {
    let r = R { id: 1 };
    println(f"{r.n()}");
    println("end");
}
