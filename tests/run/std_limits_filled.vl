// (0.15) std's integer limits (Rust's `i64::MAX` is `std::I64_MAX`:
// integer types have no associated constants) and `Vec::filled(n, x)`,
// Rust's `vec![x; n]` (x copied, not cloned).
// EXPECT: -9223372036854775808 9223372036854775807 -2147483648 4294967295 255
// EXPECT: 3 7 7 7
use std::{I32_MIN, I64_MAX, I64_MIN, U32_MAX, U8_MAX, Vec, print_int};

fn main(gpa: Gpa) {
    print_int(I64_MIN);
    print(" ");
    print_int(I64_MAX);
    print(" ");
    print_int(I32_MIN);
    print(" ");
    print_int(U32_MAX);
    print(" ");
    print_int(U8_MAX);
    println("");
    var v = Vec::filled_in(3, 7, gpa);
    print_int(v.len());
    for x in v.as_slice() {
        print(" ");
        print_int(x);
    }
    println("");
}
