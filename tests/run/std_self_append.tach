// FLAGS: --check-unsafe -O1
// EXPECT: buf 3072 ok
// EXPECT: vec 1536 ok
// EXPECT: cstr 13 abcdef abcdef
// 0.14: appending a view of a Buf or Vec to itself: growing must not
// free the memory the view reads (std copies into the new block before
// freeing the old one). --check-unsafe stops a read of freed memory;
// push_cstr of its own bytes appended them forever.
use std::Buf;

fn main(gpa: Gpa) -> i32 {
    let mut b = Buf::new_in(gpa);
    defer b.free();
    b.push_str("abc");
    for _ in 0..10 {
        b.push_str(b.as_slice());
    }
    let s = b.as_slice();
    let mut ok = true;
    for i in 0..s.len {
        ok = ok && s[i] == "abc"[i % 3];
    }
    print("buf ");
    std::print_int(b.len());
    println(if ok { " ok" } else { " WRONG" });

    let mut v: Vec<i64> = Vec::new_in(gpa);
    defer v.free();
    v.push(1);
    v.push(2);
    v.push(3);
    for _ in 0..9 {
        v.extend_from_slice(v.as_slice());
    }
    let t = v.as_slice();
    ok = true;
    for i in 0..t.len {
        ok = ok && t[i] == i % 3 + 1;
    }
    print("vec ");
    std::print_int(v.len());
    println(if ok { " ok" } else { " WRONG" });

    let mut d = Buf::new_in(gpa);
    defer d.free();
    d.push_str("abcdef");
    d.push(0);
    unsafe {
        d.push_cstr(d.as_slice().ptr);
    }
    print("cstr ");
    std::print_int(d.len());
    print(" ");
    print(d.as_slice()[0..6]);
    print(" ");
    println(d.as_slice()[7..13]);
    0
}
