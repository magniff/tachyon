// (0.25) A struct with an inout field is move-only: it does not derive
// Clone, and `.clone()` without an impl is no copy of it.
#[derive(Clone)]
struct C { n: inout i64 }
struct D { n: inout i64 }
fn main() { var x = 1; let d = D { n: &x }; let e = d.clone(); e.n += 1; println(f"{x}"); }
// ERROR: 'C' cannot derive Clone: its field 'n' is an inout access, so the struct is move-only
// ERROR: no method 'clone' on type 'D'
