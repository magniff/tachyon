// calls through fn(sink R): each R dropped once, in the callee
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: 1
// EXPECT: drop 2
// EXPECT: 2
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn eat(r: sink R) -> i64 { r.id }

fn main() {
    let f: fn(sink R) -> i64 = eat;
    let r = R { id: 1 };
    println(f"{f(r)}");
    println(f"{f(R { id: 2 })}");
    println("end");
}
