// Ranges at the integer extremes run exactly their length: no wrap into an
// endless loop, no lost iteration.
// EXPECT: 2 3 2 6 3 0 1
// EXPECT: 9223372036854775807
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let max = 9223372036854775807 + Z;
    let min = -9223372036854775807 - 1 + Z;
    var n = 0;
    for _ in max - 2..max { n += 1; }
    print(f"{n} ");
    n = 0;
    for _ in max - 2..=max { n += 1; }
    print(f"{n} ");
    n = 0;
    for _ in min..min + 2 { n += 1; }
    print(f"{n} ");
    n = 0;
    let lo: u8 = 250 + Z as u8;
    let hi: u8 = 255 + Z as u8;
    for _ in lo..=hi { n += 1; }
    print(f"{n} ");
    n = 0;
    let ilo: i8 = 125 + Z as i8;
    let ihi: i8 = 127 + Z as i8;
    for _ in ilo..=ihi { n += 1; }
    print(f"{n} ");
    n = 0;
    for _ in max..min { n += 1; }
    print(f"{n} ");
    n = 0;
    for _ in max..=max { n += 1; }
    println(f"{n}");
    var last = 0;
    for i in max - 1..=max { last = i; }
    println(last);
    0
}
