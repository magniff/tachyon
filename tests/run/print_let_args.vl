// (0.25) print, println, eprint, eprintln, format_in, format,
// to_string_in and writeln take their value as `let` (the methods
// Buf::push_fmt, String::push_fmt and Fmt::write still take it `sink`):
// it is still usable after printing.
// EXPECT: héllo
// EXPECT: héllohéllo
// EXPECT: P1
// EXPECT: P1
// EXPECT: P1héllo
// EXPECT: héllo
// EXPECT: 6
// STDERR: héllo
struct P { v: Vec<i64> }

impl Display for P {
    fn fmt(self, f: inout Fmt) { f.write(f"P{self.v.len()}"); }
}

fn main(gpa: Gpa) -> i32 {
    let s = String::from_in("héllo", gpa);
    println(s);
    print(s);
    println(s);
    eprintln(s);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let p = P { v: v };
    println(p);
    println(p);
    var out = Buf::new_in(gpa);
    out.push_fmt(f"{p}{s}");
    println(out.as_slice());
    let b = format_in(s, gpa);
    println(b.as_slice());
    println(s.len());
    0
}
