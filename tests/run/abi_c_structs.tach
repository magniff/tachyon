// #[repr(C)] aggregates passed to and returned from C by value, and C
// calling extern "C" tachyon functions with them: every shape of both conventions (AArch64
// HFAs, x0/x1 pairs and references; x86-64 INTEGER and SSE eightbytes and
// MEMORY), on the stack too when registers run out.
// CSOURCE: tests/c/abi_structs.c
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

#[repr(C)]
struct I8x3 { a: u8, b: u8, c: u8 }
#[repr(C)]
struct I32x3 { a: i32, b: i32, c: i32 }
#[repr(C)]
struct I64x2 { a: i64, b: i64 }
#[repr(C)]
struct I64x3 { a: i64, b: i64, c: i64 }
#[repr(C)]
struct F32x2 { x: f32, y: f32 }
#[repr(C)]
struct F32x3 { x: f32, y: f32, z: f32 }
#[repr(C)]
struct F64x4 { a: f64, b: f64, c: f64, d: f64 }
#[repr(C)]
struct Mixed { x: f64, n: i32 }
#[repr(C)]
struct MixedF { n: i32, x: f32 }
#[repr(C)]
enum Tagged { Zero(f64), One(f64), Two(f64) }
#[repr(C)]
struct Slice { ptr: *i64, len: u64 }

extern "C" {
    fn c_i8x3(v: I8x3, k: i32) -> I8x3;
    fn c_i32x3(v: I32x3) -> I32x3;
    fn c_i64x2(v: I64x2, w: I64x2) -> I64x2;
    fn c_i64x3(v: I64x3) -> I64x3;
    fn c_f32x2(v: F32x2) -> F32x2;
    fn c_f32x3(v: F32x3, k: f32) -> F32x3;
    fn c_f64x4(v: F64x4) -> F64x4;
    fn c_mixed(v: Mixed) -> Mixed;
    fn c_mixedf(v: MixedF) -> MixedF;
    fn c_tagged(v: Tagged) -> Tagged;
    fn c_slice_sum(s: Slice) -> i64;
    fn c_many(a: F64x4, b: F32x3, c: Mixed, d: I64x2, e: I64x2, f: I64x2, g: I64x2,
                     h: I32x3, i: F32x2, j: f64, k: I8x3) -> f64;
    fn c_call_back(f: extern "C" fn(Mixed, F32x3, I8x3) -> Mixed) -> f64;
    fn c_call_big(f: extern "C" fn(I64x3, F64x4) -> F64x4) -> f64;
}

extern "C" fn back(m: Mixed, v: F32x3, b: I8x3) -> Mixed {
    Mixed { x: m.x + v.z as f64, n: m.n + b.c as i32 }
}

extern "C" fn big(a: I64x3, b: F64x4) -> F64x4 {
    F64x4 { a: b.a * a.c as f64, b: b.b, c: b.c * a.a as f64, d: a.b as f64 }
}

fn value(t: Tagged) -> f64 {
    match t {
        Tagged::Zero(x) => x,
        Tagged::One(x) => x + 100.0,
        Tagged::Two(x) => x + 200.0,
    }
}

fn main() {
    let a = c_i8x3(I8x3 { a: 1, b: 2, c: 250 }, 3);
    printf(c"%d %d %d\n", a.a as i32, a.b as i32, a.c as i32);
    let b = c_i32x3(I32x3 { a: 1, b: -2, c: 3 });
    printf(c"%d %d %d\n", b.a, b.b, b.c);
    let c = c_i64x2(I64x2 { a: 10, b: 20 }, I64x2 { a: 1, b: 2 });
    printf(c"%ld %ld\n", c.a, c.b);
    let d = c_i64x3(I64x3 { a: 1, b: 2, c: 3 });
    printf(c"%ld %ld %ld\n", d.a, d.b, d.c);
    let e = c_f32x2(F32x2 { x: 1.0, y: 2.0 });
    printf(c"%.2f %.2f\n", e.x as f64, e.y as f64);
    let f = c_f32x3(F32x3 { x: 1.0, y: 2.0, z: 3.0 }, 1.5);
    printf(c"%.2f %.2f %.2f\n", f.x as f64, f.y as f64, f.z as f64);
    let g = c_f64x4(F64x4 { a: 1.0, b: 2.0, c: 3.0, d: 4.0 });
    printf(c"%.1f %.1f %.1f %.1f\n", g.a, g.b, g.c, g.d);
    let h = c_mixed(Mixed { x: 2.25, n: 41 });
    printf(c"%.2f %d\n", h.x, h.n);
    let i = c_mixedf(MixedF { n: 5, x: 2.5 });
    printf(c"%d %.2f\n", i.n, i.x as f64);
    printf(c"%.2f\n", value(c_tagged(Tagged::One(9.0))));
    let xs: [i64; 5] = [1, 2, 3, 4, 5];
    let tail = xs[1..];
    printf(c"%ld\n", c_slice_sum(Slice { ptr: tail.ptr, len: tail.len }));
    let many = c_many(F64x4 { a: 1.0, b: 0.0, c: 0.0, d: 2.0 }, F32x3 { x: 0.0, y: 0.0, z: 3.0 },
                      Mixed { x: 4.0, n: 5 }, I64x2 { a: 6, b: 0 }, I64x2 { a: 0, b: 7 },
                      I64x2 { a: 8, b: 0 }, I64x2 { a: 0, b: 9 }, I32x3 { a: 0, b: 0, c: 10 },
                      F32x2 { x: 0.0, y: 11.0 }, 12.0, I8x3 { a: 0, b: 0, c: 13 });
    printf(c"%.1f\n", many);
    printf(c"%.1f\n", c_call_back(back));
    printf(c"%.4f\n", c_call_big(big));
}

// EXPECT: 4 5 253
// EXPECT: 3 -4 1
// EXPECT: 12 19
// EXPECT: 10 20 30
// EXPECT: 2.00 1.50
// EXPECT: 1.50 3.00 4.50
// EXPECT: 4.0 3.0 2.0 1.0
// EXPECT: 4.50 42
// EXPECT: 15 1.50
// EXPECT: 204.50
// EXPECT: 14
// EXPECT: 91.0
