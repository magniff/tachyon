// sem-own: max over owned items needs Ord; min/max by count instead: any() drops the items it looked at.
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: any true
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let a = (0..3).map(|i| mk(i, gpa)).any(|d| d.id == 1);
    println(f"any {a}");
}
