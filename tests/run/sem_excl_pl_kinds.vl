// inout on every kind of place, each changed once
// EXPECT: 2 2 2 2 2 2 2 2 2 2 2
struct I { a: i64 }
struct S { n: i64, i: I, arr: [i64; 2], v: Vec<i64>, ps: Vec<I> }
enum E { A(i64), B }
static var G: i64 = 1;
fn bump(n: inout i64) { n += 1; }
fn main(gpa: Gpa) {
    var x = 1;
    var s = S { n: 1, i: I { a: 1 }, arr: [1, 1], v: Vec::new_in(gpa), ps: Vec::new_in(gpa) };
    s.v.push(1); s.ps.push(I { a: 1 });
    var t = (1, 1);
    var m = [[1, 1], [1, 1]];
    var e = E::A(1);
    bump(&x); bump(&s.n); bump(&s.i.a); bump(&s.arr[1]); bump(&s.v[0]); bump(&s.ps[0].a);
    bump(&t.1); bump(&m[1][0]);
    match &e { E::A(k) => bump(&k), E::B => {} }
    bump(&G);
    var en = 0; match e { E::A(k) => { en = k; } E::B => {} }
    var o: Option<i64> = Some(1);
    if let Some(k) = &o { bump(&k); }
    println(f"{x} {s.n} {s.i.a} {s.arr[1]} {s.v[0]} {s.ps[0].a} {t.1} {m[1][0]} {en} {G} {o.unwrap()}");
}
