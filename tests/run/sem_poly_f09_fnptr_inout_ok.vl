// a call through fn(inout i64) with '&': changes n; a non-capturing closure coerced too
// FLAGS: --check-alloc
// EXPECT: 11
// XFAIL: OVERSTRICT a non-capturing closure with an inout parameter as a fn value needs unsafe ('pointer parameters')
fn bump(n: inout i64) { n += 1; }

fn main() {
    var f: fn(inout i64) = bump;
    var n = 0;
    f(&n);
    f = |k: inout i64| { k += 10; };
    f(&n);
    println(f"{n}");
}
