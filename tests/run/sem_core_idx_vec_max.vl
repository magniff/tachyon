// A Vec index of i64::MAX is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index 9223372036854775807, length 1
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(v[9223372036854775807 + Z]);
    println("not reached");
    0
}
