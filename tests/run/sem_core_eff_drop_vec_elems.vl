// Dropping a Vec drops its elements: a Drop that prints makes it io.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(inout self) { println("dropped"); } }

#[no_io]
fn quiet(v: sink Vec<Noisy>) -> i64 { v.len() }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<Noisy> = Vec::new_in(gpa);
    v.push(Noisy { n: 1 });
    println(quiet(v));
    0
}
