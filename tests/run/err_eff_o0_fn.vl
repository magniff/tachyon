// 0.16: at -O0 the effects are inferred only when something reads them;
// a function's declaration is checked there too.
// FLAGS: -O0
// ERROR: 'counted' is #[pure], but it uses a static (global)
// ERROR-COUNT: 1
static var SEEN: i64 = 0;

#[pure]
fn counted(x: i64) -> i64 {
    unsafe { SEEN += x; }
    x
}

fn main() {
    println(f"{counted(1)}");
}
