use std::collections::btree_map::BTreeMap;

fn main(gpa: Gpa) -> i32 {
    var m: BTreeMap<i64, i64> = BTreeMap::new_in(gpa);
    m.insert(1, 1);
    let a = m.get_mut(1).unwrap();
    for i in 2..200 { m.insert(i, i); }
    a[0] += 1;
    println(m.len());
    0
}
