// A function whose body has an assert (and calls nothing with a requires)
// gets the unknown effect set (--print-effects: "(unknown)"), and an
// unknown function's declarations are not checked: this #[pure] one
// prints and the #[no_alloc] one pushes, both accepted.
// ERROR: 'f' is #[no_alloc], but it allocates from Gpa
#[no_alloc]
fn f(v: inout Vec<i64>) { assert(v.len() >= 0); v.push(1); }

#[pure]
fn g(x: i64) -> i64 { assert(x > 0); println("io in pure"); x }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    f(&v);
    println(g(v.len()));
    0
}
