// FLAGS: --check-alloc
// ARGS: x yz
// EXPECT: 3 x yz 2
// EXPECT: true Err(NotPresent)
// EXPECT: true
// EXPECT: 20 "one\ntwo\r\nthree\nfour\n"
// EXPECT: 20 111
// EXPECT: <one><two><three><four>
// EXPECT: 4 5 "one\ntwo\r\n"
// EXPECT: 16 true false "0 0\n1 1\n2 4\nend\n"
// EXPECT: 5
// EXPECT: ["a", "w.txt"] 1
// EXPECT: true 21
// EXPECT: false false true
// EXPECT: false
// EXPECT: No such file or directory (os error 2) | NotFound | Some(2) | Os { code: 2, kind: NotFound, message: "No such file or directory" }
// EXPECT: invalid data Custom { kind: InvalidData, error: "invalid data" }
// EXPECT: Some("libfoo.so.1") Some("1") Some("libfoo.so") Some("/usr/lib") true
// EXPECT: Some("b") Some("a") true true true true false
// EXPECT: [/][a][b][c]
// EXPECT: /x true
// EXPECT: exit status: 3 false Some(3) "out\n" "err\n"
// EXPECT: true
// EXPECT: spawn: NotFound
// 0.20 (B6): std::fs, std::io, std::path, std::env and std::process:
// create_dir_all (twice), write/append/read_to_string_in/read_in,
// BufReader's lines_in and read_line, BufWriter with writeln (flushed when
// dropped), metadata, OpenOptions' append, Read::read_to_string, read_dir,
// rename, copy, remove_file, remove_dir_all, io::Error's Display and
// Debug, Path's parts and components, PathBuf's push/set_extension/pop,
// env::args/get_in/current_dir_in, Command's output_in and status (and a
// program that is not there).
use std::{env, fs, io};
use std::fs::{File, OpenOptions};
use std::io::{BufRead, BufReader, BufWriter, Read, Write, writeln};
use std::path::{Path, PathBuf};
use std::process::{Command, Stdio};

fn files(dir: PathBuf, gpa: Gpa) -> io::Result<()> {
    let sub = dir.join_in("a/b", gpa);
    fs::create_dir_all(sub)?;
    fs::create_dir_all(sub)?;
    let x = sub.join_in("x.txt", gpa);
    fs::write(x, "one\ntwo\r\nthree")?;
    fs::append(x, "\nfour\n")?;
    let text = fs::read_to_string_in(x, gpa)?;
    println(f"{text.len()} {text:?}");
    let bytes = fs::read_in(x, gpa)?;
    println(f"{bytes.len()} {bytes[0]}");
    let r = BufReader::new(File::open(x)?);
    for line in r.lines_in(gpa) {
        let line = line?;
        print(f"<{line}>");
    }
    println("");
    var r2 = BufReader::new(File::open(x)?);
    var s = String::new_in(gpa);
    let n1 = r2.read_line(&s)?;
    let n2 = r2.read_line(&s)?;
    println(f"{n1} {n2} {s:?}");
    let w_path = dir.join_in("w.txt", gpa);
    {
        var w = BufWriter::new(File::create(w_path)?);
        for i in 0..3 {
            writeln(&w, f"{i} {i * i}")?;
        }
        w.write_all("end\n")?;
    }
    let m = fs::metadata(w_path)?;
    let wtext = fs::read_to_string_in(w_path, gpa)?;
    println(f"{m.len()} {m.is_file()} {m.is_dir()} {wtext:?}");
    var f = OpenOptions::new().append(true).open(w_path)?;
    f.write_all("more\n")?;
    var back = String::new_in(gpa);
    var rf = File::open(w_path)?;
    rf.read_to_string(&back)?;
    println(f"{back.lines().count()}");
    var names: Vec<str> = Vec::new_in(gpa);
    var kinds = 0;
    var list = fs::read_dir(dir)?;
    var keep: Vec<String> = Vec::new_in(gpa);
    for e in list {
        var e = e?;
        keep.push(e.file_name().to_str().unwrap().to_string_in(gpa));
        if e.is_dir() {
            kinds += 1;
        }
    }
    keep.sort();
    println(f"{keep:?} {kinds}");
    let w2 = dir.join_in("w2.txt", gpa);
    fs::rename(w_path, w2)?;
    let n = fs::copy(w2, w_path)?;
    println(f"{fs::exists(w_path)} {n}");
    fs::remove_file(w_path)?;
    println(f"{fs::exists(w_path)} {w_path.as_path().exists()} {w2.as_path().is_file()}");
    fs::remove_dir_all(dir)?;
    println(f"{fs::exists(dir)}");
    Ok(())
}

fn errors() {
    match File::open("/nonexistent-dir-tachyon/x") {
        Ok(_) => println("??"),
        Err(e) => println(f"{e} | {e.kind():?} | {e.raw_os_error():?} | {e:?}"),
    }
    let e = io::Error::from(io::ErrorKind::InvalidData);
    println(f"{e} {e:?}");
}

fn paths(gpa: Gpa) {
    let q = Path::new("/usr/lib/libfoo.so.1");
    println(
        f"{q.file_name():?} {q.extension():?} {q.file_stem():?} {q.parent():?} {q.is_absolute()}");
    let r: Path = "a/b/";
    let s1 = r.starts_with("a");
    let s2 = r.starts_with("a/b");
    let s3 = r.starts_with("a/");
    let s4 = Path::new("ab").starts_with("a");
    println(f"{r.file_name():?} {r.parent():?} {r.is_relative()} {s1} {s2} {s3} {s4}");
    for c in Path::new("/a//b/./c/").components() {
        print(f"[{c}]");
    }
    println("");
    var p = PathBuf::from_in("/x", gpa);
    p.push("y.tar");
    p.set_extension("gz");
    let popped = p.pop();
    println(f"{p} {popped}");
}

fn processes(gpa: Gpa) -> io::Result<()> {
    var c = Command::new("sh");
    c.arg("-c");
    c.arg("echo out; echo err >&2; exit 3");
    let o = c.output_in(gpa)?;
    let out = String::from_utf8(o.stdout).unwrap();
    let err = String::from_utf8(o.stderr).unwrap();
    println(f"{o.status} {o.status.success()} {o.status.code():?} {out:?} {err:?}");
    var t = Command::new("true");
    t.stdout(Stdio::null());
    println(f"{t.status()?.success()}");
    var missing = Command::new("/nonexistent/program");
    match missing.output_in(gpa) {
        Ok(o) => println(f"exit {o.status.code():?}"),
        Err(e) => println(f"spawn: {e.kind():?}"),
    }
    Ok(())
}

fn main(gpa: Gpa) {
    let args: Vec<str> = env::args().collect_in(gpa);
    println(f"{args.len()} {args[1]} {args[2]} {env::args().skip(1).count()}");
    let home = env::get_in("HOME", gpa);
    let none = env::get_in("TACHYON_NO_SUCH_VAR", gpa);
    println(f"{home.is_ok()} {none:?}");
    let cwd = env::current_dir_in(gpa).unwrap();
    println(f"{cwd.as_path().is_absolute()}");
    let name = to_string_in(f"/tmp/tachyon-std-io-{std::process::id()}", gpa);
    let dir = PathBuf::from_in(name.as_bytes(), gpa);
    match files(dir, gpa) {
        Ok(_) => {}
        Err(e) => println(f"files: {e}"),
    }
    errors();
    paths(gpa);
    match processes(gpa) {
        Ok(_) => {}
        Err(e) => println(f"processes: {e}"),
    }
}
