// (0.25) what scoped threads may do: read what they borrow (elements,
// slices, lengths, a shared view made before the scope); the scope's own
// body may change what no thread borrows (a counter), not what one does
use std::thread;
fn sum(s: [i64]) -> i64 { var t = 0; for x in s { t += x; } t }

// EXPECT: 10 10 4 3
// EXPECT: 3 1
fn main(gpa: Gpa) {
    let a = [1, 2, 3, 4];
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 1..5 { v.push(i); }
    var n = 0;
    var log: Vec<i64> = Vec::new_in(gpa);
    let r = thread::scope(|sc| {
        let x = sc.spawn(|| sum(a[..]));
        n += 1;
        let y = sc.spawn(|| sum(v.as_slice()));
        n += 1;
        log.push(n);
        let z = sc.spawn(|| a.len() + v[3] - a[3]);
        n += 1;
        let w = sc.spawn(|| v.as_slice()[1..].len());
        f"{x.join()} {y.join()} {z.join()} {w.join()}"
    });
    println(r);
    println(f"{n} {log.len()}");
}
