// 0.18: `type X = distinct T` (Go's defined types): literals convert,
// `as` converts both ways for free, T's operators between two X (or an X
// and a literal), comparisons give bool, `impl X` adds methods, and X has
// T's Eq, Ord, Hash, Debug, Display and Clone (in generic code too).
// EXPECT: 21 true true false
// EXPECT: 22 23
// EXPECT: 15 -10 2.5
// EXPECT: 12 3 6 1 -8
// EXPECT: 40 37
// EXPECT: small
// EXPECT: 3 and 10 3
// EXPECT: [0, 3, 7] true 4
// EXPECT: 5 5 true
// EXPECT: -1 0 1
// EXPECT: hash true
// EXPECT: P { x: 1, y: 2 } true 3
// EXPECT: 7 cell 9
// EXPECT: 8 8 16
type NodeId = distinct i64;
type Meters = distinct f64;
type Mask = distinct u8;
type Id<T> = distinct i64;
type Inner = distinct i64;
type Outer = distinct Inner;

struct Node {}
struct Edge {}

#[derive(Eq, Debug, Clone)]
struct P { x: i64, y: i64 }
type Q = distinct P;

impl NodeId {
    fn next(self) -> NodeId { self + 1 }
    fn is_root(self) -> bool { self == 0 }
}

fn half(m: Meters) -> Meters { m / 2.0 }

fn largest<T: Ord + Copyish>(v: [T]) -> T {
    var best = v[0];
    for x in v {
        if x > best {
            best = x;
        }
    }
    best
}

trait Copyish {}
impl Copyish for NodeId {}

struct Cell { id: NodeId, next: Option<NodeId> }

fn main(gpa: Gpa) {
    let a: NodeId = 3;
    let b = a + 4;
    let c = b * a;
    println(f"{c} {a < b} {a == 3} {a.is_root()}");
    println(f"{c.next()} {c.next().next()}");
    let m: Meters = 10.0;
    let n = -m;
    println(f"{half(m) + m} {n} {half(half(m))}");
    let k: Mask = 12;
    let shifted = k >> 2;
    let both = k & 6;
    println(f"{k} {shifted} {k ^ 10} {k / 8} {-(a + 5) as i64}");
    var acc: NodeId = 10;
    acc += 30;
    var d = acc;
    d -= 3;
    println(f"{acc} {d}");
    match a {
        0..=5 => println("small"),
        _ => println("large"),
    }
    println(f"{a} and {m} {a:?}");
    var v: Vec<NodeId> = Vec::new_in(gpa);
    v.push(a);
    v.push(b);
    v.push(0);
    std::sort(v.as_mut_slice());
    println(f"{v:?} {v.get(2) == b} {both as i64}");
    let id: Id<Node> = 5;
    let e: Id<Edge> = id as i64 as Id<Edge>;
    let same = id as Id<Edge> == e;
    println(f"{id} {e} {same}");
    println(f"{a.cmp(&b)} {a.cmp(&a)} {b.cmp(&a)}");
    let three: i64 = 3;
    println(f"hash {a.hash() == three.hash()}");
    let q = P { x: 1, y: 2 } as Q;
    let r = q.clone();
    let back = r as P;
    println(f"{q:?} {q == r} {back.x + back.y}");
    let cell = Cell { id: 7, next: Some(9) };
    match cell.next {
        Some(nx) => println(f"{cell.id} cell {nx}"),
        None => println("none"),
    }
    let deep: Outer = 8;
    let inner = deep as Inner;
    println(f"{deep} {inner} {size_of(Option<NodeId>)}");
    var seen: std::HashMap<NodeId, i64> = std::HashMap::new_in(gpa);
    seen.insert(a, 1);
    if !seen.contains(a) || seen.get(a).is_none() {
        println("lost");
    }
    let top = largest(v.as_slice());
    if top != b {
        println("wrong");
    }
    seen.free();
    v.free();
}
