// a generic 'with' over a local: the closure returns a view of its inout argument through R
// ERROR: [own.
fn with<T, R, F: FnMut(inout T) -> R>(x: inout T, f: sink F) -> R { f(&x) }

fn main(gpa: Gpa) {
    var w: Vec<i64> = Vec::new_in(gpa);
    let s = {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        with(&v, |d: inout Vec<i64>| d.as_slice())
    };
    for i in 0..100 { w.push(i); }
    println(f"{s[5]}");
}
