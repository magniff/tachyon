// 0.17 (value semantics, from tests/values-proto of the prototype): a
// parser that returns views of its tokens' text from a `&mut self` method,
// then changes itself (the evals' pattern, §2.9 situation 6) checks clean
// under --values=error: `name` is views(*self).
// FLAGS: --values=error
// EXPECT: ab 2
struct Tok { text: [u8], k: i64 }
struct Parser { toks: Vec<Tok>, pos: i64 }

impl Parser {
    fn name(self: &mut Parser) -> Result<[u8], [u8]> {
        let t = self.toks.get(self.pos);
        self.pos += 1;
        Ok(t.text)
    }

    fn accept(self: &mut Parser, k: i64) -> bool {
        if self.toks.get(self.pos).k == k { self.pos += 1; true } else { false }
    }

    fn item(self: &mut Parser) -> Result<[u8], [u8]> {
        let col = match self.name() {
            Ok(n) => n,
            Err(e) => return Err(e),
        };
        if !self.accept(3) {
            return Err("x");
        }
        Ok(col)
    }
}

fn main(gpa: Gpa) {
    let mut p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: "ab", k: 1 });
    p.toks.push(Tok { text: ",", k: 3 });
    match p.item() {
        Ok(c) => println(f"{c} {p.pos}"),
        Err(e) => println(e),
    }
}
