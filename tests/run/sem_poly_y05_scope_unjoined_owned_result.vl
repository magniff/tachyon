// a scoped thread's owned result never joined: dropped once when the scope ends
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: end
use std::thread;
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

fn main() {
    thread::scope(|s| {
        s.spawn(|| R { id: 1 });
        0
    });
    println("end");
}
