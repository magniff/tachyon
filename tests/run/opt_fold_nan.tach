// A NaN made by float arithmetic is not folded: its bits are the target
// machine's (AArch64's default NaN is positive, x86-64's negative), and
// the compiler's host may be another machine. The NaN of 0.0 / 0.0 at -O2
// has the bits the target computes at run time.
// EXPECT: 1 1 1
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn bits(x: f64) -> u64 {
    let mut y = x;
    unsafe { *(&y as *f64 as *u64) }
}

fn div(a: f64, b: f64) -> f64 {
    a / b
}

fn sub(a: f64, b: f64) -> f64 {
    a - b
}

fn main() -> i32 {
    // Through function values: computed at run time.
    let d = div;
    let s = sub;
    let inf = 1.0 / 0.0;
    let folded = 0.0 / 0.0;
    let folded2 = inf - inf;
    let folded3 = (0.0 / 0.0) * 2.0;
    unsafe {
        printf(c"%d %d %d\n", (bits(folded) == bits(d(0.0, 0.0))) as i32,
            (bits(folded2) == bits(s(inf, inf))) as i32,
            (bits(folded3) == bits(d(0.0, 0.0) * 2.0)) as i32);
    }
    0
}
