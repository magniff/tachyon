// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) (see the program)
// EXPECT: 1
// EXPECT: drop 1
// EXPECT: a
// EXPECT: 2
// EXPECT: drop 2
// EXPECT: b
// EXPECT: abcd
// EXPECT: c
// EXPECT: abcd
// EXPECT: d
// EXPECT: drop 4
// EXPECT: drop 3
struct H { n: i64, t: [u8; 4] }
impl Drop for H { fn drop(inout self) { println(f"drop {self.n}"); } }

impl H {
    fn new(n: i64) -> H { H { n: n, t: ['a', 'b', 'c', 'd'] } }
    fn len(self) -> i64 { self.n }
    fn view(self) -> [u8] { self.t[..] }
}

fn mk(n: i64) -> H { H::new(n) }

fn main() -> i32 {
    println(H::new(1).len());
    println("a");
    println(mk(2).len());
    println("b");
    let v = H::new(3).view();
    println(v);
    println("c");
    let w = mk(4).view();
    println(w);
    println("d");
    0
}
