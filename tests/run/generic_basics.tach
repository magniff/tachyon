// EXPECT: 7
// EXPECT: 2.5
// EXPECT: 9
// EXPECT: 3 4
// EXPECT: 1 2
// EXPECT: some 42
// EXPECT: none
// EXPECT: 11 22
// EXPECT: 30
// EXPECT: 16 8
// EXPECT: 4 4
// EXPECT: 6
// Generic functions, structs, enums and impl blocks (0.5).
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn max<T>(a: T, b: T) -> T {
    if a > b { a } else { b }
}

fn first<A, B>(pair: (A, B)) -> A {
    pair.0
}

struct Pair<T> { a: T, b: T }

impl<T> Pair<T> {
    fn new(a: T, b: T) -> Pair<T> {
        Pair { a: a, b: b }
    }

    fn swap(self: Pair<T>) -> Pair<T> {
        Pair::new(self.b, self.a)
    }

    fn set_a(self: &mut Pair<T>, a: T) {
        self.a = a;
    }
}

enum Option<T> { None, Some(T) }

impl<T> Option<T> {
    fn is_some(self: &Option<T>) -> bool {
        match *self {
            Option::Some(_) => true,
            Option::None => false,
        }
    }

    fn unwrap_or(self: Option<T>, other: T) -> T {
        match self {
            Option::Some(x) => x,
            Option::None => other,
        }
    }
}

fn find(xs: [i64], wanted: i64) -> Option<i64> {
    for i in 0..xs.len {
        if xs[i] == wanted {
            return Option::Some(xs[i]);
        }
    }
    Option::None
}

fn sum<T>(xs: [T], zero: T) -> T {
    let mut total = zero;
    for x in xs {
        total = total + x;
    }
    total
}

fn size_and_align<T>() -> (i64, i64) {
    (size_of(T), align_of(T))
}

fn apply<T>(f: fn(T) -> T, x: T) -> T {
    f(x)
}

fn double(x: i64) -> i64 {
    x * 2
}

fn main() -> i32 {
    unsafe {
        printf(c"%ld\n", max(3, 7));
        printf(c"%.1f\n", max(2.5, -1.0));
        printf(c"%d\n", max::<u8>(9, 4) as i32);
    }
    let p = Pair::new(4, 3).swap();
    unsafe { printf(c"%ld %ld\n", p.a, p.b); }
    let mut q = Pair { a: 0u16, b: 2 };
    q.set_a(1);
    unsafe { printf(c"%d %d\n", q.a as i32, q.b as i32); }
    let xs = [5, 42, 7];
    let found = find(xs[..], 42);
    if found.is_some() {
        unsafe { printf(c"some %ld\n", found.unwrap_or(0)); }
    }
    let missing: Option<i64> = find(xs[..], 1);
    match missing {
        Option::Some(_) => unsafe { printf(c"some\n") },
        Option::None => unsafe { printf(c"none\n") },
    };
    let t = (11, true);
    let n: Option<i32> = Option::None;
    unsafe { printf(c"%ld %d\n", first(t), n.unwrap_or(22)); }
    let ys = [10, 20];
    unsafe { printf(c"%ld\n", sum(ys[..], 0)); }
    let (s, a) = size_and_align::<Pair<i64>>();
    unsafe { printf(c"%ld %ld\n", s, a); }
    let (s32, a32) = size_and_align::<f32>();
    unsafe {
        printf(c"%ld %ld\n", s32, a32);
        printf(c"%ld\n", apply(double, 3));
    }
    0
}
