// sem-own: a tuple of owned values destructured by let: each part dropped
// once by its new name, in reverse declaration order.
// EXPECT: 1 2
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    {
        let t = (mk(1, gpa), mk(2, gpa));
        let (a, b) = t;
        println(f"{a.id} {b.id}");
    }
    println("end");
}
