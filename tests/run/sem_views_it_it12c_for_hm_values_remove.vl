// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: remove while iterating values
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    for i in 0..8 { m.insert(i, i); }
    for x in m.values() { m.remove(x); }
    println(m.len());
    0
}
