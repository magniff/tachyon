// (0.24) Moving a field out of a temporary whose type implements Drop is
// own.partial, as out of a local: its drop needs all of it.
// ERROR: [own.partial]: cannot move 'make(gpa).v' out of 'make(gpa)': 'N' implements Drop
struct N { v: Vec<i64> }

impl Drop for N {
    fn drop(inout self) { println("drop"); }
}

fn make(gpa: Gpa) -> N {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    N { v: v }
}

fn main(gpa: Gpa) {
    let x = make(gpa).v;
    println(f"{x[0]}");
}
