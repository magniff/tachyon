// (0.21) A value shared with scoped threads may not hold a raw pointer:
// it could change through a shared reference without a lock.
// ERROR: a thread of 'thread::scope' shares 'c' (Cache holds a raw pointer at '.slots' (*i64)) with another thread

use std::thread;

struct Cache { slots: *i64, n: i64 }

fn main() {
    var x = 3;
    var c = Cache { slots: &x as *i64, n: 1 };
    c.n += 1;
    let n = thread::scope(|s| {
        let h = s.spawn(|| c.n);
        h.join()
    });
    println(f"{n}");
}
