// Calling libm functions that take and return doubles and floats.
// EXPECT: 1.4142135623730951 -3 2.7610862764774282
// EXPECT: 1.4142135381698608 3.25
extern fn printf(format: *u8, ...) -> i32;
extern fn sqrt(x: f64) -> f64;
extern fn floor(x: f64) -> f64;
extern fn atan2(y: f64, x: f64) -> f64;
extern fn sqrtf(x: f32) -> f32;
extern fn fma(x: f64, y: f64, z: f64) -> f64;

fn main() -> i64 {
    let two: f64 = 2.0;
    let x: f64 = -2.5;
    printf("%.17g %.17g %.17g\n".0, sqrt(two), floor(x), atan2(1.0, x));
    let t: f32 = 2.0;
    printf("%.17g %.17g\n".0, sqrtf(t), fma(1.5, 2.0, 0.25));
    0
}
