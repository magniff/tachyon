// (0.17, T7) Bitwise copies of an owned value out of a reference, an index
// or a collection's accessor, moved anywhere (a let, a return, a field, a
// push, an assignment, Some(..), a tuple): own.move_out, each. Any one
// that slipped through would free its buffer twice (--check-alloc: main
// calls them all). own_copy_out shows the fixes the try: lines give.
struct S { f: Buf }
fn a1(r: &Buf) -> Buf { let x = *r; x }
fn a2(r: &Buf) -> Buf { *r }
fn a3(r: &S) -> Buf { r.f }
fn a4(r: &S, out: &mut Vec<Buf>) { out.push(r.f); }
fn a5(v: &Vec<Buf>) -> Buf { v[0] }
fn a6(v: &Vec<Buf>) -> Buf { v.get(0) }
fn a7(v: &Vec<Buf>) -> S { S { f: v.get(0) } }
fn a8(v: &Vec<Buf>, s: &mut S) { s.f = v.get(0); }
fn a9(v: &Vec<Buf>, g: Gpa) -> Buf { let mut x = Buf::new_in(g); x = v.get(0); x }
fn a10(r: &mut S) -> Buf { r.f }
fn a11(v: &Vec<Buf>) -> Option<Buf> { Some(v.get(0)) }
fn a12(r: &Buf) -> (Buf, i64) { (*r, 1) }
fn a13(v: &Vec<Buf>) -> Buf { let x = v.get(0); x }
fn a14(v: &Vec<Buf>, g: Gpa) -> Buf { match v.last() { Some(b) => b, None => Buf::new_in(g) } }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<Buf> = Vec::new_in(gpa);
    v.push(Buf::from_in("x", gpa));
    let mut s = S { f: Buf::from_in("y", gpa) };
    let mut out: Vec<Buf> = Vec::new_in(gpa);
    let n = a1(&s.f).len() + a2(&s.f).len() + a3(&s).len() + a5(&v).len() + a6(&v).len()
        + a7(&v).f.len() + a9(&v, gpa).len() + a10(&mut s).len() + a13(&v).len()
        + a14(&v, gpa).len() + a12(&s.f).1;
    a4(&s, &mut out);
    a8(&v, &mut s);
    let o = a11(&v);
    std::print_int(n + out.len() + o.is_some() as i64);
    0
}
// FLAGS: --check-alloc
// ERROR: cannot move '*r' (Buf) out of a reference
// ERROR: cannot move '*r' (Buf) out of a reference
// ERROR: cannot move 'r.f' (Buf) out of a reference
// ERROR: cannot move 'r.f' (Buf) out of a reference
// ERROR: cannot move 'v[0]' (Buf) out of an index
// ERROR: cannot move 'v.get(0)' (Buf): it is a copy of an element the collection keeps
// ERROR: cannot move 'v.get(0)' (Buf): it is a copy of an element the collection keeps
// ERROR: cannot move 'v.get(0)' (Buf): it is a copy of an element the collection keeps
// ERROR: cannot move 'v.get(0)' (Buf): it is a copy of an element the collection keeps
// ERROR: cannot move 'r.f' (Buf) out of a reference
// ERROR: cannot move 'v.get(0)' (Buf): it is a copy of an element the collection keeps
// ERROR: cannot move '*r' (Buf) out of a reference
// ERROR: cannot move 'x' (Buf) out of 'x'
// ERROR: cannot move 'b' (Buf) out of 'b'
// ERROR-COUNT: 14
