// a while loop stepping by 3 to the length: 0, 3, 6 only.
// EXPECT: 9
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64]) -> i64 { var t = 0; var i = 0; while i <= s.len() { t += s[i]; i += 3; } t }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s));
    0
}
