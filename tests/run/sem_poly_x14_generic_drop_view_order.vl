// a generic type with Drop holding a view (T = [i64]), reassigned to view a Vec declared after it:
// at the end v is dropped first, then g's drop reads its view
// ERROR: [own.drop_view]
// XFAIL: WRONG a generic Drop type instantiated with a view (Drop on a view-holding type) is accepted
struct G<T> { x: T }
impl<T> Drop for G<T> { fn drop(inout self) { println("drop G"); } }
struct Gs { x: [i64] }

fn main(gpa: Gpa) {
    let arr = [0, 0];
    var g = G { x: arr[..] };
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(9);
    g = G { x: v.as_slice() };
    println("end");
}
