// a scoped thread calling an inout method on a captured var
// ERROR: sync
use std::thread;
struct C { n: i64 }
impl C { fn inc(inout self) { self.n += 1; } }
fn main() { var c = C { n: 0 }; thread::scope(|s| { let a = s.spawn(|| { c.inc(); 0 }); let b = s.spawn(|| { c.inc(); 0 }); a.join() + b.join() }); println(f"{c.n}"); }
