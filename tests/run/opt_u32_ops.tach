// (0.16) u32 arithmetic on AArch64 runs on the 32-bit registers, whose
// results are zero-extended: no `mov wN, wN` after each operation to keep
// the value canonical. And, or, xor and right shifts of canonical values
// need none on either target; a u32 shift takes its amount modulo 32
// itself. Checked against -O0.
// EXPECT: 2432615034
// ASM(aarch64-macos): _tachyon.mix:
// ASM(aarch64-macos): madd w
// ASM-NOT(aarch64-macos): mov w9, w9
// ASM-NOT(aarch64-macos): mov w10, w10
// ASM(aarch64-macos): lsl w
// ASM-NOT(aarch64-macos): mov w9, w9
// ASM-NOT(aarch64-macos): mov w10, w10
// ASM(aarch64-macos): udiv w
// ASM(aarch64-macos): ret
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

fn mix(a: u32, b: u32, k: u32) -> u32 {
    let mut x = a * 2654435761 + b;
    x = x ^ (x >> 13) ^ (x << k);
    x = x - (b << 3) + (a >> 2);
    x = x * 9 + (x * 3) - ~a;
    x = (0 - x) ^ (x % (b | 1)) ^ (x / (a | 1));
    x + (a << 5) - (b >> 7) + 4000000000
}

fn main() -> i32 {
    let f = mix;
    let mut h: u32 = 1;
    for i in 0..100000 {
        h = f(h, i as u32, (i & 63) as u32);
    }
    unsafe { printf(c"%u\n", h); }
    0
}
