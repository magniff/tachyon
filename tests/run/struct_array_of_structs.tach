// Arrays of structs: indexed field reads and writes.
// EXPECT: 110 220 -1 440 40
extern fn printf(format: *u8, ...) -> i32;

struct P { x: i64, y: i32 }

fn main() -> i64 {
    let ps: [P; 4] = [P { x: 1, y: 10 }, P { x: 2, y: 20 }, P { x: 3, y: 30 }, P { x: 4, y: 40 }];
    let i = 0;
    loop {
        if i == 4 { break; };
        ps[i].x = ps[i].x * 100 + ps[i].y as i64;
        i += 1;
    }
    ps[2] = P { x: 0 - 1, y: 0 - 1 };
    printf("%ld %ld %ld %ld %d\n".0, ps[0].x, ps[1].x, ps[2].x, ps[3].x, ps[3].y);
    0
}
