// 0.20 T1: the own pass in the conventions' words (a file read in 0.20's
// spelling): a write through a let parameter, a move out of one, a use
// after a sink.
// FLAGS: --syntax=0.20
// ERROR: help: take it inout ('x: inout T', called with '&x') to change it
// ERROR: or take the parameter 'sink' to own it
// ERROR: let the callee borrow it: a let parameter ('x: T'), not 'sink'
fn keep(v: sink Vec<i64>) -> i64 { v.len() }

fn bad(v: Vec<i64>) { v.push(2); }

fn pass(v: Vec<i64>) -> i64 { keep(v) }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    let k = keep(v);
    println(f"{k} {v.len()}");
}
