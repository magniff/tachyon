// sem-own: `?` converting an owned error through From: the error dropped once.
// EXPECT: drop 7
// EXPECT: err 7
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct E2 { id: i64 }
impl From<D> for E2 { fn from(x: D) -> E2 { E2 { id: x.id } } }
fn g(gpa: Gpa) -> Result<i64, D> { Err(mk(7, gpa)) }
fn f(gpa: Gpa) -> Result<i64, E2> { let n = g(gpa)?; Ok(n) }

fn main(gpa: Gpa) {
    match f(gpa) { Ok(n) => println(f"ok {n}"), Err(e) => println(f"err {e.id}") }
}
