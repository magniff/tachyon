// 0.17 (T4, std on values): v[i] and v[a..b] as places (written through
// as_mut_slice), as_mut_slice, sort(&mut [T]) and v.sort(), sort_by with
// `&T` closures and named functions (`*T` parameters still fit), the
// stable sort of owned-looking elements, swap on Vec, slices and places,
// take on containers (the allocator kept), std::take with Default,
// Vec::filled_in cloning, Buf::from_in, iter_ref, Scanner tokens kept
// while it reads on, a consuming free.
// EXPECT: 1 2 9 | 9 2 1 | 7 8
// EXPECT: 0 5 | 5 0
// EXPECT: a1 b1 c2 d2 | 3 1
// EXPECT: 3 0 | 4 0 | 0 3 | 3 3
// EXPECT: hi! | 6
// EXPECT: one two three
struct Item { name: [u8], k: i64 }

fn by_k(a: *Item, b: *Item) -> i64 { unsafe { a.k - b.k } }
fn by_k_ref(a: Item, b: Item) -> i64 { a.k - b.k }

fn bump(s: inout [i64]) {
    s[0] += 1;
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(9);
    v.push(1);
    v.push(2);
    sort(v.as_mut_slice());
    print(f"{v[0]} {v[1]} {v[2]} | ");
    v.sort_by(|a, b| *b - *a);
    print(f"{v[0]} {v[1]} {v[2]} | ");
    var a = [8, 7];
    a[..].sort();
    v[0] = a[0];
    v[1..3][0] = a[1];
    println(f"{v[0]} {v[1]}");
    var x = 5;
    var y = 0;
    std::swap(&x, &y);
    print(f"{x} {y} | ");
    v.swap(0, 1);
    a[..].swap(0, 1);
    // (`std::swap(&mut a[0], &mut a[1])` is own.conflict: two loans of a)
    a.swap(0, 1);
    std::swap(&x, &y);
    println(f"{x} {y}");
    var items: Vec<Item> = Vec::new_in(gpa);
    items.push(Item { name: "c", k: 2 });
    items.push(Item { name: "a", k: 1 });
    items.push(Item { name: "d", k: 2 });
    items.push(Item { name: "b", k: 1 });
    sort_stable_by_in(items.as_mut_slice(), |p, q| p.k - q.k, gpa);
    unsafe { items.sort_by(by_k); }
    sort_stable_by_in(&items[..], by_k_ref, gpa);
    for it in items.iter_ref() {
        print(f"{it.name}{it.k} ");
    }
    var t = 0;
    var c = 0;
    for it in items.as_slice().iter_ref() {
        t += it.k;
        c += 1;
    }
    println(f"| {c - 1} {t - 5}");
    var w = v.take();
    print(f"{w.len()} {v.len()} | ");
    w.push(4);
    v.push(3);
    bump(&w[..]);
    let n: i64 = std::take(&w[3]);
    print(f"{n + 0} {w[3]} | ");
    var o: Option<i64> = Some(3);
    let got = std::take(&o);
    print(f"{if o.is_none() { 0 } else { 1 }} {got.unwrap()} | ");
    let rows: Vec<Vec<i64>> = Vec::filled_in(2, v.clone(), gpa);
    println(f"{rows[1].len() + 2} {rows[1][0]}");
    var b = Buf::from_in("hi", gpa);
    b.push('!');
    print(f"{b.as_slice()} | ");
    b.as_mut_slice()[0] = 'H';
    let bt = b.take();
    println(f"{bt.len() + b.len() * 10 + 3}");
    let text = "one two three";
    var sc = Scanner::new(text);
    let first = sc.next_token().unwrap();
    let second = sc.next_token().unwrap();
    let third = sc.next_token().unwrap();
    println(f"{first} {second} {third}");
    bt.free();
    w.free();
}
