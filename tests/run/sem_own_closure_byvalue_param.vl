// sem-own: a closure's parameter annotated `sink` is refused with
// conv.sink_type, whose message says a field or result: it is a parameter.
// A closure can take ownership only through an Fn(sink T) bound.
// XFAIL: DIAG/OVERSTRICT `|d: sink D|` is conv.sink_type ("a field or a result"), though it is a parameter
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let f = |d: sink D| println(f"got {d.id}");
    let x = mk(1, gpa);
    f(x);
    println("end");
}
