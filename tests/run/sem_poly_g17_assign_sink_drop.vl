// assigning through an inout T: the old value dropped once, the new one once at the end
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: now 2
// EXPECT: 5
// EXPECT: drop 2
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn put<T>(dst: inout T, src: sink T) { dst = src; }

fn main() {
    var a = R { id: 1 };
    put(&a, R { id: 2 });
    println(f"now {a.id}");
    var n = 1;
    put(&n, 5);
    println(f"{n}");
}
