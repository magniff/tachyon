// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a let-access field of a struct, owner changed
// ERROR: error[own.conflict]
struct C { cfg: let Vec<i64> }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let c = C { cfg: v };
    v.push(2);
    println(c.cfg.len());
    0
}
