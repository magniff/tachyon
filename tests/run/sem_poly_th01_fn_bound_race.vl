// an Fn closure that changes a captured var, called from two scoped threads: a data race
// (0.25: rejected at the bound: a closure that changes a capture is not Fn)
// ERROR: so it is not 'Fn' as the bound of 'F' of 'par' asks
use std::thread;
fn bump(n: inout i64) { n += 1; }

fn par<F: Fn()>(f: F) {
    thread::scope(|s| {
        s.spawn(|| { for _ in 0..100000 { f(); } 0 });
        s.spawn(|| { for _ in 0..100000 { f(); } 0 });
        0
    });
}

fn main() {
    var n = 0;
    par(|| bump(&n));
    println(f"{n}");
}
