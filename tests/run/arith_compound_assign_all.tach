// Every compound assignment operator, on variables, fields, array elements
// and through pointers; an assignment is an expression of type ().
// EXPECT: 4 29 -30 3.0 -10 42 49
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct S { a: i32, f: f64 }

fn main() -> i64 {
    let mut x: i64 = 100;
    x += 5;
    x -= 3;
    x *= 4;
    x /= 3;
    x %= 7;
    let mut y: u8 = 0b1100_1010;
    y &= 0xF0;
    y |= 0x05;
    y ^= 0xFF;
    y <<= 1;
    y >>= 2;
    let mut s = S { a: 10, f: 7.5 };
    s.a *= -3;
    s.f %= 2.0;
    s.f /= 0.5;
    let mut arr = [1, 2, 3];
    arr[1] += 40;
    arr[2] <<= 4;
    let p = &arr[0];
    *p -= 11;
    p[2] |= 1;
    let _unit: () = (x = x + 1);
    printf(c"%ld %d %d %.1f %ld %ld %ld\n", x, y as i32, s.a, s.f, arr[0], arr[1], arr[2]);
    0
}
