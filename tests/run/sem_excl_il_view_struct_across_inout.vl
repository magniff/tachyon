// a struct holding a view, alive across an inout of what it views
// ERROR: own.conflict
struct W { s: [i64] }
fn grow(v: inout Vec<i64>) { for i in 0..100 { v.push(i); } }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa); v.push(1); let w = W { s: v.as_slice() }; grow(&v);
    println(f"{w.s[0]}");
}
