// An index into a subslice is checked against the subslice, not the whole.
// EXIT: 101
// STDERR: index out of bounds: index 2, length 2
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3, 4, 5];
    let s = a[1..3];
    println(s[2 + Z]);
    println("not reached");
    0
}
