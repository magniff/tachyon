// Recursion: fib, Ackermann, mutual recursion.
// EXPECT: 75025 9 61
// EXPECT: 0 1
extern fn printf(format: *u8, ...) -> i32;

fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn ack(m: i64, n: i64) -> i64 {
    if m == 0 { return n + 1; };
    if n == 0 { return ack(m - 1, 1); };
    ack(m - 1, ack(m, n - 1))
}

fn is_even(n: u32) -> bool {
    if n == 0 { true } else { is_odd(n - 1) }
}

fn is_odd(n: u32) -> bool {
    if n == 0 { false } else { is_even(n - 1) }
}

fn main() -> i64 {
    printf("%ld %ld %ld\n".0, fib(25), ack(2, 3), ack(3, 3));
    printf("%d %d\n".0, is_even(10001), is_odd(10001));
    0
}
