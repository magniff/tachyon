// EXPECT: Pair { a: 1, b: "x" } Pair { a: 1, b: "y" } Pair { a: 2, b: "a" }
// EXPECT: eq true hash true
// EXPECT: Some2(5) None2
// EXPECT: lt true
// EXPECT: deep 1 2
// EXPECT: Inner { v: 3 }
// 0.15: #[derive] on generic structs and enums: each parameter gets the
// trait as a bound, after the bounds it has (`impl<K: Hash + Eq + Ord> Ord
// for Keyed<K>`); derives in an inline module, with #[repr(C)].
use std::{Fmt, HashMap, sort};

#[derive(Eq, Ord, Hash, Debug, Clone)]
struct Pair<A, B> { a: A, b: B }

#[derive(Debug, Ord, Eq, Clone)]
enum Maybe<T> { Some2(T), None2 }

#[derive(Ord, Eq)]
struct Keyed<K: Hash + Eq> { k: K, n: i64 }

#[derive(Clone)]
struct Stack<T> { items: Vec<T> }

mod inner {
    #[repr(C)]
    #[derive(Debug, Clone, Eq)]
    pub struct Inner { pub v: i64 }
}

fn show<T: std::Debug>(x: &T) {
    let mut f = Fmt::to_fd(1);
    f.debug(x);
}

fn main(gpa: Gpa) {
    let mut v: Vec<Pair<i64, [u8]>> = Vec::new_in(gpa);
    v.push(Pair { a: 2, b: "a" });
    v.push(Pair { a: 1, b: "y" });
    v.push(Pair { a: 1, b: "x" });
    sort(v.as_slice());
    for i in 0..v.len() {
        if i > 0 {
            print(" ");
        }
        show(&v.as_slice()[i]);
    }
    println("");

    let p = Pair { a: 1, b: "x" };
    let q = p.clone();
    let mut m: HashMap<Pair<i64, [u8]>, i64> = HashMap::new_in(gpa);
    m.insert(p, 7);
    print(if p == q { "eq true" } else { "eq false" });
    println(if m.get(q).unwrap_or(0) == 7 { " hash true" } else { " hash false" });

    let s: Maybe<i64> = Maybe::Some2(5);
    let n: Maybe<i64> = Maybe::None2;
    show(&s);
    print(" ");
    let n2 = n.clone();
    show(&n2);
    println("");

    let k1 = Keyed { k: 1, n: 5 };
    let k2 = Keyed { k: 2, n: 0 };
    println(if k1 < k2 && s < n { "lt true" } else { "lt false" });

    let mut items: Vec<i64> = Vec::new_in(gpa);
    items.push(1);
    let st = Stack { items: items };
    let mut st2 = st.clone();
    st2.items.push(2);
    print("deep ");
    std::print_int(st.items.len());
    print(" ");
    std::print_int(st2.items.len());
    println("");

    let i = inner::Inner { v: 3 };
    let j = i.clone();
    if i == j {
        show(&j);
    }
    println("");
}
