// Empty arrays take their type from context; struct literals are allowed in
// conditions inside parentheses, brackets and arguments.
// EXPECT: 12
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct P { x: i64 }

fn get(p: P) -> i64 { p.x }

fn main() -> i64 {
    let _empty: [i64; 0] = [];
    let _nested: [[u8; 0]; 2] = [[], []];
    var hits = 0;
    if get(P { x: 1 }) == 1 { hits += 1; }
    if (P { x: 2 }).x == 2 { hits += 1; }
    let arr = [5, 6];
    if arr[P { x: 1 }.x] == 6 { hits += 1; }
    while get(P { x: hits }) < 10 { hits += 3; }
    unsafe { printf(c"%ld\n", hits); }
    0
}
