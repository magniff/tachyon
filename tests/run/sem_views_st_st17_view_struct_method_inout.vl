// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: view into p.name, then an inout method on p
// ERROR: error[own.conflict]
struct P { name: String, n: i64 }
impl P { fn bump(inout self) { self.n += 1; } }

fn main(gpa: Gpa) -> i32 {
    var p = P { name: String::from_in("hello", gpa), n: 1 };
    let w = p.name.as_str();
    p.bump();
    println(w);
    0
}
