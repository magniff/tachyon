// 0.18.1: Rust's `m.get(&k)`, `v.contains(&x)`: std's lookups take the
// key by value. A plain key is read through the reference (as `*n`
// is, by_value_lookup.tach); an owned key's try: line (and fix
// --suggested) drops the `&`.
// ERROR: expected 'K', got '&K'
// ERROR: help: the parameter takes the value, not a reference
// ERROR: try: k
#[derive(Eq, Hash)]
struct K { a: i64, v: Vec<i64> }

fn main(gpa: Gpa) -> i32 {
    var m: HashMap<K, i64> = HashMap::new_in(gpa);
    let k = K { a: 3, v: Vec::new_in(gpa) };
    let a = m.get(&k);
    0
}
