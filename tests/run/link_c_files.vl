// 0.16: volec links C files and libraries itself (`volec main.vl
// helper.c -L DIR -l m -o prog`, no `cc` step): the C file is compiled by
// cc at the program's level, -L and -l go to the link in their order.
// LINK: the C file and -l on volec's command line
// CSOURCE: tests/c/link_helper.c
// FLAGS: -L @ROOT@/tests/c -l m
// EXPECT: 5
// EXPECT: 13
extern "C" {
    fn helper_hypot(a: f64, b: f64) -> f64;
}

fn main() {
    println(f"{unsafe { helper_hypot(3.0, 4.0) }}");
    println(f"{unsafe { helper_hypot(5.0, 12.0) }}");
}
