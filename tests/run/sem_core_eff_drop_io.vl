// Dropping a value whose Drop prints, inside a #[no_io] function.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(inout self) { println("dropped"); } }

#[no_io]
fn quiet(x: sink Noisy) -> i64 { x.n }

fn main() -> i32 {
    println(quiet(Noisy { n: 3 }));
    0
}
