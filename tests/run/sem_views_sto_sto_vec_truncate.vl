// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text stored with `v.get(0)`; s grows while it is used
// ERROR: error[own.conflict]
fn fill(s: inout [str], x: str) { for i in 0..s.len() { s[i] = x; } }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); v.truncate(1);
    let r = v.get(0);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
