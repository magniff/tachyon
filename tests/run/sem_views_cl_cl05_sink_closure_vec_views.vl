// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a sink closure owns a Vec<str> viewing s; s grows; the closure runs
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    let c = sink || v.get(0).len();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(c());
    0
}
