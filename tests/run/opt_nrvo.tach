// EXPECT: 93 32 5 6 7 4 62 0 32
// (0.17) The returned local is the result (NRVO, middle/copies.tach): a
// local that every return copies to the result pointer is built there, and
// the copy goes; `make` keeps only the copy of its array literal. Not when
// two locals are returned (`pick`), and a defer that changes the local
// after the return value is taken does not reach the result (`deferred`).
// CHECK: fn make:
// CHECK: callc memcpy
// CHECK-NOT: callc memcpy
// CHECK: ret
// CHECK: fn pick:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct Big { v: [i64; 32], n: i64 }

#[inline(never)]
fn make(k: i64) -> Big {
    let mut b = Big { v: [0; 32], n: 0 };
    for i in 0..32 {
        b.v[i] = i * k;
    }
    b.n = 32;
    b
}

#[inline(never)]
fn pick(k: i64) -> Big {
    let mut a = Big { v: [1; 32], n: 1 };
    let mut b = Big { v: [2; 32], n: 2 };
    a.v[k] = 5;
    b.v[k] = 6;
    if k > 3 { a } else { b }
}

#[inline(never)]
fn deferred(k: i64) -> Big {
    let mut b = Big { v: [k; 32], n: 7 };
    defer b.n = 99;
    b.v[3] = 4;
    b
}

#[inline(never)]
fn twice(x: Big) -> Big {
    let mut b = Big { v: [0; 32], n: 0 };
    for i in 0..32 {
        b.v[i] = x.v[31 - i] * 2;
    }
    b.n = x.n;
    b
}

fn main() -> i32 {
    let m = make(3);
    let p = pick(5);
    let q = pick(1);
    let d = deferred(8);
    let mut t = make(1);
    t = twice(t);
    unsafe {
        printf(c"%ld %ld %ld %ld %ld %ld %ld %ld %ld\n", m.v[31], m.n, p.v[5], q.v[1], d.n, d.v[3],
            t.v[0], t.v[31], t.n);
    }
    0
}
