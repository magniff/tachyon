// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: HashSet insert while iterating
// ERROR: error[own.conflict]
use std::collections::hash_set::HashSet;
fn main(gpa: Gpa) -> i32 {
    var m: HashSet<i64> = HashSet::new_in(gpa);
    for i in 0..8 { m.insert(i); }
    for k in m.iter() { m.insert(k + 100); }
    println(m.len());
    0
}
