// an iterator holding owned items (a Vec<R> field): left undrained, the rest dropped once
// FLAGS: --check-alloc
// EXPECT: got 3
// EXPECT: drop 3
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
struct Q { items: Vec<R> }

impl Iterator for Q {
    type Item = R;
    fn next(inout self) -> Option<R> { self.items.pop() }
}

fn main(gpa: Gpa) {
    var q = Q { items: Vec::new_in(gpa) };
    q.items.push(R { id: 1 }); q.items.push(R { id: 2 }); q.items.push(R { id: 3 });
    let a = q.next();
    println(f"got {a.unwrap().id}");
    println("end");
}
