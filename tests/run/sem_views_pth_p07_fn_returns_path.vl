// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a function returning file_name of its let param
// ERROR: error[own.conflict]
use std::path::{Path, PathBuf};
fn base(p: Path) -> Path { p.file_name().unwrap() }

fn main(gpa: Gpa) -> i32 {
    var p = PathBuf::from_in("/usr/local", gpa);
    let b = base(p.as_path());
    p.push("binXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(b);
    0
}
