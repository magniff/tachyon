// std::cli (0.24): the generated help, exactly: the name and version, the
// about wrapped to the width, the usage line, the arguments, options and
// commands tables (a long entry puts its help on the next line), and a
// subcommand's help (`prog remote -h`), and --version.
// EXPECT: vc 2.1.0
// EXPECT: A version control system for the tests of std::cli, whose
// EXPECT: about text is long enough to wrap at sixty columns.
// EXPECT:
// EXPECT: usage: vc [options] --user <USER> [pathspec]... [command]
// EXPECT:
// EXPECT: arguments:
// EXPECT:   <pathspec>...        what to look at
// EXPECT:
// EXPECT: options:
// EXPECT:   -v, --verbose        print more; twice prints even more
// EXPECT:   -C, --dir <PATH>     run as if started in PATH [default: .]
// EXPECT:       --color <COLOR>  when to color the output: always,
// EXPECT:                        never or auto, the last when the
// EXPECT:                        output is a terminal [default: auto]
// EXPECT:   -c, --config-file-override <CONFIG_FILE_OVERRIDE>
// EXPECT:                        read this file instead
// EXPECT:   -n
// EXPECT:       --user <USER>    who you are
// EXPECT:   -h, --help           print this help
// EXPECT:   -V, --version        print the version
// EXPECT:
// EXPECT: commands:
// EXPECT:   status               show the working tree's state
// EXPECT:   remote               manage the remotes
// EXPECT: --
// EXPECT: vc remote
// EXPECT: manage the remotes
// EXPECT:
// EXPECT: usage: vc remote [options] <name> [url] [command]
// EXPECT:
// EXPECT: arguments:
// EXPECT:   <name>         the remote
// EXPECT:   <url>
// EXPECT:
// EXPECT: options:
// EXPECT:   -h, --help     print this help
// EXPECT:
// EXPECT: commands:
// EXPECT:   add            add a remote
// EXPECT: --
// EXPECT: vc remote add
// EXPECT: add a remote
// EXPECT:
// EXPECT: usage: vc remote add [options]
// EXPECT:
// EXPECT: options:
// EXPECT:   -h, --help     print this help
// EXPECT: --
// EXPECT: vc 2.1.0
// EXPECT: error: unknown option '-V'
// EXPECT: try: --help
// EXPECT: usage: vc remote add [options]
// EXPECT: tiny
// EXPECT:
// EXPECT: usage: tiny [options]
// EXPECT:
// EXPECT: options:
// EXPECT:   -h, --help     print this help
use std::cli::{Arg, Command};

fn show(cmd: Command, line: str, gpa: Gpa) {
    match cmd.parse(line.split(' ')) {
        Ok(_) => println("parsed"),
        Err(e) => print(cmd.render_in(e, gpa).as_slice()),
    }
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("vc", gpa).version("2.1.0").width(60)
        .about("A version control system for the tests of std::cli, whose about text is long enough to wrap at sixty columns.")
        .arg(Arg::flag("verbose").short('v').help("print more; twice prints even more"))
        .arg(Arg::option("dir")
            .short('C')
            .value_name("PATH")
            .help("run as if started in PATH")
            .default("."))
        .arg(Arg::option("color").help("when to color the output: always, never or auto, the last when the output is a terminal").default("auto"))
        .arg(Arg::option("config-file-override").short('c').help("read this file instead"))
        .arg(Arg::flag("dry-run").long("").short('n'))
        .arg(Arg::option("user").required().help("who you are"))
        .arg(Arg::positional("pathspec").multiple().help("what to look at"))
        .subcommand(Command::new_in("status", gpa).about("show the working tree's state"))
        .subcommand(Command::new_in("remote", gpa).about("manage the remotes")
            .arg(Arg::positional("name").required().help("the remote"))
            .arg(Arg::positional("url"))
            .subcommand(Command::new_in("add", gpa).about("add a remote")));
    print(cmd.help_in(gpa).as_slice());
    println("--");
    show(cmd, "vc remote -h", gpa);
    println("--");
    show(cmd, "vc --user me remote origin add --help", gpa);
    println("--");
    show(cmd, "vc --version", gpa);
    show(cmd, "vc --user me remote origin add -V", gpa);
    let tiny = Command::new_in("tiny", gpa);
    print(tiny.help_in(gpa).as_slice());
    0
}
