// 0.14: only a closure that captures nothing is a plain `fn`.
// ERROR: a closure that captures variables cannot be a 'fn(i64) -> i64' (it captures 'k')
// ERROR: make the parameter generic
// ERROR-COUNT: 1
fn call(f: fn(i64) -> i64) -> i64 {
    f(1)
}

fn main() -> i64 {
    let k = 3;
    call(|x| x + k)
}
