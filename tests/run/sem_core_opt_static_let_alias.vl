// A let parameter is a value independent of the static it was read from:
// the callee changing the static does not change it.
// EXPECT: 1001
// EXPECT: 99
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn f(s: Big) -> i64 {
    let before = s.a;
    G.a = 99;
    before * 1000 + s.a
}

fn main() -> i32 {
    println(f(G));
    println(G.a);
    0
}
