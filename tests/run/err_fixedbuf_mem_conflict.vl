// (0.25) FixedBuf::new(&mem[..]) lends mem inout and the allocator views
// it, and a container on it holds it through its allocator: writing mem
// while the container lives is own.conflict (a write overwrote the Vec's
// elements), and the memory may not die before them (own.escape).
use std::FixedBuf;

fn escapes() -> i64 {
    var v: Vec<i64, FixedBuf> = {
        var mem = [0u8; 256];
        Vec::new_in(FixedBuf::new(&mem[..]))
    };
    v.push(1);
    v[0]
}

fn writes() -> i64 {
    var mem = [0u8; 256];
    var v: Vec<i64, FixedBuf> = Vec::new_in(FixedBuf::new(&mem[..]));
    v.push(7);
    for i in 0..256 {
        mem[i] = 0x41;
    }
    v[0]
}

fn main() {
    println(f"{escapes()} {writes()}");
}
// ERROR: the block's value views 'mem', which dies at the block's end
// ERROR: 'mem[i] = 0x41' writes 'mem' while 'v'
