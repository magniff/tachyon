// (0.25) A FixedBuf holds its memory inout, and a container on it holds it
// through its allocator: writing or reading mem while the container lives
// is own.conflict (a write overwrote the Vec's elements), the memory may
// not die before them (own.escape), and a second container alive with the
// first conflicts too.
use std::FixedBuf;

fn escapes() -> i64 {
    var v: Vec<i64, FixedBuf> = {
        var mem = [0u8; 256];
        Vec::new_in(FixedBuf::new(&mem[..]))
    };
    v.push(1);
    v[0]
}

fn writes() -> i64 {
    var mem = [0u8; 256];
    var v: Vec<i64, FixedBuf> = Vec::new_in(FixedBuf::new(&mem[..]));
    v.push(7);
    for i in 0..256 {
        mem[i] = 0x41;
    }
    v[0]
}

fn reads() -> i64 {
    var mem = [0u8; 256];
    var v: Vec<i64, FixedBuf> = Vec::new_in(FixedBuf::new(&mem[..]));
    v.push(7);
    let b = mem[16];
    v[0] + b as i64
}

fn two() -> i64 {
    var mem = [0u8; 256];
    let fb = FixedBuf::new(&mem[..]);
    var v: Vec<i64, FixedBuf> = Vec::new_in(fb);
    v.push(7);
    var w: Vec<i64, FixedBuf> = Vec::new_in(fb);
    w.push(1);
    v[0] + w[0]
}

fn main() {
    println(f"{escapes()} {writes()} {reads()} {two()}");
}
// ERROR: the block's value views 'mem', which dies at the block's end
// ERROR: 'mem[i] = 0x41' writes 'mem' while 'v'
// ERROR: 'mem' is read while 'v'
// ERROR: 'Vec::new_in(fb)' may change 'mem' while 'v'
