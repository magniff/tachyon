// A struct result (returned through a hidden pointer: x8 on AArch64, the
// first argument register on x86-64) together with more int and float
// arguments than fit in registers, called directly and through a function
// pointer.
// EXPECT: 36 3.5 -1
// EXPECT: 36 3.5 -1
// EXPECT: 45 49.5 9
struct R { sum: i64, fsum: f64, last: i8 }

fn gather(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, x: f64, y: f64, last: i8) -> R {
    R { sum: a + b + c + d + e + f + g + h, fsum: x + y, last: last }
}

fn floats(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64, i: f64, j: f64, k: i64, n: i8) -> R {
    R { sum: k, fsum: a + b + c + d + e + f + g + h + i + j, last: n }
}

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i32 {
    let r = gather(1, 2, 3, 4, 5, 6, 7, 8, 1.25, 2.25, -1);
    unsafe { printf(c"%ld %.1f %d\n", r.sum, r.fsum, r.last as i32); }
    let p: fn(i64, i64, i64, i64, i64, i64, i64, i64, f64, f64, i8) -> R = gather;
    let q = p(1, 2, 3, 4, 5, 6, 7, 8, 1.25, 2.25, -1);
    unsafe { printf(c"%ld %.1f %d\n", q.sum, q.fsum, q.last as i32); }
    let s = floats(0.5, 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.0, 45, 9);
    unsafe { printf(c"%ld %.1f %d\n", s.sum, s.fsum, s.last as i32); }
    0
}
