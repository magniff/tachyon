// 0.17 (value semantics, T1): drops through generics, if let and while let,
// `?`, assignments to fields and through references, std::replace and
// std::take, and a value moved and assigned again in a loop.
// FLAGS: --values=error
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: pick 3
// EXPECT: pick -1
// EXPECT: drop 4
// EXPECT: field set
// EXPECT: drop 6
// EXPECT: set 8
// EXPECT: replaced 8
// EXPECT: took 9 left 0
// EXPECT: drop 7
// EXPECT: tried 7 -5
// EXPECT: consume 10
// EXPECT: drop 10
// EXPECT: wl 12
// EXPECT: drop 12
// EXPECT: main end
// EXPECT: drop 11
// EXPECT: drop 9
// EXPECT: drop 8
// EXPECT: drop 0
// EXPECT: drop 5
// EXPECT: drop 1
struct Noisy { id: i64 }

impl Drop for Noisy {
    fn drop(self: &mut Noisy) { println(f"drop {self.id}"); }
}

impl std::Default for Noisy { fn default() -> Noisy { Noisy { id: 0 } } }
struct Holder { a: Noisy, n: i64 }
fn make(id: i64) -> Noisy { Noisy { id: id } }
fn consume(n: Noisy) { println(f"consume {n.id}"); }
fn ident<T>(x: T) -> T { x }
fn ignore<T>(x: T) {}

fn pick(o: Option<Noisy>) -> i64 {
    if let Some(n) = o { n.id } else { -1 }
}

fn parse(ok: bool) -> Result<Noisy, i64> { if ok { Ok(make(7)) } else { Err(3) } }

fn tried(ok: bool) -> Result<i64, i64> {
    let n = parse(ok)?;
    Ok(n.id)
}

fn set(r: &mut Noisy, v: Noisy) { *r = v; }

fn main() {
    let a = ident(make(1));
    ignore(make(2));
    println(f"pick {pick(Some(make(3)))}");
    println(f"pick {pick(None)}");
    let mut h = Holder { a: make(4), n: 0 };
    h.a = make(5);
    println("field set");
    let mut x = make(6);
    set(&mut x, make(8));
    println(f"set {x.id}");
    let old = std::replace(&mut x, make(9));
    println(f"replaced {old.id}");
    let t = std::take(&mut x);
    println(f"took {t.id} left {x.id}");
    println(f"tried {tried(true).unwrap_or(-5)} {tried(false).unwrap_or(-5)}");
    let mut v = make(10);
    let mut i = 0;
    while i < 3 {
        if i == 1 { consume(v); v = make(11); }
        i += 1;
    }
    let mut s: Option<Noisy> = Some(make(12));
    while let Some(n) = s { println(f"wl {n.id}"); s = None; }
    println("main end");
}
