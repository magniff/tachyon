// sem-own: its field read first, then the local sunk: accepted (the plain value is copied before the move).
// EXPECT: 1
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn two(n: i64, a: sink D) { println(f"{n}"); }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    two(a.id, a);
}
