// (0.25.1) A generic `[T]` parameter, let, inout or sink, infers T from
// what lends it a slice: a slice, `&xs` of an inout slice parameter (in
// a generic function too), a subslice `&xs[a..b]`, a Vec, a Buf, a fixed
// array, a String (let and sink: its bytes); T nested inside the
// element type (`[Vec<T>]`, `[(K, V)]`) too.
// EXPECT: 3 3 3
// EXPECT: [1, 2, 3, 4]
// EXPECT: 9 1
// EXPECT: [2, 0, 1, 4]
// EXPECT: 4 4 9
// EXPECT: 2 2 2
// EXPECT: [9, 8] 3
// EXPECT: 2 2 [10, 10]
// EXPECT: 3 7 9
// EXPECT: 4 0
fn count<T>(xs: [T]) -> i64 { xs.len() }
fn taken<T>(xs: sink [T]) -> i64 { xs.len() }
fn first<T: Copy>(xs: inout [T]) -> T { xs[0] }
fn bump_all(xs: inout [i64]) { for i in 0..xs.len() { xs[i] += 1; } }

fn sort<T: Ord>(xs: inout [T]) {
    if xs.len() <= 1 { return; }
    let p = split(&xs);
    sort(&xs[0..p]);
    sort(&xs[p + 1..xs.len()]);
}

fn split<T: Ord>(xs: inout [T]) -> i64 {
    let last = xs.len() - 1;
    var store = 0;
    for i in 0..last {
        if xs[i] < xs[last] {
            xs.swap(i, store);
            store += 1;
        }
    }
    xs.swap(store, last);
    store
}

// an inout parameter lent on, its result bound by let (no expected type)
fn largest<T: Ord + Copy>(xs: inout [T]) -> T {
    sort(&xs);
    let top = first(&xs[xs.len() - 1..xs.len()]);
    top
}

fn swap_ends<T>(xs: inout [T]) { let n = xs.len(); xs.swap(0, n - 1); }

fn total_lens<T>(xss: [Vec<T>]) -> i64 {
    var n = 0;
    for v in xss { n += v.len(); }
    n
}

fn grow_first<T: Copy>(xss: inout [Vec<T>]) { let x = xss[0][0]; xss[0].push(x); }
fn second_keys<K: Copy, V>(ps: [(K, V)]) -> K { ps[1].0 }

fn main(gpa: Gpa) {
    var arr = [3, 1, 4];
    println(f"{count(arr)} {taken(arr)} {count(&arr[0..3])}");
    var v: Vec<i64> = Vec::new_in(gpa);
    for x in [3, 1, 4, 2] { v.push(x); }
    sort(&v);
    println(f"{v:?}");
    var big: Vec<i64> = Vec::new_in(gpa);
    for x in [5, 9, 1] { big.push(x); }
    println(f"{largest(&big)} {first(&big)}");
    var w: Vec<i64> = Vec::new_in(gpa);
    for x in [4, 2, 0, 1] { w.push(x); }
    sort(&w[1..4]);
    swap_ends(&w);
    println(f"{w:?}");
    var a2 = [4, 9, 4];
    sort(&arr);
    println(f"{count(v)} {count(&v[0..4])} {largest(&a2)}");
    var s = String::new_in(gpa);
    s.push_str("hi");
    var b = Buf::new_in(gpa);
    b.push(7u8);
    b.push(8u8);
    println(f"{count(s)} {taken(s)} {count(b)}");
    swap_ends(&b);
    var c = [8, 9];
    swap_ends(&c);
    println(f"[{c[0]}, {c[1]}] {arr[2] - 1}");
    var vs: Vec<Vec<i64>> = Vec::new_in(gpa);
    var one: Vec<i64> = Vec::new_in(gpa);
    one.push(10);
    vs.push(one);
    vs.push(w);
    grow_first(&vs);
    println(f"{vs[0].len()} {vs[1].len() - 2} {vs[0]:?}");
    let ps = [(1, "a"), (3, "b")];
    println(f"{second_keys(ps)} {first(&b[1..2])} {first(&a2[2..3])}");
    let u: Vec<i64> = Vec::new_in(gpa);
    println(f"{taken(v)} {count(u)}");
}
