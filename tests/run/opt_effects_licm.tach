// (0.16) Loop-invariant calls: a call of a function that reads and writes
// no memory, with arguments defined outside the loop, moves to the loop's
// preheader when it always returns and cannot panic (it may then run
// where the loop would not have run it), or when it runs in the loop's
// first iteration before anything a stop would make visible. A call
// after a print in the loop stays (it may loop forever: the print must
// come first), and so does a call of a function that reads memory the
// loop writes.
// EXPECT: 8746019408629609934 40 30 4 3
// The hoisted calls are in the preheader (printed after the loop), not in
// the loop (its phis to its branch); the others stay in the loop.
// CHECK: fn sum_cost:
// CHECK: ret
// CHECK: phi
// CHECK-NOT: call cost
// CHECK: branch
// CHECK: call cost
// CHECK: fn sum_quick:
// CHECK: ret
// CHECK: phi
// CHECK-NOT: call quick
// CHECK: cmp.ge
// CHECK: call quick
// CHECK: fn after_print:
// CHECK: ret
// CHECK: phi
// CHECK: call cost
// CHECK: cmp.ge
// CHECK-NOT: call cost
// CHECK: fn reads_written:
// CHECK: ret
// CHECK: phi
// CHECK: call peek
// CHECK: cmp.ge
// CHECK-NOT: call peek
// CHECK: fn main:
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

static mut CELL: i64 = 1;

// Pure, but the optimizer cannot prove it returns (its trip count is a
// parameter).
#[inline(never)]
fn cost(n: i64) -> i64 {
    let mut h = 7;
    let mut i = 0;
    while i < n {
        h = h * 31 + i;
        i += 1;
    }
    h
}

// Pure, always returns, cannot panic.
#[inline(never)]
fn quick(x: i64) -> i64 {
    x * x + 1
}

#[inline(never)]
fn peek() -> i64 {
    unsafe { CELL }
}

fn sum_cost(v: [i64], k: i64) -> i64 {
    let mut s = 0;
    for x in v {
        s += x * cost(k);
    }
    s
}

// Called on some iterations only: hoisted all the same.
fn sum_quick(n: i64, k: i64) -> i64 {
    let mut s = 0;
    for i in 0..n {
        if i % 3 == 0 {
            s += quick(k);
        }
    }
    s
}

fn after_print(n: i64, k: i64) -> i64 {
    let mut s = 0;
    for i in 0..n {
        if i == 7 {
            unsafe { printf(c""); }
        }
        s += cost(k) & 3;
    }
    s
}

fn reads_written(n: i64) -> i64 {
    let mut s = 0;
    for i in 0..n {
        s += peek();
        unsafe { CELL = i; }
    }
    s
}

fn main() -> i32 {
    // (Through function values: no constant arguments, nothing inlined.)
    let f = sum_cost;
    let g = sum_quick;
    let h = after_print;
    let r = reads_written;
    let a: [i64; 4] = [1, 2, 3, 4];
    unsafe {
        printf(c"%ld %ld %ld %ld %ld\n", f(a[..], 1000), g(10, 3), h(10, 5), r(4), r(0) + CELL);
    }
    0
}
