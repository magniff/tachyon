// FLAGS: --check-alloc
// EXIT: 101
// STDERR: resize after free: block #1 (16 bytes), allocated at
// STDERR: checkalloc_resize_freed.vl:9:13, freed at
// STDERR: checkalloc_resize_freed.vl:11:9, resized at
// STDERR: checkalloc_resize_freed.vl:12:17
// 0.16: --check-alloc: a resize of a freed block.
fn main(gpa: Gpa) {
    let p = gpa.alloc(16, 8);
    unsafe {
        gpa.free(p, 16, 8);
        let q = gpa.resize(p, 16, 32, 8);
        q[0] = 1;
    }
}
