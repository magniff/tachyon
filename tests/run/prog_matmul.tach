// Integer and floating-point matrix multiplication with 2D arrays.
// EXPECT: 70 50 10 -50 | 0.307417
// EXPECT: 150 98 -6 -162 | 1.016333
// EXPECT: 230 146 -22 -274 | 2.656677
// EXPECT: 310 194 -38 -386 | 12.095238
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: [[i64; 4]; 4] = [[0; 4]; 4];
    let b: [[i64; 4]; 4] = [[0; 4]; 4];
    let c: [[i64; 4]; 4] = [[0; 4]; 4];
    let f: [[f64; 4]; 4] = [[0.0; 4]; 4];
    let i = 0;
    loop {
        if i == 4 { break; };
        let j = 0;
        loop {
            if j == 4 { break; };
            a[i][j] = i * 4 + j + 1;
            b[i][j] = (i - j) * (i + j + 1);
            j += 1;
        }
        i += 1;
    }
    i = 0;
    loop {
        if i == 4 { break; };
        let j = 0;
        loop {
            if j == 4 { break; };
            let k = 0;
            let s = 0;
            let fs: f64 = 0.0;
            loop {
                if k == 4 { break; };
                s += a[i][k] * b[k][j];
                fs += a[i][k] as f64 * 0.5 / (b[k][j] as f64 + 10.5);
                k += 1;
            }
            c[i][j] = s;
            f[i][j] = fs;
            j += 1;
        }
        i += 1;
    }
    i = 0;
    loop {
        if i == 4 { break; };
        printf("%ld %ld %ld %ld | %.6f\n".0, c[i][0], c[i][1], c[i][2], c[i][3], f[i][i]);
        i += 1;
    }
    0
}
