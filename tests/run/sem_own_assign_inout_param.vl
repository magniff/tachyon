// sem-own: assigning through an inout parameter drops the caller's old value.
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn set(r: inout D, gpa: Gpa) { r = mk(2, gpa); }

fn main(gpa: Gpa) {
    var a = mk(1, gpa);
    set(&a, gpa);
    println("end");
}
