// a view of a Mutex's data kept out of with while the data is changed through the lock
// ERROR: [own.
// XFAIL: SOUNDNESS a view out of Mutex::with survives a push through the lock (use after free)
use std::sync::Mutex;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let s = m.with(|d| d.as_slice());
    m.with(|d| { for i in 0..1000 { d.push(i); } });
    println(f"{s[0]}");
}
