// (0.25 semantics audit, views) std's accessors give a borrowed copy of an
// owned element (`v.get(0)`, `v.last().unwrap()`, `m.get(k).unwrap()` of
// a String); a view taken of that copy (`.as_str()`) views the
// container's element, so clearing the container while it is used is
// own.conflict. The view is tied to the copy instead, and is accepted: a
// use after free. `owners[0].as_str()` (the index place) is caught.
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<String> = Vec::new_in(gpa);
    v.push(String::from_in("hello", gpa));
    let w = v.get(0).as_str();
    v.clear();
    println(w);
    0
}
