// ok: scoped threads read what outlives the scope, and their results are joined inside
// EXPECT: 45
use std::thread;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 { v.push(i); }
    let s = v.as_slice();
    let total = thread::scope(|sc| {
        let a = sc.spawn(|| { var t = 0; for i in 0..5 { t += s[i]; } t });
        let b = sc.spawn(|| { var t = 0; for i in 5..10 { t += s[i]; } t });
        a.join() + b.join()
    });
    println(f"{total}");
}
