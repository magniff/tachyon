// A sink closure owns what it captures and drops it.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(inout self) { println("dropped"); } }

#[no_io]
fn quiet(x: sink Noisy) -> i64 {
    let f = sink || x.n;
    f()
}

fn main() -> i32 {
    println(quiet(Noisy { n: 4 }));
    0
}
