// sem-own: a sink closure inside a sink closure, the outer called twice: the inner moves the capture out on the first call; the second stops (exit 101) or is refused.
// EXIT: 101
// EXPECT: drop 5
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn call2<F: FnMut() -> i64>(f: sink F) -> i64 { f() + f() }
fn call<F: FnMut() -> i64>(f: sink F) -> i64 { f() }

fn main(gpa: Gpa) {
    let d = mk(5, gpa);
    let outer = sink || { let inner = sink || d.id; call(inner) };
    println(f"{call2(outer)}");
}
