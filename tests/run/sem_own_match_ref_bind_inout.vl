// sem-own: `match &x` binds inout accesses: assigning through one drops the old payload.
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
enum E { A(D), N }

fn main(gpa: Gpa) {
    var e = E::A(mk(1, gpa));
    match &e { E::A(d) => { d = mk(2, gpa); }, E::N => {} }
    println("end");
}
