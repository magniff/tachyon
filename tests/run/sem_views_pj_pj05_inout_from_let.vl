// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.readonly: inout projection from a let parameter
// ERROR: error[own.escape]
fn top(v: Vec<i64>) -> inout i64 { &v[0] }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    inout t = top(v);
    t += 1;
    println(v[0]);
    0
}
