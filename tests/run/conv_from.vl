// From and Into (0.15): two From impls on one type, chosen by the
// argument's type (a literal fits the one impl of its kind); From of a
// type itself and of a narrower integer without an impl (`i64::from(x)`);
// `x.into()` where the type is expected; a generic impl; bounds
// `T: From<U>` and `T: Into<U>`.
// EXPECT: 5 3
// EXPECT: 7 7 -2 9
// EXPECT: 4 300
// EXPECT: hey 9
// EXPECT: 11 12
struct Meters { v: i64 }

impl From<i64> for Meters {
    fn from(x: i64) -> Meters { Meters { v: x } }
}

impl From<[u8]> for Meters {
    fn from(s: [u8]) -> Meters { Meters { v: s.len } }
}

struct Wrap<T> { x: T }

impl<T> From<T> for Wrap<T> {
    fn from(x: sink T) -> Wrap<T> { Wrap { x: x } }
}

fn make<T: From<i64>>(x: i64) -> T {
    T::from(x)
}

fn total<T: Into<i64>>(a: sink T, b: sink T) -> i64 {
    let x: i64 = a.into();
    let y: i64 = b.into();
    x + y
}

fn int(n: i64) {
    std::print_int(n);
}

fn main() {
    let m = Meters::from(5);
    let n = Meters::from("abc");
    int(m.v);
    print(" ");
    int(n.v);
    println("");

    let small: i32 = 7;
    let byte: u8 = 9;
    let neg: i8 = -2;
    let same = i64::from(7);
    int(i64::from(small));
    print(" ");
    int(same);
    print(" ");
    int(i64::from(neg));
    print(" ");
    let wide: u32 = byte.into();
    int(wide as i64);
    println("");

    let z: Meters = 4.into();
    let s: i16 = 300;
    let big: i64 = s.into();
    int(z.v);
    print(" ");
    int(big);
    println("");

    let w: Wrap<[u8]> = Wrap::from("hey");
    let w2 = Wrap::<i64>::from(9);
    print(w.x);
    print(" ");
    int(w2.x);
    println("");

    let made: Meters = make(11);
    int(made.v);
    print(" ");
    let a: i32 = 5;
    int(total(a, 7i32));
    println("");
}
