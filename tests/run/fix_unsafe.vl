// FIXUNSAFE: 0.9 to 0.10
// FIXED:     let first = unsafe { *p };
// FIXED:     unsafe {
// FIXED:         printf(c"%ld\n", first);
// FIXED:         printf(c"%ld\n", *p + 1);
// FIXED:     }
// FIXED:     if unsafe { *p > 1 } {
// FIXED:         1 => unsafe { printf(c"one\n") },
// FIXED:     let total = unsafe { add(sum(p, 1), 2) };
// FIXED:     unsafe { printf(c"total %ld\n", total); }
// FIXED:     unsafe { *p as i32 }
// FIXED:     unsafe { p[0] = p[0]; }
// EXPECT: 2
// EXPECT: 3
// EXPECT: big
// EXPECT: two
// EXPECT: total 4
// EXPECT: total 4
// EXIT: 2
// 0.9: volec --fix-unsafe wraps each unsafe operation outside unsafe
// code: a statement, consecutive statements together, a `let`'s value,
// a condition, an arm, a tail.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

unsafe fn sum(p: *i64, n: i64) -> i64 {
    var s = 0;
    for i in 0..n {
        s += p[i];
    }
    s
}

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn tail(p: *i64) -> i64 {
    p[0] = p[0];
    let total = add(p[0], 2);
    printf(c"total %ld\n", total);
    total - 2
}

fn main() -> i32 {
    let x = 2;
    let p: *i64 = &x;
    let first = *p;
    printf(c"%ld\n", first);
    printf(c"%ld\n", *p + 1);
    if *p > 1 {
        printf(c"big\n");
    }
    match x {
        1 => printf(c"one\n"),
        _ => printf(c"two\n"),
    };
    let total = add(sum(p, 1), 2);
    printf(c"total %ld\n", total);
    tail(&x);
    *p as i32
}
