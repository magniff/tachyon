// a let parameter of a plain type with storage is passed by reference when the
// result views it (let-as-borrow); then it aliases an inout argument of the same value
// ERROR: own.conflict
struct A { arr: [i64; 4] }
fn g(x: inout A, y: A) -> [i64] { x.arr[0] = 9; y.arr[..] }
fn main() { var a = A { arr: [1, 2, 3, 4] }; let s = g(&a, a); println(f"{s[0]}"); }
