// -MIN == MIN: the abs of i64::MIN is negative.
// EXIT: 101
// STDERR: index out of bounds: index -9223372036854775808, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64], x: i64) -> i64 {
    let y = if x < 0 { -x } else { x }; if y < s.len() { s[y] } else { 0 }
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s, -9223372036854775807 - 1 + Z));
    0
}
