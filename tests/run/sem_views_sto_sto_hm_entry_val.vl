// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text stored with `m.get(1).unwrap()`; s grows while it is used
// ERROR: error[own.conflict]
fn fill(s: inout [str], x: str) { for i in 0..s.len() { s[i] = x; } }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var m: HashMap<i64, str> = HashMap::new_in(gpa); m.get_or_insert(1, w);
    let r = m.get(1).unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
