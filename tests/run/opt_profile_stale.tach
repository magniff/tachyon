// 0.10: the profile (opt_profile_stale.data) was made before `work`
// changed: it is ignored for `work`, with a warning, and used for the
// functions that did not change.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn work(x: i64) -> i64 {
    if x % 10 == 7 {
        return x * 3;
    }
    if x % 10 == 8 {
        return x * 5;
    }
    x + 1
}

#[inline(never)]
fn same(x: i64) -> i64 {
    if x % 3 == 0 { x / 3 } else { x }
}

fn main() -> i32 {
    let mut total = 0;
    for i in 0..1000 {
        total += work(i) + same(i);
    }
    unsafe { printf(c"%ld\n", total); }
    0
}
