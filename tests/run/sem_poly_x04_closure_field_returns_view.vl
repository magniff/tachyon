// a closure in a struct field returns a view of its argument; the Vec grown meanwhile
// ERROR: [own.conflict]: 'v.push(i)' may change 'v' while 's'
struct H<F> { f: F }

fn main(gpa: Gpa) {
    let h = H { f: |d: Vec<i64>| d.as_slice() };
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = (h.f)(v);
    for i in 0..1000 { v.push(i); }
    println(f"{s[0]}");
}
