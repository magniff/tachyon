// (0.17, T7) std's extend_from_slice copies elements bit for bit: of an
// owned element type both Vecs would own them (a double free). Until
// 0.17.1 gives it a `T: Clone` bound and clones, it is own.move_out at the
// call; push clones instead (own_std_owned_elements).
struct N { v: Vec<i64> }

fn main(gpa: Gpa) -> i32 {
    var xs: Vec<N> = Vec::new_in(gpa);
    xs.push(N { v: Vec::new_in(gpa) });
    var ys: Vec<N> = Vec::new_in(gpa);
    ys.extend_from_slice(xs.as_slice());
    var b: Vec<u8> = Vec::new_in(gpa);
    b.extend_from_slice("plain bytes copy");
    0
}
// ERROR: cannot copy the elements of 'xs.as_slice()' ([N]): extend_from_slice copies them bit for bit
// ERROR-COUNT: 1
