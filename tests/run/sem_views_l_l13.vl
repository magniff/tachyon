// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.escape or reject: view of a by-value field of a sink param / local copy
// ERROR: error[own.escape]
struct E { name: [u8; 8], len: i64 }
fn nm(e: sink E) -> [u8] { e.name[..e.len] }
fn main() -> i32 {
    let e = E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 };
    println(nm(e));
    0
}
