// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: s reassigned while v holds a view of it
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    s = String::from_in("bye", gpa);
    println(v.get(0));
    0
}
