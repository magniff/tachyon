// (0.17, T7) `==`, `!=`, `<`, `<=`, `>`, `>=` on two references compare
// what they point to (T's Eq and Ord, derived or numeric or an enum's
// order), as Rust's do; raw `*T` pointers compare as addresses, and a
// reference cast to one (`a as *P`) too.
#[derive(Eq, Ord)]
struct P { x: i64, y: i64 }
enum Color { Red, Green }
fn lt(a: P, b: P) -> bool { a < b }
fn eq(a: P, b: P) -> bool { a == b }
fn ne_int(a: i64, b: inout i64) -> bool { a != b }
fn same(a: *P, b: *P) -> bool { a == b }
fn same_ref(a: P, b: P) -> bool { &a as *P == &b as *P }
fn col(a: Color, b: Color) -> bool { a < b }

fn main() -> i32 {
    let p = P { x: 1, y: 2 };
    let q = P { x: 1, y: 2 };
    let r = P { x: 0, y: 9 };
    var k = 3;
    let three = 3;
    let red = Color::Red;
    let green = Color::Green;
    println(
        f"{eq(p, q)} {lt(r, p)} {lt(p, r)} {ne_int(three, &k)} {same(&p, &q)} {same_ref(p, p)} {same_ref(p, q)} {col(red, green)}");
    0
}
// EXPECT: true true false false false true false true
