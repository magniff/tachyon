// sem-own: moved and assigned again in each iteration: every value dropped
// once.
// EXPECT: eat 0
// EXPECT: drop 0
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: eat 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var d = mk(0, gpa);
    for i in 0..3 { eat(d); d = mk(i + 1, gpa); }
    println("end");
}
