// parse_int (0.15) returns a Result: Ok, or why not: Empty (no digits),
// InvalidDigit(i) (the byte at i; also past an overflow), Overflow.
// EXPECT: 42 -9223372036854775808 9223372036854775807 7
// EXPECT: overflow overflow empty empty empty bad@2 bad@0 bad@20 bad@1
// EXPECT: ok 5 none
use std::{ParseIntError, parse_int, print_int};

fn show(r: Result<i64, ParseIntError>) {
    match r {
        Ok(n) => print_int(n),
        Err(ParseIntError::Empty) => print("empty"),
        Err(ParseIntError::InvalidDigit(i)) => {
            print("bad@");
            print_int(i);
        }
        Err(ParseIntError::Overflow) => print("overflow"),
    }
}

fn main() {
    for s in ["42", "-9223372036854775808", "9223372036854775807", "+7"] {
        show(parse_int(s));
        print(if s[0] == '+' { "\n" } else { " " });
    }
    for s in ["9223372036854775808", "-9223372036854775809", "", "-", "+", "12x4", " 1",
        "99999999999999999999x", "1 "] {
        show(parse_int(s));
        print(if s == "1 " { "\n" } else { " " });
    }
    // (an Option when absence is all that matters)
    print(if parse_int("5").is_ok() { "ok " } else { "err " });
    print_int(parse_int("5").unwrap_or(0));
    match parse_int("x").ok() {
        Some(_) => println(" some"),
        None => println(" none"),
    }
}
