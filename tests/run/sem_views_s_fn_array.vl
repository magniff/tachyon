// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(a)`; s grows while it is used
// ERROR: error[own.conflict]
fn f(a: [str; 2]) -> str { a[1] }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let a = [w, w];
    let r = f(a);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
