// (0.25) An `inout self` method on an element of a let Vec changes the
// Vec: own.readonly, as `v[0] = x` is.
struct C {
    n: i64,
}

impl C {
    fn inc(inout self) {
        self.n += 1;
    }
}

fn main(gpa: Gpa) {
    var w: Vec<C> = Vec::new_in(gpa);
    w.push(C { n: 1 });
    let v = w;
    v[0].inc();
    println(f"{v[0].n}");
}
// ERROR: 'v[0].inc()' changes 'v', a let binding: it is read-only
