// a view sent through a channel, its Vec dropped before the receive
// ERROR: [own.escape]
// XFAIL: SOUNDNESS a view sent through an mpsc channel outlives its Vec (use after free)
use std::sync::mpsc;

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in::<[i64]>(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..10 { v.push(i + 100); }
        tx.send(v.as_slice()).unwrap();
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i); }
    println(f"{rx.recv().unwrap()[3]}");
}
