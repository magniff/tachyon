// An assertion whose condition is true as written cannot fail: no panic
// (0.25), so #[no_panic] accepts it. debug_assert is nothing outside test
// builds; an assert's effects are its condition's and panic, never unknown.
// EXPECT: 4
#[no_panic]
fn calm(x: i64) -> i64 {
    assert(true);
    assert(1 < 2 && !(3 == 4));
    debug_assert(x > 0);
    x
}

#[pure]
fn checked(x: i64) -> i64 { assert(x > 0); x }

fn main() -> i32 {
    println(calm(4) * checked(1));
    0
}
