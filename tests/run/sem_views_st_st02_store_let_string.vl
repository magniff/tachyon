// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: out stores a view of s (let String), caller grows s
// ERROR: error[own.conflict]
fn f(out: inout Vec<str>, s: String) { out.push(s.as_str()); }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var out: Vec<str> = Vec::new_in(gpa);
    f(&out, s);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(out.get(0));
    0
}
