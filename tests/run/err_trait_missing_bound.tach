// ERROR: no function 'hash' in the bounds of 'T'
// ERROR: no function 'zero' in the bounds of 'U'
// 0.9: a bounded parameter's values have its bounds' functions only.
trait Zero {
    fn zero() -> Self;
}

impl Zero for i64 {
    fn zero() -> i64 { 0 }
}

fn hash_of<T: Eq>(x: sink T) -> u64 {
    x.hash()
}

fn zero_of<U: Eq>() -> U {
    U::zero()
}

fn main() -> i32 {
    hash_of(5);
    let z: i64 = zero_of();
    z as i32
}
