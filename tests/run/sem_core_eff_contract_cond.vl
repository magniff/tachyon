// A requires condition must be pure (contract.effect); one that does io
// through a fn value is accepted, and prints when the requires is checked
// (f$pre: io global panic).
// ERROR: contract
fn noisy(x: i64) -> i64 { println("io"); x }

fn f(x: i64, g: fn(i64) -> i64) -> i64
    requires g(x) > 0
{
    x
}

fn main() -> i32 {
    println(f(3, noisy));
    0
}
