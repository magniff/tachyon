// Patterns on references (0.18.1): `mut` on a binding that is a reference
// into the value, a binding as an or-pattern's alternative under one, and
// a pattern on a raw pointer (one is matched through), each with a help
// that does not suggest `&` in a pattern. (0.20: on an inout access, or a
// `match &e`; a let parameter of a plain type is a copy, and a reference to
// a reference is not written.)
// ERROR: 'mut x' in a pattern on a reference: its bindings are references into the value
// ERROR: a binding as an alternative of an or-pattern on a reference
// ERROR: 'mut x' in a pattern on a reference: its bindings are references into the value
// ERROR: expected '*E', got 'E'
// ERROR: a raw pointer's value is 'match *p', in unsafe code
// ERROR-COUNT: 4
enum E { A(i64), C }

fn h(e: inout E) -> i64 { match e { E::A(var x) => 1, E::C => 0 } }

fn o(e: inout Option<i64>) -> i64 { match e { Some(a | a) => 1, None => 0 } }

fn h2(e: E) -> i64 { match &e { E::A(var x) => 1, E::C => 0 } }

fn f(e: *E) -> i64 { match e { E::A(x) => x, E::C => 0 } }

fn main() {}
