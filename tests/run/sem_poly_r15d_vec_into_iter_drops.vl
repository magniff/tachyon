// for over a Vec<R>'s a borrowed for over Vec<R>: each R dropped once, by the Vec
// FLAGS: --check-alloc
// EXPECT: got 1
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

fn main(gpa: Gpa) {
    var v: Vec<R> = Vec::new_in(gpa);
    v.push(R { id: 1 }); v.push(R { id: 2 }); v.push(R { id: 3 });
    for r in v { if r.id == 2 { break; } println(f"got {r.id}"); }
    println("end");
}
