// ERROR: error[own.readonly]: 's', a '[i64]', is read-only where '&mut [i64]' is expected
// ERROR: refactor signature by_hand --type s '&mut [i64]'
// ERROR: error[own.readonly]: 'v.as_slice()', a '[i64]', is read-only where '&mut [i64]' is expected: the callee writes through it
// ERROR: try: v.sort()
// ERROR: error[own.readonly]: 'a[..]', a '[i64]', is read-only where '&mut [i64]' is expected
// ERROR: try: &mut a[..]
// ERROR: error[own.readonly]: 'w.as_slice()', a '[i64]', is read-only
// ERROR: try: w.as_mut_slice()
// ERROR-COUNT: 4
// (0.19.1) A read-only view `[T]` where `&mut [T]` is expected (a callee
// that writes through it: std's sort, a store intrinsic) is own.readonly;
// 0.17's legacy rule took it as the exclusive view. The fixes: the method
// for `sort(v.as_slice())`, `&mut a[..]`, `v.as_mut_slice()`, and a `[T]`
// parameter retyped with its calls.
fn by_hand(s: [i64]) {
    sort(s);
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(2);
    v.push(1);
    sort(v.as_slice());
    var a: [i64; 3] = [3, 1, 2];
    sort_by(a[..], |x, y| x - y);
    by_hand(a[..]);
    var w: Vec<i64> = Vec::new_in(gpa);
    sort_stable_in(w.as_slice(), gpa);
    println(f"{v[0]} {a[0]}");
}
