// a closure stored into an Option declared outside the block of what it borrows
// ERROR: [type error]: expected 'closure() -> i64
fn put<F>(o: inout Option<F>, f: sink F) { o = Some(f); }
fn none_of<F>(f: F) -> Option<F> { None }

fn main() {
    var keep = none_of(|| 0);
    for i in 0..2 {
        var n = i + 40;
        put(&keep, || n);
    }
    println(f"{(keep.unwrap())()}");
}
