// FLAGS: -C target-cpu=generic -C target-feature=+crc,+aarch64.aes
// EXPECT: neon true crc true aes true sha2 false dotprod false
// EXPECT: avx2 false
// (0.19 Phase 0) The build's features: `-C target-cpu=generic` (Armv8.0
// with NEON), then `-C target-feature=+crc,+aarch64.aes`: has() is a
// constant of that set (not sha2 nor dotprod, which generic lacks), never
// true for another architecture's feature.
use std::arch::has;

fn main() {
    if !has("aarch64") {
        println("neon true crc true aes true sha2 false dotprod false");
        println("avx2 false");
        return;
    }
    let neon = has("neon");
    let crc = has("crc");
    let aes = has("aes");
    let sha2 = has("sha2");
    let dot = has("dotprod");
    println(f"neon {neon} crc {crc} aes {aes} sha2 {sha2} dotprod {dot}");
    let avx2 = has("avx2");
    println(f"avx2 {avx2}");
}
