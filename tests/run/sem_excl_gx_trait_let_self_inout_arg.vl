// let receiver (owned) plus the same value inout, through a trait
// ERROR: own.conflict
trait Look { fn look(self, o: inout Self) -> i64; }
struct S { v: Vec<i64> }
impl Look for S { fn look(self, o: inout S) -> i64 { o.v.clear(); self.v.len() } }
fn main(gpa: Gpa) { var s = S { v: Vec::new_in(gpa) }; s.v.push(1); println(f"{s.look(&s)}"); }
