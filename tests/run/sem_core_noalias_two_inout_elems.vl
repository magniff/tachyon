// Two inout accesses of elements of one array with run-time indexes that are equal.
// ERROR: own.conflict
static var Z: i64 = 0;
#[inline(never)]
fn f(a: inout i64, b: inout i64) -> i64 { a = 10; b = 20; a }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    var x = [1, 2, 3];
    let i = Z;
    let j = Z;
    println(f(&x[i], &x[j]));
    0
}
