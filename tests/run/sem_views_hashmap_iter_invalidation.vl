// (0.25 semantics audit, views) A HashMap iterator views the map's
// table: inserting into (or removing from) the map while `for .. in
// m.iter()` / `m.keys()` / `m.values()` runs, or while a named iterator
// `var it = m.iter()` is used later, is own.conflict, as `v.push` in a
// `for x in v.iter()` is. It is accepted: the insert grows the table and
// the loop reads the freed one.
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    for i in 0..8 { m.insert(i, i); }
    for k in m.keys() { m.insert(k + 100, 0); }
    println(m.len());
    0
}
