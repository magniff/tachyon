// a closure borrowing an owned var kept in Some; the Vec grown while the closure is used after
// ERROR: [own.conflict]: 'v.push(i)' may change 'v' while 'o'
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = v.as_slice();
    let o = Some(|| s[0]);
    for i in 0..1000 { v.push(i); }
    println(f"{(o.unwrap())()}");
}
