// A closure that prints, given to a generic function inside a #[no_io] one.
// ERROR: 'quiet' is #[no_io], but it does io
fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { f(x) }

#[no_io]
fn quiet(x: i64) -> i64 { apply(|y| { println("io"); y }, x) }

fn main() -> i32 {
    println(quiet(3));
    0
}
