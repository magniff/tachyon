// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of a Vec<String>'s item via a for loop kept, then v cleared
// XFAIL: OVERSTRICT a view of a for loop's borrowed element is own.escape when kept past the loop
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<String> = Vec::new_in(gpa);
    v.push(String::from_in("hello", gpa));
    var w: str = "";
    for x in v { w = x.as_str(); }
    v.clear();
    println(w);
    0
}
