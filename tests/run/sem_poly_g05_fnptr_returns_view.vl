// a fn pointer whose result views its argument: the result views the block's Vec
// ERROR: [own.escape]: the block's value views 'v', which dies
fn sl(d: Vec<i64>) -> [i64] { d.as_slice() }

fn main(gpa: Gpa) {
    let f: fn(Vec<i64>) -> [i64] = sl;
    let s = {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        f(v)
    };
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..100 { w.push(i); }
    println(f"{s[5]}");
}
