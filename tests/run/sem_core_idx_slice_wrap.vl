// lo and hi near i64::MAX whose difference is small.
// EXIT: 101
// STDERR: slice range out of bounds: 9223372036854775806..9223372036854775807, length 3
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3];
    let s = a[9223372036854775806 + Z..9223372036854775807 + Z];
    println(s.len());
    println("not reached");
    0
}
