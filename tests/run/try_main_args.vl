// `fn main(argc, argv) -> Result<(), E>` that returns Ok: exit status 0;
// `return Err(..)` in main is the error.
// ARGS: one
// STDERR: Error: "two arguments"
// EXIT: 1
fn main(argc: i32, argv: **u8) -> Result<(), [u8]> {
    if argc == 1 {
        println("no arguments");
        return Ok(());
    }
    if argc == 2 {
        return Err("two arguments");
    }
    Ok(())
}
