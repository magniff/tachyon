// Casting a non-literal integer to a pointer is unsafe (guide unsafe):
// in a static's initializer it is accepted outside unsafe code.
// XFAIL: WRONG `static P: *i64 = 4096 as *i64;` is accepted outside unsafe
// ERROR: casting an integer to a pointer is unsafe
static P: *i64 = 4096 as *i64;
fn main() -> i32 { println(P.is_null()); 0 }
