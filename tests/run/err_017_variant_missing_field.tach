// 0.17: a struct-like variant's literal gives every field.
// ERROR: missing field 'shift' in variant 'Ev::Key' constructor
// ERROR: help: its fields: code: i64, shift: bool
// ERROR-COUNT: 1
enum Ev { Key { code: i64, shift: bool }, Quit }

fn main() -> i32 {
    let e = Ev::Key { code: 1 };
    match e { Ev::Key { code, .. } => code as i32, Ev::Quit => 0 }
}
