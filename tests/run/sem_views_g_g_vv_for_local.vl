// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `r`; s grows while it is used
// XFAIL: OVERSTRICT an element of an element's loop (for x in row) is reported as viewing the loop's __for_seq
// ERROR: error[own.conflict]
// ERROR-COUNT: 1
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); var vv: Vec<Vec<str>> = Vec::new_in(gpa); vv.push(v); var r: str = ""; for row in vv { for x in row { r = x; } }
    let r = r;
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
