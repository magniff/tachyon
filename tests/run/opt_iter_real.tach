// 0.14: the iterator chains of opt_iter_map_sum, opt_iter_next and
// opt_iter_deep written with std's iterators and real closures, as the
// front end makes them: once inlined, each is the hand-written loop (no
// call, no frame slot; the vector loop where the hand loop has one).
// EXPECT: 14850 14850
// EXPECT: 124750 499500
// EXPECT: 4950 2450 328350 9900
// EXPECT: 100 348050
// EXPECT: 11100
// (callc rt.panic, a failed bounds check or unwrap, is no call of a
// closure or an iterator method)
// CHECK: fn kernel:
// CHECK-NOT: call
// CHECK-NOT: slot
// CHECK: mul
// CHECK: +24
// CHECK-NOT: call
// CHECK-NOT: slot
// CHECK: fn hand:
// CHECK: +24
// CHECK: fn take_sum:
// CHECK-NOT: call take_sum
// CHECK-NOT: call std.
// CHECK-NOT: slot
// CHECK-NOT: switch
// CHECK: v2i64 = load
// CHECK-NOT: call take_sum
// CHECK-NOT: call std.
// CHECK-NOT: slot
// CHECK: fn chains:
// CHECK-NOT: call chains
// CHECK-NOT: call std.
// CHECK-NOT: slot
// CHECK: +24
// CHECK-NOT: call chains
// CHECK-NOT: call std.
// CHECK-NOT: slot
// CHECK: fn max_fold:
// CHECK-NOT: call max_fold
// CHECK-NOT: call std.
// CHECK-NOT: slot
// CHECK-NOT: switch
// CHECK-NOT: u8 = phi
// CHECK: fn deep:
// CHECK-NOT: call
// CHECK-NOT: slot
// CHECK: fn main:

#[inline(never)]
fn kernel(v: Vec<i64>) -> i64 {
    v.iter().map(|x| x * 3).sum()
}

#[inline(never)]
fn hand(v: Vec<i64>) -> i64 {
    let s = v.as_slice();
    var t = 0;
    for k in 0..s.len {
        t += s[k] * 3;
    }
    t
}

// `for` over a chain: `next`, not `fold`
#[inline(never)]
fn take_sum(v: Vec<i64>, n: i64) -> i64 {
    var t = 0;
    for x in v.iter().take(n) {
        t += x;
    }
    t
}

// filter, zip, enumerate, count
#[inline(never)]
fn chains(v: Vec<i64>, w: Vec<i64>) -> i64 {
    let a = v.iter().filter(|x| x % 2 == 0).count();
    let b = v.iter().zip(w.iter()).map(|(x, y)| x * y).sum();
    let c = v.iter().enumerate().map(|(i, x)| i * x).sum();
    let d = v.iter().filter(|x| x % 2 == 0).map(|x| x * 2).sum();
    a + b + c + d
}

// max: one `next`, then a fold whose accumulator is plain
#[inline(never)]
fn max_fold(v: Vec<i64>, k: i64) -> i64 {
    v.iter().map(|x| (x * k) % 101).max().unwrap()
}

// six capturing maps
#[inline(never)]
fn deep(v: Vec<i64>, a: i64) -> i64 {
    let b = a + 1;
    let c = a + 2;
    v.iter().map(|x| x + a).map(|x| x + b).map(|x| x - c).map(|x| x * 2).map(|x| x + a)
        .map(|x| x - a).sum()
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..100 {
        v.push(i);
        w.push(i % 7);
    }
    std::print_int(kernel(v));
    print(" ");
    std::print_int(hand(v));
    println("");
    var u: Vec<i64> = Vec::new_in(gpa);
    for i in 0..1000 {
        u.push(i);
    }
    std::print_int(take_sum(u, 500));
    print(" ");
    std::print_int(take_sum(u, 5000) + take_sum(u, 1) + take_sum(u, -3));
    println("");
    let a = v.iter().sum();
    let b = v.iter().filter(|x| x % 2 == 0).sum();
    let c = v.iter().enumerate().map(|(i, x)| i * x).sum();
    let d = v.iter().zip(w.iter()).count() * 99;
    std::print_int(a);
    print(" ");
    std::print_int(b);
    print(" ");
    std::print_int(c);
    print(" ");
    std::print_int(d);
    println("");
    std::print_int(max_fold(v, 3));
    print(" ");
    std::print_int(chains(v, w));
    println("");
    std::print_int(deep(v, 7));
    println("");
    0
}
