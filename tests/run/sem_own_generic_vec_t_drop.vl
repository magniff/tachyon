// sem-own: a Vec<T> built in a generic fn, returned: elements dropped once by the caller.
// EXPECT: n 2
// EXPECT: drop 1
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn two<T>(a: sink T, b: sink T, gpa: Gpa) -> Vec<T> {
    var v: Vec<T> = Vec::new_in(gpa); v.push(a); v.push(b); v
}

fn main(gpa: Gpa) {
    let v = two(mk(1, gpa), mk(2, gpa), gpa);
    println(f"n {v.len()}");
}
