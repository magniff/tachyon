// 0.20 Phase 0: a file read in 0.20's spelling only (--syntax=0.20, the
// default from Phase M): `&x` is the inout marker, exclusive; let is the
// unwritten default (until T1, a by-value parameter: plain types here).
// FLAGS: --syntax=0.20
// EXPECT: 3 [0, 1, 2, 7]
struct S { n: i64 }
impl S { fn bump(inout self) { self.n += 1; } fn get(self) -> i64 { self.n } }
fn fill(v: inout Vec<i64>, k: i64) { for i in 0..k { v.push(i); } }
fn put(s: inout [i64], x: i64) { s[s.len() - 1] = x; }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    fill(&v, 4);
    put(&v[..], 7);
    var s = S { n: 1 };
    s.bump();
    s.bump();
    println(f"{s.get()} {v:?}");
}
