// Structs, tuples and arrays are passed by value: the callee gets a copy.
// EXPECT: 316 1 2 3 4
extern fn printf(format: *u8, ...) -> i32;

struct P { x: i64, y: i64 }

fn bump(p: P, t: (i64, f64), a: [i32; 3]) -> i64 {
    p.x = p.x + 100;
    t.0 = t.0 + 100;
    a[0] = a[0] + 100;
    p.x + p.y + t.0 + a[0] as i64 + a[2] as i64
}

fn main() -> i64 {
    let p = P { x: 1, y: 2 };
    let t = (3, 0.5);
    let a: [i32; 3] = [4, 5, 6];
    let r = bump(p, t, a);
    printf("%ld %ld %ld %ld %d\n".0, r, p.x, p.y, t.0, a[0]);
    0
}
