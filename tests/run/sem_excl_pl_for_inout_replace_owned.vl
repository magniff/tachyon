// XFAIL: DIAG for inout is not built yet (D18); misleading parser error
// assigning through a for-inout binding drops the old element (check-alloc)
// EXPECT: 0 0
fn main(gpa: Gpa) {
    var v: Vec<Vec<i64>> = Vec::new_in(gpa); var a: Vec<i64> = Vec::new_in(gpa); a.push(1);
    v.push(a); for inout w in &v { w = Vec::new_in(gpa); } println(f"{v[0].len()} {v.len() - 1}");
}
