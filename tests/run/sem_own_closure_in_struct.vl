// sem-own: a sink closure kept in a generic struct field: its capture dropped once, with the struct.
// EXPECT: 1
// EXPECT: end
// EXPECT: drop 1
// EXPECT: after
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct H<F> { f: F }

fn main(gpa: Gpa) {
    {
        let d = mk(1, gpa);
        let h = H { f: sink || d.id };
        println(f"{(h.f)()}");
        println("end");
    }
    println("after");
}
