// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello + X's length (the closure is called after the growth; it reads s then)
// EXPECT: 78
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    let c = || s.as_str();
    println(c().len());
    0
}
