// 0.18: what distinct types refuse: an owned or view underlying type
// (distinct.kind), two distinct types mixed, a distinct type where its
// underlying type goes, and the underlying type's methods.
// ERROR: a distinct type is over a plain type: 'Vec<i64>' owns memory
// ERROR: a distinct type is over a plain type: '[u8]' views memory
// ERROR: 'm + f' mixes 'Meters' and 'Feet'
// ERROR: 'n' is 'NodeId' where 'i64' goes
// ERROR: 'w' is 'i64' where 'NodeId' goes
// ERROR: 'area' is a method of 'Rect', not of 'Tile'
type Ids = distinct Vec<i64>;
type Text = distinct [u8];
type Meters = distinct f64;
type Feet = distinct f64;
type NodeId = distinct i64;
type Tile = distinct Rect;

struct Rect { w: i64, h: i64 }

impl Rect {
    fn area(self: Rect) -> i64 { self.w * self.h }
}

fn plain(x: i64) -> i64 { x }

fn main() {
    let m: Meters = 1.0;
    let f: Feet = 2.0;
    let s = m + f;
    let n: NodeId = 3;
    let k = plain(n);
    let w: i64 = 4;
    let id: NodeId = w;
    let t = Rect { w: 2, h: 3 } as Tile;
    let a = t.area();
}
