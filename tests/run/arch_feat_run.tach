// FLAGS: -C target-cpu=generic
// CHECK-OPT: 0
// ASM-NOT(aarch64-macos): brk #1
// ASM-NOT(aarch64-linux): brk #1
// EXPECT: crc32c 3808858755
// EXPECT: has crc false, neon true; declared crc true; detect neon true
// (0.19) Guarded intrinsics run where the analysis allows them: CRC-32C of
// "123456789" (0xE3069283) by crc's instruction under detect("crc") or
// by bits otherwise (the same value either way: a CPU without crc, or
// detection not yet run, takes the fallback), with x86-64's branch type-
// checked and dead (has/detect of another architecture's feature is
// false: no code for it, even at -O0, the ASM-NOT lines). has() is true in
// a #[target_feature] function for what it declares.
use std::arch::{detect, has};
use std::arch::aarch64::__crc32cd;
use std::arch::x86_64::_mm_crc32_u64;

fn le64(s: [u8], i: i64) -> u64 {
    let mut x: u64 = 0;
    for k in 0..8 {
        x |= (s[i + k] as u64) << (8 * k) as u64;
    }
    x
}

fn crc_bits(c0: u32, x: u64, bits: i64) -> u32 {
    let mut c = c0 ^ x as u32;
    let mut rest = x >> 32;
    for k in 0..bits {
        if k == 32 {
            c ^= rest as u32;
        }
        c = if (c & 1) != 0 { (c >> 1) ^ 0x82f63b78 } else { c >> 1 };
    }
    c
}

fn crc32c(s: [u8]) -> u32 {
    let mut c: u32 = 0xffffffff;
    let mut i = 0;
    while i + 8 <= s.len as i64 {
        let x = le64(s, i);
        if detect("crc") {
            c = __crc32cd(c, x);
        } else if detect("sse4.2") {
            c = _mm_crc32_u64(c as u64, x) as u32;
        } else {
            c = crc_bits(c, x, 64);
        }
        i += 8;
    }
    while i < s.len as i64 {
        c = crc_bits(c, s[i] as u64, 8);
        i += 1;
    }
    ~c
}

#[target_feature(enable = "crc")]
fn declared() -> bool {
    has("crc")
}

fn main() {
    println(f"crc32c {crc32c("123456789")}");
    let d = if detect("crc") { declared() } else { true };
    println(
        f"has crc {has("crc")}, neon {has("neon")}; declared crc {d}; detect neon {detect("neon")}");
}
