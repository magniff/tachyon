// (0.19) Every 0.10 vector operation on the new 256-bit vector types (unsigned
// lanes, 64-bit and 256-bit vectors: docs/design/arch.md §2.2), every lane
// printed: the same answers at every level (-O0 computes lane by lane).
// A 256-bit vector is legalized into two 128-bit halves in lowering.
// CROSS: x86_64-linux
fn main() {
    let V32i8a = v32i8(0, 127, 5, 1, -128, 100, -1, -3, 0, 127, 5, 1, -128, 100, -1, -3, 0, 127, 5,
        1, -128, 100, -1, -3, 0, 127, 5, 1, -128, 100, -1, -3);
    let V32i8b = v32i8(-3, 0, 127, 5, 1, -128, 100, -1, -3, 0, 127, 5, 1, -128, 100, -1, -3, 0, 127,
        5, 1, -128, 100, -1, -3, 0, 127, 5, 1, -128, 100, -1);
    { let r = V32i8a + V32i8b; print("v32i8 +:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V32i8a - V32i8b; print("v32i8 -:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V32i8a * V32i8b; print("v32i8 *:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V32i8a & V32i8b; print("v32i8 &:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V32i8a | V32i8b; print("v32i8 |:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V32i8a ^ V32i8b; print("v32i8 ^:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V32i8a == V32i8b); print("v32i8 ==:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V32i8a != V32i8b); print("v32i8 !=:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V32i8a < V32i8b); print("v32i8 <:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V32i8a <= V32i8b); print("v32i8 <=:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V32i8a > V32i8b); print("v32i8 >:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V32i8a >= V32i8b); print("v32i8 >=:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V32i8a; print("v32i8 neg:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V32i8a < V32i8b).select(V32i8a, V32i8b); print("v32i8 sel:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    println(f"v32i8 sum {V32i8a.sum()} {V32i8b.sum()} lane {V32i8a.lane(31)} {V32i8a.lane(0)}");
    { let r = v32i8::splat(V32i8b.lane(31)); print("v32i8 splat:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V32i8a.with_lane(31, V32i8b.lane(0)); print("v32i8 with:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let mut k = 0; let mut s = 0 as i8;
        while k < 32 { s = s + V32i8b.lane(k); k += 1; } let w = V32i8a.with_lane(k - 1, s);
        print("v32i8 var:"); for i in 0..32 { print(f" {w.lane(i)}"); } println(""); }
    { let mut arr: [i8; 34] = [0 as i8; 34]; V32i8a.store(arr, 1);
        let r = v32i8::load(arr, 1) + v32i8::load(arr[0..34], 2); print("v32i8 mem:");
        for i in 0..32 { print(f" {r.lane(i)}"); } println(""); }
    { let mut c = V32i8a; c += V32i8b; c *= V32i8b; print("v32i8 acc:");
