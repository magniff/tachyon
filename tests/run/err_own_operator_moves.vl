struct N { v: Vec<i64> }

impl std::Add for N {
    fn add(self, other: N) -> N { self }
}

fn main(gpa: Gpa) -> i32 {
    let a = N { v: Vec::new_in(gpa) };
    let c = N { v: Vec::new_in(gpa) };
    let b = a + c;
    std::print_int(a.v.len());
    0
}
// (0.17, T7) `a + c` moved its operands (own_operator_moves), so a use of
// 'a' after it was own.moved. 0.20: std::Add's operands are let, so 'a' is
// still there after `a + c`, and the impl cannot move 'self' out.
