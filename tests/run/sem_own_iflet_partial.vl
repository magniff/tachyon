// sem-own: `if let E::B(x, _) = e` moves x; the other field stays in e.
// EXPECT: x 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
enum E { B(D, D), N }

fn main(gpa: Gpa) {
    let e = E::B(mk(2, gpa), mk(3, gpa));
    if let E::B(x, _) = e { println(f"x {x.id}"); }
    println("end");
}
