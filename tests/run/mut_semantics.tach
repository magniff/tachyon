// `mut` controls assignment to a binding and to its fields and elements.
// Raw pointers are unchecked, like C: writing through `*p` or `p[i]` does
// not need `mut`, and `&x` may be taken of an immutable binding.
// EXPECT: 11 2 30 7 105
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct Counter { hits: i64 }

fn bump(c: &mut Counter) {
    (*c).hits += 1;
}

fn add_all(mut total: i64, xs: *i64, n: i64) -> i64 {
    for i in 0..n { unsafe { total += xs[i]; } }
    total
}

fn main() -> i64 {
    let c = Counter { hits: 10 };
    bump(&mut c);
    let x = 1;
    let p: *i64 = &x;
    unsafe { *p = 2; }
    let nums = [5, 10, 15];
    let sum = add_all(0, &nums[0], 3);
    // shadowing can add `mut`
    let n = 3;
    let mut n = n;
    n += 4;
    let mut arr = [100, 0];
    arr[1] = arr[0] + 5;
    unsafe { printf(c"%ld %ld %ld %ld %ld\n", c.hits, x, sum, n, arr[1]); }
    0
}
