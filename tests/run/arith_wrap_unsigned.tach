// Unsigned add/sub/mul wrap around at every width.
// EXPECT: u8 4 16 196
// EXPECT: u16 4 16 65476
// EXPECT: u32 4 16 4294967236
// EXPECT: u64 4 16 18446744073709551556
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: u8 = 250;
    let b: u8 = 10;
    printf("u8 %d %d %d\n".0, a + b, b - a, a * b);
    let c: u16 = 65530;
    let d: u16 = 10;
    printf("u16 %d %d %d\n".0, c + d, d - c, c * d);
    let e: u32 = 4294967290;
    let f: u32 = 10;
    printf("u32 %u %u %u\n".0, e + f, f - e, e * f);
    let g: u64 = 18446744073709551610;
    let h: u64 = 10;
    printf("u64 %lu %lu %lu\n".0, g + h, h - g, g * h);
    0
}
