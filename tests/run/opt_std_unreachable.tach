// 0.14: std's functions the program cannot reach are dropped before the
// optimizer runs (at -O1 too, which has no global dead code elimination):
// a program printing a number keeps print_int and what it calls, not
// std's input, parsing, sorting or iterator functions.
// EXPECT: 42
// CHECK-OPT: 1
// CHECK: fn main:
// CHECK-NOT: fn std.read_line:
// CHECK-NOT: fn std.Scanner
// CHECK-NOT: fn std.parse_int:
// CHECK-NOT: fn std.split
// CHECK-NOT: fn std.sort
// CHECK: fn std.print_int:
// CHECK-NOT: fn std.read_line:
// CHECK-NOT: fn std.Scanner
// CHECK-NOT: fn std.parse_int:
// CHECK-NOT: fn std.split
// CHECK-NOT: fn std.sort
fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    v.push(42);
    std::print_int(v.get(0));
    println("");
    v.free();
    0
}
