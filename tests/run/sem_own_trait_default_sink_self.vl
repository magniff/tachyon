// sem-own: a trait default method with `sink self` calling a let-self method: dropped once at its end.
// EXPECT: drop 1
// EXPECT: 2
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
trait T2 { fn id2(self) -> i64; fn consume(sink self) -> i64 { 2 * self.id2() } }
impl T2 for D { fn id2(self) -> i64 { self.id } }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    println(f"{a.consume()}");
    println("end");
}
