// (0.25) A container a sink closure took, given where its slice or text
// goes; nested closures; a generic callee.
// EXPECT: 7 2 3
// EXPECT: 7 7 2
// EXPECT: 7 7
fn first(s: [i64]) -> i64 { s[0] }
fn n(s: [u8]) -> i64 { s.len() }
fn tl(s: str) -> i64 { s.len() }
fn gfirst<T>(s: [T]) -> T { s[0] }
fn glen<T>(s: [T]) -> i64 { s.len() }
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(7);
    var b = Buf::new_in(gpa);
    b.push_str("ab");
    let s = String::from_in("abc", gpa);
    let f = sink || first(v);
    let g = sink || n(b);
    let h = sink || tl(s);
    println(f"{f()} {g()} {h()}");
    var w: Vec<i64> = Vec::new_in(gpa);
    w.push(7);
    var c = Buf::new_in(gpa);
    c.push_str("xy");
    let outer = || {
        let inner = || first(w);
        inner()
    };
    let gg = || gfirst::<i64>(w);
    let gl = || glen::<u8>(c);
    println(f"{outer()} {gg()} {gl()}");
    let deep = || {
        let mid = || {
            let low = || first(w) + 0;
            low()
        };
        mid()
    };
    let gnest = || { let i = || gfirst::<i64>(w); i() };
    println(f"{deep()} {gnest()}");
}
