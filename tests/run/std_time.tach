// EXPECT: new 3 500000000 millis 1 250000000 micros 0 1500 nanos 2 5
// EXPECT: add 5 100000000 sub 0 900000000 sub under true add over true
// EXPECT: sat max true zero true mul 7 500000000 div 0 333333333 mul over true div0 true
// EXPECT: f64 1.5 2 999999999 rounded 1 0 bad true true
// EXPECT: as_millis 1250 as_micros 1250000 as_nanos 1250000000 sat true
// EXPECT: cmp -1 1 0 abs_diff 0 250000000 zero true
// EXPECT: monotonic true sleep true realtime true
// 0.20 (A7): std::time's Duration, its arithmetic at its edges, and the
// clocks (monotonic, realtime, sleep).
use std::sys::SYS_CLOCK_REALTIME;
use std::time::{Duration, clock_now, monotonic_now, sleep};

fn main() -> i32 {
    let a = Duration::new(1, 2500000000);
    let b = Duration::from_millis(1250);
    let c = Duration::from_micros(1500);
    let d = Duration::from_nanos(2000000005);
    println(
        f"new {a.as_secs()} {a.subsec_nanos()} millis {b.as_secs()} {b.subsec_nanos()} micros {c.as_secs()} {c.subsec_micros()} nanos {d.as_secs()} {d.subsec_nanos()}");

    let s = Duration::new(3, 600000000).checked_add(Duration::new(1, 500000000)).unwrap();
    let t = Duration::new(2, 0).checked_sub(Duration::new(1, 100000000)).unwrap();
    let under = Duration::new(1, 0).checked_sub(Duration::new(1, 1)).is_none();
    let over = Duration::max_value().checked_add(Duration::from_nanos(1)).is_none();
    println(
        f"add {s.as_secs()} {s.subsec_nanos()} sub {t.as_secs()} {t.subsec_nanos()} sub under {under} add over {over}");

    let sat = Duration::max_value().saturating_add(Duration::from_secs(1)) == Duration::max_value();
    let zero = Duration::from_secs(1).saturating_sub(Duration::from_secs(2)).is_zero();
    let m = Duration::new(2, 500000000).mul_u32(3);
    let dv = Duration::from_secs(1).div_u32(3);
    let mover = Duration::from_secs(9223372036854775807).checked_mul(3).is_none();
    let div0 = Duration::from_secs(1).checked_div(0).is_none();
    println(
        f"sat max {sat} zero {zero} mul {m.as_secs()} {m.subsec_nanos()} div {dv.as_secs()} {dv.subsec_nanos()} mul over {mover} div0 {div0}");

    let f = Duration::from_secs_f64(2.999999999);
    let r = Duration::from_secs_f64(0.9999999999);
    let bad1 = Duration::try_from_secs_f64(-1.0).is_none();
    let bad2 = Duration::try_from_secs_f64(1.0e30).is_none();
    println(
        f"f64 {Duration::new(1, 500000000).as_secs_f64()} {f.as_secs()} {f.subsec_nanos()} rounded {r.as_secs()} {r.subsec_nanos()} bad {bad1} {bad2}");

    let ms = Duration::from_millis(1250);
    let satm = Duration::max_value().as_nanos() == 18446744073709551615;
    println(
        f"as_millis {ms.as_millis()} as_micros {ms.as_micros()} as_nanos {ms.as_nanos()} sat {satm}");

    let x = Duration::new(1, 0);
    let y = Duration::new(1, 1);
    let ad = Duration::from_millis(1000).abs_diff(Duration::from_millis(1250));
    println(
        f"cmp {x.cmp(&y)} {y.cmp(&x)} {x.cmp(&x)} abs_diff {ad.as_secs()} {ad.subsec_nanos()} zero {Duration::zero().is_zero()}");

    let mut prev = monotonic_now();
    let mut mono = true;
    for _ in 0..1000 {
        let now = monotonic_now();
        if now < prev {
            mono = false;
        }
        prev = now;
    }
    let t0 = monotonic_now();
    sleep(Duration::from_millis(20));
    let slept = monotonic_now().checked_sub(t0).unwrap();
    let real = clock_now(SYS_CLOCK_REALTIME).as_secs() > 1700000000;
    println(f"monotonic {mono} sleep {slept >= Duration::from_millis(20)} realtime {real}");

    0
}
