// ERROR: own.conflict
trait Look { fn look(self, o: inout Self) -> i64; }
struct S { v: Vec<i64> }
impl Look for S { fn look(self, o: inout S) -> i64 { o.v.clear(); self.v.len() } }
fn go<T: Look>(a: inout T) -> i64 { a.look(&a) }
fn main(gpa: Gpa) { var s = S { v: Vec::new_in(gpa) }; s.v.push(1); println(f"{go(&s)}"); }
