// map over owned items: each R dropped once
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: drop 0
// EXPECT: sum 3
// EXPECT: drop 1
// EXPECT: drop 0
// EXPECT: count 2
// XFAIL: SOUNDNESS map's closure never drops its sink parameter (no closure drops its by-value parameters, as sem_own_closure_byvalue_param_map): the items map passes it leak; count drops them (0.25)
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;

    fn next(inout self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        Some(R { id: self.n })
    }
}

fn main() {
    let t = Gen { n: 3 }.map(|r| r.id).sum();
    println(f"sum {t}");
    let c = Gen { n: 2 }.count();
    println(f"count {c}");
}
