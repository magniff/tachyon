// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello  (stored view of a let param, used while e alive)
// XFAIL: OVERSTRICT a view of a let parameter stored into an inout parameter is own.escape: the let-as-borrow rule covers results only
// EXPECT: hello
// EXPECT: 7
struct E { name: [u8; 8], len: i64 }
fn keep(out: inout Vec<[u8]>, e: E) { out.push(e.name[..e.len]); }
fn clobber() -> i64 { let z = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main(gpa: Gpa) -> i32 {
    let e = E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 };
    var out: Vec<[u8]> = Vec::new_in(gpa);
    keep(&out, e);
    let k = clobber();
    println(out.get(0));
    println(k);
    0
}
