// (0.25) A store to an element, or through inout, drops the value it replaces.
// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
struct H { d: D, n: i64 }
fn put(h: inout H) { h.d = D { id: 2 }; h.n += 1; }
fn main() { var h = H { d: D { id: 1 }, n: 0 }; put(&h); println("after"); }
