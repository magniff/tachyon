// (0.25) A match by value taking parts out of an enum that implements Drop
// is own.partial: its drop needs all of it (Rust's E0509).
// ERROR: own.partial
struct D { id: i64, v: Vec<i64> }
enum E { A(D), N }
impl Drop for E { fn drop(inout self) { println("drop e"); } }

fn main(gpa: Gpa) {
    let e = E::A(D { id: 1, v: Vec::new_in(gpa) });
    match e { E::A(d) => println(f"{d.id}"), E::N => {} }
}
