// a generic apply over a let argument: the closure returns a view of its argument through R
// ERROR: [own.
// XFAIL: SOUNDNESS a call of a generic F parameter loses its result's view summary: a view of a dead Vec escapes
fn apply<T, R, F: Fn(T) -> R>(x: T, f: F) -> R { f(x) }

fn main(gpa: Gpa) {
    var w: Vec<i64> = Vec::new_in(gpa);
    let s = {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        apply(v, |d: Vec<i64>| d.as_slice())
    };
    for i in 0..100 { w.push(i); }
    println(f"{s[5]}");
}
