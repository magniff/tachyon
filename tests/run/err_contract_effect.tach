// (0.18) A condition is pure: it may not do io, allocate or touch a static
// (contract.effect, with the call that does and a query naming why).
// ERROR: the 'requires' of 'f' calls 'log', which does io
// ERROR: the 'ensures' of 'f' reads the static 'COUNT'
// ERROR: 'result' is the returned value, which a 'requires' does not see
// ERROR: 'result' in an 'ensures' of a function that returns nothing
// ERROR-COUNT: 4

static var COUNT: i64 = 0;

fn log(x: i64) -> bool {
    println(f"{x}");
    true
}

fn f(x: i64) -> i64
    requires log(x)
    ensures result > unsafe { COUNT }

{
    x
}

fn g(x: i64) -> i64
    requires result > 0
{
    x
}

fn h(x: i64)
    ensures result > 0
{
}

fn main() -> i32 {
    f(1);
    g(2);
    h(3);
    0
}
