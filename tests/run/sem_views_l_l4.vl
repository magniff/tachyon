// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject (view of a temporary) or print hello
// EXPECT: hello
// EXPECT: 7
struct E { name: [u8; 8], len: i64 }
impl E { fn name(self) -> [u8] { self.name[..self.len] } }
fn mk() -> E { E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 } }
fn clobber() -> i64 { let z = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }
fn main() -> i32 {
    let n = mk().name();
    let k = clobber();
    println(n);
    println(k);
    0
}
