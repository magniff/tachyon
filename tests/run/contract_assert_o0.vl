// (0.18) The assertions: assert(c), assert(c, "message"), assert_eq(a, b),
// assert_ne(a, b), debug_assert(c) (only in test builds), and their bang
// spellings. Operands are evaluated once; a failure prints the position,
// the condition and its values.
// FLAGS: -O0
// EXIT: 101
// EXPECT: 2
// EXPECT: ok
// STDERR: contract_assert_o0.vl:34:5: assertion failed: 'v.len() == 3': v.len() = 2

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    // pops once
    assert(v.pop() == Some(3));
    assert !(v.len() == 2);
    assert_eq(v.len(), 2);
    assert_eq !(v.get(0), 1);
    assert_ne(v.get(0), v.get(1));
    assert_ne !(v.get(1), 3);
    assert(v.len() > 0, "never empty here");
    // not a test build: not checked, not evaluated
    debug_assert(v.pop() == Some(100));
    debug_assert !(false);
    std::print_int(v.len());
    println("");
    let x: u8 = 200;
    assert(x > 100);
    let big: u64 = 18446744073709551615;
    assert(big > 0);
    println("ok");
    assert_eq(v.len(), 3);
    0
}
