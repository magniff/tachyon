// FLAGS: -C target-feature=-aarch64.crc
// EXPECT: 89927389262 35512649461 2644923068
// CHECK: = cpufeat crc
// CHECK-NOT: = intr.__crc32cw
// CHECK: fn main
// (0.19 T6) An intrinsic under a detect guard is never run before the
// guard is tested: the crc is loop-invariant, but it runs only in some
// iterations, so LICM leaves it in the loop, under its guard (before, it
// was hoisted into the preheader beside the detect: SIGILL on a CPU
// without crc). The detect itself is hoisted.
use std::arch::detect;
use std::arch::aarch64::__crc32cw;

// CRC-32C of `crc` and the 4 bytes of `data`, bit by bit (no inversion).
fn soft_crc(crc: u32, data: u32) -> u32 {
    var c = crc ^ data;
    for _ in 0..32 {
        c = if (c & 1) != 0 { (c >> 1) ^ 0x82f63b78 } else { c >> 1 };
    }
    c
}

#[inline(never)]
fn work(x: u32, y: u32, n: i64) -> u64 {
    var acc: u64 = 0;
    for i in 0..n {
        if i % 3 == 0 {
            if detect("crc") {
                acc += __crc32cw(x, y) as u64;
            } else {
                acc += soft_crc(x, y) as u64;
            }
        }
        acc += i as u64;
    }
    acc
}

fn main() {
    println(f"{work(12345, 7, 100)} {work(99, 3, 50)} {soft_crc(12345, 7)}");
}
