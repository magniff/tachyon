// 0.14, phase 0: `Fn(A) -> R` and `FnMut(A)` bounds parse and are reported
// as not implemented yet where an instance is made. (The closures task
// replaces this case with its own.)
// ERROR: 'Fn' and 'FnMut' bounds are not implemented yet (check.unimplemented)
// ERROR-COUNT: 1
fn apply<F: Fn(i64) -> i64, G: FnMut(i64, i64)>(f: F, g: G, x: i64) -> i64 {
    f(x)
}

fn twice(x: i64) -> i64 {
    x * 2
}

fn ignore(a: i64, b: i64) {}

fn main() -> i64 {
    apply(twice, ignore, 2)
}
