// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: field a still views v after b re-pointed
// ERROR: error[own.conflict]
struct W { a: [i64], b: [i64] }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    var u: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    u.push(1);
    var w = W { a: v.as_slice(), b: v.as_slice() };
    w.b = u.as_slice();
    for i in 0..100 { v.push(i); }
    println(w.a[0]);
    0
}
