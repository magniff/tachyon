// 0.17 (value semantics, T2): own.conflict, one per rule.
// FLAGS: --values=error
// ERROR: 'a' is borrowed mutably by '&mut a' and read by '&a' in the same call
// ERROR: the receiver 'rng' of 'rng.big(1 + rng.next() % 600)' is changed by its own argument 'rng.next()'
// ERROR: 'b' is read while 'r'
// ERROR: 'grow(&mut arr)' may change 'arr' while 'view'
// ERROR: 'grow(&mut arr)' may change what argument 'arr[..]'
struct Rng { s: i64 }

impl Rng {
    fn next(self: &mut Rng) -> i64 { self.s = self.s * 7 + 1; self.s }
    fn big(self: &mut Rng, k: i64) -> i64 { self.s + k }
}

fn add(to: &mut i64, from: &i64) { *to += *from; }
fn first(s: [i64]) -> i64 { s[0] }
fn grow(v: &mut [i64; 4]) -> i64 { (*v)[0] += 1; 0 }
fn sum(s: [i64], k: i64) -> i64 { s[0] + k }

fn main() {
    let mut a = 1;
    add(&mut a, &a);
    let mut rng = Rng { s: 1 };
    let x = rng.big(1 + rng.next() % 600);
    let mut b = 2;
    let r = &mut b;
    let c = b + 1;
    *r += 1;
    let mut arr = [1, 2, 3, 4];
    let view = arr[..];
    grow(&mut arr);
    let y = first(view);
    let z = sum(arr[..], grow(&mut arr));
    println(f"{a} {x} {c} {y} {z}");
}
