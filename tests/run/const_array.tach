// EXPECT: 2 3 5 7 11 sum 28
// EXPECT: 4 16 64
// EXPECT: 1.5 2.5
// 0.9: arrays of constants are constants.
use std::print_int;

const COUNT: i64 = 5;
const PRIMES: [i64; COUNT] = [2, 3, 5, 7, 11];
const BASE: i64 = 4;
const POWERS: [i64; 3] = [BASE, BASE * BASE, BASE * BASE * BASE];
const HALVES: [f64; 2] = [1.5, 2.5];
const GRID: [[u8; 2]; 2] = [[1, 2], [3, 4]];

fn main() -> i32 {
    let mut sum = 0;
    for p in PRIMES {
        print_int(p);
        print(" ");
        sum += p;
    }
    print("sum ");
    print_int(sum);
    println("");
    print_int(POWERS[0]);
    print(" ");
    print_int(POWERS[1]);
    print(" ");
    print_int(POWERS[2]);
    println("");
    println(if HALVES[0] == 1.5 && HALVES[1] == 2.5 { "1.5 2.5" } else { "wrong" });
    (GRID[1][1] - 4) as i32
}
