// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a closure that pushes to v, called while a slice of v is used
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var add = |x: i64| v.push(x);
    let sl = v.as_slice();
    for i in 0..100 { add(i); }
    println(sl[0]);
    0
}
