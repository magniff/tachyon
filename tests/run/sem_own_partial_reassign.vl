// sem-own: a field moved out, then assigned again: the new value is dropped
// with the struct, the old one by its taker; nothing twice.
// EXPECT: took 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
struct P { a: D, b: D }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    var p = P { a: mk(1, gpa), b: mk(2, gpa) };
    {
        let x = p.b;
        println(f"took {x.id}");
    }
    p.b = mk(3, gpa);
    println("end");
}
