// sem-own: `let (a, _) = t;` moves t.0; t.1 stays in t and is dropped at
// t's scope end, once.
// XFAIL: SOUNDNESS the `_` part of a destructured tuple is leaked
// EXPECT: a 1
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let t = (mk(1, gpa), mk(2, gpa));
    {
        let (a, _) = t;
        println(f"a {a.id}");
    }
    println("end");
}
