// a nested closure stores a captured view into a variable both capture; the owner dies first
// ERROR: [own.escape]: 'out' is used here, but 'v', which it views, was dropped
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    var out: Vec<[i64]> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(7);
        let s = v.as_slice();
        let f = |x: i64| { let g = |y: i64| out.push(s); g(x); };
        f(1);
    }
    println(f"{out[0][0]}");
}
