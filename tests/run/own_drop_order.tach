// 0.17 (value semantics, from tests/values-proto of the prototype): drops
// run at scope end in reverse order, on every exit (break, continue, `?`),
// a value moved into a callee is dropped there, a by-value parameter at
// its function's end, struct glue field by field.
// FLAGS: --values=error
// EXPECT: inner end
// EXPECT: drop 3
// EXPECT: consume 2
// EXPECT: drop 2
// EXPECT: drop 200
// EXPECT: drop 100
// EXPECT: drop 101
// EXPECT: drop 11
// EXPECT: drop 10
// EXPECT: early: end
// EXPECT: drop 11
// EXPECT: drop 10
// EXPECT: main end
// EXPECT: drop 4
// EXPECT: drop 5
// EXPECT: drop 1
struct Noisy { id: i64 }

impl Drop for Noisy {
    fn drop(self: &mut Noisy) { println(f"drop {self.id}"); }
}

struct Pair { a: Noisy, b: Noisy, n: i64 }

fn make(id: i64) -> Noisy { Noisy { id: id } }
fn consume(n: Noisy) { println(f"consume {n.id}"); }

fn early(flag: bool) -> Result<i64, i64> {
    let a = make(10);
    let b = make(11);
    if flag {
        let e: Result<i64, i64> = Err(1);
        let v = e?;
        return Ok(v);
    }
    println("early: end");
    Ok(0)
}

fn main() {
    let a = make(1);
    let b = make(2);
    {
        let c = make(3);
        println("inner end");
    }
    consume(b);
    let p = Pair { a: make(4), b: make(5), n: 0 };
    for i in 0..3 {
        let x = make(100 + i);
        if i == 1 {
            break;
        }
        let y = make(200 + i);
        if i == 0 {
            continue;
        }
    }
    let r = early(true);
    let r2 = early(false);
    println("main end");
}
