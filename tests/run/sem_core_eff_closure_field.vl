// A closure kept in a generic struct's field, called later.
// ERROR: 'quiet' is #[no_io], but it does io
struct Holder<F> { f: F }

impl<F: Fn(i64) -> i64> Holder<F> {
    fn call(self, x: i64) -> i64 { (self.f)(x) }
}

#[no_io]
fn quiet(x: i64) -> i64 {
    let h = Holder { f: |y: i64| { println("io"); y } };
    h.call(x)
}

fn main() -> i32 {
    println(quiet(3));
    0
}
