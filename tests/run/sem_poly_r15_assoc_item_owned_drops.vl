// an iterator whose Item is an owned R: each item dropped once, for loop and early break
// FLAGS: --check-alloc
// EXPECT: got 2
// EXPECT: drop 2
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: got 0
// EXPECT: drop 0
// EXPECT: g 4
// EXPECT: drop 4
// EXPECT: drop 3
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;

    fn next(inout self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        Some(R { id: self.n })
    }
}

fn main() {
    for r in Gen { n: 3 } { println(f"got {r.id}"); }
    for r in Gen { n: 5 } { if r.id == 3 { break; } println(f"g {r.id}"); }
    println("end");
}
