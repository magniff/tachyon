// EXPECT: one two three
// EXPECT: [a\b]
// EXPECT: 11
// 0.9: a backslash at the end of a line, in a string literal, continues
// it: the line break and the next line's leading whitespace are left out.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

fn main() -> i32 {
    let s = "one \
             two \
        three";
    println(s);
    println("[a\\b]");
    unsafe {
        printf(c"1\
                 1\n");
    }
    0
}
