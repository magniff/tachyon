// (0.25, the semantics fuzzer) An owned temporary lent to a let
// parameter, `peek(mk(1))`, is dropped at the end of the enclosing block,
// not of its statement as `volec guide` says ("any other owned temporary
// used without being moved ... is dropped at the end of its statement",
// 0.20); `mk(2).get()` and `mk(3).v` are dropped at the end of theirs.
// In a loop body the drop waits for the iteration's end.
// XFAIL: WRONG a temporary lent to a let parameter lives to the end of the block
// EXPECT: d1
// EXPECT: a 1
// EXPECT: d2
// EXPECT: b 2
// EXPECT: d3
// EXPECT: c 3
// EXPECT: d4
// EXPECT: in if
// EXPECT: d5
// EXPECT: loop 10
// EXPECT: d6
// EXPECT: loop 11
// EXPECT: end
// EXPECT: live 0

static var NEXT: i64 = 0;
static var LIVE: i64 = 0;
struct T { id: i64, v: i64 }
fn mk(v: i64) -> T { NEXT += 1; LIVE += 1; T { id: NEXT, v: v } }
impl Drop for T {
    fn drop(inout self) { LIVE -= 1; println(f"d{self.id}"); }
}
impl T { fn get(self) -> i64 { self.v } }
fn peek(t: T) -> i64 { t.v }

fn run() {
    let a = peek(mk(1));
    println(f"a {a}");
    let b = mk(2).get();
    println(f"b {b}");
    let c = mk(3).v;
    println(f"c {c}");
    if peek(mk(4)) > 0 { println("in if"); }
    for i in 0..2 { let z = peek(mk(10 + i)); println(f"loop {z}"); }
    println("end");
}

fn main() -> i32 {
    run();
    println(f"live {LIVE}");
    0
}
