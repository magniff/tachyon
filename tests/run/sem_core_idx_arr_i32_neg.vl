// A negative i32 index is sign-extended, not taken as a large unsigned one that wraps into range.
// EXIT: 101
// STDERR: index out of bounds: index -1, length 3
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3];
    let i: i32 = -1 + Z as i32;
    println(a[i]);
    println("not reached");
    0
}
