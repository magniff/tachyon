// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(o).unwrap()`; s grows while it is used
// ERROR: error[own.conflict]
fn f(o: Option<str>) -> Option<str> { let x = o?; Some(x) }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let o: Option<str> = Some(w);
    let r = f(o).unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
