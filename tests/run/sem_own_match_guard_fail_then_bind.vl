// sem-own: a guard that fails on the first arm, the next arm binds: dropped once.
// EXPECT: other 2
// EXPECT: drop 2
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
enum E { A(D), N }

fn main(gpa: Gpa) {
    let e = E::A(mk(2, gpa));
    match e { E::A(d) if d.id == 1 => eat(d), E::A(d) => println(f"other {d.id}"), E::N => {} }
    println("end");
}
