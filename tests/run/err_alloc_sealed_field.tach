        pub fn count(self: &Counter) -> i64 {
            self.count
        }
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.len = 2;
    v.ptr = 0 as *i64;
    let b = std::Buf::new_in(gpa);
    let k = b.bytes.len();
    let c = counter::Counter::new(1);
    let m = c.step + c.count;
