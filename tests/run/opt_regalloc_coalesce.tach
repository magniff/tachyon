// Coalescing: a loop-carried value keeps one register (its phi, its
// operands and the phis they flow into share it), so the loop has no
// moves on AArch64 (on x86-64, cmov overwrites its destination: one move
// remains, n being live until the test); a large constant used in a loop
// stays in a register. The parity test is a select (csinc, cmov).
// EXPECT: 837799 524
// ASM(aarch64-macos): lsr x
// ASM-NOT(aarch64-macos): mov x
// ASM(aarch64-macos): csinc
// ASM(aarch64-macos): b.ne
// ASM(x86_64-macos): shrq $1
// ASM(x86_64-macos): cmov
// ASM(x86_64-macos): jne
// ASM(x86_64-linux): shrq $1
// ASM(x86_64-linux): cmov
// ASM(x86_64-linux): jne
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn steps(start: u64) -> i64 {
    var n = start;
    var count = 0;
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count += 1;
    }
    count
}

fn main() -> i32 {
    var best = 0;
    var best_start: u64 = 1;
    for start in 1..1000000u64 {
        let s = steps(start);
        if s > best {
            best = s;
            best_start = start;
        }
    }
    unsafe { printf(c"%lu %ld\n", best_start, best); }
    0
}
