// XFAIL: SOUNDNESS a closure passes a captured Vec as &v to an inout [i64]: segfault at -O0, internal error at -O2
// a closure capturing v calls a function with &v as an inout slice
// EXPECT: 5
fn bump(s: inout [i64]) { s[0] += 5; }
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); v.push(0); let f = || { bump(&v); 0 }; f(); println(f"{v[0]}"); }
