// F: FnMut(sink R) given a closure taking sink R: each R dropped once
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: 3
// XFAIL: OVERSTRICT a closure parameter cannot be sink (conv.sink_type), so F: FnMut(sink R) cannot be met
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn feed<F: FnMut(sink R) -> i64>(f: sink F) -> i64 { f(R { id: 1 }) + f(R { id: 2 }) }
fn main() { println(f"{feed(|r: sink R| r.id)}"); }
