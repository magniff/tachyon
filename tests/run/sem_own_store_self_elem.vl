// (0.25) A store to an element, or through inout, drops the value it replaces.
// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
struct H { v: Vec<D> }
impl H { fn put(inout self) { self.v[0] = D { id: 2 }; } }

fn main(gpa: Gpa) {
    var h = H { v: Vec::new_in(gpa) }; h.v.push(D { id: 1 }); h.put(); println("after");
}
