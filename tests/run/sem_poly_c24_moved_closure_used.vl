// a sink closure owning an R, moved into another binding, then called through the old one: own.moved
// ERROR: [own.moved]: 'k' is used here after it moved
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

fn main() {
    let a = R { id: 1 };
    let k = sink || a.id;
    let k2 = k;
    println(f"{k()} {k2()}");
}
