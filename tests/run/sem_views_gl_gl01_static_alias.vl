// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject (passing a static the callee writes) or print 1: a is a let (immutable) parameter
// XFAIL: SOUNDNESS a borrowed let parameter aliases a static the callee writes (it reads 9)
// ERROR: error[own.static]
static var G: [i64; 4] = [1, 2, 3, 4];
fn f(a: [i64; 4]) -> [i64] { G[0] = 9; a[0..1] }

fn main() -> i32 {
    let s = f(G);
    println(s[0]);
    0
}
