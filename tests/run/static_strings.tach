// EXPECT: add: 2 operands
// EXPECT: neg: 1 operands
// EXPECT: nop: 0 operands
// EXPECT: hello world
// EXPECT: c strings: ab
// 0.9: a static array of structs holding string literals is constant (the
// addresses of the strings are relocated).
use std::print_int;

extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

struct Op { name: [u8], operands: i64, flag: bool }

static OPS: [Op; 3] = [
    Op { name: "add", operands: 2, flag: true },
    Op { name: "neg", operands: 1, flag: false },
    Op { operands: 0, name: "nop", flag: true },
];

static GREETING: ([u8], [u8]) = ("hello", "world");

struct Named { id: i64, text: *u8 }

static CS: [Named; 2] = [Named { id: 1, text: c"a" }, Named { id: 2, text: c"b" }];

fn main() -> i32 {
    for op in OPS {
        print(op.name);
        print(": ");
        print_int(op.operands);
        println(" operands");
    }
    print(GREETING.0);
    print(" ");
    println(GREETING.1);
    unsafe {
        printf(c"c strings: %s%s\n", CS[0].text, CS[1].text);
    }
    0
}
