// trait methods with each receiver: let reads, inout changes, sink consumes (dropped inside once)
// FLAGS: --check-alloc
// EXPECT: 2
// EXPECT: drop 2
// EXPECT: 20
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

trait T3 {
    fn get(self) -> i64;
    fn bump(inout self);
    fn eat(sink self) -> i64;
}

impl T3 for R {
    fn get(self) -> i64 { self.id }
    fn bump(inout self) { self.id += 1; }
    fn eat(sink self) -> i64 { self.id * 10 }
}

fn main() {
    var r = R { id: 1 };
    r.bump();
    println(f"{r.get()}");
    println(f"{r.eat()}");
    println("end");
}
