// All six comparisons on ordinary, equal and NaN operands, for f64 and f32.
// EXPECT: 101001
// EXPECT: 010101
// EXPECT: 001110
// EXPECT: 000001
// EXPECT: 000001
// EXPECT: 000001
// EXPECT: 101001
// EXPECT: 000001
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn row(a: bool, b: bool, c: bool, d: bool, e: bool, f: bool) {
    printf(c"%d%d%d%d%d%d\n", a, b, c, d, e, f);
}

fn main() -> i64 {
    let zero: f64 = 0.0;
    let nan = zero / zero;
    let x: f64 = 1.5;
    let y: f64 = 2.5;
    row(x < y, x > y, x <= y, x >= y, x == y, x != y);
    row(y < x, y > x, y <= x, y >= x, y == x, y != x);
    row(x < x, x > x, x <= x, x >= x, x == x, x != x);
    row(nan < x, nan > x, nan <= x, nan >= x, nan == x, nan != x);
    row(x < nan, x > nan, x <= nan, x >= nan, x == nan, x != nan);
    row(nan < nan, nan > nan, nan <= nan, nan >= nan, nan == nan, nan != nan);
    let p: f32 = (0.0 - 1.0) as f32;
    let q: f32 = 1.0;
    let z: f32 = 0.0;
    let n32 = z / z;
    row(p < q, p > q, p <= q, p >= q, p == q, p != q);
    row(n32 < q, n32 > q, n32 <= q, n32 >= q, n32 == q, n32 != q);
    0
}
