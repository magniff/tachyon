// (0.24) What err_own_iter_item_copy's code may do instead, under the leak
// checker: clone the items (`iter_ref().map(|x| x.clone())`, a closure
// given `w.iter()`'s items, which borrows them), push clones in a `for`
// loop, or read them (count, filter, any, map to a length).
// FLAGS: --check-alloc
// EXPECT: 2 2 2 1 true 7
use std::HashMap;

fn main(gpa: Gpa) {
    var w: Vec<Vec<i64>> = Vec::new_in(gpa);
    w.push(Vec::new_in(gpa));
    w.push(Vec::new_in(gpa));
    w[0].push(7);
    let a: Vec<Vec<i64>> = w.iter_ref().map(|x| x.clone()).collect_in(gpa);
    let b: Vec<Vec<i64>> = w.iter().map(|x| x.clone()).collect_in(gpa);
    var c: Vec<Vec<i64>> = Vec::new_in(gpa);
    for x in w.iter() {
        c.push(x.clone());
    }
    let n = w.iter().filter(|x| x.len() > 0).count();
    let any = w.iter().any(|x| x.len() == 1);
    var m: HashMap<i64, Vec<i64>> = HashMap::new_in(gpa);
    m.insert(1, a[0].clone());
    let total: i64 = m.values().map(|v| v[0]).fold(0, |s, k| s + k);
    println(f"{a.len()} {b.len()} {c.len()} {n} {any} {total}");
}
