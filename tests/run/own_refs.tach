// 0.17: references (docs/design/value-semantics.md §2.3). `&T` and `&mut
// T` parameters; `&x` and `&mut x`; a reference in a local is safe to read
// through; a `*T` parameter (the legacy rule: `&mut T`) takes `&x` and
// `&mut x`; `&mut [T]` from `&mut a[..]`, and `&s` where `[T]` is wanted;
// a reference converts to a raw `*T`.
// EXPECT: 24 24
// EXPECT: 2 22
// EXPECT: 19 19
// EXPECT: 19
// EXPECT: 5 5
// EXPECT: 3
struct P { x: i64, y: i64 }
fn bump(p: inout P) { p.x += 1; }
fn read(p: P) -> i64 { p.x + p.y }
fn legacy(p: inout P) { p.y += 10; }
fn total(s: [i64]) -> i64 { var t = 0; for x in s { t += x; } t }
fn fill(s: inout [i64], v: i64) { for i in 0..s.len { s[i] = v; } }
fn setn(out: inout i64, v: i64) { out = v; }
fn deep(p: **i64) -> i64 { unsafe { **p } }

fn main() {
    var p = P { x: 1, y: 2 };
    bump(&p);
    legacy(&p);
    legacy(&p);
    println(f"{read(p)} {read(p)}");
    let r = p;
    println(f"{r.x} {r.y}");
    var a = [1, 2, 3, 4];
    fill(&a[1..3], 7);
    println(f"{total(a[..])} {total(a[..])}");
    let s = a[..];
    println(f"{total(s)}");
    var n = 0;
    setn(&n, 5);
    let q: *i64 = &n;
    println(f"{n} {unsafe { *q }}");
    let three = 3;
    let r3 = &three as *i64;
    println(f"{deep(&r3)}");
}
