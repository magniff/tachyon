// (0.25) A let Vec is read-only: `&v` to an inout Vec or an inout slice,
// `&v[i]`, `v.as_mut_slice()`, `v.push(x)`, `v[i] = x`, `&a[..]` of a let
// array, and `m.get_mut(k)` on a let HashMap are own.readonly.
fn grow(v: inout Vec<i64>) { v.push(1); }
fn fill(s: inout [i64], x: i64) { for i in 0..s.len() { s[i] = x; } }
fn bump(n: inout i64) { n += 1; }

fn main(gpa: Gpa) {
    var w: Vec<i64> = Vec::new_in(gpa);
    w.push(1);
    let v = w;
    grow(&v);
    fill(&v, 0);
    bump(&v[0]);
    fill(v.as_mut_slice(), 0);
    v.push(2);
    v[0] = 3;
    let a = [1, 2, 3];
    fill(&a[..], 0);
    var h: HashMap<i64, i64> = HashMap::new_in(gpa);
    h.insert(1, 1);
    let m = h;
    if let Some(c) = m.get_mut(1) { c += 1; }
    println(f"{v[0]} {a[0]} {m.len()}");
}
// ERROR: '&v' changes 'v', a let binding
// ERROR: 'v.as_mut_slice()' changes 'v', a let binding
// ERROR: 'v.push(2)' changes 'v', a let binding
// ERROR: 'a[..]' changes 'a', a let binding
// ERROR: 'm.get_mut(1)' changes 'm', a let binding
