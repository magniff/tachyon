// 0.17: `p[i]` on a raw pointer (not a borrow: a `mut` parameter, a local,
// a field) to a Vec, a Buf or a slice stays pointer arithmetic. The error
// says so and names the element's spelling, `(*p)[i]`; it does not offer
// to wrap the arithmetic in `unsafe` (`fix --only unsafe`), which would
// compile to the wrong value.
// ERROR: indexing a raw pointer to 'Vec<i64>' is unsafe pointer arithmetic
// ERROR: try: (*st)[0]
// ERROR: slicing a raw pointer to 'Buf' is unsafe pointer arithmetic
// ERROR: try: (*b)[0..1]
// ERROR: indexing a raw pointer to '[i64]' is unsafe pointer arithmetic
// ERROR: try: (*s)[1]
// ERROR: indexing a raw pointer to 'Vec<i64>' is unsafe pointer arithmetic
// ERROR: try: (*p)[0]
// ERROR: indexing a raw pointer to 'Vec<i64>' is unsafe pointer arithmetic
// ERROR: try: (*h.vp)[0]
// ERROR-COUNT: 5
struct H { vp: *Vec<i64> }

fn top(mut st: *Vec<i64>) -> Vec<i64> { st[0] }

fn head(mut b: *Buf) -> [Buf] { b[0..1] }

fn second(mut s: *[i64]) -> [i64] { s[1] }

fn main(gpa: Gpa) -> i32 {
    let mut d: Vec<i64> = Vec::new_in(gpa);
    let p = &d;
    let v = p[0];
    let h = H { vp: &d };
    let w = h.vp[0];
    0
}
