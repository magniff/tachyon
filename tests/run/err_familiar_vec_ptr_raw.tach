// 0.17: `p[i]` on a raw pointer (not a borrow: a `mut` parameter, a local,
// a field) to a Vec, a Buf or a slice indexes the one it points to, as
// through a borrow, but reads through a raw pointer: unsafe. The try: is
// `fix --only unsafe` (wrapping it keeps its meaning), or, for a local
// `let p = &d;`, `d` indexed itself.
// ERROR: indexing a 'Vec<i64>' through a raw pointer is unsafe
// ERROR: help: `st` is a `mut` parameter, a raw pointer, not a borrow
// ERROR: fix --only unsafe
// ERROR: slicing a 'Buf' through a raw pointer is unsafe
// ERROR: fix --only unsafe
// ERROR: indexing a '[i64]' through a raw pointer is unsafe
// ERROR: fix --only unsafe
// ERROR: indexing a 'Vec<i64>' through a raw pointer is unsafe
// ERROR: try: d[0]
// ERROR: indexing a 'Vec<i64>' through a raw pointer is unsafe
// ERROR: try: d[1] = 5
// ERROR: indexing a 'Vec<i64>' through a raw pointer is unsafe
// ERROR: help: `h.vp` is a field, a raw pointer
// ERROR: fix --only unsafe
// ERROR-COUNT: 6
struct H { vp: *Vec<i64> }

fn top(mut st: *Vec<i64>) -> i64 { st[0] }

fn head(mut b: *Buf) -> [u8] { b[0..1] }

fn second(mut s: *[i64]) -> i64 { s[1] }

fn main(gpa: Gpa) -> i32 {
    let mut d: Vec<i64> = Vec::new_in(gpa);
    let p: *Vec<i64> = &d;
    let v = p[0];
    p[1] = 5;
    let h = H { vp: &d };
    let w = h.vp[0];
    0
}
