// (0.25) A part bound by a by-value match arm and moved on some paths only:
// in an arm, in a loop with break/continue, under guards. Each T is dropped
// once (LIVE is 0 after each group), at -O0 and -O2.
// EXPECT: arm 0
// EXPECT: loop 0
// EXPECT: guard 0
static var LIVE: i64 = 0;
struct T { id: i64 }
fn mk(id: i64) -> T { LIVE += 1; T { id: id } }
impl Drop for T { fn drop(inout self) { LIVE -= 1; } }
enum E { One(T), Two(T, T), Nada }
fn take(t: sink T) {}

fn in_arm(c: bool) {
    let e = E::Two(mk(1), mk(2));
    match e {
        E::Two(a, _) => { if c { take(a); } }
        _ => {}
    }
}

fn in_loop(n: i64) {
    var i = 0;
    while i < n {
        let e = E::Two(mk(1), mk(2));
        match e {
            E::Two(a, b) => {
                if i % 2 == 0 { take(b); i += 1; continue; }
                if i == 3 { take(a); break; }
            }
            E::One(t) => take(t),
            E::Nada => {}
        }
        i += 1;
    }
}

fn guarded(k: i64) {
    let e = E::Two(mk(1), mk(2));
    match e {
        E::Two(a, b) if k == 0 => { take(a); }
        E::Two(_, b) if k == 1 => { if b.id > 0 { take(b); } }
        E::One(t) => take(t),
        _ => {}
    }
}

fn main() -> i32 {
    in_arm(false); in_arm(true); println(f"arm {LIVE}");
    in_loop(1); in_loop(5); println(f"loop {LIVE}");
    guarded(0); guarded(1); guarded(2); println(f"guard {LIVE}");
    0
}
