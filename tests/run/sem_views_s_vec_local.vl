// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `v[0]`; s grows while it is used
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w);
    let r = v[0];
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
