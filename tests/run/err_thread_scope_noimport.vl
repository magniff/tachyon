// (0.22) A scope's spawned closures naming AtomicI64 and Ordering with no
// `use`: the missing imports, each with its `use` (the threads check walked
// an unresolved `Ordering::Relaxed` path's names as nodes, and overflowed
// the stack).
// ERROR: unknown type 'AtomicI64'
// ERROR: help: add `use std::sync::atomic::AtomicI64;`

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..1000 { v.push(i); }
    let total = AtomicI64::new(0);
    std::thread::scope(|s| {
        s.spawn(|| { for x in v.as_slice()[..500] { total.fetch_add(x, Ordering::Relaxed); } });
        s.spawn(|| { for x in v.as_slice()[500..] { total.fetch_add(x, Ordering::Relaxed); } });
    });
    println(f"{total.load(Ordering::SeqCst)}");
}
