// A heap-allocated linked list of structs built and walked through pointers.
// EXPECT: 385 10 100
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(n: u64) -> *u8;
}

struct Node { value: i64, next: *Node }

fn push(head: *Node, v: i64) -> *Node {
    let n = unsafe { malloc(16) as *Node };
    unsafe {
        (*n).value = v;
        (*n).next = head;
    }
    n
}

fn main() -> i64 {
    let null = 0 as *Node;
    var head = null;
    var i = 1;
    while i <= 10 {
        unsafe { head = push(head, i * i); }
        i += 1;
    }
    var sum = 0;
    var count = 0;
    var cur = head;
    while cur != null {
        unsafe { sum += (*cur).value; }
        count += 1;
        unsafe { cur = (*cur).next; }
    }
    unsafe { printf(c"%ld %ld %ld\n", sum, count, (*head).value); }
    0
}
