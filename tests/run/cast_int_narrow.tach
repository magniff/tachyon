// Narrowing keeps the low bits; the result is then read with the narrow
// type's signedness.
// EXPECT: 188 -68 39612 -25924 1450744508 1450744508
// EXPECT: 44 44
// EXPECT: 255 65535 4294967295
// EXPECT: -128 128 -2147483520
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let x: i64 = 0x123456789ABC;
    printf(c"%d %d %d %d %u %d\n", x as u8, x as i8, x as u16, x as i16, x as u32, x as i32);
    let y: i64 = 300;
    printf(c"%d %d\n", y as u8, y as i8);
    let m: i64 = 0 - 1;
    printf(c"%d %d %u\n", m as u8, m as u16, m as u32);
    let z: u32 = 0x80000080;
    printf(c"%d %d %d\n", z as i8, z as i16, z as i32);
    0
}
