// F: Fn(let i64) and F: Fn(i64) are one bound; a fn(i64) satisfies both
// FLAGS: --check-alloc
// EXPECT: 2 3 10 20
fn a<F: Fn(let i64) -> i64>(f: F) -> i64 { f(1) }
fn b<F: Fn(i64) -> i64>(f: F) -> i64 { f(2) }
fn inc(x: i64) -> i64 { x + 1 }
fn main() { println(f"{a(inc)} {b(inc)} {a(|x| x * 10)} {b(|x: let i64| x * 10)}"); }
