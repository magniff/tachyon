// for i in 0..n with n past the length stops at the length.
// EXIT: 101
// STDERR: index out of bounds: index 8, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64], n: i64) -> i64 { var t = 0; for i in 0..n { t += s[i]; } t }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s, 9 + Z));
    0
}
