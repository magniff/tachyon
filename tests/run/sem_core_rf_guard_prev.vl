// i < len does not make i - 1 in bounds (i == 0).
// EXIT: 101
// STDERR: index out of bounds: index -1, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64], i: i64) -> i64 { if i < s.len() { s[i - 1] } else { 0 } }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s, 0 + Z));
    0
}
