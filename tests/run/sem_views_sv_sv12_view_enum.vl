// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: enum holding a view
// ERROR: error[own.conflict]
enum T { S([i64]), N }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let t = T::S(v.as_slice());
    for i in 0..100 { v.push(i); }
    match t { T::S(x) => println(x[0]), T::N => println(0) }
    0
}
