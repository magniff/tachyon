// sem-own: an element moved out of an array call result by constant index: refused or the rest dropped.
// XFAIL: DIAG `ma(gpa)[1]` (an element of an array call result) is "cannot take address of non-lvalue expression", a C word, with a try: that does not fix it
// EXPECT: drop 1
// EXPECT: got 2
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn ma(gpa: Gpa) -> [D; 2] { [mk(1, gpa), mk(2, gpa)] }

fn main(gpa: Gpa) {
    let b = ma(gpa)[1];
    println(f"got {b.id}");
}
