// impl for [T] with inout self: reverse in place through a Vec's slice
// FLAGS: --check-alloc
// EXPECT: [3, 2, 1]
trait Rev { fn rev(inout self); }

impl<T> Rev for [T] {
    fn rev(inout self) {
        var i = 0;
        var j = self.len() - 1;
        while i < j { self.swap(i, j); i += 1; j -= 1; }
    }
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1); v.push(2); v.push(3);
    v.as_mut_slice().rev();
    println(f"{v:?}");
}
