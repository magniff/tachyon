// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a function returning the file name of a DirEntry it created
// ERROR: error[own.escape]
use std::fs;
use std::path::Path;

fn first() -> Path {
    for e in fs::read_dir(".").unwrap() {
        let e = e.unwrap();
        return e.file_name();
    }
    Path::new("")
}

fn main() -> i32 {
    println(first().len() > 0);
    0
}
