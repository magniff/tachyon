// (0.25) FixedBuf::new(&mem[..]): the allocator holds mem inout; mem is
// used again once the containers on it are done, and containers used one
// after the other share one buffer.
use std::FixedBuf;

fn main() {
    var mem = [0u8; 256];
    let fb = FixedBuf::new(&mem[..]);
    var v: Vec<i64, FixedBuf> = Vec::new_in(fb);
    v.push(7);
    v.push(8);
    println(f"{v[0] + v[1]} {fb.used()}");
    v.free();
    var w: Vec<u8, FixedBuf> = Vec::new_in(fb);
    w.push(1);
    println(f"{w.len()}");
    var other = [0u8; 64];
    var t: Vec<u8, FixedBuf> = Vec::new_in(FixedBuf::new(&other[..]));
    t.push(2);
    println(f"{t[0] + w[0]}");
    println(f"{mem[0] + other[0]}");
}
// EXPECT: 15 32
// EXPECT: 1
// EXPECT: 3
// EXPECT: 8
