// Boolean operators and comparisons of booleans.
// EXPECT: 0 1 0 1
// EXPECT: 0 1 1 1
// EXPECT: 10
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let t = true;
    let f = false;
    printf("%d %d %d %d\n".0, !t, !f, t == f, t != f);
    printf("%d %d %d %d\n".0, t && f, t || f, !(t && f) == (!t || !f), f == false);
    let k = 0;
    let n = 0;
    loop {
        if k == 16 { break; };
        let a = (k & 1) != 0;
        let b = (k & 2) != 0;
        let c = (k & 4) != 0;
        let d = (k & 8) != 0;
        if (a && b || c && !d) != ((a && b) || (c && (!d))) { n += 100; };
        if a || b && c { n += 1; };
        k += 1;
    }
    printf("%ld\n".0, n);
    0
}
