// Boolean operators and comparisons of booleans.
// EXPECT: 0 1 0 1
// EXPECT: 0 1 1 1
// EXPECT: 10
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let t = true;
    let f = false;
    printf(c"%d %d %d %d\n", !t, !f, t == f, t != f);
    printf(c"%d %d %d %d\n", t && f, t || f, !(t && f) == (!t || !f), f == false);
    let mut k = 0;
    let mut n = 0;
    while k != 16 {
        let a = (k & 1) != 0;
        let b = (k & 2) != 0;
        let c = (k & 4) != 0;
        let d = (k & 8) != 0;
        if (a && b || c && !d) != ((a && b) || (c && (!d))) { n += 100; }
        if a || b && c { n += 1; }
        k += 1;
    }
    printf(c"%ld\n", n);
    0
}
