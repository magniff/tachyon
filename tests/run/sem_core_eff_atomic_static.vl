// An atomic in a static (no var) has no `global`: a #[pure] function may
// change it (it is not a static var). Documented: guide threads.
// EXPECT: 0 1 242
use std::sync::atomic::{AtomicI64, Ordering};

static C: AtomicI64 = AtomicI64 { v: 0 };

#[pure]
fn tick() -> i64 { C.fetch_add(1, Ordering::Relaxed) }

fn main() -> i32 {
    let a = tick();
    let b = tick();
    println(f"{a} {b} {twice()}");
    0
}

#[pure]
fn peek() -> i64 { C.load(Ordering::Relaxed) }

#[inline(never)]
fn twice() -> i64 {
    let x = peek();
    tick();
    let y = peek();
    var t = 0;
    for _ in 0..3 { t += peek(); tick(); }
    x * 100 + y * 10 + t
}
