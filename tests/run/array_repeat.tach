// `[v; n]` fills every element and evaluates `v` once.
// EXPECT: 7 7 10 10 1 3000
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn next(c: *i64) -> i64 {
    *c = *c + 1;
    *c * 10
}

fn main() -> i64 {
    let a: [i32; 6] = [7; 6];
    let c: i64 = 0;
    let b: [i64; 4] = [next(&c); 4];
    let big: [u8; 1000] = [3; 1000];
    let mut i = 0;
    let mut s: u64 = 0;
    while i != 1000 {
        s += big[i] as u64;
        i += 1;
    }
    unsafe { printf(c"%d %d %ld %ld %ld %lu\n", a[0], a[5], b[0], b[3], c, s); }
    0
}
