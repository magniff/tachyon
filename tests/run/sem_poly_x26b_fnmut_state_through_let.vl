// a sink closure's own state changed through a let parameter: the caller's closure must not change
// (0.25) Calling an FnMut needs inout access to the closure: a let
// parameter is read-only, so `f: inout F` or `f: sink F`.
// ERROR: [own.readonly]: 'f()' changes 'f', a let parameter
// ERROR: try: f: inout F
fn run<F: FnMut() -> i64>(f: F) -> i64 { f() + f() }

fn main() {
    var k = 0;
    var c = sink || { k += 1; k };
    let a = run(c);
    let b = c();
    println(f"{a} {b} {k}");
}
