// a sink closure's own state changed through a let parameter: the caller's closure must not change
// FLAGS: --check-alloc
// EXPECT: 3 1 0
fn run<F: FnMut() -> i64>(f: F) -> i64 { f() + f() }

fn main() {
    var k = 0;
    var c = sink || { k += 1; k };
    let a = run(c);
    let b = c();
    println(f"{a} {b} {k}");
}
