// Condvar::wait_then's closure returns a view of the locked data
// ERROR: [own.escape]: the closure's result views 'd', the data 'wait_then' locks
use std::sync::{Condvar, Mutex};

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let c = Condvar::new();
    let s = c.wait_then(m, |d| d.len() > 0, |d| d.as_slice());
    println(f"{s[0]}");
}
