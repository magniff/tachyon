// Condvar::wait_then's closure returns a view of the locked data
// ERROR: [sync.view_item]: the closure given to the lock returns [i64], a view
use std::sync::{Condvar, Mutex};

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let c = Condvar::new();
    let s = c.wait_then(m, |d| d.len() > 0, |d| d.as_slice());
    println(f"{s[0]}");
}
