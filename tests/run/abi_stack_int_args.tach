// More than 6 integer arguments: the rest go on the stack. Called in a
// loop so that unpopped stack arguments would blow the stack.
// EXPECT: 204
// EXPECT: 2000000
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn weighted(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h
}

fn main() -> i64 {
    printf(c"%ld\n", weighted(1, 2, 3, 4, 5, 6, 7, 8));
    let mut i: i64 = 0;
    let mut count: i64 = 0;
    while i < 2000000 {
        if weighted(0, 0, 0, 0, 0, 0, 1, 0) == 7 { count += 1; }
        i += 1;
    }
    printf(c"%ld\n", count);
    0
}
