// no block: the view comes back through a generic closure call, then the Vec is changed
// ERROR: [own.conflict]
fn apply<T, R, F: Fn(T) -> R>(x: T, f: F) -> R { f(x) }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = apply(v, |d: Vec<i64>| d.as_slice());
    for i in 0..1000 { v.push(i); }
    println(f"{s[0]}");
}
