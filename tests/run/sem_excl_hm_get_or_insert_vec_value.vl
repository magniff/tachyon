// XFAIL: OVERSTRICT HashMap<K, Vec<T>>::get_or_insert does not instantiate (std's p[0..1] on *V)
// a map of lists: get_or_insert with an owned value type
// EXPECT: 2
fn main(gpa: Gpa) {
    var m: HashMap<i64, Vec<i64>> = HashMap::new_in(gpa);
    m.get_or_insert(1, Vec::new_in(gpa))[0].push(5);
    m.get_or_insert(1, Vec::new_in(gpa))[0].push(6); println(f"{m.get(1).unwrap().len()}");
}
