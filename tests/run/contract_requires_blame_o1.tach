// (0.18) A requires is checked at the call, after the arguments are
// evaluated (once), and its failure names the call's line (the line to
// change), the condition, its values and the clause's function.
// FLAGS: -O1
// EXIT: 101
// EXPECT: 20
// EXPECT: 1
// STDERR: contract_requires_blame_o1.tach:34:9: requires failed: 'i < s.len()' of 'get' (
// STDERR: contract_requires_blame_o1.tach:13:5): i = 4, s.len() = 3

fn get(s: [i64], i: i64) -> i64
    requires 0 <= i
    requires i < s.len()
{
    s[i]
}

static mut CALLS: i64 = 0;

fn next(i: i64) -> i64 {
    unsafe { CALLS += 1; }
    i
}

fn main() -> i32 {
    let a = [10, 20, 30];
    std::print_int(get(a[..], next(1)));
    println("");
    // the argument is evaluated once
    unsafe { std::print_int(CALLS); }
    println("");
    let k = 4;
    let x =
        get(a[..], k);
    std::print_int(x);
    0
}
