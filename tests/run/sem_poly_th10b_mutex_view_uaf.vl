// a view of a Mutex's data returned out of with, the Mutex dropped at the block's end
// ERROR: [sync.view_item]
use std::sync::Mutex;

fn main(gpa: Gpa) {
    let s = {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        let m = Mutex::new(v);
        m.with(|d| d.as_slice())
    };
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..100 { w.push(i); }
    println(f"{s[5]} {w[5]}");
}
