// sem-own: an if expression choosing between two owned locals: the other dropped at its scope end.
// EXPECT: got 1
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    {
        let c = true;
        let d = if c { a } else { b };
        println(f"got {d.id}");
        println("end");
    }
}
