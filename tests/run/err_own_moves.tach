// 0.17 (value semantics, T1): the move rules under --values=error, one per
// code: a Drop impl on a view type (own.drop_view), a move out of a
// reference (own.move_out), a use after a move on some paths (own.moved),
// a field moved out of a Drop type (own.partial), a binding of a match
// through a reference and a `for` loop's element moved (own.move_out).
// FLAGS: --values=error
// ERROR: [own.drop_view]: 'View' holds views and cannot implement Drop
// ERROR: [own.move_out]: cannot move 'b.inner' (Noisy) out of a reference
// ERROR: [own.move_out]: cannot move 'arr[0]' (Noisy) out of an index
// ERROR: [own.moved]: 'n.id' is used here after 'n' may have moved at 46:20 (on some paths)
// ERROR: [own.partial]: cannot move 'p.a' out of 'p': 'Pair' implements Drop
// ERROR: the match on '*s' (56:11) binds it by reference
// ERROR: it is a loop's element, which the loop borrows
// ERROR-COUNT: 7
struct Noisy { id: i64 }

impl Drop for Noisy {
    fn drop(self: &mut Noisy) { println(f"drop {self.id}"); }
}

struct Pair { a: Noisy, b: Noisy }

impl Drop for Pair {
    fn drop(self: &mut Pair) {}
}

struct Box2 { inner: Noisy, n: i64 }
enum Slot { Full(Noisy), Empty }
struct View { text: [u8] }

impl Drop for View {
    fn drop(self: &mut View) {}
}

fn consume(n: Noisy) {}
fn make(id: i64) -> Noisy { Noisy { id: id } }
fn take_out(b: &mut Box2) -> Noisy { b.inner }

fn first(arr: [Noisy; 2]) -> i64 {
    let x = arr[0];
    x.id
}

fn maybe(c: bool) {
    let n = make(1);
    if c { consume(n); }
    println(f"{n.id}");
}

fn partial() {
    let p = Pair { a: make(1), b: make(2) };
    let a = p.a;
}

fn by_ref(s: &Slot) {
    match *s {
        Slot::Full(n) => consume(n),
        Slot::Empty => {}
    }
}

fn main() {
    let arr = [make(1), make(2)];
    for x in arr { consume(x); }
}
