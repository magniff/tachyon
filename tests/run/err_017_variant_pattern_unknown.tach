// 0.17: an unknown field in a variant's pattern; a field matched twice.
// ERROR: no field 'cod' in variant 'Ev::Key'
// ERROR: help: did you mean 'code'?
enum Ev { Key { code: i64, shift: bool }, Quit }

fn code(e: Ev) -> i64 {
    match e { Ev::Key { cod, .. } => cod, Ev::Quit => 0 }
}

fn main() -> i32 { 0 }
