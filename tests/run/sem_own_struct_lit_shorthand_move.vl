// sem-own: a struct literal shorthand field moves the local: dropped once, by the struct.
// EXPECT: in 1
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct P { a: D }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    {
        let p = P { a };
        println(f"in {p.a.id}");
    }
    println("end");
}
