// (0.25) Owned temporaries given to let parameters, of functions, methods
// and generic functions, and `x?` given to one, are dropped at the end of
// their statement, the last made first (they were dropped at the end of
// the block); inside an expression too (`peek(mk(1)) + peek(mk(2))`
// needed a name first).
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: n 3
// EXPECT: 7
// EXPECT: drop 4
// EXPECT: drop 3
// EXPECT: 11
// EXPECT: drop 5
// EXPECT: 1
// EXPECT: drop 6
// EXPECT: drop 9
// EXPECT: q 9
// EXPECT: in
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn add(a: D, b: D) -> i64 { a.v[0] + b.v[0] }
fn peek(d: D) -> i64 { d.v[0] }
struct H { k: i64 }
impl H { fn f(self, d: D) -> i64 { d.v[0] + self.k } }
fn gl<T>(x: T) -> i64 { 1 }
fn g(gpa: Gpa) -> Result<D, i64> { Ok(mk(9, gpa)) }
fn q(gpa: Gpa) -> Result<i64, i64> { Ok(peek(g(gpa)?)) }

fn main(gpa: Gpa) {
    {
        let n = add(mk(1, gpa), mk(2, gpa));
        println(f"n {n}");
        println(f"{peek(mk(3, gpa)) + peek(mk(4, gpa))}");
        let h = H { k: 6 };
        println(f"{h.f(mk(5, gpa))}");
        println(f"{gl(mk(6, gpa))}");
        let r = q(gpa).unwrap();
        println(f"q {r}");
        println("in");
    }
    println("end");
}
