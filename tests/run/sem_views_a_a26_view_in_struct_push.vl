// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: struct holding a slice of v, then push
// ERROR: error[own.conflict]
struct W { s: [i64] }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let w = W { s: v.as_slice() };
    v.push(2);
    println(w.s[0]);
    0
}
