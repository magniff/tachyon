// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view stored through inout, then push
// ERROR: error[own.conflict]
struct W { s: [i64] }
fn set(w: inout W, v: Vec<i64>) { w.s = v.as_slice(); }
fn main(gpa: Gpa) -> i32 {
    let u: Vec<i64> = Vec::new_in(gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var w = W { s: u.as_slice() };
    set(&w, v);
    v.push(2);
    println(w.s[0]);
    0
}
