// A guarded index of an array field.
// FLAGS: -O2
// EXPECT: 0
static var Z: i64 = 0;

struct S { a: [i64; 3], n: i64 }

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    let s = S { a: [1, 2, 3], n: 0 };
    var t = 0;
    var k = 0;
    while k < 5 + Z { if k > 100 { t += s.a[i]; } k += 1; }
    println(t);
    0
}
