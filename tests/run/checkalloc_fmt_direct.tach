// FLAGS: --check-alloc
// EXPECT: 7! [7]
// STDERR: check-alloc: 2 blocks of Gpa not freed
// STDERR: allocated at
// STDERR: checkalloc_fmt_direct.tach:16:13
// STDERR: allocated at
// STDERR: checkalloc_fmt_direct.tach:18:5
// (0.17) The allocation sites of format_in and push_fmt with their
// f-string written in place (fmt_direct) are the calls', as when std's
// functions were called.
use std::{Buf, Gpa, format_in, println};

fn main(gpa: Gpa) {
    let n = 7;
    var b: Buf<Gpa> = Buf::new_in(gpa);
    let t = format_in(f"{n}!", gpa);
    // (no room: it grows)
    b.push_fmt(f"[{n}]");
    println(f"{t.as_slice()} {b.as_slice()}");
    // (0.17: both would drop; forgotten, they leak and show their sites)
    forget(t);
    forget(b);
}
