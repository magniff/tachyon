// CSOURCE: tests/c/sys_layout.c
// EXPECT: checked 106 mismatches 0
// 0.20 (A7): the layouts and constants std's OS layer writes by hand
// (compiler/std/sys/unix.vl, and the target's sys/macos.vl or
// sys/linux.vl) against the system's headers (tests/c/sys_layout.c,
// compiled by cc): struct stat, dirent, timespec, winsize, pollfd, the
// room for termios and posix_spawn_file_actions_t, and every flag, errno,
// clock, signal, ioctl and file-type value. A mismatch prints its name.
use std::sys::{
    DirentLinux, DirentMacos, SYS_CLOCK_MONOTONIC, SYS_CLOCK_REALTIME, SYS_DT_BLK, SYS_DT_CHR,
    SYS_DT_DIR, SYS_DT_FIFO, SYS_DT_LNK, SYS_DT_REG, SYS_DT_SOCK, SYS_DT_UNKNOWN, SYS_EACCES,
    SYS_EAGAIN, SYS_EBADF, SYS_ECHILD, SYS_EEXIST, SYS_EINTR, SYS_EINVAL, SYS_EIO, SYS_EISDIR,
    SYS_ELOOP, SYS_ENAMETOOLONG, SYS_ENOENT, SYS_ENOMEM, SYS_ENOSPC, SYS_ENOSYS, SYS_ENOTDIR,
    SYS_ENOTEMPTY, SYS_ENOTSUP, SYS_EPERM, SYS_EPIPE, SYS_EROFS, SYS_ESRCH, SYS_ETIMEDOUT,
    SYS_EXDEV, SYS_O_APPEND, SYS_O_CLOEXEC, SYS_O_CREAT, SYS_O_DIRECTORY, SYS_O_EXCL, SYS_O_NOCTTY,
    SYS_O_NONBLOCK, SYS_O_RDONLY, SYS_O_RDWR, SYS_O_TRUNC, SYS_O_WRONLY, SYS_PATH_MAX, SYS_POLLERR,
    SYS_POLLHUP, SYS_POLLIN, SYS_POLLNVAL, SYS_POLLOUT, SYS_POLLPRI, SYS_SEEK_CUR, SYS_SEEK_END,
    SYS_SEEK_SET, SYS_SIGCHLD, SYS_SIGHUP, SYS_SIGINT, SYS_SIGKILL, SYS_SIGTERM, SYS_S_IFDIR,
    SYS_S_IFLNK, SYS_S_IFMT, SYS_S_IFREG, SYS_TIOCGWINSZ, SYS_TIOCSCTTY, SYS_TIOCSWINSZ, StatLinux,
    StatMacos, SysPollFd, SysSpawnActions, SysTermios, SysTimespec, SysWinsize, TARGET_OS,
};

extern "C" {
    fn sys_layout_c(key: *u8) -> i64;
}

struct Check {
    count: i64,
    bad: i64,
}

impl Check {
    fn eq(inout self, key: *u8, ours: i64) {
        self.count += 1;
        let theirs = unsafe { sys_layout_c(key) };
        if theirs != ours {
            self.bad += 1;
            let name = unsafe { std::sys::sys_cstr_view(key) };
            println(f"mismatch {name}: ours {ours}, the headers' {theirs}");
        }
    }

    // ours is room for C's type: at least its size.
    fn room(inout self, key: *u8, ours: i64) {
        self.count += 1;
        let theirs = unsafe { sys_layout_c(key) };
        if theirs > ours {
            self.bad += 1;
            let name = unsafe { std::sys::sys_cstr_view(key) };
            println(f"too small {name}: ours {ours}, the headers' {theirs}");
        }
    }
}

// The byte offset of a field: its address in a zeroed buffer.
fn off(base: *u8, field: *u8) -> i64 {
    field as i64 - base as i64
}

fn main() -> i32 {
    var c = Check { count: 0, bad: 0 };
    let buf = [0u64; 160];
    let b = &buf as *u8;
    unsafe {
        if TARGET_OS == 1 {
            let s = b as *StatLinux;
            c.eq(c"sizeof stat", size_of(StatLinux));
            c.eq(c"stat.st_dev", off(b, &s.st_dev as *u8));
            c.eq(c"stat.st_ino", off(b, &s.st_ino as *u8));
            c.eq(c"stat.st_mode", off(b, &s.st_mode as *u8));
            c.eq(c"stat.st_nlink", off(b, &s.st_nlink as *u8));
            c.eq(c"stat.st_uid", off(b, &s.st_uid as *u8));
            c.eq(c"stat.st_gid", off(b, &s.st_gid as *u8));
            c.eq(c"stat.st_rdev", off(b, &s.st_rdev as *u8));
            c.eq(c"stat.st_size", off(b, &s.st_size as *u8));
            c.eq(c"stat.st_blocks", off(b, &s.st_blocks as *u8));
            c.eq(c"stat.st_blksize", off(b, &s.st_blksize as *u8));
            c.eq(c"stat.st_atime", off(b, &s.st_atime as *u8));
            c.eq(c"stat.st_mtime", off(b, &s.st_mtime as *u8));
            c.eq(c"stat.st_ctime", off(b, &s.st_ctime as *u8));
            c.eq(c"sizeof stat.st_mode", size_of(u32));
            c.eq(c"sizeof stat.st_nlink", size_of(u32));
            c.eq(c"sizeof stat.st_dev", size_of(u64));
            c.eq(c"sizeof stat.st_blksize", size_of(i32));
            let d = b as *DirentLinux;
            c.eq(c"dirent.d_ino", off(b, &d.d_ino as *u8));
            c.eq(c"dirent.d_type", off(b, &d.d_type as *u8));
            c.eq(c"dirent.d_name", off(b, &d.d_name as *u8));
            c.eq(c"sizeof dirent.d_name", 256);
        } else {
            let s = b as *StatMacos;
            c.eq(c"sizeof stat", size_of(StatMacos));
            c.eq(c"stat.st_dev", off(b, &s.st_dev as *u8));
            c.eq(c"stat.st_ino", off(b, &s.st_ino as *u8));
            c.eq(c"stat.st_mode", off(b, &s.st_mode as *u8));
            c.eq(c"stat.st_nlink", off(b, &s.st_nlink as *u8));
            c.eq(c"stat.st_uid", off(b, &s.st_uid as *u8));
            c.eq(c"stat.st_gid", off(b, &s.st_gid as *u8));
            c.eq(c"stat.st_rdev", off(b, &s.st_rdev as *u8));
            c.eq(c"stat.st_size", off(b, &s.st_size as *u8));
            c.eq(c"stat.st_blocks", off(b, &s.st_blocks as *u8));
            c.eq(c"stat.st_blksize", off(b, &s.st_blksize as *u8));
            c.eq(c"stat.st_atime", off(b, &s.st_atime as *u8));
            c.eq(c"stat.st_mtime", off(b, &s.st_mtime as *u8));
            c.eq(c"stat.st_ctime", off(b, &s.st_ctime as *u8));
            c.eq(c"sizeof stat.st_mode", size_of(u16));
            c.eq(c"sizeof stat.st_nlink", size_of(u16));
            c.eq(c"sizeof stat.st_dev", size_of(i32));
            c.eq(c"sizeof stat.st_blksize", size_of(i32));
            let d = b as *DirentMacos;
            c.eq(c"dirent.d_ino", off(b, &d.d_ino as *u8));
            c.eq(c"dirent.d_type", off(b, &d.d_type as *u8));
            c.eq(c"dirent.d_name", off(b, &d.d_name as *u8));
            c.eq(c"sizeof dirent.d_name", 1024);
        }
        let t = b as *SysTimespec;
        c.eq(c"sizeof timespec", size_of(SysTimespec));
        c.eq(c"timespec.tv_nsec", off(b, &t.tv_nsec as *u8));
        let w = b as *SysWinsize;
        c.eq(c"sizeof winsize", size_of(SysWinsize));
        c.eq(c"winsize.ws_col", off(b, &w.ws_col as *u8));
        c.eq(c"winsize.ws_ypixel", off(b, &w.ws_ypixel as *u8));
        let p = b as *SysPollFd;
        c.eq(c"sizeof pollfd", size_of(SysPollFd));
        c.eq(c"pollfd.events", off(b, &p.events as *u8));
        c.eq(c"pollfd.revents", off(b, &p.revents as *u8));
        c.room(c"sizeof termios", size_of(SysTermios));
        c.room(c"sizeof posix_spawn_file_actions_t", size_of(SysSpawnActions) - 8);
        c.eq(c"O_RDONLY", SYS_O_RDONLY as i64);
        c.eq(c"O_WRONLY", SYS_O_WRONLY as i64);
        c.eq(c"O_RDWR", SYS_O_RDWR as i64);
        c.eq(c"O_CREAT", SYS_O_CREAT as i64);
        c.eq(c"O_TRUNC", SYS_O_TRUNC as i64);
        c.eq(c"O_APPEND", SYS_O_APPEND as i64);
        c.eq(c"O_EXCL", SYS_O_EXCL as i64);
        c.eq(c"O_NONBLOCK", SYS_O_NONBLOCK as i64);
        c.eq(c"O_CLOEXEC", SYS_O_CLOEXEC as i64);
        c.eq(c"O_NOCTTY", SYS_O_NOCTTY as i64);
        c.eq(c"O_DIRECTORY", SYS_O_DIRECTORY as i64);
        c.eq(c"F_GETFD", 1);
        c.eq(c"F_SETFD", 2);
        c.eq(c"F_GETFL", 3);
        c.eq(c"F_SETFL", 4);
        c.eq(c"FD_CLOEXEC", 1);
        c.eq(c"SEEK_SET", SYS_SEEK_SET as i64);
        c.eq(c"SEEK_CUR", SYS_SEEK_CUR as i64);
        c.eq(c"SEEK_END", SYS_SEEK_END as i64);
        c.eq(c"EPERM", SYS_EPERM as i64);
        c.eq(c"ENOENT", SYS_ENOENT as i64);
        c.eq(c"ESRCH", SYS_ESRCH as i64);
        c.eq(c"EINTR", SYS_EINTR as i64);
        c.eq(c"EIO", SYS_EIO as i64);
        c.eq(c"EBADF", SYS_EBADF as i64);
        c.eq(c"ECHILD", SYS_ECHILD as i64);
        c.eq(c"ENOMEM", SYS_ENOMEM as i64);
        c.eq(c"EACCES", SYS_EACCES as i64);
        c.eq(c"EEXIST", SYS_EEXIST as i64);
        c.eq(c"EXDEV", SYS_EXDEV as i64);
        c.eq(c"ENOTDIR", SYS_ENOTDIR as i64);
        c.eq(c"EISDIR", SYS_EISDIR as i64);
        c.eq(c"EINVAL", SYS_EINVAL as i64);
        c.eq(c"ENOSPC", SYS_ENOSPC as i64);
        c.eq(c"EROFS", SYS_EROFS as i64);
        c.eq(c"EPIPE", SYS_EPIPE as i64);
        c.eq(c"EAGAIN", SYS_EAGAIN as i64);
        c.eq(c"ENOTEMPTY", SYS_ENOTEMPTY as i64);
        c.eq(c"ETIMEDOUT", SYS_ETIMEDOUT as i64);
        c.eq(c"ENOSYS", SYS_ENOSYS as i64);
        c.eq(c"ENOTSUP", SYS_ENOTSUP as i64);
        c.eq(c"ENAMETOOLONG", SYS_ENAMETOOLONG as i64);
        c.eq(c"ELOOP", SYS_ELOOP as i64);
        c.eq(c"CLOCK_REALTIME", SYS_CLOCK_REALTIME as i64);
        c.eq(c"CLOCK_MONOTONIC", SYS_CLOCK_MONOTONIC as i64);
        c.eq(c"PATH_MAX", SYS_PATH_MAX);
        c.eq(c"SIGHUP", SYS_SIGHUP as i64);
        c.eq(c"SIGINT", SYS_SIGINT as i64);
        c.eq(c"SIGKILL", SYS_SIGKILL as i64);
        c.eq(c"SIGTERM", SYS_SIGTERM as i64);
        c.eq(c"SIGCHLD", SYS_SIGCHLD as i64);
        c.eq(c"WNOHANG", 1);
        c.eq(c"TIOCSWINSZ", SYS_TIOCSWINSZ as i64);
        c.eq(c"TIOCGWINSZ", SYS_TIOCGWINSZ as i64);
        c.eq(c"TIOCSCTTY", SYS_TIOCSCTTY as i64);
        c.eq(c"TCSANOW", 0);
        c.eq(c"POLLIN", SYS_POLLIN as i64);
        c.eq(c"POLLPRI", SYS_POLLPRI as i64);
        c.eq(c"POLLOUT", SYS_POLLOUT as i64);
        c.eq(c"POLLERR", SYS_POLLERR as i64);
        c.eq(c"POLLHUP", SYS_POLLHUP as i64);
        c.eq(c"POLLNVAL", SYS_POLLNVAL as i64);
        c.eq(c"DT_UNKNOWN", SYS_DT_UNKNOWN as i64);
        c.eq(c"DT_FIFO", SYS_DT_FIFO as i64);
        c.eq(c"DT_CHR", SYS_DT_CHR as i64);
        c.eq(c"DT_DIR", SYS_DT_DIR as i64);
        c.eq(c"DT_BLK", SYS_DT_BLK as i64);
        c.eq(c"DT_REG", SYS_DT_REG as i64);
        c.eq(c"DT_LNK", SYS_DT_LNK as i64);
        c.eq(c"DT_SOCK", SYS_DT_SOCK as i64);
        c.eq(c"S_IFMT", SYS_S_IFMT as i64);
        c.eq(c"S_IFDIR", SYS_S_IFDIR as i64);
        c.eq(c"S_IFREG", SYS_S_IFREG as i64);
        c.eq(c"S_IFLNK", SYS_S_IFLNK as i64);
    }
    println(f"checked {c.count} mismatches {c.bad}");
    0
}
