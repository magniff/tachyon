// A value read before an inout call is re-read after it.
// EXPECT: 1 2 1 2 1 42 2 7 2 50
static var Z: i64 = 0;

#[inline(never)]
fn bump(v: inout Vec<i64>) { v[0] += 1; v.push(9); }
#[inline(never)]
fn set(x: inout i64) { x = 42; }
struct P { a: i64, b: i64 }
#[inline(never)]
fn setb(p: inout P) { p.b = 7; }

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1 + Z);
    let a = v[0];
    let l1 = v.len();
    bump(&v);
    let b = v[0];
    let l2 = v.len();
    var x = 1 + Z;
    let x1 = x;
    set(&x);
    var p = P { a: 1, b: 2 };
    let pb = p.b;
    setb(&p);
    var arr = [1, 2, 3];
    let s = arr[1];
    inout r = &arr;
    r[1] = 50;
    println(f"{a} {b} {l1} {l2} {x1} {x} {pb} {p.b} {s} {arr[1]}");
    0
}
