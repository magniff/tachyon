// sem-own: a match guard reads the binding; the arm moves it: dropped once.
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
enum E { A(D), N }

fn main(gpa: Gpa) {
    let e = E::A(mk(1, gpa));
    match e { E::A(d) if d.id == 1 => eat(d), E::A(d) => println("other"), E::N => {} }
    println("end");
}
