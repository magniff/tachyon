// (0.22) `f(x?)`: the value `?` makes, given to a let parameter, lives
// through the call (a temporary of the statement, dropped after it), for a
// method's argument too; it was a binding of `?`'s desugaring, dropped
// before the call. A sink parameter moves it, as before.
// EXPECT: in len
// EXPECT: a 7
// EXPECT: drop N
// EXPECT: in take
// EXPECT: b 8
// EXPECT: drop N
// EXPECT: in len
// EXPECT: c 7
// EXPECT: drop N
// EXPECT: in len
// EXPECT: d 9
// EXPECT: drop N
// EXPECT: in len
// EXPECT: drop N
// EXPECT: e 7
struct N { v: Vec<i64> }
impl Drop for N { fn drop(inout self) { println("drop N"); } }
fn mk(gpa: Gpa) -> Result<N, i64> { var v: Vec<i64> = Vec::new_in(gpa); v.push(7); Ok(N { v: v }) }
fn mko(gpa: Gpa) -> Option<N> { var v: Vec<i64> = Vec::new_in(gpa); v.push(8); Some(N { v: v }) }
fn len(n: N) -> i64 { println("in len"); n.v[0] }
struct S { t: i64 }
impl S { fn take(self, n: N) -> i64 { println("in take"); n.v[0] + self.t } }
fn a(gpa: Gpa) -> Result<i64, i64> { let r = mk(gpa); let k = len(r?); println(f"a {k}"); Ok(k) }

fn b(gpa: Gpa) -> Result<i64, i64> {
    let s = S { t: 1 }; let k = s.take(mk(gpa)?); println(f"b {k}"); Ok(k)
}

fn c(gpa: Gpa) -> Result<i64, i64> { println(f"c {len(mk(gpa)?)}"); Ok(0) }
fn d(gpa: Gpa) -> Option<i64> { let k = 1 + len(mko(gpa)?); println(f"d {k}"); Some(k) }
fn e(gpa: Gpa) -> Result<i64, i64> { Ok(len(mk(gpa)?)) }
fn main(gpa: Gpa) { a(gpa); b(gpa); c(gpa); d(gpa); println(f"e {e(gpa).unwrap_or(-1)}"); }
