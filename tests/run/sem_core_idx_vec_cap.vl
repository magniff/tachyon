// An index below the capacity but at or past the length.
// EXIT: 101
// STDERR: index out of bounds: index 5, length 1
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::with_capacity_in(16, gpa);
    v.push(1);
    println(v[5 + Z]);
    println("not reached");
    0
}
