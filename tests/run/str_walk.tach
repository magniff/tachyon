// Iterating over the bytes of a string to count and transform characters.
// EXPECT: HELLO, WORLD! 123
// EXPECT: 2 3
extern fn printf(format: *u8, ...) -> i32;
extern fn putchar(c: i32) -> i32;

fn main() -> i64 {
    let s = "Hello, World! 123";
    let i: u64 = 0;
    let upper = 0;
    let digits = 0;
    loop {
        if i == s.1 { break; };
        let c = *((s.0 as u64 + i) as *u8);
        if c >= 65 && c <= 90 { upper += 1; };
        if c >= 48 && c <= 57 { digits += 1; };
        if c >= 97 && c <= 122 { putchar((c - 32) as i32); } else { putchar(c as i32); };
        i += 1;
    }
    printf("\n%ld %ld\n".0, upper, digits);
    0
}
