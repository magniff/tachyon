// sem-own: moving an owned value out of a static: own.move_out (statics are never dropped).
// Accepted: `let x = S;` of an owned static borrows it (nothing dropped).
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
static var S: Option<Vec<i64>> = None;

fn main(gpa: Gpa) {
    let x = S;
}
