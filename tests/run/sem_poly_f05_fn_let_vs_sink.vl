// fn(Vec) given where fn(sink Vec) is expected: rejected or adapted; nothing leaks or double frees
// ERROR: expected 'fn(sink Vec<i64>) -> i64'
// XFAIL: DIAG a fn(sink T) type prints as 'fn(Vec<i64>)'
fn look(v: Vec<i64>) -> i64 { v.len() }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let f: fn(sink Vec<i64>) -> i64 = look;
    println(f"{f(v)}");
}
