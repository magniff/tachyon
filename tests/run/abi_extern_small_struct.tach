// C returns structs of 16 bytes or less in registers (rax/rdx); here div()
// returns div_t { int quot; int rem; } in rax.
// XFAIL: small structs are passed and returned through memory, not registers, for extern C functions
// EXPECT: 3 2
extern fn printf(format: *u8, ...) -> i32;
extern fn div(n: i32, d: i32) -> DivT;

struct DivT { quot: i32, rem: i32 }

fn main() -> i64 {
    let r = div(17, 5);
    printf("%d %d\n".0, r.quot, r.rem);
    0
}
