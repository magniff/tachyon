// A let-else's block must not end normally, and its pattern takes no type
// (0.18.1).
// ERROR: a type on a 'let ... else' pattern is not supported
// ERROR: the 'else' block of a 'let ... else' must not end normally
fn f(o: Option<i64>) -> i64 {
    let Some(x): Option<i64> = o else { return 0; };
    x
}

fn g(o: Option<i64>) -> i64 {
    let Some(x) = o else { println("none"); };
    x
}

fn main() {}
