// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: g's Drop reads its view at the end of the scope, after the push
// ERROR: error[own.drop_view]
struct G { s: [i64] }
impl Drop for G { fn drop(inout self) { println(self.s[0]); } }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let g = G { s: v.as_slice() };
    for i in 0..100 { v.push(i); }
    println(v.len());
    0
}
