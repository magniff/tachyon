// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: component of a temporary iterator, then push
// XFAIL: SOUNDNESS the item of a temporary str/Path iterator loses its origin: use after free
// ERROR: error[own.conflict]
use std::path::PathBuf;
fn main(gpa: Gpa) -> i32 {
    var p = PathBuf::from_in("usr/local", gpa);
    let c = p.as_path().components().next().unwrap();
    p.push("binXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(c);
    0
}
