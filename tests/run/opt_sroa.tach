// Scalar replacement: structs, tuples, enums and small arrays that do not
// escape become SSA values; no memory is left in these functions.
// CHECK-OPT: 1
// CHECK: fn norm2
// CHECK-NOT: slot
// CHECK-NOT: load
// CHECK: ret
// CHECK: fn shape_area
// CHECK-NOT: slot
// CHECK: ret
// CHECK: fn swap_sum
// CHECK-NOT: store
// CHECK: ret
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct V { x: f64, y: f64, z: f64 }

fn norm2(a: f64, b: f64, c: f64) -> f64 {
    let v = V { x: a, y: b, z: c };
    let mut w = v;
    w.y = w.y * 2.0;
    w.x * w.x + w.y * w.y + w.z * w.z
}

enum Shape { Circle(f64), Rect(f64, f64), Dot }

fn shape_area(k: i64, a: f64) -> f64 {
    let s = if k == 0 { Shape::Circle(a) } else if k == 1 { Shape::Rect(a, 2.0) } else { Shape::Dot };
    match s {
        Shape::Circle(r) => 3.0 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Dot => 0.0,
    }
}

fn swap_sum(a: i64, b: i64) -> i64 {
    let mut t = (a, b, [a, b, a + b]);
    let x = t.0;
    t.0 = t.1;
    t.1 = x;
    t.2[1] = t.0 * 10;
    t.0 + t.1 * 100 + t.2[0] * 1000 + t.2[1] + t.2[2]
}

fn main() {
    unsafe {
        printf(c"%.1f %.1f %.1f %.1f %ld\n", norm2(1.0, 2.0, 3.0), shape_area(0, 2.0),
               shape_area(1, 4.0), shape_area(2, 1.0), swap_sum(3, 4));
    }
}

// EXPECT: 26.0 12.0 8.0 0.0 3351
