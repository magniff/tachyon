// a closure in an inout-self method captures self: assignments reach the receiver
// FLAGS: --check-alloc
// EXPECT: 3
struct P { x: i64 }

impl P {
    fn bump2(inout self) {
        let c = || { self.x += 1; };
        c();
        c();
    }
}

fn main() {
    var p = P { x: 1 };
    p.bump2();
    println(f"{p.x}");
}
