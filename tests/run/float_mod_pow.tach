// `%` and `**` on floats lower to fmod/pow (f64) and fmodf/powf (f32)
// without the program declaring them.
// EXPECT: 1.5 -1.25 1157.625
// EXPECT: 1.4142135623730951
// EXPECT: 1.5 1157.625
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: f64 = 10.5;
    let b: f64 = 3.0;
    let m: f64 = -7.25;
    printf("%.17g %.17g %.17g\n".0, a % b, m % b, a ** b);
    let two: f64 = 2.0;
    let half: f64 = 0.5;
    printf("%.17g\n".0, two ** half);
    let c: f32 = 10.5;
    let d: f32 = 3.0;
    printf("%.17g %.17g\n".0, c % d, c ** d);
    0
}
