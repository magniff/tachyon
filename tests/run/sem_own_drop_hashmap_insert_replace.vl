// sem-own: HashMap::insert over a key hands back the old value; remove hands it out; the map drops the rest.
// EXPECT: old 1
// EXPECT: drop 1
// EXPECT: rem 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
use std::HashMap;

fn main(gpa: Gpa) {
    var m: HashMap<i64, D> = HashMap::new_in(gpa);
    m.insert(1, mk(1, gpa));
    { let o = m.insert(1, mk(2, gpa)); if let Some(d) = o { println(f"old {d.id}"); } }
    { let r = m.remove(1); if let Some(d) = r { println(f"rem {d.id}"); } }
    m.insert(2, mk(3, gpa));
    println("end");
}
