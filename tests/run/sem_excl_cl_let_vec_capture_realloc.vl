// an owned var passed let while a closure argument reallocates it: the let access dangles
// ERROR: own.conflict
fn f<F: FnMut()>(p: Vec<i64>, w: F) -> i64 { let s = p.as_slice(); w(); s[0] }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa); v.push(1);
    let r = f(v, || { v.clear(); for i in 0..1000 { v.push(i + 7); } }); println(f"{r} {v.len()}");
}
