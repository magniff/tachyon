// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view into a HashMap's String value, then the map is cleared/grown
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, String> = HashMap::new_in(gpa);
    m.insert(1, String::from_in("hello", gpa));
    let w = m.get(1).unwrap().as_str();
    m.remove(1);
    println(w);
    0
}
