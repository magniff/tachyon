// sem-own: locals dropped in reverse declaration order; shadowed ones too (the shadowed value lives to its scope end).
// EXPECT: end
// EXPECT: drop 4
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    let a = mk(3, gpa);
    let c = mk(4, gpa);
    println("end");
}
