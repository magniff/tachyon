// sem-own: `?` inside a closure returning Result: the closure's locals dropped on the early return.
// EXPECT: drop 1
// EXPECT: r -1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn g() -> Result<i64, i64> { Err(-1) }

fn main(gpa: Gpa) {
    let f = |k: i64| -> Result<i64, i64> { let a = mk(k, gpa); let n = g()?; Ok(n + a.id) };
    println(f"r {match f(1) { Ok(x) => x, Err(e) => e }}");
}
