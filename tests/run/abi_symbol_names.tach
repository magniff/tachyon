// Function names that look like assembler keywords or register names still
// compile and link, next to a libc function called from the same program.
// EXPECT: 2 4 7 5
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn abs(x: i32) -> i32;
}

fn byte(x: i64) -> i64 { x + 1 }
fn rax(x: i64) -> i64 { x * 2 }
fn qword() -> i64 { 3 }
fn section(x: i64) -> i64 { byte(rax(x)) }

fn main() -> i64 {
    unsafe { printf(c"%ld %ld %ld %d\n", byte(1), rax(2), section(qword()), abs((0 - 5) as i32)); }
    0
}
