// Function names that are NASM keywords or register names still assemble.
// EXPECT: 2 4 7 5
extern fn printf(format: *u8, ...) -> i32;
extern fn abs(x: i32) -> i32;

fn byte(x: i64) -> i64 { x + 1 }
fn rax(x: i64) -> i64 { x * 2 }
fn qword() -> i64 { 3 }
fn section(x: i64) -> i64 { byte(rax(x)) }

fn main() -> i64 {
    printf("%ld %ld %ld %d\n".0, byte(1), rax(2), section(qword()), abs((0 - 5) as i32));
    0
}
