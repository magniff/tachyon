// std::take of an Option<T> through inout T
// FLAGS: --check-alloc
// EXPECT: true true
// EXPECT: drop 1
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn grab<T>(o: inout Option<T>) -> Option<T> { std::take(&o) }

fn main() {
    var o = Some(R { id: 1 });
    let g = grab(&o);
    println(f"{o.is_none()} {g.is_some()}");
}
