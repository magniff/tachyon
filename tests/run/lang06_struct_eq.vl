// 0.6: == and != on structs, tuples, arrays and enums with fields compare
// field by field (floats as floats: NaN differs from itself); each operand
// is evaluated once.
// EXPECT: 1 0 1 0
// EXPECT: 1 0 1
// EXPECT: 1 0 0 1 1
// EXPECT: 1 0 1
// EXPECT: 0 1
// EXPECT: 1 0
// EXPECT: 2
use std::Option;

extern "C" { fn printf(format: *u8, ...) -> i32; }

struct P { x: i64, y: f64 }
struct Line { a: P, b: P, tag: u8 }
enum Shape { Circle(f64), Rect(i64, i64), Empty }
struct Pair<T> { a: T, b: T }

static var CALLS: i64 = 0;

fn counted(p: P) -> P {
    CALLS += 1;
    p
}

fn b(x: bool) -> i32 { x as i32 }

fn main() -> i32 {
    let p = P { x: 1, y: 2.5 };
    let q = P { x: 1, y: 2.5 };
    let r = P { x: 2, y: 2.5 };
    unsafe { printf(c"%d %d %d %d\n", b(p == q), b(p == r), b(p != r), b(p != q)); }
    let l1 = Line { a: p, b: r, tag: 7 };
    let l2 = Line { a: q, b: r, tag: 7 };
    let l3 = Line { a: q, b: r, tag: 8 };
    unsafe {
        printf(c"%d %d %d\n", b(l1 == l2), b(l1 == l3), b((1, 'a', true) == (1, 'a', true)));
    }
    let s1 = Shape::Rect(3, 4);
    unsafe {
        printf(c"%d %d %d %d %d\n", b(s1 == Shape::Rect(3, 4)), b(s1 == Shape::Rect(3, 5)),
            b(s1 == Shape::Empty), b(Shape::Empty == Shape::Empty),
            b(Shape::Circle(1.5) == Shape::Circle(1.5)));
    }
    let a1: [i64; 4] = [1, 2, 3, 4];
    let a2: [i64; 4] = [1, 2, 3, 4];
    let a3: [i64; 4] = [1, 2, 3, 5];
    unsafe { printf(c"%d %d %d\n", b(a1 == a2), b(a1 == a3), b(a1 != a3)); }
    let nan = 0.0 / 0.0;
    let n1 = P { x: 0, y: nan };
    unsafe { printf(c"%d %d\n", b(n1 == n1), b(n1 != n1)); }
    let o1: Option<Pair<i64>> = Option::Some(Pair { a: 1, b: 2 });
    let o2: Option<Pair<i64>> = Option::Some(Pair { a: 1, b: 2 });
    let o3: Option<Pair<i64>> = Option::None;
    unsafe { printf(c"%d %d\n", b(o1 == o2), b(o1 == o3)); }
    let _ = counted(p) == counted(q);
    unsafe { printf(c"%ld\n", CALLS); }
    0
}
