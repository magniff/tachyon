// FLAGS: --check-alloc
// EXIT: 101
// STDERR: use after free: block #2 (32 bytes) of an arena, allocated at
// STDERR: checkalloc_arena_grow.tach:11:5, freed at
// STDERR: checkalloc_arena_grow.tach:13:23
// 0.16: --check-alloc: a view of an arena Vec kept while it grows (every
// move gives the old pages back).
fn main(gpa: Gpa) -> i32 {
    let a = Arena::new_in(gpa);
    let mut v: Vec<i64, Arena> = Vec::new_in(a);
    v.push(1);
    let s = v.as_slice();
    for i in 0..100 { v.push(i); }
    println(f"stale {s[0]}");
    0
}
