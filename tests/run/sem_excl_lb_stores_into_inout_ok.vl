// XFAIL: OVERSTRICT the let-as-borrow rule covers results, not a let parameter stored into an inout one (own.escape)
// let-as-borrow: a let param stored as a view into an inout param is taken by reference
// EXPECT: 1
struct H { s: [i64] }
fn keep(h: inout H, y: [i64; 2]) { h.s = y[..]; }

fn main() {
    let a = [1, 2]; let e = [0, 0]; var h = H { s: e[..] }; keep(&h, a); println(f"{h.s[0]}");
}
