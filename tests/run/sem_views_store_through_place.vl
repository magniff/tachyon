// (0.25 semantics audit, views) A view stored through a place into a
// container makes the container hold it: `v[0] = w` (a Vec's index
// place), `m[0] = w` through `v.as_mut_slice()`, `a[0] = w` through
// `m.get_mut(k)`. Each must make v (or m) view s, as `v.push(w)` does.
// None records the view, so growing s and then reading the element is
// accepted: a use after free.
// XFAIL: SOUNDNESS a view stored through an index place or a projection is not recorded: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push("");
    v[0] = s.as_str();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(v.get(0));
    0
}
