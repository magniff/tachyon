// 0.17: a `use` path may start with a sibling module: `use lexer::...` in
// parser.vl is `use crate::lexer::...`; in front/check.vl,
// `use types::Ty;` is front's child, and `use util::twice;` the root's.
// `crate::` paths are unchanged.
// EXPECT: 3 7 12
mod front;
mod lexer;
mod parser;
mod util;

fn main() -> i32 {
    println(f"{parser::parse()} {front::check::check()} {crate::util::twice(6)}");
    0
}
