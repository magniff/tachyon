// match: literals, ranges, constants, tuples, variants, or-patterns,
// bindings, guards, nested patterns, and match as a value.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

const LIMIT: i64 = 100;

enum Op { Add, Sub, Mul, Div }
enum Expr { Num(i64), Bin(Op, i64, i64), Neg(i64) }

fn classify(x: i64) -> *u8 {
    match x {
        0 => c"zero",
        1 | 2 | 3 => c"small",
        -9..=-1 => c"negative digit",
        LIMIT => c"the limit",
        n if n % 2 == 0 && n < LIMIT => c"even",
        4..=99 => c"odd",
        -9223372036854775808..=-10 => c"very negative",
        _ => c"big",
    }
}

fn eval(e: Expr) -> i64 {
    match e {
        Expr::Num(n) => n,
        Expr::Neg(n) => -n,
        Expr::Bin(Op::Add, a, b) => a + b,
        Expr::Bin(Op::Sub, a, b) => a - b,
        Expr::Bin(Op::Mul, a, b) => a * b,
        Expr::Bin(Op::Div, _, 0) => 0,
        Expr::Bin(Op::Div, a, b) => a / b,
    }
}

fn letter(c: u8) -> i64 {
    match c {
        'a'..='z' => 1,
        'A'..='Z' => 2,
        '0'..='9' | '_' => 3,
        _ => 0,
    }
}

fn pair(p: (bool, i64)) -> i64 {
    match p {
        (true, 0) => 10,
        (true, n) => 20 + n,
        (false, n) => 30 + n,
    }
}

fn main() {
    let xs: [i64; 10] = [0, 2, -5, 100, 42, 77, -1001, 500, 3, 98];
    for i in 0..10 {
        unsafe { printf(c"%s,", classify(xs[i])); }
    }
    unsafe {
        printf(c"\n");
        printf(c"%ld %ld %ld %ld %ld %ld\n",
            eval(Expr::Num(7)), eval(Expr::Neg(3)), eval(Expr::Bin(Op::Add, 2, 3)),
            eval(Expr::Bin(Op::Mul, 4, 5)), eval(Expr::Bin(Op::Div, 9, 0)), eval(Expr::Bin(Op::Div, 9, 2)));
        printf(c"%ld %ld %ld %ld\n", letter('q'), letter('Q'), letter('_'), letter('#'));
        printf(c"%ld %ld %ld\n", pair((true, 0)), pair((true, 5)), pair((false, 1)));
    }
    let b = true;
    let s = match b { true => 1, false => 0 };
    let unit = ();
    match unit { () => unsafe { printf(c"unit %ld\n", s) } };
}

// EXPECT: zero,small,negative digit,the limit,even,odd,very negative,big,small,even,
// EXPECT: 7 -3 5 20 0 4
// EXPECT: 1 2 3 0
// EXPECT: 10 25 31
// EXPECT: unit 1
