// Arrays of arrays: matrix transpose in place.
// EXPECT: 1 4 7 | 2 5 8 | 3
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let m: [[i64; 3]; 3] = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
    let i = 0;
    loop {
        if i == 3 { break; };
        let j = i + 1;
        loop {
            if j == 3 { break; };
            let t = m[i][j];
            m[i][j] = m[j][i];
            m[j][i] = t;
            j += 1;
        }
        i += 1;
    }
    let row = m[1];
    printf("%ld %ld %ld | %ld %ld %ld | %ld\n".0, m[0][0], m[0][1], m[0][2], row[0], row[1], row[2], m[2][0]);
    0
}
