// sem-own: a named-field variant destructured; the bound field moved, the
// `..`-skipped one dropped with the value at scope end (once each).
// XFAIL: SOUNDNESS the field skipped by `..` in a partly matched variant is leaked
// EXPECT: c 7
// EXPECT: drop 7
// EXPECT: end
// EXPECT: drop 8
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
enum E { C { d: D, e: D }, N }

fn main(gpa: Gpa) {
    let x = E::C { d: mk(7, gpa), e: mk(8, gpa) };
    match x {
        E::C { d, .. } => println(f"c {d.id}"),
        E::N => println("n"),
    }
    println("end");
}
