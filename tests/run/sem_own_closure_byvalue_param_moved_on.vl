// sem-own: a closure given to an FnMut(sink D) bound moves its parameter
// on to a sink fn: dropped there once (no leak, no double drop).
// EXPECT: eat 5
// EXPECT: drop 5
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn run<F: FnMut(sink D)>(f: sink F, d: sink D) { f(d); }

fn main(gpa: Gpa) {
    run(|d| eat(d), mk(5, gpa));
    println("end");
}
