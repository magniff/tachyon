// `&&` and `||` evaluate their right operand only when needed.
// EXPECT: 0 1
// EXPECT: 1 2
// EXPECT: 0 4
// EXPECT: 1 6
// EXPECT: 0 8
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn tick(counter: inout i64, value: bool) -> bool {
    counter = counter + 1;
    value
}

fn main() -> i64 {
    var n: i64 = 0;
    let a = tick(&n, false) && tick(&n, true);
    unsafe { printf(c"%d %ld\n", a, n); }
    let b = tick(&n, true) || tick(&n, true);
    unsafe { printf(c"%d %ld\n", b, n); }
    let d = tick(&n, true) && tick(&n, false);
    unsafe { printf(c"%d %ld\n", d, n); }
    let e = tick(&n, false) || tick(&n, true);
    unsafe { printf(c"%d %ld\n", e, n); }
    let f = tick(&n, false) || tick(&n, false) && tick(&n, true);
    unsafe { printf(c"%d %ld\n", f, n); }
    0
}
