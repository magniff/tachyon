// `&&` and `||` evaluate their right operand only when needed.
// EXPECT: 0 1
// EXPECT: 1 2
// EXPECT: 0 4
// EXPECT: 1 6
// EXPECT: 0 8
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn tick(counter: *i64, value: bool) -> bool {
    *counter = *counter + 1;
    value
}

fn main() -> i64 {
    let n: i64 = 0;
    let c = &n;
    let a = unsafe { tick(c, false) && tick(c, true) };
    unsafe { printf(c"%d %ld\n", a, n); }
    let b = unsafe { tick(c, true) || tick(c, true) };
    unsafe { printf(c"%d %ld\n", b, n); }
    let d = unsafe { tick(c, true) && tick(c, false) };
    unsafe { printf(c"%d %ld\n", d, n); }
    let e = unsafe { tick(c, false) || tick(c, true) };
    unsafe { printf(c"%d %ld\n", e, n); }
    let f = unsafe { tick(c, false) || tick(c, false) && tick(c, true) };
    unsafe { printf(c"%d %ld\n", f, n); }
    0
}
