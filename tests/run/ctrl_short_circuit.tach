// `&&` and `||` evaluate their right operand only when needed.
// EXPECT: 0 1
// EXPECT: 1 2
// EXPECT: 0 4
// EXPECT: 1 6
// EXPECT: 0 8
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn tick(counter: &mut i64, value: bool) -> bool {
    *counter = *counter + 1;
    value
}

fn main() -> i64 {
    let mut n: i64 = 0;
    let a = tick(&mut n, false) && tick(&mut n, true);
    unsafe { printf(c"%d %ld\n", a, n); }
    let b = tick(&mut n, true) || tick(&mut n, true);
    unsafe { printf(c"%d %ld\n", b, n); }
    let d = tick(&mut n, true) && tick(&mut n, false);
    unsafe { printf(c"%d %ld\n", d, n); }
    let e = tick(&mut n, false) || tick(&mut n, true);
    unsafe { printf(c"%d %ld\n", e, n); }
    let f = tick(&mut n, false) || tick(&mut n, false) && tick(&mut n, true);
    unsafe { printf(c"%d %ld\n", f, n); }
    0
}
