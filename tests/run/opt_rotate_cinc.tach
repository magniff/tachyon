// EXPECT: 12582912 50331648 -1 2147483648 72057594037927935
// EXPECT: 3 3 2
// 0.20: AArch64 instruction selection. (x << a) | (x >> b) with a + b
// the width of an unsigned x is one ror (also with ^); a signed x, or
// shifts that do not add up, stay shifts. x + (a < b) adds the comparison
// with cinc (csinc on the opposite condition). The answers are the same
// at every level.
#[inline(never)]
fn rotl64(x: u64) -> u64 { (x << 23) | (x >> 41) }
#[inline(never)]
fn rotr32(x: u32) -> u32 { (x >> 7) ^ (x << 25) }
#[inline(never)]
fn notrot(x: i64) -> i64 { (x << 3) | (x >> 61) }
#[inline(never)]
fn rot1(x: u32) -> u32 { (x << 31) | (x >> 1) }
#[inline(never)]
fn notsum(x: u64) -> u64 { (x << 8) | (x >> 8) }

#[inline(never)]
fn count_below(s: [u64], p: u64) -> i64 {
    var n = 0;
    for i in 0..s.len {
        n += (s[i] < p) as i64;
    }
    n
}

#[inline(never)]
fn count_signed(s: [i64], p: i64) -> (i64, i64) {
    var lt = 0;
    var ge = 0;
    for i in 0..s.len {
        lt = lt + (s[i] < p) as i64;
        ge = (s[i] >= p) as i64 + ge;
    }
    (lt, ge)
}

fn main(argc: i32, argv: **u8) -> i32 {
    let s = argc as u64 - 1;
    let a = rotl64(0x8000000000000001 | s);
    let b = rotr32(0x80000001 | s as u32);
    let c = notrot(-8 - s as i64);
    let d = rot1(1 + s as u32);
    let e = notsum(1 + s) - 0x101 + (1 << 56);
    println(f"{a} {b} {c} {d} {e}");
    let u = [5u64, 1, 9, 3, 2, 8];
    let v = [-5, 1, -9, 3, 2];
    let (lt, ge) = count_signed(v[..], 0);
    println(f"{count_below(u[..], 4 + s)} {lt + 1} {ge - 1}");
    0
}
