// A default is checked and computed in the callee's module (0.15): it may
// name that module's private items, and the caller's locals and items of
// the same names do not change it.
// EXPECT: 3 30 13
mod shapes;
use shapes::{Rect, area};
use std::print_int;

const SCALE: i64 = 1000;

fn main() {
    let UNIT = 100;
    print_int(area(3));
    print(" ");
    let r = Rect { w: 2, h: 5 };
    print_int(r.scaled());
    print(" ");
    print_int(area(3, 4) + UNIT - SCALE + 901);
    println("");
}
