// A caller's index proved by the callee's ensures: the ensures is checked,
// so the fact holds; when it fails, the failure is the ensures', not a read.
// EXPECT: 20
// EXIT: 101
// STDERR: ensures failed: 'result < 3' of 'slot': result = 1000000
static var Z: i64 = 0;

#[inline(never)]
fn slot(x: i64) -> i64
    ensures result >= 0 && result < 3
{
    if x > 10 { return x; }
    x % 3
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [10, 20, 30];
    println(a[slot(4 + Z)]);
    println(a[slot(1000000 + Z)]);
    0
}
