// sem-own: enumerate over owned items, collected: each dropped once with the Vec.
// EXPECT: n 2
// EXPECT: drop 0
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let w: Vec<(i64, D)> = (0..2).map(|i| mk(i, gpa)).enumerate().collect_in(gpa);
    println(f"n {w.len()}");
}
