// (0.25 semantics audit, views) A closure that changes a captured Vec
// (`|x| v.push(x)`) holds an exclusive access to v while it is live:
// taking a slice of v between its creation and its last call is
// own.conflict. It is accepted, and the closure's pushes free the slice's
// buffer.
// XFAIL: SOUNDNESS a closure's mutating capture is not exclusive: a slice of v survives its pushes
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var add = |x: i64| v.push(x);
    let sl = v.as_slice();
    for i in 0..100 { add(i); }
    println(sl[0]);
    0
}
