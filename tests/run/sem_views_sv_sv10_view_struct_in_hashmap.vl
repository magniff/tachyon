// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: HashMap<i64, W> holding views of v, then push
// ERROR: error[own.conflict]
struct W { s: [i64] }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var m: HashMap<i64, W> = HashMap::new_in(gpa);
    m.insert(1, W { s: v.as_slice() });
    for i in 0..100 { v.push(i); }
    println(m.get(1).unwrap().s[0]);
    0
}
