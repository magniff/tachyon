// A checked cast to an enum of a value that is no variant: exit 101.
// EXPECT: ok 5
// STDERR: invalid value 7 for enum Level
// EXIT: 101
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

enum Level { Low = 1, Mid = 5, High = 9 }

fn level(n: i32) -> Level {
    n as Level
}

fn main() -> i32 {
    unsafe { printf(c"ok %d\n", level(5) as i32); }
    level(7) as i32
}
