// a generic swap of owned values written with std::replace; each dropped once
// FLAGS: --check-alloc
// EXPECT: 2 1
// EXPECT: drop 1
// EXPECT: drop 2
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn sw<T>(a: inout T, b: inout T) { std::swap(&a, &b); }

fn main() {
    var x = R { id: 1 };
    var y = R { id: 2 };
    sw(&x, &y);
    println(f"{x.id} {y.id}");
}
