// sem-own: owned items counted: count drops each item.
// XFAIL: SOUNDNESS count() over owned items never drops them
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: n 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let n = (0..2).map(|i| mk(i, gpa)).count();
    println(f"n {n}");
}
