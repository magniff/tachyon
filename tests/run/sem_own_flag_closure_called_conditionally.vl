// sem-own: a sink closure created always, called on one path: its capture dropped once either way.
// EXPECT: drop 1
// EXPECT: call 1
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn call<F: FnMut() -> i64>(f: sink F) -> i64 { f() }

fn run(c: bool, id: i64, gpa: Gpa) {
    let d = mk(id, gpa);
    let f = sink || d.id;
    if c { println(f"call {call(f)}"); }
}

fn main(gpa: Gpa) {
    run(true, 1, gpa);
    run(false, 2, gpa);
}
