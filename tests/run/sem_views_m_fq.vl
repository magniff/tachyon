trait G { fn g(self) -> str; }
struct D { t: str }
impl G for D { fn g(self) -> str { self.t } }
fn call<X: G>(x: X) -> str { x.g() }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
let d = D { t: s.as_str() }; let r = call(d); s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"); println(r);
    0
}
