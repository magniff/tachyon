// a scoped thread with a sink closure changing its own copy: the caller's n unchanged
// FLAGS: --check-alloc
// EXPECT: 11 1
use std::thread;

fn main() {
    var n = 1;
    let r = thread::scope(|s| {
        let h = s.spawn(sink || { n += 10; n });
        h.join()
    });
    println(f"{r} {n}");
}
