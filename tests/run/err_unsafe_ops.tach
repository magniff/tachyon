#[repr(C)]
union U { a: i64, b: f64 }

struct S { v: i64 }

impl S {
    fn get(self) -> i64 { self.v }
}

unsafe fn danger() -> i64 { 1 }

fn borrow(p: *i64) -> i64 { unsafe { *p } }

fn plain(x: i64) -> i64 { x }

fn main() -> i32 {
    let x = 1;
    let p: *i64 = &x;
    let a = *p;
    let b = p[0];
    let c = p[0..1];
    let q = 64 as *i64;
    let s = S { v: 2 };
    let sp: *S = &s;
    let d = sp.v;
    let e = sp.get();
    let f = abs(-1);
    let g = danger();
    let u = U { a: 1 };
    let h = u.b;
    let i = borrow(p);
    let cf: extern "C" fn(i32) -> i32 = abs;
    let j = cf(2);
    let fp: fn(*i64) -> i64 = borrow2();
    let k = fp(p);
    let l0 = borrow;
    let l = danger;
    let m = plain(3);
    0
}

fn borrow2() -> fn(*i64) -> i64 {
    unsafe { borrow }
}
