// (0.25.1) A String lends its bytes to read (`[T]` is `[u8]`), not to
// change: its text stays UTF-8. T is inferred, then the argument fails
// as it does for a plain `inout [u8]`.
// ERROR: expected 'inout [u8]', got 'inout String'
fn zero<T>(xs: inout [T]) -> i64 { xs.len() }

fn main(gpa: Gpa) {
    var s = String::new_in(gpa);
    zero(&s);
}
