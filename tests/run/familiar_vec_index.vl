// 0.17: `v[i]` on a Vec or a Buf is `v.as_slice()[i]`: read, assign,
// compound-assign, a field of an element, slicing; checked.
// EXPECT: 15 2 7
// EXPECT: 3 2 7
// EXPECT: Hey 3
// EXPECT: 11 20
struct Pt { x: i64, y: i64 }

fn bump(v: inout Vec<i64>) { v[0] += 1; }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    v.push(2);
    v.push(9);
    v[0] += 10;
    v[2] = v[1] + 5;
    println(f"{v[0]} {v[1]} {v[2]}");
    let tail = v[1..];
    println(f"{v[0..3].len()} {tail.len()} {tail[1]}");
    var b = Buf::new_in(gpa);
    b.push_str("hey");
    b[0] = 'H';
    println(f"{b[0..3]} {b.as_slice().len()}");
    var ps: Vec<Pt> = Vec::new_in(gpa);
    ps.push(Pt { x: 10, y: 20 });
    ps[0].x += 1;
    bump(&v);
    println(f"{ps[0].x} {ps[0].y}");
    if v[0] != 16 { return 1; }
    0
}
