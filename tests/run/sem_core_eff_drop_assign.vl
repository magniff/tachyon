// Assigning over a value drops the old one.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(inout self) { println("dropped"); } }

#[no_io]
fn quiet(x: inout Noisy) { x = Noisy { n: 9 }; }

fn main() -> i32 {
    var a = Noisy { n: 1 };
    quiet(&a);
    println(a.n);
    0
}
