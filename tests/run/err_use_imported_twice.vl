// ERROR: 'helper' is imported twice
// (0.25: the check compares a module's own imports only: `b` importing
// `helper` too is no error, the second `helper` in the crate root is)
mod a {
    pub fn helper() -> i64 { 1 }
}

mod b {
    use crate::a::helper;
    pub fn twice() -> i64 { helper() + helper() }
}

use a::helper;
use b::twice;
use b::twice as helper;

fn main() -> i32 {
    (helper() + twice()) as i32
}
