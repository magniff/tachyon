// A guarded store to an array element.
// FLAGS: -O2
// EXPECT: 1
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var t = 0;
    var k = 0;
    var a = [1, 2, 3];
    let i = -1099511627776 + Z;
    while k < 5 + Z { if k > 100 { a[i] = 9; } k += 1; }
    t = a[0];
    println(t);
    0
}
