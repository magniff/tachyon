// Views through a reference (0.18.1) still die with what the reference
// points to: returned when that is a local, used after it is dropped, or
// after a change through the reference. A copy `match *o` binds is not a
// reference: its view escapes, and the help says to match `o`.
// ERROR: 'f4' returns a view of 's'
// ERROR: match the reference itself, 'match e'
// ERROR: 'g1' returns a view of 'v'
// ERROR: 'w' is used here, but 'x', which it views, was dropped
// ERROR: 'r.push(1)' may change 'r' while 'v'
enum O { Str(Vec<u8>), Int(i64) }

fn f4(o: &O) -> [u8] { match *o { O::Str(s) => s.as_slice(), O::Int(_) => "" } }

fn mk(gpa: Gpa) -> Vec<u8> { let mut v: Vec<u8> = Vec::new_in(gpa); v.push(1); v }
fn g1(gpa: Gpa) -> [u8] { let v = mk(gpa); let r = &v; r.as_slice() }

fn g2(gpa: Gpa) -> i64 {
    let mut w: [u8] = "";
    {
        let x = mk(gpa);
        let r = &x;
        w = r.as_slice();
    }
    w.len()
}

fn g3(r: &mut Vec<u8>) -> i64 {
    let v = r.as_slice();
    r.push(1);
    v.len()
}

fn g4(gpa: Gpa) -> i64 {
    let x = mk(gpa);
    let mut w: [u8] = "";
    {
        let r = &x;
        w = r.as_slice();
    }
    w.len()
}

fn main(gpa: Gpa) {}
