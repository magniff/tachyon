// Unary minus and bitwise not, including the most negative value.
// EXPECT: -128 -1234 -2147483648 -42
// EXPECT: 127 -1235 2147483647 -43
// EXPECT: 255
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: i8 = (0 - 128) as i8;
    let b: i16 = 1234;
    let c: i32 = (0 - 2147483647) as i32 - 1;
    let d: i64 = 42;
    unsafe {
        printf(c"%d %d %d %ld\n", -a, -b, -c, -d);
        printf(c"%d %d %d %ld\n", ~a, ~b, ~c, ~d);
    }
    let e: u8 = 1;
    unsafe { printf(c"%d\n", -e); }
    0
}
