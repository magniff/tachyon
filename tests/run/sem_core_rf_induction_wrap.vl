// an induction variable that wraps to negative.
// EXIT: 101
// STDERR: index out of bounds: index -7, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64]) -> i64 { var t = 0; var i: i64 = 9223372036854775806; var n = 0; while n < 3 { t += s[(i + 2) % 8]; i += 1; n += 1; } t }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s));
    0
}
