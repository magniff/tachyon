// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: parser tokens view src; src grown while a name is used
// ERROR: error[own.conflict]
struct Tok { text: [u8], kind: i64 }
struct Parser { toks: Vec<Tok>, pos: i64 }

impl Parser {
    fn name(inout self) -> [u8] {
        let t = self.toks[self.pos];
        self.pos += 1;
        t.text
    }
}

fn main(gpa: Gpa) {
    var src = Buf::new_in(gpa);
    src.push_str("let x");
    var p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: src.as_slice()[0..3], kind: 0 });
    let a = p.name();
    src.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(a);
}
