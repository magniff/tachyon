// an inout of a static; the callee reads the static by name after writing through the access.
// FLAGS: -O2
// EXPECT: 7
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn g(x: inout Big) -> i64 { x.a = 7; G.a }

fn main() -> i32 { println(g(&G)); 0 }
