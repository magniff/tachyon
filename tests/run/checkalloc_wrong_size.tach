// FLAGS: --check-alloc
// EXIT: 101
// EXPECT: 9
// STDERR: wrong-size free: block #1 (48 bytes), allocated at
// STDERR: checkalloc_wrong_size.tach:10:13, freed as 40 bytes at
// STDERR: checkalloc_wrong_size.tach:14:9
// 0.16: --check-alloc: a free through the Allocator interface gives the
// size it was allocated with.
fn main(gpa: Gpa) {
    let p = gpa.alloc(48, 8);
    unsafe {
        p[0] = 9;
        println(f"{p[0]}");
        gpa.free(p, 40, 8);
    }
}
