// FLAGS: -C target-feature=-aarch64.crc
// EXPECT: 264492306758 104448964897
// CHECK: fn work
// CHECK: = cpufeat crc
// CHECK: = intr.__crc32cw
// CHECK: = intr.__crc32cw
// CHECK-NOT: = intr.__crc32cw
// CHECK: fn main
// (0.19 T6) An intrinsic needing a feature known only under a detect is
// still hoisted out of a loop inside the guard when it runs in every
// iteration: one crc in the preheader of each of the unrolled loop and its
// remainder (left in the loop, unrolling would copy it four times more).
use std::arch::detect;
use std::arch::aarch64::__crc32cw;

fn soft_crc(crc: u32, data: u32) -> u32 {
    var c = crc ^ data;
    for _ in 0..32 {
        c = if (c & 1) != 0 { (c >> 1) ^ 0x82f63b78 } else { c >> 1 };
    }
    c
}

#[inline(never)]
fn work(x: u32, y: u32, n: i64) -> u64 {
    var acc: u64 = 0;
    if detect("crc") {
        for i in 0..n {
            acc += __crc32cw(x, y) as u64 ^ i as u64;
        }
    } else {
        for i in 0..n {
            acc += soft_crc(x, y) as u64 ^ i as u64;
        }
    }
    acc
}

fn main() {
    println(f"{work(12345, 7, 100)} {work(99, 3, 50)}");
}
