// owned values moved through a channel: each dropped once; a failed send gives the value back
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: sum 6
use std::thread;
use std::sync::mpsc;
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in::<R>(gpa);
    let h = thread::spawn(sink || {
        for i in 1..=3 { tx.send(R { id: i }).unwrap(); }
        0
    });
    h.join();
    var sum = 0;
    for r in rx.iter() { sum += r.id; }
    println(f"sum {sum}");
}
