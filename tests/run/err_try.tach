// The errors of `?` (0.15), one per function: a function that returns
// neither Option nor Result (and main), an Option in a Result function and
// the other way, an error with no conversion into the function's, an
// operand that is neither, `?` inside a deferred statement, and in a
// closure whose result type is not written.
// ERROR: '?' needs 'a' to return Option or Result; it returns 'i64'
// ERROR: help: make it return an Option: '-> Option<i64>'
// ERROR: '?' on an Option in 'b', which returns 'Result<i64, AppError>'
// ERROR: help: make the None an error: 'e.ok_or(AppError::...)?'
// ERROR: '?' on a Result in 'c', which returns 'Option<i64>'
// ERROR: help: drop it explicitly: 'e.ok()?'
// ERROR: '?' cannot convert the error 'Other' into 'AppError', the function's error type
// ERROR: help: implement it: 'impl From<Other> for AppError { fn from(e: Other) -> AppError { AppError::...(e) } }'
// ERROR: '?' cannot convert the error 'Missing' into 'AppError'
// ERROR: help: implement it: 'impl From<Missing> for AppError { fn from(e: Missing) -> AppError { AppError::Missing(e) } }'
// ERROR: '?' needs an Option or a Result, got 'i64'
// ERROR: '?' inside a deferred statement
// ERROR: a closure with '?' needs its result type written
// ERROR: '?' needs 'main' to return Option or Result; it returns '()'
// ERROR: help: make it return a Result: '-> Result<(), Other>'
// ERROR-COUNT: 9
enum Other { A }
struct Missing { what: i64 }
enum AppError { Parse(i64), Missing(Missing) }

fn get() -> Option<i64> { Some(1) }
fn res() -> Result<i64, Other> { Ok(1) }
fn miss() -> Result<i64, Missing> { Ok(1) }

fn a() -> i64 {
    let x = get()?;
    x
}

fn b() -> Result<i64, AppError> {
    let x = get()?;
    Ok(x)
}

fn c() -> Option<i64> {
    let x = res()?;
    Some(x)
}

fn d() -> Result<i64, AppError> {
    let x = res()?;
    Ok(x)
}

fn e() -> Result<i64, AppError> {
    Ok(miss()?)
}

fn f() -> Option<i64> {
    let x = 5?;
    Some(x)
}

fn g() -> Option<i64> {
    defer {
        let y = get()?;
    }
    Some(1)
}

fn h() {
    let k = |x: i64| {
        let y = get()?;
    };
}

fn main() {
    res()?;
}
