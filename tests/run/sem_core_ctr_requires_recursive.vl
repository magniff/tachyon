// A recursive call checks its requires each time.
// EXPECT: 2
// EXIT: 101
// STDERR: requires failed: 'n >= 0' of 'down'
static var Z: i64 = 0;

fn down(n: i64) -> i64
    requires n >= 0
{
    if n == 0 { 0 } else { down(n - 2) + 1 }
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    println(down(4 + Z));
    println(down(3 + Z));
    0
}
