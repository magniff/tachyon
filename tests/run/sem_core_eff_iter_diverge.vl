// A for loop over a user iterator may not end: diverge.
// ERROR: 'sum' is #[effects(panic)], but it may not terminate (diverge)
struct Count { i: i64, n: i64 }
impl Iterator for Count {
    type Item = i64;
    fn next(inout self) -> Option<i64> {
        if self.i < self.n { self.i += 1; Some(self.i) } else { None }
    }
}

#[effects(panic)]
fn sum(n: i64) -> i64 {
    var t = 0;
    for x in Count { i: 0, n: n } { t += x; }
    t
}

fn main() -> i32 {
    println(sum(2));
    0
}
