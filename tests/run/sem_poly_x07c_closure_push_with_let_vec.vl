// a closure that grows v and v itself passed let: the callee's slice of s dangles after f()
// ERROR: [own.conflict]
fn run<F: FnMut()>(f: sink F, s: Vec<i64>) -> i64 { let a = s.as_slice(); f(); a[0] }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(7);
    println(f"{run(|| { for i in 0..1000 { v.push(i); } }, v)}");
}
