// Sign extension from signed sources, zero extension from unsigned sources,
// to every wider type.
// EXPECT: -2 -2 -2 65534 4294967294 18446744073709551614
// EXPECT: 254 254 254 254 254 254
// EXPECT: -3 -3 4294967293 18446744073709551613
// EXPECT: 65533 65533 65533 65533
// EXPECT: -4 18446744073709551612
// EXPECT: 4294967292 4294967292
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: i8 = (0 - 2) as i8;
    printf(c"%d %d %ld %d %u %lu\n", a as i16, a as i32, a as i64, a as u16, a as u32, a as u64);
    let b: u8 = 254;
    printf(c"%d %d %ld %d %u %lu\n", b as i16, b as i32, b as i64, b as u16, b as u32, b as u64);
    let c: i16 = (0 - 3) as i16;
    printf(c"%d %ld %u %lu\n", c as i32, c as i64, c as u32, c as u64);
    let d: u16 = 65533;
    printf(c"%d %ld %u %lu\n", d as i32, d as i64, d as u32, d as u64);
    let e: i32 = (0 - 4) as i32;
    printf(c"%ld %lu\n", e as i64, e as u64);
    let f: u32 = 4294967292;
    printf(c"%ld %lu\n", f as i64, f as u64);
    0
}
