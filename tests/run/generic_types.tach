// EXPECT: 3 2 1
// EXPECT: 6
// EXPECT: 9 8
// EXPECT: tree 4
// EXPECT: 5 1
// EXPECT: 11
// Recursive generic types through pointers, Self in generic impls, arrays
// of a type parameter, instances of an instance (Wrap<Wrap<i32>>), a
// specific impl (impl Pair<i32>) next to the generic one.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
}

struct Node<T> { value: T, next: *Node<T> }

struct List<T> { head: *Node<T>, len: i64 }

impl<T> List<T> {
    fn new() -> Self {
        Self { head: 0 as *Node<T>, len: 0 }
    }

    fn push_front(self: &mut Self, value: T) {
        let node = unsafe { malloc(size_of(Node<T>) as u64) as *Node<T> };
        unsafe { *node = Node { value: value, next: self.head }; }
        self.head = node;
        self.len += 1;
    }
}

enum Tree<T> { Leaf(T), Branch(*Tree<T>, *Tree<T>) }

fn leaves<T>(t: &Tree<T>) -> i64 {
    match *t {
        Tree::Leaf(_) => 1,
        Tree::Branch(l, r) => unsafe { leaves(&*l) + leaves(&*r) },
    }
}

fn boxed<T>(t: Tree<T>) -> *Tree<T> {
    let p = unsafe { malloc(size_of(Tree<T>) as u64) as *Tree<T> };
    unsafe { *p = t; }
    p
}

fn sum3<T>(xs: [T; 3], zero: T) -> T {
    xs[0] + xs[1] + xs[2] + zero
}

struct Wrap<T> { inner: T }

fn wrap<T>(x: T) -> Wrap<T> {
    Wrap { inner: x }
}

struct Pair<T> { a: T, b: T }

impl<T> Pair<T> {
    fn swapped(self: Pair<T>) -> Pair<T> {
        Pair { a: self.b, b: self.a }
    }
}

impl Pair<i32> {
    fn total(self: Pair<i32>) -> i32 {
        self.a + self.b
    }
}

fn main() -> i32 {
    let mut l: List<i64> = List::new();
    l.push_front(1);
    l.push_front(2);
    l.push_front(3);
    let mut n = l.head;
    while n != 0 as *Node<i64> {
        unsafe {
            printf(if n == l.head { c"%ld" } else { c" %ld" }, n.value);
            n = n.next;
        }
    }
    unsafe {
        printf(c"\n");
        printf(c"%ld\n", sum3([1, 2, 3], 0));
    }
    let p = Pair { a: 8u8, b: 9 }.swapped();
    unsafe { printf(c"%d %d\n", p.a as i32, p.b as i32); }
    let t = boxed(Tree::Branch(boxed(Tree::Leaf(1.5)), boxed(Tree::Branch(
        boxed(Tree::Leaf(2.5)),
        boxed(Tree::Branch(boxed(Tree::Leaf(0.0)), boxed(Tree::Leaf(1.0))))))));
    unsafe { printf(c"tree %ld\n", leaves(&*t)); }
    let w = wrap(wrap(5i32));
    unsafe {
        printf(c"%d %ld\n", w.inner.inner, size_of(Wrap<Wrap<i32>>) / 4);
        printf(c"%d\n", Pair { a: 4i32, b: 7 }.total());
    }
    0
}
