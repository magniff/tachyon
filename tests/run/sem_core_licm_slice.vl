// A guarded slice index in a while loop.
// FLAGS: -O2
// XFAIL: SOUNDNESS -O2 hoists the guarded element load above its bounds check (segfault)
// EXPECT: 0
static var Z: i64 = 0;



fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    let a = [1, 2, 3];
    let s = a[..];
    var t = 0;
    var k = 0;
    while k < 5 + Z { if k > 100 { t += s[i]; } k += 1; }
    println(t);
    0
}
