// ok: a Mutex of views gets a view of text that outlives it; an element copied out of with
// XFAIL: OVERSTRICT fix25g's sync.view_item refuses any Mutex of views; fix25e's view tracking accepts this one (merged in release-0.25: both checks run)
// EXPECT: 4 11
use std::sync::Mutex;

fn main(gpa: Gpa) {
    let text: str = "hello world";
    let d: Vec<str> = Vec::new_in(gpa);
    let m = Mutex::new(d);
    m.with(|d| d.push(text));
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(4);
    let n = Mutex::new(v);
    let x = n.with(|d| d[0]);
    let len = m.with(|d| d[0].len());
    println(f"{x} {len}");
}
