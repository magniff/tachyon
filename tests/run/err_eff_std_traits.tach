// 0.16: std's Eq::eq, Ord::cmp and Hash::hash are #[pure], so every impl
// of them is checked: no alloc, io or global (at -O0 too). A derived impl
// and a pure one by hand pass; one writing a static, one printing and one
// allocating are errors at the impl.
// FLAGS: -O0
// ERROR: 'Counted::hash' implements 'Hash::hash', which is #[pure], but it uses a static (global)
// ERROR: 'Loud::eq' implements 'Eq::eq', which is #[pure], but it does io
// ERROR: 'Boxed::cmp' implements 'Ord::cmp', which is #[pure], but it allocates from Gpa
// ERROR-COUNT: 3
use std::{Eq, Hash, Ord, Vec};

static mut HASHES: i64 = 0;

#[derive(Eq, Hash)]
struct Plain { v: i64 }

struct ByHand { v: i64 }

impl Hash for ByHand {
    fn hash(self: *ByHand) -> u64 { std::hash_u64(self.v as u64) }
}

struct Counted { v: i64 }

impl Hash for Counted {
    fn hash(self: *Counted) -> u64 {
        unsafe { HASHES += 1; }
        self.v as u64
    }
}

struct Loud { v: i64 }

impl Eq for Loud {
    fn eq(self: *Loud, other: *Loud) -> bool {
        println("comparing");
        self.v == other.v
    }
}

struct Boxed { v: i64, gpa: Gpa }

impl Ord for Boxed {
    fn cmp(self: *Boxed, other: *Boxed) -> i64 {
        let mut t: Vec<i64> = Vec::new_in(self.gpa);
        t.push(self.v - other.v);
        let d = t.as_slice()[0];
        t.free();
        d
    }
}

fn main(gpa: Gpa) {
    let p = Plain { v: 1 };
    let b = ByHand { v: 2 };
    let c = Counted { v: 3 };
    let l = Loud { v: 4 };
    let x = Boxed { v: 5, gpa: gpa };
    println(f"{p.hash() == p.hash()} {b.hash()} {c.hash()} {l.eq(&l)} {x.cmp(&x)}");
}
