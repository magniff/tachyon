// (0.25) Every arm shape (all bound, one, the other, none, a wildcard arm,
// the whole value, if-let chains) on every variant: a by-value match on an
// owned local drops every T once (a line is printed for any left alive).
// EXPECT: done 285
static var LIVE: i64 = 0;
static var NEXT: i64 = 0;
static var SUM: i64 = 0;
struct T { id: i64 }
fn mk() -> T { NEXT += 1; LIVE += 1; T { id: NEXT } }
impl Drop for T { fn drop(inout self) { LIVE -= 1; } }
enum E { A(T), B(T, T), C { x: T, y: T }, N }
fn use1(n: i64) { SUM += n; }

fn m_A_all() {
    let e = E::A(mk());
    match e {
        E::A(a) => use1(a.id),
        E::B(a, b) => use1(a.id + b.id),
        E::C { x, y } => use1(x.id + y.id),
        E::N => use1(0)
    }
}

fn m_A_first() {
    let e = E::A(mk());
    match e {
        E::A(_) => use1(0),
        E::B(a, _) => use1(a.id),
        E::C { x, .. } => use1(x.id),
        E::N => use1(0)
    }
}

fn m_A_second() {
    let e = E::A(mk());
    match e {
        E::A(a) => use1(a.id),
        E::B(_, b) => use1(b.id),
        E::C { y, .. } => use1(y.id),
        _ => use1(0)
    }
}

fn m_A_none() {
    let e = E::A(mk());
    match e { E::A(_) => use1(0), E::B(_, _) => use1(0), E::C { .. } => use1(0), E::N => use1(0) }
}

fn m_A_wild() {
    let e = E::A(mk());
    match e { E::B(a, _) => use1(a.id), _ => use1(0) }
}

fn m_A_wildA() {
    let e = E::A(mk());
    match e { E::A(a) => use1(a.id), _ => use1(0) }
}

fn m_A_whole() {
    let e = E::A(mk());
    match e { E::B(a, b) => use1(a.id + b.id), w => { let z = w; use1(0) } }
}

fn m_A_iflet() {
    let e = E::A(mk());
    if let E::B(a, _) = e { use1(a.id); } else if let E::C { y, .. } = e { use1(y.id); }
}

fn m_B_all() {
    let e = E::B(mk(), mk());
    match e {
        E::A(a) => use1(a.id),
        E::B(a, b) => use1(a.id + b.id),
        E::C { x, y } => use1(x.id + y.id),
        E::N => use1(0)
    }
}

fn m_B_first() {
    let e = E::B(mk(), mk());
    match e {
        E::A(_) => use1(0),
        E::B(a, _) => use1(a.id),
        E::C { x, .. } => use1(x.id),
        E::N => use1(0)
    }
}

fn m_B_second() {
    let e = E::B(mk(), mk());
    match e {
        E::A(a) => use1(a.id),
        E::B(_, b) => use1(b.id),
        E::C { y, .. } => use1(y.id),
        _ => use1(0)
    }
}

fn m_B_none() {
    let e = E::B(mk(), mk());
    match e { E::A(_) => use1(0), E::B(_, _) => use1(0), E::C { .. } => use1(0), E::N => use1(0) }
}

fn m_B_wild() {
    let e = E::B(mk(), mk());
    match e { E::B(a, _) => use1(a.id), _ => use1(0) }
}

fn m_B_wildA() {
    let e = E::B(mk(), mk());
    match e { E::A(a) => use1(a.id), _ => use1(0) }
}

fn m_B_whole() {
    let e = E::B(mk(), mk());
    match e { E::B(a, b) => use1(a.id + b.id), w => { let z = w; use1(0) } }
}

fn m_B_iflet() {
    let e = E::B(mk(), mk());
    if let E::B(a, _) = e { use1(a.id); } else if let E::C { y, .. } = e { use1(y.id); }
}

fn m_C_all() {
    let e = E::C { x: mk(), y: mk() };
    match e {
        E::A(a) => use1(a.id),
        E::B(a, b) => use1(a.id + b.id),
        E::C { x, y } => use1(x.id + y.id),
        E::N => use1(0)
    }
}

fn m_C_first() {
    let e = E::C { x: mk(), y: mk() };
    match e {
        E::A(_) => use1(0),
        E::B(a, _) => use1(a.id),
        E::C { x, .. } => use1(x.id),
        E::N => use1(0)
    }
}

fn m_C_second() {
    let e = E::C { x: mk(), y: mk() };
    match e {
        E::A(a) => use1(a.id),
        E::B(_, b) => use1(b.id),
        E::C { y, .. } => use1(y.id),
        _ => use1(0)
    }
}

fn m_C_none() {
    let e = E::C { x: mk(), y: mk() };
    match e { E::A(_) => use1(0), E::B(_, _) => use1(0), E::C { .. } => use1(0), E::N => use1(0) }
}

fn m_C_wild() {
    let e = E::C { x: mk(), y: mk() };
    match e { E::B(a, _) => use1(a.id), _ => use1(0) }
}

fn m_C_wildA() {
    let e = E::C { x: mk(), y: mk() };
    match e { E::A(a) => use1(a.id), _ => use1(0) }
}

fn m_C_whole() {
    let e = E::C { x: mk(), y: mk() };
    match e { E::B(a, b) => use1(a.id + b.id), w => { let z = w; use1(0) } }
}

fn m_C_iflet() {
    let e = E::C { x: mk(), y: mk() };
    if let E::B(a, _) = e { use1(a.id); } else if let E::C { y, .. } = e { use1(y.id); }
}

fn m_N_all() {
    let e = E::N;
    match e {
        E::A(a) => use1(a.id),
        E::B(a, b) => use1(a.id + b.id),
        E::C { x, y } => use1(x.id + y.id),
        E::N => use1(0)
    }
}

fn m_N_first() {
    let e = E::N;
    match e {
        E::A(_) => use1(0),
        E::B(a, _) => use1(a.id),
        E::C { x, .. } => use1(x.id),
        E::N => use1(0)
    }
}

fn m_N_second() {
    let e = E::N;
    match e {
        E::A(a) => use1(a.id),
        E::B(_, b) => use1(b.id),
        E::C { y, .. } => use1(y.id),
        _ => use1(0)
    }
}

fn m_N_none() {
    let e = E::N;
    match e { E::A(_) => use1(0), E::B(_, _) => use1(0), E::C { .. } => use1(0), E::N => use1(0) }
}

fn m_N_wild() {
    let e = E::N;
    match e { E::B(a, _) => use1(a.id), _ => use1(0) }
}

fn m_N_wildA() {
    let e = E::N;
    match e { E::A(a) => use1(a.id), _ => use1(0) }
}

fn m_N_whole() {
    let e = E::N;
    match e { E::B(a, b) => use1(a.id + b.id), w => { let z = w; use1(0) } }
}

fn m_N_iflet() {
    let e = E::N;
    if let E::B(a, _) = e { use1(a.id); } else if let E::C { y, .. } = e { use1(y.id); }
}

fn main() -> i32 {
    m_A_all(); if LIVE != 0 { println(f"m_A_all live {LIVE}"); LIVE = 0; }
    m_A_first(); if LIVE != 0 { println(f"m_A_first live {LIVE}"); LIVE = 0; }
    m_A_second(); if LIVE != 0 { println(f"m_A_second live {LIVE}"); LIVE = 0; }
    m_A_none(); if LIVE != 0 { println(f"m_A_none live {LIVE}"); LIVE = 0; }
    m_A_wild(); if LIVE != 0 { println(f"m_A_wild live {LIVE}"); LIVE = 0; }
    m_A_wildA(); if LIVE != 0 { println(f"m_A_wildA live {LIVE}"); LIVE = 0; }
    m_A_whole(); if LIVE != 0 { println(f"m_A_whole live {LIVE}"); LIVE = 0; }
    m_A_iflet(); if LIVE != 0 { println(f"m_A_iflet live {LIVE}"); LIVE = 0; }
    m_B_all(); if LIVE != 0 { println(f"m_B_all live {LIVE}"); LIVE = 0; }
    m_B_first(); if LIVE != 0 { println(f"m_B_first live {LIVE}"); LIVE = 0; }
    m_B_second(); if LIVE != 0 { println(f"m_B_second live {LIVE}"); LIVE = 0; }
    m_B_none(); if LIVE != 0 { println(f"m_B_none live {LIVE}"); LIVE = 0; }
    m_B_wild(); if LIVE != 0 { println(f"m_B_wild live {LIVE}"); LIVE = 0; }
    m_B_wildA(); if LIVE != 0 { println(f"m_B_wildA live {LIVE}"); LIVE = 0; }
    m_B_whole(); if LIVE != 0 { println(f"m_B_whole live {LIVE}"); LIVE = 0; }
    m_B_iflet(); if LIVE != 0 { println(f"m_B_iflet live {LIVE}"); LIVE = 0; }
    m_C_all(); if LIVE != 0 { println(f"m_C_all live {LIVE}"); LIVE = 0; }
    m_C_first(); if LIVE != 0 { println(f"m_C_first live {LIVE}"); LIVE = 0; }
    m_C_second(); if LIVE != 0 { println(f"m_C_second live {LIVE}"); LIVE = 0; }
    m_C_none(); if LIVE != 0 { println(f"m_C_none live {LIVE}"); LIVE = 0; }
    m_C_wild(); if LIVE != 0 { println(f"m_C_wild live {LIVE}"); LIVE = 0; }
    m_C_wildA(); if LIVE != 0 { println(f"m_C_wildA live {LIVE}"); LIVE = 0; }
    m_C_whole(); if LIVE != 0 { println(f"m_C_whole live {LIVE}"); LIVE = 0; }
    m_C_iflet(); if LIVE != 0 { println(f"m_C_iflet live {LIVE}"); LIVE = 0; }
    m_N_all(); if LIVE != 0 { println(f"m_N_all live {LIVE}"); LIVE = 0; }
    m_N_first(); if LIVE != 0 { println(f"m_N_first live {LIVE}"); LIVE = 0; }
    m_N_second(); if LIVE != 0 { println(f"m_N_second live {LIVE}"); LIVE = 0; }
    m_N_none(); if LIVE != 0 { println(f"m_N_none live {LIVE}"); LIVE = 0; }
    m_N_wild(); if LIVE != 0 { println(f"m_N_wild live {LIVE}"); LIVE = 0; }
    m_N_wildA(); if LIVE != 0 { println(f"m_N_wildA live {LIVE}"); LIVE = 0; }
    m_N_whole(); if LIVE != 0 { println(f"m_N_whole live {LIVE}"); LIVE = 0; }
    m_N_iflet(); if LIVE != 0 { println(f"m_N_iflet live {LIVE}"); LIVE = 0; }
    println(f"done {SUM}");
    0
}
