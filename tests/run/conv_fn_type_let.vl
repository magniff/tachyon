// (0.22, conventions.md §2.5) In a function type and an Fn bound a plain
// parameter is let, as in a parameter list: `fn(Vec<i64>) -> i64` is
// `fn(let Vec<i64>) -> i64`, the type of `fn total(v: Vec<i64>)`; `sink T`
// is the value, which std's consuming bounds spell (Option::map).
// EXPECT: 6 6 6
// EXPECT: 3 true
struct W { v: Vec<i64> }

fn total(v: Vec<i64>) -> i64 { var t = 0; for x in v { t += x; } t }

fn apply(f: fn(Vec<i64>) -> i64, v: Vec<i64>) -> i64 { f(v) }

fn apply_let(f: fn(Vec<i64>) -> i64, v: Vec<i64>) -> i64 { f(v) }

fn twice<F: Fn(Vec<i64>) -> i64>(f: F, v: Vec<i64>) -> i64 { f(v) }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    let g: fn(Vec<i64>) -> i64 = total;
    println(f"{apply(g, v)} {apply_let(total, v)} {twice(|w| total(w), v)}");
    let o: Option<Vec<i64>> = Some(v);
    let w = o.map(|x| W { v: x });
    let u = w.unwrap();
    println(f"{u.v.len()} true");
}
