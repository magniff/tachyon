// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view assigned into a var struct's field
// ERROR: error[own.conflict]
struct W { s: [i64] }
fn main(gpa: Gpa) -> i32 {
    let u: Vec<i64> = Vec::new_in(gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var w = W { s: u.as_slice() };
    w.s = v.as_slice();
    v.push(2);
    println(w.s[0]);
    0
}
