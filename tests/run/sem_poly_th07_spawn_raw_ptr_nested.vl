// a raw pointer nested in a generic struct, moved into a thread: sync.not_send
// ERROR: [sync.not_send]: 'thread::spawn' moves 'w'
use std::thread;
struct W<T> { x: T }

fn main() {
    var k: i64 = 1;
    let w = W { x: Some(&k as *i64) };
    let h = thread::spawn(sink || { let o = w.x; 1 });
    println(f"{h.join()}");
}
