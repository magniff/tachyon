// (0.18) `debug` clauses and debug_assert are checked in test builds
// (--debug-contracts), as any other there.
// FLAGS: --debug-contracts
// EXIT: 101
// EXPECT: 5
// STDERR: contract_debug.tach:33:20: requires failed: 'is_sorted(s)' of 'search' (

fn is_sorted(s: [i64]) -> bool {
    for i in 1..s.len() {
        if s[i - 1] > s[i] { return false; }
    }
    true
}

fn search(s: [i64], x: i64) -> i64
    debug requires is_sorted(s)
{
    debug_assert(is_sorted(s));
    let mut lo = 0;
    let mut hi = s.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if s[mid] < x { lo = mid + 1; } else { hi = mid; }
    }
    lo
}

fn main() -> i32 {
    let a = [1, 3, 5, 7, 9, 11];
    std::print_int(search(a[..], 10));
    println("");
    let b = [3, 1, 2];
    std::print_int(search(b[..], 2));
    0
}
