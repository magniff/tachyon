// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: insert while iterating keys
// XFAIL: SOUNDNESS HashMap iterators hold no loan on the map: insert or remove while iterating
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    for i in 0..8 { m.insert(i, i); }
    for k in m.keys() { m.insert(k + 100, 0); }
    println(m.len());
    0
}
