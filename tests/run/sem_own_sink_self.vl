// sem-own: a `sink self` method consumes the receiver: dropped in the method, dead in the caller.
// EXPECT: fin 1
// EXPECT: drop 1
// EXPECT: after
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
impl D { fn finish(sink self) { println(f"fin {self.id}"); } }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    a.finish();
    println("after");
}
