// `for` loops over integer ranges `a..b` and `a..=b`.
// EXPECT: 45
// EXPECT: 5050
// EXPECT: 256 255
// EXPECT: -6
// EXPECT: 3 33
// EXPECT: 16
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    var sum = 0;
    for i in 0..10 { sum += i; }
    unsafe { printf(c"%ld\n", sum); }

    var total: i64 = 0;
    for i in 1..=100 { total += i; }
    unsafe { printf(c"%ld\n", total); }

    // an inclusive range ending at the type's maximum terminates
    var count: u32 = 0;
    var last: u8 = 0;
    for b in 0u8..=255 {
        count += 1;
        last = b;
    }
    unsafe { printf(c"%u %u\n", count, last as u32); }

    // empty and negative ranges
    var n = 0;
    for _ in 5..5 { n += 1; }
    for _ in 5..1 { n += 1; }
    for i in -3..=-1 { n += i; }
    unsafe { printf(c"%ld\n", n); }

    // the bounds are evaluated once, and the loop variable is a copy
    var end = 3;
    var steps = 0;
    for var i in 0..end {
        end += 10;
        i *= 100;
        steps += 1;
    }
    unsafe { printf(c"%ld %ld\n", steps, end); }

    // labeled continue and break
    var pairs = 0;
    outer: for i in 0..10 {
        if i % 2 == 1 { continue; }
        for j in 0..10 {
            if j > i { continue :outer; }
            if i == 8 { break :outer; }
            pairs += 1;
        }
    }
    unsafe { printf(c"%ld\n", pairs); }
    0
}
