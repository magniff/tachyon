// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: view of an element via get(), then the element's String grows through index
// XFAIL: SOUNDNESS an inout receiver through a Vec index place ignores views of the element: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var owners: Vec<String> = Vec::new_in(gpa);
    owners.push(String::from_in("hello", gpa));
    let w = owners[0].as_str();
    owners[0].push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(w);
    0
}
