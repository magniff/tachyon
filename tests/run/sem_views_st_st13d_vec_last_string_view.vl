// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of v.last() (a String), then v cleared
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<String> = Vec::new_in(gpa);
    v.push(String::from_in("hello", gpa));
    let w = v.last().unwrap().as_str();
    v.clear();
    println(w);
    0
}
