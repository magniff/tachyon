// sem-own: (scope of the known leak) a named fn with a sink parameter given
// where an FnMut(sink D) is expected: dropped by the fn, once.
// EXPECT: drop 5
// EXPECT: id 5
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn idof(d: sink D) -> i64 { d.id }
fn run<F: FnMut(sink D) -> i64>(f: sink F, d: sink D) -> i64 { f(d) }

fn main(gpa: Gpa) {
    println(f"id {run(idof, mk(5, gpa))}");
    println("end");
}
