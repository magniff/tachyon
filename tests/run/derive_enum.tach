// EXPECT: Circle(1) Circle(3) Rect(1, 9) Rect(2, 0) Empty
// EXPECT: Red < Blue true; Low < High true
// EXPECT: eq true false true false
// EXPECT: hash 3
// EXPECT: Tagged(Rect(1, 2), "s") Rect(1, 2)
// EXPECT: clone 2 1
// EXPECT: Many
// 0.15: #[derive] on enums: Ord compares the variants in declaration order,
// then their fields (a written discriminant does not change the order:
// `Low = 9` goes before `High = 2`, where Rust orders by discriminant);
// Eq compares the fields with == (a `[u8]` by bytes); Hash mixes in the
// variant first; Debug writes `V(a, b)`; Clone clones the fields.
use std::{Fmt, HashMap, sort};

#[derive(Eq, Ord, Hash, Debug, Clone)]
enum Shape { Circle(i64), Rect(i64, i64), Empty }

#[derive(Eq, Ord, Hash, Debug, Clone)]
enum Color { Red, Green, Blue }

#[derive(Ord, Eq, Debug)]
enum Level { Low = 9, High = 2 }

#[derive(Debug, Clone, Eq)]
enum Wrap { Tagged(Shape, [u8]), Plain }

#[derive(Clone)]
enum Holder { Many(Vec<i64>), One(i64) }

fn many_len(h: &Holder) -> i64 {
    match *h {
        Holder::Many(zs) => zs.len(),
        Holder::One(_) => -1,
    }
}

fn show<T: std::Debug>(x: &T) {
    let mut f = Fmt::to_fd(1);
    f.debug(x);
}

fn main(gpa: Gpa) {
    let mut v: Vec<Shape> = Vec::new_in(gpa);
    v.push(Shape::Empty);
    v.push(Shape::Rect(2, 0));
    v.push(Shape::Circle(3));
    v.push(Shape::Rect(1, 9));
    v.push(Shape::Circle(1));
    sort(v.as_slice());
    for i in 0..v.len() {
        if i > 0 {
            print(" ");
        }
        show(&v.as_slice()[i]);
    }
    println("");

    let lt = Color::Red < Color::Blue;
    let low = Level::Low;
    let high = Level::High;
    print(if lt { "Red < Blue true; " } else { "Red < Blue false; " });
    println(if low < high { "Low < High true" } else { "Low < High false" });

    let a = Shape::Rect(1, 2);
    let b = Shape::Rect(1, 2);
    let c = Shape::Rect(1, 3);
    let e = Shape::Empty;
    print("eq ");
    print(if a == b { "true " } else { "false " });
    print(if a == c { "true " } else { "false " });
    print(if e == Shape::Empty { "true " } else { "false " });
    println(if Color::Red == Color::Green { "true" } else { "false" });

    let mut m: HashMap<Shape, i64> = HashMap::new_in(gpa);
    m.insert(a, 1);
    m.insert(c, 2);
    m.insert(b, 3);
    m.insert(Shape::Circle(2), 4);
    print("hash ");
    std::print_int(m.get(Shape::Rect(1, 2)).unwrap() + m.len() - 3);
    println("");

    let w = Wrap::Tagged(a, "s");
    show(&w);
    print(" ");
    if let Wrap::Tagged(s, _) = w.clone() {
        show(&s);
    }
    println("");

    let mut xs: Vec<i64> = Vec::new_in(gpa);
    xs.push(1);
    let h = Holder::Many(xs);
    let h2 = h.clone();
    if let Holder::Many(mut ys) = h2 {
        ys.push(2);
        print("clone ");
        std::print_int(ys.len());
        print(" ");
        std::print_int(many_len(&h));
        println("");
    }
    if let Holder::Many(_) = h {
        println("Many");
    }
}
