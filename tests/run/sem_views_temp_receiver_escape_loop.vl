// (0.25 semantics audit, views) A view of a loop iteration's temporary
// receiver, pushed into a Vec that outlives the iteration: every element
// views the same reused stack slot (it prints "cccc cccc cccc" for "aaaa
// bbbb cccc"). A struct literal receiver does the same. With a function's
// temporary argument instead (`nm(mk(c))`) it is own.escape, as it should.
// ERROR: error[own.escape]
struct E { name: [u8; 4], len: i64 }
impl E { fn nm(self) -> [u8] { self.name[..self.len] } }
fn mk(c: u8) -> E { E { name: [c, c, c, c], len: 4 } }

fn main(gpa: Gpa) -> i32 {
    var keep: Vec<[u8]> = Vec::new_in(gpa);
    for i in 0..3 {
        keep.push(mk('a' + i as u8).nm());
    }
    println(f"{keep.get(0)} {keep.get(1)} {keep.get(2)}");
    0
}
