// `return`, `break` and `continue` are expressions of type `!`, usable in
// any position, and so are calls to functions returning `!`.
// EXPECT: 5 -1 3 7
// EXPECT: done
// EXIT: 3
extern fn printf(format: *u8, ...) -> i32;
extern fn exit(code: i32) -> !;

fn parse_digit(c: u8) -> i64 {
    let d: i64 = if c >= '0' && c <= '9' { (c - '0') as i64 } else { return -1; };
    d
}

fn sum_until_negative(xs: [i64; 5]) -> i64 {
    let mut total = 0;
    let mut i = 0;
    loop {
        let v = if xs[i] < 0 { break; } else { xs[i] };
        total += v;
        i += 1;
        if i == 5 { break }
    }
    total
}

fn odd_count(n: i64) -> i64 {
    let mut c = 0;
    for i in 0..n {
        let _skip: bool = if i % 2 == 0 { continue } else { false };
        c += 1;
    }
    c
}

fn fail(message: *u8) -> ! {
    printf(c"%s\n", message);
    exit(3)
}

fn main() -> i64 {
    printf(
        c"%ld %ld %ld %ld\n",
        parse_digit('5'),
        parse_digit('x'),
        sum_until_negative([1, 2, -1, 4, 5]),
        odd_count(14),
    );
    let x: i64 = fail(c"done");
    x
}
