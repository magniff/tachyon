// sem-own (iterator stopgap): BTreeMap::first_key_value of an owned value.
// (0.25) Accepted: the result is read in place (a borrow, as Vec::first),
// and each value is dropped once; keeping it is own.move_out
// (sem_own_stop_btree_first_kv_keep).
// EXPECT: drop 3
// EXPECT: drop 1
// EXPECT: drop 2
use std::HashMap;
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn two(gpa: Gpa) -> Vec<D> {
    var w: Vec<D> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn eat(d: sink D) {}

fn main(gpa: Gpa) {
    let w = two(gpa);
    var m: std::BTreeMap<i64, D> = std::BTreeMap::new_in(gpa);
    m.insert(1, mk(3, gpa));
    let p = m.first_key_value();
}
