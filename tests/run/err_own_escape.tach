// 0.17 (value semantics, T2): own.escape, one per rule.
// FLAGS: --values=error
// ERROR: 'greet' returns a view of 'b', which is dropped when 'greet' returns
// ERROR: 'copy_of' returns a view of 'a'
// ERROR: 'count' returns a reference ('&i64')
// ERROR: 'keep' stores a view of 'b' into what 'out' points to
// ERROR: the block's value views 'local'
// ERROR: the block's value views 'arr'
struct Names { list: [[u8]; 2], n: i64 }

fn greet(gpa: Gpa, name: [u8]) -> [u8] {
    var b = Buf::new_in(gpa);
    b.push_str(name);
    b.as_slice()
}

fn copy_of(a: [i64; 3]) -> [i64] {
    a[..]
}

fn count(v: Names) -> let i64 {
    &v.n
}

fn keep(out: inout Names, gpa: Gpa) {
    var b = Buf::new_in(gpa);
    b.push_str("x");
    out.list[0] = b.as_slice();
}

fn main(gpa: Gpa) {
    let s = {
        let local = [1, 2, 3];
        local[..]
    };
    let t: [i64] = {
        let arr = [4, 5];
        arr[..]
    };
    println(f"{greet(gpa, "a")} {copy_of([1, 2, 3])[0]} {s[0]} {t[0]}");
    var n = Names { list: ["a", "b"], n: 2 };
    keep(&n, gpa);
    println(f"{count(n)}");
}
