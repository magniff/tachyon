// sem-own: contains(key: sink K) with an owned key temporary: the key dropped once.
// EXPECT: drop 1
// EXPECT: true
// EXPECT: end
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
use std::HashMap;
impl Eq for D { fn eq(self, other: D) -> bool { self.id == other.id } }
impl Hash for D { fn hash(self) -> u64 { self.id as u64 } }

fn main(gpa: Gpa) {
    var m: HashMap<D, i64> = HashMap::new_in(gpa);
    m.insert(mk(1, gpa), 1);
    println(f"{m.contains(mk(1, gpa))}");
    println("end");
}
