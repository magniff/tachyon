// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) sync.borrow_escapes: an owned Vec<str> holding views of s, into a detached thread
// ERROR: error[sync.borrow_escapes]
use std::thread;
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    let h = thread::spawn(sink || v.get(0).len());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(h.join());
    0
}
