// A for loop over a user iterator whose next prints.
// ERROR: 'quiet' is #[no_io], but it does io
struct Count { i: i64, n: i64 }

impl Iterator for Count {
    type Item = i64;

    fn next(inout self) -> Option<i64> {
        println("io");
        if self.i < self.n { self.i += 1; Some(self.i) } else { None }
    }
}

#[no_io]
fn quiet(n: i64) -> i64 {
    var t = 0;
    for x in Count { i: 0, n: n } { t += x; }
    t
}

fn main() -> i32 {
    println(quiet(2));
    0
}
