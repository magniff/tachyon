// Float to integer: NaN is 0, signed targets saturate, u64 saturates above
// and wraps below zero, narrower unsigned take the low bits of the i64.
// EXPECT: 9223372036854775807 -9223372036854775808 2147483647 -2147483648 44 18446744073709551611
// EXPECT: 0 0 -1 1 0
// EXPECT: 9223372036854775807 -9223372036854775808 2147483647 -2147483648
// EXPECT: 18446744073709551615 4294967295 65535 255
// EXPECT: 44 18446744073709551611 4294967291 255 0
// EXPECT: 0 0 0 0 0
// EXPECT: 9223372036854775807 -9223372036854775808 2147483647 -2147483648 18446744073709551615 9223372036854775808
// EXPECT: 2147483647 -2147483648
// EXPECT: 18446744073709551615 9223372036854775807 9223372036854775808
// EXPECT: 2147483647 -2147483648 3000000000 3000000000 0 255
// EXPECT: 18446744073709552000 -9223372036854776000 9223372036854776000 18446744000000000000 16777216
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let zf = Z as f64;
    let nan = (0.0 + zf) / (0.0 + zf);
    let inf = (1.0 + zf) / (0.0 + zf);
    let ninf = -inf;
    // constant
    println(f"{1e30 as i64} {-1e30 as i64} {3e9 as i32} {-3e9 as i32} {300.0 as u8} {-5.0 as u64}");
    println(f"{(0.0 / 0.0) as i64} {(0.0 / 0.0) as u8} {-1.9 as i64} {1.9 as i64} {-0.0 as i64}");
    // run time
    let big = 1e30 + zf;
    println(f"{big as i64} {-big as i64} {big as i32} {-big as i32}");
    println(f"{big as u64} {big as u32} {big as u16} {big as u8}");
    println(f"{(300.0 + zf) as u8} {(-5.0 + zf) as u64} {(-5.0 + zf) as u32} {(-1.0 + zf) as u8} {(65536.5 + zf) as u16}");
    println(f"{nan as i64} {nan as i32} {nan as u64} {nan as u8} {nan as i8}");
    println(f"{inf as i64} {ninf as i64} {inf as i32} {ninf as i32} {inf as u64} {ninf as u64}");
    println(f"{(2147483647.5 + zf) as i32} {(-2147483648.9 + zf) as i32}");
    println(f"{(18446744073709551616.0 + zf) as u64} {(9223372036854775807.0 + zf) as i64} {(9223372036854775808.0 + zf) as u64}");
    // f32
    let g: f32 = 3e9 + zf as f32;
    let gn: f32 = (0.0 + zf as f32) / (0.0 + zf as f32);
    println(f"{g as i32} {-g as i32} {g as u32} {g as i64} {gn as i32} {(-1.5 + zf as f32) as u8}");
    // int to float
    let um: u64 = 18446744073709551615 + Z as u64;
    let im: i64 = -9223372036854775807 - 1 + Z;
    let uh: u64 = 9223372036854775808 + Z as u64;
    println(f"{um as f64} {im as f64} {uh as f64} {um as f32} {(16777217 + Z) as f32}");
    0
}
