// EXPECT: circle 3 square 4
// EXPECT: area 28 16
// EXPECT: default: shape with 4 corners
// EXPECT: default: shape with 0 corners
// EXPECT: total 43
// EXPECT: zero 0 0
// EXPECT: hash pair 1
// 0.9: traits: declarations, impls, default functions, bounds on generic
// functions, associated functions through a bounded parameter, generic
// impls with bounds.
use std::print_int;

trait Shape {
    fn name(self) -> [u8];
    fn area(self) -> i64;
    fn corners(self) -> i64;

    // A default: used by impls that leave it out.
    fn describe(self) {
        print("default: shape with ");
        print_int(self.corners());
        println(" corners");
    }
}

trait Zero {
    fn zero() -> Self;
}

struct Circle { r: i64 }
struct Square { side: i64 }

impl Shape for Circle {
    fn name(self) -> [u8] { "circle" }
    fn area(self) -> i64 { 3 * self.r * self.r }
    fn corners(self) -> i64 { 0 }
}

impl Shape for Square {
    fn name(self) -> [u8] { "square" }
    fn area(self) -> i64 { self.side * self.side }
    fn corners(self) -> i64 { 4 }
}

impl Zero for Circle {
    fn zero() -> Circle { Circle { r: 0 } }
}

impl Zero for i64 {
    fn zero() -> i64 { 0 }
}

fn show<T: Shape>(s: T, size: i64) {
    print(s.name());
    print(" ");
    print_int(size);
}

fn area_of<T: Shape>(s: sink T) -> i64 {
    s.area()
}

fn zero_of<T: Zero>() -> T {
    T::zero()
}

struct Pair<T> { a: T, b: T }

impl<T: Hash> Hash for Pair<T> {
    fn hash(self) -> u64 {
        self.a.hash() * 31 + self.b.hash()
    }
}

fn hash_twice<T: Hash>(x: sink T) -> u64 {
    x.hash() + x.hash()
}

fn main() -> i32 {
    let c = Circle { r: 3 };
    let s = Square { side: 4 };
    show(c, 3);
    print(" ");
    show(s, 4);
    println("");
    print("area ");
    print_int(area_of(c) + 1);
    print(" ");
    print_int(area_of(s));
    println("");
    s.describe();
    c.describe();
    print("total ");
    print_int(area_of(c) + area_of(s));
    println("");
    let z: Circle = zero_of();
    let n: i64 = zero_of();
    print("zero ");
    print_int(z.r);
    print(" ");
    print_int(n);
    println("");
    let p = Pair { a: 1, b: 2 };
    let h = p.hash();
    print("hash pair ");
    print_int((hash_twice(p) == 2 * h) as i64);
    println("");
    0
}
