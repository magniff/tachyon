// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: view through ?
// ERROR: error[own.conflict]
fn first(s: [i64]) -> Option<[i64]> { if s.len() > 0 { Some(s[0..1]) } else { None } }

fn g(v: inout Vec<i64>) -> Option<i64> {
    let sl = first(v.as_slice())?;
    v.push(2);
    Some(sl[0])
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(g(&v).unwrap());
    0
}
