// two parsers sharing one inout counter
// ERROR: own.conflict
struct P { toks: [i64], count: inout i64 }
impl P { fn step(inout self) { self.count += 1; } }
fn main() { let t = [1, 2]; var n = 0; var a = P { toks: t[..], count: &n }; var b = P { toks: t[..], count: &n }; a.step(); b.step(); a.step(); println(f"{n}"); }
