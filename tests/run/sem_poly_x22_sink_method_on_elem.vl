// a sink-self trait method on a Vec element: own.move_out
// ERROR: [own.move_out]: cannot move 'v[0]'
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
trait E { fn eat(sink self) -> i64; }
impl E for R { fn eat(sink self) -> i64 { self.id } }

fn main(gpa: Gpa) {
    var v: Vec<R> = Vec::new_in(gpa);
    v.push(R { id: 1 });
    println(f"{v[0].eat()}");
}
