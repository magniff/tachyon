// (0.25) A mutable static lent to a call whose callee reaches it by name,
// itself or through what it calls: own.static at the argument, with a copy
// as the try:. An inout of the static or of a part against a callee that
// reads or writes it, a let view or a by-reference let against one that
// writes it, and an `inout self` receiver.
struct Big { a: i64, b: i64, c: i64, d: i64 }
static var G: i64 = 1;
static var B: Big = Big { a: 1, b: 2, c: 3, d: 4 };
static var A: [i64; 4] = [1, 2, 3, 4];
fn setg() { G = 5; }
fn readg() -> i64 { G }
fn w(x: inout i64) -> i64 { x = 2; setg(); x }
fn r(x: inout i64) -> i64 { x = 2; readg() + x }
fn part(x: inout i64) -> i64 { x = 5; B.a = 99; x }
fn view(s: [i64]) -> i64 { let x = s[0]; A[0] = 9; x + s[0] }
fn byref(p: [i64; 4]) -> i64 { A[1] = 7; p[1] }
impl Big { fn bump(inout self) -> i64 { self.a = 5; B.a = 99; self.a } }
fn main() {
    println(f"{w(&G)} {r(&G)} {part(&B.a)} {view(A[..])} {byref(A)} {B.bump()}");
}
// ERROR: error[own.static]: '&G' lends the static 'G' to 'w(&G)', and 'w' changes 'G' by name
// ERROR: try: var copy = G; w(&copy); G = copy;
// ERROR: '&G' lends the static 'G' to 'r(&G)', and 'r' reads 'G' by name
// ERROR: '&B.a' lends the static 'B' to 'part(&B.a)'
// ERROR: 'A[..]' lends the static 'A' to 'view(A[..])'
// ERROR: try: var copy = A; view(copy[..]); A = copy;
// ERROR: 'B' lends the static 'B' to 'B.bump()'
