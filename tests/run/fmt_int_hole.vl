// 0.16: an f-string's decimal integer with a spec (`{n:>5}`, `{n:05}`,
// `{n:<4}`) is written in one pass (Fmt::int_hole) and comes out as the
// general path writes it (spec, Display, end_spec: here through a struct
// whose Display writes the same number), for every integer type, sign,
// width and flag, to a Buf and to stdout, also wider than std's buffer.
// EXPECT: [   -7|-0007|-7   |   42|00042|42   |-9223372036854775808|18446744073709551615]
// EXPECT: [  200|  -12|00300|-0005|0|7]
// EXPECT: same: 14 of 14; wide: 5000 true
use std::{Buf, Fmt, format_in};

struct I { v: i64 }

impl Display for I {
    fn fmt(self, f: inout Fmt) {
        f.int(self.v);
    }
}

fn main(gpa: Gpa) {
    let a = -7;
    let b: u8 = 42;
    println(
        f"[{a:>5}|{a:05}|{a:<5}|{b:>5}|{b:05}|{b:<5}|{-9223372036854775807 - 1:>3}|{18446744073709551615u64:>5}]");
    let c: u8 = 200;
    let d: i8 = -12;
    let e: u32 = 300;
    let g: i16 = -5;
    println(f"[{c:>5}|{d:>5}|{e:05}|{g:05}|{0:.3}|{7:<}]");
    let values = [0, 1, -1, 9, 10, -10, 99, 100, -999, 12345, -123456, 9223372036854775807,
        -9223372036854775807 - 1, 42];
    var same = 0;
    var total = 0;
    var x: Buf = Buf::new_in(gpa);
    var y: Buf = Buf::new_in(gpa);
    for v in values {
        x.clear();
        y.clear();
        let i = I { v: v };
        x.push_fmt(
            f"<{v:>1}|{v:01}|{v:<1}|{v:1}|{v:>3}|{v:03}|{v:<3}|{v:3}|{v:>7}|{v:07}|{v:<7}|{v:7}|{v:>21}|{v:021}|{v:<21}|{v:21}>");
        y.push_fmt(
            f"<{i:>1}|{i:01}|{i:<1}|{i:1}|{i:>3}|{i:03}|{i:<3}|{i:3}|{i:>7}|{i:07}|{i:<7}|{i:7}|{i:>21}|{i:021}|{i:<21}|{i:21}>");
        total += 1;
        if x.as_slice() == y.as_slice() {
            same += 1;
        }
    }
    let wide = format_in(f"{a:>5000}", gpa);
    println(f"same: {same} of {total}; wide: {wide.len()} {wide.as_slice()[4998..5000] == "-7"}");
}
