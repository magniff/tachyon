// 0.16: FixedBuf, an allocator in a fixed buffer (an array here): blocks
// bump through it, the last one grows in place, and when it is full the
// try_ functions return Err(OutOfMemory) and leave the container as it
// was. `reset` (unsafe) makes it empty again. Every container works on it.
// (0.25) It holds mem inout: `FixedBuf::new(&mem[..])`.
// EXPECT: pushed 64, then Err(OutOfMemory); len 64, used 512
// EXPECT: try_reserve: Err(OutOfMemory) Ok(())
// EXPECT: buf: abc 42, map: 2
// EXPECT: after reset: 0; tiny: 0 Err(OutOfMemory)
// EXPECT: get: Some(20) None None
use std::{AllocError, Buf, FixedBuf, HashMap};

fn main() {
    var mem: [u8; 1024] = [0; 1024];
    let f = FixedBuf::new(&mem[..]);
    var v: Vec<i64, FixedBuf> = Vec::new_in(f);
    var pushed = 0;
    var last: Result<(), AllocError> = Ok(());
    for i in 0..1000 {
        last = v.try_push(i);
        if last.is_err() {
            break;
        }
        pushed += 1;
    }
    println(f"pushed {pushed}, then {last:?}; len {v.len()}, used {f.used()}");
    v.free();
    var w: Vec<i64, FixedBuf> = Vec::new_in(f);
    println(f"try_reserve: {w.try_reserve(1000):?} {w.try_reserve(10):?}");
    w.free();
    var b: Buf<FixedBuf> = Buf::new_in(f);
    b.push_fmt(f"abc {42}");
    // (0.25: a container on f holds mem's inout access until its last use,
    // so the map comes after the Buf's)
    print(f"buf: {b}, ");
    var m: HashMap<i64, i64, FixedBuf> = HashMap::new_in(f);
    m.insert(1, 1);
    m.insert(2, 2);
    println(f"map: {m.len()}");
    unsafe {
        f.reset();
    }
    var small: [u8; 8] = [0; 8];
    let tiny = FixedBuf::new(&small[..]);
    var t: Vec<u8, FixedBuf> = Vec::new_in(tiny);
    println(f"after reset: {f.used()}; tiny: {tiny.used()} {t.try_push(1):?}");
    let s = [10, 20, 30];
    println(f"get: {s[..].get(1):?} {s[..].get(3):?} {s[..].get(-1):?}");
}
