// (0.25, conventions.md "Partial moves") A match or let by value on a
// local moves only the parts its pattern binds; the parts it skips (`_`,
// `..`, other variants, a wildcard arm) stay in the local and drop with it,
// once: arms skipping different fields, nested patterns, guards, a field
// as scrutinee, let-else, if let, tuples, loops.
// EXPECT: b 1
// EXPECT: live 0
// EXPECT: c 4
// EXPECT: live 0
// EXPECT: a
// EXPECT: live 0
// EXPECT: nb 7
// EXPECT: live 0
// EXPECT: na 9 10
// EXPECT: live 0
// EXPECT: g 11
// EXPECT: live 0
// EXPECT: h 14
// EXPECT: live 0
// EXPECT: f 15
// EXPECT: k 17
// EXPECT: live 0
// EXPECT: le 18 live 0
// EXPECT: il 20
// EXPECT: live 0
// EXPECT: tn 22
// EXPECT: live 0
// EXPECT: t0 25
// EXPECT: live 0
// EXPECT: t2 30
// EXPECT: live 0
// EXPECT: live 0
// EXPECT: w
// EXPECT: dots
// EXPECT: live 0
static var LIVE: i64 = 0;
static var NEXT: i64 = 0;
struct T { id: i64 }
fn mk() -> T { NEXT += 1; LIVE += 1; T { id: NEXT } }
impl Drop for T { fn drop(inout self) { LIVE -= 1; } }
enum E { A(T), B(T, T), C { x: T, y: T }, N }
enum O { In(E, T), Z }
struct S { e: E, k: T }

fn arms(k: i64) {
    let e = if k == 0 { E::B(mk(), mk()) } else if k == 1 { E::C { x: mk(), y: mk() } }
        else { E::A(mk()) };
    match e {
        E::B(a, _) => println(f"b {a.id}"),
        E::C { y, .. } => println(f"c {y.id}"),
        E::A(_) => println("a"),
        E::N => {}
    }
}

fn nested(k: i64) {
    let o = if k == 0 { O::In(E::B(mk(), mk()), mk()) } else { O::In(E::A(mk()), mk()) };
    match o {
        O::In(E::B(_, b), _) => println(f"nb {b.id}"),
        O::In(E::A(a), t) => println(f"na {a.id} {t.id}"),
        _ => println("other"),
    }
}

fn guard(k: i64) {
    let e = E::B(mk(), mk());
    match e {
        E::B(a, _) if k == 0 => println(f"g {a.id}"),
        E::B(_, b) => println(f"h {b.id}"),
        _ => {}
    }
}

fn field_scrut() {
    let s = S { e: E::B(mk(), mk()), k: mk() };
    match s.e { E::B(a, _) => println(f"f {a.id}"), _ => {} }
    println(f"k {s.k.id}");
}

fn letelse() -> i64 {
    let e = E::B(mk(), mk());
    let E::B(a, _) = e else { return 0; };
    a.id
}

fn iflet() {
    let e = E::C { x: mk(), y: mk() };
    if let E::C { x, .. } = e { println(f"il {x.id}"); } else { println("no"); }
}

fn tuple_nested() {
    let t = ((mk(), mk()), mk());
    let ((a, _), _) = t;
    println(f"tn {a.id}");
}

fn tuple_match(k: i64) {
    let t = (mk(), mk(), mk());
    match k {
        0 => { let (a, _, _) = t; println(f"t0 {a.id}"); },
        _ => { let (_, _, c) = t; println(f"t2 {c.id}"); }
    }
}

fn loop_break() {
    var i = 0;
    while i < 3 {
        let e = E::B(mk(), mk());
        match e { E::B(a, _) => { if a.id > 0 { i += 1; continue; } }, _ => break }
    }
}

fn whole_wild(k: i64) {
    let e = E::B(mk(), mk());
    match e { E::A(t) => println(f"{t.id}"), _ => println("w") }
    let f = E::B(mk(), mk());
    match f { E::B(_, _) => println("dots"), _ => {} }
}

fn main(gpa: Gpa) -> i32 {
    arms(0); println(f"live {LIVE}");
    arms(1); println(f"live {LIVE}");
    arms(2); println(f"live {LIVE}");
    nested(0); println(f"live {LIVE}");
    nested(1); println(f"live {LIVE}");
    guard(0); println(f"live {LIVE}");
    guard(1); println(f"live {LIVE}");
    field_scrut(); println(f"live {LIVE}");
    println(f"le {letelse()} live {LIVE}");
    iflet(); println(f"live {LIVE}");
    tuple_nested(); println(f"live {LIVE}");
    tuple_match(0); println(f"live {LIVE}");
    tuple_match(1); println(f"live {LIVE}");
    loop_break(); println(f"live {LIVE}");
    whole_wild(0); println(f"live {LIVE}");
    0
}
