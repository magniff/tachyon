// 0.15: derived Debug and Clone of fields whose types are std's
// (Vec, Option, Result, HashMap): their Debug comes from std/fmt.tach,
// their Clone from std/clone.tach.
// EXPECT: R { name: "x", v: [1, 2], o: Some(3), r: Err("bad") }
// EXPECT: R { name: "x", v: [1, 2, 9], o: Some(3), r: Err("bad") } 2
// EXPECT: A([R { name: "x", v: [1, 2], o: None, r: Ok(4) }]) B
// EXPECT: M { m: {1: 2} } 1
use std::HashMap;

#[derive(Debug, Clone)]
struct R { name: [u8], v: Vec<i64>, o: Option<i64>, r: Result<i64, [u8]> }

#[derive(Debug)]
enum E { A(Vec<R>), B }

#[derive(Debug, Clone)]
struct M { m: HashMap<i64, i64> }

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let r = R { name: "x", v, o: Some(3), r: Err("bad") };
    let mut s = r.clone();
    s.v.push(9);
    println(f"{r:?}");
    println(f"{s:?} {r.v.len()}");
    let mut w: Vec<R> = Vec::new_in(gpa);
    w.push(R { name: "x", v: r.v.clone(), o: None, r: Ok(4) });
    println(f"{E::A(w):?} {E::B:?}");
    let mut m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(1, 2);
    let n = M { m }.clone();
    println(f"{n:?} {n.m.len()}");
}
