// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: on the second iteration sl (from the first) is used after the push
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    let u: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var sl: [i64] = u.as_slice();
    for i in 0..3 {
        v.push(i);
        if i > 0 { println(sl[0]); }
        sl = v.as_slice();
    }
    0
}
