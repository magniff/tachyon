// sem-own: a nested match with a wildcard inner: the whole value dropped once, after.
// EXPECT: some
// EXPECT: end
// EXPECT: drop 4
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let o: Option<Option<D>> = Some(Some(mk(4, gpa)));
    match o { Some(_) => println("some"), None => {} }
    println("end");
}
