// sem-own: a match binding one payload field of a two-field variant moves
// that field; the rest of the value (payload 2) must still be dropped once,
// at the enum's scope end.
// EXPECT: drop 3
// EXPECT: end
// EXPECT: drop 2
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
enum E { A(D), B(D, D), N }

fn main(gpa: Gpa) {
    {
        let a = E::A(mk(1, gpa));
        let n = E::N;
        let b = E::B(mk(2, gpa), mk(3, gpa));
        match b { E::B(_, x) => {}, _ => {} }
        println("end");
    }
}
