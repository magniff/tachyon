// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(v)`; s grows while it is used
// ERROR: error[own.conflict]
fn f(v: Vec<Option<str>>) -> str { v[0].unwrap() }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<Option<str>> = Vec::new_in(gpa); v.push(Some(w));
    let r = f(v);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
