// EXPECT: sizes ok
// EXPECT: patterns ok
// EXPECT: records ok
// EXPECT: bytes: a ab b ba
// EXPECT: chaos 3000 sum 4498500
// 0.14: std::sort is an introsort. Every size up to a few hundred (the
// insertion sort, the partition and their boundaries), the inputs that
// break simple quicksorts (sorted, reversed, all equal, organ pipe, few
// keys), records by key, byte strings, and a cmp that is not an order
// (which must not leave the slice or lose elements; its partitions are
// lopsided enough to reach the heapsort).
use std::{Ord, Vec, sort};

struct Rng { x: u64 }

impl Rng {
    fn next(inout self) -> i64 {
        self.x = self.x * 6364136223846793005u64 + 1442695040888963407u64;
        (self.x >> 33) as i64
    }
}

// The input of a pattern: n elements.
fn fill(v: inout Vec<i64>, pattern: i64, n: i64, rng: inout Rng) {
    v.clear();
    for i in 0..n {
        let x = if pattern == 0 {
            rng.next() % 1000000
        } else if pattern == 1 {
            i
        } else if pattern == 2 {
            n - i
        } else if pattern == 3 {
            7
        } else if pattern == 4 {
            if i < n / 2 { i } else { n - i }
        } else if pattern == 5 {
            rng.next() % 3
        } else if pattern == 6 {
            if i % 2 == 0 { i } else { n + i }
        } else {
            if i % 50 == 0 { rng.next() } else { i }
        };
        v.push(x);
    }
}

// Whether s is sorted and holds the same multiset as before (by sum and
// sum of squares, wrapping).
fn check(s: [i64], sum: i64, squares: i64) -> bool {
    var a = 0;
    var b = 0;
    for i in 0..s.len {
        if i > 0 && s[i - 1] > s[i] {
            return false;
        }
        a += s[i];
        b += s[i] * s[i];
    }
    a == sum && b == squares
}

fn sorts(v: inout Vec<i64>) -> bool {
    let s = v.as_mut_slice();
    var sum = 0;
    var squares = 0;
    for x in s {
        sum += x;
        squares += x * x;
    }
    sort(s);
    check(s, sum, squares)
}

struct Rec { key: i64, id: i64 }

impl Ord for Rec {
    fn cmp(self, other: Rec) -> i64 {
        self.key - other.key
    }
}

// Not an order: the answer depends on a counter. (0.16: Ord::cmp is
// #[pure], so the counter is not a static: each key points at it, and a
// write through a raw pointer is unsafe, not global.)
struct Chaos { x: i64, calls: *i64 }

impl Ord for Chaos {
    fn cmp(self, other: Chaos) -> i64 {
        unsafe {
            *self.calls += 1;
            (*self.calls * 7919 + self.x - other.x) % 3 - 1
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    var rng = Rng { x: 12345u64 };
    var v: Vec<i64> = Vec::new_in(gpa);
    var ok = true;
    for n in 0..300 {
        fill(&v, n % 8, n, &rng);
        ok = ok && sorts(&v);
    }
    println(if ok { "sizes ok" } else { "sizes WRONG" });
    for p in 0..8 {
        for n in [1000, 4099, 50000] {
            fill(&v, p, n, &rng);
            ok = ok && sorts(&v);
        }
    }
    println(if ok { "patterns ok" } else { "patterns WRONG" });

    var r: Vec<Rec> = Vec::new_in(gpa);
    for i in 0..20000 {
        r.push(Rec { key: rng.next() % 100, id: i });
    }
    let rs = r.as_mut_slice();
    sort(rs);
    var ids = 0;
    for i in 0..rs.len {
        if i > 0 && rs[i - 1].key > rs[i].key {
            ok = false;
        }
        ids += rs[i].id;
    }
    println(if ok && ids == 19999 * 10000 { "records ok" } else { "records WRONG" });

    var words = ["ba", "b", "ab", "a"];
    sort(&words[..]);
    print("bytes:");
    for w in words {
        print(" ");
        print(w);
    }
    println("");

    var c: Vec<Chaos> = Vec::new_in(gpa);
    var calls = 0;
    for i in 0..3000 {
        c.push(Chaos { x: i, calls: &calls as *i64 });
    }
    sort(c.as_mut_slice());
    var total = 0;
    for x in c.as_slice() {
        total += x.x;
    }
    print("chaos ");
    std::print_int(c.len());
    print(" sum ");
    std::print_int(total);
    println("");
    0
}
