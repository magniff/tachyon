// C interoperability: an extern "C" block of functions and globals,
// extern "C" definitions (called by C by name, and passed as callbacks),
// globals defined here and used by C, #[repr(C)] structs, enums and unions
// laid out and passed as C does (packed and aligned ones too).
// CSOURCE: tests/c/interop.c
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn c_bump() -> i64;
    fn c_read_total() -> i64;
    fn c_add_total(k: i64);
    fn c_call_square(x: i64) -> i64;
    fn c_next_color(c: Color) -> Color;
    fn c_area(s: Shape) -> f64;
    fn c_square_shape(side: f64) -> Shape;
    fn c_bits_of(b: Bits) -> i64;
    fn c_layout(which: i32) -> i64;
    fn c_packed_sum(p: Packed) -> i64;
    fn qsort(base: *u8, n: u64, size: u64, cmp: extern "C" fn(*u8, *u8) -> i32);
    static var c_counter: i64;
    static c_scale: f64;
}

extern "C" static var t_total: i64 = 100;

extern "C" fn t_square(x: i64) -> i64 {
    x * x
}

extern "C" fn by_i32(a: *u8, b: *u8) -> i32 {
    unsafe { *(a as *i32) - *(b as *i32) }
}

#[repr(C)]
enum Color { Red, Green = 10, Blue }

#[repr(C)]
enum Shape { Circle(f64), Rect(f64, f64), Nothing }

#[repr(C)]
union Bits { i: i64, d: f64, bytes: [u8; 8] }

#[repr(C, packed)]
struct Packed { a: u8, b: i32, c: u16 }

#[repr(C, align(16))]
struct Aligned { x: i32 }

#[repr(C)]
struct HoldsAligned { a: u8, b: Aligned, c: u8 }

#[repr(u8)]
enum Small { A = 1, B = 200 }

fn main() {
    unsafe { printf(c"%ld %ld %.1f\n", c_bump(), c_counter, c_scale); }
    c_counter = 7;
    unsafe {
        printf(c"%ld\n", c_bump());
        printf(c"%ld ", c_read_total());
        c_add_total(5);
    }
    t_total += 1;
    unsafe {
        printf(c"%ld %ld\n", t_total, c_read_total());
        printf(c"%ld %ld\n", c_call_square(9), t_square(3));
        printf(c"%d %d\n", c_next_color(Color::Red) as i32, c_next_color(Color::Blue) as i32);
        printf(c"%.1f %.1f %.1f\n", c_area(Shape::Circle(2.0)), c_area(Shape::Rect(3.0, 4.0)),
            c_area(c_square_shape(1.5)));
    }
    let b = Bits { d: 1.0 };
    unsafe { printf(c"%lx %d\n", c_bits_of(b), b.bytes[7] as i32); }
    let p = Packed { a: 1, b: 1000, c: 7 };
    unsafe { printf(c"%ld %ld\n", c_packed_sum(p), p.b as i64); }
    for i in 0i32..5 {
        unsafe { printf(c"%ld,", c_layout(i)); }
    }
    unsafe { printf(c"\n"); }
    var xs: [i32; 5] = [5, -2, 9, 0, 3];
    unsafe {
        qsort(&xs as *u8, 5, 4, by_i32);
        printf(c"%d %d %d %d %d %d\n", xs[0], xs[1], xs[2], xs[3], xs[4], Small::B as i32);
    }
}

// EXPECT: 41 41 2.5
// EXPECT: 8
// EXPECT: 100 106 106
// EXPECT: 82 9
// EXPECT: 10 0
// EXPECT: 12.0 12.0 2.2
// EXPECT: 3ff0000000000000 63
// EXPECT: 1008 1000
// EXPECT: 715,1616,4832,2408,8,
// EXPECT: -2 0 3 5 9 200
