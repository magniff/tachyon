// 0.16: Arena::none() (the constant a static starts with) has no memory:
// allocating from it stops the program; freeing an empty container on it
// is nothing.
// EXPECT: 0 0
// EXIT: 101
// STDERR: the arena has no memory: it is Arena::none()
static mut V: Vec<i64, Arena> = Vec::new_in(Arena::none());

fn main() {
    let a = Arena::none();
    V.free();
    println(f"{a.used()} {a.chunk_bytes()}");
    V.push(1);
    println("not reached");
}
