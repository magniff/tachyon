// sem-own: `?` moving an owned error out: the error dropped once, by the caller.
// EXPECT: drop 1
// EXPECT: err 9
// EXPECT: drop 9
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn g(gpa: Gpa) -> Result<i64, D> { Err(mk(9, gpa)) }

fn f(gpa: Gpa) -> Result<i64, D> {
    let a = mk(1, gpa);
    let n = g(gpa)?;
    Ok(n)
}

fn main(gpa: Gpa) {
    match f(gpa) { Ok(x) => println(f"ok {x}"), Err(e) => println(f"err {e.id}") }
}
