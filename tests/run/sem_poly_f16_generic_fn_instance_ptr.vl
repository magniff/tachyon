// a generic instance as a fn(sink R) pointer: each R dropped once
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: 2
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn take<T>(x: sink T) -> i64 { 1 }

fn main() {
    let f: fn(sink R) -> i64 = take::<R>;
    let a = f(R { id: 1 });
    let b = f(R { id: 2 });
    println(f"{a + b}");
}
