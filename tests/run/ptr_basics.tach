// Taking addresses, reading and writing through pointers, pointer to pointer,
// and passing pointers to functions.
// EXPECT: 43 1 4 4.5
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn swap(a: &mut i64, b: &mut i64) {
    let t = *a;
    *a = *b;
    *b = t;
}

fn set_via(pp: **i64, v: i64) {
    unsafe { **pp = v; }
}

fn main() -> i64 {
    let x: i64 = 1;
    let y: i64 = 2;
    swap(&mut x, &mut y);
    let p = &mut x;
    let pp = &mut p;
    unsafe {
        set_via(pp, 42);
        **pp = **pp + 1;
    }
    let b: u8 = 250;
    let pb = &mut b;
    unsafe { *pb = *pb + 10; }
    let f: f32 = 1.5;
    let pf = &mut f;
    unsafe {
        *pf = *pf * 3.0;
        printf(c"%ld %ld %d %.1f\n", x, y, b, f);
    }
    0
}
