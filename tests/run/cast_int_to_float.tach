// Every integer type to f32 and f64, at extreme values.
// EXPECT: -128 255 -32768 65535 -2147483648
// EXPECT: 4294967295 -9.2233720368547758e+18 1.8446744073709552e+19 9007199254740992
// EXPECT: -128 255 -32768 65535 -2147483648
// EXPECT: 4294967296 -9.2233720368547758e+18 1.8446744073709552e+19 9007199254740992
// EXPECT: 9.2233720368547779e+18 9.2233720368547758e+18
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: i8 = (0 - 128) as i8;
    let b: u8 = 255;
    let c: i16 = (0 - 32768) as i16;
    let d: u16 = 65535;
    let e: i32 = (0 - 2147483647) as i32 - 1;
    let f: u32 = 4294967295;
    let g: i64 = 0 - 9223372036854775807 - 1;
    let h: u64 = 18446744073709551615;
    let k: u64 = 9007199254740993;
    printf(c"%.17g %.17g %.17g %.17g %.17g\n", a as f64, b as f64, c as f64, d as f64, e as f64);
    printf(c"%.17g %.17g %.17g %.17g\n", f as f64, g as f64, h as f64, k as f64);
    printf(c"%.17g %.17g %.17g %.17g %.17g\n", a as f32, b as f32, c as f32, d as f32, e as f32);
    printf(c"%.17g %.17g %.17g %.17g\n", f as f32, g as f32, h as f32, k as f32);
    let l: u64 = 0x8000000000000401;
    printf(c"%.17g %.17g\n", l as f64, l as f32);
    0
}
