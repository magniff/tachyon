// (0.25, the semantics fuzzer) Two owned temporaries lent to let
// parameters in one statement: the second is rejected, "cannot take
// address of non-lvalue expression", though the program writes no `&`
// and one such temporary is accepted (and two struct literals are); the try: line passes `peek(&t)`,
// which is itself an error (a let argument has no marker).
// EXPECT: 3
// EXPECT: 3

struct T { v: i64 }
impl Drop for T {
    fn drop(inout self) {}
}
fn mk(v: i64) -> T { T { v: v } }
fn peek(t: T) -> i64 { t.v }

fn main() -> i32 {
    let a = peek(mk(1)) + peek(mk(2));
    println(f"{a}");
    println(f"{peek(mk(1)) + peek(mk(2))}");
    0
}
