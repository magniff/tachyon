// (0.20) BTreeMap (the B-tree engine) against a model: random operations
// from seeded generators (insert or update, remove, look up, pop the
// first or the last pair, iterate both ways, ranges, clear) on maps of
// keys below K, the model an array (key -> value, or -1), from one leaf
// to trees of height 4; `check` verifies the tree's invariants (node
// lengths, parent links, leaf depth, key order, the count) as it goes.
// Any failure prints a FAIL line. Then a BTreeSet, and owned values
// dropped (--check-alloc).
// FLAGS: --check-alloc
// EXPECT: checksum 0
// EXPECT: set {1, 3, 5} 1 5 3
use std::{BTreeMap, BTreeSet};

fn xorshift(x: inout u64) -> u64 {
    var v = x;
    v ^= v << 13;
    v ^= v >> 7;
    v ^= v << 17;
    x = v;
    v
}

// The model's pairs in [lo, hi): their number and the sum of key * 3 +
// value.
fn model_range(model: Vec<i64>, lo: i64, hi: i64) -> (i64, i64) {
    var n = 0;
    var s = 0;
    for k in lo..hi {
        let v = model.get(k);
        if v >= 0 {
            n += 1;
            s += k * 3 + v;
        }
    }
    (n, s)
}

fn run(seed: u64, ops: i64, keys: i64, gpa: Gpa) {
    var rng = seed;
    var t: BTreeMap<i64, i64> = BTreeMap::new_in(gpa);
    var model: Vec<i64> = Vec::filled_in(keys, -1, gpa);
    var count = 0;
    for step in 0..ops {
        let r = (xorshift(&rng) % 100) as i64;
        let k = (xorshift(&rng) % keys as u64) as i64;
        if r < 45 {
            let old = t.insert(k, step);
            let want = model.get(k);
            match old {
                Some(v) => if v != want { println("FAIL: insert gave a wrong old value"); },
                None => {
                    if want >= 0 { println("FAIL: insert missed a key"); }
                    count += 1;
                }
            }
            model.set(k, step);
        } else if r < 75 {
            let want = model.get(k);
            match t.remove(k) {
                Some(v) => {
                    if v != want { println("FAIL: removed a wrong value"); }
                    count -= 1;
                }
                None => if want >= 0 { println("FAIL: remove missed a key"); },
            }
            model.set(k, -1);
        } else if r < 88 {
            let want = model.get(k);
            match t.get(k) {
                Some(v) => if v != want { println("FAIL: a wrong value"); },
                None => if want >= 0 { println("FAIL: a key of the model not found"); },
            }
        } else if r < 91 {
            let first = r < 90;
            let got = if first { t.pop_first() } else { t.pop_last() };
            var want = -1;
            for j in 0..keys {
                if model.get(j) >= 0 && (want < 0 || !first) {
                    want = j;
                }
            }
            match got {
                Some(e) => {
                    if e.0 != want
                        || e.1 != model.get(e.0) { println("FAIL: popped a wrong pair"); }
                    model.set(e.0, -1);
                    count -= 1;
                }
                None => if want >= 0 { println("FAIL: pop of a non-empty map"); },
            }
        } else if r < 97 {
            let a = (xorshift(&rng) % (keys + 2) as u64) as i64 - 1;
            let b = a + (xorshift(&rng) % 64) as i64;
            var n = 0;
            var s = 0;
            var last = a - 1;
            for (key, v) in t.range(a, b) {
                if key <= last { println("FAIL: a range out of order"); }
                last = key;
                n += 1;
                s += key * 3 + v;
            }
            let lo = if a < 0 { 0 } else { a };
            let hi = if b > keys { keys } else { b };
            let (mn, ms) = if lo < hi { model_range(model, lo, hi) } else { (0, 0) };
            if n != mn || s != ms { println(f"FAIL: range [{a}, {b}): {n} {s} against {mn} {ms}"); }
            var n2 = 0;
            for _ in t.range_inclusive(a, b) { n2 += 1; }
            let extra = if b >= 0 && b < keys && model.get(b) >= 0 { 1 } else { 0 };
            if n2 != n + extra { println("FAIL: an inclusive range"); }
        } else if r < 99 {
            var n = 0;
            var last = -1;
            for (key, v) in t.iter() {
                if key <= last || model.get(key) != v { println("FAIL: forward iteration"); }
                last = key;
                n += 1;
            }
            var it = t.iter();
            var prev = keys;
            loop {
                match it.next_back() {
                    Some(e) => {
                        if e.0 >= prev { println("FAIL: backward iteration"); }
                        prev = e.0;
                        n -= 1;
                    }
                    None => break,
                }
            }
            if n != 0 { println("FAIL: iteration count"); }
        } else if xorshift(&rng) % 10 == 0 {
            t.clear();
            for j in 0..keys { model.set(j, -1); }
            count = 0;
        }
        if t.len() != count { println("FAIL: len"); }
        if step % 499 == 0 {
            let c = t.check();
            if c.len > 0 { println(f"FAIL: {c}"); }
        }
    }
    let c = t.check();
    if c.len > 0 { println(f"FAIL: {c}"); }
    // (emptied by removals from the middle, checked as it shrinks)
    for j in 0..keys {
        let k = (j * 7 + keys / 2) % keys;
        t.remove(k);
        if t.len() % 97 == 0 {
            let c = t.check();
            if c.len > 0 { println(f"FAIL: {c}"); }
        }
    }
    if t.len() != 0 || t.height() != 0 { println("FAIL: an emptied tree keeps nodes"); }
}

fn main(gpa: Gpa) {
    let configs = [(1, 3000, 4), (2, 20000, 30), (3, 30000, 200), (4, 60000, 3000),
        (5, 60000, 20000), (6, 20000, 12)];
    for c in configs {
        run(0x9e3779b97f4a7c15u64 + c.0 as u64, c.1, c.2, gpa);
    }
    // (height 4: 200000 ascending keys, and descending)
    var t: BTreeMap<i64, i64> = BTreeMap::new_in(gpa);
    var u: BTreeMap<i64, i64> = BTreeMap::new_in(gpa);
    for k in 0..200000 {
        t.insert(k, k);
        u.insert(200000 - k, k);
    }
    let c = t.check();
    let d = u.check();
    if c.len > 0 || d.len > 0 || t.height() < 4 || u.height() < 4 {
        println(f"FAIL: sequential trees: {c} {d} {t.height()} {u.height()}");
    }
    println("checksum 0");
    var s: BTreeSet<i64> = BTreeSet::new_in(gpa);
    for x in [5, 1, 3, 1, 5] { s.insert(x); }
    println(f"set {s:?} {s.first().unwrap()} {s.last().unwrap()} {s.len()}");
    // (owned values: dropped with the map and when replaced or removed)
    var w: BTreeMap<i64, Vec<i64>> = BTreeMap::new_in(gpa);
    for k in 0..300 {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(k);
        w.insert(k % 50, v);
    }
    w.remove(7);
    w.pop_first();
}
