// (0.17) Without --trace a failure's message had a note on --trace; (0.18)
// it is one line, its position and message (the run-time checks' messages
// and std's panic).
// EXIT: 101
// STDERR: trace_note.vl:10:13: invalid value 7 for enum Color
enum Color { Red, Green }

fn main() -> i32 {
    let n = 7;
    let c = n as Color;
    std::print_int(c as i64);
    0
}
