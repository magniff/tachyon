// a thread reaching a static var through a generic trait method
// ERROR: [sync.global]: 'thread::spawn' runs a closure on another thread, but it reaches a static var
// XFAIL: DIAG sync.global says 'static mut' and 'without `mut`'
use std::thread;
static var G: i64 = 0;
trait Tick { fn tick(self) -> i64; }
struct A {}
impl Tick for A { fn tick(self) -> i64 { G += 1; G } }
fn run<T: Tick>(t: sink T) -> i64 { t.tick() }

fn main() {
    let h = thread::spawn(sink || run(A {}));
    println(f"{h.join()}");
}
