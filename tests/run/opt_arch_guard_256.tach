// CROSS: x86_64-linux
// EXPECT: 1673 1225
// CHECK-OPT: 2
// ASM(x86_64-linux): tachyon.work:
// ASM(x86_64-linux): vmovdqu
// ASM-NOT(x86_64-linux): :
// ASM(x86_64-linux): vpmovmskb %ymm
// (0.19) Every operation that needs a feature stays under its guard, not
// only an intrinsic's: on x86-64 a 256-bit value lives in a ymm register,
// so its load (vmovdqu) is an AVX instruction. `a` is made without AVX
// (from_bits copies bytes) and is loop-invariant; its load for the
// movemask runs only in some iterations, under detect("avx2"), so LICM
// leaves it there (before, it was hoisted into the preheader: an AVX
// instruction on any CPU). Compiled for x86_64-linux (CROSS), not run; on
// AArch64 the detect is false and the fallback prints the same.
use std::arch::detect;
use std::arch::x86_64::{__m256i, _mm256_movemask_epi8};

#[inline(never)]
fn work(n: i64) -> i64 {
    let a = __m256i::from_bits(v32u8::splat(0x80));
    let mut acc: i64 = 0;
    for i in 0..n {
        if i % 3 == 0 {
            if detect("avx2") {
                acc += _mm256_movemask_epi8(a) as i64 & 1;
            } else {
                acc += 1;
            }
        }
        acc += i;
    }
    acc
}

fn main() {
    println(f"{work(58)} {work(50) - 17}");
}
