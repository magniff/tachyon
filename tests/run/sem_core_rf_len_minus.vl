// i <= len - 1 with len == 0 is i <= -1: false, no index.
// EXPECT: 0
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64], i: i64) -> i64 { if i >= 0 && i <= s.len() - 1 { s[i] } else { 0 } }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s[0..0], 0 + Z));
    0
}
