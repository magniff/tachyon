// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: get_mut result live across insert
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(1, 1);
    if let Some(a) = m.get_mut(1) {
        for i in 2..100 { m.insert(i, i); }
        a[0] += 1;
    }
    println(m.get(1).unwrap());
    0
}
