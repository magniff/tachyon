// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a view of a loop iteration's temporary String receiver kept past it
// XFAIL: SOUNDNESS a view of a temporary receiver escapes the temporary's block: use after free
// ERROR: error[own.escape]
fn main(gpa: Gpa) -> i32 {
    var keep: Vec<str> = Vec::new_in(gpa);
    for i in 0..3 {
        keep.push(String::from_in("abc", gpa).as_str());
    }
    println(f"{keep.get(0)} {keep.get(2)}");
    0
}
