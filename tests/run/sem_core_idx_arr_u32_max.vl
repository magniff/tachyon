// A u32 index of 2^32 - 1.
// EXIT: 101
// STDERR: index out of bounds: index 4294967295, length 3
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3];
    let i: u32 = 4294967295 + Z as u32;
    println(a[i]);
    println("not reached");
    0
}
