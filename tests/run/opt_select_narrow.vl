// Selects of increments at narrow widths wrap like the increment does
// (AArch64's csinc adds at 64 bits, so it is only used for 64-bit values;
// a random program found it).
// EXPECT: 0 255 -128 127 0 -2147483648
// EXPECT: 1 5 9223372036854775807 -9223372036854775808
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn bump8(c: bool, a: u8, b: u8) -> i64 {
    // The u8 result widened in the function: no normalization at a return.
    let r = if c { a } else { b + 1 };
    r as i64
}

fn bumpi8(c: bool, a: i8, b: i8) -> i64 {
    let r = if c { b + 1 } else { a };
    r as i64
}

fn bump32(c: bool, a: i32, b: i32) -> i64 {
    let r = if c { a } else { b + 1 };
    r as i64
}

fn bump64(c: bool, a: i64, b: i64) -> i64 {
    if c { a } else { b + 1 }
}

fn main() -> i32 {
    let f = bump8;
    let g = bumpi8;
    let h = bump32;
    let k = bump64;
    unsafe {
        printf(c"%ld %ld %ld %ld %ld %ld\n", f(false, 7, 255), f(true, 255, 0), g(true, 0, 127),
            g(false, 127, 0), f(false, 0, 255), h(false, 0, 2147483647));
        printf(c"%ld %ld %ld %ld\n", k(false, 0, 0), k(true, 5, 0), k(true, 9223372036854775807, 0),
            k(false, 0, 9223372036854775807));
    }
    0
}
