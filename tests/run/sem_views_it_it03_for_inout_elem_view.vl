// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a slice of the element, the element grown, the slice used
// XFAIL: OVERSTRICT for inout x in &v (D-T3c) is a parser error naming 'inout' as a keyword
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var vv: Vec<Vec<i64>> = Vec::new_in(gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    vv.push(v);
    for inout x in &vv {
        let sl = x.as_slice();
        for i in 0..100 { x.push(i); }
        println(sl[0]);
    }
    0
}
