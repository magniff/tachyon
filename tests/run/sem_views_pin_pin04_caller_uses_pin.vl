// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: the pinned summary views(b) is used by the caller
// ERROR: error[own.conflict]
#[views(b)]
fn pick(a: [u8], b: [u8]) -> [u8] { b }
fn main(gpa: Gpa) -> i32 {
    var x = Buf::new_in(gpa);
    x.push_str("hello");
    let r = pick("a", x.as_slice());
    x.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
