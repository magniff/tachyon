// C returns structs of 16 bytes or less in registers (x0 / rax); here div()
// returns div_t { int quot; int rem; } in one register.
// EXPECT: 3 2
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn div(n: i32, d: i32) -> DivT;
}

#[repr(C)]
struct DivT { quot: i32, rem: i32 }

fn main() -> i64 {
    let r = unsafe { div(17, 5) };
    unsafe { printf(c"%d %d\n", r.quot, r.rem); }
    0
}
