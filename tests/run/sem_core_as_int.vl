// `as` between integers truncates, sign- or zero-extends by the source.
// EXPECT: -17 239 -12817 52719 -1867788817 2427178479 1311768467294899695
// EXPECT: 255 -1 65535 -1 4294967295 -1 18446744073709551615
// EXPECT: -1 255 255 255 255
// EXPECT: -1 4294967295 4294967295 -1 65535
// EXPECT: 2147483648 -2147483648 18446744071562067968 0 0
// EXPECT: 4294967295 44 127
// EXPECT: 1 1 0
// EXPECT: -17 255 18446744073709551615 -1 -1
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let x: i64 = 0x1234567890ABCDEF + Z;
    println(f"{x as i8} {x as u8} {x as i16} {x as u16} {x as i32} {x as u32} {x as u64}");
    let m: i8 = -1 + Z as i8;
    println(f"{m as u8} {m as i16} {m as u16} {m as i32} {m as u32} {m as i64} {m as u64}");
    let u: u8 = 255 + Z as u8;
    println(f"{u as i8} {u as i16} {u as i32} {u as i64} {u as u64}");
    let w: u32 = 4294967295 + Z as u32;
    println(f"{w as i32} {w as i64} {w as u64} {w as i8} {w as u16}");
    let n: i32 = -2147483648 + Z as i32;
    println(f"{n as u32} {n as i64} {n as u64} {n as i16} {n as u8}");
    let chain = ((-1 + Z) as i32) as u32 as i64;
    println(f"{chain} {((300 + Z) as u8) as i64} {((-129 + Z) as i8) as i64}");
    let b = Z == 0;
    println(f"{b as i64} {b as u8} {!b as i32}");
    // constants
    println(f"{0x1234567890ABCDEF as i8} {-1 as u8} {-1 as u64} {255 as i8} {4294967295 as i32}");
    0
}
