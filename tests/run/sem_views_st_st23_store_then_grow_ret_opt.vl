// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: Some(view of s) returned after s grows
// ERROR: error[own.conflict]
fn f(s: inout String) -> Option<str> { let w = Some(s.as_str()); s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"); w }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    println(f(&s).unwrap());
    0
}
