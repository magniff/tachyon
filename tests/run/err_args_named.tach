// The errors of named arguments (0.15), each with what to write: out of
// parameter order, an unknown name, a parameter given twice or by
// position already, a missing one, `self`, a trait's function, a call of
// a closure.
// ERROR: named argument 'b' is out of order: named arguments follow the parameters of 'f'
// ERROR: help: write 'f(1, b: 3, c: 2)'
// ERROR: function 'scale' has no parameter 'factr'
// ERROR: help: did you mean 'factor'?
// ERROR: parameter 'b' is given by position already
// ERROR: parameter 'c' is given twice
// ERROR: missing argument 'b' of 'f' (it has no default)
// ERROR: help: give it: 'f(1, b: VALUE)'
// ERROR: 'self' cannot be named: the receiver is the value before '.'
// ERROR: 'P::go' is a trait's function: its arguments are positional
// ERROR: help: write '1' without its name
// ERROR: named argument 'x': only the calls of functions and methods name their arguments
// ERROR-COUNT: 8
trait Go { fn go(self: *Self, n: i64) -> i64; }

struct P { x: i64 }

impl Go for P {
    fn go(self: *P, n: i64) -> i64 { n }
}

impl P {
    fn m(self: *P, k: i64 = 1) -> i64 { k }
}

fn f(a: i64, b: i64, c: i64 = 3) -> i64 {
    a + b + c
}

fn scale(value: i64, factor: i64 = 2) -> i64 {
    value * factor
}

fn main() {
    f(1, c: 2, b: 3);
    scale(1, factr: 3);
    f(1, 2, b: 3);
    f(1, 2, c: 3, c: 4);
    f(1);
    let p = P { x: 1 };
    p.m(self: 2);
    p.go(n: 1);
    let k = |x: i64| x;
    k(x: 1);
}
