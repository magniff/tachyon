// (0.25) An `inout self` method on a let local or a field of one, an
// inherent or a trait method, directly or through a generic `T: Trait`
// with `&c`: own.readonly.
struct C { n: i64 }
impl C { fn inc(inout self) { self.n += 1; } }
trait Inc { fn up(inout self); }
impl Inc for C { fn up(inout self) { self.n += 1; } }
struct O { c: C }
fn go<T: Inc>(t: inout T) { t.up(); }
fn main() {
    let c = C { n: 1 };
    c.inc();
    let o = O { c: C { n: 1 } };
    o.c.inc();
    let d = C { n: 1 };
    d.up();
    let e = C { n: 1 };
    go(&e);
    println(f"{c.n} {o.c.n} {d.n} {e.n}");
}
// ERROR: 'c.inc()' changes 'c', a let binding
// ERROR: 'o.c.inc()' changes 'o', a let binding
// ERROR: 'd.up()' changes 'd', a let binding
// ERROR: '&e' changes 'e', a let binding
