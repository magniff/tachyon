// a closure given to a user generic function stores a local into a capture
// ERROR: [own.escape]: the closure stores a view of 's'
fn twice<F: FnMut(i64)>(f: F) { var g = f; g(1); g(2); }

fn main(gpa: Gpa) {
    var saved: Vec<str> = Vec::new_in(gpa);
    twice(|i: i64| { let s = String::from_in("t", gpa); saved.push(s.as_str()); });
    println(f"{saved:?}");
}
