// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: abcd (a closure given a by-reference let param's view)
// XFAIL: OVERSTRICT a closure does not satisfy Fn(E) -> [u8] when E is a borrowed let parameter: 'Fn(let E)'
// EXPECT: abcd 7
struct E { name: [u8; 4], len: i64 }
fn nm(e: E) -> [u8] { e.name[..e.len] }
fn apply<F: Fn(E) -> [u8]>(f: F, e: E) -> [u8] { f(e) }
fn clobber() -> i64 { let z = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }
fn main() -> i32 {
    let e = E { name: ['a', 'b', 'c', 'd'], len: 4 };
    let r = apply(|x| nm(x), e);
    let k = clobber();
    println(f"{r} {k}");
    0
}
