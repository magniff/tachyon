// XFAIL: SOUNDNESS a captured Vec passed as &v to an inout [i64] segfaults at -O0, internal error at -O2
// a closure that captures a Vec and passes it as an inout slice (`&v` where `inout [i64]` is wanted)
// EXPECT: 5
fn bump(s: inout [i64]) { s[0] += 5; }
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); v.push(0); let f = || bump(&v); f(); println(f"{v[0]}"); }
