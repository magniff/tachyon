// 0.15: a derive needs its trait on every field: the error is at the
// field, and names it (an enum's by its variant and index); a float
// field has no Hash. (S has ==, comparing its [u8] by bytes; a union
// has none.) (0.17: S owns nothing, so it is Clone without an impl, and
// D derives it.)
// ERROR: cannot derive Hash for 'B': field 'w' of type 'f64' has no Hash
// ERROR: floats have no Hash (NaN is not equal to itself)
// ERROR: cannot derive Eq for 'E': field 1 of 'E::V' of type 'U' has no ==
// ERROR: cannot derive Debug for 'F': field 's' of type 'S' has no Debug
// ERROR: cannot derive Ord for 'F': field 's' of type 'S' has no Ord
// ERROR: cannot derive Debug for 'F': field 'pair' of type '(S, i64)' has no Debug
// ERROR: cannot derive Ord for 'F': field 'pair' of type '(S, i64)' has no Ord
// ERROR-COUNT: 6
#[derive(Hash, Eq)]
struct B { id: i64, w: f64 }

struct S { s: [u8] }

#[derive(Eq, Clone)]
enum D { V(i64, S), W }

union U { a: i64, b: f64 }

#[derive(Eq)]
enum E { V(i64, U), W }

#[derive(Debug, Ord)]
struct F { s: S, pair: (S, i64) }

fn main() {
}
