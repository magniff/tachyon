// (0.25) Other implicit conversions of a captured name inside a closure:
// a let parameter (passed by reference), a receiver, an f-string hole, an array where
// a slice goes.
// EXPECT: 3 3 abc 5 2
struct P { x: i64, y: i64 }
fn sum(p: P) -> i64 { p.x + p.y }
fn first(s: [i64]) -> i64 { s[0] }
impl P {
    fn total(self) -> i64 { self.x + self.y }
}
fn main(gpa: Gpa) {
    let p = P { x: 1, y: 2 };
    let s = String::from_in("abc", gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    v.push(6);
    let a = [2, 4];
    let f1 = || sum(p);
    let f2 = || p.total();
    let f3 = || f"{s}";
    let f4 = || first(v);
    let f5 = || first(a);
    println(f"{f1()} {f2()} {f3()} {f4()} {f5()}");
}
