// an impl taking 'sink self' where the trait says 'self': a let caller would lose its value
// ERROR: [type error]: 'get' does not have the signature trait 'G' declares: expect
trait G { fn get(self) -> i64; }
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
impl G for R { fn get(sink self) -> i64 { self.id } }
fn twice<T: G>(x: T) -> i64 { x.get() + x.get() }

fn main() {
    let r = R { id: 1 };
    println(f"{twice(r)}");
}
