// 0.16: while an arena is lent to a scope, allocating from it stops the
// program (the scope rewinds it when it ends).
// FLAGS: --no-ambient-gpa
// EXPECT: in the scope
// EXIT: 101
// STDERR: the arena is lent to a scope: allocate from the scope's arena
fn main(gpa: Gpa) {
    let a = Arena::new_in(gpa);
    let mut v: Vec<i64, Arena> = Vec::new_in(a);
    a.scope(|s: ScopedArena| {
        println("in the scope");
        v.push(1);
    });
    println("not reached");
}
