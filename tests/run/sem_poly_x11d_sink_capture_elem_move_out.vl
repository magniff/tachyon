// a sink closure capturing a borrowed for-variable moves it out
// ERROR: [own.move_out]: cannot move 'x'
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn eat(r: sink R) -> i64 { r.id }

fn main(gpa: Gpa) {
    var vs: Vec<R> = Vec::new_in(gpa);
    vs.push(R { id: 1 });
    for x in vs { let c = sink || eat(x); println(f"{c()}"); }
    println("end");
}
