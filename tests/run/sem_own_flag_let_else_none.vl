// sem-own: let-else on None: the else returns; nothing to drop, nothing leaked.
// EXPECT: r -1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn f(o: sink Option<D>, gpa: Gpa) -> i64 {
    let k = mk(9, gpa);
    let Some(d) = o else { std::forget(k); return -1; };
    d.id
}

fn main(gpa: Gpa) {
    println(f"r {f(None, gpa)}");
    println("end");
}
