// `&f(x)` where it is evaluated or not (0.18.1, the eval's task 15): the
// other side of `||`/`&&`, a match arm's value, a closure's body, gets its
// temporaries in a block of its own; `&pool[a..b]` where `&[u8]` is
// expected is a reference to a temporary slice. Nothing leaks.
// FLAGS: --check-alloc
// EXPECT: 3 0 -1 0
enum Val { Str([u8]), Int(i64), Null }
struct T { v: Vec<i64> }
impl T { fn val(self, i: i64) -> Val { Val::Int(self.v[i]) } }

fn cmp_vals(a: Val, b: Val) -> i64 {
    match (a, b) {
        (Val::Int(x), Val::Int(y)) => x - y,
        _ => 0,
    }
}

fn count(t: T, ord: Vec<i64>) -> i64 {
    let n = ord.len();
    var groups = 0;
    for i in 0..n + 1 {
        if i == 0 || i == n || cmp_vals(t.val(ord[i - 1]), t.val(ord[i])) != 0 { groups += 1; }
    }
    groups
}

fn pick(t: T, k: i64) -> i64 {
    match k {
        0 => cmp_vals(t.val(0), t.val(1)),
        _ => 7,
    }
}

fn sl(pool: [u8]) -> i64 { cmp_of(&pool[0..2], &pool[1..3]) }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1); v.push(1); v.push(2);
    let t = T { v: v };
    var ord: Vec<i64> = Vec::new_in(gpa);
    ord.push(0); ord.push(1); ord.push(2);
    var keys: Vec<i64> = Vec::new_in(gpa);
    keys.push(2); keys.push(0); keys.push(1);
    keys.sort_by(|a, b| cmp_vals(t.val(*a), t.val(*b)));
    println(f"{count(t, ord)} {pick(t, 0)} {sl("abcd")} {keys[0]}");
}
