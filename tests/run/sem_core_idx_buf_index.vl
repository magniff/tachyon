// The bytes of a Buf indexed past its length (inside the capacity).
// EXIT: 101
// STDERR: index out of bounds: index 5, length 5
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var b = Buf::new_in(gpa);
    b.push_str("hello");
    let s = b.as_slice();
    println(s[5 + Z]);
    println("not reached");
    0
}
