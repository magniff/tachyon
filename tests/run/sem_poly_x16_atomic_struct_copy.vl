// a struct holding an atomic is move-only too: a copy would not be shared
// ERROR: [own.moved]: 'c.a' is used here after 'c' moved
use std::sync::atomic::{AtomicI64, Ordering};
struct C { a: AtomicI64 }

fn main() {
    let c = C { a: AtomicI64::new(1) };
    let d = c;
    d.a.fetch_add(1, Ordering::SeqCst);
    println(f"{c.a.load(Ordering::SeqCst)} {d.a.load(Ordering::SeqCst)}");
}
