// a generic F: FnMut(inout Vec<[i64]>, [i64]) that stores its view argument, the source dropped
// ERROR: [own.escape]: 'all' is used here, but 'v', which it views, was dropped
fn run<F: FnMut(inout Vec<[i64]>, [i64])>(f: sink F, d: inout Vec<[i64]>, s: [i64]) { f(&d, s); }

fn main(gpa: Gpa) {
    var all: Vec<[i64]> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..10 { v.push(i + 100); }
        run(|d: inout Vec<[i64]>, s: [i64]| d.push(s), &all, v.as_slice());
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i); }
    println(f"{all[0][3]}");
}
