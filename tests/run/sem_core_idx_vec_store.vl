// A store to v[len] is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index 1, length 1
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v[1 + Z] = 5;
    println(v[0]);
    println("not reached");
    0
}
