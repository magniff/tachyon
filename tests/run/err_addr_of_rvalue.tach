// `&(1 + 2)` takes a temporary (0.18.1, addr_of_temporary.tach); one
// after a call in its statement does not (the call could see the order
// change), and the error's try: names it first.
// ERROR: cannot take address of non-lvalue expression
// ERROR: try: let t = P { x: one() }; get(one(), &t) + *q
struct P { x: i64 }

fn one() -> i64 { 1 }

fn get(n: i64, p: &P) -> i64 { n + p.x }

fn main() -> i64 {
    let q = &(1 + 2);
    get(one(), &P { x: one() }) + *q
}
