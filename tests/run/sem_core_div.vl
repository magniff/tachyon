// x / 0 == 0, x % 0 == x, MIN / -1 == MIN, MIN % -1 == 0 at every width,
// constant and at run time; truncation and the sign of the dividend.
// EXPECT: 0 10 0 -10
// EXPECT: 0 -7 0 250
// EXPECT: 0 -700 0 65000
// EXPECT: 0 -70000 0 4000000000
// EXPECT: 0 18446744073709551615 0 -7
// EXPECT: -128 0 -32768 0
// EXPECT: -2147483648 0 -9223372036854775808 0
// EXPECT: -128 0 -9223372036854775808 0
// EXPECT: -3 -1 -3 1 3 -1
// EXPECT: -3 -1 -1 -3 0 -7 1 -3
// EXPECT: 9223372036854775807 5 6148914691236517205
// EXPECT: 0 9 -9223372036854775808
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let z = Z;
    // by zero, constant
    println(f"{10 / 0} {10 % 0} {-10 / 0} {-10 % 0}");
    // by zero, run time, every width
    let i8v: i8 = -7 + z as i8; let u8v: u8 = 250 + z as u8;
    let i16v: i16 = -700 + z as i16; let u16v: u16 = 65000 + z as u16;
    let i32v: i32 = -70000 + z as i32; let u32v: u32 = 4000000000 + z as u32;
    let u64v: u64 = 18446744073709551615 + z as u64;
    println(f"{i8v / z as i8} {i8v % z as i8} {u8v / z as u8} {u8v % z as u8}");
    println(f"{i16v / z as i16} {i16v % z as i16} {u16v / z as u16} {u16v % z as u16}");
    println(f"{i32v / z as i32} {i32v % z as i32} {u32v / z as u32} {u32v % z as u32}");
    println(f"{u64v / z as u64} {u64v % z as u64} {(-7 + z) / z} {(-7 + z) % z}");
    // MIN / -1
    let m1 = -1 + z;
    let n8: i8 = -128 + z as i8; let n16: i16 = -32768 + z as i16; let n32: i32 = -2147483648 + z as i32;
    let n64: i64 = -9223372036854775807 - 1 + z;
    println(f"{n8 / m1 as i8} {n8 % m1 as i8} {n16 / m1 as i16} {n16 % m1 as i16}");
    println(f"{n32 / m1 as i32} {n32 % m1 as i32} {n64 / m1} {n64 % m1}");
    let c8: i8 = -128; let c64: i64 = -9223372036854775807 - 1;
    println(f"{c8 / -1} {c8 % -1} {c64 / -1} {c64 % -1}");
    // truncation and signs
    println(f"{-7 / 2} {-7 % 2} {7 / -2} {7 % -2} {-7 / -2} {-7 % -2}");
    let s = -7 + z;
    println(f"{s / 2} {s % 2} {s / 4} {s % 4} {s / 8} {s % 8} {s / -4} {s % -4}");
    let big: u64 = 18446744073709551615 + z as u64;
    println(f"{big / 2} {big % 10} {big / 3}");
    // compound
    var q = 9 + z; q /= z; var r = 9 + z; r %= z; var t = n64; t /= m1;
    println(f"{q} {r} {t}");
    0
}
