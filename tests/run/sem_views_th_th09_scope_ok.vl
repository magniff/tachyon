// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 3 hello
// EXPECT: 3 hello
use std::thread;
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    v.push(s.as_str());
    v.push(s.as_str());
    let n = thread::scope(|sc| {
        let a = sc.spawn(|| v.len());
        a.join()
    });
    println(f"{n} {v.get(0)}");
    0
}
