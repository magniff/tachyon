// sem-own (iterator stopgap): for over a Vec of tuples with owned parts, destructured, part kept.
// ERROR: own.
use std::HashMap;
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn two(gpa: Gpa) -> Vec<D> {
    var w: Vec<D> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn eat(d: sink D) {}
impl Eq for D { fn eq(self, other: D) -> bool { self.id == other.id } }
impl Ord for D { fn cmp(self, other: D) -> i64 { self.id - other.id } }
fn gcollect<T>(s: [T], gpa: Gpa) -> Vec<T> { s.iter().collect_in(gpa) }

fn gkeep<T>(s: [T], gpa: Gpa) -> Vec<T> {
    var k: Vec<T> = Vec::new_in(gpa); for x in s.iter() { k.push(x); } k
}

fn gfirst<T>(s: [T]) -> T { s[0] }
fn gvget<T>(v: Vec<T>) -> T { v.get(0) }

fn main(gpa: Gpa) {
    let w = two(gpa);
    var t: Vec<(i64, D)> = Vec::new_in(gpa);
    t.push((1, mk(7, gpa)));
    var keep: Vec<D> = Vec::new_in(gpa);
    for (i, d) in t.iter() { keep.push(d); }
}
