// Entry facts (0.18.1, middle::entryfacts): a function no caller inlines
// takes its checked requires as facts at its entry, since every direct
// call checks them first: `at`'s bounds check goes. A function whose
// address is taken (`picked`, called through a fn value too) or that C
// calls (`exported`) assumes nothing: their checks stay. And (range) x % n
// with n > 0 is below n: `bucket`'s check goes without any clause.
// EXPECT: 3 4 5 6 7 7 1
// CHECK: fn at:
// CHECK-NOT: rt.panic
// CHECK: fn picked:
// CHECK: rt.panic
// CHECK: fn exported:
// CHECK: rt.panic
// CHECK: fn bucket:
// CHECK-NOT: rt.panic
// CHECK: fn main:

#[inline(never)]
fn at(v: Vec<i64>, i: i64) -> i64
    requires 0 <= i && i < v.len()
{
    v[i]
}

#[inline(never)]
fn picked(v: Vec<i64>, i: i64) -> i64
    requires 0 <= i && i < v.len()
{
    v[i]
}

extern "C" fn exported(i: i64) -> i64
    requires 0 <= i && i < 4
{
    let a: [i64; 4] = [3, 5, 6, 8];
    a[i]
}

#[inline(never)]
fn bucket(v: Vec<i64>, x: u64) -> i64 {
    let n = v.len();
    if n > 0 {
        v[(x % (n as u64)) as i64]
    } else {
        0
    }
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 {
        v.push(i);
    }
    let g: fn(Vec<i64>, i64) -> i64 = picked;
    let e = exported(2);
    println(
        f"{at(v, 3)} {picked(v, 4)} {g(v, 5)} {e} {bucket(v, 27)} {bucket(v, 7)} {at(v, 1)}");
    0
}
