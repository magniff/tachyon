// `g(&G)` lends the static G inout while g writes G by name: two live
// names for one place under an inout access. It is accepted, and -O0
// prints 99 (the store through G seen) while -O1/-O2 print 5 (the inout
// assumed to be the only way to its memory). Expected: rejected, or one
// answer at every level; the test expects the -O0 answer.
// FLAGS: -O2
// XFAIL: SOUNDNESS inout lent from a static the callee writes by name: -O0 99, -O2 5
// EXPECT: 99
// EXPECT: 99
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn g(s: inout Big) -> i64 {
    s.a = 5;
    G.a = 99;
    s.a
}

fn main() -> i32 {
    println(g(&G));
    println(G.a);
    0
}
