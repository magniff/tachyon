// (0.21) std::sync::mpsc: four senders (clones) on their own threads, one
// receiver iterating until every sender is gone; order kept per sender;
// send to a dropped receiver gives the value back; recv on a channel whose
// senders are gone and that is empty fails.
// EXPECT: 4000 7998000 ordered true
// EXPECT: returned 9
// EXPECT: closed true

use std::thread;
use std::sync::mpsc;

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in::<i64>(gpa);
    let mut hs: Vec<thread::JoinHandle<i64>> = Vec::new_in(gpa);
    for k in 0..4 {
        let t = tx.clone();
        hs.push(thread::spawn(move || {
            for i in 0..1000 { t.send(k * 1000 + i).unwrap(); }
            k
        }));
    }
    drop(tx);
    let mut last = [-1, -1, -1, -1];
    let mut ordered = true;
    let mut sum = 0;
    let mut count = 0;
    for x in rx.iter() {
        let k = x / 1000;
        if x <= last[k] { ordered = false; }
        last[k] = x;
        sum += x;
        count += 1;
    }
    while hs.len() > 0 { hs.pop().unwrap().join(); }
    println(f"{count} {sum} ordered {ordered}");

    let (t2, r2) = mpsc::channel_in::<i64>(gpa);
    drop(r2);
    match t2.send(9) {
        Ok(_) => println("sent"),
        Err(e) => println(f"returned {e.into_inner()}"),
    }
    let (t3, r3) = mpsc::channel_in::<i64>(gpa);
    drop(t3);
    println(f"closed {r3.recv().is_err()}");
}
