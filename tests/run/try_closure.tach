// `?` in a closure returns from the closure (its result type written, as
// for `return`); deferred statements run when `?` returns, as for
// `return`.
// EXPECT: 208
// EXPECT: after
// EXPECT: deferred 1
// EXPECT: deferred 0
// EXPECT: 5
fn first(v: [i64]) -> Option<i64> {
    let at = |i: i64| -> Option<i64> {
        if i < v.len { Some(v[i]) } else { None }
    };
    let a = at(0)?;
    let times = |i: i64| -> Option<i64> {
        let x = at(i)?;
        Some(x * 100)
    };
    Some(a + times(1).unwrap_or(0) + times(9).unwrap_or(7))
}

fn with_defer(x: i64) -> Option<i64> {
    defer {
        print("deferred ");
        std::print_int(x);
        println("");
    }
    let y: Option<i64> = if x > 0 { Some(x) } else { None };
    let v = y?;
    println("after");
    Some(v)
}

fn apply<F: Fn(i64) -> Result<i64, i64>>(f: F, x: i64) -> i64 {
    match f(x) {
        Ok(v) => v,
        Err(e) => e,
    }
}

fn check(x: i64) -> Result<i64, i64> {
    if x > 3 { Err(x) } else { Ok(x * 2) }
}

fn main() {
    std::print_int(first([1, 2, 3][..]).unwrap_or(-1));
    println("");
    with_defer(1);
    with_defer(0);
    // (its result type from the bound)
    std::print_int(apply(|x| Ok(check(x)? + check(x - 1)?), 5) + apply(|x| Ok(check(x)?), 0));
    println("");
}
