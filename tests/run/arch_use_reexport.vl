// EXPECT: 4
// (0.25) std::arch re-exported by a module of the program and named
// through it, `c::arch::NAME`: the `pub use` names it, and the intrinsic
// tables are loaded (arch/virtual.vl, arch_names_std).
mod c {
    pub use std::arch;
}

fn main() {
    std::println(f"{c::arch::count_ones(15)}");
}
