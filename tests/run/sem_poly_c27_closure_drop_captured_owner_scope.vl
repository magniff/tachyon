// a closure capturing an owned let by access: the owner dropped once at its scope end, after the closure's calls
// FLAGS: --check-alloc
// EXPECT: 5 5
// EXPECT: end
// EXPECT: drop 4
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

fn main() {
    let r = R { id: 4 };
    let c = || r.id + 1;
    println(f"{c()} {c()}");
    println("end");
}
