// 0.16: an impl block writes every type argument of its type, also those
// with defaults; only structs and enums have defaults, after the
// parameters without one.
// ERROR: an impl block writes every type argument of 'V', also those with defaults
// ERROR: 'impl<T, A: Al> V<T, A>'
trait Al { fn id(self: *Self) -> i64; }
struct Z {}
impl Al for Z { fn id(self: *Z) -> i64 { 0 } }
struct V<T, A: Al = Z> { x: T, a: A }

impl<T> V<T> {
    fn get(self: *V<T>) -> T { self.x }
}

fn main() {}
