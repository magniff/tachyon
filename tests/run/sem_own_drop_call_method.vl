// sem-own: calling x.drop() directly is refused (try: drop(x)).
// XFAIL: SOUNDNESS `x.drop()` is accepted and the value is dropped again at its scope end: its Drop runs twice
// ERROR: drop(x)
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var a = mk(1, gpa);
    a.drop();
}
