// sem-own: `break` with an owned value bound in a match arm inside a loop.
// EXPECT: drop 0
// EXPECT: got 1
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn g(i: i64, gpa: Gpa) -> Option<D> { Some(mk(i, gpa)) }

fn main(gpa: Gpa) {
    var i = 0;
    let d = loop {
        match g(i, gpa) { Some(x) => { if x.id == 1 { break x; } }, None => {} }
        i += 1;
    };
    println(f"got {d.id}");
}
