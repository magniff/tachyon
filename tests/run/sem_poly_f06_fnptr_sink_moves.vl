// a call through fn(sink R) moves the argument: used after is own.moved
// ERROR: [own.moved]: 'r.id' is used here after 'r' moved
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn eat(r: sink R) -> i64 { r.id }

fn main() {
    let f: fn(sink R) -> i64 = eat;
    let r = R { id: 1 };
    println(f"{f(r)}");
    println(f"{r.id}");
}
