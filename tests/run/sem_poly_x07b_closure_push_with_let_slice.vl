// a closure that grows v (inout capture) and a slice of v passed let to the same call: s dangles after f()
// ERROR: [own.conflict]
// XFAIL: SOUNDNESS a closure argument growing v and v.as_slice() passed let to the same call: use after free
fn run<F: FnMut()>(f: sink F, s: [i64]) -> i64 { f(); s[0] }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(7);
    println(f"{run(|| { for i in 0..1000 { v.push(i); } }, v.as_slice())}");
}
