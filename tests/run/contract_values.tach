// (0.18 with 0.17's values) Clauses read owned parameters in place: a
// requires check's companion takes the call's arguments without moving
// them (nor dropping them), so a by-value Vec passed to a function with a
// requires is moved once, into the function; std's `unwrap` (a requires)
// of an owned Option and `v.get(i)` (a borrowed copy) through a requires
// check's block keep their 0.17 meaning. --check-alloc: nothing leaks and
// nothing is freed twice.
// FLAGS: --check-alloc
// EXPECT: 7
// EXPECT: hi
// EXPECT: x 2
// EXPECT: 3

fn total(v: Vec<i64>) -> i64
    requires v.len() > 0 else "total of nothing"
    ensures result >= old(v.len())
{
    let mut s = 0;
    for x in v.iter() {
        s += x;
    }
    s
}

fn first(v: &Vec<Buf>) -> Buf
    requires v.len() > 0
{
    v.get(0).clone()
}

fn grow(v: &mut Vec<Buf>, b: Buf) -> i64
    requires b.len() > 0
    ensures result == old(v.len()) + 1
{
    v.push(b);
    v.len()
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    v.push(4);
    println(f"{total(v)}");
    let mut b: Vec<Buf> = Vec::new_in(gpa);
    b.push(Buf::from_in("hi", gpa));
    let f = first(&b);
    println(f"{f}");
    let o: Option<Buf> = Option::Some(Buf::from_in("x", gpa));
    let u = o.unwrap();
    let n = grow(&mut b, u);
    println(f"{b.get(1)} {n}");
    println(f"{grow(&mut b, b.get(0).clone())}");
    0
}
