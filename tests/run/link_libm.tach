// 0.16: a program calling C's math library links without `-lm`: tachyonc
// adds it (Linux has libm apart from libc) when the program refers to one
// of its functions, here declared by hand.
// LINK: tachyonc links, no -lm given
// EXPECT: 1.414214 0.841471 8
extern "C" {
    fn sqrt(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn powf(x: f32, y: f32) -> f32;
}

fn main() {
    let r = unsafe { sqrt(2.0) };
    let s = unsafe { sin(1.0) };
    let p = unsafe { powf(2.0, 3.0) };
    println(f"{r:.6} {s:.6} {p as i64}");
}
