// Compound results are returned through a hidden pointer into the caller.
// EXPECT: 1 2 3
// EXPECT: 3 2 1
// EXPECT: 5 7 9
// EXPECT: 10 20
// EXPECT: 55
extern fn printf(format: *u8, ...) -> i32;

struct V { x: i64, y: i64, z: i64 }

fn mk(x: i64, y: i64, z: i64) -> V { V { x: x, y: y, z: z } }

fn rev(v: V) -> V {
    return V { x: v.z, y: v.y, z: v.x };
}

fn add(a: V, b: V) -> V { V { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z } }

fn pair(a: i64, b: i64) -> (i64, i64) { (a, b) }

fn fib(n: i64) -> (i64, i64) {
    if n == 0 { return (0, 1); }
    let p = fib(n - 1);
    (p.1, p.0 + p.1)
}

fn main() -> i64 {
    let a = mk(1, 2, 3);
    printf(c"%ld %ld %ld\n", a.x, a.y, a.z);
    let b = rev(mk(1, 2, 3));
    printf(c"%ld %ld %ld\n", b.x, b.y, b.z);
    let c = add(mk(1, 2, 3), mk(4, 5, 6));
    printf(c"%ld %ld %ld\n", c.x, c.y, c.z);
    mk(7, 8, 9);
    let p = pair(10, 20);
    printf(c"%ld %ld\n", p.0, p.1);
    printf(c"%ld\n", fib(10).0);
    0
}
