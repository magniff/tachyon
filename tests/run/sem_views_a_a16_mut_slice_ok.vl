// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 5 / 7
// EXPECT: 5
// EXPECT: 7
fn fill(s: inout [i64], x: i64) { for i in 0..s.len() { s[i] = x; } }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let m = v.as_mut_slice();
    m[0] = 5;
    println(v[0]);
    fill(&v[1..2], 7);
    println(v[1]);
    0
}
