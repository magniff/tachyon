// Tuples of mixed types, nested tuples, tuple-field assignment and
// `t.0.1` chains.
// EXPECT: 1 2.5 1 -3
// EXPECT: 2 3 5
// EXPECT: 40 100
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let mut t = (1, 2.5, true, (0 - 3) as i8);
    unsafe { printf(c"%ld %.1f %d %d\n", t.0, t.1, t.2, t.3); }
    let mut n = ((1, 2), (3, (4, 5)));
    unsafe { printf(c"%ld %ld %ld\n", n.0.1, n.1.0, n.1.1.1); }
    n.1.1.0 = 40;
    t.3 = 100;
    unsafe { printf(c"%ld %d\n", n.1.1.0, t.3); }
    0
}
