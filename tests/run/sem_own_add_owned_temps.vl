// sem-own: `mk(1) + mk(2)` with a let-param Add: both temporaries dropped once.
// XFAIL: SOUNDNESS owned temporaries given to an operator (`mk(1) + mk(2)`, let params of Add) are never dropped
// EXPECT: 3
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
impl Add for D { fn add(self, other: D) -> D { D { id: self.id + other.id, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let c = mk(1, gpa) + mk(2, gpa);
    println(f"{c.id}");
}
