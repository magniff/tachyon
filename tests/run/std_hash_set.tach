// (0.20) HashSet on the Swiss table: insert, contains, remove, iteration
// against a model; a map of owned values dropped (--check-alloc).
// FLAGS: --check-alloc
// EXPECT: 3 true false 2
// EXPECT: 500 500 124750
// EXPECT: 2 1
use std::collections::HashSet;

fn main(gpa: Gpa) {
    var s: HashSet<[u8]> = HashSet::new_in(gpa);
    s.insert("pear");
    s.insert("fig");
    let again = s.insert("pear");
    s.insert("kiwi");
    let had = s.contains("fig");
    s.remove("fig");
    println(f"{s.len() + 1} {had} {again} {s.len()}");
    var t: HashSet<i64> = HashSet::new_in(gpa);
    var model: Vec<bool> = Vec::filled_in(1000, false, gpa);
    for i in 0..1000 {
        t.insert(i);
        model.set(i, true);
    }
    for i in 0..1000 {
        if i % 2 == 1 {
            t.remove(i);
            model.set(i, false);
        }
    }
    var n = 0;
    var sum = 0;
    for x in t.iter() {
        if !model.get(x) {
            println("FAIL");
        }
        n += 1;
        sum += x / 2;
    }
    println(f"{t.len()} {n} {sum}");
    var u: HashSet<(i64, [u8])> = HashSet::new_in(gpa);
    u.insert((1, "a"));
    u.insert((2, "b"));
    u.insert((1, "a"));
    u.remove((2, "b"));
    println(f"{u.len() + 1} {u.len()}");
    // (a map of owned values, dropped with it: --check-alloc reports a leak)
    var m: std::HashMap<i64, Vec<i64>> = std::HashMap::new_in(gpa);
    for k in 0..100 {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(k);
        m.insert(k % 7, v);
    }
    m.remove(3);
}
