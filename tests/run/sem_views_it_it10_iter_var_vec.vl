// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a Vec iterator kept across a push
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var it = v.iter();
    for i in 0..100 { v.push(i); }
    println(it.next().unwrap());
    0
}
