// 0.16: a static's initializer may call a constant constructor (a function
// whose body is one expression of constants and its parameters), not any
// function.
// ERROR: expression is not a compile-time constant
// ERROR: help: a call is constant when its function's body is one expression of constants and its parameters
// ERROR-COUNT: 1
struct P { x: i64, y: i64 }

fn origin() -> P {
    P { x: 0, y: 0 }
}

fn shifted(d: i64) -> P {
    let x = d + 1;
    P { x: x, y: d }
}

static mut A: P = origin();
static mut B: P = shifted(2);

fn main() {}
