// EXPECT: len 1000 sum 499500
// EXPECT: get 49 none
// EXPECT: removed 333 len 999 missing
// EXPECT: replaced 49 now 70
// EXPECT: words 4: the=3 cat=1 sat=1 mat=1
// EXPECT: iterated 4 total 6
// EXPECT: points 2
// 0.9: std's HashMap<K: Hash + Eq, V>: integer keys, string keys, a user
// key type, and iteration by slots.
use std::{HashMap, print_int};

struct Point { x: i64, y: i64 }

impl Hash for Point {
    fn hash(self: *Point) -> u64 { self.x.hash() ^ (self.y.hash() * 3) }
}

fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<i64, i64> = HashMap::new_in(gpa);
    for i in 0..1000 {
        m.insert(i, i * i);
    }
    let mut sum = 0;
    for i in 0..1000 {
        sum += m.get(i).unwrap() - i * i + i;
    }
    print("len ");
    print_int(m.len());
    print(" sum ");
    print_int(sum);
    println("");
    print("get ");
    print_int(m.get(7).unwrap());
    println(if m.get(1000).is_none() { " none" } else { " some" });
    print("removed ");
    print_int(m.remove(333).unwrap_or(-1) / 333);
    print(" len ");
    print_int(m.len());
    println(if m.contains(333) { " present" } else { " missing" });
    let old = m.insert(7, 70).unwrap();
    print("replaced ");
    print_int(old);
    print(" now ");
    print_int(m.get(7).unwrap());
    println("");
    m.free();

    let mut counts: HashMap<[u8], i64> = HashMap::new_in(gpa);
    let words = ["the", "cat", "sat", "the", "mat", "the"];
    for w in words {
        let n = counts.get(w).unwrap_or(0);
        counts.insert(w, n + 1);
    }
    print("words ");
    print_int(counts.len());
    print(":");
    let order = ["the", "cat", "sat", "mat"];
    for w in order {
        print(" ");
        print(w);
        print("=");
        print_int(counts.get(w).unwrap());
    }
    println("");
    let mut seen = 0;
    let mut total = 0;
    for i in 0..counts.slots() {
        if let Some(v) = counts.value_at(i) {
            seen += 1;
            total += v;
            if counts.key_at(i).is_none() {
                return 1;
            }
        }
    }
    print("iterated ");
    print_int(seen);
    print(" total ");
    print_int(total);
    println("");
    counts.free();

    let mut pts: HashMap<Point, i64> = HashMap::new_in(gpa);
    pts.insert(Point { x: 1, y: 2 }, 1);
    pts.insert(Point { x: 2, y: 1 }, 2);
    pts.insert(Point { x: 1, y: 2 }, 3);
    print("points ");
    print_int(pts.len());
    println("");
    0
}
