// 0.17: the prelude has the names programs reach for first, so none of
// these needs a `use`: Buf, HashMap, read_line, Scanner, parse_int, trim,
// split_in, split_whitespace_in, sort, sort_by, cmp_of, eq_of, Fmt.
// STDIN: 3 1 2
// STDIN: a,b,,c
// EXPECT: 1 2 3
// EXPECT: 4 parts, 3 words
// EXPECT: 42 -1 true
// EXPECT: [3, 2, 1] counted 2
// EXPECT: P(7)
struct P { x: i64 }

impl Display for P {
    fn fmt(self: &P, f: &mut Fmt) { f.write(f"P({self.x})"); }
}

fn main(gpa: Gpa) -> i32 {
    let mut line = Buf::new_in(gpa);
    read_line(&mut line).unwrap();
    let mut words = split_whitespace_in(line.as_slice(), gpa);
    let mut v: Vec<i64> = Vec::new_in(gpa);
    for w in words.iter() { v.push(parse_int(w).unwrap()); }
    sort(v.as_mut_slice());
    println(f"{v.get(0)} {v.get(1)} {v.get(2)}");
    read_line(&mut line).unwrap();
    let mut parts = split_in(line.as_slice(), ',', gpa);
    let mut sc = Scanner::new("x y  z");
    let mut n = 0;
    while sc.next_token().is_some() { n += 1; }
    println(f"{parts.len()} parts, {n} words");
    let (one, two) = (1, 2);
    // (eq_of takes `*T`, an exclusive loan: not &two twice in one call)
    let two_again = two;
    println(f"{parse_int(trim("  42 ")).unwrap()} {cmp_of(&one, &two)} {eq_of(&two, &two_again)}");
    sort_by(v.as_mut_slice(), |a, b| *b - *a);
    let mut m: HashMap<[u8], i64> = HashMap::new_in(gpa);
    m.insert("a", 1);
    m.insert("b", 2);
    println(f"{v:?} counted {m.len()}");
    println(P { x: 7 });
    0
}
