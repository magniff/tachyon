// 0.14: capture modes. A `let mut` is captured by reference (changes
// are seen both ways), an immutable binding by value (by reference when
// the closure takes its address, as a method's `self: *T` does), and
// everything by value with `move`.
// EXPECT: 111 111
// EXPECT: 5 6
// EXPECT: 2
// EXPECT: 3
// EXPECT: 1 2 0
fn twice<F: FnMut()>(mut f: F) {
    f();
    f();
}

fn main(gpa: Gpa) -> i64 {
    let mut c = 1;
    c += 100;
    // (0.17: c cannot be written while bump, which borrows it, is used)
    let mut bump = || {
        c += 10;
        c
    };
    let r = bump();
    std::print_int(r);
    print(" ");
    std::print_int(c);
    println("");
    // a snapshot
    let mut n = 5;
    let snap = move || n;
    n = 6;
    std::print_int(snap());
    print(" ");
    std::print_int(n);
    println("");
    // a handle changed through `self: *Vec`: the variable's
    let v: Vec<i64> = Vec::new_in(gpa);
    twice(|| v.push(1));
    std::print_int(v.len());
    println("");
    // through two levels
    let mut hits = 0;
    let mut outer = || {
        let mut inner = || hits += 1;
        inner();
        inner();
        inner();
    };
    outer();
    std::print_int(hits);
    println("");
    // a `move` closure changes its own copy
    let mut m = 0;
    let mut count = move || {
        m += 1;
        m
    };
    std::print_int(count());
    print(" ");
    std::print_int(count());
    print(" ");
    std::print_int(m);
    println("");
    0
}
