// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `b.g()`; s grows while it is used
// ERROR: error[own.conflict]
trait G<T> { fn g(self) -> T; }
struct B<T> { items: Vec<T> }
impl<T> G<T> for B<T> { fn g(self) -> T { self.items.get(0) } }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); let b = B { items: v };
    let r = b.g();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
