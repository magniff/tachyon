// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: n views e
// ERROR: error[own.conflict]
struct E { name: [u8; 8], len: i64 }
impl E { fn name(self) -> [u8] { self.name[..self.len] } }

fn main() -> i32 {
    var e = E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 };
    let n = e.name();
    e.name[0] = 'J';
    println(n);
    0
}
