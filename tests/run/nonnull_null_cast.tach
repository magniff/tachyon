// 0.18: `p as NonNull<T>` checks p: a null p is a run-time failure (exit
// 101), as `n as E` of a value E lacks is, so that `Some(p)` can never
// read back as None through the niche. NonNull::new is the conversion
// that may fail without stopping.
// EXPECT: 5 true
// EXIT: 101
// STDERR: null pointer made NonNull
use std::NonNull;

fn main() {
    let x: i64 = 5;
    let p = &x as NonNull<i64>;
    let q: *i64 = 0 as *i64;
    println(f"{unsafe { *p.as_ptr() }} {NonNull::new(q).is_none()}");
    let o: Option<NonNull<i64>> = Some(q as NonNull<i64>);
    println(f"unreached {o.is_some()}");
}
