// (0.25) A view of v live across a call of a closure that pushes to v: the
// call changes v, as `v.push` does, and the view is invalid after it.
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = v.as_slice();
    var g = || { for i in 0..1000 { v.push(i); } };
    g();
    println(f"{s[0]}");
}
// ERROR: own.conflict
