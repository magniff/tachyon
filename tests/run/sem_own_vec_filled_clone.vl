// sem-own: Vec::filled_in(n, x) clones x n times (or n-1 plus x): each dropped once.
// EXPECT: n 3
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
impl Clone for D { fn clone(self) -> D { D { id: self.id, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let v: Vec<D> = Vec::filled_in(3, mk(1, gpa), gpa);
    println(f"n {v.len()}");
    println("end");
}
