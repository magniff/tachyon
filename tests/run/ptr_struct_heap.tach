// A heap-allocated linked list of structs built and walked through pointers.
// EXPECT: 385 10 100
extern fn printf(format: *u8, ...) -> i32;
extern fn malloc(n: u64) -> *u8;

struct Node { value: i64, next: *Node }

fn push(head: *Node, v: i64) -> *Node {
    let n = malloc(16) as *Node;
    (*n).value = v;
    (*n).next = head;
    n
}

fn main() -> i64 {
    let null = 0 as *Node;
    let head = null;
    let i = 1;
    loop {
        if i > 10 { break; };
        head = push(head, i * i);
        i += 1;
    }
    let sum = 0;
    let count = 0;
    let cur = head;
    loop {
        if cur == null { break; };
        sum += (*cur).value;
        count += 1;
        cur = (*cur).next;
    }
    printf("%ld %ld %ld\n".0, sum, count, (*head).value);
    0
}
