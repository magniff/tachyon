// if-conversion must not make an index (or its load) unconditional.
// EXPECT: 5 -1 -1 7
// EXPECT: 0 0
// EXPECT: 3
static var Z: i64 = 0;

#[inline(never)]
fn get(v: Vec<i64>, i: i64) -> i64 {
    if i < v.len() && i >= 0 { v[i] } else { -1 }
}

#[inline(never)]
fn get2(v: Vec<i64>, i: i64, c: bool) -> i64 {
    let x = if c { v[i] } else { 7 };
    x
}

#[inline(never)]
fn get_raw(p: *i64, c: bool) -> i64 {
    if c { unsafe { *p } } else { 0 }
}

#[inline(never)]
fn get_null(p: *i64) -> i64 {
    if p.is_null() { 0 } else { unsafe { *p } }
}

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    let far = 1099511627776 + Z;
    println(f"{get(v, 0)} {get(v, far)} {get(v, -far)} {get2(v, far, false)}");
    println(f"{get_raw(0 as *i64, Z == 1)} {get_null(0 as *i64)}");
    let i = 10 + Z;
    let x = if Z == 1 { v[i] } else { 3 };
    println(x);
    0
}
