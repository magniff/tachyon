// requires i < len without i >= 0: a negative i is still out of bounds.
// EXPECT: 3
// EXIT: 101
// STDERR: index out of bounds: index -1, length 3
static var Z: i64 = 0;

#[inline(never)]
fn at(s: [i64], i: i64) -> i64
    requires i < s.len()
{
    s[i]
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3];
    println(at(a[..], 2 + Z));
    println(at(a[..], -1 + Z));
    0
}
