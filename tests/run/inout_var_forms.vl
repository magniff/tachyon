// (0.25) The mutable places an inout access takes: a var local and its
// parts, an inout parameter, `inout self`, a `static var`, an `inout r`
// local, a var Vec, a sink parameter, and memory through a raw pointer.
struct S { n: i64 }

impl S {
    fn inc(inout self) { self.n += 1; bump(&self.n); }
}

static var G: i64 = 1;
fn bump(n: inout i64) { n += 1; }
fn twice(n: inout i64) { bump(&n); bump(&n); }
fn own(x: sink i64) -> i64 { bump(&x); x }
fn addr(n: i64) -> i64 { let p = &n as *i64; unsafe { *p } }

fn main(gpa: Gpa) {
    var n = 1;
    bump(&n);
    var s = S { n: 1 };
    bump(&s.n);
    s.inc();
    var a = [1, 2, 3];
    bump(&a[1]);
    var t = (1, 2);
    bump(&t.0);
    inout r = &n;
    r += 1;
    twice(&n);
    bump(&G);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    bump(&v[0]);
    v[0] += 1;
    var o: Option<i64> = Some(1);
    match &o { Some(k) => { k += 1; } None => {} }
    var x = 1;
    var y = 2;
    std::swap(&x, &y);
    unsafe {
        let p = &a[0] as *i64;
        *p = 9;
    }
    println(f"{n} {s.n} {a[0]} {a[1]} {t.0} {G} {v[0]} {o.unwrap()} {x} {y} {own(5)} {addr(4)}");
}
// EXPECT: 5 4 9 3 2 2 3 2 2 1 6 4
