// a sink closure on thread::spawn holding a view of a local Vec: sync.borrow_escapes
// ERROR: [sync.borrow_escapes]: 'thread::spawn' moves 's'
use std::thread;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    let s = v.as_slice();
    let h = thread::spawn(sink || s[0]);
    println(f"{h.join()}");
}
