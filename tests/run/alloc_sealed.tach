// 0.16: a #[sealed] struct: outside its module, only its `pub` fields and
// its functions; inside (and in the modules inside it), everything.
// Structural == still compares every field.
// EXPECT: 3 4 7
// EXPECT: 1 2 true false
// EXPECT: 5 [1, 2] 2
mod counter {
    #[sealed]
    pub struct Counter { pub step: i64, count: i64 }

    impl Counter {
        pub fn new(step: i64) -> Counter {
            Counter { step: step, count: 0 }
        }

        pub fn tick(self: &mut Counter) {
            self.count += self.step;
        }

        pub fn count(self: &Counter) -> i64 {
            self.count
        }
    }

    pub mod inner {
        use super::Counter;

        // A module inside the declaring one sees the private fields.
        pub fn total(c: &Counter) -> i64 {
            c.count + c.step
        }
    }
}

use counter::Counter;

fn main(gpa: Gpa) {
    let mut c = Counter::new(3);
    c.tick();
    c.step = 4;
    c.tick();
    println(f"{c.step - 1} {c.step} {c.count()}");
    let a = Counter::new(1);
    let b = Counter::new(2);
    println(f"{a.step} {b.step} {a == Counter::new(1)} {a == b}");
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    println(f"{counter::inner::total(&c) - 6} {v:?} {v.len()}");
}
