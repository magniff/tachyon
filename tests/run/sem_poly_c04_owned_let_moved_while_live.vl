// an owned let captured by access, moved while the closure is still to be called
// ERROR: [own.conflict]: 'v' moves 'v' while 'c'
fn eat(v: sink Vec<i64>) -> i64 { v.len() }

fn main(gpa: Gpa) {
    var v0: Vec<i64> = Vec::new_in(gpa);
    v0.push(1);
    let v = v0;
    let c = || v.len();
    let k = eat(v);
    println(f"{k} {c()}");
}
