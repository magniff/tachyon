// 0.17: a variant's pattern names every field, or ends with `..`.
// ERROR: the pattern of 'Ev::Key' does not mention field 'shift'
// ERROR: help: match it too, or end the pattern with '..' to leave the rest out
// ERROR: try: Ev::Key { code: c, .. }
enum Ev { Key { code: i64, shift: bool }, Quit }

fn code(e: Ev) -> i64 {
    match e { Ev::Key { code: c } => c, Ev::Quit => 0 }
}

fn main() -> i32 { 0 }
