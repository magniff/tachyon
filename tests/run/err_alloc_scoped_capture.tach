// 0.16: an arena scope cannot use a value on another scope's arena (S3):
// the inner scope's body could keep it; a view (a slice) is fine.
// FLAGS: --no-ambient-gpa
// ERROR: an arena scope cannot use 'outer': its type holds another scope's arena
// ERROR: help: take a view first: 'let s = outer.as_slice();'
// ERROR: an arena scope cannot use 's': its type holds another scope's arena
// ERROR: an arena scope cannot use 'p': its type holds another scope's arena
// ERROR-COUNT: 3
fn main(gpa: Gpa) {
    let n = arena_scope(gpa, |s: ScopedArena| {
        let mut outer: Vec<i64, ScopedArena> = Vec::new_in(s);
        outer.push(1);
        let a = arena_scope(gpa, |t: ScopedArena| outer.len());
        let b = arena_scope(gpa, |t: ScopedArena| {
            let v: Vec<i64, ScopedArena> = Vec::new_in(s);
            v.len()
        });
        let p = &outer;
        let c = arena_scope(gpa, |t: ScopedArena| p == p);
        let view = outer.as_slice();
        let d = arena_scope(gpa, |t: ScopedArena| view.len);
        // (a closure that takes no scope's arena may use it)
        let e = outer.iter().map(|x: i64| x + outer.len()).sum();
        a + b + d + e
    });
}
