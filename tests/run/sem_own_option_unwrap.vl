// sem-own: Option::unwrap and unwrap_or move: unwrap_or's unused default is
// dropped once, inside unwrap_or.
// EXPECT: u 1
// EXPECT: drop 3
// EXPECT: o 2
// EXPECT: end
// EXPECT: drop 2
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let a: Option<D> = Some(mk(1, gpa));
    let x = a.unwrap();
    println(f"u {x.id}");
    let b: Option<D> = Some(mk(2, gpa));
    let y = b.unwrap_or(mk(3, gpa));
    println(f"o {y.id}");
    println("end");
}
