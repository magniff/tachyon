// 0.14: closures and generics: a closure in a generic instance, the
// result type inferred from the closure (or a function passed for F),
// pointer parameters from the bound, a generic struct holding a closure.
// EXPECT: 30 4
// EXPECT: 1 8
// EXPECT: 9 3
// EXPECT: 42
fn sum_by<T, F: Fn(T) -> i64>(s: [T], f: F) -> i64 {
    var t = 0;
    for x in s {
        t += f(x);
    }
    t
}

fn scaled<T>(s: [T], k: i64) -> i64 {
    sum_by(s, |x: T| k * 2)
}

fn map_one<A, B, F: FnMut(A) -> B>(x: sink A, f: sink F) -> B {
    f(x)
}

fn pick<T, F: FnMut(let T, let T) -> bool>(a: sink T, b: sink T, better: sink F) -> T {
    if better(a, b) { a } else { b }
}

fn double(x: i64) -> i64 {
    x * 2
}

struct Op<F: Fn(i64) -> i64> {
    f: F,
    x: i64,
}

fn main() -> i64 {
    let arr = [1, 2, 3];
    std::print_int(scaled(arr[0..3], 5));
    print(" ");
    std::print_int(scaled([true, false][0..2], 1));
    println("");
    let big = map_one(3, |x| x * 1000 == 3000);
    std::print_int(if big { 1 } else { 0 });
    print(" ");
    std::print_int(map_one(4, double));
    println("");
    std::print_int(pick(3, 9, |a, b| a > b));
    print(" ");
    std::print_int(pick(3, 9, |a, b| a < b));
    println("");
    let k = 40;
    let op = Op { f: |x| x + k, x: 2 };
    std::print_int((op.f)(op.x));
    println("");
    0
}
