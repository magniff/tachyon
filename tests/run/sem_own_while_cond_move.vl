// sem-own: a value moved on some path inside a loop that may run again
// without reassigning is own.moved.
// ERROR: own.moved
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) {}

fn main(gpa: Gpa) {
    var d = mk(0, gpa);
    var i = 0;
    while i < 3 {
        if i == 1 { eat(d); }
        i += 1;
    }
}
