// ERROR: own.static
// (0.25: rejected, own.static: the static is lent to a callee that reaches it by name)
// an inout of a static's field while the callee writes the field by name.
// FLAGS: -O2
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn g(x: inout i64) -> i64 { x = 5; G.a = 99; x }

fn main() -> i32 { println(g(&G.a)); println(G.a); 0 }
