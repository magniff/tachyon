// --emit-header: C includes the program's own header and calls into it
// with every kind of C type (structs, packed, packed(N), aligned, enums
// with and without fields, unions, function pointers, self-referential
// structs, opaque tachyon types behind pointers, statics).
// CHEADER: roundtrip.h
// CSOURCE: tests/c/cheader_roundtrip.c
// EXPECT: area 12.0 12.0 0.0
// EXPECT: make 1.5 -2.0
// EXPECT: packed 5000001010
// EXPECT: color 61
// EXPECT: tagged -9 105
// EXPECT: union 12345
// EXPECT: walk 38.5
// EXPECT: shape 1 2.5
// EXPECT: limit 7
// EXPECT: drive 42 counter 2
import "stdio.h" as c;

#[repr(C)]
struct Vec2 { x: f32, y: f32 }
#[repr(C, packed)]
struct Packed { a: u8, b: u32 }
#[repr(C, packed(2))]
struct Pack2 { a: u8, b: u64 }
#[repr(C, align(16))]
struct Aligned { v: i32 }
#[repr(C)]
enum Color { Red, Green = 5, Blue }
#[repr(u8)]
enum Small { A, B }
#[repr(C)]
enum Shape { Circle(f64), Rect(f64, f64), Empty }
#[repr(u8)]
enum Tagged { One(i32), Two(i64, u8) }
#[repr(C)]
union U { i: i64, f: f64 }
struct Hidden { x: i64 }
#[repr(C)]
struct Holder { v: Vec2, arr: [i32; 3], next: *Holder, h: *Hidden, cb: extern "C" fn(i32) -> f64 }

extern "C" static mut COUNTER: i64 = 0;
extern "C" static LIMIT: i32 = 7;

extern "C" {
    fn c_drive() -> i32;
}

extern "C" fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.0 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Empty => 0.0,
    }
}

extern "C" fn make(x: f32, y: f32) -> Vec2 {
    Vec2 { x: x, y: y }
}

extern "C" fn packed_sum(p: Packed, q: Pack2, a: Aligned) -> i64 {
    p.a as i64 + p.b as i64 + q.a as i64 + q.b as i64 + a.v as i64
}

extern "C" fn color_code(c: Color, s: Small) -> i32 {
    (c as i32) * 10 + s as i32
}

extern "C" fn tagged_value(t: Tagged) -> i64 {
    match t {
        Tagged::One(x) => x as i64,
        Tagged::Two(a, b) => a + b as i64,
    }
}

extern "C" fn union_bits(u: U) -> i64 {
    u.i
}

extern "C" fn twice(x: i32) -> f64 {
    x as f64 * 2.0
}

extern "C" fn walk(first: *Holder) -> f64 {
    let mut total = 0.0;
    let mut h = first;
    while h != 0 as *Holder {
        let node = *h;
        total += node.v.x as f64 + (node.arr[0] + node.arr[1] + node.arr[2]) as f64 + (node.cb)(node.arr[0]);
        h = node.next;
    }
    total
}

extern "C" fn make_shape(k: i32) -> Shape {
    if k == 1 { Shape::Rect(2.5, 1.0) } else { Shape::Empty }
}

extern "C" fn bump() {
    COUNTER += 1;
}

fn main() -> i32 {
    let r = c_drive();
    c::printf(c"drive %d counter %ld\n", r, COUNTER);
    0
}
