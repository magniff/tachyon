// Taking addresses, reading and writing through pointers, pointer to pointer,
// and passing pointers to functions.
// EXPECT: 43 1 4 4.5
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn swap(a: inout i64, b: inout i64) {
    let t = a;
    a = b;
    b = t;
}

fn set_via(pp: **i64, v: i64) {
    unsafe { **pp = v; }
}

fn main() -> i64 {
    var x: i64 = 1;
    var y: i64 = 2;
    swap(&x, &y);
    var p = &x as *i64;
    let pp = &p as **i64;
    unsafe {
        set_via(pp, 42);
        **pp = **pp + 1;
    }
    var b: u8 = 250;
    inout pb = &b;
    unsafe { pb = pb + 10; }
    var f: f32 = 1.5;
    inout pf = &f;
    unsafe {
        pf = pf * 3.0;
        printf(c"%ld %ld %d %.1f\n", x, y, b, f);
    }
    0
}
