// pushing a let T into a Vec<T>: copy for i64; for an owned T a move out of a borrow
// ERROR: [own.move_out]: cannot move 'x'
fn store<T>(dst: inout Vec<T>, x: T) { dst.push(x); }

fn main(gpa: Gpa) {
    var a: Vec<i64> = Vec::new_in(gpa);
    store(&a, 3);
    var b: Vec<Vec<i64>> = Vec::new_in(gpa);
    store(&b, a);
    println(f"{a.len()} {b.len()}");
}
