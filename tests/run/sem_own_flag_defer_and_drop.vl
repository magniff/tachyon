// sem-own: defer and implicit drops share one exit list: reverse order of declaration.
// EXPECT: body
// EXPECT: drop 2
// EXPECT: defer
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    defer println("defer");
    let b = mk(2, gpa);
    println("body");
}
