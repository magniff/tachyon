// 0.16: zero-sized types (an empty struct, like std's Gpa) as fields, in
// arrays, tuples and enum payloads, passed and returned by value, and
// with methods: no storage, the same layout as without them, at every
// level. A #[repr(C)] struct with a field of a type that is not repr(C)
// cannot cross to C (the field's layout is vole's).
// EXPECT: 5 24 10 0 2 0
// EXPECT: 8 3 7 1 16
struct Z {}

impl Z {
    fn get(self, x: i64) -> i64 { x + 1 }
}

fn mk() -> Z { Z {} }
struct V<T, A> { ptr: *T, len: i64, cap: i64, alloc: A }
fn take(z: Z, y: i64) -> i64 { y * 2 }
fn build() -> V<i64, Z> { V { ptr: 0 as *i64, len: 3, cap: 4, alloc: mk() } }
#[repr(C)]
struct C1 { a: i32, z: Z, b: i32 }
enum E { A(Z), B(i64, Z), C }
fn sum(c: C1) -> i32 { c.a + c.b }

fn opt(o: Option<Z>) -> i64 {
    match o {
        Option::Some(_) => 1,
        Option::None => 0,
    }
}

fn main() {
    let z = mk();
    var v = build();
    v.len += v.alloc.get(1);
    let w = v;
    var arr: [Z; 4] = [Z {}, Z {}, Z {}, Z {}];
    arr[2] = Z {};
    let t = (1, Z {}, 2);
    println(f"{w.len} {size_of(V<i64, Z>)} {take(z, 5)} {size_of(Z)} {t.2} {size_of([Z; 4])}");
    let c = C1 { a: 1, z: Z {}, b: 2 };
    let e = E::B(7, Z {});
    let k = match e {
        E::A(_) => 0,
        E::B(x, _) => x,
        E::C => 9,
    };
    println(f"{size_of(C1)} {sum(c)} {k} {opt(Option::Some(Z {}))} {size_of(E)}");
}
