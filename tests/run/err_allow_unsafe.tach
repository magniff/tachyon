// FLAGS: --allow-unsafe
// ERROR: --allow-unsafe was removed in 0.10
// 0.10: unsafe operations outside unsafe code are errors, and 0.9's
// --allow-unsafe (for the compiler's own source) is gone.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

fn main() -> i32 {
    let x = 5;
    let p = &x;
    printf(c"%ld\n", p);
    0
}
