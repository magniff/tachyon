// A let slice of a static array, while the callee writes the static: the
// view sees the change at -O0 (1099) but not at -O1/-O2 (1001). Either
// the write is rejected while the view is alive, or the view sees it at
// every level (the -O0 answer, expected here).
// FLAGS: -O2
// XFAIL: SOUNDNESS a let slice viewing a static the callee writes: -O0 1099, -O2 1001
// EXPECT: 1099
static var A: [i64; 4] = [1, 2, 3, 4];

#[inline(never)]
fn f(s: [i64]) -> i64 {
    let x = s[0];
    A[0] = 99;
    x * 1000 + s[0]
}

fn main() -> i32 {
    println(f(A[..]));
    0
}
