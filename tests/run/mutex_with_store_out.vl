// with's closure stores a view of the locked data into a captured Vec
// ERROR: [own.escape]: the closure stores a view of 'd', the data 'with' locks
use std::sync::Mutex;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    var out: Vec<[i64]> = Vec::new_in(gpa);
    m.with(|d| out.push(d.as_slice()));
    m.with(|d| { for i in 0..1000 { d.push(i); } });
    println(f"{out[0][0]}");
}
