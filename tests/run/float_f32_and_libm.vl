// f32 constants, implicit fmod, pow from libm, and f32 promotion for
// variadics.
// EXPECT: 1.000000 1.5 1024
// EXPECT: 1.5 8
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn pow(x: f64, y: f64) -> f64;
    fn powf(x: f32, y: f32) -> f32;
}

fn main() -> i64 {
    let x: f32 = 2.0;
    let y: f32 = 0.5;
    let a: f64 = 5.5;
    let b: f64 = 2.0;
    let e: f64 = 10.0;
    unsafe { printf(c"%f %.1f %.0f\n", x * y, a % b, pow(b, e)); }
    let p: f32 = 5.5;
    let q: f32 = 2.0;
    let r: f32 = 3.0;
    unsafe { printf(c"%.1f %.0f\n", p % q, powf(q, r)); }
    0
}
