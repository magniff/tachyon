// 0.6: a string literal is a [u8] slice of its bytes (no terminator); the
// std functions taking [u8] accept it directly.
// EXPECT: hello, world
// EXPECT: 12 104 100
// EXPECT: llo
// EXPECT: 5 vowels
// EXPECT: abc-42
// EXPECT: 5 0
use std::Buf;

fn vowels(s: [u8]) -> i64 {
    let mut n = 0;
    for c in s {
        if c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' { n += 1; }
    }
    n
}

fn show(a: i64, b: i64) {
    std::print_int(a);
    std::print(" ");
    std::print_int(b);
}

fn main() -> i32 {
    std::println("hello, world");
    let s = "hello, world";
    std::print_int(s.len);
    std::print(" ");
    show(s[0] as i64, s[11] as i64);
    std::println("");
    std::println(s[2..5]);
    std::print_int(vowels("education"));
    std::println(" vowels");
    let mut b = Buf::new();
    b.push_str("abc");
    b.push_str("-");
    b.push_int(42);
    std::println(b.as_slice());
    b.free();
    let empty = "";
    show("\t\n\\\"x".len, empty.len);
    std::println("");
    0
}
