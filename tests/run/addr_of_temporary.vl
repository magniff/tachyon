// `&` of a value (0.18.1): a temporary, named by the checker, lives to the
// end of the block and is dropped there: `let r = &f(x);` (Rust's
// temporary lifetime extension), a call's argument `g(&f(x))`, nested,
// `&mut`, in a condition, in a loop; `&x.text()` is a slice (its own
// view), or a `&[u8]` where one is expected (`cmp_of`, whose T is then
// the slice). Nothing leaks (--check-alloc).
// FLAGS: --check-alloc
// EXPECT: 7
// EXPECT: 9
// EXPECT: 18
// EXPECT: 5
// EXPECT: 1 1
// EXPECT: 41
// EXPECT: big
// EXPECT: -1 0 1
// EXPECT: 18
struct P { x: i64, y: i64 }

struct T { s: [u8] }

impl T {
    fn text(self, a: i64) -> [u8] { self.s[a..] }
}

fn mk(gpa: Gpa) -> Vec<i64> {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    v.push(4);
    v
}

fn total(v: Vec<i64>) -> i64 {
    var t = 0;
    for x in v { t += x; }
    t
}

fn px(p: P) -> i64 { p.x * 10 + p.y }

fn bump(p: inout P) -> i64 {
    p.x += 1;
    p.x
}

fn tick(n: inout i64) -> i64 {
    n += 1;
    n
}

fn main(gpa: Gpa) {
    println(total(mk(gpa)));
    let r = &mk(gpa);
    println(r.len() + total(r));
    // (0.25: a temporary lent inout is conv.place; named first)
    var p5 = P { x: 5, y: 0 };
    println(px(P { x: 1, y: 2 }) + bump(&p5));
    let s = "hello";
    println(s.len());
    var c = 0;
    println(f"{tick(&c)} {c}");
    let q = (c + 40);
    println(q);
    if total(mk(gpa)) > 3 { println("big"); }
    let t = T { s: "hello" };
    let u = T { s: "help" };
    let a = cmp_of(t.text(1), u.text(1));
    let b = cmp_of(t.text(3), t.text(3));
    println(f"{a} {b} {cmp_of(u.text(3), t.text(3))}");
    var sum = 0;
    for i in 0..3 { sum += total(mk(gpa)) - i; }
    println(sum - total(mk(gpa)) + 7);
}
