// Calls with stack arguments inside a long loop must not leak stack space,
// and an odd number of stack arguments must keep the stack aligned for
// calls made by the callee.
// EXPECT: 9000015000000
// EXPECT: 45 0.5
extern fn printf(format: *u8, ...) -> i32;

fn seven(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 {
    a + b + c + d + e + f + g
}

fn eight(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    a ^ b ^ c ^ d ^ e ^ f ^ g ^ h
}

fn nine_print(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) {
    let x: f64 = 0.5;
    printf(c"%ld %.1f\n", a + b + c + d + e + f + g + h + i, x);
}

fn main() -> i64 {
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i != 3000000 {
        acc += seven(i, 1, 1, 1, 1, 1, 1);
        acc += eight(i, 0, 0, 0, 0, 0, 0, 1);
        i += 1;
    }
    printf(c"%ld\n", acc);
    nine_print(1, 2, 3, 4, 5, 6, 7, 8, 9);
    0
}
