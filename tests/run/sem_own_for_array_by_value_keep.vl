// sem-own: `for x in arr` over an array local of owned values, keeping x: refused: the items are borrowed from the array.
// ERROR: own.move_out
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let arr = [mk(1, gpa), mk(2, gpa)];
    var keep: Vec<D> = Vec::new_in(gpa);
    for x in arr { keep.push(x); }
    println(f"n {keep.len()}");
}
