// 0.17: through a borrow of a Vec, a Buf or a slice (a reference, `&v`),
// `p[i]` indexes the pointee: `p.as_slice()[i]`, `(*p)[i]` for a slice;
// read, assign, compound-assign, slicing, generic; checked, safe. Through
// a raw `*[T]` (0.18.1: every `*T` parameter) it means the same, in unsafe.
// EXPECT: true false 7
// EXPECT: 1 9 7 -1
// EXPECT: azc z
// EXPECT: 16 16
// EXPECT: 2 9 3
// EXPECT: 9 7
fn relax(dist: inout Vec<i64>, u: i64, nd: i64) -> bool {
    if dist[u] < 0 || nd < dist[u] {
        dist[u] = nd;
        return true;
    }
    false
}

fn bump(b: inout Buf, i: i64) -> inout [u8] {
    b[i] += 1;
    &b[i..i + 1]
}

fn total(s: *[i64]) -> i64 {
    unsafe {
        var t = 0;
        for i in 0..(*s).len {
            t += s[i];
        }
        s[0] = t;
        t
    }
}

fn mid(v: Vec<i64>) -> [i64] { v[1..3] }

fn tail(s: *[i64]) -> [i64] { unsafe { s[1..] } }

fn at<T>(v: Vec<T>, i: i64) -> T { v[i] }

fn main(gpa: Gpa) -> i32 {
    var d: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..4 {
        d.push(-1);
    }
    let a = relax(&d, 2, 7);
    let b = relax(&d, 2, 9);
    println(f"{a} {b} {d[2]}");
    d[0] = 1;
    d[1] += 10;
    println(f"{d[0]} {d[1]} {d[2]} {d[3]}");
    var buf = Buf::new_in(gpa);
    buf.push_str("abc");
    let one = bump(&buf, 1);
    one[0] = 'z';
    let one: [u8] = one;
    print(buf.as_slice());
    println(f" {one}");
    let s = d.as_slice();
    let t = total(&s);
    println(f"{t} {d[0]}");
    let m = mid(d);
    println(f"{m.len} {m[0]} {tail(&s).len}");
    println(f"{at(d, 1)} {(&d)[2]}");
    0
}
