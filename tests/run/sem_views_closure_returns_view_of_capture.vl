// (0.25 semantics audit, views) A closure that returns a view of a
// captured owner (`|| s.as_str()`) returns a view of s: growing s while
// the result is used is own.conflict. It is accepted: a use after free.
// XFAIL: SOUNDNESS a closure's view of its captured owner loses its origin: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    let c = || s.as_str();
    let r = c();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
