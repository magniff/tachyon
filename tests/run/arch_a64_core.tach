// EXPECT: memchr 37 -1 0 63
// EXPECT: popcount 194 194
// EXPECT: ascii true false
// EXPECT: utf8-lead 2 2
// EXPECT: crc32 cbf43926 cbf43926
// EXPECT: crc32c e3069283 e3069283
// EXPECT: tbx 9 8 7 6 99 99 99 99
// EXPECT: zero 255 0 255 0
// EXPECT: sat 9223372036854775807 -9223372036854775808
// EXPECT: minv 3 250
// (0.19 T4) The AArch64 intrinsics std's 0.20 work builds on, each one
// instruction (the ASM lines; a 64-bit lane's are scalar `d` forms): a
// byte search, a popcount, the ASCII fast path and UTF-8 lead bytes of a
// validator, CRC-32 and CRC-32C by their check values (with the
// inversions around them), tbx, compares against zero, the 64-bit
// saturating add.
// CHECK-OPT: 2
// ASM(aarch64-macos): cmeq v
// ASM(aarch64-macos): umaxv b31
// ASM(aarch64-macos): crc32cx w
// ASM(aarch64-macos): crc32cb w
// ASM(aarch64-macos): crc32x w
// ASM(aarch64-macos): crc32b w
// ASM(aarch64-macos): cnt v
// ASM(aarch64-macos): uaddlv h31
// ASM(aarch64-macos): ushr v
// ASM(aarch64-macos): tbx v
// ASM(aarch64-macos): cmeq v
// ASM(aarch64-macos): sqadd d
// ASM(aarch64-macos): uminv b31
// ASM(aarch64-linux): cmeq v
// ASM(aarch64-linux): umaxv b31
// ASM(aarch64-linux): crc32cx w
// ASM(aarch64-linux): cnt v
// ASM(aarch64-linux): tbx v
// ASM(aarch64-linux): sqadd d
use std::count_ones;
use std::arch::{detect, has};
use std::arch::aarch64::{
    __crc32b, __crc32cb, __crc32cd, __crc32d, uint8x16_t, vaddlvq_u8, vaddvq_u8, vceqq_u8,
    vceqzq_u8, vcgtq_u8, vcntq_u8, vdup_n_s64, vdupq_n_u8, vget_lane_s64, vget_lane_u64, vld1q_u8,
    vmaxvq_u8, vminvq_u8, vmovn_u16, vqadd_s64, vqtbx1_u8, vreinterpretq_u16_u8, vshrn_n_u16,
    vshrq_n_u8, vst1_u8, vst1q_u8,
};

// The first i >= from with s[i] == b, or -1: 16 bytes at a time, the
// shrn movemask (four bits per byte) finding the lane.
fn memchr(s: [u8], b: u8, from: i64) -> i64 {
    let needle = vdupq_n_u8(b);
    let mut i = from;
    while i + 16 <= s.len as i64 {
        let eq = vceqq_u8(vld1q_u8(s, i), needle);
        if vmaxvq_u8(eq) != 0 {
            let m = vget_lane_u64(v1u64::from_bits(vshrn_n_u16(vreinterpretq_u16_u8(eq), 4)), 0);
            let mut n = 0;
            while ((m >> (4 * n) as u64) & 1) == 0 {
                n += 1;
            }
            return i + n;
        }
        i += 16;
    }
    while i < s.len as i64 {
        if s[i] == b {
            return i;
        }
        i += 1;
    }
    -1
}

// The 1 bits of s, 16 bytes at a time (cnt, then a widening sum).
fn popcount(s: [u8]) -> i64 {
    let mut total = 0;
    let mut i = 0;
    while i + 16 <= s.len as i64 {
        total += vaddlvq_u8(vcntq_u8(vld1q_u8(s, i))) as i64;
        i += 16;
    }
    total
}

fn popcount_scalar(s: [u8]) -> i64 {
    let mut t = 0;
    for i in 0..s.len as i64 {
        t += count_ones(s[i] as u64);
    }
    t
}

// Whether the 16 bytes at i are ASCII (a validator's fast path).
fn ascii16(s: [u8], i: i64) -> bool {
    vmaxvq_u8(vld1q_u8(s, i)) < 0x80
}

// The bytes of the 16 at i that start a multi-byte sequence (>= 0xc0),
// counted: shr 6 gives 3 for them, the mask's top bits are summed.
fn leads16(s: [u8], i: i64) -> i64 {
    let top = vshrq_n_u8(vld1q_u8(s, i), 6);
    let lead = vcgtq_u8(top, vdupq_n_u8(2));
    vaddvq_u8(vshrq_n_u8(lead, 7)) as i64
}

fn crc32(s: [u8], castagnoli: bool) -> u32 {
    let mut c: u32 = 0xffffffff;
    let mut i = 0;
    while i + 8 <= s.len as i64 {
        let mut w: u64 = 0;
        for j in 0..8 {
            w = w | (s[i + j] as u64) << (8 * j) as u64;
        }
        c = if castagnoli { __crc32cd(c, w) } else { __crc32d(c, w) };
        i += 8;
    }
    while i < s.len as i64 {
        c = if castagnoli { __crc32cb(c, s[i]) } else { __crc32b(c, s[i]) };
        i += 1;
    }
    c ^ 0xffffffff
}

// The same, a bit at a time.
fn crc32_bits(s: [u8], poly: u32) -> u32 {
    let mut c: u32 = 0xffffffff;
    for i in 0..s.len as i64 {
        c = c ^ s[i] as u32;
        for _ in 0..8 {
            c = if (c & 1) != 0 { (c >> 1) ^ poly } else { c >> 1 };
        }
    }
    c ^ 0xffffffff
}

fn print_hex(x: u32) {
    let digits = "0123456789abcdef";
    print(" ");
    for k in 0..8 {
        print(
            digits[
                ((x >> (4 * (7 - k)) as u32) & 15) as i64..((x >> (4 * (7 - k)) as u32) & 15) as i64 + 1]);
    }
}

fn crc_line(label: [u8], s: [u8], castagnoli: bool) {
    if detect("crc") {
        let poly: u32 = if castagnoli { 0x82f63b78 } else { 0xedb88320 };
        print(label);
        print_hex(crc32(s, castagnoli));
        print_hex(crc32_bits(s, poly));
        println("");
    } else {
        println(f"{label} {if castagnoli { "e3069283 e3069283" } else { "cbf43926 cbf43926" }}");
    }
}

fn show16(label: [u8], v: uint8x16_t, n: i64) {
    let mut out: [u8; 16] = [0; 16];
    vst1q_u8(out[..], 0, v);
    print(label);
    for k in 0..n {
        print(f" {out[k]}");
    }
    println("");
}

fn main() {
    let mut buf: [u8; 80] = [0; 80];
    for i in 0..80 {
        buf[i] = (i % 37 + 1) as u8;
    }
    buf[63] = 200;
    println(
        f"memchr {memchr(buf[..], 1, 1)} {memchr(buf[..], 99, 0)} {memchr(buf[..], 1, 0)} {memchr(buf[..], 200, 0)}");
    println(f"popcount {popcount(buf[..])} {popcount_scalar(buf[..])}");
    let mut text: [u8; 32] = [0x41; 32];
    text[20] = 0xc3;
    text[21] = 0xa9;
    text[25] = 0xe2;
    println(f"ascii {ascii16(text[..], 0)} {ascii16(text[..], 16)}");
    println(f"utf8-lead {leads16(text[..], 16)} {leads16(text[..], 10)}");
    let check = "123456789";
    crc_line("crc32", check, false);
    crc_line("crc32c", check, true);
    // tbx: indexes below 16 look up, the rest keep the old lane
    let table = vld1q_u8(buf[..], 0);
    let mut idx: [u8; 8] = [8, 7, 6, 5, 16, 200, 255, 17];
    let mut old: [u8; 8] = [99; 8];
    let r = vqtbx1_u8(v8u8::load(old[..], 0), table, v8u8::load(idx[..], 0));
    vst1_u8(old[..], 0, r);
    println(f"tbx {old[0]} {old[1]} {old[2]} {old[3]} {old[4]} {old[5]} {old[6]} {old[7]}");
    let mut z: [u8; 16] = [0; 16];
    z[1] = 4;
    z[3] = 255;
    show16("zero", vceqzq_u8(vld1q_u8(z[..], 0)), 4);
    let big = vdup_n_s64(9223372036854775800);
    let small = vdup_n_s64(-9223372036854775800);
    println(
        f"sat {vget_lane_s64(vqadd_s64(big, big), 0)} {vget_lane_s64(vqadd_s64(small, small), 0)}");
    let mut m: [u8; 16] = [7; 16];
    m[5] = 3;
    m[9] = 250;
    let v = vld1q_u8(m[..], 0);
    println(f"minv {vminvq_u8(v)} {vmaxvq_u8(v)}");
    if has("neon") {
        let _ = vmovn_u16(vreinterpretq_u16_u8(v));
    }
}
