struct N { v: Vec<i64> }

impl std::Add for N {
    fn add(self: N, other: N) -> N {
        let mut v = self.v.clone();
        for x in other.v.iter() { v.push(x); }
        N { v: v }
    }
}

fn mk(x: i64, gpa: Gpa) -> N { let mut v: Vec<i64> = Vec::new_in(gpa); v.push(x); N { v: v } }

fn main(gpa: Gpa) -> i32 {
    let a = mk(1, gpa);
    let c = mk(2, gpa);
    let b = a + c;
    let d = b + mk(3, gpa);
    std::print_int(d.v.len());
    println("");
    0
}
// (0.17, T7) An arithmetic operator's operands move into its by-value
// `add(self, other)`: `a + c` moves a and c (they were read, then dropped
// a second time by the caller). err_own_operator_moves: a use after.
// FLAGS: --check-alloc
// EXPECT: 3
