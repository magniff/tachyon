// try_with on a Mutex inside its own with: the lock is held, so None (no second access to the data)
// FLAGS: --check-alloc
// EXPECT: true 2
use std::sync::Mutex;

fn main() {
    let m = Mutex::new(1);
    let r = m.with(|a| {
        let inner = m.try_with(|b| { b += 10; b });
        a += 1;
        inner.is_none()
    });
    println(f"{r} {m.with(|n| n)}");
}
