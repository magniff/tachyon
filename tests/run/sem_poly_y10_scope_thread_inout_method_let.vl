// a scoped thread calls an inout method on a captured let struct (the let-receiver bug, across threads)
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'p', which the scope's o
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'p', which the scope's o
use std::thread;
struct P { x: i64 }
impl P { fn bump(inout self) { self.x += 1; } }

fn main() {
    let p = P { x: 0 };
    thread::scope(|s| {
        s.spawn(|| { for _ in 0..100000 { p.bump(); } 0 });
        s.spawn(|| { for _ in 0..100000 { p.bump(); } 0 });
        0
    });
    println(f"{p.x}");
}
