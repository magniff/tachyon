// 0.20: std is a tree of modules; every item is at its module's path and,
// as before, at std::NAME (a re-export), and the prelude finds it.
// EXPECT: 1 1 [1, 2, 3] 6 3 4 true
// EXPECT: P(4)
// EXPECT: via std::fmt
use std::collections::HashMap;
use std::collections::hash_map::HashMap as Map2;
use std::fmt::Display;
use std::iter::Iterator;
use std::num::{I64_MAX, count_ones};
use std::slice::sort;

struct P { x: i64 }

impl Display for P {
    fn fmt(self: &P, f: &mut Fmt) { f.write(f"P({self.x})"); }
}

fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(1, 10);
    let mut n: Map2<i64, i64> = std::HashMap::new_in(gpa);
    n.insert(2, 20);
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    v.push(2);
    sort(v.as_mut_slice());
    std::sort(v.as_mut_slice());
    let total = v.iter().fold(0, |a, x| a + x);
    println(
        f"{m.len()} {n.len()} {v:?} {total} {count_ones(7)} {std::count_ones(15)} {I64_MAX > 0}");
    println(f"{P { x: 4 }}");
    std::fmt::println("via std::fmt");
    0
}
