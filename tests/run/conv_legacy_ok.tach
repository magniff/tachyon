// tachyon-syntax: 0.19 (the legacy mode's own test: tests/run.sh allows the line in tests/run/conv_legacy*)
// 0.20 Phase 0: a crate read in 0.19's spelling (compiler/src during 0.20,
// conventions.md §9.3): 0.19's forms, with `var`, `inout` and `sink` as
// identifiers; `&x` stays shared.
// EXPECT: 5 3
fn sink(var: &mut i64) { *var += 2; }

fn main() {
    let mut inout = 3;
    sink(&mut inout);
    let r = &inout;
    let var = 3;
    println(f"{*r} {var}");
}
