// Character literals (bytes), typed literals and escapes.
// EXPECT: AzA 7 10 39 92 66
// EXPECT: 0 4000000000 -128 2.0 1.5 1000.0 7
// EXPECT: 5 été
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let c = 'A';
    let digit: u8 = '7' - '0';
    let nl = '\n';
    let q = '\'';
    let bs = '\\';
    let hex = '\x7a';
    let uni = '\u{41}';
    printf(c"%c%c%c %d %d %d %d %d\n", c, hex, uni, digit, nl as i32, q as i32, bs as i32, c + 1);

    let a = 255u8;
    let b = a + 1;
    let big = 4_000_000_000u32;
    let neg = -128i8;
    let f = 2f32;
    let g = 1.5f64;
    let h = 1e3f32;
    let n = 7usize;
    printf(c"%d %u %d %.1f %.1f %.1f %lu\n", b as i32, big, neg as i32, f, g, h, n);

    let s = "\u{e9}t\u{e9}";
    printf(c"%ld %s\n", (s.len as u64) as i64, s.ptr);
    0
}
