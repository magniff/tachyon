// (0.18 with 0.17's values) An ensures runs after the body: a by-value
// parameter of an owned type is gone by then, and an old(..) that views
// something would see what the body changed (contract.old, design §2.1).
fn size(v: Vec<i64>) -> i64
    ensures result == v.len()
{
    v.len()
}

fn view(v: &mut Vec<i64>) -> i64
    ensures old(v.as_slice()).len == 0
{
    v.push(1);
    v.len()
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    view(&mut v);
    size(v);
    0
}
// ERROR: the ensures of 'size' reads 'v' after the body took it ('Vec<i64>' is owned, passed by value)
// ERROR: 'old(v.as_slice())' keeps a view: the ensures of 'view' runs after the body
// ERROR-COUNT: 2
