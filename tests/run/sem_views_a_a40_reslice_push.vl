// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: slice of a slice, then push
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 1..5 { v.push(i); }
    let c = v.as_slice()[1..3][1..];
    v.push(9);
    println(c[0]);
    0
}
