// 0.25: a for over an owned temporary or an owning iterator drops what it
// has not reached on every exit: break, return, ? and the end.
// FLAGS: --check-alloc
// EXPECT: first 3
// EXPECT: found 2
// EXPECT: err
// EXPECT: end: made 17 dropped 17
static var MADE: i64 = 0;
static var DROPS: i64 = 0;
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { DROPS += 1; } }
impl Eq for D { fn eq(self, o: Self) -> bool { self.id == o.id } }
impl Ord for D { fn cmp(self, o: Self) -> i64 { self.id - o.id } }

fn mk(id: i64, gpa: Gpa) -> D {
    MADE += 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

// Makes D 1, 2, ..., n, one per call to next.
struct Gen { n: i64, k: i64, gpa: Gpa }

impl Iterator for Gen {
    type Item = D;

    fn next(inout self) -> Option<D> {
        if self.k >= self.n { return None; }
        self.k += 1;
        Some(mk(self.k, self.gpa))
    }
}

fn gen(n: i64, gpa: Gpa) -> Gen { Gen { n: n, k: 0, gpa: gpa } }
// Owns D 1..n (pops n first): the ones it has not given out drop with it.
struct Pop { v: Vec<D> }

impl Iterator for Pop {
    type Item = D;
    fn next(inout self) -> Option<D> { self.v.pop() }
}

fn pop(n: i64, gpa: Gpa) -> Pop {
    var v: Vec<D> = Vec::new_in(gpa);
    for i in 1..=n { v.push(mk(i, gpa)); }
    Pop { v: v }
}

fn report(what: [u8]) {
    println(f"{what}: made {MADE} dropped {DROPS}");
}

fn vec(n: i64, gpa: Gpa) -> Vec<D> {
    var v: Vec<D> = Vec::new_in(gpa);
    for i in 1..=n { v.push(mk(i, gpa)); }
    v
}

fn find2(gpa: Gpa) -> i64 {
    for d in vec(4, gpa) { if d.id == 2 { return d.id; } }
    -1
}

fn check(d: D) -> Result<i64, i64> { if d.id == 3 { Err(d.id) } else { Ok(d.id) } }

fn sum(gpa: Gpa) -> Result<i64, i64> {
    var s = 0;
    for d in pop(5, gpa) { s += check(d)?; }
    for d in vec(3, gpa) { s += check(d)?; }
    Ok(s)
}

fn main(gpa: Gpa) {
    for d in pop(3, gpa) { println(f"first {d.id}"); break; }
    println(f"found {find2(gpa)}");
    match sum(gpa) { Ok(s) => println(f"sum {s}"), Err(_) => println("err") }
    for d in gen(3, gpa) { if d.id == 2 { continue; } }
    for d in vec(2, gpa).take() {}
    report("end");
}
