// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a closure returning a closure's view result
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    let w = s.as_str();
    let c = || w;
    let d = || c();
    let r = d();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
