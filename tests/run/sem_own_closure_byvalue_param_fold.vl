// sem-own: fold's accumulator is sink in the closure; moved back as the
// result each step: no leak, no double free of the Vec accumulator.
// EXPECT: len 3
// EXPECT: end
fn main(gpa: Gpa) {
    let xs = [1, 2, 3];
    let acc: Vec<i64> = Vec::new_in(gpa);
    let out = xs[..].iter().fold(acc, |a, x| { var b = a; b.push(x); b });
    println(f"len {out.len()}");
    println("end");
}
