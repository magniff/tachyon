// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 1 (view re-pointed to another owner before the push)
// XFAIL: OVERSTRICT a view field re-pointed to another owner keeps the old loan
// EXPECT: 1
struct W { s: [i64] }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    var u: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    u.push(1);
    var w = W { s: v.as_slice() };
    w.s = u.as_slice();
    v.push(2);
    println(w.s[0]);
    0
}
