// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: two mutating closures over v live at once
// XFAIL: WRONG a closure's mutating capture is not exclusive (v read, or a second mutating closure, while it is live)
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    var a = |x: i64| v.push(x);
    var b = || v.clear();
    a(1);
    b();
    a(2);
    println(v.len());
    0
}
