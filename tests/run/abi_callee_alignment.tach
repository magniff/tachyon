// Functions reached with odd and even numbers of stack arguments call
// printf with doubles (movaps on a misaligned stack would crash).
// EXPECT: 7 1.25 2.50
// EXPECT: 8 2.50
// EXPECT: 7 1.25 2.50
extern fn printf(format: *u8, ...) -> i32;

fn p7(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) {
    let x: f64 = 1.25;
    printf("%ld %.2f %.2f\n".0, a + b + c + d + e + f + g, x, x * 2.0);
}

fn p8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) {
    let x: f64 = 2.5;
    printf("%ld %.2f\n".0, a + b + c + d + e + f + g + h, x);
    p7(a, b, c, d, e, f, g);
}

fn main() -> i64 {
    p7(1, 1, 1, 1, 1, 1, 1);
    p8(1, 1, 1, 1, 1, 1, 1, 1);
    0
}
