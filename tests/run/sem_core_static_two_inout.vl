// two inout accesses of one static: f(&G, &G) overlaps (own.conflict expected).
// ERROR: own.conflict
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn two(x: inout Big, y: inout Big) -> i64 { x.a = 10; y.a = 20; x.a }

fn main() -> i32 { println(two(&G, &G)); 0 }
