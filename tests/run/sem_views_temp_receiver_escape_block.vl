// (0.25 semantics audit, views) A view of a method call's temporary
// receiver (`mk(gpa).view()`, `views(self)`) lives only as long as the
// temporary: the temporary lives to the end of its block, so a view of it
// assigned to a variable of an outer block (or pushed into an outer Vec in
// a loop) outlives it. The view must be own.escape, as `nm(mk())`, a
// function's temporary argument, already is in a loop.
// XFAIL: SOUNDNESS a view of a temporary receiver escapes its block: use after free
// ERROR: error[own.escape]
struct H { b: Buf }
impl H { fn view(self) -> [u8] { self.b.as_slice() } }
fn mk(gpa: Gpa, c: u8) -> H { var b = Buf::new_in(gpa); b.push(c); b.push(c); H { b: b } }
fn main(gpa: Gpa) -> i32 {
    var keep: [u8] = "";
    {
        keep = mk(gpa, 'a').view();
    }
    println(keep);
    0
}
