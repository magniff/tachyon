// a scoped thread writing through the caller's inout parameter
// ERROR: sync
use std::thread;

fn go(n: inout i64) {
    thread::scope(|s| {
        let a = s.spawn(|| { n += 1; 0 }); let b = s.spawn(|| { n += 1; 0 }); a.join() + b.join()
    });
}

fn main() { var n = 0; go(&n); println(f"{n}"); }
