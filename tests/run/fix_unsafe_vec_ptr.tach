// FIXUNSAFE: 0.17
// FIXED:     unsafe { st[0] }
// FIXED:     let v = unsafe { p[1] };
// FIXED:     unsafe { h.vp[0] = 7; }
// EXPECT: 1 2 7
// 0.17: `p[i]` through a raw pointer to a Vec means the same in `unsafe`
// code, so `fix --only unsafe` wraps it (before, it was pointer arithmetic
// there, and the fix left such places alone).
struct H { vp: *Vec<i64> }

fn top(mut st: *Vec<i64>) -> i64 {
    st[0]
}

fn main(gpa: Gpa) -> i32 {
    let mut d: Vec<i64> = Vec::new_in(gpa);
    defer d.free();
    d.push(1);
    d.push(2);
    let p = &d;
    let v = p[1];
    let h = H { vp: &d };
    h.vp[0] = 7;
    println(f"{top(&d) - 6} {v} {d[0]}");
    0
}
