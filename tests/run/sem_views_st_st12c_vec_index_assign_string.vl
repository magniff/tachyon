// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: owners[0] replaced while a view into it is used
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var owners: Vec<String> = Vec::new_in(gpa);
    owners.push(String::from_in("hello", gpa));
    let w = owners[0].as_str();
    owners[0] = String::from_in("bye", gpa);
    println(w);
    0
}
