// sem-own: moved in one match arm only; drop flag decides.
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: kept
// EXPECT: drop 2
// EXPECT: kept
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn run(id: i64, k: i64, gpa: Gpa) {
    let d = mk(id, gpa);
    match k {
        0 => eat(d),
        1 => println("kept"),
        _ => { println("kept"); }
    }
}

fn main(gpa: Gpa) { run(1, 0, gpa); run(2, 1, gpa); run(3, 2, gpa); }
