// FLAGS: --check-alloc
// EXIT: 101
// EXPECT: before 3 used 128
// STDERR: use after release: block #3 (128 bytes) of an arena, allocated at
// STDERR: checkalloc_fixedbuf_reset.tach:14:22, released at
// STDERR: checkalloc_fixedbuf_reset.tach:17:14
// 0.16: --check-alloc with a FixedBuf: the same for its reset.
use std::FixedBuf;

fn main(gpa: Gpa) -> i32 {
    let mut mem: [u8; 4096] = [0; 4096];
    let fb = FixedBuf::new(mem[..]);
    let mut v: Vec<i64, FixedBuf> = Vec::new_in(fb);
    for i in 0..10 { v.push(i); }
    let s = v.as_slice();
    println(f"before {s[3]} used {fb.used()}");
    unsafe { fb.reset(); }
    println(f"after {s[3]}");
    0
}
