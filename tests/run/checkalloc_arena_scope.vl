// FLAGS: --check-alloc --values=off
// EXIT: 101
// STDERR: use after release: block #4 (128 bytes) of an arena, allocated at
// STDERR: checkalloc_arena_scope.vl:12:26, released at
// STDERR: checkalloc_arena_scope.vl:10:20 (the arena's reset or scope end)
// 0.16 (0.17 rejects this code: --values=off, 0.16's semantics): --check-alloc: a view returned out of an arena scope (the one
// hole #[scoped] leaves) is caught at its first use; the release is at the
// scope's call.
fn main(gpa: Gpa) -> i32 {
    let s: [i64] = arena_scope(gpa, |a| {
        var v: Vec<i64, ScopedArena> = Vec::new_in(a);
        for i in 0..10 { v.push(i); }
        v.as_slice()
    });
    println(f"after {s[3]}");
    0
}
