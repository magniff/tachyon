// (0.21) What a scoped thread borrows must outlive the scope's closure.
// ERROR: a thread of 'thread::scope' borrows 'mine', made inside the scope's closure

use std::thread;

fn main(gpa: Gpa) {
    let n = thread::scope(|s| {
        let mut mine: Vec<i64> = Vec::new_in(gpa);
        mine.push(1);
        let h = s.spawn(|| mine.len());
        h.join()
    });
    println(f"{n}");
}
