// v[0].f(&v[1]): receiver and argument are elements of one Vec
// ERROR: own.conflict
struct S { n: i64 }
impl S { fn add(inout self, o: inout S) { self.n += o.n; o.n = 0; } }
fn main(gpa: Gpa) { var v: Vec<S> = Vec::new_in(gpa); v.push(S { n: 1 }); v.push(S { n: 2 }); v[0].add(&v[1]); println(f"{v[0].n} {v[1].n}"); }
