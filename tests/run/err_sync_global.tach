// (0.21) The shared-static rule: a static mut is for the main thread.
// ERROR: 'thread::spawn' runs a closure on another thread, but it reaches a static mut

use std::thread;

static mut COUNT: i64 = 0;

fn bump() {
    COUNT += 1;
}

fn main() {
    let h = thread::spawn(move || {
        bump();
        0
    });
    h.join();
    println(f"{COUNT}");
}
