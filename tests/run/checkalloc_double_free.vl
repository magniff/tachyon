// FLAGS: --check-alloc --values=off
// EXIT: 101
// STDERR: double free: block #2 (64 bytes), allocated at
// STDERR: checkalloc_double_free.vl:12:9, freed at
// STDERR: checkalloc_double_free.vl:16:5, freed again at
// STDERR: checkalloc_double_free.vl:17:5
// 0.16 (0.17 rejects this code: --values=off, 0.16's semantics): --check-alloc: a container freed twice through two copies of its
// handle (block #1 is the Vec's first, freed when it grew).
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::with_capacity_in(1, gpa);
    for i in 0..5 {
        v.push(i);
    }
    v.push(5);
    var w = v;
    v.free();
    w.free();
}
