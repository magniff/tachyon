// a struct holding a view passed let to a generic: copied; the copy and original both view v
// ERROR: [own.conflict]: 'b.push_str(" world, a much longer text to force a reallocat
struct Tok { t: [u8] }
fn keep<T>(x: T, gpa: Gpa) -> Vec<T> { var r: Vec<T> = Vec::new_in(gpa); r.push(x); r }

fn main(gpa: Gpa) {
    var b = Buf::new_in(gpa);
    b.push_str("hello");
    let tk = Tok { t: b.as_slice() };
    let ks = keep(tk, gpa);
    b.push_str(" world, a much longer text to force a reallocation of the buffer's storage");
    println(ks[0].t);
}
