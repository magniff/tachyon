// The address is taken in another function; the #[no_io] one only calls through a value of that type.
// ERROR: 'quiet' is #[no_io], but it does io
fn noisy(x: i64) -> i64 { println("io"); x }
fn plain(x: i64) -> i64 { x }

fn pick(k: i64) -> fn(i64) -> i64 { if k == 0 { plain } else { noisy } }

#[no_io]
fn quiet(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }

fn main() -> i32 {
    println(quiet(pick(1), 3));
    0
}
