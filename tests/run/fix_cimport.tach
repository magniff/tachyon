// FIXIMPORTS: a plain header import gets a name, and its uses the path (0.8)
// FIXED: import "stdio.h" as c;
// FIXED: import "stdlib.h" as c;
// FIXED:     let d: c::div_t = c::div(17, 5);
// FIXED:     c::printf(c"div %d %d\n", d.quot, d.rem);
// FIXED:     let abs = c::abs(-3) + 1;
// FIXED: use c::EOF;
// FIXED:         EOF => 1,
// FIXED:     let f: extern "C" fn(i32) -> i32 = c::abs;
// EXPECT: div 3 2
// EXPECT: abs 4 9
// EXPECT: eof 1
// Code written for 0.7: `import "h.h";` brought every declaration into
// scope. A local of the same name (`abs`) is left alone.
import "stdio.h";
import "stdlib.h";

fn is_eof(x: i32) -> i32 {
    match x {
        EOF => 1,
        _ => 0,
    }
}

fn main() -> i32 {
    let d: div_t = div(17, 5);
    printf(c"div %d %d\n", d.quot, d.rem);
    let f: extern "C" fn(i32) -> i32 = abs;
    let abs = abs(-3) + 1;
    printf(c"abs %d %d\n", abs, f(-9));
    printf(c"eof %d\n", is_eof(-1));
    0
}
