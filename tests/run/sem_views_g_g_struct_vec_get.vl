// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `b.first()`; s grows while it is used
// XFAIL: SOUNDNESS a function's view of what its parameter's elements or fields hold is lost (summary): use after free
// ERROR: error[own.conflict]
struct B { names: Vec<str> }
impl B { fn first(self) -> str { self.names.get(0) } }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); let b = B { names: v };
    let r = b.first();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
