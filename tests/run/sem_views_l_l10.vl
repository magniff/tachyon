// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello (Option and tuple results of a let-param view)
// EXPECT: hello hello hello 7
struct E { name: [u8; 8], len: i64 }
fn nm(e: E) -> Option<[u8]> { Some(e.name[..e.len]) }
fn nt(e: E) -> (i64, [u8]) { (e.len, e.name[..e.len]) }
struct V { t: [u8] }
fn nv(e: E) -> V { V { t: e.name[..e.len] } }
fn clobber() -> i64 { let z = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 };
    let a = nm(e).unwrap();
    let (_, b) = nt(e);
    let c = nv(e);
    let k = clobber();
    println(f"{a} {b} {c.t} {k}");
    0
}
