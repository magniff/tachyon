// Value ranges (0.18.1): a Vec's length read as a slice's (`sub len, 0`
// in u64) is the same value as the length, so `for i in 0..v.len()`
// proves v[i]; and two facts chain through a third value: `i < n` (the
// loop's) and `n <= v.len()` (a guard's, an assert's, a requires') prove
// v[i]. A chain the wrong way round proves nothing: its check stays.
// EXPECT: 45 45 45 45 45
// CHECK: fn whole:
// CHECK-NOT: rt.panic
// CHECK: fn guarded:
// CHECK-NOT: rt.panic
// CHECK: fn asserted:
// CHECK: rt.panic
// CHECK-NOT: rt.panic
// CHECK: fn returned:
// CHECK-NOT: rt.panic
// CHECK: fn wrong_way:
// CHECK: rt.panic
// CHECK: fn main:

#[inline(never)]
fn whole(v: &Vec<i64>) -> i64 {
    let mut s = 0;
    for i in 0..v.len() {
        s += v[i];
    }
    s
}

#[inline(never)]
fn guarded(v: &Vec<i64>, n: i64) -> i64 {
    let mut s = 0;
    if n <= v.len() {
        for i in 0..n {
            s += v[i];
        }
    }
    s
}

// The assert's own check stays (one rt.panic), the bounds check goes.
#[inline(never)]
fn asserted(v: &Vec<i64>, n: i64) -> i64 {
    assert(n <= v.len());
    let mut s = 0;
    for i in 0..n {
        s += v[i];
    }
    s
}

#[inline(never)]
fn returned(v: &Vec<i64>, n: i64) -> i64 {
    if n > v.len() {
        return 0;
    }
    let mut s = 0;
    for i in 0..n {
        s += v[i];
    }
    s
}

// n >= v.len() says nothing of i < v.len().
#[inline(never)]
fn wrong_way(v: &Vec<i64>, n: i64) -> i64 {
    let mut s = 0;
    if n >= v.len() {
        for i in 0..n {
            if i < 10 {
                s += v[i];
            }
        }
    }
    s
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 {
        v.push(i);
    }
    println(
        f"{whole(&v)} {guarded(&v, 10)} {asserted(&v, 10)} {returned(&v, 10)} {wrong_way(&v, 12)}");
    0
}
