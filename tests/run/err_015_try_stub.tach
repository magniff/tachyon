// 0.15, phase 0: `?` parses (a postfix operator, as `.`, `(` and `[`)
// and is reported as not implemented yet. (The errors task replaces this
// case with its own.)
// ERROR: '?' expressions are not implemented yet (check.unimplemented)
// ERROR: '?' expressions are not implemented yet (check.unimplemented)
// ERROR-COUNT: 2
fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

fn quarter(x: i64) -> Option<i64> {
    let h = half(x)?;
    Some(half(h)?.max(0))
}

fn main() {
    quarter(8);
}
