// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(t)`; s grows while it is used
// ERROR: error[own.conflict]
fn f(t: (Vec<str>, i64)) -> str { t.0[0] }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); let t = (v, 1);
    let r = f(t);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
