// XFAIL: OVERSTRICT HashMap<K, Vec<T>>::get_mut does not instantiate (std's p[0..1] on *V indexes the Vec)
// HashMap::get_mut with an owned value type
// EXPECT: 2
fn main(gpa: Gpa) { var m: HashMap<i64, Vec<i64>> = HashMap::new_in(gpa); m.insert(1, Vec::new_in(gpa)); match m.get_mut(1) { Some(v) => { v[0].push(5); v[0].push(6); } None => {} } println(f"{m.get(1).unwrap().len()}"); }
