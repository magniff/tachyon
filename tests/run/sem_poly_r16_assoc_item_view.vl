// an iterator whose Item is a view of a Vec it holds a view of: kept items outlive the Vec?
// ERROR: [own.conflict]: 'v.push(i)' may change 'v' while 'a'
struct It { s: [i64], pos: i64 }

impl Iterator for It {
    type Item = [i64];

    fn next(inout self) -> Option<[i64]> {
        if self.pos >= self.s.len() { return None; }
        self.pos += 1;
        Some(self.s[self.pos - 1..self.pos])
    }
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1); v.push(2);
    var it = It { s: v.as_slice(), pos: 0 };
    let a = it.next().unwrap();
    for i in 0..100 { v.push(i); }
    println(f"{a[0]}");
}
