// an impl whose parameter is let where the trait says inout
// ERROR: [type error]: 'add_to' does not have the signature trait 'A' declares: exp
trait A { fn add_to(self, n: inout i64); }
struct P { x: i64 }
impl A for P { fn add_to(self, n: i64) { println(f"{n}"); } }
fn main() { let p = P { x: 1 }; var k = 0; p.add_to(&k); println(f"{k}"); }
