// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of a HashMap's String value, then insert grows the map
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<i64, String> = HashMap::new_in(gpa);
    m.insert(1, String::from_in("hello", gpa));
    let w = m.get(1).unwrap().as_str();
    m.insert(1, String::from_in("bye", gpa));
    println(w);
    0
}
