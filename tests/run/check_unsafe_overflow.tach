// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: 45
// STDERR: unsafe access out of bounds (just past the end): 8 bytes at offset 80 of a block of 80 bytes
// STDERR: check_unsafe_overflow.tach: line 26, column 22
// 0.10: --check-unsafe finds an access past the end of a heap block.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
    fn fflush(f: *u8) -> i32;
}

fn main() -> i32 {
    let p = unsafe { malloc(80) as *i64 };
    for i in 0..10 {
        unsafe { p[i] = i; }
    }
    var s = 0;
    for i in 0..10 {
        unsafe { s += p[i]; }
    }
    unsafe {
        printf(c"%ld\n", s);
        fflush(0 as *u8);
    }
    let x = unsafe { p[10] };
    x as i32
}
