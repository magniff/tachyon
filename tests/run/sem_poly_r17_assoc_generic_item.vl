// a generic over I: Iterator collecting I::Item; Item owned and plain
// FLAGS: --check-alloc
// EXPECT: 2
// EXPECT: drop 2
// EXPECT: 0
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;

    fn next(inout self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        Some(R { id: self.n })
    }
}

fn firstof<I: Iterator>(it: sink I) -> Option<I::Item> { it.next() }

fn main() {
    let a = firstof(Gen { n: 3 });
    println(f"{a.unwrap().id}");
    println(f"{firstof(0..4).unwrap()}");
    println("end");
}
