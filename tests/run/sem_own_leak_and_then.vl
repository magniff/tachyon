// sem-own: (known leak, scope) Option::and_then's closure takes the payload sink.
// XFAIL: SOUNDNESS known leak: a closure's sink parameter is never dropped (and_then)
// EXPECT: drop 1
// EXPECT: v 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let o: Option<D> = Some(mk(1, gpa));
    let v = o.and_then(|d| Some(d.id));
    println(f"v {v.unwrap_or(0)}");
}
