// a call through fn(inout i64, inout i64) with the same place twice: own.conflict
// ERROR: [own.conflict]: 'x' is borrowed mutably by '&x' and mutably again by '&x' in
fn sw(a: inout i64, b: inout i64) { let t = a; a = b; b = t + 1; }

fn main() {
    let f: fn(inout i64, inout i64) = sw;
    var x = 1;
    f(&x, &x);
    println(f"{x}");
}
