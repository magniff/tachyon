// (0.17, T7) A `&mut self` method on a place reached through a `&T` is a
// write through it: own.readonly, as an assignment is (it was accepted,
// and `fix --values` could make such a parameter `&T`). A legacy `*T`
// receiver is not checked (the legacy rule), and a `&mut` parameter is
// fine.
struct Bag { v: Vec<i64> }

fn bump(b: Bag) {
    b.v.push(7);
}

fn grow(b: inout Bag) {
    b.v.push(7);
}

fn main(gpa: Gpa) -> i32 {
    var b = Bag { v: Vec::new_in(gpa) };
    grow(&b);
    bump(b);
    0
}
// ERROR: writes through 'b', a '&Bag', which is read-only
// ERROR-COUNT: 1
