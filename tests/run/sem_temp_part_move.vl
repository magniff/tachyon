// (0.25) A field or tuple part moved out of an owned temporary (`mp().a`,
// `mt().1`, `nest().p.b`): the rest of the temporary is dropped at the
// end of the statement, the part where its binding ends; each once.
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: got 1
// EXPECT: drop 3
// EXPECT: drop 5
// EXPECT: got 4
// EXPECT: drop 7
// EXPECT: drop 8
// EXPECT: got 6
// EXPECT: drop 6
// EXPECT: drop 4
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
struct P { a: D, b: D }
struct N { p: P, c: D, n: i64 }
fn mp(gpa: Gpa) -> P { P { a: mk(1, gpa), b: mk(2, gpa) } }
fn mt(gpa: Gpa) -> (D, D, D) { (mk(3, gpa), mk(4, gpa), mk(5, gpa)) }
fn nest(gpa: Gpa) -> N { N { p: P { a: mk(7, gpa), b: mk(6, gpa) }, c: mk(8, gpa), n: 0 } }

fn main(gpa: Gpa) {
    let a = mp(gpa).a;
    println(f"got {a.id}");
    let b = mt(gpa).1;
    println(f"got {b.id}");
    let c = nest(gpa).p.b;
    println(f"got {c.id}");
}
