// sem-own: a nested Option<Option<D>> matched by value: the inner payload dropped once.
// EXPECT: got 4
// EXPECT: drop 4
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let o: Option<Option<D>> = Some(Some(mk(4, gpa)));
    match o { Some(Some(d)) => println(f"got {d.id}"), _ => {} }
    println("end");
}
