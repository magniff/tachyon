// Branches on constants disappear (SCCP), also through phis and loops.
// EXPECT: 42 7
// CHECK-OPT: 1
// CHECK: fn decided:
// CHECK-NOT: branch
// CHECK: ret
// CHECK: fn main:
extern fn printf(format: *u8, ...) -> i32;

fn decided(flag: bool) -> i64 {
    let mode = 3;
    let mut x = 0;
    if mode == 3 {
        x = 40;
    } else {
        x = flag as i64;
    }
    let mut i = 0;
    while i < 0 {
        x += 1000;
        i += 1;
    }
    if x > 10 && mode != 4 { x + 2 } else { x - 2 }
}

fn main() -> i32 {
    printf(c"%ld %ld\n", decided(true), 7);
    0
}
