// EXPECT: unstable ok
// EXPECT: stable ok
// EXPECT: noalloc ok
// EXPECT: big ok
// EXPECT: select ok
// EXPECT: search ok
// EXPECT: algo ok
// EXPECT: heap ok
// 0.20: std::slice's sorts and algorithms against simple models, on
// seeded random input (before 0.18's property tests): every length up to
// 300 and some long ones, in seven shapes (random, few distinct values,
// sorted, reversed, sawtooth runs, all equal, sorted with noise). The
// unstable sort must give insertion sort's order of keys; the stable one
// its order of (key, position) too; selection, binary search, dedup,
// retain, rotations and the heap sifts are checked against loops.
use std::{sort_stable_by_in, sort_stable_in};
use std::slice::{
    binary_search, binary_search_by_key, dedup, dedup_by_key, fill, heap_sift_down_less,
    heap_sift_down_to_bottom_less, heap_sift_up_less, partition_point, retain_by, reverse,
    rotate_left, rotate_right, select_nth_unstable, select_nth_unstable_by, sort_stable_less,
    sort_stable_noalloc, sort_unstable, sort_unstable_by, sort_unstable_by_key,
};

struct Rng { s: u64 }

fn next(r: inout Rng) -> u64 {
    var x = r.s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    r.s = x;
    x
}

// n keys of a shape.
fn make(r: inout Rng, n: i64, shape: i64, out: inout Vec<i64>) {
    out.clear();
    for i in 0..n {
        let x = (next(&r) >> 1) as i64;
        let k = if shape == 0 {
            x % 1000000
        } else if shape == 1 {
            x % 5
        } else if shape == 2 {
            i
        } else if shape == 3 {
            n - i
        } else if shape == 4 {
            i % 37
        } else if shape == 5 {
            7
        } else if x % 10 == 0 {
            x % 1000
        } else {
            i * 2
        };
        out.push(k);
    }
}

// The model: insertion sort by (key, position), stable.
fn model_sort(v: inout Vec<(i64, i64)>) {
    let s = v.as_mut_slice();
    for i in 1..s.len {
        let x = s[i];
        var j = i;
        for _ in 0..i {
            if s[j - 1].0 <= x.0 {
                break;
            }
            s[j] = s[j - 1];
            j -= 1;
        }
        s[j] = x;
    }
}

fn pairs(keys: Vec<i64>, out: inout Vec<(i64, i64)>) {
    out.clear();
    let k = keys.as_slice();
    for i in 0..k.len {
        out.push((k[i], i));
    }
}

#[derive(Clone)]
struct Big { key: i64, pos: i64, pad: [i64; 62] }

fn main(gpa: Gpa) -> i32 {
    var r = Rng { s: 0x9E3779B97F4A7C15 };
    var keys: Vec<i64> = Vec::new_in(gpa);
    var a: Vec<(i64, i64)> = Vec::new_in(gpa);
    var m: Vec<(i64, i64)> = Vec::new_in(gpa);
    var lens: Vec<i64> = Vec::new_in(gpa);
    for n in 0..301 {
        lens.push(n);
    }
    lens.push(1000);
    lens.push(4097);
    lens.push(12000);
    var ok_u = true;
    var ok_s = true;
    var ok_n = true;
    for li in 0..lens.len() {
        let n = lens[li];
        for shape in 0..7 {
            if n > 4097 && shape != 0 && shape != 1 {
                continue;
            }
            make(&r, n, shape, &keys);
            pairs(keys, &m);
            model_sort(&m);
            // unstable: the keys in order
            pairs(keys, &a);
            if shape % 2 == 0 {
                sort_unstable_by(a.as_mut_slice(), |x: (i64, i64), y: (i64, i64)| {
                    if x.0 < y.0 { -1 } else if x.0 > y.0 { 1 } else { 0 }
                });
            } else {
                sort_unstable_by_key(a.as_mut_slice(), |x: (i64, i64)| x.0);
            }
            for i in 0..n {
                if a[i].0 != m[i].0 {
                    ok_u = false;
                }
            }
            // the plain one on the keys alone
            var k2: Vec<i64> = Vec::new_in(gpa);
            for i in 0..n {
                k2.push(keys[i]);
            }
            sort_unstable(k2.as_mut_slice());
            for i in 0..n {
                if k2[i] != m[i].0 {
                    ok_u = false;
                }
            }
            k2.free();
            // stable, with an allocator: keys and positions in order
            pairs(keys, &a);
            sort_stable_by_in(a.as_mut_slice(), |x: (i64, i64), y: (i64, i64)| x.0 - y.0, gpa);
            for i in 0..n {
                if a[i] != m[i] {
                    ok_s = false;
                }
            }
            // stable, without (a 4 KB scratch: in-place merges past it)
            pairs(keys, &a);
            sort_stable_less(a.as_mut_slice(), |x: (i64, i64), y: (i64, i64)| x.0 < y.0);
            for i in 0..n {
                if a[i] != m[i] {
                    ok_n = false;
                }
            }
        }
    }
    var k3: Vec<i64> = Vec::new_in(gpa);
    make(&r, 5000, 0, &k3);
    sort_stable_noalloc(k3.as_mut_slice());
    sort_stable_in(k3.as_mut_slice(), gpa);
    for i in 1..k3.len() {
        if k3[i - 1] > k3[i] {
            ok_n = false;
        }
    }
    println(if ok_u { "unstable ok" } else { "unstable WRONG" });
    println(if ok_s { "stable ok" } else { "stable WRONG" });
    println(if ok_n { "noalloc ok" } else { "noalloc WRONG" });

    // Elements of 512 bytes: 8 fit in the 4 KB scratch, no small sort.
    var ok_b = true;
    for n in [0, 1, 2, 7, 9, 33, 100, 333] {
        var b: Vec<Big> = Vec::new_in(gpa);
        for i in 0..n {
            b.push(Big { key: (next(&r) % 7) as i64, pos: i, pad: [i; 62] });
        }
        sort_stable_less(b.as_mut_slice(), |x: Big, y: Big| x.key < y.key);
        for i in 0..n {
            if i > 0
                && (b[i - 1].key > b[i].key || b[i - 1].key == b[i].key && b[i - 1].pos > b[i].pos) {
                ok_b = false;
            }
            if b[i].pad[61] != b[i].pos {
                ok_b = false;
            }
        }
        sort_unstable_by(b.as_mut_slice(), |x: Big, y: Big| y.pos - x.pos);
        for i in 0..n {
            if b[i].pos != n - 1 - i || b[i].pad[0] != b[i].pos {
                ok_b = false;
            }
        }
        b.free();
    }
    println(if ok_b { "big ok" } else { "big WRONG" });

    // select_nth_unstable: the k-th, none greater before, none less after.
    var ok_sel = true;
    for n in [1, 2, 3, 16, 17, 100, 1000, 10007] {
        for shape in 0..7 {
            make(&r, n, shape, &keys);
            pairs(keys, &m);
            model_sort(&m);
            for t in 0..4 {
                let k = if t == 0 { 0 } else if t == 1 { n - 1 }
                    else { (next(&r) % n as u64) as i64 };
                var s: Vec<i64> = Vec::new_in(gpa);
                for i in 0..n {
                    s.push(keys[i]);
                }
                if t == 3 {
                    select_nth_unstable_by(s.as_mut_slice(), k, |x: i64, y: i64| y - x);
                    if s[k] != m[n - 1 - k].0 {
                        ok_sel = false;
                    }
                } else {
                    select_nth_unstable(s.as_mut_slice(), k);
                    if s[k] != m[k].0 {
                        ok_sel = false;
                    }
                    for i in 0..n {
                        if i < k && s[i] > s[k] || i > k && s[i] < s[k] {
                            ok_sel = false;
                        }
                    }
                }
                s.free();
            }
        }
    }
    println(if ok_sel { "select ok" } else { "select WRONG" });

    // binary_search and partition_point against a scan.
    var ok_bs = true;
    for n in [0, 1, 2, 3, 10, 100, 1001] {
        make(&r, n, 1, &keys);
        sort_unstable(keys.as_mut_slice());
        let s = keys.as_slice();
        for q in -1..7 {
            var lt = 0;
            var eq = 0;
            for i in 0..n {
                if s[i] < q {
                    lt += 1;
                } else if s[i] == q {
                    eq += 1;
                }
            }
            match binary_search(s, &q) {
                Ok(i) => {
                    if eq == 0 || s[i] != q {
                        ok_bs = false;
                    }
                }
                Err(i) => {
                    if eq != 0 || i != lt {
                        ok_bs = false;
                    }
                }
            }
            if partition_point(s, |x: i64| x < q) != lt {
                ok_bs = false;
            }
            match binary_search_by_key(s, &(q * 2), |x: i64| x * 2) {
                Ok(i) => {
                    if s[i] != q {
                        ok_bs = false;
                    }
                }
                Err(i) => {
                    if i != lt {
                        ok_bs = false;
                    }
                }
            }
        }
    }
    println(if ok_bs { "search ok" } else { "search WRONG" });

    // dedup, retain, rotations, reverse, fill.
    var ok_a = true;
    var v: Vec<i64> = Vec::new_in(gpa);
    for x in [1, 1, 2, 3, 3, 3, 1, 4, 4] {
        v.push(x);
    }
    let d = dedup(v.as_mut_slice());
    if d != 5 || v[0] != 1 || v[1] != 2 || v[2] != 3 || v[3] != 1 || v[4] != 4 {
        ok_a = false;
    }
    v.clear();
    for x in [10, 11, 20, 21, 22, 30] {
        v.push(x);
    }
    if dedup_by_key(v.as_mut_slice(), |x: i64| x / 10) != 3 || v[2] != 30 {
        ok_a = false;
    }
    v.clear();
    for i in 0..10 {
        v.push(i);
    }
    let kept = retain_by(v.as_mut_slice(), |x: i64| x % 3 != 0);
    if kept != 6 || v[0] != 1 || v[1] != 2 || v[2] != 4 || v[5] != 8 {
        ok_a = false;
    }
    v.clear();
    for i in 0..7 {
        v.push(i);
    }
    rotate_left(v.as_mut_slice(), 3);
    if v[0] != 3 || v[3] != 6 || v[4] != 0 {
        ok_a = false;
    }
    rotate_right(v.as_mut_slice(), 3);
    reverse(v.as_mut_slice());
    if v[0] != 6 || v[6] != 0 {
        ok_a = false;
    }
    rotate_left(v.as_mut_slice(), 0);
    rotate_left(v.as_mut_slice(), 7);
    fill(v.as_mut_slice(), 9);
    if v[0] != 9 || v[6] != 9 {
        ok_a = false;
    }
    println(if ok_a { "algo ok" } else { "algo WRONG" });

    // A max-heap built by sift_up and drained by sift_down_to_bottom
    // gives the keys largest first; sift_down after a decrease keeps it.
    var ok_h = true;
    for n in [1, 2, 5, 64, 1000] {
        make(&r, n, 0, &keys);
        var h: Vec<i64> = Vec::new_in(gpa);
        for i in 0..n {
            h.push(keys[i]);
            let last = h.len() - 1;
            heap_sift_up_less(h.as_mut_slice(), 0, last, |x: i64, y: i64| x < y);
        }
        if n > 1 {
            h[0] = -1;
            heap_sift_down_less(h.as_mut_slice(), 0, n, |x: i64, y: i64| x < y);
            h[0] = h[0];
        }
        var prev = 1 << 62;
        var end = n;
        for _ in 0..n {
            let s = h.as_mut_slice();
            let top = s[0];
            if top > prev {
                ok_h = false;
            }
            prev = top;
            end -= 1;
            s[0] = s[end];
            if end > 0 {
                heap_sift_down_to_bottom_less(s, 0, end, |x: i64, y: i64| x < y);
            }
        }
        h.free();
    }
    println(if ok_h { "heap ok" } else { "heap WRONG" });
    0
}
