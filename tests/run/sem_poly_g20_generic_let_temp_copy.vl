// a let binding of a let T: no copy for owned T, the value seen through it independent of later changes? (it borrows)
// FLAGS: --check-alloc
// EXPECT: 1 2 3
fn f<T: Clone>(x: T) -> T { let y = x; y.clone() }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var w = f(v);
    w.push(2);
    println(f"{v.len()} {w.len()} {f(3)}");
}
