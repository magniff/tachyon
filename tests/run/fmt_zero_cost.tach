// f-strings are zero cost (0.15): `println(f"{a} {b:?}")` makes only
// direct calls: println's instance, the f-string's closure, its Display
// and Fmt's small methods are inlined (the bytes go to std's 4 KB static
// buffer, written out by one `write`), the quoted text is formatted by a
// call (0.16: the number inline); no heap allocation, no indirect call.
// EXPECT: 42 "hi\n"
// EXPECT: -7 "tab\t"
// CHECK: fn show:
// CHECK-NOT: malloc
// CHECK-NOT: realloc
// CHECK-NOT: calli
// CHECK: call std.fmt.fmt_quoted
// CHECK-NOT: malloc
// CHECK-NOT: calli
// CHECK: call std.fmt.fmt_flush
// CHECK-NOT: malloc
// CHECK-NOT: calli
// CHECK: fn main:
fn show(a: i64, b: [u8]) {
    println(f"{a} {b:?}");
}

fn main() {
    show(42, "hi\n");
    show(-7, "tab\t");
}
