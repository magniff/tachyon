// sem-own: pop and remove hand the element out: dropped by the taker; truncate and clear drop the rest; set drops the old one.
// EXPECT: drop 4
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: drop 3
// EXPECT: drop 9
// EXPECT: drop 5
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var v: Vec<D> = Vec::new_in(gpa);
    for i in 1..5 { v.push(mk(i, gpa)); }
    { let p = v.pop(); }
    { let r = v.remove(1); }
    v.set(0, mk(9, gpa));
    v.truncate(1);
    v.push(mk(5, gpa));
    v.clear();
    println("end");
}
