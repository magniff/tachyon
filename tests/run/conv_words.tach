// 0.20 Phase 0: `var`, `inout` and `sink` stay identifiers where they are
// not 0.20's words (they become keywords in 0.21, conventions.md D27):
// a local named var, a call var(..), a function named sink.
// EXPECT: 3 4 5
fn var(a: i64, b: i64) -> i64 { a + b }
fn sink(x: i64) -> i64 { x + 1 }

fn main() {
    let inout = 1;
    let var2 = var(inout, 2);
    var(1, 1);
    let s = sink(var2);
    var x = s;
    x += 1;
    println(f"{var2} {s} {x}");
}
