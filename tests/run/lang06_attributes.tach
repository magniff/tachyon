// 0.6: #[inline], #[inline(never)] and #[cold] on functions (also in impl
// blocks and on generic functions), and attributes before `pub`.
// EXPECT: 42 7 9 3
extern "C" { fn printf(format: *u8, ...) -> i32; }

#[repr(C)]
pub struct Pair { a: i64, b: i64 }

#[inline]
fn add(a: i64, b: i64) -> i64 { a + b }

#[inline(never)]
pub fn twice(x: i64) -> i64 { x * 2 }

#[cold]
#[inline(never)]
fn fail(code: i64) -> i64 { code }

#[inline]
fn pick<T>(c: bool, a: sink T, b: sink T) -> T { if c { a } else { b } }

impl Pair {
    #[inline]
    pub fn sum(self) -> i64 { self.a + self.b }
    #[cold]
    fn never_called(self) -> i64 { 0 }
}

fn main() -> i32 {
    let p = Pair { a: 3, b: 4 };
    let x = twice(add(20, 1));
    unsafe {
        printf(c"%ld %ld %ld %ld\n", x, p.sum(), pick(false, 1, 9),
            if x < 0 { fail(1) } else { 3 });
    }
    0
}
