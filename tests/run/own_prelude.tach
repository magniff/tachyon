// 0.17: the prelude's Drop, drop, forget, needs_drop and Copy, and
// std::take and std::replace; drop(n) runs n's drop, forget(n) does not;
// needs_drop folds; #[views] and #[stores] declare summaries.
// FLAGS: --values=error
// EXPECT: drop 1
// EXPECT: true 3
// EXPECT: 5 7 4 0 h a
struct Noisy { id: i64 }

impl Drop for Noisy {
    fn drop(self: &mut Noisy) { println(f"drop {self.id}"); }
}

struct Z { n: i64 }
impl std::Default for Z { fn default() -> Z { Z { n: 0 } } }
fn same<T: Copy>(x: T) -> T { x }
struct Scan { text: [u8], pos: i64 }

impl Scan {
    #[views(*self)]
    fn word(self: &mut Scan) -> [u8] { let a = self.pos; self.pos += 1; self.text[a..a + 1] }
}

#[views(s)]
#[stores()]
fn first(s: [u8]) -> [u8] { s[0..1] }

fn main() {
    let n = Noisy { id: 1 };
    drop(n);
    forget(Noisy { id: 2 });
    println(f"{needs_drop::<Noisy>()} {same(3)}");
    let mut x = 5;
    let old = std::replace(&mut x, 7);
    let mut z = Z { n: 4 };
    let t = std::take(&mut z);
    let abc = "abc";
    let mut sc = Scan { text: "hello", pos: 0 };
    println(f"{old} {x} {t.n} {z.n} {sc.word()} {first(abc)}");
}
