// 0.16 T1: each declaration form checked against the inferred effects,
// with the first step of the chain: #[no_alloc], #[no_panic], #[pure],
// #[no_io], #[effects(...)] (unsafe, diverge, recursion), a trait
// method's declaration binding an impl (a user's, std's Allocator), an
// `effects(...)` bound on a closure, a template's declaration per
// instance.
// ERROR: 'K::key' implements 'Key::key', which is #[pure], but it uses a static (global): 'SEEN' at
// ERROR: but it allocates from Gpa: 'v.push(x)' at
// ERROR: 'avg' is #[no_panic], but it may panic: 's[i]' at
// ERROR: 'counted' is #[pure], but it uses a static (global): 'note(x)' at
// ERROR: 'chatty' is #[no_io], but it does io: 'putchar(33)' at
// ERROR: 'raw' is #[effects(io)], but it has unsafe operations (unsafe)
// ERROR: is a 'while' loop
// ERROR: calls 'rec', which calls back (recursion)
// ERROR: 'grow_in' is #[effects(alloc(Gpa), panic, diverge)], but it allocates from Bump
// ERROR: 'Bump::free' implements 'Allocator::free', which is #[effects(alloc, global, panic, diverge, unsafe)], but it does io
// ERROR: the closure for 'F' of 'apply' does io ('shout(x)' at
// ERROR-COUNT: 11
extern "C" {
    fn putchar(c: i32) -> i32;
}

static var SEEN: i64 = 0;

trait Key {
    #[pure]
    fn key(self) -> u64;
}

struct K { v: i64 }

impl Key for K {
    fn key(self) -> u64 {
        SEEN += 1;
        self.v as u64
    }
}

#[no_alloc]
fn total(v: inout Vec<i64>, x: i64) -> i64 {
    v.push(x);
    v.len()
}

#[no_panic]
fn avg(s: [i64], i: i64) -> i64 {
    s[i]
}

#[pure]
fn counted(x: i64) -> i64 {
    note(x)
}

fn note(x: i64) -> i64 {
    SEEN += x;
    x
}

#[no_io]
fn chatty() {
    unsafe { putchar(33); }
}

#[effects(io)]
fn raw(p: *i64) -> i64 {
    unsafe { *(p as *i64) }
}

#[effects()]
fn wait(n: i64) -> i64 {
    var k = n;
    while k > 0 {
        k -= 1;
    }
    k
}

#[effects(panic)]
fn rec(n: i64) -> i64 {
    if n == 0 { 0 } else { rec(n - 1) }
}

#[effects(alloc(Gpa), panic, diverge)]
fn grow_in<A: Allocator>(v: inout Vec<i64, A>) {
    v.push(1);
}

fn apply<F: Fn(i64) -> i64 + effects(panic)>(f: F, x: i64) -> i64 {
    f(x)
}

fn shout(x: i64) -> i64 {
    unsafe { putchar(33); }
    x
}

struct Bump { used: i64 }

impl Allocator for Bump {
    fn try_alloc(self: *Bump, size: i64, align: i64) -> *u8 {
        0 as *u8
    }

    unsafe fn try_resize(self: *Bump, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        0 as *u8
    }

    unsafe fn free(self: *Bump, p: *u8, size: i64, align: i64) {
        putchar(33);
    }
}

fn main(gpa: Gpa) -> i32 {
    let k = K { v: 1 };
    var v: Vec<i64> = Vec::new_in(gpa);
    var w: Vec<i64, Bump> = Vec::new_in(Bump { used: 0 });
    grow_in(&v);
    grow_in(&w);
    let n = apply(|x| shout(x), 2);
    (total(&v, 1) + avg([1, 2][..], 0) + k.key() as i64 + n + counted(1) + raw(&n) + wait(2)
        + rec(2)) as i32
}
