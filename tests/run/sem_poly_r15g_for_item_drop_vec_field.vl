// an iterator of a Drop type holding a Vec: --check-alloc on the loop's items
// FLAGS: --check-alloc
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: got 0
// EXPECT: drop 0
// EXPECT: end
struct R { v: Vec<i64> }
impl Drop for R { fn drop(inout self) { println(f"drop {self.v[0]}"); } }
struct Gen { n: i64, gpa: Gpa }

impl Iterator for Gen {
    type Item = R;

    fn next(inout self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        var v: Vec<i64> = Vec::new_in(self.gpa);
        v.push(self.n);
        Some(R { v: v })
    }
}

fn main(gpa: Gpa) {
    for r in (Gen { n: 2, gpa: gpa }) { println(f"got {r.v[0]}"); }
    println("end");
}
