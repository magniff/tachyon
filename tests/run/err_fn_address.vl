// (0.17, issue #1) `&f` of a function and `*f` of a fn value: a function's
// name is already a pointer to it, called as it is; the fix writes the
// name alone (fix --suggested).
// ERROR: cannot take the address of 'factorial': a function's name is already a pointer to it
// ERROR: try: factorial
// ERROR: cannot dereference 'g': a function value is called as it is
// ERROR: try: g
// ERROR-COUNT: 2
fn factorial(n: i64) -> i64 { if n < 2 { 1 } else { n * factorial(n - 1) } }

fn main() {
    let f = &factorial;
    let g = factorial;
    println(f"{f(5)} {(*g)(4)}");
}
