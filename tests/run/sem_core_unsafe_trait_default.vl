// A trait's default method dereferencing a raw pointer.
// ERROR: dereference of a raw pointer is unsafe
trait R { fn p(self) -> *i64; fn read(self) -> i64 { *self.p() } }
struct S { q: *i64 }
impl R for S { fn p(self) -> *i64 { self.q } }
fn main() -> i32 { var x = 1; let s = S { q: &x as *i64 }; println(s.read()); 0 }
