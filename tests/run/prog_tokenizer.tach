// A small state machine that tokenizes an arithmetic expression from stdin
// and evaluates it with a two-stack (shunting-yard) algorithm.
// STDIN: 12 + 3 * (40 - 2) / 6 - 7 * (1 + 1)
// EXPECT: 19 tokens = 17
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn read(fd: i32, buf: *u8, n: u64) -> i64;
}

struct Stacks { nums: [i64; 64], nn: i64, ops: [u8; 64], no: i64 }

fn prec(op: u8) -> i64 {
    if op == '+' || op == '-' { 1 } else if op == '*' || op == '/' { 2 } else { 0 }
}

fn apply(s: *Stacks) {
    let b = (*s).nums[(*s).nn - 1];
    let a = (*s).nums[(*s).nn - 2];
    let op = (*s).ops[(*s).no - 1];
    (*s).no -= 1;
    (*s).nn -= 1;
    let r = if op == '+' { a + b } else if op == '-' { a - b } else if op == '*' { a * b }
        else { a / b };
    (*s).nums[(*s).nn - 1] = r;
}

fn main() -> i64 {
    let buf: [u8; 256] = [0; 256];
    let n = unsafe { read(0, &buf as *u8, 255) };
    let mut s = Stacks { nums: [0; 64], nn: 0, ops: [0; 64], no: 0 };
    let ps = &s;
    let mut tokens = 0;
    let mut i: i64 = 0;
    let mut in_num = false;
    let mut cur: i64 = 0;
    loop {
        let c: u8 = if i < n { buf[i] } else { ' ' };
        let digit = c >= '0' && c <= '9';
        if digit {
            cur = cur * 10 + (c - '0') as i64;
            in_num = true;
        } else {
            if in_num {
                s.nums[s.nn] = cur;
                s.nn += 1;
                tokens += 1;
                cur = 0;
                in_num = false;
            }
            if c == '(' {
                s.ops[s.no] = c;
                s.no += 1;
                tokens += 1;
            } else if c == ')' {
                while s.ops[s.no - 1] != '(' {
                    unsafe { apply(ps); }
                }
                s.no -= 1;
                tokens += 1;
            } else if prec(c) > 0 {
                while s.no != 0 {
                    if prec(s.ops[s.no - 1]) < prec(c) { break; }
                    unsafe { apply(ps); }
                }
                s.ops[s.no] = c;
                s.no += 1;
                tokens += 1;
            }
        }
        i += 1;
        if i > n { break; }
    }
    while s.no != 0 {
        unsafe { apply(ps); }
    }
    unsafe { printf(c"%ld tokens = %ld\n", tokens, s.nums[0]); }
    0
}
