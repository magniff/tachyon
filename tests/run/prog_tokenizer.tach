// A small state machine that tokenizes an arithmetic expression from stdin
// and evaluates it with a two-stack (shunting-yard) algorithm.
// STDIN: 12 + 3 * (40 - 2) / 6 - 7 * (1 + 1)
// EXPECT: 19 tokens = 17
extern fn printf(format: *u8, ...) -> i32;
extern fn read(fd: i32, buf: *u8, n: u64) -> i64;

struct Stacks { nums: [i64; 64], nn: i64, ops: [u8; 64], no: i64 }

fn prec(op: u8) -> i64 {
    if op == 43 || op == 45 { 1 } else { if op == 42 || op == 47 { 2 } else { 0 } }
}

fn apply(s: *Stacks) {
    let b = (*s).nums[(*s).nn - 1];
    let a = (*s).nums[(*s).nn - 2];
    let op = (*s).ops[(*s).no - 1];
    (*s).no -= 1;
    (*s).nn -= 1;
    let r = if op == 43 { a + b } else { if op == 45 { a - b } else { if op == 42 { a * b } else { a / b } } };
    (*s).nums[(*s).nn - 1] = r;
}

fn main() -> i64 {
    let buf: [u8; 256] = [0; 256];
    let n = read(0, &buf as *u8, 255);
    let s = Stacks { nums: [0; 64], nn: 0, ops: [0; 64], no: 0 };
    let ps = &s;
    let tokens = 0;
    let i: i64 = 0;
    let in_num = false;
    let cur: i64 = 0;
    loop {
        let c: u8 = if i < n { buf[i] } else { 32 };
        let digit = c >= 48 && c <= 57;
        if digit {
            cur = cur * 10 + (c - 48) as i64;
            in_num = true;
        } else {
            if in_num {
                s.nums[s.nn] = cur;
                s.nn += 1;
                tokens += 1;
                cur = 0;
                in_num = false;
            };
            if c == 40 {
                s.ops[s.no] = c;
                s.no += 1;
                tokens += 1;
            } else {
                if c == 41 {
                    loop {
                        if s.ops[s.no - 1] == 40 { break; };
                        apply(ps);
                    }
                    s.no -= 1;
                    tokens += 1;
                } else {
                    if prec(c) > 0 {
                        loop {
                            if s.no == 0 { break; };
                            if prec(s.ops[s.no - 1]) < prec(c) { break; };
                            apply(ps);
                        }
                        s.ops[s.no] = c;
                        s.no += 1;
                        tokens += 1;
                    };
                };
            };
        };
        i += 1;
        if i > n { break; };
    }
    loop {
        if s.no == 0 { break; };
        apply(ps);
    }
    printf("%ld tokens = %ld\n".0, tokens, s.nums[0]);
    0
}
