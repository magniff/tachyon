// (0.18) Clauses of generic functions and methods are checked per
// instance; the report names the instance.
// EXIT: 101
// EXPECT: 7
// EXPECT: 2
// STDERR: contract_generic.vl:37:20: requires failed: 'i < self.len' of 'Ring<i64>::at' (

struct Ring<T> { items: [T; 4], len: i64 }

impl<T> Ring<T> {
    fn at(self, i: i64) -> T
        requires 0 <= i && i < self.len
    {
        self.items[i]
    }

    fn put(inout self, x: sink T)
        requires self.len < 4 else "the ring is full"
        ensures self.len == old(self.len) + 1
    {
        unsafe {
            self.items[self.len] = x;
            self.len += 1;
        }
    }
}

fn first<T: Clone>(s: [T]) -> T requires s.len() > 0 { s[0].clone() }

fn main() -> i32 {
    var r: Ring<i64> = Ring { items: [0; 4], len: 0 };
    r.put(7);
    std::print_int(r.at(0));
    println("");
    std::print_int(first([2, 3][..]));
    println("");
    std::print_int(r.at(1));
    0
}
