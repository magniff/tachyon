// (0.25 semantics audit, views) A Vec collected from views holds them:
// `w.split(' ').collect_in(gpa)` and `v.iter().collect_in(gpa)` view s,
// so growing s while an element is used is own.conflict.
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let c: Vec<str> = s.split(' ').collect_in(gpa);
    let r = c.get(0);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
