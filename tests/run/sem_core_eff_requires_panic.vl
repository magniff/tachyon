// A call of a function with a requires may fail it: panic in the caller.
// ERROR: 'calm' is #[no_panic], but it may panic
fn half(x: i64) -> i64
    requires x > 0
{
    x / 2
}

#[no_panic]
fn calm(x: i64) -> i64 { half(x) }

fn main() -> i32 {
    println(calm(4));
    println(calm(0));
    0
}
