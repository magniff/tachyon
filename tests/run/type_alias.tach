// Type aliases name existing types, in any order.
// EXPECT: 9 6 -8 -8 255
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

type Coord = (i64, i64);
type Grid = [[u8; SIZE]; SIZE];
type Callback = fn(i64) -> i64;
type CoordPtr = *Coord;
type Byte = u8;
const SIZE: u64 = 3;

fn double(x: i64) -> i64 { x * 2 }

fn apply(f: Callback, c: Coord) -> Coord {
    (f(c.0), f(c.1))
}

fn main() -> i64 {
    var g: Grid = [[0; SIZE]; SIZE];
    g[1][2] = 9;
    let c: Coord = apply(double, (3, -4));
    let p: CoordPtr = &c;
    let b: Byte = 255;
    unsafe { printf(c"%d %ld %ld %ld %d\n", g[1][2] as i32, c.0, c.1, (*p).1, b as i32); }
    0
}
