// (0.25, the semantics fuzzer) The -O2 bug of sem_fuzz_o2_empty_clone_len
// as a crash: the clone of an empty Vec field, iterated at -O2 without
// --check-alloc, faults (exit -11, SIGSEGV); -O0, -O1 and --check-alloc
// builds print the expected lines. Found by tools/semfuzz/semfuzz.py
// (seed 10354 of the first generator), shrunk.
// XFAIL: SOUNDNESS -O2 faults iterating the clone of an empty Vec field
// FLAGS: -O2
// EXPECT: o5 0 0 8
// EXPECT: o7 2 0 9
// EXPECT: o7 2 0 9
// EXPECT: o7 2 0 9
// EXPECT: d2
// EXPECT: d1
// EXPECT: live 0

static var NEXT: i64 = 0;
static var LIVE: i64 = 0;

struct T { id: i64, v: i64 }

fn mk(v: i64) -> T {
    NEXT += 1;
    LIVE += 1;
    T { id: NEXT, v: v }
}

impl Drop for T {
    fn drop(inout self) {
        LIVE -= 1;
        println(f"d{self.id}");
    }
}

impl Clone for T {
    fn clone(self) -> T { mk(self.v) }
}

impl T {
    fn get(self) -> i64 { self.v }
    fn add(inout self, k: i64) { self.v += k; }
    fn into_v(sink self) -> i64 { self.v }
}

#[derive(Clone)]
struct S { t: T, w: Vec<T>, n: i64 }

#[derive(Clone)]
enum E { One(T), Two(T, T), Nada }

struct Pt { x: i64, y: i64 }

trait Score { fn score(self) -> i64; }
impl Score for T { fn score(self) -> i64 { self.v * 2 + 1 } }
impl Score for S { fn score(self) -> i64 { self.t.v + self.w.len() + self.n } }

fn total<X: Score>(x: X) -> i64 { x.score() }
fn gid<X>(x: sink X) -> X { x }
fn obs(t: T) -> i64 { t.v }
fn bump(t: inout T, k: i64) { t.v += k; }
fn eat(t: sink T) -> i64 { t.v }
fn ident(t: sink T) -> T { t }
fn pick(a: sink T, b: sink T, c: bool) -> T {
    if c { return a; }
    b
}
fn vsig(w: Vec<T>) -> i64 {
    var h = 7;
    for x in w { h = h * 31 + x.id * 100 + x.v; }
    h
}
fn vbump(w: inout Vec<T>, k: i64) {
    for i in 0..w.len() { w[i].v += k; }
}
fn veat(w: sink Vec<T>) -> i64 { w.len() }
fn keep(w: inout Vec<T>, t: sink T) { w.push(t); }
fn ssig(s: S) -> i64 { s.t.id * 1000 + s.t.v * 7 + vsig(s.w) + s.n }
fn esig(e: E) -> i64 {
    match e {
        E::One(a) => a.id * 10 + a.v,
        E::Two(a, b) => a.id * 100 + b.id * 10 + a.v - b.v,
        E::Nada => -3,
    }
}
fn osig(o: Option<T>) -> i64 {
    match o {
        Some(t) => t.id * 10 + t.v,
        None => -1,
    }
}
fn chk(t: T, lim: i64) -> Result<i64, i64> {
    if t.v > lim { return Err(t.v); }
    Ok(t.v + 1)
}
fn tchk(t: sink T, lim: i64) -> Result<T, i64> {
    if t.v > lim { return Err(t.v); }
    Ok(t)
}
fn pget(p: Pt) -> i64 { p.x * 10 + p.y }
fn pbump(p: inout Pt, k: i64) { p.x += k; }
fn psink(p: sink Pt) -> i64 {
    p.x += 1;
    p.x * 10 + p.y
}
fn seat(s: sink String) -> i64 { s.len() }
fn apply<F: Fn(i64) -> i64>(f: F, a: i64) -> i64 { f(a) }
fn twice<F: FnMut(i64)>(f: sink F) { f(1); f(2); }
fn callf<F: Fn() -> i64>(f: sink F) -> i64 { f() }

fn run(gpa: Gpa) {
    var s11 = S { t: mk(7), w: Vec::new_in(gpa), n: 7 };
    var w12: Vec<T> = s11.w.clone();
    let t13 = ident(mk(9));
    for i14 in 0..1 {
        let n15 = apply(|a: i64| obs(t13) + a, -1);
        println(f"o5 {w12.iter().map(|t| t.v).sum()} {w12.iter().filter(|t| t.v > 0).count()} {n15}");
    }
    for i17 in 0..3 {
        println(f"o7 {t13.id} {w12.iter().filter(|t| t.v > 11).count()} {t13.v}");
    }
}

fn main(gpa: Gpa) -> i32 {
    run(gpa);
    println(f"live {LIVE}");
    0
}

