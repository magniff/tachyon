// Integer + - * and unary - wrap at every width, constant and at run time.
// EXPECT: -128 -32768 -2147483648 -9223372036854775808
// EXPECT: -128 -32768 -2147483648 -9223372036854775808
// EXPECT: 127 32767 2147483647 9223372036854775807
// EXPECT: -128 -32768 -2147483648 -9223372036854775808
// EXPECT: -2 -2 -2 -2 -128 -9223372036854775808
// EXPECT: 16 24464 605032704
// EXPECT: 0 0 0 0
// EXPECT: 255 65535 4294967295 18446744073709551615
// EXPECT: 1 1 1 1
// EXPECT: 0 0
// EXPECT: -127 4294967293 32765
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let z8 = Z as i8; let z16 = Z as i16; let z32 = Z as i32;
    let u8z = Z as u8; let u16z = Z as u16; let u32z = Z as u32; let u64z = Z as u64;
    // constants
    let a8: i8 = 127; let a16: i16 = 32767; let a32: i32 = 2147483647;
    let a64: i64 = 9223372036854775807;
    println(f"{a8 + 1} {a16 + 1} {a32 + 1} {a64 + 1}");
    // run time
    let r8: i8 = 127 + z8; let r16: i16 = 32767 + z16; let r32: i32 = 2147483647 + z32;
    let r64: i64 = 9223372036854775807 + Z;
    println(f"{r8 + 1} {r16 + 1} {r32 + 1} {r64 + 1}");
    // MIN - 1, -MIN
    let m8: i8 = -128 + z8; let m16: i16 = -32768 + z16; let m32: i32 = -2147483648 + z32;
    let m64: i64 = -9223372036854775807 - 1 + Z;
    println(f"{m8 - 1} {m16 - 1} {m32 - 1} {m64 - 1}");
    println(f"{-m8} {-m16} {-m32} {-m64}");
    // multiplication
    println(f"{r8 * 2} {r16 * 2} {r32 * 2} {r64 * 2} {m8 * -1} {m64 * -1}");
    println(
        f"{(100 + z8) * (100 + z8)} {(300 + z16) * (300 + z16)} {(70000 + z32) * (70000 + z32)}");
    // unsigned
    let b8: u8 = 255 + u8z; let b16: u16 = 65535 + u16z; let b32: u32 = 4294967295 + u32z;
    let b64: u64 = 18446744073709551615 + u64z;
    println(f"{b8 + 1} {b16 + 1} {b32 + 1} {b64 + 1}");
    println(f"{u8z - 1} {u16z - 1} {u32z - 1} {u64z - 1}");
    println(f"{b8 * b8} {b16 * b16} {b32 * b32} {b64 * b64}");
    println(f"{(16 + u8z) * (16 + u8z)} {(65536 + u32z) * (65536 + u32z)}");
    // compound assignment
    var c8: i8 = r8; c8 += 2; var c32: u32 = b32; c32 *= 3; var c16: i16 = m16; c16 -= 3;
    println(f"{c8} {c32} {c16}");
    0
}
