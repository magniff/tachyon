// Nested if/else used as a value (there is no `else if`).
// EXPECT: -1 0 1 2
extern fn printf(format: *u8, ...) -> i32;

fn classify(n: i64) -> i64 {
    if n < 0 {
        0 - 1
    } else {
        if n == 0 {
            0
        } else {
            if n < 10 { 1 } else { 2 }
        }
    }
}

fn main() -> i64 {
    printf("%ld %ld %ld %ld\n".0, classify(0 - 5), classify(0), classify(7), classify(100));
    0
}
