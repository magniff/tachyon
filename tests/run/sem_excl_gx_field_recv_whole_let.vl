// receiver a field inout, the whole struct let (owned)
// ERROR: own.conflict
struct I { n: i64 }
impl I { fn look(inout self, o: O) -> i64 { let b = o.i.n; self.n = 7; b * 100 + o.i.n } }
struct O { i: I, v: Vec<i64> }
fn main(gpa: Gpa) { var o = O { i: I { n: 1 }, v: Vec::new_in(gpa) }; println(f"{o.i.look(o)}"); }
