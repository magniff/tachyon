// Two calls of a function that reads its let argument, with a change in
// between, are two values: no call is value-numbered across the change.
// EXPECT: 11 21 22 6 14
static var Z: i64 = 0;

#[inline(never)]
fn first(v: Vec<i64>) -> i64 { v[0] + v.len() }

#[inline(never)]
fn sum(s: [i64]) -> i64 { var t = 0; for x in s { t += x; } t }

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(10 + Z);
    let a = first(v);
    v[0] = 20;
    let b = first(v);
    v.push(1);
    let c = first(v);
    var arr = [1, 2, 3];
    let s1 = sum(arr[..]);
    arr[1] = 10;
    let s2 = sum(arr[..]);
    println(f"{a} {b} {c} {s1} {s2}");
    0
}
