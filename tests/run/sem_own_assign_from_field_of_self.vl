// sem-own: `a = a.inner` (the new value comes out of the old): moved out first, then the old rest dropped.
// EXPECT: drop 1
// EXPECT: now 2
// EXPECT: drop 2
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct N { id: i64, inner: Option<D>, v: Vec<i64> }

fn main(gpa: Gpa) {
    var a = D { id: 1, v: Vec::new_in(gpa) };
    var n = N { id: 1, inner: Some(mk(2, gpa)), v: Vec::new_in(gpa) };
    var o: Option<D> = Some(mk(1, gpa));
    o = n.inner;
    if let Some(d) = o { println(f"now {d.id}"); }
}
