// Expected types flow through if/else and block tails.
// EXPECT: 250 255 -1
extern fn printf(format: *u8, ...) -> i32;

fn pick(c: bool) -> u8 {
    if c { 200 + 50 } else { { let t: u8 = 1; t + 254 } }
}

fn main() -> i64 {
    let v: i16 = if pick(true) > 100 { -1 } else { 1 };
    printf("%d %d %d\n".0, pick(true), pick(false), v);
    0
}
