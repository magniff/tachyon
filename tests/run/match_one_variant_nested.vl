// EXPECT: 3 3 30
// 0.16: a match lowered as a switch on Result's tag whose Err arm names
// the one variant of an enum (`Err(AllocError::OutOfMemory)`, irrefutable)
// branched to block 0 at -O1 ("cannot assemble: branch to another
// section"): the one variant of an enum is no test.
use std::AllocError;

enum E { A }

enum Pair { Both(i64, i64) }

fn f(r: Result<(), E>) -> i64 {
    match r {
        Ok(()) => 1,
        Err(E::A) => 2,
    }
}

fn g(r: Result<(), AllocError>) -> i64 {
    match r {
        Ok(()) => 1,
        Err(AllocError::OutOfMemory) => 2,
    }
}

fn h(o: Option<Pair>) -> i64 {
    match o {
        Some(Pair::Both(a, b)) => a * b,
        None => 0,
    }
}

fn main() -> i32 {
    println(
        f"{f(Ok(())) + f(Err(E::A))} {g(Ok(())) + g(Err(AllocError::OutOfMemory))} {h(Some(Pair::Both(5, 6))) + h(None)}");
    0
}
