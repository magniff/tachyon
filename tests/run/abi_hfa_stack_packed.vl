// Apple's AArch64 convention (fixed in 0.5): homogeneous float aggregates
// that no longer fit in the float registers go on the stack at their
// element's alignment and exact size: a struct of three f32 takes 12 bytes,
// one of a single f32 takes 4. They were given 8-byte slots, which put
// every later stack argument at the wrong place. Both directions.
// CSOURCE: tests/c/abi_hfa_stack_packed.c
// EXPECT: 654320161.000
// EXPECT: 654320161.000
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn c_take(a: F3, b: F3, c: F3, d: F1, e: F3, f: f32, g: i32) -> f64;
    fn c_call() -> f64;
}

#[repr(C)]
struct F3 { a: f32, b: f32, c: f32 }
#[repr(C)]
struct F1 { a: f32 }

extern "C" fn t_take(a: F3, b: F3, c: F3, d: F1, e: F3, f: f32, g: i32) -> f64 {
    a.a as f64 + b.b as f64 + c.a as f64 * 10.0 + c.b as f64 * 100.0 + c.c as f64 * 1000.0
        + d.a as f64 * 10000.0 + e.a as f64 * 100000.0 + e.c as f64 * 1000000.0
        + f as f64 * 10000000.0 + g as f64 * 100000000.0
}

fn main() -> i32 {
    let a = F3 { a: 1.0, b: 2.0, c: 3.0 };
    let b = F3 { a: 4.0, b: 5.0, c: 6.0 };
    let c = F3 { a: 0.5, b: 0.25, c: 0.125 };
    let e = F3 { a: 3.0, b: 0.0, c: 4.0 };
    unsafe {
        printf(c"%.3f\n", c_take(a, b, c, F1 { a: 2.0 }, e, 5.0, 6));
        printf(c"%.3f\n", c_call());
    }
    0
}
