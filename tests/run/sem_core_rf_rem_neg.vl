// x % 8 of a negative x is negative: a[x % 8] is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index -3, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(a: [i64; 8], x: i64) -> i64 { a[x % 8] }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(a, -3 + Z));
    0
}
