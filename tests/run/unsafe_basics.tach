// EXPECT: 42 7 3
// EXPECT: sum 15
// EXPECT: union 1078530011
// EXPECT: borrow 11 12
// EXPECT: method 5 6
// EXPECT: slice 30
// EXPECT: block 9
// 0.9: unsafe blocks (expressions, block-like statements) and unsafe
// functions; borrowed pointer parameters are dereferenced in safe code.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
    fn malloc(n: u64) -> *u8;
    fn free(p: *u8);
}

#[repr(C)]
union Bits { f: f32, u: u32 }

struct Counter { n: i64 }

impl Counter {
    fn bump(self: *Counter) -> i64 {
        self.n += 1;
        self.n
    }

    // An unsafe method: the caller promises `p` points to `count` i64s.
    unsafe fn add_all(self: *Counter, p: *i64, count: i64) {
        for i in 0..count {
            self.n += p[i];
        }
    }
}

// The caller promises that p points to `count` i64s.
pub unsafe fn sum(p: *i64, count: i64) -> i64 {
    let mut s = 0;
    for i in 0..count {
        s += p[i];
    }
    s
}

#[inline]
unsafe fn read(p: *i64) -> i64 {
    *p
}

// A method through a borrowed parameter.
fn bump_again(c: *Counter) -> i64 {
    c.bump()
}

// A borrowed parameter: dereferenced in safe code.
fn add_one(p: *i64) -> i64 {
    *p += 1;
    *p
}

fn main() -> i32 {
    let x = 42;
    let p = &x;
    let a = unsafe { *p };
    let b = unsafe { read(&x) } - 35;
    let mut arr = [1i64, 2, 3, 4, 5];
    let c = unsafe {
        let q = &arr[0] as *i64;
        q[2]
    };
    unsafe {
        printf(c"%ld %ld %ld\n", a, b, c);
    }
    let s = unsafe { sum(&arr[0], 5) };
    unsafe { printf(c"sum %ld\n", s) };
    let bits = Bits { f: 3.14159274 };
    let u = unsafe { bits.u };
    unsafe {
        printf(c"union %u\n", u);
    }
    let mut y = 10;
    let first = add_one(&y);
    let second = add_one(&y);
    unsafe {
        printf(c"borrow %ld %ld\n", first, second);
    }
    let mut counter = Counter { n: 4 };
    let m1 = counter.bump();
    let m2 = bump_again(&counter);
    unsafe {
        printf(c"method %ld %ld\n", m1, m2);
    }
    let heap = unsafe { malloc(40) as *i64 };
    unsafe {
        for i in 0..5 {
            heap[i] = (i + 1) * 2;
        }
    }
    let view = unsafe { heap[0..5] };
    let mut total = 0;
    for v in view {
        total += v;
    }
    unsafe {
        printf(c"slice %ld\n", total);
        free(heap as *u8);
    }
    let mut k = Counter { n: 0 };
    let three = [2i64, 3, 4];
    unsafe { k.add_all(&three[0], 3) }
    unsafe {
        printf(c"block %ld\n", k.n);
    }
    arr[0] = 0;
    0
}
