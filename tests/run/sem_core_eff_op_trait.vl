// An operator trait impl that prints, used as `a + b`.
// ERROR: 'quiet' is #[no_io], but it does io
struct V { n: i64 }

impl Add for V {
    fn add(self, o: V) -> V { println("io"); V { n: self.n + o.n } }
}

#[no_io]
fn quiet(a: V, b: V) -> i64 { (a + b).n }

fn main() -> i32 {
    println(quiet(V { n: 1 }, V { n: 2 }));
    0
}
