// `%` on floats lowers to fmod (f64) and fmodf (f32) without the program
// declaring them; pow/powf come from libm.
// EXPECT: 1.5 -1.25 1157.625
// EXPECT: 1.4142135623730951
// EXPECT: 1.5 1157.625
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn pow(x: f64, y: f64) -> f64;
    fn powf(x: f32, y: f32) -> f32;
}

fn main() -> i64 {
    let a: f64 = 10.5;
    let b: f64 = 3.0;
    let m: f64 = -7.25;
    unsafe { printf(c"%.17g %.17g %.17g\n", a % b, m % b, pow(a, b)); }
    let two: f64 = 2.0;
    let half: f64 = 0.5;
    unsafe { printf(c"%.17g\n", pow(two, half)); }
    let c: f32 = 10.5;
    let d: f32 = 3.0;
    unsafe { printf(c"%.17g %.17g\n", c % d, powf(c, d)); }
    0
}
