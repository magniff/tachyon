// 0.18.1: BinaryHeap and MinHeap joined the prelude; a program declaring
// its own (a hand-written heap, as before) still gets its own.
// EXPECT: 1 3
struct MinHeap { d: Vec<i64> }

impl MinHeap {
    fn push(inout self, x: i64) {
        self.d.push(x);
        self.d.sort();
    }

    fn pop(inout self) -> Option<i64> {
        if self.d.len() == 0 { None } else { Some(self.d.remove(0)) }
    }
}

fn main(gpa: Gpa) -> i32 {
    var h = MinHeap { d: Vec::new_in(gpa) };
    h.push(3);
    h.push(1);
    let a = h.pop().unwrap();
    let b = h.pop().unwrap();
    println(f"{a} {b}");
    0
}
