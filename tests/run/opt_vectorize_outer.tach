// CHECK: fn matvec:
// CHECK: v2f64 = load
// CHECK: fn mm:
// CHECK: v4f32 = load
// CHECK: fn mm2:
// CHECK: v2f64 = phi
// CHECK: v2f64 = load
// CHECK: vbin.add
// CHECK: store
// 0.10: outer loops the vectorizer takes: an inner loop over k summing
// for each j (floats too: each lane adds in the scalar order).
extern "C" {
    fn printf(f: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
}

const K: i64 = 7;

#[inline(never)]
fn matvec(m: &f64, v: &f64, out: *f64, cols: i64) {
    // out[j] = sum over k of m[k][j] * v[k] (m: K rows of `cols`)
    for j in 0..cols {
        let mut sum = 0.0;
        for k in 0..K {
            unsafe { sum += m[k * cols + j] * v[k]; }
        }
        unsafe { out[j] = sum; }
    }
}

#[inline(never)]
fn colsum(m: [i32], out: &mut [i32], cols: i64) {
    for j in 0..cols {
        let mut s: i32 = 1;
        for k in 0..12 {
            s = s * 3 + m[k * cols + j];
        }
        out[j] = s;
    }
}

#[inline(never)]
fn mm(a: &f32, b: &f32, c: &mut f32, n: i64) {
    for i in 0..n {
        for j in 0..n {
            let mut s: f32 = 0.0;
            for k in 0..8 {
                unsafe { s += a[i * 8 + k] * b[k * n + j]; }
            }
            unsafe { c[i * n + j] = s; }
        }
    }
}

fn main() -> i32 {
    let cols = 13;
    let m = unsafe { malloc((K * 40 * 8) as u64) as *f64 };
    let v = unsafe { malloc((K * 8) as u64) as *f64 };
    let out = unsafe { malloc((40 * 8 + 64) as u64) as *f64 };
    for i in 0..K * 40 {
        unsafe { m[i] = (i % 17) as f64 * 0.1 - 0.7; }
    }
    for i in 0..K {
        unsafe { v[i] = 1.0 / (i as f64 + 3.0); }
    }
    for c in 1..cols {
        unsafe { matvec(&*m, &*v, out, c); }
        for j in 0..c {
            unsafe { printf(c"%.17g,", out[j]); }
        }
        unsafe { printf(c"\n"); }
    }
    // The output inside the matrix: the overlap test sends it to the scalar
    // loop.
    unsafe { matvec(&*m, &*v, &m[3], 9); }
    for j in 0..20 {
        unsafe { printf(c"%.17g,", m[j]); }
    }
    unsafe { printf(c"\n"); }
    let mut ints: [i32; 200] = [0; 200];
    for i in 0..200 {
        ints[i] = (i * 7919 % 1009 - 500) as i32;
    }
    let mut res: [i32; 16] = [0; 16];
    for c in 1..16 {
        colsum(ints[0..200], &mut res[0..16], c);
        unsafe { printf(c"%d,", res[c - 1]); }
    }
    unsafe { printf(c"\n"); }
    let n = 9;
    let a = unsafe { malloc((n * 8 * 4) as u64) as *f32 };
    let b = unsafe { malloc((8 * n * 4) as u64) as *f32 };
    let c = unsafe { malloc((n * n * 4) as u64) as *f32 };
    for i in 0..n * 8 {
        unsafe {
            a[i] = (i % 5) as f32 * 0.5;
            b[i] = (i % 7) as f32 - 2.25;
        }
    }
    unsafe { mm(&*a, &*b, &mut *c, n); }
    for i in 0..n * n {
        unsafe { printf(c"%.9g,", c[i] as f64); }
    }
    unsafe { printf(c"\n"); }
    for n in 1..8 {
        run_mm2(n);
    }
    0
}

// matmul's shape: the j loop around a k loop (8 iterations, unrolled by 4
// first) that sums a row times a column.
#[inline(never)]
fn mm2(a: &f64, b: &f64, c: &mut f64, n: i64) {
    for i in 0..n {
        for j in 0..n {
            let mut s = 0.0;
            for k in 0..40 {
                unsafe { s += a[i * 40 + k] * b[k * n + j]; }
            }
            unsafe { c[i * n + j] = s; }
        }
    }
}

#[inline(never)]
fn run_mm2(n: i64) {
    let a = unsafe { malloc((n * 40 * 8) as u64) as *f64 };
    let b = unsafe { malloc((40 * n * 8) as u64) as *f64 };
    let c = unsafe { malloc((n * n * 8) as u64) as *f64 };
    for i in 0..n * 40 {
        unsafe {
            a[i] = (i % 11) as f64 * 0.25 - 1.0;
            b[i] = 1.0 / ((i % 13) as f64 + 1.0);
        }
    }
    unsafe { mm2(&*a, &*b, &mut *c, n); }
    let mut t = 0.0;
    for i in 0..n * n {
        unsafe { t = t * 0.5 + c[i]; }
    }
    unsafe { printf(c"mm2 %ld %.17g\n", n, t); }
}
