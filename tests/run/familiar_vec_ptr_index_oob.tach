// 0.17: `p[i]` through a borrow of a Vec is checked as the Vec's slice is.
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
fn set(v: *Vec<i64>, i: i64) { v[i] = 4; }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    defer v.free();
    v.push(1);
    v.push(2);
    v.push(3);
    set(&v, 3);
    0
}
