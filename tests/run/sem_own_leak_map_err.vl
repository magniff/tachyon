// sem-own: (known leak, scope) Result::map_err's closure takes the error sink: not dropped.
// XFAIL: SOUNDNESS known leak: a closure's sink parameter is never dropped (map_err)
// EXPECT: drop 1
// EXPECT: e 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn g(gpa: Gpa) -> Result<i64, D> { Err(mk(1, gpa)) }

fn main(gpa: Gpa) {
    let r = g(gpa).map_err(|e| e.id);
    println(f"e {r.err().unwrap_or(0)}");
}
