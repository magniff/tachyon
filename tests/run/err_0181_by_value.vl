// 0.18.1: Rust's `m.get(&k)`, `v.contains(&x)`: std's lookups take the
// key by value. A plain key is read through the reference (as `*n`
// is, by_value_lookup.vl); an owned key's try: line (and fix
// --suggested) drops the `&`. 0.20: the key is a let parameter, and `&`
// marks only an inout argument (conv.marker_extra).
// ERROR: error[conv.marker_extra]: '&' marks an argument the callee may change; 'k' is taken let or sink here (read, or moved): pass 'k'
// ERROR: --old '&k' --new 'k'
#[derive(Eq, Hash)]
struct K { a: i64, v: Vec<i64> }

fn main(gpa: Gpa) -> i32 {
    var m: HashMap<K, i64> = HashMap::new_in(gpa);
    let k = K { a: 3, v: Vec::new_in(gpa) };
    let a = m.get(&k);
    0
}
