// (0.25) A view of a temporary lives as long as the temporary: to the end
// of the block when a `let` binds the view, to the end of the statement
// otherwise. Both are fine while they are used inside that.
// EXPECT: aa
// EXPECT: bb
// EXPECT: cc 2
struct H { b: Buf }
impl H { fn view(self) -> [u8] { self.b.as_slice() } }
fn mk(gpa: Gpa, c: u8) -> H { var b = Buf::new_in(gpa); b.push(c); b.push(c); H { b: b } }

fn main(gpa: Gpa) {
    let s = mk(gpa, 'a').view();
    println(s);
    println(mk(gpa, 'b').view());
    let n = mk(gpa, 'c').view().len();
    println(f"{mk(gpa, 'c').view()} {n}");
}
