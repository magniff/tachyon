// ok: a generic function's closure result that views nothing it is given
// EXPECT: 1 static 2
fn apply<T, R, F: Fn(T) -> R>(x: T, f: F) -> R { f(x) }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let n = apply(v, |d: Vec<i64>| d.len());
    let w: str = apply(v, |d: Vec<i64>| "static");
    v.push(2);
    println(f"{n} {w} {v.len()}");
}
