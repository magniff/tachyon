// (0.17) format_in with its f-string written in place (fmt_direct) checks
// its allocator as the call of format_in did: the error names format_in.
// ERROR: the trait 'Allocator' is not implemented for 'i64'
// ERROR-COUNT: 1
use std::{format_in, println};

fn main() {
    let s = format_in(f"x{1}", 5);
    println(s.as_slice());
}
