// String escapes produce the right bytes, and `.1` is the byte length.
// EXPECT: a	b\c"d
// EXPECT: 8
// EXPECT: 3 121
extern fn printf(format: *u8, ...) -> i32;
extern fn write(fd: i32, buf: *u8, n: u64) -> i64;

fn main() -> i64 {
    let s = "a\tb\\c\"d\n";
    write(1, s.0, s.1);
    printf("%lu\n".0, s.1);
    let z = "x\0y";
    printf("%lu %d\n".0, z.1, *((z.0 as u64 + 2) as *u8));
    0
}
