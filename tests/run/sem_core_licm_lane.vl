fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var t = 0;
    var k = 0;
    let v = v4f32::splat(1.0);
    let i = 9 + Z;
    while k < 5 + Z { if k > 100 { t += v.lane(i) as i64; } k += 1; }
    println(t);
    0
}
