// sem-own: matching an owned enum local by value moves the payload into the
// binding; dropped once, at the arm's end.
// EXPECT: some 5
// EXPECT: drop 5
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
enum E { A(D), B(i64), C { d: D, n: i64 } }

fn main(gpa: Gpa) {
    let e = E::A(mk(5, gpa));
    match e {
        E::A(d) => println(f"some {d.id}"),
        E::B(n) => println(f"b {n}"),
        E::C { d, n } => println(f"c {d.id}"),
    }
    println("end");
}
