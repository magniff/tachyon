// 0.15: if-conversion in innermost loops (ifconv.tach). A small branch
// whose ways meet again becomes a select (`sel`): a filtered sum is a sum
// of `k ? x : 0`, a count a sum of `k ? 1 : 0`, `if x > m { m = x }` a
// maximum; the vectorizer takes them on masks (`vcmp`, `vsel`), and the
// maximum's lanes are combined after the loop. Every length from 0 to 20,
// values of both signs, the comparisons of every order, a branch whose
// arm divides (left alone) and one setting two values; a comparator's
// ordering (-1, 0, 1) compared with 0 is the comparison it came from.
// EXPECT: fsum 0 0 0 0 0 39 39 46 46 46 113 113 113 113 113 113 372 379 446 465 465
// EXPECT: count 0 1 1 2 2 3 4 5 6 6 7 8 8 9 10 10 11 12 13 14 15
// EXPECT: max -9223372036854775808 7 7 11 11 11 11 11 13 13 13 13 13 13 13 13 16 16 16 16 16
// EXPECT: min 9223372036854775807 7 -3 -3 -9 -9 -9 -9 -9 -9 -9 -9 -9 -9 -9 -15 -15 -15 -15 -15 -15
// EXPECT: maxge 0 7 7 11 11 11 11 11 13 13 13 13 13 13 13 13 16 16 16 16 16
// EXPECT: umin 4294967295 14 4 4 4 4 4 4 4 4 4 4 4 4 4 4 4 4 4 4 4
// EXPECT: two 0:0 7:0 7:3 18:3 18:12 24:12 31:12 33:12 46:12 46:13 54:13 59:13 60:13 63:13 74:13 74:28 90:28 92:28 100:28 104:28 109:28
// EXPECT: divs 0 3 3 8 8 11 14 15 21 21 25 27 27 28 33 33 41 42 46 48 50
// EXPECT: xor 0 7 -6 -15 6 0 7 5 8 -9 -1 -6 -5 -8 -13 2 18 16 24 24 29
// EXPECT: sorted 16 13 11 11 8 8 7 7 6 5 5 4 3 2 2 1 -1 -3 -9 -15
// CHECK: fn fsum:
// CHECK: sel
// CHECK: fn count:
// CHECK: vcmp.gt
// CHECK: vsel
// CHECK: fn max:
// CHECK: vcmp.gt
// CHECK: vsel
// CHECK: vext
// CHECK: sel
// CHECK: fn min:
// CHECK: vcmp.lt
// CHECK: vsel
// CHECK: fn sort_desc:
// CHECK-NOT: const -1
// CHECK: fn main:
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn fsum(s: [i64], r: i64) -> i64 {
    let mut t = 0;
    for x in s {
        if x & 1 == 0 {
            t += x * x + r;
        }
    }
    t
}

#[inline(never)]
fn count(s: [i64], r: i64) -> i64 {
    let mut c = 0;
    for x in s {
        if x > r {
            c += 1;
        }
    }
    c
}

#[inline(never)]
fn max(s: [i64]) -> i64 {
    let mut m = 0 - 9223372036854775807 - 1;
    for x in s {
        if x > m {
            m = x;
        }
    }
    m
}

#[inline(never)]
fn min(s: [i64]) -> i64 {
    let mut m = 9223372036854775807;
    for x in s {
        if x < m {
            m = x;
        }
    }
    m
}

#[inline(never)]
fn maxge(s: [i64]) -> i64 {
    let mut m = 0;
    for k in 0..s.len {
        let x = s[k] * 1;
        if m <= x {
            m = x;
        }
    }
    m
}

// (unsigned: no vector comparison, the run-time unroller's accumulators)
#[inline(never)]
fn umin(s: [u32]) -> u32 {
    let mut m: u32 = 4294967295;
    for x in s {
        if x < m {
            m = x;
        }
    }
    m
}

#[inline(never)]
fn two(s: [i64], a: &mut i64, b: &mut i64) {
    let mut p = 0;
    let mut q = 0;
    for x in s {
        if x > 0 {
            p += x;
        } else {
            q -= x;
        }
    }
    unsafe {
        *a = p;
        *b = q;
    }
}

#[inline(never)]
fn divs(s: [i64], d: i64) -> i64 {
    let mut t = 0;
    for x in s {
        if x > 0 {
            t += x / d;
        }
    }
    t
}

#[inline(never)]
fn xor(s: [i64]) -> i64 {
    let mut t = 0;
    for x in s {
        if x != 4 {
            t ^= x;
        }
    }
    t
}

// (std's sort_by: its sift-down's choice of child, on the comparator's
// ordering)
#[inline(never)]
fn sort_desc(v: &mut Vec<i64>) {
    v.sort_by(|a, b| b.cmp(a));
}

fn main(gpa: Gpa) -> i32 {
    let a: [i64; 20] = [7, -3, 11, -9, 6, 7, 2, 13, -1, 8, 5, 1, 3, 11, -15, 16, 2, 8, 4, 5];
    let mut u: [u32; 20] = [0; 20];
    for i in 0..20 {
        u[i] = (a[i] + 100) as u32 - 93;
    }
    unsafe { printf(c"fsum"); }
    for n in 0..21 {
        unsafe { printf(c" %ld", fsum(a[0..n], 3)); }
    }
    unsafe { printf(c"\ncount"); }
    for n in 0..21 {
        unsafe { printf(c" %ld", count(a[0..n], 1)); }
    }
    unsafe { printf(c"\nmax"); }
    for n in 0..21 {
        unsafe { printf(c" %ld", max(a[0..n])); }
    }
    unsafe { printf(c"\nmin"); }
    for n in 0..21 {
        unsafe { printf(c" %ld", min(a[0..n])); }
    }
    unsafe { printf(c"\nmaxge"); }
    for n in 0..21 {
        unsafe { printf(c" %ld", maxge(a[0..n])); }
    }
    unsafe { printf(c"\numin"); }
    for n in 0..21 {
        unsafe { printf(c" %u", umin(u[0..n])); }
    }
    unsafe { printf(c"\ntwo"); }
    for n in 0..21 {
        let mut p = 0;
        let mut q = 0;
        two(a[0..n], &mut p, &mut q);
        unsafe { printf(c" %ld:%ld", p, q); }
    }
    unsafe { printf(c"\ndivs"); }
    for n in 0..21 {
        unsafe { printf(c" %ld", divs(a[0..n], 2)); }
    }
    unsafe { printf(c"\nxor"); }
    for n in 0..21 {
        unsafe { printf(c" %ld", xor(a[0..n])); }
    }
    unsafe { printf(c"\nsorted"); }
    let mut w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..20 {
        w.push(a[i]);
    }
    sort_desc(&mut w);
    for i in 0..20 {
        unsafe { printf(c" %ld", w.get(i)); }
    }
    unsafe { printf(c"\n"); }
    0
}
