// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: the closure's result views the captured s
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    let c = || s.as_str();
    let r = c();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
