// STDIN: 3 lines first
// STDIN:
// STDIN:   padded
// STDIN: 10 -20 x 30
// STDIN: second line
// STDIN:
// STDIN: last, no newline
// EXPECT: [3 lines first] [] [  padded] [padded]
// EXPECT: ints: 10 -20 none 30
// EXPECT: lines: <> <second line> <> <last, no newline>
// EXPECT: done true, rest 0
// EXPECT: end false []
// 0.14: reading stdin without unsafe: read_line (an empty line apart from
// the end of input, the last line without '\n'), then read_stdin for the
// rest (what read_line had buffered included), and a Scanner over it.
// (0.15: read_line, read_stdin and next_int return a Result.)
use std::{Buf, Scanner, read_line, read_stdin, trim};

fn main() -> i32 {
    let mut line = Buf::new();
    defer line.free();
    for _ in 0..3 {
        read_line(&line).unwrap();
        print("[");
        print(line.as_slice());
        print("] ");
    }
    print("[");
    print(trim(line.as_slice()));
    println("]");

    let mut input = read_stdin().unwrap();
    defer input.free();
    let mut sc = Scanner::new(input.as_slice());
    print("ints:");
    for _ in 0..4 {
        print(" ");
        match sc.next_int() {
            Ok(n) => std::print_int(n),
            Err(_) => print("none"),
        }
    }
    println("");
    print("lines:");
    while let Some(l) = sc.next_line() {
        print(" <");
        print(l);
        print(">");
    }
    println("");
    print(if sc.is_done() { "done true" } else { "done false" });
    print(", rest ");
    std::print_int(sc.rest().len);
    println("");

    line.push_str("stale");
    let more = read_line(&line).unwrap();
    print(if more { "end true [" } else { "end false [" });
    print(line.as_slice());
    println("]");
    0
}
