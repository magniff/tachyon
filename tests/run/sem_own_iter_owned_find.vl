// sem-own: find over owned items: the non-matching items are dropped, the found one kept.
// EXPECT: drop 0
// EXPECT: found 1
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let f = (0..3).map(|i| mk(i, gpa)).find(|d| d.id == 1);
    if let Some(d) = f { println(f"found {d.id}"); }
}
