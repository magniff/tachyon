// 0.17: `&mut x` is `&x`: one pointer type, `*T`.
// EXPECT: 3 [1, 2]
fn bump(x: inout i64) { x += 1; }

fn add(v: inout Vec<i64>, x: i64) { v.push(x); }

fn main(gpa: Gpa) -> i32 {
    var n = 1;
    bump(&n);
    bump(&n);
    var v: Vec<i64> = Vec::new_in(gpa);
    add(&v, 1);
    add(&v, 2);
    println(f"{n} {v:?}");
    0
}
