// Float-to-integer casts saturate, NaN is 0 (grammar.md): signed results
// saturate at their own bounds (0.25: i8 and i16 too), unsigned ones up to
// 32 bits take the low bits of the i64 conversion, and u64 converts
// unsigned at 2^63 and above.
// EXPECT: i64: 9223372036854775807 -9223372036854775808 0 -2
// EXPECT: i32: 2147483647 -2147483648 0 2147483647
// EXPECT: i8: 127 127 -128
// EXPECT: u8: 44 255 0
// EXPECT: u32: 705032704 4294967293
// EXPECT: u64: 18446744073709551615 9223372036854775808 12345678901234567168 18446744073709551611 0
// EXPECT: f32: 9223372036854775807 2147483647 18446744073709551615 9223372036854775808 0
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn nan() -> f64 { 0.0 / 0.0 }

fn main() -> i32 {
    let big: f64 = 1e30;
    let neg: f64 = -1e30;
    let n = nan();
    unsafe {
        printf(c"i64: %ld %ld %ld %ld\n", big as i64, neg as i64, n as i64, -2.75 as i64);
        printf(c"i32: %d %d %d %d\n", big as i32, neg as i32, n as i32, 3000000000.0 as i32);
        printf(c"i8: %d %d %d\n", big as i8, 200.0 as i8, -200.0 as i8);
        printf(c"u8: %u %u %u\n", 300.5 as u8, -1.0 as u8, n as u8);
        printf(c"u32: %u %u\n", 5000000000.0 as u32, -3.0 as u32);
        printf(c"u64: %lu %lu %lu %lu %lu\n", big as u64, 9223372036854775808.0 as u64,
            12345678901234567890.0 as u64, -5.0 as u64, n as u64);
    }
    let fbig: f32 = 1e20;
    let fn32: f32 = 0.0 / 0.0;
    unsafe {
        printf(c"f32: %ld %d %lu %lu %u\n", fbig as i64, fbig as i32, fbig as u64,
            9223372036854775808.0 as f32 as u64, fn32 as u32);
    }
    0
}
