use parser::Query;

fn value(o: parser::Operand) -> i64 { o.col }

fn weight(k: parser::Kind) -> i64 {
    match k {
        parser::Kind::A => 1,
        parser::Kind::B(n) => n,
    }
}

pub fn run() -> i64 {
    let q = Query { n: 1 };
    let o = parser::Operand { col: q.n };
    value(o) + parser::mk(2).col + weight(parser::Kind::B(parser::LIMIT)) + weight(parser::Kind::A)
}
