// 0.17: a path in code starts as a `use` path does: its first segment,
// when no name of the module it is written in, is a module beside it,
// else the root's. In exec.vl `parser::...` is crate::parser in a type,
// a struct literal, a call, a constant, an enum's variant (an expression
// and a pattern); in front/check.vl `types::Ty` is front's child and
// `util::twice` the root's. A name in scope still wins (`use` of a
// module named so).
// EXPECT: 8 7 12 2
mod parser;
mod exec;
mod front;
mod util;

fn main() -> i32 {
    println(f"{exec::run()} {front::check::check()} {util::twice(6)} {front::check::shadow()}");
    0
}
