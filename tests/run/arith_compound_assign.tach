// +=, -=, <<=, >>= at several widths, wrapping where needed.
// EXPECT: 44 -5 2147483648 -8 15 3.25
// EXPECT: 275
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: u8 = 200;
    a += 100;
    let b: i16 = 5;
    b -= 10;
    let c: u32 = 1;
    c <<= 31;
    let d: i32 = (0 - 64) as i32;
    d >>= 3;
    let e: u64 = 0xFFFFFFFFFFFFFFFF;
    e >>= 60;
    let f: f64 = 1.5;
    f += 2.25;
    f -= 0.5;
    printf("%d %d %u %d %lu %.2f\n".0, a, b, c, d, e, f);
    let i: i64 = 0;
    let acc: i64 = 0;
    loop {
        if i == 10 { break; };
        acc += i * i;
        acc -= 1;
        i += 1;
    }
    printf("%ld\n".0, acc);
    0
}
