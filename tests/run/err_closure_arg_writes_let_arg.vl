// (0.25) A closure argument that changes v, next to v passed let to the
// same call: the callee may call it while it reads v (a use after free
// once v grows).
fn f<F: FnMut()>(p: Vec<i64>, w: F) -> i64 { let before = p.len(); w(); before * 100 + p.len() }
fn g<F: FnMut()>(w: F, s: [i64]) -> i64 { w(); s[0] }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let a = f(v, || { v.push(2); });
    let b = g(|| { for i in 0..100 { v.push(i); } }, v.as_slice());
    let h = || { v.clear(); };
    let c = f(v, h);
    println(f"{a} {b} {c}");
}
// ERROR: own.conflict
