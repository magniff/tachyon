// for over a user iterator of R (Drop): each R dropped once, at the end of its iteration
// FLAGS: --check-alloc
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: got 0
// EXPECT: drop 0
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;

    fn next(inout self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        Some(R { id: self.n })
    }
}

fn main() {
    for r in Gen { n: 2 } { println(f"got {r.id}"); }
    println("end");
}
