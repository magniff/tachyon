// A fn value given as a default argument: the function it names is address-taken.
// ERROR: 'quiet' is #[no_io], but it does io
fn noisy(x: i64) -> i64 { println("io"); x }

fn run(x: i64, f: fn(i64) -> i64 = noisy) -> i64 { f(x) }

#[no_io]
fn quiet(x: i64) -> i64 { run(x) }

fn main() -> i32 {
    println(quiet(3));
    0
}
