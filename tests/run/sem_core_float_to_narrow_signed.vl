// grammar.md: "a signed target saturates at its own bounds". i8 and i16
// instead saturate at i32's and keep the low bits (1e30 as i16 == -1,
// 128.0 as i8 == -128), constant and at run time.
// XFAIL: WRONG float to i8/i16 does not saturate at the target's bounds as grammar.md says
// EXPECT: 32767 -32768 127 -128 127 -128
// EXPECT: 32767 -32768 127 -128 127 -128
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let zf = Z as f64;
    println(f"{1e30 as i16} {-1e30 as i16} {1e30 as i8} {-1e30 as i8} {128.0 as i8} {-200.0 as i8}");
    let big = 1e30 + zf;
    println(f"{big as i16} {-big as i16} {big as i8} {-big as i8} {(128.0 + zf) as i8} {(-200.0 + zf) as i8}");
    0
}
