// (0.22) A distinct type cannot have named values: `const STORAGE:
// BufferUsage = 128` is rejected (a constant's type must be a literal's),
// and there are no associated constants, so std::gpu's flags stay u32
// constants in modules (BufferUsage::STORAGE) and a TextureUsage passed
// as a BufferUsage is not a type error (design A18).
// XFAIL: constants of a distinct type (0.22)
// EXPECT: true

pub type BufferUsage = distinct u32;

const STORAGE: BufferUsage = 128;
const COPY_DST: BufferUsage = 8;

fn main() {
    let u = STORAGE | COPY_DST;
    println(u & STORAGE != 0);
}
