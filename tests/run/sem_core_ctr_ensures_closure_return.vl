// A return inside a closure is the closure's: it is not checked against the
// enclosing function's ensures; the function's own return is.
// EXPECT: 5
// EXPECT: 11
static var Z: i64 = 0;

fn f(x: i64) -> i64
    ensures result > 0
{
    let g = |y: i64| -> i64 { if y > 0 { return -5; } 1 };
    g(x) + 10
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    println(f(1 + Z));
    println(f(-20 + Z));
    0
}
