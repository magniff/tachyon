// Slices: from arrays, slices and pointers; len and ptr; indexing and
// writing through them; passing them to functions.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
}

fn sum(s: [i64]) -> i64 {
    var total = 0;
    for i in 0..s.len {
        total += s[i];
    }
    total
}

fn fill(s: inout [i64], value: i64) {
    for i in 0..s.len {
        s[i] = value + i as i64;
    }
}

fn middle(s: [u8]) -> [u8] {
    s[1..s.len - 1]
}

struct Buf { data: [u8], used: i64 }

fn main() {
    var a: [i64; 6] = [1, 2, 3, 4, 5, 6];
    let all = a[..];
    unsafe {
        printf(c"%lu %ld\n", all.len, sum(all));
        printf(c"%ld %ld %ld\n", sum(a[2..]), sum(a[..2]), sum(a[1..=3]));
    }
    fill(&a[3..5], 100);
    unsafe { printf(c"%ld %ld %ld\n", a[3], a[4], a[5]); }
    let s = a[1..5];
    let t = s[1..3];
    unsafe { printf(c"%lu %ld %ld\n", t.len, t[0], t[1]); }
    let p = unsafe { malloc(64) as *i64 };
    let h = unsafe { &p[0..8] };
    fill(h, 7);
    unsafe { printf(c"%ld %ld %lu\n", p[0], p[7], h.len); }
    let text: [u8; 5] = [104, 101, 108, 108, 111];
    let mid = middle(text[..]);
    unsafe { printf(c"%lu %c%c%c\n", mid.len, mid[0] as i32, mid[1] as i32, mid[2] as i32); }
    let b = Buf { data: text[0..2], used: 1 };
    unsafe { printf(c"%c %ld\n", b.data[1] as i32, b.used); }
    let e = a[3..3];
    unsafe {
        printf(c"%lu\n", e.len);
        printf(c"%d\n", (*a[..].ptr == 1) as i32);
    }
}

// EXPECT: 6 21
// EXPECT: 18 3 9
// EXPECT: 100 101 6
// EXPECT: 2 3 100
// EXPECT: 7 14 8
// EXPECT: 3 ell
// EXPECT: e 1
// EXPECT: 0
// EXPECT: 1
