// The Iterator trait's adapters and consumers on std's sources (0.14):
// map, filter, enumerate, zip, take, sum, count, min, max, fold,
// collect, and `for` over a chain (the `next` path).
// EXPECT: map 81 filter 5 range 220
// EXPECT: enumerate 66 zip 93
// EXPECT: max 9 min 1 empty 1
// EXPECT: take 5 1 9 | 18 6
// EXPECT: collect 6 90 | 0 1 2 3 4
// EXPECT: chain 0:5 2:9 4:7
// EXPECT: u8 32640 6
fn show(label: [u8], x: i64) {
    print(label);
    std::print_int(x);
}

fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    defer v.free();
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    v.push(2);

    show("map ", v.iter().map(| x | x * 3).sum());
    show(" filter ", v.iter().filter(| x | x % 2 == 1).count());
    show(" range ", (1..=10).filter(| x | x % 2 == 0).map(| x | x * x).sum());
    println("");

    show("enumerate ", v.iter().enumerate().map(| (i, x) | i * x).sum());
    show(" zip ", v.iter().zip((0..6).map(| k | k + 1)).fold(0, | acc, (x, y) | acc + x * y));
    println("");

    show("max ", v.iter().max().unwrap());
    show(" min ", v.iter().min().unwrap());
    show(" empty ", (0..0).max().is_none() as i64);
    println("");

    print("take");
    for x in v.iter().take(3) {
        show(" ", x);
    }
    show(" | ", v.iter().take(4).sum());
    show(" ", v.iter().take(100).count());
    println("");

    let mut w = v.iter().map(| x | x * 10).collect();
    defer w.free();
    show("collect ", w.len());
    show(" ", w.get(2));
    print(" |");
    let mut r = (0..5).collect();
    defer r.free();
    for x in r {
        show(" ", x);
    }
    println("");

    print("chain");
    for (i, x) in v.iter().enumerate().filter(| p | p.1 > 4) {
        show(" ", i);
        show(":", x);
    }
    println("");

    show("u8 ", (0..=255u8).map(| x | x as i64).sum());
    show(" ", (250..=255u8).count());
    println("");
    0
}
