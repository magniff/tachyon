// (0.25) every way a scoped thread changes a variable it borrows from the
// caller is sync.scope_shared_write: through an inout slice of a whole or a
// part (arrays, Vec, Buf, fields), an element of a Vec or a Buf (written
// through as_mut_slice), an inout method of an array's slicing, a String
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'a'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'a'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'a'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'a'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'v'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'v'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'v'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'b'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'b'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'b'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 's'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 's'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 's'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'st'
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'v'
use std::thread;
fn fill(s: inout [i64]) { s[0] = 7; }
fn fb(s: inout [u8]) { s[0] = 7; }
struct S { v: Vec<i64>, a: [i64; 2] }

fn main(gpa: Gpa) {
    var a = [0, 0, 0, 0];
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(0);
    var b = Buf::new_in(gpa);
    b.push(1);
    var st = String::new_in(gpa);
    var s = S { v: Vec::new_in(gpa), a: [0, 0] };
    thread::scope(|sc| {
        sc.spawn(|| { fill(&a[1..3]); 0 });
        sc.spawn(|| { fill(&a); 0 });
        sc.spawn(|| { a.sort(); 0 });
        sc.spawn(|| { a[1..].sort(); 0 });
        sc.spawn(|| { fill(&v); 0 });
        sc.spawn(|| { v[0] = 1; 0 });
        sc.spawn(|| { v[0] += 1; 0 });
        sc.spawn(|| { b[0] = 1; 0 });
        sc.spawn(|| { b.as_mut_slice()[0] = 1; 0 });
        sc.spawn(|| { fb(&b[0..1]); 0 });
        sc.spawn(|| { fill(&s.v); 0 });
        sc.spawn(|| { fill(&s.a); 0 });
        sc.spawn(|| { s.a[1] = 2; 0 });
        sc.spawn(|| { st.push_str("x"); 0 });
        sc.spawn(|| { inout r = &v; r.push(1); 0 });
        0
    });
}
