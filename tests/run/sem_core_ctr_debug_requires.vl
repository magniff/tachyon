// debug requires is not checked in a normal build, so it gives the optimizer no fact.
// EXPECT: 2
// EXIT: 101
// STDERR: index out of bounds: index 1000000, length 3
static var Z: i64 = 0;

#[inline(never)]
fn at(s: [i64], i: i64) -> i64
    debug requires 0 <= i && i < s.len()
{
    s[i]
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2, 3];
    println(at(a[..], 1 + Z));
    println(at(a[..], 1000000 + Z));
    0
}
