// (0.25) A store to an element drops the element it replaces, once: an
// index evaluated once, swap/replace on elements, nested `w[0][0]`, a
// field of an element, an array element, a tuple part, Vec::set. (A
// temporary cannot be lent inout, conv.place: swap's second place is t3.)
// EXPECT: drop 1
// EXPECT: calls 1
// EXPECT: drop 2
// EXPECT: old 3
// EXPECT: drop 5
// EXPECT: drop 7
// EXPECT: drop 9
// EXPECT: drop 12
// EXPECT: drop 14
// EXPECT: drop 4
// EXPECT: end
// EXPECT: drop 15
// EXPECT: drop 11
// EXPECT: drop 13
// EXPECT: drop 8
// EXPECT: drop 10
// EXPECT: drop 6
// EXPECT: drop 3
// EXPECT: drop 16
// EXPECT: live 0
static var LIVE: i64 = 0;
static var CALLS: i64 = 0;
struct D { id: i64 }
fn mk(id: i64) -> D { LIVE += 1; D { id: id } }
impl Drop for D { fn drop(inout self) { LIVE -= 1; println(f"drop {self.id}"); } }
struct H { d: D, v: Vec<D> }
fn idx() -> i64 { CALLS += 1; 0 }

fn main(gpa: Gpa) -> i32 {
    {
        var v: Vec<D> = Vec::new_in(gpa);
        v.push(mk(1));
        v[idx()] = mk(2);
        println(f"calls {CALLS}");
        { var t3 = mk(3); std::swap(&v[0], &t3); }
        let old = std::replace(&v[0], mk(4));
        println(f"old {old.id}");
        var w: Vec<Vec<D>> = Vec::new_in(gpa);
        var inner: Vec<D> = Vec::new_in(gpa);
        inner.push(mk(5));
        w.push(inner);
        w[0][0] = mk(6);
        var hs: Vec<H> = Vec::new_in(gpa);
        hs.push(H { d: mk(7), v: Vec::new_in(gpa) });
        hs[0].d = mk(8);
        hs[0].v.push(mk(9));
        hs[0].v[0] = mk(10);
        var arr = [mk(11), mk(12)];
        arr[1] = mk(13);
        var t: Vec<(i64, D)> = Vec::new_in(gpa);
        t.push((1, mk(14)));
        t[0].1 = mk(15);
        v.set(0, mk(16));
        println("end");
    }
    println(f"live {LIVE}");
    0
}
