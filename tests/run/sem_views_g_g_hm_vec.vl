// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(m)`; s grows while it is used
// ERROR: error[own.conflict]
fn f(m: HashMap<i64, Vec<str>>) -> str { m.get(1).unwrap().get(0) }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w);
    var m: HashMap<i64, Vec<str>> = HashMap::new_in(gpa); m.insert(1, v);
    let r = f(m);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
