// requires on a generic function, checked in every instance.
// EXPECT: 2
// EXIT: 101
// STDERR: past the end: i = 1, s.len() = 1
static var Z: i64 = 0;
fn at<T>(s: [T], i: i64) -> T
    requires i < s.len() else "past the end"
{
    s[i]
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [1, 2];
    let b = [true];
    println(at(a[..], 1 + Z));
    println(at(b[..], 1 + Z));
    0
}
