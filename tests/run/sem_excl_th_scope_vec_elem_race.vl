// ERROR: sync
use std::thread;
fn bump(n: inout i64) { n += 1; }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa); v.push(0);
    thread::scope(|sc| {
        let x = sc.spawn(|| { for i in 0..1000000 { bump(&v[0]); } 0 });
        let y = sc.spawn(|| { for i in 0..1000000 { bump(&v[0]); } 0 }); x.join() + y.join()
    }); println(f"{v[0]}");
}
