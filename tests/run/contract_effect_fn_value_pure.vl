// A condition may call through a fn value when every function of its type
// whose address is taken is pure (0.25).
// EXPECT: 3
fn double(x: i64) -> i64 { x * 2 }
fn triple(x: i64) -> i64 { x * 3 }

fn f(x: i64, g: fn(i64) -> i64) -> i64
    requires g(x) > 0
{
    x
}

fn main() -> i32 {
    let h = if std::env::args().len() > 5 { triple } else { double };
    println(f(3, h));
    0
}
