fn main(gpa: Gpa) -> i32 {
    let mut names: Vec<Buf> = Vec::new_in(gpa);
    names.push(Buf::from_in("x", gpa));
    let mut out: Vec<Buf> = Vec::new_in(gpa);
    out.push(names.get(0));
    let n = names.get(0);
    out.push(n);
    out.push(names.last().unwrap());
    out.push(names.get(0).clone());
    0
}
// (0.17, T7) std's accessors return a copy of an element (`T`, not `&T`,
// until 0.17.1): a binding of it borrows (not dropped), and moving it,
// or passing the call's value on by value, would drop it twice:
// own.move_out, with `.clone()`.
// ERROR: cannot move 'names.get(0)' (Buf): it is a copy of an element the collection keeps
// ERROR: cannot move 'n' (Buf) out of 'n': it is a copy of an element 'names.get(0)'
// ERROR: cannot move 'names.last().unwrap()' (Buf)
