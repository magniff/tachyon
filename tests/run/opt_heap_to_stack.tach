// Escape analysis (0.6): a small malloc or calloc whose pointer stays in
// the function (dereferenced, compared, freed) becomes a frame slot
// (zeroed for calloc), and its free goes; scalar replacement then keeps
// it in registers. Here every allocation ends up in main (inlined), where
// none escapes. `escapes` keeps one on the heap: its pointer is stored.
// EXPECT: 30 0 7
// EXPECT: 51
// EXPECT: 5
// CHECK: fn main:
// CHECK: call malloc
// CHECK-NOT: call calloc
// CHECK-NOT: call free
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
    fn calloc(count: u64, size: u64) -> *u8;
    fn free(p: *u8);
}

#[repr(C)]
struct Pair { a: i64, b: i64 }

static var SAVED: *i64 = 0 as *i64;

fn local_sum(x: i64) -> i64 {
    let p = unsafe { malloc(16) as *Pair };
    unsafe {
        p.a = x;
        p.b = x * 2;
    }
    let s = unsafe { p.a + p.b };
    unsafe { free(p as *u8); }
    s
}

fn zeroed() -> i64 {
    let q = unsafe { calloc(4, 8) as *i64 };
    var t = 0;
    for i in 0..4 {
        unsafe { t += q[i]; }
    }
    unsafe { free(q as *u8); }
    t
}

fn kept(n: i64) -> *i64 {
    let q = unsafe { calloc(1, 8) as *i64 };
    unsafe { *q = n; }
    q
}

fn escapes(n: i64) {
    let q = unsafe { malloc(8) as *i64 };
    unsafe { *q = n; }
    SAVED = q;
}

fn main() -> i32 {
    let k = kept(7);
    unsafe {
        printf(c"%ld %ld %ld\n", local_sum(10), zeroed(), *k);
        free(k as *u8);
    }
    var total = 0;
    for i in 0..3 {
        total += local_sum(i + 6) - i * 3;
    }
    unsafe { printf(c"%ld\n", total - 3); }
    escapes(5);
    unsafe { printf(c"%ld\n", *SAVED); }
    0
}
