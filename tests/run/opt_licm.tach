// Loop-invariant code moves out of the loop, without changing what loops
// that run zero times do (division never traps).
// EXPECT: 4950 6 0 0
// CHECK: fn sum_scaled:
// CHECK: mul
// CHECK: phi
// CHECK: fn main:
extern fn printf(format: *u8, ...) -> i32;

fn sum_scaled(n: i64, a: i64, b: i64) -> i64 {
    let mut total = 0;
    for i in 0..n {
        total += i * (a * b);
    }
    total
}

fn zero_trip(n: i64, d: i64) -> i64 {
    let mut total = 0;
    for i in 0..n {
        total += 100 / d + i;
    }
    total
}

fn main() -> i32 {
    // Taking its address keeps the function itself in the program.
    let keep = sum_scaled;
    let mut table: [i64; 4] = [1, 2, 3, 0];
    let mut acc = 0;
    for i in 0..3 {
        acc += table[2] * 2;
        table[3] = acc;
    }
    printf(c"%ld %ld %ld %ld\n", keep(100, 1, 1), table[3] / 3, zero_trip(0, 0), zero_trip(-5, 0));
    0
}
