// (0.25.1) `&v` given to a let `[T]`, T inferred from v: the `&` marks
// a change the callee cannot make, as for a plain `[i64]`.
// ERROR: '&' marks an argument the callee may change; 'v' is taken let or sink here
fn count<T>(xs: [T]) -> i64 { xs.len() }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    println(count(&v));
}
