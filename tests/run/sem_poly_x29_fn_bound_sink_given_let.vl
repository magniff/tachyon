// F: FnMut(sink R) given a closure taking let R: rejected, or R still dropped once
// ERROR: does not satisfy the bound
// XFAIL: DIAG a let-parameter closure for F: FnMut(sink R): 'expected R, got let R', try: *R
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn feed<F: FnMut(sink R) -> i64>(f: sink F) -> i64 { f(R { id: 1 }) }
fn main() { println(f"{feed(|r: R| r.id)}"); }
