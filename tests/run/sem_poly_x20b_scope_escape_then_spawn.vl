// the Scope returned out of thread::scope, then used to start a thread that is never joined
// ERROR: [sync.scope_spawn]: 's.spawn' is called outside the closure given to 'thread::sc
use std::thread;

fn main(gpa: Gpa) {
    var sc2 = thread::scope(|sc| sc);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(5);
        let s = v.as_slice();
        sc2.spawn(|| { thread::yield_now(); s[0] });
    }
    println("x");
}
