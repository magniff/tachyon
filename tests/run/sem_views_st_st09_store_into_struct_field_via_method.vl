// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a method stores a view into self (inout), caller grows the owner
// ERROR: error[own.conflict]
struct Names { list: Vec<str> }
impl Names { fn add(inout self, w: str) { self.list.push(w); } }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var n = Names { list: Vec::new_in(gpa) };
    n.add(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(n.list.get(0));
    0
}
