// (0.25) An owned temporary matched with no binding that takes a part of
// it (`E::A(_)`, a literal, `if let`) is dropped once, at the end of the
// statement (it was never dropped).
// FLAGS: --check-alloc
// EXPECT: in 5
// EXPECT: drop 5
// EXPECT: n
// EXPECT: drop 6
// EXPECT: if-let
// EXPECT: drop 7
// EXPECT: id 8
// EXPECT: drop 8
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
enum E { A(D), N(D) }
fn me(id: i64, gpa: Gpa) -> E { if id == 6 { E::N(mk(id, gpa)) } else { E::A(mk(id, gpa)) } }

fn main(gpa: Gpa) {
    match me(5, gpa) { E::A(_) => println("in 5"), E::N(_) => {} }
    match me(6, gpa) { E::A(_) => println("a"), E::N(_) => println("n") }
    if let E::A(_) = me(7, gpa) { println("if-let"); }
    match mk(8, gpa).id { 8 => println("id 8"), _ => {} }
    println("end");
}
