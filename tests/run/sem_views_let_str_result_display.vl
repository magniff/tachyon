// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md)
// A `-> let str` result (D21) used as its value: println(r) says "the
// trait 'Display' is not implemented for 'let str'". A let access is used
// as the value itself, so it prints. (Whether the projection is accepted
// at all is sem_views_pj_*; this is the message when the body is a place.)
// XFAIL: OVERSTRICT a '-> let str' result is not its value: 'Display' is not implemented for 'let str'
// EXPECT: hello
fn f(v: Vec<str>) -> let str { v[0] }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<str> = Vec::new_in(gpa);
    v.push("hello");
    let r = f(v);
    println(r);
    0
}
