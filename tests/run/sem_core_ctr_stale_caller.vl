// The caller's fact from an inlined requires goes stale after the callee clears the Vec.
// EXIT: 101
// STDERR: index out of bounds: index 2, length 0
static var Z: i64 = 0;

fn touch(v: inout Vec<i64>, i: i64)
    requires 0 <= i && i < v.len()
{
    v.clear();
}

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1); v.push(2); v.push(3);
    let i = 2 + Z;
    touch(&v, i);
    println(v[i]);
    0
}
