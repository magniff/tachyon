// 0.18.1: Rust's `m.get(&k)`, `v.contains(&x)` with a number: the
// reference is read through (a `&i64` where an `i64` is expected), as are
// a pattern's bindings on a reference.
// EXPECT: 30 true 8
enum E { A(i64), B }

fn twice(n: i64) -> i64 { n * 2 }

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(3, 30);
    let k = 3;
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(4);
    let x = 4;
    let e = E::A(4);
    let d = match &e { E::A(n) => twice(n), E::B => 0 };
    println(f"{m.get(&k).unwrap()} {v.contains(&x)} {d}");
}
