// a struct holding a raw pointer shared by let with scoped threads: sync.not_sync
// ERROR: [sync.not_sync]: a thread of 'thread::scope' shares 'w'
use std::thread;
struct P { p: *i64 }

fn main() {
    var k: i64 = 1;
    let w = P { p: &k as *i64 };
    thread::scope(|s| {
        s.spawn(|| { let q = w.p; 0 });
        0
    });
    println("ok");
}
