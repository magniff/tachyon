// a large plain var passed let while a closure argument writes it
// EXPECT: 101 5
struct B { x: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64 }
fn f<F: FnMut()>(p: B, w: F) -> i64 { let before = p.x; w(); before * 100 + p.x }
fn main() { var b = B { x: 1, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0 }; let r = f(b, || { b.x = 5; }); println(f"{r} {b.x}"); }
