// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `c()`; s grows while it is used
// XFAIL: SOUNDNESS a closure's result loses the views its capture holds: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); let c = || v[0];
    let r = c();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
