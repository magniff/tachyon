// 0.20: a sink closure owns its captures; its body may move one out (each
// has a flag): the closure's drop then skips it, and one never called, or
// that keeps its capture, drops it once. --check-alloc finds no leak and no
// double free.
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: drop 101
// EXPECT: once 101
// EXPECT: kept 2
// EXPECT: vec 1
// EXPECT: drop 3
// EXPECT: drop 2
struct R { id: i64 }

impl Drop for R {
    fn drop(inout self) { println(f"drop {self.id}"); }
}

impl Clone for R { fn clone(self) -> R { R { id: self.id + 100 } } }
fn call<F: FnMut() -> i64>(f: F) -> i64 { var g = f; g() }
fn call2<F: FnMut() -> i64>(f: F) -> i64 { var g = f; g() + g() }

fn main(gpa: Gpa) {
    let a = R { id: 1 };
    let r = call(sink || { let c = a.clone(); drop(a); c.id });
    println(f"once {r}");
    let b = R { id: 2 };
    let k = sink || { b.id };
    println(f"kept {k()}");
    let d = R { id: 3 };
    let u = sink || { drop(d); 0 };
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    let w = call(sink || { let n = v.len(); drop(v); n as i64 });
    println(f"vec {w}");
}
