// std::cli (0.24): every error, as cmd.exit(e) prints it: the error line,
// the try: line (a did-you-mean by edit distance, or the fix), then the
// usage line of the command it is about; and exit_code 2.
// EXPECT: $ tool --outt x
// EXPECT: error: unknown option '--outt'
// EXPECT: try: --out
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool --hepl
// EXPECT: error: unknown option '--hepl'
// EXPECT: try: --help
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool --verison
// EXPECT: error: unknown option '--verison'
// EXPECT: try: --version
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool --frobnicate
// EXPECT: error: unknown option '--frobnicate'
// EXPECT: try: --help
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool -verbose
// EXPECT: error: unknown option '-e' in '-verbose'
// EXPECT: try: --verbose
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool -vx
// EXPECT: error: unknown option '-x' in '-vx'
// EXPECT: try: --help
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool -x
// EXPECT: error: unknown option '-x'
// EXPECT: try: --help
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool stauts
// EXPECT: error: unknown command 'stauts'
// EXPECT: try: status
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownCommand 2]
// EXPECT: $ tool frobnicate
// EXPECT: error: unknown command 'frobnicate'
// EXPECT: try: --help
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownCommand 2]
// EXPECT: $ tool push extra
// EXPECT: error: unexpected argument 'extra'
// EXPECT: try: --help
// EXPECT: usage: tool push [options]
// EXPECT: [UnexpectedArgument 2]
// EXPECT: $ tool --out
// EXPECT: error: option '--out' needs a value
// EXPECT: try: --out <FILE>
// EXPECT: usage: tool [options] [command]
// EXPECT: [MissingValue 2]
// EXPECT: $ tool -vo
// EXPECT: error: option '-o' needs a value
// EXPECT: try: --out <FILE>
// EXPECT: usage: tool [options] [command]
// EXPECT: [MissingValue 2]
// EXPECT: $ tool --verbose=yes
// EXPECT: error: flag '--verbose' takes no value
// EXPECT: try: --verbose
// EXPECT: usage: tool [options] [command]
// EXPECT: [FlagValue 2]
// EXPECT: $ tool status p
// EXPECT: error: missing option '--format <FORMAT>'
// EXPECT: try: --format <FORMAT>
// EXPECT: usage: tool status [options] --format <FORMAT> <path>
// EXPECT: [MissingRequired 2]
// EXPECT: $ tool status --format=short
// EXPECT: error: missing argument '<path>'
// EXPECT: try: <path>
// EXPECT: usage: tool status [options] --format <FORMAT> <path>
// EXPECT: [MissingRequired 2]
// EXPECT: $ tool status --formt x
// EXPECT: error: unknown option '--formt'
// EXPECT: try: --format
// EXPECT: usage: tool status [options] --format <FORMAT> <path>
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool -n 3
// EXPECT: count=3
// EXPECT: $ tool -n three
// EXPECT: error: invalid value 'three' for '--count <COUNT>'
// EXPECT: try: --count <COUNT>
// EXPECT: usage: tool [options] [command]
use std::cli::{Arg, Command};

fn show(cmd: Command, line: str, gpa: Gpa) {
    println(f"$ {line}");
    match cmd.parse(line.split(' ')) {
        Ok(m) => match m.get_as::<i64>("count") {
            Ok(n) => println(f"count={n}"),
            Err(e) => print(cmd.render_in(e, gpa).as_slice()),
        },
        Err(e) => {
            print(cmd.render_in(e, gpa).as_slice());
            println(f"[{e.kind:?} {e.exit_code()}]");
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("tool", gpa).version("1.0")
        .arg(Arg::flag("verbose").short('v'))
        .arg(Arg::option("out").short('o').value_name("FILE"))
        .arg(Arg::option("count").short('n').default("1"))
        .subcommand(Command::new_in("status", gpa)
            .arg(Arg::option("format").required())
            .arg(Arg::positional("path").required()))
        .subcommand(Command::new_in("push", gpa));
    show(cmd, "tool --outt x", gpa);
    show(cmd, "tool --hepl", gpa);
    show(cmd, "tool --verison", gpa);
    show(cmd, "tool --frobnicate", gpa);
    show(cmd, "tool -verbose", gpa);
    show(cmd, "tool -vx", gpa);
    show(cmd, "tool -x", gpa);
    show(cmd, "tool stauts", gpa);
    show(cmd, "tool frobnicate", gpa);
    show(cmd, "tool push extra", gpa);
    show(cmd, "tool --out", gpa);
    show(cmd, "tool -vo", gpa);
    show(cmd, "tool --verbose=yes", gpa);
    show(cmd, "tool status p", gpa);
    show(cmd, "tool status --format=short", gpa);
    show(cmd, "tool status --formt x", gpa);
    show(cmd, "tool -n 3", gpa);
    show(cmd, "tool -n three", gpa);
    0
}
