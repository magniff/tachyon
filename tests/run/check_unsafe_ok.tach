// FLAGS: --check-unsafe
// EXPECT: 4950 99 128
// EXPECT: 120
// 0.10: well-behaved unsafe code runs unchanged under --check-unsafe:
// heap blocks grown, read through interior pointers and slices, freed and
// allocated again; the stack and statics are not checked.
extern "C" {
    fn printf(f: *u8, ...) -> i32;
    fn malloc(size: u64) -> *u8;
    fn realloc(p: *u8, size: u64) -> *u8;
    fn free(p: *u8);
}

static mut TABLE: [i64; 4] = [1, 2, 3, 4];

fn main(gpa: Gpa) -> i32 {
    let mut cap = 1;
    let mut p = unsafe { malloc(8) as *i64 };
    for i in 0..100 {
        if i == cap {
            cap *= 2;
            p = unsafe { realloc(p as *u8, (cap * 8) as u64) as *i64 };
        }
        unsafe { p[i] = i; }
    }
    let mid = unsafe { &p[50] as *i64 };
    let s = unsafe { p[0..100] };
    let mut t = 0;
    for x in s {
        t += x;
    }
    unsafe { printf(c"%ld %ld %ld\n", t, mid[49], cap); }
    unsafe { free(p as *u8); }
    let q = unsafe { malloc(8 * 5) as *i64 };
    let mut v = std::Vec::<i64>::new_in(gpa);
    for i in 1..6 {
        unsafe { q[i - 1] = i; }
        v.push(i);
    }
    let mut prod = 1;
    for i in 0..5 {
        unsafe { prod *= q[i]; }
    }
    let local = 7;
    let lp = &local as *i64;
    let tp = &TABLE[0] as *i64;
    unsafe { printf(c"%ld\n", prod + *lp * 0 + tp[3] * 0); }
    0
}
