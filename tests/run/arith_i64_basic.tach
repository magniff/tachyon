// i64 add/sub/mul/div/rem with mixed signs (C truncating semantics).
// EXPECT: 22 12 85 3 2
// EXPECT: -12 -22 -85 -3 -2
// EXPECT: 12 22 -85 -3 2
// EXPECT: -22 -12 85 3 -2
// EXPECT: 1998244360 1755654 998244359987710471 1 1755654
// EXPECT: -9223372036854775807 9223372036854775805 -2 4611686018427387903 1
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn show(a: i64, b: i64) {
    printf(c"%ld %ld %ld %ld %ld\n", a + b, a - b, a * b, a / b, a % b);
}

fn main() -> i64 {
    show(17, 5);
    show(-17, 5);
    show(17, -5);
    show(-17, -5);
    show(1000000007, 998244353);
    show(9223372036854775807, 2);
    0
}
