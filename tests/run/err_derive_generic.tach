// 0.15: on a generic type a field without the trait is found in the
// instance; the error is at the field.
// ERROR: the trait 'Hash' is not implemented for 'Vec<i64>'
// ERROR: in instantiation of 'G<i64>::hash'
// ERROR-COUNT: 1
use std::HashMap;

#[derive(Hash, Eq)]
struct G<T> { v: Vec<T> }

fn main(gpa: Gpa) {
    let mut m: HashMap<G<i64>, i64> = HashMap::new_in(gpa);
    m.insert(G { v: Vec::new_in(gpa) }, 1);
}
