// a sink closure capturing a let self of an owned type
// ERROR: [own.move_out]
// XFAIL: WRONG a sink closure 'capturing' a let self of an owned type borrows it
struct S { v: Vec<i64> }

impl S {
    fn n(self) -> i64 { let c = sink || self.v.len(); c() }
}

fn main(gpa: Gpa) {
    var s = S { v: Vec::new_in(gpa) };
    s.v.push(1);
    println(f"{s.n()} {s.v.len()}");
}
