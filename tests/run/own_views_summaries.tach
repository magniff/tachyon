// 0.17 (value semantics, T3): view summaries inferred callees first. Each
// call below is clean only because its callee's summary is precise, not
// one region: a parser method returning a view of its tokens' text is
// views(*self), so the parser can move on while the view lives; a
// recursive pair is views(s); intern stores into 'names' only, not into
// the map beside it (the type filter); a generic result (Vec::get) is the
// T value, not a loan on the Vec.
// FLAGS: --values=error
// EXPECT: ab cd
// EXPECT: yz 2
// EXPECT: ab 1
struct Tok { text: [u8], k: i64 }
struct Parser { toks: Vec<Tok>, pos: i64 }

impl Parser {
    fn name(self: &mut Parser) -> [u8] {
        let t = self.toks.get(self.pos);
        self.pos += 1;
        t.text
    }
}

fn even(n: i64, s: [u8]) -> [u8] {
    if n == 0 { s } else { odd(n - 1, s) }
}

fn odd(n: i64, s: [u8]) -> [u8] {
    if n == 0 { s[1..] } else { even(n - 1, s) }
}

fn intern(ids: &mut HashMap<[u8], i64>, names: &mut Vec<[u8]>, word: [u8]) -> i64 {
    match ids.get(word) {
        Some(i) => i,
        None => {
            names.push(word);
            ids.insert(word, names.len() - 1);
            names.len() - 1
        }
    }
}

fn main(gpa: Gpa) {
    let mut p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: "ab", k: 1 });
    p.toks.push(Tok { text: "cd", k: 1 });
    let a = p.name();
    let b = p.name();
    println(f"{a} {b}");
    let s = even(3, "xyz");
    let mut ids: HashMap<[u8], i64> = HashMap::new_in(gpa);
    let mut names: Vec<[u8]> = Vec::new_in(gpa);
    intern(&mut ids, &mut names, "ab");
    let n = intern(&mut ids, &mut names, "cd");
    println(f"{s} {ids.len()}");
    let first = names.get(0);
    intern(&mut ids, &mut names, "ab");
    println(f"{first} {n}");
}
