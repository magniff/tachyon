// a closure in a let-self method assigns self's field: rejected (self is let)
// ERROR: [type error]: cannot assign to immutable variable 'self'
struct P { x: i64 }

impl P {
    fn bad(self) -> i64 {
        let c = || { self.x += 1; };
        c();
        self.x
    }
}

fn main() {
    let p = P { x: 1 };
    println(f"{p.bad()} {p.x}");
}
