// (0.25, the semantics fuzzer) `let t = v.last()?;` in a function that
// borrows `v`: last() gives a borrowed copy of the element (0.17 T7), but
// the `?` lowering drops it as if it were owned, so the element is
// dropped there and again with the Vec (a double drop; with an element
// that owns memory, a use after free under --check-alloc). `.unwrap()`
// and `match` on the same Option are fine.
// EXPECT: q 1
// EXPECT: u 1
// EXPECT: m 1
// EXPECT: end
// EXPECT: d1
// EXPECT: live 0

static var LIVE: i64 = 0;
struct T { id: i64 }
fn mk(id: i64) -> T { LIVE += 1; T { id: id } }

impl Drop for T {
    fn drop(inout self) { LIVE -= 1; println(f"d{self.id}"); }
}

fn last_q(v: Vec<T>) -> Option<i64> {
    let t = v.last()?;
    Some(t.id)
}

fn last_u(v: Vec<T>) -> i64 {
    let t = v.last().unwrap();
    t.id
}

fn last_m(v: Vec<T>) -> i64 {
    match v.last() { Some(t) => t.id, None => 0 }
}

fn run(gpa: Gpa) {
    var v: Vec<T> = Vec::new_in(gpa);
    v.push(mk(1));
    println(f"q {last_q(v).unwrap_or(0)}");
    println(f"u {last_u(v)}");
    println(f"m {last_m(v)}");
    println("end");
}

fn main(gpa: Gpa) -> i32 {
    run(gpa);
    println(f"live {LIVE}");
    0
}
