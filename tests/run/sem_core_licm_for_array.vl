// A guarded array index in a counted for loop.
// FLAGS: -O2
// XFAIL: SOUNDNESS -O2 hoists the guarded element load above its bounds check (segfault)
// EXPECT: 0
static var Z: i64 = 0;



fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    let a = [1, 2, 3];
    var t = 0;
    for k in 0..5 + Z { if k > 100 { t += a[i]; } }
    println(t);
    0
}
