// Iterating over the bytes of a string to count and transform characters.
// EXPECT: HELLO, WORLD! 123
// EXPECT: 2 3
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn putchar(c: i32) -> i32;
}

fn main() -> i64 {
    let s = "Hello, World! 123";
    var i: u64 = 0;
    var upper = 0;
    var digits = 0;
    while i != (s.len as u64) {
        let c = unsafe { s.ptr[i] };
        if c >= 65 && c <= 90 { upper += 1; }
        if c >= 48 && c <= 57 { digits += 1; }
        if c >= 97 && c <= 122 { unsafe { putchar((c - 32) as i32); } }
        else { unsafe { putchar(c as i32); } }
        i += 1;
    }
    unsafe { printf(c"\n%ld %ld\n", upper, digits); }
    0
}
