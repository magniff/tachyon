// FLAGS: --target x86_64-linux
// ERROR: error[arch.feature_ambiguous]: 'aes' means x86_64.aes on x86_64-linux, but 'vaeseq_u8' needs aarch64.aes
// ERROR: --new '"aarch64.aes"'
// ERROR-COUNT: 1
// (0.19 T4) An unqualified feature of both architectures means the
// target's: on x86-64, detect("aes") guarding AArch64's vaeseq_u8 is
// arch.feature_ambiguous, with the qualified name as the fix.
use std::arch::{detect, has};
use std::arch::aarch64::{uint8x16_t, vaeseq_u8};

fn round(s: uint8x16_t, k: uint8x16_t) -> uint8x16_t {
    if detect("aes") {
        return vaeseq_u8(s, k);
    }
    s
}

fn main() {
    let z = v16u8::splat(0);
    if has("neon") {
        let r = round(z, z);
        println(f"{r.lane(0)}");
    }
}
