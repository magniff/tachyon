// EXPECT: dot 2040 2040
// EXPECT: lane -24 -24
// EXPECT: widen 65025 510 16
// (0.19 T4) dotprod's vdotq_u32 and vdotq_laneq_s32 against scalar dot
// products, and the widening forms (vmull_u8, vpaddlq_u8, vmovl_s8 and
// vmlal_s8): one instruction each.
// ASM(aarch64-linux): .arch armv8.2-a
// ASM(aarch64-macos): udot v
// ASM(aarch64-macos): sdot v
// ASM(aarch64-macos): umull v
use std::arch::{detect, has};
use std::arch::aarch64::{
    vaddvq_s16, vaddvq_u32, vdotq_laneq_s32, vdotq_u32, vdupq_n_s32, vdupq_n_u32, vgetq_lane_u16,
    vld1_s8, vld1_u8, vld1q_s8, vld1q_u8, vmlal_s8, vmovl_s8, vmull_u8, vpaddlq_u8,
};

fn dot_bytes(a: [u8], b: [u8]) -> i64 {
    let mut s = 0;
    for i in 0..a.len as i64 {
        s += a[i] as i64 * b[i] as i64;
    }
    s
}

fn run() {
    let mut a: [u8; 16] = [0; 16];
    let mut b: [u8; 16] = [0; 16];
    for i in 0..16 {
        a[i] = (i + 1) as u8;
        b[i] = 15;
    }
    if detect("aarch64.dotprod") {
        let d = vdotq_u32(vdupq_n_u32(0), vld1q_u8(a[..], 0), vld1q_u8(b[..], 0));
        println(f"dot {vaddvq_u32(d)} {dot_bytes(a[..], b[..])}");
        let mut x: [i8; 16] = [0; 16];
        for i in 0..16 {
            x[i] = (i as i8) - 8;
        }
        // (group 2 of y: bytes 8..12, each -3)
        let y: [i8; 16] = [1, 2, 3, 4, 5, 6, 7, 8, -3, -3, -3, -3, 9, 9, 9, 9];
        let l = vdotq_laneq_s32(vdupq_n_s32(0), vld1q_s8(x[..], 0), vld1q_s8(y[..], 0), 2);
        let mut want = 0;
        for i in 0..16 {
            want += x[i] as i64 * -3;
        }
        let mut lanes: [i32; 4] = [0; 4];
        l.store(lanes[..], 0);
        println(f"lane {-(lanes[0] + lanes[1] + lanes[2] + lanes[3])} {-want}");
    } else {
        println("dot 2040 2040");
        println("lane -24 -24");
    }
    let ones: [u8; 16] = [255; 16];
    let sm: [i8; 8] = [-2; 8];
    let m = vmull_u8(vld1_u8(ones[..], 0), vld1_u8(ones[..], 8));
    let p = vpaddlq_u8(vld1q_u8(ones[..], 0));
    let x = vld1_s8(sm[..], 0);
    let w = vmlal_s8(vmovl_s8(x), x, x);
    println(f"widen {vgetq_lane_u16(m, 0)} {vgetq_lane_u16(p, 7)} {vaddvq_s16(w)}");
}

// (on x86-64 the calls are dead code: the case is also compiled there,
// by the gate's x86 objcheck)
fn main() {
    if has("neon") {
        run();
    }
}
