// a scoped thread calls a closure that writes a var: sync.scope_shared_write
// ERROR: [sync.not_sync]
// ERROR: [sync.scope_write]
// ERROR: inout
// XFAIL: DIAG sync.not_sync calls a closure's inout capture 'a raw pointer at .n (*i64)'
use std::thread;

fn main() {
    var n = 0;
    let c = || { n += 1; };
    thread::scope(|s| {
        s.spawn(|| { c(); 0 });
        0
    });
    println(f"{n}");
}
