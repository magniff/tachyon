    let rt = 0i16 + z;
    let m = x / rt * rt;
    var sum = k85_one(x, rt);
    sum = sum * 31u64 + k85_one(m, rt);
    sum = sum * 31u64 + k85_one(m - 1i16, rt);
    sum = sum * 31u64 + k85_one(m + 1i16, rt);
    sum
}

