// 0.11: divisions and remainders by constants are multiplications by
// magic numbers (isel.vl), for every type and kind of constant,
// checked against divisions by the same numbers unknown to the compiler;
// x / 0 is 0, x % 0 is x, MIN / -1 is MIN.
// EXPECT: 5233184623069668826
// ASM(aarch64-macos): umulh
// ASM(aarch64-macos): smulh
// ASM(x86_64-linux): mulq
// ASM(x86_64-linux): imulq %
// Divisions by constants (0.11), made by tests/fuzz/gendiv.awk -v curated=1
// -v iterations=3000 -v seed=1.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

// u8 by 0u8
fn k0_one(x: u8, rt: u8) -> u64 {
    let q = x / 0u8;
    let r = x % 0u8;
    if q != x / rt || r != x % rt {
        unsafe {
            printf(c"FAIL k0 %ld: %ld %ld, %ld %ld\n", x as i64, q as i64, r as i64,
                (x / rt) as i64, (x % rt) as i64);
        }
    }
    (q as u64) * 7u64 + (r as u64)
}

fn k0(x: u8, z: u8) -> u64 {
    let rt = 0u8 + z;
    let m = x / rt * rt;
    var sum = k0_one(x, rt);
    sum = sum * 31u64 + k0_one(m, rt);
    sum = sum * 31u64 + k0_one(m - 1u8, rt);
    sum = sum * 31u64 + k0_one(m + 1u8, rt);
    sum
}

#[inline(never)]
fn k0_q(x: u8) -> u8 {
    x / 0u8
}

#[inline(never)]
fn k0_r(x: u8) -> u8 {
    x % 0u8
}

