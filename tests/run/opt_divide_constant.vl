        acc = acc * 31u64 + (k3_r(x as u8) as u64);
        acc = acc * 31u64 + (k3_q((x ^ 0x5555u64) as u8) as u64);
        acc = acc * 31u64 + k4(x as u8, z as u8);
        acc = acc * 31u64 + (k4_r(x as u8) as u64);
        acc = acc * 31u64 + (k4_q((x ^ 0x5555u64) as u8) as u64);
