// i16 by 0i16
fn k85_one(x: i16, rt: i16) -> u64 {
    let q = x / 0i16;
    let r = x % 0i16;
    if q != x / rt || r != x % rt {
        unsafe {
            printf(c"FAIL k85 %ld: %ld %ld, %ld %ld\n", x as i64, q as i64, r as i64,
                (x / rt) as i64, (x % rt) as i64);
        }
    }
    (q as u64) * 7u64 + (r as u64)
}

