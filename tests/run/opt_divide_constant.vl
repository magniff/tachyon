fn main() -> i32 {
    let z = unsafe { printf(c"") } as u64;
    let special: [u64; 24] = [0u64, 1u64, 2u64, 3u64, 0x7fu64, 0x80u64, 0xffu64, 0x7fffu64,
        0x8000u64, 0xffffu64, 0x7fffffffu64, 0x80000000u64, 0xffffffffu64, 0x7fffffffffffffffu64,
        0x8000000000000000u64, 0xffffffffffffffffu64, 0xfffffffffffffffeu64, 0x8000000000000001u64,
        0xffffffff80000000u64, 0xffffffffffff8000u64, 0xffffffffffffff80u64, 0x7ffffffeu64,
        0xfffffffeu64, 0x100000000u64];
    var state = 840188u64;
    var acc = 0u64;
    var i = 0;
    while i < 3000 {
        var x = 0u64;
        if i < 24 {
            x = special[i];
        } else {
            state = state * 6364136223846793005u64 + 1442695040888963407u64;
            x = state ^ (state >> 29u64);
            if i % 3 == 0 {
                x = x >> (state >> 58u64);
            }
