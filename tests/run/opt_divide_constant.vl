        acc = acc * 31u64 + k0(x as u8, z as u8);
        acc = acc * 31u64 + (k0_r(x as u8) as u64);
        acc = acc * 31u64 + (k0_q((x ^ 0x5555u64) as u8) as u64);
        acc = acc * 31u64 + k1(x as u8, z as u8);
        acc = acc * 31u64 + (k1_r(x as u8) as u64);
