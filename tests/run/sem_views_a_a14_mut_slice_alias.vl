// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: read v while mut slice live
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = v.as_mut_slice();
    println(v[0]);
    m[0] = 5;
    println(v[0]);
    0
}
