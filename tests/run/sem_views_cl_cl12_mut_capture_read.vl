// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: v read directly while a mutating closure is live
// XFAIL: WRONG a closure's mutating capture is not exclusive (v read, or a second mutating closure, while it is live)
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    var add = |x: i64| v.push(x);
    add(1);
    println(v.len());
    add(2);
    println(v.len());
    0
}
