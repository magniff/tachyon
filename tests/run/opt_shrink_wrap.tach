// Shrink-wrapping (0.6): the frame is set up only on the paths that need
// it. fib's base case returns before the frame is linked; `pick` only
// calls the panic of a failed bounds check, which links a frame of its own,
// so its normal path has none; `scan` leaves the frame's region through a
// return block shared with its frameless early exit. The last call panics
// from a function without a frame (x86-64 calls need an aligned stack).
// EXPECT: 55 0 1
// EXPECT: 30 7
// EXPECT: 10 0
// STDERR: index out of bounds: index 9, length 4
// EXIT: 101
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn pick(s: [i64], i: i64) -> i64 {
    s[i]
}

fn total(s: [i64]) -> i64 {
    let mut t = 0;
    for x in s {
        t += x;
    }
    t
}

fn scan(s: [i64], f: fn([i64]) -> i64) -> i64 {
    if s.len == 0 {
        return 0;
    }
    let mut acc = 0;
    let mut i = 0;
    while i < 2 {
        acc += f(s);
        i += 1;
    }
    acc / 2
}

fn main() -> i32 {
    let p: fn([i64], i64) -> i64 = pick;
    let sc: fn([i64], fn([i64]) -> i64) -> i64 = scan;
    let a: [i64; 4] = [1, 7, 2, 0];
    unsafe {
        printf(c"%ld %ld %ld\n", fib(10), fib(0), fib(1));
        printf(c"%ld %ld\n", sc(a[..], total) * 3, p(a[..], 1));
        printf(c"%ld %ld\n", sc(a[..], total), sc(a[0..0], total));
        printf(c"%ld\n", p(a[..], 9));
    }
    0
}

// ASM(aarch64-macos): fib:
// ASM(aarch64-macos): cmp x0, #2
// ASM-NOT(aarch64-macos): stp x29
// ASM(aarch64-macos): ret
// ASM(aarch64-macos): stp x29, x30
// ASM(aarch64-macos): pick:
// ASM-NOT(aarch64-macos): stp x29
// ASM(aarch64-macos): ret
// ASM(aarch64-macos): stp x29, x30
// ASM(aarch64-macos): bl
// ASM(x86_64-macos): pick:
// ASM-NOT(x86_64-macos): pushq %rbp
// ASM(x86_64-macos): ret
// ASM(x86_64-macos): pushq %rbp
// ASM(x86_64-macos): call
// ASM(x86_64-linux): pick:
// ASM-NOT(x86_64-linux): pushq %rbp
// ASM(x86_64-linux): ret
// ASM(x86_64-linux): pushq %rbp
// ASM(x86_64-linux): call
