// 0.16 T1: what a declaration names: effects (a typo gets the nearest
// name), allocator types (not a parameter: the try writes its type; not a
// type that is no allocator), allocators only for `alloc`; in bounds too.
// ERROR: unknown effect 'allocates' (effects: alloc, io, global, panic, diverge, unsafe)
// ERROR: help: did you mean 'alloc'?
// ERROR: effects name allocator types: 'arena' is a parameter
// ERROR: try: #[effects(alloc(Arena))]
// ERROR: only 'alloc' names allocators: 'io' takes none
// ERROR: 'i64' is not an allocator
// ERROR: unknown effect 'pnic'
// ERROR: unknown effect 'nothing'
// ERROR-COUNT: 6
#[effects(allocates)]
fn typo() {}

#[effects(alloc(arena))]
fn named(arena: *Arena) {}

#[effects(io(Gpa))]
fn badio() {}

#[effects(alloc(i64))]
fn notalloc() {}

fn bounded<F: Fn() + effects(pnic)>(f: F) { f() }

trait T {
    #[effects(nothing)]
    fn t(self: *Self);
}

fn main() {}
