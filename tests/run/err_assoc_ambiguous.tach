// ERROR: 'C::Out' is ambiguous: traits 'A' and 'B' both define it
// ERROR: the associated type 'Loop' of 'D' is defined in terms of itself
// 0.14: two traits giving a type the same associated name; a definition
// in terms of itself.
trait A {
    type Out;
    fn a(self) -> Self::Out;
}

trait B {
    type Out;
}

trait L {
    type Loop;
}

struct C { n: i64 }
struct D { n: i64 }

impl A for C {
    type Out = i64;

    fn a(self) -> i64 {
        self.n
    }
}

impl B for C {
    type Out = u8;
}

impl L for D {
    type Loop = Self::Loop;
}

fn out<T>(x: sink T) -> T::Out {
    x.a()
}

fn lp<T>(x: sink T) -> T::Loop {
    x.n
}

fn main() -> i32 {
    let c = C { n: 1 };
    let d = D { n: 1 };
    (out(c) + lp(d)) as i32
}
