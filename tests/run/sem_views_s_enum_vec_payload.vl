// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(e)`; s grows while it is used
// XFAIL: SOUNDNESS a function's view of what its parameter's elements or fields hold is lost (summary): use after free
// ERROR: error[own.conflict]
enum E { A(Vec<str>), B }
fn f(e: E) -> str { match e { E::A(x) => x[0], E::B => "" } }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var v: Vec<str> = Vec::new_in(gpa); v.push(w); let e = E::A(v);
    let r = f(e);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
