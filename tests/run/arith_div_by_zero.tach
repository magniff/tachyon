// Integer division by zero is not trapped: x / 0 is 0 and x % 0 is x, at
// every width and on every target (AArch64's divide instructions behave so;
// x86-64 reproduces it). The signed minimum divided by -1 wraps.
// EXPECT: 0 7 0 -7
// EXPECT: 0 7 0 4294967289
// EXPECT: 0 18446744073709551615
// EXPECT: -9223372036854775808 0
// EXPECT: -2147483648 0
// EXPECT: -128 0
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn zero() -> i64 { 0 }
fn minus_one() -> i64 { -1 }

fn main() -> i32 {
    let z = zero();
    let a: i64 = 7;
    let b: i64 = -7;
    printf(c"%ld %ld %ld %ld\n", a / z, a % z, b / z, b % z);
    let c: u32 = 7;
    let d: u32 = 4294967289;
    printf(c"%u %u %u %u\n", c / z as u32, c % z as u32, d / z as u32, d % z as u32);
    let e: u64 = 18446744073709551615;
    printf(c"%lu %lu\n", e / z as u64, e % z as u64);
    let m = minus_one();
    let min64: i64 = -9223372036854775807 - 1;
    printf(c"%ld %ld\n", min64 / m, min64 % m);
    let min32: i32 = -2147483647 - 1;
    printf(c"%d %d\n", min32 / m as i32, min32 % m as i32);
    let min8: i8 = -128;
    printf(c"%d %d\n", min8 / m as i8, min8 % m as i8);
    0
}
