// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 6 (Option<inout T> result)
// XFAIL: OVERSTRICT a binding of an Option<inout T> result is immutable: 'cannot assign to immutable variable'
// EXPECT: 6
fn find(v: inout Vec<i64>, x: i64) -> Option<inout i64> {
    for i in 0..v.len() { if v[i] == x { return Some(&v[i]); } }
    None
}
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    if let Some(r) = find(&v, 5) { r += 1; }
    println(v[0]);
    0
}
