// 0.17: a reference's kind is checked: `&x` where `&mut T` is wanted, a
// value where a reference is, a raw pointer where a reference is (the
// help says what to write; the first two are fixed by `fix --suggested`).
// ERROR: expected '&mut P', got '&P'
// ERROR: try: &mut p
// ERROR: expected '&mut P', got 'P'
// ERROR: try: &mut p
// ERROR: expected '&P', got '*P'
// ERROR: help: a raw pointer is not a reference
struct P { x: i64 }
fn bump(p: &mut P) { p.x += 1; }
fn rd(p: &P) -> i64 { p.x }

fn main() {
    let mut p = P { x: 1 };
    bump(&p);
    bump(p);
    let raw: *P = &p;
    rd(raw);
}
