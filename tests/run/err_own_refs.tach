// 0.17: a reference's kind is checked: a value where a reference is, a raw
// pointer where a reference is (the help says what to write; the first is
// fixed by `fix --suggested`). (0.20: `&x` where `&mut T` is wanted is the
// inout marker, conventions.md D7: accepted.)
// ERROR: expected '&mut P', got 'P'
// ERROR: try: &mut p
// ERROR: expected '&P', got '*P'
// ERROR: help: a raw pointer is not a reference
struct P { x: i64 }
fn bump(p: inout P) { p.x += 1; }
fn rd(p: P) -> i64 { p.x }

fn main() {
    var p = P { x: 1 };
    bump(&p);
    bump(p);
    let raw: *P = &p;
    rd(raw);
}
