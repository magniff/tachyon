// The e-graph's rewrite rules (0.9): each function's arithmetic reduces
// to what the CHECKs show (and the program's results agree at every
// level).
// EXPECT: 5 30 1 5 -4 1 30 2
// CHECK: fn cancel:
// CHECK-NOT: sub
// CHECK: ret
// CHECK: fn reassociate:
// CHECK: const 7
// CHECK: fn compare:
// CHECK: const 11
// CHECK-NOT: xor
// CHECK: fn absorb:
// CHECK-NOT: and
// CHECK: ret
// CHECK: fn negate:
// CHECK: neg
// CHECK-NOT: bnot
// CHECK: fn difference:
// CHECK-NOT: sub
// CHECK: cmp.eq
// CHECK: fn scale:
// CHECK: const 6
// CHECK-NOT: sub
// CHECK: ret
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

extern "C" fn cancel(x: i64, y: i64) -> i64 { (x + y) - y }
extern "C" fn reassociate(x: i64) -> i64 { ((x - 3) + 10) * 2 }
extern "C" fn compare(x: u8) -> bool { (x ^ 7) == 12 }
extern "C" fn absorb(x: i64, y: i64) -> i64 { (x | y) & x }
extern "C" fn negate(x: i32) -> i32 { ~x + 1 }
extern "C" fn difference(x: i64, y: i64) -> bool { x - y == 0 }
extern "C" fn scale(x: i64) -> i64 { x * 7 - x }
extern "C" fn wrap(x: u8) -> bool { x + 250 == 1 }

fn main() -> i32 {
    unsafe {
        printf(c"%ld %ld %d %ld %d %d %ld %d\n", cancel(5, 9), reassociate(8), compare(11) as i32,
            absorb(5, 2), negate(4), difference(3, 3) as i32, scale(5), wrap(7) as i32 + 1);
    }
    0
}
