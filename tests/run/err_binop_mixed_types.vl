// Operands of two integer types join to the wider one (0.15) only when
// one widens to the other: i32 and u32 do not (the help converts both to
// i64, which both widen to).
// ERROR: expected 'i32', got 'u32'
// ERROR: convert explicitly: '(a as i64) + (b as i64)'
fn main() -> i64 {
    let a: i32 = 1;
    let b: u32 = 2;
    let c = a + b;
    0
}
