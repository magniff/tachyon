// Byte-level pointer arithmetic on a malloc'd buffer and memcpy/memset.
// EXPECT: 32640 312a231c 21 249
extern fn printf(format: *u8, ...) -> i32;
extern fn malloc(n: u64) -> *u8;
extern fn free(p: *u8);
extern fn memset(p: *u8, c: i32, n: u64) -> *u8;
extern fn memcpy(d: *u8, s: *u8, n: u64) -> *u8;

fn at(p: *u8, i: u64) -> *u8 { (p as u64 + i) as *u8 }

fn main() -> i64 {
    let buf = malloc(256);
    memset(buf, 0, 256);
    let i: u64 = 0;
    loop {
        if i == 256 { break; };
        *at(buf, i) = (i * 7) as u8;
        i += 1;
    }
    let sum: u64 = 0;
    i = 0;
    loop {
        if i == 256 { break; };
        sum += *at(buf, i) as u64;
        i += 1;
    }
    let words = buf as *u32;
    let w = *((words as u64 + 4) as *u32);
    memcpy(at(buf, 100), buf, 8);
    printf("%lu %x %d %d\n".0, sum, w, *at(buf, 103), *at(buf, 255));
    free(buf);
    0
}
