// Byte-level pointer arithmetic on a malloc'd buffer and memcpy/memset.
// EXPECT: 32640 312a231c 21 249
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn malloc(n: u64) -> *u8;
    fn free(p: *u8);
    fn memset(p: *u8, c: i32, n: u64) -> *u8;
    fn memcpy(d: *u8, s: *u8, n: u64) -> *u8;
}

fn at(p: *u8, i: u64) -> *u8 { unsafe { (p as u64 + i) as *u8 } }

fn main() -> i64 {
    let buf = unsafe { malloc(256) };
    unsafe { memset(buf, 0, 256); }
    let mut i: u64 = 0;
    while i != 256 {
        unsafe { *at(buf, i) = (i * 7) as u8; }
        i += 1;
    }
    let mut sum: u64 = 0;
    i = 0;
    while i != 256 {
        unsafe { sum += *at(buf, i) as u64; }
        i += 1;
    }
    let words = buf as *u32;
    let w = unsafe { *((words as u64 + 4) as *u32) };
    unsafe {
        memcpy(at(buf, 100), buf, 8);
        printf(c"%lu %x %d %d\n", sum, w, *at(buf, 103), *at(buf, 255));
        free(buf);
    }
    0
}
