// the same store called directly: own.escape
// ERROR: [own.escape]: 'all' is used here, but 'v', which it views, was dropped
fn keep(dst: inout Vec<[i64]>, s: [i64]) { dst.push(s); }

fn main(gpa: Gpa) {
    var all: Vec<[i64]> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..10 { v.push(i + 100); }
        keep(&all, v.as_slice());
    }
    println(f"{all[0][3]}");
}
