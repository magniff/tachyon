// Array literals, indexing with computed indices, element assignment.
// EXPECT: 5 9 5 43
// EXPECT: 0.875 0
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: [i64; 5] = [5, 4, 3, 2, 1];
    let i = 0;
    let s = 0;
    loop {
        if i == 5 { break; };
        a[i] = a[i] * a[4 - i];
        s += a[i];
        i += 1;
    }
    printf("%ld %ld %ld %ld\n".0, a[0], a[2], a[4], s);
    let f: [f32; 3] = [0.5, 0.25, 0.125];
    let b: [u8; 4] = [255, 1, 2, 3];
    printf("%.3f %d\n".0, f[0] + f[1] + f[2], b[0] + b[1]);
    0
}
