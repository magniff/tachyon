// Array literals, indexing with computed indices, element assignment.
// EXPECT: 5 9 5 43
// EXPECT: 0.875 0
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let mut a: [i64; 5] = [5, 4, 3, 2, 1];
    let mut i = 0;
    let mut s = 0;
    while i != 5 {
        a[i] = a[i] * a[4 - i];
        s += a[i];
        i += 1;
    }
    unsafe { printf(c"%ld %ld %ld %ld\n", a[0], a[2], a[4], s); }
    let f: [f32; 3] = [0.5, 0.25, 0.125];
    let b: [u8; 4] = [255, 1, 2, 3];
    unsafe { printf(c"%.3f %d\n", f[0] + f[1] + f[2], b[0] + b[1]); }
    0
}
