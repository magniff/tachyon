// sem-own: an owned temporary in an if condition: dropped before the branch runs? (after the condition, as a statement temporary of the if).
// (a temporary lives to the end of its statement, here the whole if, as documented)
// EXPECT: yes
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    if mk(1, gpa).id == 1 { println("yes"); }
    println("end");
}
