// std::cli (0.24): flags, options, positionals, subcommands, clusters,
// `--`, defaults, required, typed values, repeats; each line is parsed
// from a string split at spaces (the program's name first).
// EXPECT: prog a => v=0 q=false out=none in=a rest= tags=0 jobs=4
// EXPECT: prog -v a b c => v=1 q=false out=none in=a rest=b,c tags=0 jobs=4
// EXPECT: prog -vvq a => v=2 q=true out=none in=a rest= tags=0 jobs=4
// EXPECT: prog -vqo f a => v=1 q=true out=f in=a rest= tags=0 jobs=4
// EXPECT: prog -vofile a => v=1 q=false out=file in=a rest= tags=0 jobs=4
// EXPECT: prog -o=file a => v=0 q=false out=file in=a rest= tags=0 jobs=4
// EXPECT: prog --out f a --out g => v=0 q=false out=g in=a rest= tags=0 jobs=4
// EXPECT: prog --out=x=y a => v=0 q=false out=x=y in=a rest= tags=0 jobs=4
// EXPECT: prog a -t x --tag y -tz => v=0 q=false out=none in=a rest= tags=3 jobs=4
// EXPECT: prog --jobs 8 a => v=0 q=false out=none in=a rest= tags=0 jobs=8
// EXPECT: prog -j -3 a => v=0 q=false out=none in=a rest= tags=0 jobs=-3
// EXPECT: prog -j=12 a => v=0 q=false out=none in=a rest= tags=0 jobs=12
// EXPECT: prog --jobs many a => v=0 q=false out=none in=a rest= tags=0 jobs-err=InvalidValue
// EXPECT: prog -- -v --out => v=0 q=false out=none in=-v rest=--out tags=0 jobs=4
// EXPECT: prog a -- -q => v=0 q=false out=none in=a rest=-q tags=0 jobs=4
// EXPECT: prog - - => v=0 q=false out=none in=- rest=- tags=0 jobs=4
// EXPECT: prog a add => v=0 q=false out=none in=a rest= tags=0 jobs=4 sub=add force=false what=0
// EXPECT: prog a add -f x y => v=0 q=false out=none in=a rest= tags=0 jobs=4 sub=add force=true what=2
// EXPECT: prog a add -- -f => v=0 q=false out=none in=a rest= tags=0 jobs=4 sub=add force=false what=1
// EXPECT: prog a add -v => UnknownOption '-v' code 2
// EXPECT: prog => MissingRequired '' code 2
// EXPECT: prog a --out => MissingValue '--out' code 2
// EXPECT: prog --help => Help '--help' code 0
// EXPECT: prog a add -h => Help '-h' code 0
// EXPECT: prog -V => Version '-V' code 0
// EXPECT: prog --version => Version '--version' code 0
use std::cli::{Arg, CliError, Command, Matches};

fn show(m: Matches) {
    print(f"v={m.count("verbose")} q={m.flag("quiet")}");
    match m.get("out") {
        Some(o) => print(f" out={o}"),
        None => print(" out=none"),
    }
    print(f" in={m.get("input").unwrap_or("-")} rest=");
    for (i, r) in m.values("rest").iter().enumerate() {
        print(if i > 0 { "," } else { "" });
        print(r);
    }
    print(f" tags={m.values("tag").len()}");
    match m.get_as::<i64>("jobs") {
        Ok(n) => print(f" jobs={n}"),
        Err(e) => print(f" jobs-err={e.kind:?}"),
    }
    match m.subcommand() {
        Some((name, sub)) => {
            print(f" sub={name}");
            if name == "add" {
                print(f" force={sub.flag("force")} what={sub.values("what").len()}");
            }
        }
        None => {}
    }
    println("");
}

fn run(cmd: Command, line: str) {
    print(f"{line} => ");
    match cmd.parse(line.split(' ')) {
        Ok(m) => show(m),
        Err(e) => println(f"{e.kind:?} '{e.text}' code {e.exit_code()}"),
    }
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("prog", gpa).version("0.1")
        .arg(Arg::flag("verbose").short('v'))
        .arg(Arg::flag("quiet").short('q'))
        .arg(Arg::option("out").short('o'))
        .arg(Arg::option("tag").short('t'))
        .arg(Arg::option("jobs").short('j').default("4"))
        .arg(Arg::positional("input").required())
        .arg(Arg::positional("rest").multiple())
        .subcommand(Command::new_in("add", gpa)
            .arg(Arg::flag("force").short('f'))
            .arg(Arg::positional("what").multiple()));
    run(cmd, "prog a");
    run(cmd, "prog -v a b c");
    run(cmd, "prog -vvq a");
    run(cmd, "prog -vqo f a");
    run(cmd, "prog -vofile a");
    run(cmd, "prog -o=file a");
    run(cmd, "prog --out f a --out g");
    run(cmd, "prog --out=x=y a");
    run(cmd, "prog a -t x --tag y -tz");
    run(cmd, "prog --jobs 8 a");
    run(cmd, "prog -j -3 a");
    run(cmd, "prog -j=12 a");
    run(cmd, "prog --jobs many a");
    run(cmd, "prog -- -v --out");
    run(cmd, "prog a -- -q");
    run(cmd, "prog - -");
    run(cmd, "prog a add");
    run(cmd, "prog a add -f x y");
    run(cmd, "prog a add -- -f");
    run(cmd, "prog a add -v");
    run(cmd, "prog");
    run(cmd, "prog a --out");
    run(cmd, "prog --help");
    run(cmd, "prog a add -h");
    run(cmd, "prog -V");
    run(cmd, "prog --version");
    0
}
