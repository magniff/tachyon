// (0.20 D1) The Swiss table's tag match: NEON's (exact, on AArch64)
// against the SWAR one, on random groups and tags: every true match is
// in both, and the SWAR one's extra bits are false positives only (bytes
// that are not the tag), so a table's layout is the same with either.
// EXPECT: ok 0 0
use std::collections::group::{match_tag, match_tag_swar};

fn xorshift(x: inout u64) -> u64 {
    var v = x;
    v ^= v << 13;
    v ^= v >> 7;
    v ^= v << 17;
    x = v;
    v
}

fn main() {
    var rng = 0x2545f4914f6cdd1du64;
    var missing = 0;
    var wrong = 0;
    for _ in 0..1000000 {
        // (bytes drawn near the tag, to make matches and borrows common)
        let tag = (xorshift(&rng) & 0x7f) as u8;
        var g = 0u64;
        for b in 0..8 {
            let r = xorshift(&rng) % 6;
            let byte = if r == 0 { tag as u64 } else if r == 1 { (tag ^ 1) as u64 }
                else if r == 2 { 0xff } else if r == 3 { 0x80 } else { xorshift(&rng) & 0x7f };
            g |= byte << (8 * b) as u64;
        }
        let n = match_tag(g, tag);
        let s = match_tag_swar(g, tag);
        for b in 0..8 {
            let byte = ((g >> (8 * b) as u64) & 0xff) as u8;
            let bit = 0x80u64 << (8 * b) as u64;
            let is = byte == tag;
            if is != ((n & bit) != 0) {
                wrong += 1;
            }
            if is && (s & bit) == 0 {
                missing += 1;
            }
            if !is && (s & bit) != 0 && byte & 0x80 != 0 {
                wrong += 1;
            }
        }
    }
    println(f"ok {missing} {wrong}");
}
