// EXPECT: 30 2
// EXPECT: 5
// EXPECT: 9
// 0.14: an associated type of a generic impl (`type Item = T;` for
// `Each<T>`), resolved per instance; `Self::Item` in an impl's own
// signature; a projection through another projection, `Pairs<I>`'s Item
// being `(I::Item, I::Item)`.
use std::print_int;

struct Each<T> { s: [T], pos: i64 }

impl<T> Iterator for Each<T> {
    type Item = T;

    fn next(self: *Each<T>) -> Option<Self::Item> {
        if self.pos == self.s.len {
            return None;
        }
        self.pos += 1;
        Some(self.s[self.pos - 1])
    }
}

struct Pairs<I> { it: I }

impl<I: Iterator> Iterator for Pairs<I> {
    type Item = (I::Item, I::Item);

    fn next(self: *Pairs<I>) -> Option<(I::Item, I::Item)> {
        let a = self.it.next();
        let b = self.it.next();
        match (a, b) {
            (Some(x), Some(y)) => Some((x, y)),
            _ => None,
        }
    }
}

fn first<I: Iterator>(it: I) -> Option<I::Item> {
    let mut it = it;
    it.next()
}

fn main() -> i32 {
    let a: [i64; 3] = [10, 20, 30];
    let b: [u8; 2] = [7, 9];
    print_int(Each { s: a[0..3], pos: 2 }.next().unwrap());
    print(" ");
    print_int(Each { s: b[0..2], pos: 0 }.count());
    println("");
    let p = first(Pairs { it: Each { s: a[0..3], pos: 0 } }).unwrap();
    print_int(p.1 / p.0 + 3);
    println("");
    let q = first(Pairs { it: Each { s: b[0..2], pos: 0 } }).unwrap();
    print_int(q.1 as i64);
    println("");
    0
}
