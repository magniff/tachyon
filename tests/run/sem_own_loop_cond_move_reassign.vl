// sem-own: moved on some iterations and assigned again then; the old value is
// dropped by the assignment when not moved.
// EXPECT: eat 0
// EXPECT: drop 0
// EXPECT: drop 10
// EXPECT: eat 11
// EXPECT: drop 11
// EXPECT: end
// EXPECT: drop 12
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var d = mk(0, gpa);
    for i in 0..3 {
        if i != 1 { eat(d); }
        d = mk(10 + i, gpa);
    }
    println("end");
}
