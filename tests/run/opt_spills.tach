// More live values than registers: spills on both targets, values live
// across calls (callee-saved registers, or spill slots for floats on
// x86-64), and parallel moves with cycles (swaps and rotations in loops).
// EXPECT: 2064 499
// EXPECT: 3 1 2
// EXPECT: 15.500000
extern fn printf(format: *u8, ...) -> i32;

fn id(x: i64) -> i64 { x }
fn fid(x: f64) -> f64 { x }

fn many(seed: i64) -> i64 {
    let a0 = seed + 0; let a1 = seed + 1; let a2 = seed + 2; let a3 = seed + 3;
    let a4 = seed + 4; let a5 = seed + 5; let a6 = seed + 6; let a7 = seed + 7;
    let a8 = seed + 8; let a9 = seed + 9; let a10 = seed + 10; let a11 = seed + 11;
    let a12 = seed + 12; let a13 = seed + 13; let a14 = seed + 14; let a15 = seed + 15;
    let a16 = seed + 16; let a17 = seed + 17; let a18 = seed + 18; let a19 = seed + 19;
    let a20 = seed + 20; let a21 = seed + 21; let a22 = seed + 22; let a23 = seed + 23;
    let a24 = seed + 24; let a25 = seed + 25; let a26 = seed + 26; let a27 = seed + 27;
    let a28 = seed + 28; let a29 = seed + 29; let a30 = seed + 30; let a31 = seed + 31;
    let mid = id(a0) + id(a31);
    mid + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15
        + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23 + a24 + a25 + a26 + a27 + a28 + a29
        + a30 + a31 - 31 - 31
}

fn rotate(n: i64) {
    let mut a = 1;
    let mut b = 2;
    let mut c = 3;
    for _ in 0..n {
        let t = a;
        a = b;
        b = c;
        c = t;
    }
    let mut x = 10;
    let mut y = 20;
    for _ in 0..n {
        let t = x;
        x = y;
        y = t;
    }
    printf(c"%ld %ld %ld\n", a + (x - x), b, c + (y - y));
}

fn floats(x: f64) -> f64 {
    let a = x + 1.0;
    let b = x + 2.0;
    let c = x + 3.0;
    let d = fid(a) + fid(b);
    d + c + a - b
}

fn main() -> i32 {
    let mut t = 0;
    for i in 0..4 { t += many(i); }
    // many(seed) == 34 * seed + 465
    printf(c"%ld %ld\n", t, many(1));
    rotate(5);
    printf(c"%f\n", floats(3.5));
    0
}
