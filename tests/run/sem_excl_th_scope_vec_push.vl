// ERROR: sync
use std::thread;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    thread::scope(|s| {
        let a = s.spawn(|| { for i in 0..1000 { v.push(i); } 0 });
        let b = s.spawn(|| { for i in 0..1000 { v.push(i); } 0 }); a.join() + b.join()
    }); println(f"{v.len()}");
}
