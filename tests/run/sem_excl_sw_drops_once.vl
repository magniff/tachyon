// swapping two Drop values: each dropped once, at the end, in reverse declaration order
// EXPECT: swapped
// EXPECT: drop 1
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn main() { var a = D { id: 1 }; var b = D { id: 2 }; std::swap(&a, &b); println("swapped"); }
