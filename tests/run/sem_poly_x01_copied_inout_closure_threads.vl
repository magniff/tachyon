// a closure with an inout capture copied, each copy moved into its own scoped thread: a race on n
// ERROR: [sync.not_sync]: a thread of 'thread::scope' shares 'a'
// ERROR: [sync.not_sync]: a thread of 'thread::scope' shares 'b'
use std::thread;

fn main() {
    var n = 0;
    let a = || { n += 1; };
    let b = a;
    thread::scope(|s| {
        s.spawn(sink || { for _ in 0..100000 { a(); } 0 });
        s.spawn(sink || { for _ in 0..100000 { b(); } 0 });
        0
    });
    println(f"{n}");
}
