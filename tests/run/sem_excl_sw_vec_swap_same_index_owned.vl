// swap(i, i) on owned elements: no double drop
// EXPECT: 1 2
fn main(gpa: Gpa) { var v: Vec<Vec<i64>> = Vec::new_in(gpa); var a: Vec<i64> = Vec::new_in(gpa); a.push(0); v.push(a); var b: Vec<i64> = Vec::new_in(gpa); b.push(0); b.push(0); v.push(b); v.swap(1, 1); v.swap(0, 1); v.swap(0, 1); println(f"{v[0].len()} {v[1].len()}"); }
