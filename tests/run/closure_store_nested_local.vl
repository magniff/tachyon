// nested closure stores a local of the inner closure into a capture of the outer
// ERROR: [own.escape]: the closure stores a view of 's'
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    var saved: Vec<str> = Vec::new_in(gpa);
    let f = |x: i64| {
        let g = |y: i64| { let s = String::from_in("inner", gpa); saved.push(s.as_str()); y };
        g(x)
    };
    f(1);
    println(f"{saved:?}");
}
