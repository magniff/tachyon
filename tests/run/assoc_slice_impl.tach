// EXPECT: 20 b
// EXPECT: 3 2
// EXPECT: 6
// 0.14: impls for slices: `impl<T> [T] { ... }` (methods of every slice
// type) and `impl<T> Tr for [T]`.
use std::print_int;

impl<T>[T] {
    fn second(self: [T]) -> T {
        self[1]
    }

    fn count_if_len(self: [T], n: i64) -> i64 {
        if self.len == n { 1 } else { 0 }
    }
}

trait Size {
    fn size(self) -> i64;

    fn twice(self) -> i64 {
        2 * self.size()
    }
}

impl<T> Size for [T] {
    fn size(self: [T]) -> i64 {
        self.len
    }
}

fn size_of_it<S: Size>(s: sink S) -> i64 {
    s.size()
}

fn main() -> i32 {
    let a: [i64; 3] = [10, 20, 30];
    let s = a[0..3];
    let t = "abc";
    print_int(s.second());
    print(" ");
    let b = [t.second()];
    print(b[0..1]);
    println("");
    print_int(s.size());
    print(" ");
    print_int(size_of_it(t[0..2]));
    println("");
    print_int(s.twice() + s.count_if_len(3) - 1);
    println("");
    0
}
