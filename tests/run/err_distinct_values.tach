// (0.18 with 0.17's values) A distinct type is over a plain type only
// (distinct.kind): not over a reference (a view: copying it would copy a
// loan the own pass no longer sees), nor over a type that owns by its
// Drop impl (copies would drop it twice).
struct Handle { fd: i64 }

impl Drop for Handle {
    fn drop(inout self) {
        println(f"close {self.fd}");
    }
}

type Ref = distinct let i64;
type Mut = distinct inout i64;
type File = distinct Handle;

fn main() -> i32 {
    0
}
// ERROR: a distinct type is over a plain type: '&i64' views memory
// ERROR: a distinct type is over a plain type: '&mut i64' views memory
// ERROR: a distinct type is over a plain type: 'Handle' owns memory
// ERROR-COUNT: 3
