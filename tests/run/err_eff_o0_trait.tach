// 0.16: at -O0, a trait method's declaration binds the impls.
// FLAGS: -O0
// ERROR: 'K::key' implements 'Key::key', which is #[pure], but it uses a static (global)
// ERROR-COUNT: 1
static var SEEN: i64 = 0;

trait Key {
    #[pure]
    fn key(self) -> u64;
}

struct K { v: i64 }

impl Key for K {
    fn key(self) -> u64 {
        unsafe { SEEN += 1; }
        self.v as u64
    }
}

fn main() {
    let k = K { v: 1 };
    println(f"{k.key()}");
}
