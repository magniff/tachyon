// Insertion sort of an array of structs by a float key, stable for ties.
// EXPECT: 2B 6F 4D 1A 3C 5E
extern fn printf(format: *u8, ...) -> i32;

struct Item { key: f64, id: i32, tag: u8 }

fn main() -> i64 {
    let mut items: [Item; 6] = [
        Item { key: 3.5, id: 1, tag: 65 },
        Item { key: -1.0, id: 2, tag: 66 },
        Item { key: 3.5, id: 3, tag: 67 },
        Item { key: 0.0, id: 4, tag: 68 },
        Item { key: 10.25, id: 5, tag: 69 },
        Item { key: -1.0, id: 6, tag: 70 }
    ];
    let mut i = 1;
    while i != 6 {
        let cur = items[i];
        let mut j = i - 1;
        while j >= 0 {
            if items[j].key <= cur.key { break; }
            items[j + 1] = items[j];
            j -= 1;
        }
        items[j + 1] = cur;
        i += 1;
    }
    i = 0;
    while i != 6 {
        printf(c"%d%c ", items[i].id, items[i].tag);
        i += 1;
    }
    printf(c"\n");
    0
}
