// a generic over a trait returning a view: per instance the result views the argument
// ERROR: [own.conflict]: 's.v.push(i)' may change 's' while 'h'
trait H { fn data(self) -> [i64]; }
struct S { v: Vec<i64> }
impl H for S { fn data(self) -> [i64] { self.v.as_slice() } }
fn get<T: H>(t: T) -> [i64] { t.data() }

fn main(gpa: Gpa) {
    var s = S { v: Vec::new_in(gpa) };
    s.v.push(1);
    let h = get(s);
    for i in 0..100 { s.v.push(i); }
    println(f"{h[0]}");
}
