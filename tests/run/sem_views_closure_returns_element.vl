// (0.25 semantics audit, views) A closure that captures a Vec of views
// and returns an element returns a view of what the element views:
// `let c = || v.get(0); c()` views s. A closure returning a captured
// `str` directly (`|| w`) is caught.
// XFAIL: SOUNDNESS a closure's result loses the views its captured Vec holds: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    let c = || v.get(0);
    let r = c();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
