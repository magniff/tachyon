// libc's qsort calling back into a tachyon comparison function.
// EXPECT: 99 42 7 7 5 0 -3 -100
extern fn printf(format: *u8, ...) -> i32;
extern fn qsort(base: *u8, n: u64, size: u64, cmp: fn(*u8, *u8) -> i32);

fn by_value_desc(a: *u8, b: *u8) -> i32 {
    let x = *(a as *i64);
    let y = *(b as *i64);
    if x < y { 1 } else { if x > y { -1 } else { 0 } }
}

fn main() -> i64 {
    let data: [i64; 8] = [5, -3, 99, 0, 42, -100, 7, 7];
    qsort(&data as *u8, 8, 8, by_value_desc);
    printf("%ld %ld %ld %ld %ld %ld %ld %ld\n".0, data[0], data[1], data[2], data[3], data[4], data[5], data[6], data[7]);
    0
}
