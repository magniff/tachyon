// PROFILE: 0.10, profile-guided optimization
// EXPECT: 1744074573318737656
// The profile moves the rare way of `work` out of the fall-through, and
// makes the hot call of `mix` (too big for a loop's call site otherwise)
// inlined.
// ASM(aarch64-macos): _vole.work:
// ASM(aarch64-macos): b.eq
// ASM(aarch64-macos): lsl x
// ASM(aarch64-macos): ret
// ASM(aarch64-macos): bl _vole.slow
// ASM(x86_64-macos): _vole.work:
// ASM(x86_64-macos): je
// ASM(x86_64-macos): ret
// ASM(x86_64-macos): call _vole.slow
// CHECK: fn main:
// CHECK-NOT: call mix
// CHECK: ret
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

#[inline(never)]
fn slow(x: i64) -> i64 {
    var s = 0;
    for i in 0..x % 13 {
        s += i * x;
    }
    s
}

// A rare branch: with the profile, the common way falls through.
#[inline(never)]
fn work(x: i64) -> i64 {
    var r = x;
    if x % 1000 == 7 {
        r = slow(x) + 3;
    } else {
        r = r * 2 + 1;
    }
    r
}

// Too big for a call site in a loop without a profile; hot with it.
fn mix(x: i64, y: i64) -> i64 {
    var t = x;
    t = t * 31 + y;
    t = t ^ (t >> 7);
    t = t + (t << 3);
    t = t - x * y;
    t = t ^ (t >> 11);
    t = t * 7 + 1;
    t = t * 31 + y;
    t = t ^ (t >> 7);
    t = t + (t << 3);
    t = t - x * y;
    t = t ^ (t >> 11);
    t = t * 7 + 1;
    t = t * 31 + y;
    t = t ^ (t >> 7);
    t = t + (t << 3);
    t = t - x * y;
    t = t ^ (t >> 11);
    t = t * 7 + 1;
    t = t * 31 + y;
    t = t ^ (t >> 7);
    t = t + (t << 3);
    t = t - x * y;
    t = t ^ (t >> 11);
    t = t * 7 + 1;
    t = t * 31 + y;
    t = t ^ (t >> 7);
    t = t + (t << 3);
    t = t - x * y;
    t = t ^ (t >> 11);
    t = t * 7 + 1;
    t = t * 31 + y;
    t = t ^ (t >> 7);
    t = t + (t << 3);
    t = t - x * y;
    t = t ^ (t >> 11);
    t = t * 7 + 1;
    if t % 3 == 0 { t / 3 } else if t % 5 == 0 { t / 5 } else { t - 1 }
}

fn main() -> i32 {
    var total = 0;
    for i in 0..200000 {
        total += work(i);
    }
    for i in 0..100000 {
        total += mix(i, total & 255);
    }
    total += mix(total, 3);
    unsafe { printf(c"%ld\n", total); }
    0
}
