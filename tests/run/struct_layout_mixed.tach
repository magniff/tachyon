// Fields of different sizes and alignments are laid out and read back
// without clobbering their neighbours.
// EXPECT: 1 -2 65535 1.50 255 0.25 -7 1
// EXPECT: 9 -2 1 1.50 0 0.25 -7 0
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct M { a: u8, b: i64, c: u16, d: f32, e: u8, f: f64, g: i32, h: bool }

fn main() -> i64 {
    var m = M { a: 1, b: 0 - 2, c: 65535, d: 1.5, e: 255, f: 0.25, g: 0 - 7, h: true };
    unsafe { printf(c"%d %ld %d %.2f %d %.2f %d %d\n", m.a, m.b, m.c, m.d, m.e, m.f, m.g, m.h); }
    m.a = 9;
    m.e = 0;
    m.h = false;
    m.c = 1;
    unsafe { printf(c"%d %ld %d %.2f %d %.2f %d %d\n", m.a, m.b, m.c, m.d, m.e, m.f, m.g, m.h); }
    0
}
