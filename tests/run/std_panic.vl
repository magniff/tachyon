// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
// EXPECT: before
// A Vec's get is checked like a slice's index (exit 101).
use std::Vec;

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i32> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    unsafe { std::print_cstr(c"before\n"); }
    v.get(3)
}
