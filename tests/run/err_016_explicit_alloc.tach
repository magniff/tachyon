// 0.16: allocation is explicit: std's constructors of 0.15 that took an
// allocator from nowhere are errors, with the `_in` form to write.
// FLAGS: --no-ambient-gpa
// ERROR: allocation is explicit: pass an allocator (try: Vec::new_in(gpa))
// ERROR: allocation is explicit: pass an allocator (try: collect_in(gpa))
// ERROR: allocation is explicit: pass an allocator (try: format_in(x, gpa))
// ERROR: allocation is explicit: pass an allocator (try: HashMap::new_in(gpa))
// ERROR: allocation is explicit: pass an allocator (try: Buf::new_in(gpa))
// ERROR: allocation is explicit: pass an allocator (try: Vec::with_capacity_in(cap, gpa))
// ERROR: allocation is explicit: pass an allocator (try: a 'gpa: Gpa' parameter, from main's)
fn main() {
    let v: Vec<i64> = Vec::new();
    let w: Vec<i64> = (0..3).collect();
    let b = std::format(1);
    let m: std::HashMap<i64, i64> = std::HashMap::new();
    let x = std::Buf::new();
    let y: Vec<i64> = Vec::with_capacity(3);
    let g = Gpa::ambient();
}
