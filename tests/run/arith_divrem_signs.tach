// Signed division truncates toward zero and the remainder takes the
// dividend's sign, at every width.
// EXPECT: i8 3 1 -3 -1 -3 1 3 -1
// EXPECT: i16 142 6 -142 -6 -142 6 142 -6
// EXPECT: i32 3030 10 -3030 -10 -3030 10 3030 -10
// EXPECT: i64 30030030 10 -30030030 -10 -30030030 10 30030030 -10
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a8: i8 = 7;
    let b8: i8 = 2;
    let na8: i8 = (0 - 7) as i8;
    let nb8: i8 = (0 - 2) as i8;
    printf("i8 %d %d %d %d %d %d %d %d\n".0, a8 / b8, a8 % b8, na8 / b8, na8 % b8, a8 / nb8, a8 % nb8, na8 / nb8, na8 % nb8);
    let a16: i16 = 1000;
    let b16: i16 = 7;
    let na16: i16 = (0 - 1000) as i16;
    let nb16: i16 = (0 - 7) as i16;
    printf("i16 %d %d %d %d %d %d %d %d\n".0, a16 / b16, a16 % b16, na16 / b16, na16 % b16, a16 / nb16, a16 % nb16, na16 / nb16, na16 % nb16);
    let a32: i32 = 100000;
    let b32: i32 = 33;
    let na32: i32 = (0 - 100000) as i32;
    let nb32: i32 = (0 - 33) as i32;
    printf("i32 %d %d %d %d %d %d %d %d\n".0, a32 / b32, a32 % b32, na32 / b32, na32 % b32, a32 / nb32, a32 % nb32, na32 / nb32, na32 % nb32);
    let a64: i64 = 10000000000;
    let b64: i64 = 333;
    printf("i64 %ld %ld %ld %ld %ld %ld %ld %ld\n".0, a64 / b64, a64 % b64, (0 - a64) / b64, (0 - a64) % b64, a64 / (0 - b64), a64 % (0 - b64), (0 - a64) / (0 - b64), (0 - a64) % (0 - b64));
    0
}
