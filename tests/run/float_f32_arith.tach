// f32 arithmetic rounds to single precision (promoted to double for printf).
// EXPECT: 0.30000001192092896 -0.10000000149011612 0.020000001415610313 0.5
// EXPECT: 16777216 16777215
// EXPECT: 0.3333333432674408
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: f32 = 0.1;
    let b: f32 = 0.2;
    unsafe { printf(c"%.17g %.17g %.17g %.17g\n", a + b, a - b, a * b, a / b); }
    let c: f32 = 16777216.0;
    let one: f32 = 1.0;
    unsafe { printf(c"%.17g %.17g\n", c + one, c - one); }
    let x: f32 = 3.0;
    unsafe { printf(c"%.17g\n", one / x); }
    0
}
