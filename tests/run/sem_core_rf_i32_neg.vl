// i < 3 for a negative i32 index.
// EXIT: 101
// STDERR: index out of bounds: index -5, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64], i: i32) -> i64 { if i < 3 { s[i] } else { 0 } }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s, (-5 + Z) as i32));
    0
}
