// (0.16) std's count_ones, leading_zeros and trailing_zeros: the 1 bits
// of a u64, the zeros above its highest 1, below its lowest (64 for 0).
// On AArch64 the optimizer makes each an instruction or two (cnt over the
// bytes and addv, clz, rbit and clz); elsewhere, and at -O0, their bodies
// count by halves. A u32 widens.
// EXPECT: 0 64 64
// EXPECT: 1 63 0
// EXPECT: 1 0 63
// EXPECT: 8 48 8
// EXPECT: 64 0 0
// EXPECT: 27 20 1
// EXPECT: 1 23 40
// EXPECT: 3 61 0
// EXPECT: 7219389657248 73
// ASM(aarch64-macos): _vole.counts:
// ASM(aarch64-macos): cnt v31.8b, v31.8b
// ASM(aarch64-macos): addv b31, v31.8b
// ASM(aarch64-macos): clz
// ASM(aarch64-macos): rbit
// ASM(aarch64-macos): clz
// ASM(aarch64-macos): ret
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

fn counts(x: u64) -> i64 {
    let a = std::count_ones(x);
    let b = std::leading_zeros(x);
    let c = std::trailing_zeros(x);
    unsafe { printf(c"%ld %ld %ld\n", a, b, c); }
    a * 7 + b * 3 + c
}

fn main() -> i32 {
    let f = counts;
    let xs: [u64; 8] = [0, 1, 0x8000000000000000, 0xff00, 0xffffffffffffffff, 12345678901234,
        1 << 40, 7];
    var h: i64 = 0;
    for x in xs {
        h = h * 31 + f(x);
    }
    // (constants: folded)
    let m: u32 = 0xf0f0;
    let n = std::count_ones(m) + std::trailing_zeros(m) + std::leading_zeros(5);
    unsafe { printf(c"%ld %ld\n", h, n); }
    0
}
