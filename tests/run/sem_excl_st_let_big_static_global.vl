// a large plain static passed let (a copy, D5) to a function that writes the static
// EXPECT: 101 5
struct B { x: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64 }
static var G: B = B { x: 1, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0, h: 0 };
fn f(p: B) -> i64 { let before = p.x; G.x = 5; before * 100 + p.x }
fn main() { let r = f(G); println(f"{r} {G.x}"); }
