// FLAGS: -C target-cpu=generic
// ERROR: arch.multiversion]: '__crc32cd' needs crc, which the baseline version of #[multiversion] 'step' lacks
// ERROR-COUNT: 1
// (0.19 T3) Every version of a #[multiversion] function compiles the same
// body: an intrinsic call that only the crc version can make must be under
// has("crc"), else it is an error in the versions without it (reported
// once, naming one).
use std::arch::aarch64::__crc32cd;

#[multiversion("crc")]
fn step(c: u32, x: u64) -> u32 {
    __crc32cd(c, x)
}

fn main() {
    println(f"{step(1, 2)}");
}
