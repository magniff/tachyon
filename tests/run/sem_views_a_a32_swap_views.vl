// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: std::swap of two views moves the loan
// XFAIL: OVERSTRICT std::swap of two [T] locals fails inside std: expected '*[i64]', got 'inout inout [i64]'
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    let u: Vec<i64> = Vec::new_in(gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var a: [i64] = v.as_slice();
    var b: [i64] = u.as_slice();
    std::swap(&a, &b);
    v.push(2);
    println(b[0]);
    0
}
