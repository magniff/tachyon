// A temporary with a printing Drop, dropped at the end of a statement in a #[no_io] function.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(inout self) { println("dropped"); } }

fn make(n: i64) -> Noisy { Noisy { n: n } }

#[no_io]
fn quiet(x: i64) -> i64 { make(x).n }

fn main() -> i32 {
    println(quiet(3));
    0
}
