// Small functions and functions called once are inlined; recursive ones
// are not inlined into themselves (and recursion still works). fact's
// recursion, in tail position with an accumulator, becomes a loop (and
// then fact is inlined like any small function).
// EXPECT: 25 120 55 1 0 3
// CHECK: fn is_even:
// CHECK: call is_odd
// CHECK: fn main:
// CHECK-NOT: call square
// CHECK-NOT: call once
// CHECK-NOT: call fact
// CHECK: call is_odd
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn square(x: i64) -> i64 { x * x }

fn once(a: i64) -> i64 {
    let mut s = 0;
    for i in 0..a + 1 { s += i; }
    s
}

fn fact(n: i64) -> i64 { if n <= 1 { 1 } else { n * fact(n - 1) } }

fn is_even(n: i64) -> bool { if n == 0 { true } else { is_odd(n - 1) } }
fn is_odd(n: i64) -> bool { if n == 0 { false } else { is_even(n - 1) } }

fn pair() -> (i64, i64) { (1, 2) }

fn main() -> i32 {
    let p = pair();
    printf(c"%ld %ld %ld %d %d %ld\n", square(5), fact(5), once(10), is_even(10) as i32,
           is_odd(10) as i32, p.0 + p.1);
    0
}
