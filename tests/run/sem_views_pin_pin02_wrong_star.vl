// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.views: pinned views(*self) but returns a view of self
// ERROR: error[own.views]
struct L { src: Buf }
impl L { #[views(*self)] fn all(self) -> [u8] { self.src.as_slice() } }
fn main(gpa: Gpa) -> i32 { var b = Buf::new_in(gpa); b.push_str("x"); let l = L { src: b }; println(l.all()); 0 }
