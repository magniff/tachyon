// fn(T) and fn(let T) are one type: assigned both ways, compared, passed
// FLAGS: --check-alloc
// EXPECT: 1 1 1 1
fn len(v: Vec<i64>) -> i64 { v.len() }
fn lenl(v: Vec<i64>) -> i64 { v.len() }
fn run(f: fn(Vec<i64>) -> i64, v: Vec<i64>) -> i64 { f(v) }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let a: fn(Vec<i64>) -> i64 = lenl;
    let b: fn(Vec<i64>) -> i64 = len;
    var c = a;
    c = b;
    println(f"{run(len, v)} {run(lenl, v)} {c(v)} {v.len()}");
}
