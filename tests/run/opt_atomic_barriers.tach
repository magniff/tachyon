// (0.21) Atomics and fences are barriers for shared memory
// (docs/design/concurrency.md §4.2): a plain store before a release is
// kept and stays before it, a plain load after an acquire stays after it
// and is not forwarded from before, two acquire loads are not merged, a
// spin loop's load is not hoisted, and a store before a fence is not
// dead though the location is stored again after it.
// CHECK: fn publish
// CHECK: store
// CHECK: atomic.store.release
// CHECK: fn consume
// CHECK: atomic.load.acquire
// CHECK: load
// CHECK: fn reread
// CHECK: store
// CHECK: atomic.load.acquire
// CHECK: load
// CHECK: fn twice
// CHECK: atomic.load.acquire
// CHECK: atomic.load.acquire
// CHECK: fn overwrite
// CHECK: store
// CHECK: fence.seqcst
// CHECK: store
// EXPECT: 42 2 7 5

use std::sync::atomic::{AtomicBool, AtomicI64, Ordering, fence};

static mut DATA: i64 = 0;
static mut READY: AtomicBool = AtomicBool { v: false };
static mut SEQ: AtomicI64 = AtomicI64 { v: 0 };

#[inline(never)]
fn publish(x: i64) {
    DATA = x;
    READY.store(true, Ordering::Release);
}

#[inline(never)]
fn consume() -> i64 {
    while !READY.load(Ordering::Acquire) {}
    DATA
}

#[inline(never)]
fn reread() -> i64 {
    DATA = 5;
    READY.load(Ordering::Acquire);
    DATA
}

#[inline(never)]
fn twice() -> i64 {
    SEQ.load(Ordering::Acquire) + SEQ.load(Ordering::Acquire)
}

#[inline(never)]
fn overwrite() {
    DATA = 1;
    fence(Ordering::SeqCst);
    DATA = 2;
}

fn main() {
    publish(42);
    let a = consume();
    overwrite();
    SEQ.store(3, Ordering::Relaxed);
    let b = DATA;
    println(f"{a} {b} {twice() + 1} {reread()}");
}
