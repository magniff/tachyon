// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text stored with `o.unwrap()`; s grows while it is used
// ERROR: error[own.conflict]
fn fill(s: inout [str], x: str) { for i in 0..s.len() { s[i] = x; } }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var o: Option<str> = None; o = Some(w);
    let r = o.unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
