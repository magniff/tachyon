// 0.14: in `a[i]`, `a[lo..hi]` and a vector load or store, the base `a`
// is evaluated first to its location, then the index or bounds, and only
// then is what `a` holds read (a slice's pointer and length, a pointer).
// An index that grows the table `a` views and re-takes the view is seen:
// nothing reads the old storage. `move_table` stands for the realloc that
// moves a table: it copies the elements to a new Vec, poisons the old one
// (99) and keeps it, so a read of the old storage shows as 99.
use std::Buf;

static mut V: Vec<i64> = Vec { ptr: 0 as *i64, len: 0, cap: 0, alloc: Gpa {} };
static mut OLD: Vec<Vec<i64>> = Vec { ptr: 0 as *Vec<i64>, len: 0, cap: 0, alloc: Gpa {} };
static mut BYTES: Vec<u8> = Vec { ptr: 0 as *u8, len: 0, cap: 0, alloc: Gpa {} };
static mut S: [u8] = "";
static mut SS: [[u8]; 2] = ["", ""];
static mut P: *u8 = 0 as *u8;

struct Table { view: [i64], pad: i64 }

fn reset(t: *Table, gpa: Gpa) {
    V = Vec::new_in(gpa);
    for x in 0..8 { V.push(10 + x); }
    BYTES = Vec::new_in(gpa);
    for x in 0..8 { BYTES.push(20 + x as u8); }
    t.view = V.as_slice();
    S = BYTES.as_slice();
    SS[1] = BYTES.as_slice();
    P = BYTES.ptr;
}

// Moves the tables (the old storage poisoned and kept), re-takes every
// view of them; returns k.
fn move_table(t: *Table, k: i64, gpa: Gpa) -> i64 {
    let mut w: Vec<i64> = Vec::new_in(gpa);
    for x in V { w.push(x); }
    for i in 0..V.len() { V.set(i, 99); }
    OLD.push(V);
    V = w;
    t.view = V.as_slice();
    let mut b: Vec<u8> = Vec::new_in(gpa);
    for x in BYTES { b.push(x); }
    for i in 0..BYTES.len() { BYTES.set(i, 99); }
    BYTES = b;
    S = BYTES.as_slice();
    SS[1] = BYTES.as_slice();
    P = BYTES.ptr;
    k
}

fn via_param(t: *Table, gpa: Gpa) -> i64 { t.view[move_table(t, 2, gpa)] }

fn main(gpa: Gpa) -> i32 {
    let mut out = Buf::new_in(gpa);
    let mut t = Table { view: V.as_slice(), pad: 0 };
    defer out.free();
    reset(&t, gpa);
    out.push_int(t.view[move_table(&t, 1, gpa)]);
    reset(&t, gpa);
    out.push(' ');
    out.push_int(via_param(&t, gpa));
    reset(&t, gpa);
    t.view[move_table(&t, 3, gpa)] = 7;
    out.push(' ');
    out.push_int(V.get(3));
    reset(&t, gpa);
    t.view[move_table(&t, 4, gpa)] += 100;
    out.push(' ');
    out.push_int(V.get(4));
    println(out.as_slice());
    out.clear();

    // Slicing: the bounds, then the slice.
    reset(&t, gpa);
    out.push_int(S[move_table(&t, 1, gpa)..][0] as i64);
    reset(&t, gpa);
    out.push(' ');
    out.push_int(S[..move_table(&t, 3, gpa)][2] as i64);
    reset(&t, gpa);
    out.push(' ');
    out.push_int(S[move_table(&t, 1, gpa)..move_table(&t, 4, gpa)][1] as i64);
    reset(&t, gpa);
    out.push(' ');
    out.push_int(t.view[move_table(&t, 2, gpa)..=5][0]);
    reset(&t, gpa);
    out.push(' ');
    out.push_int(SS[1][move_table(&t, 5, gpa)] as i64);
    reset(&t, gpa);
    out.push(' ');
    out.push_int(SS[1][move_table(&t, 5, gpa)..][1] as i64);
    println(out.as_slice());
    out.clear();

    // A local view re-taken inside the index.
    let mut v: Vec<i64> = Vec::new_in(gpa);
    defer v.free();
    for x in 0..4 { v.push(x); }
    let mut s = v.as_slice();
    let a = s[{
        for x in 0..1000 { v.push(x); }
        s = v.as_slice();
        3
    }];
    let b = s[{
        for x in 0..1000 { v.push(x); }
        s = v.as_slice();
        1
    } ..3][1];
    out.push_int(a);
    out.push(' ');
    out.push_int(b);
    println(out.as_slice());
    out.clear();

    // Vector loads and stores: s, the index, then s's pointer and length.
    reset(&t, gpa);
    out.push_int(v2i64::load(t.view, move_table(&t, 2, gpa)).sum());
    reset(&t, gpa);
    v2i64::splat(5).store(t.view, move_table(&t, 6, gpa));
    out.push(' ');
    out.push_int(V.get(6) + V.get(7));
    println(out.as_slice());
    out.clear();

    // Raw pointers (unsafe code) the same: the pointer is read after the index.
    reset(&t, gpa);
    out.push_int(unsafe { P[move_table(&t, 3, gpa)] } as i64);
    reset(&t, gpa);
    unsafe { P[move_table(&t, 0, gpa)] = 1; }
    out.push(' ');
    out.push_int(BYTES.get(0) as i64);
    reset(&t, gpa);
    unsafe { P[move_table(&t, 1, gpa)] += 1; }
    out.push(' ');
    out.push_int(BYTES.get(1) as i64);
    reset(&t, gpa);
    out.push(' ');
    out.push_int(unsafe { P[move_table(&t, 2, gpa)..move_table(&t, 4, gpa)] } [1] as i64);
    let mut q = BYTES.ptr;
    out.push(' ');
    out.push_int(unsafe {
        q[{
            move_table(&t, 0, gpa);
            q = BYTES.ptr;
            5
        }]
    } as i64);
    println(out.as_slice());
    0
}

// EXPECT: 11 12 7 114
// EXPECT: 21 22 22 12 25 26
// EXPECT: 3 2
// EXPECT: 25 10
// EXPECT: 23 1 22 23 25
