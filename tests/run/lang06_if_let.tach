// 0.6: `if let` and `while let`, with refutable and irrefutable patterns,
// else-if chains, labels, break and continue.
// EXPECT: 1103 5 18
use std::{Option, Vec};

enum Shape { Circle(f64), Rect(f64, f64), Empty }

fn area(s: Shape) -> f64 {
    if let Shape::Circle(r) = s { 3.0 * r * r } else if let Shape::Rect(w, h) = s { w * h } else { 0.0 }
}

fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    for i in 0..5 { v.push(i * 10); }
    let mut total = 0;
    while let Option::Some(x) = v.pop() { total += x; }
    let mut n = 0;
    outer: while let Option::Some(k) = Option::Some(n) {
        n += 1;
        if k > 3 { break :outer; }
        if k == 1 { continue; }
    }
    let t = (1, 2);
    if let (a, b) = t { total += a + b; }
    if let 103 = total { total += 1000; }
    std::print_int(total); unsafe { std::print_cstr(c" "); }
    std::print_int(n); unsafe { std::print_cstr(c" "); }
    std::print_int((area(Shape::Circle(2.0)) + area(Shape::Rect(2.0, 3.0)) + area(Shape::Empty)) as i64);
    unsafe { std::print_cstr(c"\n"); }
    0
}
