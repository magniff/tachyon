// 0.17: a program's own names hide the prelude's new ones (the prelude
// comes last); declaring them loads no std (tests/query/prelude017.q).
fn trim(x: i64) -> i64 { x - 1 }

fn panic(code: i64) -> i64 { code * 2 }

struct Buf { n: i64 }

fn main() -> i32 {
    let split = 3;
    let b = Buf { n: 2 };
    (trim(split) + panic(b.n) - 6) as i32
}
