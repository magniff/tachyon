// Methods and associated functions: impl blocks, self by value and by
// pointer, automatic & and *, Self, T::f(), methods on enums, fields
// through pointers.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct Vec2 { x: f64, y: f64 }

impl Vec2 {
    fn new(x: f64, y: f64) -> Self {
        Self { x: x, y: y }
    }

    fn zero() -> Vec2 {
        Vec2::new(0.0, 0.0)
    }

    fn dot(self: Vec2, other: Vec2) -> f64 {
        self.x * other.x + self.y * other.y
    }

    fn scale(self: *Vec2, k: f64) {
        self.x *= k;
        self.y = self.y * k;
    }

    fn scaled(self: Vec2, k: f64) -> Vec2 {
        let mut v = self;
        v.scale(k);
        v
    }
}

struct Counter { n: i64 }

impl Counter {
    fn bump(self: *Counter) -> i64 {
        (*self).n += 1;
        self.n
    }
}

enum Light { Red, Yellow, Green }

impl Light {
    fn next(self: Light) -> Light {
        match self {
            Light::Red => Light::Green,
            Light::Green => Light::Yellow,
            Light::Yellow => Light::Red,
        }
    }

    fn code(self: *Light) -> i64 {
        *self as i64
    }
}

fn main() {
    let mut a = Vec2::new(1.0, 2.0);
    let b = Vec2 { x: 3.0, y: 4.0 };
    unsafe { printf(c"%.1f\n", a.dot(b)); }
    a.scale(2.0);
    unsafe { printf(c"%.1f %.1f\n", a.x, a.y); }
    let p = &a as *Vec2;
    unsafe {
        p.scale(0.5);
        printf(c"%.1f %.1f %.1f\n", p.x, p.dot(b), Vec2::dot(a, a));
    }
    let c = b.scaled(10.0);
    unsafe {
        printf(c"%.1f %.1f %.1f\n", c.x, c.y, Vec2::zero().dot(c));
        printf(c"%.1f\n", Vec2::new(2.0, 0.5).scaled(4.0).dot(Vec2::new(1.0, 1.0)));
    }
    let mut k = Counter { n: 0 };
    k.bump();
    k.bump();
    let kp = &k as *Counter;
    unsafe { printf(c"%ld %ld\n", kp.bump(), k.n); }
    let mut l = Light::Red;
    for _ in 0..4 {
        unsafe { printf(c"%ld,", l.code()); }
        l = l.next();
    }
    unsafe { printf(c"\n"); }
    let f = Vec2::dot;
    unsafe { printf(c"%.1f\n", f(b, b)); }
}

// EXPECT: 11.0
// EXPECT: 2.0 4.0
// EXPECT: 1.0 11.0 5.0
// EXPECT: 30.0 40.0 0.0
// EXPECT: 10.0
// EXPECT: 3 3
// EXPECT: 0,2,1,0,
// EXPECT: 25.0
