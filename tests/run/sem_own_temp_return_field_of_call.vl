// sem-own: a field moved out of a temporary: the rest dropped, the field once.
// EXPECT: drop 2
// EXPECT: got 1
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct P { a: D, b: D }
fn mp(gpa: Gpa) -> P { P { a: mk(1, gpa), b: mk(2, gpa) } }

fn main(gpa: Gpa) {
    let a = mp(gpa).a;
    println(f"got {a.id}");
}
