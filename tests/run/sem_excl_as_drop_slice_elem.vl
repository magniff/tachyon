// XFAIL: SOUNDNESS s[0] = x through an inout [D] does not drop the old element (a leak)
// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn put(s: inout [D]) { s[0] = D { id: 2 }; }
fn main(gpa: Gpa) { var v: Vec<D> = Vec::new_in(gpa); v.push(D { id: 1 }); put(&v); println("after"); }
