// A slice range out of bounds: exits with 101.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() {
    let a: [u8; 4] = [1, 2, 3, 4];
    var lo: u64 = 1;
    let s = a[lo..4];
    unsafe { printf(c"%lu\n", s.len); }
    lo = 3;
    let t = a[lo..2];
    unsafe { printf(c"%lu\n", t.len); }
}

// EXPECT: 3
// EXIT: 101
// STDERR: slice range out of bounds: 3..2, length 4
