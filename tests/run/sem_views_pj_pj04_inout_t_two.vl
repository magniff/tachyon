// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: two inout projections of v live
// ERROR: error[own.escape]
fn top(v: inout Vec<i64>) -> inout i64 { &v[0] }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    inout a = top(&v);
    inout b = top(&v);
    a += 1;
    b += 1;
    println(v[0]);
    0
}
