// Infinities, NaN and signed zero from arithmetic.
// EXPECT: inf -inf 1
// EXPECT: 1 0
// EXPECT: -0 -inf 1
// EXPECT: inf 0
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let zero: f64 = 0.0;
    let one: f64 = 1.0;
    let inf = one / zero;
    let ninf = -one / zero;
    let nan = zero / zero;
    printf("%f %f %d\n".0, inf, ninf, nan != nan);
    printf("%d %d\n".0, inf - inf != inf - inf, inf * zero == inf * zero);
    let nz = -zero;
    printf("%g %g %d\n".0, nz, one / nz, nz == zero);
    let z32: f32 = 0.0;
    let o32: f32 = 1.0;
    printf("%f %d\n".0, o32 / z32, z32 / z32 == z32 / z32);
    0
}
