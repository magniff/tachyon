// (0.19) Every 0.10 vector operation on the new 128-bit vector types (unsigned
// lanes, 64-bit and 256-bit vectors: docs/design/arch.md §2.2), every lane
// printed: the same answers at every level (-O0 computes lane by lane).
// Unsigned lanes compare unsigned (cmhi, cmhs) and widen with umov.
// CROSS: x86_64-linux
fn main() {
    let V16u8a = v16u8(0, 254, 3, 1, 128, 200, 255, 127, 0, 254, 3, 1, 128, 200, 255, 127);
    let V16u8b = v16u8(127, 0, 254, 3, 1, 128, 200, 255, 127, 0, 254, 3, 1, 128, 200, 255);
    { let r = V16u8a + V16u8b; print("v16u8 +:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V16u8a - V16u8b; print("v16u8 -:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V16u8a * V16u8b; print("v16u8 *:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V16u8a & V16u8b; print("v16u8 &:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V16u8a | V16u8b; print("v16u8 |:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V16u8a ^ V16u8b; print("v16u8 ^:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V16u8a == V16u8b); print("v16u8 ==:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V16u8a != V16u8b); print("v16u8 !=:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V16u8a < V16u8b); print("v16u8 <:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V16u8a <= V16u8b); print("v16u8 <=:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V16u8a > V16u8b); print("v16u8 >:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V16u8a >= V16u8b); print("v16u8 >=:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V16u8a; print("v16u8 neg:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V16u8a < V16u8b).select(V16u8a, V16u8b); print("v16u8 sel:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    println(f"v16u8 sum {V16u8a.sum()} {V16u8b.sum()} lane {V16u8a.lane(15)} {V16u8a.lane(0)}");
    { let r = v16u8::splat(V16u8b.lane(15)); print("v16u8 splat:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V16u8a.with_lane(15, V16u8b.lane(0)); print("v16u8 with:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let mut k = 0; let mut s = 0 as u8;
        while k < 16 { s = s + V16u8b.lane(k); k += 1; } let w = V16u8a.with_lane(k - 1, s);
        print("v16u8 var:"); for i in 0..16 { print(f" {w.lane(i)}"); } println(""); }
    { let mut arr: [u8; 18] = [0 as u8; 18]; V16u8a.store(arr, 1);
        let r = v16u8::load(arr, 1) + v16u8::load(arr[0..18], 2); print("v16u8 mem:");
        for i in 0..16 { print(f" {r.lane(i)}"); } println(""); }
    { let mut c = V16u8a; c += V16u8b; c *= V16u8b; print("v16u8 acc:");
        for i in 0..16 { print(f" {c.lane(i)}"); } println(""); }
    let V8u16a = v8u16(0, 65534, 3, 1, 32768, 200, 65535, 32767);
    let V8u16b = v8u16(32767, 0, 65534, 3, 1, 32768, 200, 65535);
    { let r = V8u16a + V8u16b; print("v8u16 +:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8u16a - V8u16b; print("v8u16 -:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8u16a * V8u16b; print("v8u16 *:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8u16a & V8u16b; print("v8u16 &:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8u16a | V8u16b; print("v8u16 |:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8u16a ^ V8u16b; print("v8u16 ^:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8u16a == V8u16b); print("v8u16 ==:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8u16a != V8u16b); print("v8u16 !=:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8u16a < V8u16b); print("v8u16 <:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8u16a <= V8u16b); print("v8u16 <=:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8u16a > V8u16b); print("v8u16 >:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8u16a >= V8u16b); print("v8u16 >=:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V8u16a; print("v8u16 neg:"); for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8u16a < V8u16b).select(V8u16a, V8u16b); print("v8u16 sel:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    println(f"v8u16 sum {V8u16a.sum()} {V8u16b.sum()} lane {V8u16a.lane(7)} {V8u16a.lane(0)}");
    { let r = v8u16::splat(V8u16b.lane(7)); print("v8u16 splat:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8u16a.with_lane(7, V8u16b.lane(0)); print("v8u16 with:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let mut k = 0; let mut s = 0 as u16;
        while k < 8 { s = s + V8u16b.lane(k); k += 1; } let w = V8u16a.with_lane(k - 1, s);
        print("v8u16 var:"); for i in 0..8 { print(f" {w.lane(i)}"); } println(""); }
    { let mut arr: [u16; 10] = [0 as u16; 10]; V8u16a.store(arr, 1);
        let r = v8u16::load(arr, 1) + v8u16::load(arr[0..10], 2); print("v8u16 mem:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let mut c = V8u16a; c += V8u16b; c *= V8u16b; print("v8u16 acc:");
        for i in 0..8 { print(f" {c.lane(i)}"); } println(""); }
    let V4u32a = v4u32(0, 4294967294, 3, 1);
    let V4u32b = v4u32(2147483647, 0, 4294967294, 3);
    { let r = V4u32a + V4u32b; print("v4u32 +:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4u32a - V4u32b; print("v4u32 -:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4u32a * V4u32b; print("v4u32 *:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4u32a & V4u32b; print("v4u32 &:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4u32a | V4u32b; print("v4u32 |:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4u32a ^ V4u32b; print("v4u32 ^:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4u32a == V4u32b); print("v4u32 ==:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4u32a != V4u32b); print("v4u32 !=:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4u32a < V4u32b); print("v4u32 <:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4u32a <= V4u32b); print("v4u32 <=:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4u32a > V4u32b); print("v4u32 >:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4u32a >= V4u32b); print("v4u32 >=:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V4u32a; print("v4u32 neg:"); for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4u32a < V4u32b).select(V4u32a, V4u32b); print("v4u32 sel:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    println(f"v4u32 sum {V4u32a.sum()} {V4u32b.sum()} lane {V4u32a.lane(3)} {V4u32a.lane(0)}");
    { let r = v4u32::splat(V4u32b.lane(3)); print("v4u32 splat:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4u32a.with_lane(3, V4u32b.lane(0)); print("v4u32 with:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let mut k = 0; let mut s = 0 as u32;
        while k < 4 { s = s + V4u32b.lane(k); k += 1; } let w = V4u32a.with_lane(k - 1, s);
        print("v4u32 var:"); for i in 0..4 { print(f" {w.lane(i)}"); } println(""); }
    { let mut arr: [u32; 6] = [0 as u32; 6]; V4u32a.store(arr, 1);
        let r = v4u32::load(arr, 1) + v4u32::load(arr[0..6], 2); print("v4u32 mem:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let mut c = V4u32a; c += V4u32b; c *= V4u32b; print("v4u32 acc:");
        for i in 0..4 { print(f" {c.lane(i)}"); } println(""); }
    let V2u64a = v2u64(0, 18446744073709551614);
    let V2u64b = v2u64(9223372036854775807, 0);
    { let r = V2u64a + V2u64b; print("v2u64 +:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2u64a - V2u64b; print("v2u64 -:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2u64a * V2u64b; print("v2u64 *:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2u64a & V2u64b; print("v2u64 &:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2u64a | V2u64b; print("v2u64 |:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2u64a ^ V2u64b; print("v2u64 ^:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2u64a == V2u64b); print("v2u64 ==:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2u64a != V2u64b); print("v2u64 !=:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2u64a < V2u64b); print("v2u64 <:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2u64a <= V2u64b); print("v2u64 <=:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2u64a > V2u64b); print("v2u64 >:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2u64a >= V2u64b); print("v2u64 >=:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V2u64a; print("v2u64 neg:"); for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2u64a < V2u64b).select(V2u64a, V2u64b); print("v2u64 sel:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    println(f"v2u64 sum {V2u64a.sum()} {V2u64b.sum()} lane {V2u64a.lane(1)} {V2u64a.lane(0)}");
    { let r = v2u64::splat(V2u64b.lane(1)); print("v2u64 splat:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2u64a.with_lane(1, V2u64b.lane(0)); print("v2u64 with:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let mut k = 0; let mut s = 0 as u64;
        while k < 2 { s = s + V2u64b.lane(k); k += 1; } let w = V2u64a.with_lane(k - 1, s);
        print("v2u64 var:"); for i in 0..2 { print(f" {w.lane(i)}"); } println(""); }
    { let mut arr: [u64; 4] = [0 as u64; 4]; V2u64a.store(arr, 1);
        let r = v2u64::load(arr, 1) + v2u64::load(arr[0..4], 2); print("v2u64 mem:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let mut c = V2u64a; c += V2u64b; c *= V2u64b; print("v2u64 acc:");
        for i in 0..2 { print(f" {c.lane(i)}"); } println(""); }
}
