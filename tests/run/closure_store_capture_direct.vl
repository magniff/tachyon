fn main(gpa: Gpa) {
    // ERROR: [own.escape]: 'out' is used here, but 'v', which it views, was dropped
    var out: Vec<[i64]> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(1);
        let s = v.as_slice();
        let f = |x: i64| out.push(s);
        f(1);
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i); }
    println(f"{out[0][0]}");
}
