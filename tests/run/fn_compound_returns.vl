// Struct and tuple returns, nested and chained, and in a loop.
// EXPECT: 13 23 33
// EXPECT: 499500 1000 -499500
// EXPECT: 3 2 8 2
// EXPECT: 9
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct V { x: i64, y: i64, z: i64 }

fn v(x: i64, y: i64, z: i64) -> V { V { x: x, y: y, z: z } }
fn add(a: V, b: V) -> V { v(a.x + b.x, a.y + b.y, a.z + b.z) }
fn scale(a: V, k: i64) -> V { v(a.x * k, a.y * k, a.z * k) }
fn divmod(a: i64, b: i64) -> (i64, i64) { (a / b, a % b) }
fn nest() -> ((i64, i64), V) { (divmod(17, 5), v(7, 8, 9)) }

fn main() -> i64 {
    let r = add(scale(v(1, 2, 3), 10), add(v(1, 1, 1), v(2, 2, 2)));
    unsafe { printf(c"%ld %ld %ld\n", r.x, r.y, r.z); }
    var acc = v(0, 0, 0);
    var i = 0;
    while i != 1000 {
        acc = add(acc, v(i, 1, 0 - i));
        i += 1;
    }
    unsafe { printf(c"%ld %ld %ld\n", acc.x, acc.y, acc.z); }
    let n = nest();
    let q = n.0;
    let w = n.1;
    unsafe {
        printf(c"%ld %ld %ld %ld\n", q.0, q.1, w.y, divmod(100, 7).1);
        printf(c"%ld\n", add(v(1, 2, 3), v(4, 5, 6)).z);
    }
    0
}
