// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: abcd / 7 (generic let param, instance returns a view)
// EXPECT: abcd
// EXPECT: 7
struct E { name: [u8; 4], len: i64 }
trait N { fn nm(self) -> [u8]; }
impl N for E { fn nm(self) -> [u8] { self.name[..self.len] } }
fn twice<X: N>(x: X) -> [u8] { let a = x.nm(); a }
fn clobber() -> i64 { let z = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: ['a', 'b', 'c', 'd'], len: 4 };
    let n = twice(e);
    let k = clobber();
    println(n);
    println(k);
    0
}
