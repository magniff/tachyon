// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a view of a loop iteration's temporary receiver (owning a Buf) kept past it
// ERROR: error[own.escape]
struct H { b: Buf }
impl H { fn view(self) -> [u8] { self.b.as_slice() } }
fn mk(gpa: Gpa, c: u8) -> H { var b = Buf::new_in(gpa); b.push(c); b.push(c); H { b: b } }

fn main(gpa: Gpa) -> i32 {
    var keep: Vec<[u8]> = Vec::new_in(gpa);
    for i in 0..3 {
        keep.push(mk(gpa, 'a' + i as u8).view());
    }
    println(f"{keep.get(0)} {keep.get(2)}");
    0
}
