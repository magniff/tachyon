// (0.25) A let receiver of a plain type is a copy, read-only: `&self.n`
// and an `inout self` method on it are own.readonly, with `inout self` as
// the fix.
struct C { n: i64 }
fn bump(n: inout i64) { n += 1; }
impl C {
    fn inc(inout self) { self.n += 1; }
    fn a(self) -> i64 { bump(&self.n); self.n }
    fn b(self) -> i64 { self.inc(); self.n }
}
fn main() { let c = C { n: 1 }; println(f"{c.a()} {c.b()}"); }
// ERROR: '&self.n' changes 'self', a let receiver: it is read-only
// ERROR: try: inout self
// ERROR: 'self.inc()' changes 'self', a let receiver
