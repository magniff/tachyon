// XFAIL: SOUNDNESS f(&c, &x) with c holding an inout of x: accepted (aliasing)
// the view and the place passed to one call
// ERROR: own.conflict
struct C { n: inout i64 }
fn f(c: inout C, x: inout i64) { c.n += 1; x += 10; }
fn main() { var x = 1; var c = C { n: &x }; f(&c, &x); println(f"{x}"); }
