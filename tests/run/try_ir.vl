// `?` costs nothing over the match written by hand (0.15): in a loop, at
// -O2, both functions are the same code (checked by hand at -O1 and -O2:
// the same IR once values are renumbered): the Option stays in registers
// (no stack slot), `half` is inlined, and the None returns from the loop.
// EXPECT: 12 12 0
// CHECK: fn by_try:
// CHECK-NOT: slot
// CHECK-NOT: call
// CHECK: cmp.eq
// CHECK: pack
// CHECK: fn by_match:
// CHECK-NOT: slot
// CHECK-NOT: call
// CHECK: cmp.eq
// CHECK: pack
// CHECK: fn main:
fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

#[inline(never)]
fn by_try(xs: [i64]) -> Option<i64> {
    var total = 0;
    for x in xs {
        total += half(x)?;
    }
    Some(total)
}

#[inline(never)]
fn by_match(xs: [i64]) -> Option<i64> {
    var total = 0;
    for x in xs {
        total += match half(x) {
            Some(v) => v,
            None => return None,
        };
    }
    Some(total)
}

fn main() {
    let xs = [2, 4, 6, 12];
    std::print_int(by_try(xs[..]).unwrap_or(0));
    print(" ");
    std::print_int(by_match(xs[..]).unwrap_or(0));
    print(" ");
    std::print_int(by_try([2, 3][..]).unwrap_or(0));
    println("");
}
