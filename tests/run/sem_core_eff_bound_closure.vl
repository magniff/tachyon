// A closure that does io given where F: Fn + effects(panic) is required.
// ERROR: the closure for 'F' of 'apply' does io
fn apply<F: Fn(i64) -> i64 + effects(panic)>(f: F, x: i64) -> i64 { f(x) }

fn noisy(x: i64) -> i64 { println("io"); x }

fn main() -> i32 {
    let g: fn(i64) -> i64 = noisy;
    println(apply(|x| g(x), 3));
    0
}
