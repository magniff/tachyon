// sem-own: #[derive(Clone)] on a struct of owned fields: a deep copy, each dropped once.
// EXPECT: 1 2
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
#[derive(Clone)]
struct P { d: Vec<i64>, n: i64 }
impl Clone for D { fn clone(self) -> D { D { id: self.id, v: self.v.clone() } } }
#[derive(Clone)]
struct Q { d: D }

fn main(gpa: Gpa) {
    let p = P { d: Vec::new_in(gpa), n: 1 };
    var q = p.clone();
    q.d.push(1);
    q.d.push(2);
    println(f"{p.d.len() + 1} {q.d.len()}");
    let x = Q { d: mk(1, gpa) };
    let y = x.clone();
    println("end");
}
