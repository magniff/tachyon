// 0.6: the prelude: Option, Some, None, Result, Ok, Err, Vec, print and
// println without `use`, in every module; variants of generic enums by
// their own names, their type arguments inferred.
// EXPECT: 5 -1
// EXPECT: ok 21
// EXPECT: err 7
// EXPECT: 60
fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

fn parse(x: i64) -> Result<i64, i64> {
    if x >= 0 { Ok(x * 3) } else { Err(-x) }
}

fn show(r: Result<i64, i64>) {
    match r {
        Ok(v) => { print("ok "); std::print_int(v); }
        Err(e) => { print("err "); std::print_int(e); }
    }
    println("");
}

fn main(gpa: Gpa) -> i32 {
    let a = match half(10) { Some(v) => v, None => -1 };
    let b = if let Some(v) = half(3) { v } else { -1 };
    std::print_int(a);
    print(" ");
    std::print_int(b);
    println("");
    show(parse(7));
    show(parse(-7));
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(10);
    v.push(20);
    v.push(30);
    var total = 0;
    while let Some(x) = v.pop() { total += x; }
    std::print_int(total);
    println("");
    v.free();
    0
}
