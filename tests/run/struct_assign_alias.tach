// Assigning a struct, tuple or array built from the target's own fields
// reads the old values first.
// EXPECT: 2 1 4 3 7 6 5 9 8
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct P { x: i64, y: i64 }

fn main() -> i64 {
    var p = P { x: 1, y: 2 };
    p = P { x: p.y, y: p.x };
    var t = (3, 4);
    t = (t.1, t.0);
    var a: [i64; 3] = [5, 6, 7];
    a = [a[2], a[1], a[0]];
    var q = P { x: 8, y: 9 };
    q = if true { P { x: q.y, y: q.x } } else { q };
    unsafe {
        printf(c"%ld %ld %ld %ld %ld %ld %ld %ld %ld\n", p.x, p.y, t.0, t.1, a[0], a[1], a[2], q.x,
            q.y);
    }
    0
}
