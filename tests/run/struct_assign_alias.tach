// Assigning a struct, tuple or array built from the target's own fields
// reads the old values first.
// EXPECT: 2 1 4 3 7 6 5 9 8
extern fn printf(format: *u8, ...) -> i32;

struct P { x: i64, y: i64 }

fn main() -> i64 {
    let p = P { x: 1, y: 2 };
    p = P { x: p.y, y: p.x };
    let t = (3, 4);
    t = (t.1, t.0);
    let a: [i64; 3] = [5, 6, 7];
    a = [a[2], a[1], a[0]];
    let q = P { x: 8, y: 9 };
    q = if true { P { x: q.y, y: q.x } } else { q };
    printf("%ld %ld %ld %ld %ld %ld %ld %ld %ld\n".0, p.x, p.y, t.0, t.1, a[0], a[1], a[2], q.x, q.y);
    0
}
