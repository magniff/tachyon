// sem-own: (known leak, scope) Result::unwrap_or_else's closure takes the error sink.
// XFAIL: SOUNDNESS known leak: a closure's sink parameter is never dropped (unwrap_or_else)
// EXPECT: drop 1
// EXPECT: v 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn g(gpa: Gpa) -> Result<i64, D> { Err(mk(1, gpa)) }

fn main(gpa: Gpa) {
    let v = g(gpa).unwrap_or_else(|e| e.id);
    println(f"v {v}");
}
