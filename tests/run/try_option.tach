// `e?` on an Option (0.15): the value, or `return None` from the function;
// in a loop, nested, through a pointer receiver, and as a function's tail.
// EXPECT: 2
// EXPECT: none
// EXPECT: 6
// EXPECT: none
// EXPECT: 3
// EXPECT: 10
fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

fn quarter(x: i64) -> Option<i64> {
    let h = half(x)?;
    half(h)
}

fn sum_halves(xs: [i64]) -> Option<i64> {
    let mut total = 0;
    for x in xs {
        total += half(x)?;
    }
    Some(total)
}

struct Stack { v: Vec<i64> }

impl Stack {
    fn top_two(self: *Stack) -> Option<i64> {
        let a = self.v.pop()?;
        let b = self.v.pop()?;
        Some(a + b)
    }
}

fn eighth(x: i64) -> Option<i64> {
    Some(half(half(x)?)?)
}

fn show(o: Option<i64>) {
    match o {
        Some(v) => {
            std::print_int(v);
            println("");
        }
        None => println("none"),
    }
}

fn main() {
    show(quarter(8));
    show(quarter(6));
    show(sum_halves([2, 4, 6][..]));
    show(sum_halves([2, 3][..]));
    let mut s = Stack { v: Vec::new() };
    s.v.push(1);
    s.v.push(2);
    show(s.top_two());
    show(eighth(40));
    s.v.free();
}
