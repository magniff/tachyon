// a closure capturing a local copy of a static while the static changes.
// FLAGS: -O2
// EXPECT: 1
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

fn main() -> i32 {
    let copy = G;
    let f = || copy.a;
    G.a = 50;
    println(f());
    0
}
