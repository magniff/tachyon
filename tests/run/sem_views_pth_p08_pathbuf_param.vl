// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a function taking a PathBuf (let) returning its file name
// ERROR: error[own.conflict]
use std::path::{Path, PathBuf};
fn base(p: PathBuf) -> Path { p.as_path().file_name().unwrap() }
fn main(gpa: Gpa) -> i32 {
    var p = PathBuf::from_in("/usr/local", gpa);
    let b = base(p);
    p.push("binXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(b);
    0
}
