// A condition's calls through fn values count (0.25, contract.effect): an
// ensures through a fn value that touches a static is rejected.
// ERROR: the 'ensures' of 'f' calls 'g', a fn value that may call a function which touches a static
static var COUNT: i64 = 0;

fn bump(x: i64) -> i64 {
    COUNT += 1;
    x + COUNT
}

fn f(x: i64, g: fn(i64) -> i64) -> i64
    ensures g(result) > 0
{
    x
}

fn main() -> i32 {
    println(f(3, bump));
    0
}
