// for i in 0..s.len() with s[i + 1]: not in bounds by the syntax, so panic.
// ERROR: 'calm' is #[no_panic], but it may panic
#[no_panic]
fn calm(s: [i64]) -> i64 {
    var t = 0;
    for i in 0..s.len() { t += s[i + 1]; }
    t
}

fn main() -> i32 {
    let a = [1, 2, 3];
    println(calm(a[..]));
    0
}
