// Patterns on references (0.18.1, Rust's default binding modes): a
// pattern matched against `&E` (`&mut E`) matches the E, and its bindings
// are `&T` (`&mut T`) references into it; a slice binds a copy. In
// `match`, `if let` and `let`, nested (`Option<&E>`), in a generic, and as
// a switch on the tag. References to two fields of one value are apart.
// EXPECT: 3 5 0 6 12
// EXPECT: 4 5 0 107 92
// EXPECT: 7 -1 100 200 300 43 7
// EXPECT: 6 4 12 0 0 3
// EXPECT: 7 9 7 0 26
enum E { A(i64), B([u8]), C, D(Vec<i64>, i64), P((i64, i64)) }
enum Tok { Num(i64), Op(u8) }
enum Op { Add(i64), Sub(i64), Mul(i64), Div(i64), Neg, Name([u8]) }
enum Tree { Leaf(i64), Node(Vec<Tree>) }

fn f(e: E) -> i64 {
    match e {
        E::A(x) => x,
        E::B(s) => s.len(),
        E::C => 0,
        E::D(v, k) => v.len() + k,
        E::P((a, b)) => a * 10 + b,
    }
}

fn bump(e: inout E) {
    match e {
        E::A(x) => { x += 1; }
        E::D(v, k) => {
            v.push(k);
            k += 100;
        }
        E::P((a, _)) => { a = 9; }
        _ => {}
    }
}

fn g(o: Option<i64>) -> i64 { match o { Some(x) => x, None => -1 } }

fn lit(r: i64) -> i64 { match r { 0 => 100, 1..=5 => 200, _ => 300 } }

fn tok(t: Tok) -> i64 { if let Tok::Op(c) = t { c as i64 } else { 0 } }

fn pair(p: (i64, [u8])) -> i64 {
    let (n, s) = p;
    n + s.len()
}

fn apply(op: Op, x: i64) -> i64 {
    match op {
        Op::Add(n) => x + n,
        Op::Sub(n) => x - n,
        Op::Mul(n) => x * n,
        Op::Div(n) => if n == 0 { 0 } else { x / n },
        Op::Neg => -x,
        Op::Name(s) => x + s.len(),
    }
}

fn sum(t: Tree) -> i64 {
    match t {
        Tree::Leaf(v) => v,
        Tree::Node(kids) => {
            var s = 0;
            for k in kids.iter() { s += sum(k); }
            s
        }
    }
}

fn first<T>(o: Option<T>, d: sink T) -> T { match o { Some(x) => x, None => d } }

fn opt(o: Option<let Op>) -> i64 { match o { Some(Op::Add(n)) => n, Some(_) => 1, None => 0 } }

fn pairs(v: Vec<(i64, i64)>) -> i64 {
    var t = 0;
    for i in 0..v.len() {
        let (a, b) = &v[i];
        t += a * b;
    }
    t
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var es: Vec<E> = Vec::new_in(gpa);
    es.push(E::A(3));
    es.push(E::B("hello"));
    es.push(E::C);
    es.push(E::D(v, 5));
    es.push(E::P((1, 2)));
    for i in 0..es.len() { if i > 0 { print(" "); } print(f(es[i])); }
    println("");
    for i in 0..es.len() { bump(&es[i]); }
    for i in 0..es.len() { if i > 0 { print(" "); } print(f(es[i])); }
    println("");
    let o = Some(7);
    let n: Option<i64> = None;
    let z = 0;
    let t = 3;
    let h = 9;
    let op = Tok::Op('+');
    let pr = (4, "abc");
    println(f"{g(o)} {g(n)} {lit(z)} {lit(t)} {lit(h)} {tok(op)} {pair(pr)}");
    let ops = [Op::Add(5), Op::Sub(2), Op::Mul(3), Op::Div(0), Op::Neg, Op::Name("abc")];
    var x = 1;
    for i in 0..6 {
        x = apply(ops[i], x);
        if i > 0 { print(" "); }
        print(x);
    }
    println("");
    var kids: Vec<Tree> = Vec::new_in(gpa);
    kids.push(Tree::Leaf(3));
    kids.push(Tree::Leaf(4));
    let tr = Tree::Node(kids);
    let so = Some(9);
    let a = Op::Add(7);
    var pv: Vec<(i64, i64)> = Vec::new_in(gpa);
    pv.push((2, 3));
    pv.push((4, 5));
    println(f"{sum(tr)} {first(so, 0)} {opt(Some(&a))} {opt(None)} {pairs(pv)}");
}
