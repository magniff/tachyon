// An array field indexed out of bounds through an inout parameter.
// EXIT: 101
// STDERR: index out of bounds: index 4, length 4
static var Z: i64 = 0;

struct S { a: [i64; 4] }

fn poke(s: inout S, i: i64) {
    s.a[i] = 9;
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    var s = S { a: [1, 2, 3, 4] };
    poke(&s, 4 + Z);
    println(s.a[0]);
    0
}
