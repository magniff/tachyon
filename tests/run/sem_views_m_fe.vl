// ERROR: error[own.conflict]
fn ap(c: fn(Vec<i64>) -> i64, v: Vec<i64>) -> i64 { c(v) }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    var v: Vec<i64> = Vec::new_in(gpa); v.push(1); println(ap(|l| l[0], v));
    0
}
