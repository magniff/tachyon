// A narrowing cast followed by a widening cast must drop the high bits.
// EXPECT: 44 44 4294967295 -1 65535
// EXPECT: 44.0 -1.0
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let x: i64 = 300;
    let a = (x as u8) as u64;
    let b = (x as i8) as i64;
    let y: u64 = 0x1FFFFFFFF;
    let c = (y as u32) as u64;
    let d = (y as i32) as i64;
    let e = (y as u16) as u32;
    printf(c"%lu %ld %lu %ld %u\n", a, b, c, d, e);
    let f = (x as u8) as f64;
    let g = (y as i16) as f32;
    printf(c"%.1f %.1f\n", f, g);
    0
}
