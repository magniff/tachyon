// ? argument evaluated before the inout use; the read ends before the call (two-phase receiver only)
// EXPECT: 2
fn parse(v: Vec<i64>) -> Result<i64, i64> { if v.len() > 0 { Ok(v.len()) } else { Err(0) } }
fn go(v: inout Vec<i64>) -> Result<i64, i64> { v.push(parse(v)?); Ok(v.len()) }
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); v.push(1); match go(&v) { Ok(n) => println(f"{n}"), Err(e) => println(f"e{e}") } }
