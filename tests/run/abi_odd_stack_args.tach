// An odd number of stack arguments must not misalign rsp: the callee calls
// printf with a double, which faults in glibc on a misaligned stack.
// EXPECT: 28 2.500000
extern fn printf(format: *u8, ...) -> i32;

fn seven(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 {
    let x: f64 = 2.5;
    printf("%ld %f\n".0, a + b + c + d + e + f + g, x);
    0
}

fn main() -> i64 {
    seven(1, 2, 3, 4, 5, 6, 7);
    0
}
// SNAPSHOT
