// a closure argument that changes the receiver's owner
// ERROR: own.conflict
struct S { v: Vec<i64>, n: i64 }
impl S { fn each<F: FnMut(i64)>(inout self, f: F) { for i in 0..self.v.len() { f(self.v[i]); self.v.push(0); } } }
fn main(gpa: Gpa) { var s = S { v: Vec::new_in(gpa), n: 0 }; s.v.push(1); s.each(|x| { s.n += x; }); println(f"{s.n}"); }
