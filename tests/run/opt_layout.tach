// Block layout and scheduling (51_layout.tach, 50_isel.tach): the panic of
// a bounds check goes after the loop (cold blocks last), the loop's
// comparison fuses with its branch, the constant a loop stores is made
// once, outside it, and callee-saved registers are saved in pairs.
// (0.10: without vectorization, which would take both loops.)
// FLAGS: --no-vectorize
// EXPECT: 4950 100
// EXPECT: 45
// ASM(aarch64-macos): _tachyon.sum:
// ASM(aarch64-macos): b.hs
// ASM(aarch64-macos): b.lt
// ASM(aarch64-macos): ret
// ASM(aarch64-macos): rt.panic
// ASM(aarch64-macos): _tachyon.mark:
// ASM(aarch64-macos): mov x
// ASM(aarch64-macos): strb w
// ASM-NOT(aarch64-macos): mov
// ASM(aarch64-macos): b.l
// ASM(aarch64-macos): _main:
// ASM(aarch64-macos): stp x19, x20
// ASM(aarch64-macos): ldp x19, x20
// ASM(x86_64-macos): _tachyon.sum:
// ASM(x86_64-macos): jae
// ASM(x86_64-macos): jl
// ASM(x86_64-macos): ret
// ASM(x86_64-macos): rt.panic
// ASM(x86_64-linux): tachyon.sum:
// ASM(x86_64-linux): jae
// ASM(x86_64-linux): jl
// ASM(x86_64-linux): ret
// ASM(x86_64-linux): rt.panic
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn calloc(count: u64, size: u64) -> *u8;
}

// A slice loop whose bounds check stays (the length is the caller's).
fn sum(s: [i64], n: i64) -> i64 {
    let mut total = 0;
    let mut i = 0;
    while i < n {
        total += s[i];
        i += 1;
    }
    total
}

// Stores of a constant in a loop.
fn mark(p: *u8, n: i64) {
    let mut i = 0;
    while i < n {
        unsafe { p[i] = 1; }
        i += 1;
    }
}

fn count(p: *u8, n: i64) -> i64 {
    let mut c = 0;
    for i in 0..n {
        unsafe { c += p[i] as i64; }
    }
    c
}

fn main() -> i32 {
    let p = unsafe { calloc(100, 8) as *i64 };
    for i in 0..100 {
        unsafe { p[i] = i; }
    }
    let s = sum;
    let m = unsafe { mark };
    let bytes = unsafe { calloc(100, 1) };
    unsafe {
        m(bytes, 100);
        printf(c"%ld %ld\n", s(p[0..100], 100), count(bytes, 100));
    }
    // main keeps p and bytes across calls: two callee-saved registers.
    unsafe { printf(c"%ld\n", count(bytes, 10) + 35 + p[0]); }
    0
}
