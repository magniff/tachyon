// read_stdin (0.15) returns Result<Buf, IoError>: what read_line had
// buffered first, then the rest of stdin (then nothing: an empty Buf).
// STDIN: head
// STDIN: a b
// STDIN: c
// EXPECT: head|a b\nc|0
use std::{Buf, read_line, read_stdin};

fn main() {
    let mut line = Buf::new();
    defer line.free();
    read_line(&line).unwrap();
    print(line.as_slice());
    print("|");
    let mut rest = match read_stdin() {
        Ok(b) => b,
        Err(e) => {
            println("read error");
            return;
        }
    };
    defer rest.free();
    let text = rest.as_slice();
    for i in 0..text.len {
        if text[i] == '\n' {
            if i + 1 < text.len {
                print("\\n");
            }
        } else {
            print(text[i..i + 1]);
        }
    }
    print("|");
    std::print_int(read_stdin().unwrap().len());
    println("");
}
