// 0.18: C's `_Nonnull` pointers are imported as std::NonNull<T> (others
// stay *T), and `Option<NonNull<T>>` crosses to C as a nullable pointer
// (the null niche): one register, None the null pointer.
// REQUIRES: clang
// (`_Nonnull` is clang's nullability qualifier: with gcc the header has
// none, so the pointers import as *T; the case runs where cc is clang)
// CSOURCE: tests/c/nonnull.c
// EXPECT: sum 6
// EXPECT: named true
// EXPECT: self true
// EXPECT: count 1 2
// EXPECT: back true true
import "../c/nonnull.h" as c;

// (a C pointer that may be null)
type Nullable = Option<std::NonNull<u8>>;

extern "C" {
    fn count_nonnull(a: Nullable, b: Nullable) -> i64;
    fn pass_through(p: Nullable) -> Nullable;
}

fn main() {
    let mut third = c::cell { value: 3, next: 0 as *c::cell };
    let mut second = c::cell { value: 2, next: &third };
    let mut first = c::cell { value: 1, next: &second };
    let p: std::NonNull<c::cell> = &first as std::NonNull<c::cell>;
    let sum = unsafe { c::cell_sum(p) };
    println(f"sum {sum}");
    let name = unsafe { c::name_or_null(1) };
    println(f"named {!name.is_null()}");
    let back = unsafe { c::cell_self(p) };
    println(f"self {back.as_ptr() as u64 == p.as_ptr() as u64}");
    let some = std::NonNull::new(&first as *u8);
    let none: Option<std::NonNull<u8>> = None;
    let one = unsafe { count_nonnull(some, none) };
    let two = unsafe { count_nonnull(some, some) };
    println(f"count {one} {two}");
    let r1 = unsafe { pass_through(some) };
    let r2 = unsafe { pass_through(none) };
    println(f"back {r1.is_some()} {r2.is_none()}");
}
