// a trait with a default, implemented for Vec<T> generically; sink self drops the Vec once
// FLAGS: --check-alloc
// EXPECT: 4 2
// XFAIL: OVERSTRICT impl<T> Tr for Vec<T> must also name Vec's allocator parameter
trait Sz {
    fn n(self) -> i64;
    fn twice(self) -> i64 { self.n() * 2 }
    fn done(sink self) -> i64 { self.n() }
}

impl<T> Sz for Vec<T> { fn n(self) -> i64 { self.len() } }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1); v.push(2);
    println(f"{v.twice()} {v.done()}");
}
