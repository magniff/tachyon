// sem-own: moving an inout parameter out then assigning it again on every path: refused (own.move_out, as in Rust): the move leaves the caller's place empty while the callee runs.
// ERROR: own.move_out
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn f(d: inout D, gpa: Gpa) { eat(d); d = mk(2, gpa); }

fn main(gpa: Gpa) {
    var a = mk(1, gpa);
    f(&a, gpa);
    println(f"now {a.id}");
}
