// A requires on an impl's method, called through a generic bound.
// EXPECT: 1
// EXIT: 101
// STDERR: requires failed: 'i < self.n' of 'S::pick'
static var Z: i64 = 0;
trait Pick { fn pick(self, i: i64) -> i64; }
struct S { n: i64 }

impl Pick for S {
    fn pick(self, i: i64) -> i64
        requires i < self.n
    {
        i
    }
}

fn use_it<T: Pick>(t: T, i: i64) -> i64 { t.pick(i) }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    println(use_it(S { n: 3 }, 1 + Z));
    println(use_it(S { n: 3 }, 5 + Z));
    0
}
