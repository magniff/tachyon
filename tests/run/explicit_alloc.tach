// 0.16: allocation is explicit. main takes the program's Gpa and passes
// it down; the `_in` forms take the allocator: collect_in, format_in,
// split_in, clone_in, sort_stable_in, with_capacity_in, filled_in.
// EXPECT: [0, 1, 4, 9, 16] [3, 2, 1, 0]
// EXPECT: 1 4 [0, 1, 4, 9, 16] true [7, 7, 7]
struct Counter { n: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(inout self) -> Option<i64> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        Some(self.n)
    }
}

fn squares(n: i64, gpa: Gpa) -> Vec<i64> {
    (0..n).map(|x| x * x).collect_in(gpa)
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    let s = squares(5, gpa);
    let c = Counter { n: 4 }.collect_in(gpa);
    let b = std::format_in(f"{s:?} {c:?}", gpa);
    println(b.as_slice());
    let parts = std::split_in("a,b,,c", ',', gpa);
    var w = s.clone_in(gpa);
    std::sort_stable_in(w.as_mut_slice(), gpa);
    let sevens: Vec<i64> = Vec::filled_in(3, 7, gpa);
    println(f"{v.len()} {parts.len()} {w:?} {v == v.clone()} {sevens:?}");
}
