// FLAGS: --check-alloc --values=off
// EXIT: 101
// EXPECT: before 3
// STDERR: use after release: block #4 (128 bytes) of an arena, allocated at
// STDERR: checkalloc_arena_reset.tach:13:22, released at
// STDERR: checkalloc_arena_reset.tach:16:14 (the arena's reset or scope end)
// 0.16 (0.17 rejects this code: --values=off, 0.16's semantics): --check-alloc with an arena: each block on pages of its own (the
// bump keeps the count); reset takes them away, so a view kept across it
// stops the program.
fn main(gpa: Gpa) -> i32 {
    let mut a = Arena::new_in(gpa);
    let mut v: Vec<i64, Arena> = Vec::new_in(a);
    for i in 0..10 { v.push(i); }
    let s = v.as_slice();
    println(f"before {s[3]}");
    unsafe { a.reset(); }
    println(f"after {s[3]}");
    0
}
