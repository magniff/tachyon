// std's helpers for Option and Result (0.15): ok_or, map, and_then,
// unwrap_or_else, map_err, err; eprint and eprintln write to stderr.
// EXPECT: 7 -1 10 20 -2 3
// EXPECT: 5 -1 1
// STDERR: to stderr
fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

fn need(o: Option<i64>) -> Result<i64, i64> {
    let v = o.ok_or(-1)?;
    Ok(v)
}

fn int(n: i64) {
    std::print_int(n);
    print(" ");
}

fn main() {
    int(need(Some(7)).unwrap_or(0));
    int(need(None).err().unwrap_or(0));
    int(Some(5).map(|x| x * 2).unwrap_or(0));
    int(half(40).and_then(|x| half(x)).map(|x| x * 2).unwrap_or(0));
    int(half(3).unwrap_or_else(|| -2));
    std::print_int(half(6).and_then(half).unwrap_or(3));
    println("");
    let r: Result<i64, i64> = Ok(5);
    let e: Result<i64, i64> = Err(2);
    int(r.map_err(|e| e * 100).unwrap_or(0));
    int(e.map(|v| v + 1).unwrap_or_else(|e| 0 - e + 1));
    std::print_int(e.map_err(|e| e - 1).err().unwrap_or(0));
    println("");
    std::eprint("to ");
    std::eprintln("stderr");
}
