// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: generic struct instantiated with a view
// ERROR: error[own.conflict]
struct Box1<T> { x: T }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let b = Box1 { x: v.as_slice() };
    for i in 0..100 { v.push(i); }
    println(b.x[0]);
    0
}
