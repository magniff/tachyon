// 0.17 (T1 with T4): std's containers drop under --values=error, checked
// by --check-alloc: a Vec of views (owned and a view: its Drop is std's,
// generic over the element), format_in's f-string result, f-string holes
// of owned values (borrowed, not dropped by the f-string), Vec<Buf>
// elements, free then the implicit drop, take. (A hole that moves into a
// temporary, `{E::A(w):?}`, moves w; the temporary is not dropped yet: a
// leak, 0.17.1.)
// FLAGS: --values=error --check-alloc
// EXPECT: 3 ["a", "bb", "c"]
// EXPECT: x=4 [1, 2] [1, 2]
// EXPECT: A([5]) B
// EXPECT: 2 hi there | 0 2
#[derive(Debug)]
enum E { A(Vec<i64>), B }

fn main(gpa: Gpa) {
    let words: Vec<[u8]> = split_in("a,bb,c", ',', gpa);
    println(f"{words.len()} {words:?}");
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let b = format_in(f"x={4}", gpa);
    println(f"{b} {v:?} {v:?}");
    let mut w: Vec<i64> = Vec::new_in(gpa);
    w.push(5);
    let e = E::A(w);
    println(f"{e:?} {E::B:?}");
    let mut bufs: Vec<Buf> = Vec::new_in(gpa);
    bufs.push(Buf::from_in("hi", gpa));
    bufs.push(format_in(f"there", gpa));
    v.free();
    v.push(9);
    let taken = bufs.take();
    print(f"{taken.len()} {taken[0]} {taken[1]} | ");
    println(f"{bufs.len()} {v.len() + 1}");
}
