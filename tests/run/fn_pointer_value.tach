// Functions used as values: stored in variables, arrays and structs,
// passed as arguments, and wrapping libc (a C function is an
// `extern "C" fn`, another type).
// EXPECT: 10 81 77
// EXPECT: 6 add 6 49 1
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn labs(x: i64) -> i64;
}

struct Op { f: fn(i64, i64) -> i64, name: *u8 }

fn twice(x: i64) -> i64 { x * 2 }
fn abs(x: i64) -> i64 { labs(x) }
fn square(x: i64) -> i64 { x * x }
fn add(a: i64, b: i64) -> i64 { a + b }
fn sub(a: i64, b: i64) -> i64 { a - b }
fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }
fn pick(c: bool) -> fn(i64) -> i64 { if c { twice } else { square } }

fn main() -> i64 {
    let f: fn(i64) -> i64 = twice;
    printf(c"%ld %ld %ld\n", f(5), apply(square, 9), apply(abs, 0 - 77));
    let fs: [fn(i64) -> i64; 3] = [twice, square, abs];
    let mut i = 0;
    let mut acc = 0;
    while i != 3 {
        acc += fs[i](0 - 3);
        i += 1;
    }
    let ops: [Op; 2] = [Op { f: add, name: c"add" }, Op { f: sub, name: c"sub" }];
    let g = ops[1].f;
    printf(c"%ld %s %ld %ld %d\n", acc, ops[0].name, g(10, 4), pick(false)(7), f == twice);
    0
}
