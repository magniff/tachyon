// Functions used as values: stored in variables, arrays and structs,
// passed as arguments, and taken from libc.
// EXPECT: 10 81 77
// EXPECT: 6 add 6 49 1
extern fn printf(format: *u8, ...) -> i32;
extern fn labs(x: i64) -> i64;

struct Op { f: fn(i64, i64) -> i64, name: *u8 }

fn twice(x: i64) -> i64 { x * 2 }
fn square(x: i64) -> i64 { x * x }
fn add(a: i64, b: i64) -> i64 { a + b }
fn sub(a: i64, b: i64) -> i64 { a - b }
fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }
fn pick(c: bool) -> fn(i64) -> i64 { if c { twice } else { square } }

fn main() -> i64 {
    let f: fn(i64) -> i64 = twice;
    printf("%ld %ld %ld\n".0, f(5), apply(square, 9), apply(labs, 0 - 77));
    let fs: [fn(i64) -> i64; 3] = [twice, square, labs];
    let i = 0;
    let acc = 0;
    loop {
        if i == 3 { break; };
        acc += fs[i](0 - 3);
        i += 1;
    }
    let ops: [Op; 2] = [Op { f: add, name: "add".0 }, Op { f: sub, name: "sub".0 }];
    let g = ops[1].f;
    printf("%ld %s %ld %ld %d\n".0, acc, ops[0].name, g(10, 4), pick(false)(7), f == twice);
    0
}
