// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: HashMap<str, i64> keys view s, then s grows, then lookups
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var m: HashMap<str, i64> = HashMap::new_in(gpa);
    m.insert(s.as_str(), 1);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(m.contains("hello"));
    0
}
