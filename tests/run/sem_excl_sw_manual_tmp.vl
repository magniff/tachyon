// a manual swap through a temporary of owned values: moves, no double free
// EXPECT: 2 1
fn sw(a: inout Vec<i64>, b: inout Vec<i64>) { let t = std::replace(&a, b.take()); b = t; }

fn main(gpa: Gpa) {
    var a: Vec<i64> = Vec::new_in(gpa); a.push(1); var b: Vec<i64> = Vec::new_in(gpa); b.push(2);
    b.push(3); sw(&a, &b); println(f"{a.len()} {b.len()}");
}
