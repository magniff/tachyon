// sem-own: a sink closure moved to a thread: its capture dropped once, on that thread.
// EXPECT: drop 1
// EXPECT: joined 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let d = mk(1, gpa);
    let h = std::thread::spawn(sink || d.id);
    println(f"joined {h.join()}");
}
