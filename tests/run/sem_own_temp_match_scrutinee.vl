// sem-own: an owned temporary matched by value, the payload bound: the bound part dropped at the arm end, nothing else left.
// EXPECT: in 5
// EXPECT: drop 5
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
enum E { A(D), N }
fn me(gpa: Gpa) -> E { E::A(mk(5, gpa)) }

fn main(gpa: Gpa) {
    match me(gpa) { E::A(d) => println(f"in {d.id}"), E::N => {} }
    println("end");
}
