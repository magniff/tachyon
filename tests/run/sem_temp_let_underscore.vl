// (0.25) `let _ = e` of an owned value drops it at once, as `e;` does (and
// as Rust's); of a place it moves nothing.
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: one
// EXPECT: two
// EXPECT: drop 3
// EXPECT: three
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let _ = mk(1, gpa);
    println("one");
    let x = mk(2, gpa);
    let _ = x;
    println("two");
    let _ = if x.id == 2 { mk(3, gpa) } else { mk(4, gpa) };
    println("three");
}
