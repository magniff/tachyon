// a generic function calling F on a let argument, F a plain fn whose result views it
// ERROR: [own.
// XFAIL: SOUNDNESS a call of a generic F parameter (a plain fn) loses its result's view summary
fn sl(d: Vec<i64>) -> [i64] { d.as_slice() }
fn apply<T, R, F: Fn(T) -> R>(x: T, f: F) -> R { f(x) }

fn main(gpa: Gpa) {
    let s = {
        var v: Vec<i64> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        apply(v, sl)
    };
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..100 { w.push(i); }
    println(f"{s[5]}");
}
