// A call with a requires inside a closure is checked when the closure runs.
// EXPECT: 2
// EXIT: 101
// STDERR: requires failed: 'x % 2 == 0' of 'half'
static var Z: i64 = 0;
fn half(x: i64) -> i64
    requires x % 2 == 0
{
    x / 2
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let g = |y: i64| half(y);
    println(g(4 + Z));
    println(g(5 + Z));
    0
}
