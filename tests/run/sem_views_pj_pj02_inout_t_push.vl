// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: inout projection live across a push
// ERROR: error[own.escape]
fn top(v: inout Vec<i64>) -> inout i64 { &v[0] }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    inout t = top(&v);
    for i in 0..100 { v.push(i); }
    t += 1;
    println(v[0]);
    0
}
