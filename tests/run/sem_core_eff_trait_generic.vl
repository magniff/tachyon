// A trait method whose impl prints, reached through a generic bound.
// ERROR: 'quiet' is #[no_io], but it does io
trait Get { fn get(self) -> i64; }

struct Loud { n: i64 }
impl Get for Loud { fn get(self) -> i64 { println("io"); self.n } }

fn read<T: Get>(t: T) -> i64 { t.get() }

#[no_io]
fn quiet(l: Loud) -> i64 { read(l) }

fn main() -> i32 {
    println(quiet(Loud { n: 3 }));
    0
}
