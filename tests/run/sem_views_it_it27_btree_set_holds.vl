// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a BTreeSet<str> holds a view of s; s grows; the set is iterated
// XFAIL: SOUNDNESS BTreeMap/BTreeSet/HashSet insert does not record the view it stores: use after free
// ERROR: error[own.conflict]
use std::collections::btree_map::BTreeSet;

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var m: BTreeSet<str> = BTreeSet::new_in(gpa);
    m.insert(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    for x in m.iter() { println(x); }
    0
}
