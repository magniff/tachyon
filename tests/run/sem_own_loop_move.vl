// sem-own: moving an outer value inside a loop body is own.moved (the second
// iteration would use it).
// ERROR: own.moved
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) {}

fn main(gpa: Gpa) {
    let d = mk(1, gpa);
    for i in 0..3 { eat(d); }
}
