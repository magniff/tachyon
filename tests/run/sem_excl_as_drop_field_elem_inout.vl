// XFAIL: SOUNDNESS h.v[0] = x through an inout struct does not drop the old element (a leak)
// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
struct H { v: Vec<D> }
fn put(h: inout H) { h.v[0] = D { id: 2 }; }
fn main(gpa: Gpa) { var h = H { v: Vec::new_in(gpa) }; h.v.push(D { id: 1 }); put(&h); println("after"); }
