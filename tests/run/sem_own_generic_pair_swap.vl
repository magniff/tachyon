// sem-own: a generic fn swapping a tuple's parts by moves: each dropped once.
// EXPECT: 2 1
// EXPECT: drop 2
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn sw<A, B>(t: sink (A, B)) -> (B, A) { let (a, b) = t; (b, a) }

fn main(gpa: Gpa) {
    let t = sw((mk(1, gpa), mk(2, gpa)));
    println(f"{t.0.id} {t.1.id}");
}
