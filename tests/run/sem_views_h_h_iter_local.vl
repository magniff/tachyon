// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `m.iter().next().unwrap().1`; s grows while it is used
// XFAIL: SOUNDNESS the item of a temporary HashMap iterator loses its origin: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var m: HashMap<i64, str> = HashMap::new_in(gpa); m.insert(1, w);
    let r = m.iter().next().unwrap().1;
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
