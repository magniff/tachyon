// 0.20 T1: a borrowed element is a view (the push may move it), and `var`
// takes ownership, which an element cannot give (own.move_out).
// FLAGS: --syntax=0.20
// ERROR: may change 'rows' while 'row'
// ERROR: help: read it in place ('let x = v[i];')
fn main(gpa: Gpa) {
    var rows: Vec<Vec<i64>> = Vec::new_in(gpa);
    rows.push(Vec::new_in(gpa));
    let row = rows[0];
    rows.push(Vec::new_in(gpa));
    println(row.len());
    var w = rows[0];
}
