// The inner index of a nested array is checked against the inner length.
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    var g = [[0; 3]; 2];
    g[1][2] = 5;
    println(g[0][3 + Z]);
    println("not reached");
    0
}
