// a user Clone through a generic: original and clone each dropped once
// FLAGS: --check-alloc
// EXPECT: 11 11
// EXPECT: drop 11
// EXPECT: drop 11
// EXPECT: drop 1
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
impl Clone for R { fn clone(self) -> R { R { id: self.id + 10 } } }
fn dup<T: Clone>(x: T) -> (T, T) { (x.clone(), x.clone()) }

fn main() {
    let r = R { id: 1 };
    let p = dup(r);
    println(f"{p.0.id} {p.1.id}");
}
