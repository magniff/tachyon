// sem-own: a whole move: the moved-to name owns, the old one is not dropped.
// EXPECT: b 1
// EXPECT: c 1
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    {
        let a = mk(1, gpa);
        let b = a;
        println(f"b {b.id}");
        var c = b;
        println(f"c {c.id}");
    }
    println("end");
}
