// A pure call that would run (almost) forever, under a condition that never
// holds: hoisting it speculatively changes a program that ends into one
// that does not.
// FLAGS: -O2
// EXPECT: 3
static var Z: i64 = 0;

#[inline(never)]
fn slow(n: i64) -> i64 {
    var t = 0;
    for i in 0..n { t = t * 31 + i; }
    t
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let big = 4611686018427387904 + Z;
    var s = 0;
    for k in 0..3 + Z {
        if k == 5 { s += slow(big); }
        s += k;
    }
    println(s);
    0
}
