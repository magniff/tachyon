// a plain let struct captured: an inout method on it inside the closure; is p changed? (p is let)
// ERROR: [own.readonly]
struct P { x: i64 }
impl P { fn bump(inout self) { self.x += 1; } }

fn main() {
    let p = P { x: 1 };
    let c = || { p.bump(); 0 };
    let r = c();
    println(f"{p.x}");
}
