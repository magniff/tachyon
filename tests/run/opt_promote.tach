// FLAGS: --values=off
// (0.17: the parameters here alias on purpose, which the own pass rejects;
// --values=off is 0.16's semantics, where the optimizer must respect it.)
// Scalar promotion (0.6): a field written in a loop lives in a register
// for the loop, stored back once at its exit, when the other accesses of
// its object at variable offsets are kept apart by their ranges (here the
// index is below 8: a mask), and so does a static that only a
// readnone function is called beside. The location is not promoted when
// an access may overlap it, nor when a call may read it.
// EXPECT: 499500 125 125 4950
// EXPECT: 55 4950
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn abs(x: i32) -> i32;
}

struct Counts { total: i64, bins: [i64; 8] }

#[repr(C)]
struct Raw { a: i64, b: i64 }

static mut HITS: i64 = 0;

fn square(x: i64) -> i64 {
    x * x
}

fn fields(n: i64) -> i64 {
    let mut c = Counts { total: 0, bins: [0; 8] };
    let p = &c;
    for i in 0..n {
        unsafe {
            p.total += i;
            p.bins[i & 7] += 1;
        }
    }
    unsafe { printf(c"%ld %ld %ld ", c.total, c.bins[0], c.bins[7]); }
    c.total
}

// The static is promoted: square reads and writes no memory.
fn statics(n: i64) -> i64 {
    for i in 0..n {
        HITS += square(i) - i * i + i;
    }
    HITS
}

// Not promoted: the loop writes through a pointer that may be &r.a.
fn aliased(r: *Raw, q: *i64, n: i64) -> i64 {
    unsafe {
        for i in 0..n {
            r.a += i;
            *q += 1;
        }
        r.a + r.b
    }
}

// Not promoted: abs, a C function, may read HITS.
fn observed(n: i64) -> i64 {
    let mut total = 0;
    for i in 0..n {
        HITS += 1;
        unsafe { total += HITS + abs(0) as i64; }
    }
    total
}

fn main() -> i32 {
    fields(1000);
    unsafe { printf(c"%ld\n", statics(100)); }
    let mut r = Raw { a: 0, b: 0 };
    let x = aliased(&r, &r.b, 10);
    HITS = 0;
    unsafe { printf(c"%ld %ld\n", x, observed(99) - 0); }
    0
}
