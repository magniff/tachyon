// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of an element kept past the loop, then vv grown
// XFAIL: OVERSTRICT for inout x in &v (D-T3c) is a parser error naming 'inout' as a keyword
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var vv: Vec<Vec<i64>> = Vec::new_in(gpa);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    vv.push(v);
    let u: Vec<i64> = Vec::new_in(gpa);
    var keep = u.as_slice();
    for inout x in &vv { keep = x.as_slice(); }
    vv.clear();
    println(keep.len());
    0
}
