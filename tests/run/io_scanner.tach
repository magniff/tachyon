// Scanner::next_int (0.15) returns Result<i64, ScanError>: End when no
// token is left, Parse(e) for a token that is not a number (consumed all
// the same); next_token and next_line stay Options (absence).
// EXPECT: 10 -20 parse(bad@1) 30 parse(overflow) end
// EXPECT: sum 40
use std::{ParseIntError, ScanError, Scanner, print_int};

fn main() {
    let mut sc = Scanner::new("10 -20 3x 30 99999999999999999999");
    loop {
        match sc.next_int() {
            Ok(n) => print_int(n),
            Err(ScanError::End) => break,
            Err(ScanError::Parse(ParseIntError::InvalidDigit(i))) => {
                print("parse(bad@");
                print_int(i);
                print(")");
            }
            Err(ScanError::Parse(_)) => print("parse(overflow)"),
        }
        print(" ");
    }
    println("end");
    let mut sum = 0;
    let mut sc2 = Scanner::new("10 x 30");
    while let Some(t) = sc2.next_token() {
        sum += std::parse_int(t).unwrap_or(0);
    }
    print("sum ");
    print_int(sum);
    println("");
}
