// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: parent view then set_extension
// ERROR: error[own.conflict]
use std::path::PathBuf;
fn main(gpa: Gpa) -> i32 {
    var p = PathBuf::from_in("/usr/local/x.txt", gpa);
    let par = p.as_path().parent().unwrap();
    p.set_extension("mdXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(par);
    0
}
