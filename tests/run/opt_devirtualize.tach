// Interprocedural constants (0.6): a function pointer every caller passes
// the same becomes a constant in the callee, its indirect calls become
// direct ones, and those are inlined; so is a constant argument, and a
// constant result replaces the calls' values. A function pointer that
// differs between callers stays indirect.
// EXPECT: 1325 2525 7
// EXPECT: 11 9
// CHECK: fn twice_each:
// CHECK: calli
// CHECK: fn main:
// CHECK-NOT: calli
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn double(x: i64) -> i64 {
    x * 2
}

fn add_one(x: i64) -> i64 {
    x + 1
}

fn triple(x: i64) -> i64 {
    x * 3
}

// Every caller passes `double` and 50.
fn sum_mapped(f: fn(i64) -> i64, n: i64) -> i64 {
    let mut total = 0;
    for i in 1..n + 1 {
        total += f(i);
    }
    total / 2 + n
}

fn seven(flag: bool) -> i64 {
    if flag { 7 } else { 7 }
}

// Called with two different functions: stays indirect (and too big to
// inline at both sites).
fn twice_each(f: fn(i64) -> i64, values: [i64]) -> i64 {
    let mut total = 0;
    for x in values {
        total += f(f(x)) - f(x) + f(x * 2) - f(x * 2) + f(0) - f(0);
        total += f(x + 1) - f(x + 1) + f(x + 2) - f(x + 2);
        total += f(x + 3) - f(x + 3) + f(x + 4) - f(x + 4);
    }
    total
}

fn main() -> i32 {
    let a = sum_mapped(double, 50);
    let b = sum_mapped(double, 50) * 2 - a - 50 + 50 * 51 / 2 + 50 + 2525 - 2550 - 50;
    unsafe { printf(c"%ld %ld %ld\n", a, b + 2550 - 2550, seven(a > 0)); }
    let values: [i64; 2] = [1, 2];
    unsafe {
        printf(c"%ld %ld\n",
            twice_each(add_one, values[..]) + twice_each(triple, values[..]) - 9 + 0, 9);
    }
    0
}
