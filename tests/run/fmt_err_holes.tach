// f-string holes (0.15): a value without Display ({x}) or Debug ({x:?})
// gets the impl to write; x, X, b need an integer, c a u8; an f-string is
// not a [u8].
// ERROR: 'P' does not implement Display, which '{x}' needs
// ERROR: help: write 'impl Display for P { fn fmt(self: *P, f: *std::Fmt) { f.write(f"..."); } }'
// ERROR: 'P' does not implement Debug, which '{x:?}' needs
// ERROR: help: derive it: '#[derive(Debug)]' before the type, or write 'impl Debug for P
// ERROR: 'x', 'X' and 'b' write an integer's digits: they need an integer, got 'f64'
// ERROR: 'c' writes a byte: it needs a 'u8', got 'i64'
// ERROR: an f-string is a 'std::Interp' (a value that prints), not '[u8]'
// ERROR: help: make the text with 'format_in(f"...", gpa)'
// ERROR: '(i64, i64)' does not implement Display
// ERROR-COUNT: 6
struct P { x: i64 }

fn takes(s: [u8]) -> i64 { s.len }

fn display() {
    let p = P { x: 1 };
    println(f"{p}");
}

fn debug() {
    let p = P { x: 1 };
    println(f"{p.x} {p:?}");
}

fn hex() {
    let f = 1.5;
    println(f"{f:x}");
}

fn byte() {
    let n = 65;
    println(f"{n:c}");
}

fn slice() {
    let n = 1;
    takes(f"{n}");
}

fn tuple() {
    let t = (1, 2);
    println(f"{t}");
}

fn main() {}
