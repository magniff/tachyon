// Type::m(&x) with an inout self on a let x (the known let bug's relative, through a path call)
// ERROR: [own.readonly]
// XFAIL: WRONG P::bump(&p) on a let p is accepted (the known let bug, path-call form)
struct P { x: i64 }
impl P { fn bump(inout self) { self.x += 1; } }

fn main() {
    let p = P { x: 1 };
    P::bump(&p);
    println(f"{p.x}");
}
