// EXPECT: whole 7 line abcdefghijklmnopqrstuvwxyz
// EXPECT: done

use std::thread;

fn main(gpa: Gpa) {
    let mut hs: Vec<thread::JoinHandle<i64>> = Vec::new_in(gpa);
    for k in 0..4 {
        hs.push(unsafe { thread::spawn(move || {
            for _ in 0..25 { println(f"whole {7} line abcdefghijklmnopqrstuvwxyz"); }
            k
        }) });
    }
    while hs.len() > 0 { hs.pop().unwrap().join(); }
    println("done");
}
