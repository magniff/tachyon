// a scoped thread's result views the caller's Vec, which then grows
// ERROR: [own.conflict]: 'v.push(i)' may change 'v' while 'r'
use std::thread;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    let s = v.as_slice();
    let r = thread::scope(|sc| sc.spawn(|| s).join());
    for i in 0..1000 { v.push(i); }
    println(f"{r[0]}");
}
