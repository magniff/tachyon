// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: out = view of s, then s grows
// ERROR: error[own.conflict]
fn f(out: inout str, s: inout String) {
    out = s.as_str();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
}

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var o: str = "";
    f(&o, &s);
    println(o);
    0
}
