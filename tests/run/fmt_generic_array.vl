// (0.22) An array type in type arguments, `Vec<[i64; 2]>`: fmt keeps it
// and the lines after it as they are (its `;` closed the `<`, so the `>`
// was spaced as a comparison and the next lines indented; tests/fmt's
// tree check runs over this file).
// EXPECT: 3
fn main(gpa: Gpa) {
    var v: Vec<[i64; 2]> = Vec::new_in(gpa);
    v.push([1, 2]);
    if v.len() > 0 {
        println(f"{v[0][0] + v[0][1]}");
    }
}
