// (0.25) Drop and views together where no drop reads a view: a Drop type
// instantiated with owned or plain arguments, std's containers of views, a
// view-holding struct with a Drop field that holds none
struct G<T> { x: T }
impl<T> Drop for G<T> { fn drop(inout self) { println("drop G"); } }
struct D { n: i64 }
impl Drop for D { fn drop(inout self) { println(f"drop D {self.n}"); } }
struct W { s: [i64], d: D }

// EXPECT: 3 2 1
// EXPECT: drop D 7
// EXPECT: drop G
// EXPECT: drop G
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    let g = G { x: 1 };
    let o = G { x: v.clone() };
    var views: Vec<[i64]> = Vec::new_in(gpa);
    views.push(v.as_slice());
    let w = W { s: v.as_slice(), d: D { n: 7 } };
    println(f"{views[0][0]} {o.x.len() + 1} {g.x}");
}
