// one generic instantiated with a plain T and an owned T, conventions per instance
// FLAGS: --check-alloc
// EXPECT: 10 2 1
fn both<T, F: Fn(T) -> i64>(x: T, f: F) -> i64 { f(x) + f(x) }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    println(f"{both(5, |x: i64| x)} {both(v, |w: Vec<i64>| w.len())} {v.len()}");
}
