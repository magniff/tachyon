// sem-own: struct glue drops fields in declaration order; tuples in index order; arrays by index.
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: drop 4
// EXPECT: drop 5
// EXPECT: drop 6
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct P { a: D, b: D }

fn main(gpa: Gpa) {
    {
        let p = P { a: mk(1, gpa), b: mk(2, gpa) };
    }
    {
        let t = (mk(3, gpa), mk(4, gpa));
    }
    {
        let a = [mk(5, gpa), mk(6, gpa)];
    }
    println("end");
}
