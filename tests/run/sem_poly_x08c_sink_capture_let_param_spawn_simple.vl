// a sink closure capturing a let parameter given to thread::spawn
// ERROR: [sync.borrow_escapes]: 'thread::spawn' moves 'v'
use std::thread;

fn go(v: Vec<i64>) -> i64 {
    let h = thread::spawn(sink || v.len());
    h.join()
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(f"{go(v)}");
}
