// printf with more than 6 integer and more than 8 float variadic arguments:
// the overflow goes on the stack in order.
// EXPECT: 1 2 3 4 5 6 7 8
// EXPECT: 0.5 1.5 2.5 3.5 4.5 5.5 6.5 7.5 8.5 9.5
// EXPECT: 1 0.5 2 1.5 3 2.5 4 3.5 5 4.5 6 5.5 7 6.5 8 7.5 9 8.5 10 9.5 11
// EXPECT: -1 65535 0.25 str Z
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let a: i64 = 1;
    let x: f64 = 0.5;
    printf(c"%ld %ld %ld %ld %ld %ld %ld %ld\n", a, a + 1, a + 2, a + 3, a + 4, a + 5, a + 6, a + 7);
    printf(c"%.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f\n", x, x + 1.0, x + 2.0, x + 3.0, x + 4.0, x + 5.0, x + 6.0, x + 7.0, x + 8.0, x + 9.0);
    printf(c"%ld %.1f %ld %.1f %ld %.1f %ld %.1f %ld %.1f %ld %.1f %ld %.1f %ld %.1f %ld %.1f %ld %.1f %ld\n", a, x, a + 1, x + 1.0, a + 2, x + 2.0, a + 3, x + 3.0, a + 4, x + 4.0, a + 5, x + 5.0, a + 6, x + 6.0, a + 7, x + 7.0, a + 8, x + 8.0, a + 9, x + 9.0, a + 10);
    let s: i8 = (0 - 1) as i8;
    let u: u16 = 65535;
    let f: f32 = 0.25;
    printf(c"%d %d %.2f %s %c\n", s, u, f, c"str", 90);
    0
}
