// (0.25) Owned temporaries given to an operator whose impl takes them let
// (`mk(1) + mk(2)`, `==`, `<`, unary `-`) are dropped at the end of the
// statement, once (they were never dropped); its result is the binding's.
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: c 3
// EXPECT: drop 5
// EXPECT: drop 4
// EXPECT: eq false
// EXPECT: drop 7
// EXPECT: drop 6
// EXPECT: lt true
// EXPECT: drop 8
// EXPECT: neg -8
// EXPECT: drop -8
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
impl Add for D { fn add(self, other: D) -> D { D { id: self.id + other.id, v: self.v.clone() } } }
impl Eq for D { fn eq(self, other: D) -> bool { self.id == other.id } }
impl Ord for D { fn cmp(self, other: D) -> i64 { self.id - other.id } }
impl Neg for D { fn neg(self) -> D { D { id: 0 - self.id, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let c = mk(1, gpa) + mk(2, gpa);
    println(f"c {c.id}");
    let e = mk(4, gpa) == mk(5, gpa);
    println(f"eq {e}");
    let l = mk(6, gpa) < mk(7, gpa);
    println(f"lt {l}");
    let m = -mk(8, gpa);
    println(f"neg {m.id}");
}
