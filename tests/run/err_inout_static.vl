// (0.25) An immutable static is in read-only data: `&N` to an inout
// parameter, `&T.f` of a part, an `inout self` method on one, and an
// assignment are errors (`static var` is the fix); it stays read-only.
struct P { x: i64 }
impl P { fn inc(inout self) { self.x += 1; } }
static N: i64 = 1;
static Q: P = P { x: 1 };
fn bump(n: inout i64) { n += 1; }
fn main() {
    bump(&N);
    bump(&Q.x);
    Q.inc();
    println(f"{N} {Q.x}");
}
// ERROR: '&N' changes 'N', an immutable static: it is read-only (in read-only memory)
// ERROR: try: static var N
// ERROR: '&Q.x' changes 'Q', an immutable static
// ERROR: 'Q.inc()' changes 'Q', an immutable static
