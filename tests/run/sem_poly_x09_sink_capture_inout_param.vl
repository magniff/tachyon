// a sink closure capturing an inout parameter of an owned type: a move out of an inout access
// ERROR: [own.move_out]
fn f(v: inout Vec<i64>) -> i64 {
    let c = sink || v.len();
    c()
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(f"{f(&v)} {v.len()}");
}
