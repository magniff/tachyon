// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: result of an indirect call views e, then e changes
// ERROR: error[own.conflict]
struct E { name: [u8; 4], len: i64 }
fn nm(e: E) -> [u8] { e.name[..e.len] }

fn main() -> i32 {
    var e = E { name: ['a', 'b', 'c', 'd'], len: 4 };
    let g: fn(E) -> [u8] = nm;
    let r = g(e);
    e.name[0] = 'J';
    println(r);
    0
}
