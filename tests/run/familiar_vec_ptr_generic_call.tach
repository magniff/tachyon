// 0.17 (decided 2026-10-16): a pointer from a call whose function is
// declared `-> *T`, T a type parameter of the function or of its impl
// (`a.as_ptr()`, `first_ptr(p)`), points, as written, to a type
// parameter: `q[i]` on it is pointer arithmetic for every T, Vec<i64> as
// i64; at once (`f(..)[i]`) or through a local. A function declared
// `-> *Vec<T>` gives a pointer whose `[i]` indexes the Vec.
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 6 4
struct Arr<T> { p: *T }

impl<T> Arr<T> {
    fn as_ptr(self: *Arr<T>) -> *T { self.p }
}

fn first_ptr<T>(p: *T) -> *T { p }

fn vec_ptr<T>(v: *Vec<T>) -> *Vec<T> { v }

fn second_method<T>(a: Arr<T>) -> T {
    let q = a.as_ptr();
    unsafe { q[1] }
}

fn second_call<T>(p: *T) -> T { unsafe { first_ptr(p)[1] } }

fn second_local<T>(p: *T) -> T {
    let q = first_ptr(p);
    unsafe { q[1] }
}

fn last<T>(v: *Vec<T>) -> T {
    let q = vec_ptr(v);
    unsafe { q[q.len() - 1] }
}

fn main(gpa: Gpa) -> i32 {
    let mut a: Vec<i64> = Vec::new_in(gpa);
    defer a.free();
    let mut b: Vec<i64> = Vec::new_in(gpa);
    defer b.free();
    a.push(1);
    b.push(2);
    b.push(4);
    b.push(6);
    let vs = [a, b];
    let xs = [7, 8, 9];
    println(f"{second_method(Arr { p: &vs[0] }).len()} {second_method(Arr { p: &xs[0] })}");
    println(f"{second_call(&vs[0]).len()} {second_call(&xs[0])}");
    println(f"{second_local(&vs[0]).len()} {second_local(&xs[0])}");
    println(f"{last(&b)} {last(&b) - 2}");
    0
}
