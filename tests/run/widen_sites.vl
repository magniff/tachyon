// Integer widening (0.15): a narrower integer value where a wider one of
// the same signedness is expected is converted, at every place check
// mode meets an expected type: let, assignment and compound assignment,
// arguments (generic ones after inference too), return, block tails,
// struct fields, variant payloads, elements of array and tuple literals.
// EXPECT: let 7 assign 9 compound 16 arg 7 generic 7 ret -3 tail 7
// EXPECT: field 7 payload 7 array 7 tuple 7 u8 200 u32 4000000000
use std::{Vec, print_int};

struct S { big: i64 }

enum E { V(i64) }

fn take(x: i64) -> i64 {
    x
}

fn id<T>(x: sink T) -> T {
    x
}

fn ret(x: i32) -> i64 {
    if x < 0 {
        return x;
    }
    x
}

fn tail(x: i16) -> i64 {
    let y = x;
    y
}

fn show(label: [u8], v: i64) {
    print(label);
    print(" ");
    print_int(v);
}

fn main(gpa: Gpa) {
    let a: i32 = 7;
    let x: i64 = a;
    show("let", x);
    var y: i64 = 0;
    y = a + 2;
    show(" assign", y);
    y += a;
    show(" compound", y);
    show(" arg", take(a));
    let v: Vec<i64> = Vec::new_in(gpa);
    let g: i64 = id(a);
    show(" generic", g);
    show(" ret", ret(-3));
    show(" tail", tail(7));
    println("");
    let s = S { big: a };
    show("field", s.big);
    let e = E::V(a);
    match e {
        E::V(n) => show(" payload", n),
    }
    let arr: [i64; 2] = [a, 1];
    show(" array", arr[0]);
    let t: (i64, u8) = (a, 1);
    show(" tuple", t.0);
    let b: u8 = 200;
    let wide: u64 = b;
    show(" u8", wide as i64);
    let c: u32 = 4000000000;
    let signed: i64 = c;
    show(" u32", signed);
    println("");
}
