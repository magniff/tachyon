// the Mutex's owned data returned out of with by value: a move out of an inout access
// ERROR: [own.move_out]: cannot move 'd'
use std::sync::Mutex;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let w = m.with(|d| d);
    println(f"{w.len()}");
}
