// 0.17: a struct-like variant is matched by name, as in Rust.
// ERROR: variant 'Ev::Key' has named fields; match them by name
// ERROR: try: Ev::Key { code: c, shift: _ }
enum Ev { Key { code: i64, shift: bool }, Quit }

fn code(e: Ev) -> i64 {
    match e { Ev::Key(c, _) => c, Ev::Quit => 0 }
}

fn main() -> i32 { 0 }
