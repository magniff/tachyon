// sem-own: keeping a `for x in v` item of an owned Vec (pushing it to
// another Vec) would own it twice: refused, or it moves. Expect a refusal.
// ERROR: own.move_out
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    var v: Vec<D> = Vec::new_in(gpa);
    v.push(mk(1, gpa));
    var w: Vec<D> = Vec::new_in(gpa);
    for x in v { w.push(x); }
}
