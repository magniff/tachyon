// two live projections of the same value
// ERROR: own.conflict
struct S { a: i64, b: i64 }
fn pick(s: inout S, first: bool) -> inout i64 { if first { &s.a } else { &s.b } }

fn main() {
    var s = S { a: 1, b: 2 }; inout r = pick(&s, true); inout q = pick(&s, true); q += 5; r += 10;
    println(f"{s.a}");
}
