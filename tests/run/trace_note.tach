// (0.17) Without --trace a failure's message has a note on --trace (the
// run-time checks' messages and std's panic).
// EXIT: 101
// STDERR: invalid value 7 for enum Color
// STDERR: note: build with --trace for the line and its callers
enum Color { Red, Green }

fn main() -> i32 {
    let n = 7;
    let c = n as Color;
    std::print_int(c as i64);
    0
}
