// (0.25) A move-only closure a let parameter lends may be taken over once
// (`var g = f;` to call it); f is moved from there.
fn each<F: FnMut(i64)>(n: i64, f: F) { var g = f; for i in 0..n { g(i); } f(0); }
fn main() { var s = 0; each(3, |i| { s += i; }); println(f"{s}"); }
// ERROR: error[own.moved]
