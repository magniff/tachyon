// var y = x from a let T: a copy for plain T, own.move_out for an owned T
// ERROR: [own.move_out]: cannot move 'x'
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn f<T>(x: T) { var y = x; println("f"); }

fn main() {
    f(1);
    f(R { id: 1 });
    println("end");
}
