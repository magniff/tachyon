// Indexing a slice out of its bounds writes a message to stderr and exits
// with 101, after what was printed before.
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn get(s: [i32], i: i64) -> i32 {
    s[i]
}

fn main() {
    let a: [i32; 3] = [10, 20, 30];
    unsafe {
        printf(c"%d\n", get(a[..], 2));
        printf(c"%d\n", get(a[..], 3));
        printf(c"not reached\n");
    }
}

// EXPECT: 30
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
