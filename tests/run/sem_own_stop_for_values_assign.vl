// sem-own (iterator stopgap): a for loop over m.values() assigning an item to an outer Option.
// XFAIL: SOUNDNESS accepted: `for v in m.values()` stored in an outer var frees it twice
// ERROR: own.
use std::HashMap;
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn two(gpa: Gpa) -> Vec<D> {
    var w: Vec<D> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn eat(d: sink D) {}

fn main(gpa: Gpa) {
    let w = two(gpa);
    var m: HashMap<i64, D> = HashMap::new_in(gpa);
    m.insert(1, mk(5, gpa));
    var r: Option<D> = None;
    for v in m.values() { r = Some(v); }
}
