// sem-own: a sink closure moved to a sink parameter: its capture dropped in
// the callee, once.
// EXPECT: drop 7
// EXPECT: r 7
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn call<F: FnMut() -> i64>(f: sink F) -> i64 { f() }

fn main(gpa: Gpa) {
    let d = mk(7, gpa);
    let f = sink || d.id;
    let r = call(f);
    println(f"r {r}");
    println("end");
}
