// A #[no_alloc] function that takes a Vec by sink frees it when it drops it.
// ERROR: 'consume' is #[no_alloc], but it allocates from Gpa
#[no_alloc]
fn consume(v: sink Vec<i64>) -> i64 { v.len() }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(consume(v));
    0
}
