// closures borrowing a var declared inside the loop body, pushed into a Vec declared outside
// ERROR: [type error]: cannot infer type parameter 'T' of 'Vec::new_in'
fn main(gpa: Gpa) {
    var vs = Vec::new_in(gpa);
    for i in 0..3 {
        var n = i * 10;
        vs.push(|| n);
    }
    println(f"{(vs[0])()} {(vs[1])()}");
}
