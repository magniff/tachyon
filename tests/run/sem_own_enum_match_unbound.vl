// sem-own: matching with `_` binds nothing: the payload stays and is
// dropped with the enum at scope end, once.
// EXPECT: a
// EXPECT: end
// EXPECT: drop 5
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
enum E { A(D), B(i64) }

fn main(gpa: Gpa) {
    let e = E::A(mk(5, gpa));
    match e {
        E::A(_) => println("a"),
        E::B(n) => println(f"b {n}"),
    }
    println("end");
}
