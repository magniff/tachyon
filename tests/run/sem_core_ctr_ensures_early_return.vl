// ensures is checked at an early return inside a loop.
// EXPECT: 0
// EXIT: 101
// STDERR: ensures failed: 'result >= 0' of 'find': result = -9
static var Z: i64 = 0;

fn find(s: [i64], x: i64) -> i64
    ensures result >= 0
{
    for i in 0..s.len() {
        if s[i] == x { return i - 10; }
    }
    0
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [5, 6, 7];
    println(find(a[..], 9 + Z));
    println(find(a[..], 6 + Z));
    0
}
