// ERROR: cannot compare 'S' with ==: it holds a 'U', which has no ==
// A slice has == when its elements do (0.14): a struct holding a slice
// of a union has none.
#[repr(C)]
union U { a: i64, b: f64 }

struct S { name: [u8], us: [U] }

fn main() -> i64 {
    let v = [U { a: 1 }, U { a: 2 }];
    let a = S { name: "a", us: v[0..2] };
    if a == a { 1 } else { 0 }
}
