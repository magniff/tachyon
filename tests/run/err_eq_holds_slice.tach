// ERROR: cannot compare 'S' with ==: it holds a '[i64]', which has no ==
// A slice has == only through an `impl Eq` (std's `[u8]`, 0.14): a
// struct holding a `[i64]` has none.
struct S { name: [u8], ns: [i64] }

fn main() -> i64 {
    let v = [1, 2];
    let a = S { name: "a", ns: v[0..2] };
    println(a.name);
    if a == a { 1 } else { 0 }
}
