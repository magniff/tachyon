// std::cli (0.24): parse_or_exit over env::args(), the common case.
// ARGS: -vv --name=world -c 3 a b
// EXPECT: hello world (verbosity 2)
// EXPECT: hello world (verbosity 2)
// EXPECT: hello world (verbosity 2)
// EXPECT: files: a b
use std::env;
use std::cli::{Arg, Command};

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("hello", gpa).version("1.0").about("says hello")
        .arg(Arg::flag("verbose").short('v').help("say more"))
        .arg(Arg::option("name").default("you").help("who to greet"))
        .arg(Arg::option("count").short('c').value_name("N").default("1"))
        .arg(Arg::positional("file").multiple());
    let m = cmd.parse_or_exit(env::args());
    let n = match m.get_as::<i64>("count") {
        Ok(n) => n,
        Err(e) => cmd.exit(e),
    };
    for _ in 0..n {
        println(f"hello {m.get("name").unwrap()} (verbosity {m.count("verbose")})");
    }
    print("files:");
    for f in m.values("file") {
        print(f" {f}");
    }
    println("");
    0
}
