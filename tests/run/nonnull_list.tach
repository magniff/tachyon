// 0.18: std::NonNull<T>, a pointer that is never null, and the null
// niche: `Option<NonNull<T>>` is one pointer (None the null one), in
// locals, fields, statics, matches and `while let`.
// EXPECT: 8 8 8 16
// EXPECT: sum 6
// EXPECT: null true false
// EXPECT: first 1
// EXPECT: none true some true
// EXPECT: last 3
use std::NonNull;

struct Node { value: i64, next: Option<NonNull<Node>> }

static mut HEAD: Option<NonNull<Node>> = None;

fn sum(start: Option<NonNull<Node>>) -> i64 {
    let mut cur = start;
    let mut total = 0;
    while let Some(p) = cur {
        unsafe {
            total += (*p.as_ptr()).value;
            cur = (*p.as_ptr()).next;
        }
    }
    total
}

fn last(start: NonNull<Node>) -> i64 {
    let mut p = start;
    loop {
        let node = unsafe { *p.as_ptr() };
        match node.next {
            Some(q) => p = q,
            None => return node.value,
        }
    }
}

fn main() {
    let (one, raw_one) = (size_of(Option<NonNull<Node>>), size_of(NonNull<u8>));
    println(f"{one} {raw_one} {size_of(Node) - 8} {size_of(Option<*u8>)}");
    let mut c = Node { value: 3, next: None };
    let mut b = Node { value: 2, next: NonNull::new(&c) };
    let mut a = Node { value: 1, next: NonNull::new(&b) };
    println(f"sum {sum(NonNull::new(&a))}");
    let raw = 0 as *u8;
    let q: *u8 = &a as *u8;
    println(f"null {raw.is_null()} {q.is_null()}");
    unsafe {
        HEAD = NonNull::new(&a);
        match HEAD {
            Some(p) => println(f"first {(*p.as_ptr()).value}"),
            None => println("empty"),
        }
    }
    let none: Option<NonNull<u8>> = NonNull::new(raw);
    let some: Option<NonNull<u8>> = NonNull::new(q);
    println(f"none {none.is_none()} some {some.is_some()}");
    let head = &a as NonNull<Node>;
    println(f"last {last(head)}");
}
