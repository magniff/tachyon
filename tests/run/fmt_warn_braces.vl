// A plain string with `{name}`, name a local, passed to print, println,
// eprint, eprintln or format (0.15): a warning, its help the f-string
// (other braces doubled); the text is printed as it is.
// WARNING: warning[format]: this string has '{x}' in it, as text: it is not an f-string
// WARNING: help: an f-string writes the local's value: 'println(f"x = {x}")'
// WARNING: this string has '{x:>4}' in it
// WARNING: help: an f-string writes the local's value: 'print(f"{{y}} {x:>4} }}\n")'
// EXPECT: x = {x}
// EXPECT: {y} {x:>4} }
// EXPECT: {y} {{x}} {z}
fn main() {
    let x = 5;
    println("x = {x}");
    print("{y} {x:>4} }\n");
    println("{y} {{x}} {z}");
}
