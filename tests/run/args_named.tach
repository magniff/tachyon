// Named arguments (0.15): after the positional ones, `name: value`, in
// parameter order; any parameter may be named, also one without a
// default; on functions, methods and generic functions.
// EXPECT: 2x3 2x3 2x3
// EXPECT: box 4 5
// EXPECT: pair 1 two
use std::print_int;

fn area(w: i64, h: i64) -> i64 {
    print_int(w);
    print("x");
    print_int(h);
    w * h
}

struct Box { w: i64 }

impl Box {
    fn grow(self: &Box, by: i64, then: i64) {
        print("box ");
        print_int(self.w + by);
        print(" ");
        print_int(self.w + then);
        println("");
    }
}

fn pair<A, B>(first: A, second: B) -> B {
    second
}

fn main() {
    area(2, 3);
    print(" ");
    area(2, h: 3);
    print(" ");
    area(w: 2, h: 3);
    println("");
    let b = Box { w: 3 };
    b.grow(1, then: 2);
    print("pair 1 ");
    println(pair(first: 1, second: "two"));
}
