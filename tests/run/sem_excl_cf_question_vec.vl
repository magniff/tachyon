// XFAIL: WRONG conventions §3: add(&v, parse(v)?) reads v while it is lent inout to an earlier argument; accepted (benign)
// ERROR: own.conflict
fn parse(v: Vec<i64>) -> Result<i64, i64> { if v.len() > 0 { Ok(v.len()) } else { Err(0) } }
fn add(a: inout Vec<i64>, b: i64) { a.push(b); }
fn go(v: inout Vec<i64>, w: Vec<i64>) -> Result<i64, i64> { add(&v, parse(v)?); Ok(v.len()) }
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); v.push(1); let w: Vec<i64> = Vec::new_in(gpa); match go(&v, w) { Ok(n) => println(f"{n}"), Err(e) => println(f"e{e}") } }
