// a call through fn(inout Vec, let Vec) with the same Vec: own.conflict
// ERROR: [own.conflict]: 'v' is lent inout to '&v' and read by 'v' in the same
fn app(d: inout Vec<i64>, s: Vec<i64>) { for x in s { d.push(x); } }

fn main(gpa: Gpa) {
    let f: fn(inout Vec<i64>, Vec<i64>) = app;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    f(&v, v);
    println(f"{v.len()}");
}
