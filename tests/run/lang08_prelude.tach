// EXPECT: some 4 none
// EXPECT: ok 7 err 2
// EXPECT: vec 3 6
// 0.8: the prelude is not a wildcard: a fixed list of names (Option, Some,
// None, Result, Ok, Err, Vec, print, println) every module sees.
mod inner {
    pub fn checked(x: i64) -> Result<i64, i64> {
        if x >= 0 { Ok(x + 1) } else { Err(-x) }
    }
}

fn find(x: i64) -> Option<i64> {
    if x > 0 { Some(x * 2) } else { None }
}

fn main(gpa: Gpa) -> i32 {
    match find(2) {
        Some(v) => { print("some "); std::print_int(v); }
        None => print("none"),
    }
    match find(0) {
        Some(_) => println(" some"),
        None => println(" none"),
    }
    match inner::checked(6) {
        Ok(v) => { print("ok "); std::print_int(v); }
        Err(_) => print("?"),
    }
    match inner::checked(-2) {
        Ok(_) => println("?"),
        Err(e) => { print(" err "); std::print_int(e); println(""); }
    }
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    var sum = 0;
    for i in 0..v.len() {
        sum += v.get(i);
    }
    print("vec ");
    std::print_int(v.len());
    print(" ");
    std::print_int(sum);
    println("");
    0
}
