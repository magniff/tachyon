// sem-own: an array of owned values drops every element once.
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    {
        let a = [mk(1, gpa), mk(2, gpa), mk(3, gpa)];
        println("end");
    }
}
