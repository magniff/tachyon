// 0.18: an explicit impl of a trait replaces the one a distinct type takes
// from its underlying type; a generic distinct type (`Id<T>`) has generic
// impls (`impl<T> Id<T>`) and is inferred through generic functions;
// `as` converts a distinct type as its underlying type converts.
// EXPECT: n4 4
// EXPECT: 7 7 7
// EXPECT: 6
type NodeId = distinct i64;
type Id<T> = distinct i64;
struct Node {}

impl Display for NodeId {
    fn fmt(self, f: inout Fmt) {
        f.str("n");
        f.int(self as i64);
    }
}

impl<T> Id<T> {
    fn raw(sink self) -> i64 { self as i64 }
    fn make(v: i64) -> Id<T> { v as Id<T> }
}

fn first<T>(ids: [Id<T>]) -> Id<T> { ids[0] }

fn main() {
    let a: NodeId = 4;
    println(f"{a} {a:?}");
    let i: Id<Node> = Id::make(7);
    let arr: [Id<Node>; 2] = [i, 9];
    println(f"{i.raw()} {first(arr[..]).raw()} {i}");
    let x = a as f64 * 1.5;
    println(f"{x}");
}
