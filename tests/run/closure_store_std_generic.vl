// a closure given to a generic function stores a captured view into a captured Vec; the view's owner dies first
// ERROR: [own.escape]: 'out' is used here, but 'v', which it views, was dropped
fn main(gpa: Gpa) {
    var out: Vec<[i64]> = Vec::new_in(gpa);
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(7);
        let s = v.as_slice();
        (0..2).for_each(|i| out.push(s));
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i); }
    println(f"{out[0][0]}");
}
