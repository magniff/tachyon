// Comparisons with NaN are false, except !=.
// EXPECT: 0 1 0 0 0 0
// EXPECT: 1 0 1 1 0 0
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let zero: f64 = 0.0;
    let nan: f64 = zero / zero;
    let one: f64 = 1.0;
    printf("%d %d %d %d %d %d\n".0,
        (nan == nan) as i32, (nan != nan) as i32, (nan < one) as i32,
        (nan <= one) as i32, (nan > one) as i32, (nan >= one) as i32);
    let two: f64 = 2.0;
    printf("%d %d %d %d %d %d\n".0,
        (one == one) as i32, (one != one) as i32, (one < two) as i32,
        (one <= two) as i32, (one > two) as i32, (one >= two) as i32);
    0
}
