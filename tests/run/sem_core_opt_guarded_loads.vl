// (0.25) Loads under a condition that never holds, in loops, at an index
// far out of bounds: an array's element, a static array's, an array field
// through a reference, a slice's, a Vec's, a field through a raw pointer
// behind a null test. No optimization level may run one where the program
// does not (LICM, scalar promotion): -O2 prints what -O0 does.
// FLAGS: -O2
// EXPECT: 5 5 5 5 5 5 5
// EXPECT: 15 15
// EXPECT: 4 5
static var Z: i64 = 0;
static var TABLE: [i64; 4] = [1, 2, 3, 4];

struct Grid { cells: [i64; 3], n: i64 }
struct Node { v: i64, next: i64 }

fn arr_local(i: i64) -> i64 {
    let a = [1, 2, 3];
    var t = 0;
    var k = 0;
    while k < 5 + Z { if k > 100 { t += a[i]; } t += 1; k += 1; }
    t
}

fn arr_static(i: i64) -> i64 {
    var t = 0;
    for k in 0..5 + Z { if k == 1000 { t += TABLE[i]; } t += 1; }
    t
}

fn field_ref(g: Grid, i: i64) -> i64 {
    var t = 0;
    for k in 0..5 + Z { if k < 0 { t += g.cells[i]; } t += 1; }
    t
}

fn slice_elem(s: [i64], i: i64) -> i64 {
    var t = 0;
    for k in 0..5 + Z { if k > 50 { t += s[i]; } t += 1; }
    t
}

fn vec_elem(v: Vec<i64>, i: i64) -> i64 {
    var t = 0;
    for k in 0..5 + Z { if k > 50 { t += v[i]; } t += 1; }
    t
}

fn raw_field(p: *Node) -> i64 {
    var t = 0;
    for k in 0..5 + Z {
        if Z > 0 && p != 0 as *Node { t += unsafe { (*p).v }; }
        t += 1;
    }
    t
}

fn after_continue(i: i64) -> i64 {
    let a = [1, 2, 3];
    var t = 0;
    var k = 0;
    while k < 5 + Z { t += 1; k += 1; if Z == 0 { continue; } t += a[i]; }
    t
}

// Nested: the inner loop's guarded load, hoisted to either preheader.
fn nested(i: i64) -> i64 {
    let a = [1, 2, 3];
    var t = 0;
    for j in 0..3 + Z {
        for k in 0..5 + Z { if j + k > 100 { t += a[i]; } t += 1; }
    }
    t
}

// A guarded read and write of one element: scalar promotion's case.
fn promoted(i: i64) -> i64 {
    var a = [1, 2, 3];
    var t = 0;
    for k in 0..15 + Z { if k > 100 { a[i] += k; } t += 1; }
    t
}

// In bounds, the hoisted and promoted forms must still compute the same.
fn in_bounds(i: i64) -> i64 {
    var a = [1, 2, 3];
    var t = 0;
    for k in 0..3 + Z { t += a[i]; a[i] = 1; }
    t + a[i] - 1
}

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let far = -1099511627776 + Z;
    let g = Grid { cells: [7, 8, 9], n: 3 };
    let s = [1, 2, 3];
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(
        f"{arr_local(far)} {arr_static(far)} {field_ref(g, far)} {slice_elem(s[0..3], far)} {vec_elem(v, far)} {raw_field(0 as *Node)} {after_continue(far)}");
    println(f"{nested(far)} {promoted(far)}");
    println(f"{in_bounds(1 + Z)} {in_bounds(2 + Z)}");
    0
}
