// an operator on an owned type takes both operands let: a + a is fine, neither consumed
// FLAGS: --check-alloc
// EXPECT: 1 2 3
struct Big { v: Vec<i64> }

impl Add for Big {
    fn add(self, o: Big) -> Big {
        var r = self.v.clone();
        for x in o.v { r.push(x); }
        Big { v: r }
    }
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let a = Big { v: v };
    let b = a + a;
    let c = b + a;
    println(f"{a.v.len()} {b.v.len()} {c.v.len()}");
}
