// sem-own: a type with Drop has its own drop run first, then its fields'
// glue (as in Rust); each field dropped once.
// EXPECT: outer 1
// EXPECT: inner 10
// EXPECT: inner 11
// EXPECT: end
struct In { id: i64 }
impl Drop for In { fn drop(inout self) { println(f"inner {self.id}"); } }
struct Out { id: i64, a: In, b: In, v: Vec<i64> }
impl Drop for Out { fn drop(inout self) { println(f"outer {self.id}"); } }

fn main(gpa: Gpa) {
    {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(3);
        let o = Out { id: 1, a: In { id: 10 }, b: In { id: 11 }, v: v };
    }
    println("end");
}
