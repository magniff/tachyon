// sem-own: BTreeMap insert of an existing owned key: one key dropped, the old value dropped (result discarded).
// EXPECT: drop 1
// EXPECT: drop 5
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 6
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
impl Eq for D { fn eq(self, other: D) -> bool { self.id == other.id } }
impl Ord for D { fn cmp(self, other: D) -> i64 { self.id - other.id } }

fn main(gpa: Gpa) {
    var m: std::BTreeMap<D, D> = std::BTreeMap::new_in(gpa);
    m.insert(mk(1, gpa), mk(5, gpa));
    m.insert(mk(1, gpa), mk(6, gpa));
    println("end");
}
