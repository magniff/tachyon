// the scope's closure writes a value a scoped thread reads
// ERROR: [sync.scope_write]: the closure given to 'thread::scope' changes 'n', which its
use std::thread;

fn main() {
    var n = 1;
    thread::scope(|s| {
        s.spawn(|| n * 2);
        n = 5;
        0
    });
    println(f"{n}");
}
