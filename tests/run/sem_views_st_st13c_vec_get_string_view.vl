// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of v.get(0) (a String), then v cleared
// XFAIL: SOUNDNESS a view of an accessor's copy of an owned element loses the container: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var v: Vec<String> = Vec::new_in(gpa);
    v.push(String::from_in("hello", gpa));
    let w = v.get(0).as_str();
    v.clear();
    println(w);
    0
}
