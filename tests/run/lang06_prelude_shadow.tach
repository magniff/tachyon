// 0.6: the prelude comes last: a program's own items, its imports and its
// `*` imports all shadow it, and so do local bindings.
// EXPECT: mine 3
// EXPECT: 2 9
enum Opt { Some(i64), None }
use Opt::*;

fn println(x: i64) {
    std::print("mine ");
    std::print_int(x);
    std::println("");
}

fn main() -> i32 {
    println(3);
    let o = Some(2);
    let n = match o { Some(v) => v, None => 0 };
    let print = 9;
    std::print_int(n);
    std::print(" ");
    std::print_int(print);
    std::println("");
    0
}
