// an Fn closure that pushes to a captured Vec, called from two scoped threads
// ERROR: [sync.not_sync]: a thread of 'thread::scope' shares 'f'
// ERROR: [sync.not_sync]: a thread of 'thread::scope' shares 'f'
use std::thread;

fn par<F: Fn()>(f: F) {
    thread::scope(|s| {
        s.spawn(|| { for _ in 0..10000 { f(); } 0 });
        s.spawn(|| { for _ in 0..10000 { f(); } 0 });
        0
    });
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    par(|| v.push(1));
    println(f"{v.len()}");
}
