// an Fn closure that pushes to a captured Vec, called from two scoped threads
// (0.25: rejected at the bound: a closure that changes a capture is not Fn)
// ERROR: so it is not 'Fn' as the bound of 'F' of 'par' asks
use std::thread;

fn par<F: Fn()>(f: F) {
    thread::scope(|s| {
        s.spawn(|| { for _ in 0..10000 { f(); } 0 });
        s.spawn(|| { for _ in 0..10000 { f(); } 0 });
        0
    });
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    par(|| v.push(1));
    println(f"{v.len()}");
}
