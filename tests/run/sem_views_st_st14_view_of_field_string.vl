// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view into a struct's String field, then the field reassigned
// ERROR: error[own.conflict]
struct P { name: String }
fn main(gpa: Gpa) -> i32 {
    var p = P { name: String::from_in("hello", gpa) };
    let w = p.name.as_str();
    p.name = String::from_in("bye", gpa);
    println(w);
    0
}
