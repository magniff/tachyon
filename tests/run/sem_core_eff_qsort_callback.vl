// qsort calls back into a vole function that prints.
// ERROR: 'sort3' is #[no_io], but it does io
extern "C" {
    fn qsort(base: *u8, n: u64, size: u64, cmp: extern "C" fn(*u8, *u8) -> i32);
}

extern "C" fn cmp(a: *u8, b: *u8) -> i32 {
    println("io");
    unsafe { (*(a as *i64) - *(b as *i64)) as i32 }
}

#[no_io]
fn sort3(a: inout [i64; 3]) {
    unsafe { qsort(&a as *u8, 3, 8, cmp); }
}

fn main() -> i32 {
    var a = [3, 1, 2];
    sort3(&a);
    println(f"{a[0]} {a[1]} {a[2]}");
    0
}
