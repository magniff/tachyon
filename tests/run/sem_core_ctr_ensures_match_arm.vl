// ensures is checked at a return from a match arm.
// EXPECT: 1
// EXIT: 101
// STDERR: ensures failed: 'result < 100' of 'pick': result = 500
static var Z: i64 = 0;

fn pick(k: i64) -> i64
    ensures result < 100
{
    match k {
        0 => return 1,
        1 => return 500,
        _ => 2,
    }
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    println(pick(0 + Z));
    println(pick(1 + Z));
    0
}
