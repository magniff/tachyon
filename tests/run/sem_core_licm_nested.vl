// A guarded index in an inner loop.
// FLAGS: -O2
// XFAIL: SOUNDNESS -O2 hoists the guarded element load above its bounds check (segfault)
// EXPECT: 0
static var Z: i64 = 0;



fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    let a = [1, 2, 3];
    var t = 0;
    for j in 0..3 + Z {
        var k = 0;
        while k < 5 + Z { if k > 100 + j { t += a[i]; } k += 1; }
    }
    println(t);
    0
}
