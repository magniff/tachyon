// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view returned by a scoped thread, used after a push
// ERROR: error[own.conflict]
use std::thread;

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let s = v.as_slice();
    let r = thread::scope(|sc| {
        let a = sc.spawn(|| s[0..1]);
        a.join()
    });
    for i in 0..100 { v.push(i); }
    println(r[0]);
    0
}
