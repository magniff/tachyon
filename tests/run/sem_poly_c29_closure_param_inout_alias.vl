// a closure taking two inout params, called with the same place twice
// ERROR: [own.conflict]: 'x' has an inout access, '&x', and another one, '&x', in the same call
fn main() {
    let sw = |a: inout i64, b: inout i64| { let t = a; a = b; b = t + 1; };
    var x = 1;
    sw(&x, &x);
    println(f"{x}");
}
