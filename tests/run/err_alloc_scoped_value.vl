// 0.16: what an arena scope makes on its arena is gone when the scope
// ends: the scope's value cannot hold a ScopedArena (S2), whether the
// scope's body is a closure or a function passed by name.
// ERROR: this arena scope's value holds 'ScopedArena' (Vec<i64, ScopedArena>): its memory is gone when the scope ends
// ERROR: help: copy it out: 'v.clone_in(gpa)'
// ERROR: this arena scope's value holds 'ScopedArena' (ScopedArena)
// ERROR: this arena scope's value holds 'ScopedArena' (Option<*Vec<i64, ScopedArena>>)
// ERROR: this arena scope's value holds 'ScopedArena' (Vec<i64, ScopedArena>)
// ERROR-COUNT: 4
fn make(s: ScopedArena) -> Vec<i64, ScopedArena> {
    var v: Vec<i64, ScopedArena> = Vec::new_in(s);
    v.push(1);
    v
}

fn main(gpa: Gpa) {
    let v = arena_scope(gpa, |s: ScopedArena| {
        var v: Vec<i64, ScopedArena> = Vec::new_in(s);
        v.push(1);
        v
    });
    let s = arena_scope(gpa, |s: ScopedArena| s);
    let p = arena_scope(gpa, |s: ScopedArena| {
        let v = make(s);
        let o: Option<*Vec<i64, ScopedArena>> = None;
        o
    });
    let w = arena_scope(gpa, make);
    // (a function of a scope's arena may return what it makes there)
    let n = arena_scope(gpa, |s: ScopedArena| make(s).len());
}
