// FLAGS: --check-alloc
// EXIT: 101
// STDERR: check-alloc: out of memory maps at block #101, with 100 blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)
// STDERR: try: sudo sysctl vm.max_map_count=1048576
// 0.16: --check-alloc: each live block has pages of its own, and Linux
// limits a process's memory maps (vm.max_map_count): reaching the limit
// stops the program with the fix. TACHYON_ALLOC_MAX_LIVE gives the same
// stop at a count of live blocks, on any system (for this test).
extern "C" {
    fn setenv(name: *u8, value: *u8, overwrite: i32) -> i32;
}

fn main(gpa: Gpa) {
    unsafe {
        setenv(c"TACHYON_ALLOC_MAX_LIVE", c"100", 1);
    }
    let mut keep: [*u8; 200] = [0 as *u8; 200];
    for i in 0..200 {
        keep[i] = gpa.alloc(16, 8);
    }
}
