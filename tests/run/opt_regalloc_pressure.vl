// Register pressure: more values live at once than there are registers,
// across calls and around loops, in integers and floats; arguments
// rotated between calls. Every level must print the same.
// EXPECT: -5094091037704438488
// EXPECT: 7.722433376e+31
// EXPECT: 1684955
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn mix(a: i64, b: i64) -> i64 {
    a * 31 + b
}

fn fmix(a: f64, b: f64) -> f64 {
    a * 0.5 + b
}

fn many(n: i64) -> i64 {
    var a0 = n + 1; var a1 = n + 2; var a2 = n + 3; var a3 = n + 4;
    var a4 = n + 5; var a5 = n + 6; var a6 = n + 7; var a7 = n + 8;
    var a8 = n + 9; var a9 = n + 10; var b0 = n * 3; var b1 = n * 5;
    var b2 = n * 7; var b3 = n * 11; var b4 = n * 13; var b5 = n * 17;
    var b6 = n * 19; var b7 = n * 23; var b8 = n * 29; var b9 = n * 31;
    var i = 0;
    while i < n {
        a0 = mix(a0, b9); a1 = mix(a1, a0); a2 = mix(a2, a1); a3 = mix(a3, a2);
        a4 = mix(a4, a3); a5 = mix(a5, a4); a6 = mix(a6, a5); a7 = mix(a7, a6);
        a8 = mix(a8, a7); a9 = mix(a9, a8); b0 = b0 ^ a9; b1 = b1 + b0;
        b2 = b2 - b1; b3 = b3 ^ b2; b4 = b4 + b3; b5 = b5 - b4;
        b6 = b6 ^ b5; b7 = b7 + b6; b8 = b8 - b7; b9 = b9 ^ b8;
        i += 1;
    }
    a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9
        + b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9
}

fn floats(n: i64) -> f64 {
    var x0 = 1.0; var x1 = 2.0; var x2 = 3.0; var x3 = 4.0;
    var x4 = 5.0; var x5 = 6.0; var x6 = 7.0; var x7 = 8.0;
    var x8 = 9.0; var x9 = 10.0; var y0 = 0.5; var y1 = 0.25;
    var y2 = 0.125; var y3 = 1.5; var y4 = 2.5; var y5 = 3.5;
    var i = 0;
    while i < n {
        x0 = fmix(x0, y5); x1 = fmix(x1, x0); x2 = fmix(x2, x1); x3 = fmix(x3, x2);
        x4 = fmix(x4, x3); x5 = fmix(x5, x4); x6 = fmix(x6, x5); x7 = fmix(x7, x6);
        x8 = fmix(x8, x7); x9 = fmix(x9, x8); y0 = y0 + x9; y1 = y1 * 0.5 + y0;
        y2 = y2 + y1; y3 = y3 * 0.25 + y2; y4 = y4 + y3; y5 = y5 * 0.5 + y4;
        i += 1;
    }
    x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9 + y0 + y1 + y2 + y3 + y4 + y5
}

// Values live across a call that uses them all as arguments, rotated.
fn sum8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f + 7 * g + 8 * h
}

fn rotate(n: i64) -> i64 {
    var a = 1; var b = 2; var c = 3; var d = 4;
    var e = 5; var f = 6; var g = 7; var h = 8;
    var total = 0;
    for _ in 0..n {
        total += sum8(h, a, b, c, d, e, f, g);
        let t = h;
        h = g; g = f; f = e; e = d; d = c; c = b; b = a; a = t + total % 7;
    }
    total + a + b + c + d + e + f + g + h
}

fn main() -> i32 {
    unsafe {
        printf(c"%ld\n", many(1000));
        printf(c"%.9e\n", floats(40));
        printf(c"%ld\n", rotate(500));
    }
    0
}
