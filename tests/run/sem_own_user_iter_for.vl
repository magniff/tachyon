// sem-own: `for x in p` over an owning user iterator: the iterator consumed
// once, its Vec freed once.
// EXPECT: 2
// EXPECT: 1
// EXPECT: end
struct Pop { v: Vec<i64> }
impl Iterator for Pop { type Item = i64; fn next(inout self) -> Option<i64> { self.v.pop() } }

fn main(gpa: Gpa) {
    var p = Pop { v: Vec::new_in(gpa) };
    p.v.push(1);
    p.v.push(2);
    for x in p { println(f"{x}"); }
    println("end");
}
