// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: enumerate items of a Vec<str>, kept, s grows
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    var r: str = "";
    for (i, x) in v.iter().enumerate() { r = x; }
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
