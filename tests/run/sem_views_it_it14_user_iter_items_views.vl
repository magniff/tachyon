// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a user iterator yielding views of its slice's text
// ERROR: error[own.conflict]
struct Words { s: [str], i: i64 }

impl Iterator for Words {
    type Item = str;

    fn next(inout self) -> Option<str> {
        if self.i < self.s.len() { self.i += 1; Some(self.s[self.i - 1]) } else { None }
    }
}

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    var it = Words { s: v.as_slice(), i: 0 };
    let r = it.next().unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
