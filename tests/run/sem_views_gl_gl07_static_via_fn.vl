// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a function stores its parameter's view into a static
// XFAIL: SOUNDNESS a static var may hold a view of a String: use after free
// ERROR: error[own.
static var K: str = "";
fn keep(w: str) { K = w; }
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    keep(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(K);
    0
}
