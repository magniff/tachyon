// sem-own: `loop { break v }` moves an owned value out of the loop.
// EXPECT: drop 0
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: got 3
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var i = 0;
    let d = loop {
        let x = mk(i, gpa);
        if i == 3 { break x; }
        i += 1;
        if i == 2 { let y = mk(2, gpa); }
    };
    println(f"got {d.id}");
}
