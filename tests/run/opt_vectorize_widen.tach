// (0.16) A u64 accumulation of products of u32 values by an invariant
// below 2^32, `out[j] += k * b[j]` (big-integer kernels) and its dot
// product, is vectorized: the u32 loads stay two lanes of 32 bits and one
// AArch64 umlal (a widening multiply-accumulate by element) does two
// columns (x86-64's SSE2 has no such multiply: scalar there). Checked
// against -O0 at run time.
// EXPECT: 6708939801348849375 6872522037386418532
// ASM(aarch64-macos): _tachyon.mac:
// ASM(aarch64-macos): umlal
// ASM(aarch64-macos): _tachyon.dot:
// ASM(aarch64-macos): umlal
extern "C" {
    fn printf(f: *u8, ...) -> i32;
}

fn mac(out: &mut [u64], b: [u32], ai: u32) {
    let k: u64 = ai;
    for j in 0..b.len {
        out[j] += k * b[j];
    }
}

fn dot(a: [u32], k: u32) -> u64 {
    let mut s: u64 = 0;
    for x in a {
        s += (x as u64) * (k as u64);
    }
    s
}

fn main(gpa: Gpa) -> i32 {
    let f = mac;
    let mut out = Vec::filled_in(1003, 7u64, gpa);
    let mut b = Vec::filled_in(1001, 0u32, gpa);
    for i in 0..1001 {
        b.set(i, (i * 2654435761) as u32);
    }
    for r in 0..300 {
        let ai: u32 = (r * 40503 + 17) as u32;
        f(&mut out.as_mut_slice()[r % 2..r % 2 + 1001], b.as_slice(), ai);
    }
    let mut h: u64 = 0;
    for x in out.as_slice() {
        h = h * 31 + x;
    }
    let g = dot;
    unsafe { printf(c"%lu %lu\n", h, g(b.as_slice(), 123456789)); }
    out.free();
    b.free();
    0
}
