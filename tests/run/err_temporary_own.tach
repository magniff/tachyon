// A temporary `&f(x)` makes (0.18.1) is a local the own pass checks: it
// dies at the end of its block (a block's value that views it escapes),
// it cannot be moved out through the reference, and a view it holds of
// another value is checked as any view.
// ERROR: the block's value views 'mk(gpa)'
// ERROR: cannot move '*r' (Vec<i64>) out of a reference
// ERROR: 'v.push(1)' may change 'v' while 's'
fn mk(gpa: Gpa) -> Vec<i64> {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v
}

fn total(v: Vec<i64>) -> i64 { v.len() }

fn main(gpa: Gpa) {
    let n = {
        let r = &mk(gpa);
        r
    };
    let r = &mk(gpa);
    let w = r;
    var v = mk(gpa);
    let s = v.as_slice();
    v.push(1);
    println(f"{total(n)} {w.len()} {s.len()}");
}
