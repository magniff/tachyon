// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) sync.borrow_escapes: an Option<str> into a detached thread
// ERROR: error[sync.borrow_escapes]
use std::thread;
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    let o = Some(s.as_str());
    let h = thread::spawn(sink || o.unwrap().len());
    println(h.join());
    0
}
