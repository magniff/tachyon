// two scoped threads push to a captured let Vec (inout method on a let capture)
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'v', which the scope's o
// ERROR: [sync.scope_shared_write]: a thread of 'thread::scope' changes 'v', which the scope's o
use std::thread;

fn main(gpa: Gpa) {
    let v: Vec<i64> = Vec::new_in(gpa);
    thread::scope(|s| {
        s.spawn(|| { for i in 0..10000 { v.push(i); } 0 });
        s.spawn(|| { for i in 0..10000 { v.push(i); } 0 });
        0
    });
    println(f"{v.len()}");
}
