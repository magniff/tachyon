// sem-own: returning an owned local moves it out: not dropped in the callee.
// EXPECT: in
// EXPECT: got 5
// EXPECT: drop 5
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn f(gpa: Gpa) -> D { let d = mk(5, gpa); println("in"); d }

fn main(gpa: Gpa) {
    let d = f(gpa);
    println(f"got {d.id}");
}
