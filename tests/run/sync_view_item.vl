// (0.25) a channel's items, a Mutex's data, an atomic's value and what a
// lock's closure returns hold no view (sync.view_item): what goes in comes
// out elsewhere, later, and may outlive what it views
// ERROR: [sync.view_item]: a channel of [i64], a view:
// ERROR: [sync.view_item]: a channel of str, a view:
// ERROR: [sync.view_item]: a channel of Line, which holds views:
// ERROR: [sync.view_item]: a Mutex of [u8], a view:
// ERROR: [sync.view_item]: a Mutex of Vec<[i64]>, which holds views:
// ERROR: [sync.view_item]: the closure given to the lock returns [i64], a view:
// ERROR: [sync.view_item]: the closure given to the lock returns [i64], a view:
use std::sync::{Mutex, mpsc};
struct Line { text: [u8], n: i64 }

fn main(gpa: Gpa) {
    let (t1, r1) = mpsc::channel_in::<[i64]>(gpa);
    let (t2, r2) = mpsc::channel_in::<str>(gpa);
    let (t3, r3) = mpsc::channel_in::<Line>(gpa);
    let m1 = Mutex::new("abc");
    let d: Vec<[i64]> = Vec::new_in(gpa);
    let m2 = Mutex::new(d);
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let m3 = Mutex::new(v);
    let s = m3.with(|d| d.as_slice());
    let o = m3.try_with(|d| d.as_slice());
}
