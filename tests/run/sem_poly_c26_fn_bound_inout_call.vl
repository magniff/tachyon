// a closure passing a captured var to an inout param, given to an Fn bound
// ERROR: does not satisfy the bound
// XFAIL: WRONG a closure passing a capture to an inout parameter satisfies an Fn bound
fn bump(n: inout i64) { n += 1; }
fn apply<F: Fn()>(f: F) { f(); f(); }

fn main() {
    var n = 0;
    apply(|| bump(&n));
    println(f"{n}");
}
