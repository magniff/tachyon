// A fixed-size array place has its slice's methods (0.16): `a.iter()` is
// `a[..].iter()`, for locals, fields, statics and elements of arrays of
// arrays, with adapters and consumers after it; `for x in a` as before,
// and `for x in a.iter()`. A temporary array has none: err_array_iter_temp.
// EXPECT: sum 6 count 3 max 3
// EXPECT: field 26 for 26 26
// EXPECT: static 4 7 rows 5 6
// EXPECT: map 2 4 6 | filter 2
use std::Iterator;

struct P { a: [i64; 4] }

static TABLE: [i64; 2] = [4, 3];

fn show(x: i64) {
    print(" ");
    std::print_int(x);
}

fn main() -> i32 {
    let a = [1, 2, 3];
    print("sum");
    show(a.iter().sum());
    print(" count");
    show(a.iter().count());
    print(" max");
    var m = 0;
    for x in a.iter() {
        if x > m {
            m = x;
        }
    }
    show(m);
    println("");
    let p = P { a: [5, 6, 7, 8] };
    print("field");
    show(p.a.iter().sum());
    print(" for");
    var t = 0;
    for x in p.a {
        t += x;
    }
    show(t);
    let q = p;
    show(unsafe { q.a.iter().fold(0, |s, x| s + x) });
    println("");
    print("static");
    show(TABLE.iter().take(1).sum());
    show(TABLE.iter().sum());
    let rows = [[1, 2], [3, 4]];
    print(" rows");
    let r1: i64 = rows[1].iter().sum();
    show(r1 - rows[0].iter().count());
    show(rows.iter().map(|r| r[1]).sum());
    println("");
    print("map");
    for x in a.iter().map(|x| x * 2) {
        show(x);
    }
    print(" | filter");
    show(a.iter().filter(|x| x % 2 == 1).count());
    println("");
    0
}
