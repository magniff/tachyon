// (0.25 semantics audit, views) A view read out of a local Vec by index
// keeps what the element views: `let r = v[0]` of a Vec<[i64]> views b,
// so growing b while r is used is own.conflict. No function is involved.
// XFAIL: SOUNDNESS v[i] of a Vec of views loses the element's origin: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var b: Vec<i64> = Vec::new_in(gpa);
    b.push(1);
    var v: Vec<[i64]> = Vec::new_in(gpa);
    v.push(b.as_slice());
    let r = v[0];
    for i in 0..100 { b.push(i); }
    println(r[0]);
    0
}
