// FLAGS: --check-alloc
// EXIT: 101
// EXPECT: 2
// STDERR: use after free: block #1 (32 bytes), allocated at
// STDERR: checkalloc_uaf_copy.tach:20:5, freed at
// STDERR: checkalloc_uaf_copy.tach:24:5
// 0.16: --check-alloc, the checking Gpa: a Vec used after its free
// through a copied handle (a copy shares the memory: the gap 0.17's moves
// close) faults, reported with where the block was allocated and freed.
fn sum(v: Vec<i64>) -> i64 {
    let mut t = 0;
    for x in v.iter() {
        t += x;
    }
    t
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(1);
    let copy = v;
    println(f"{sum(copy)}");
    v.free();
    println(f"{sum(copy)}");
}
