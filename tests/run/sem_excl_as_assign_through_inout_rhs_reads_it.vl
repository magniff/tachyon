// the right side reads the place through the same access
// EXPECT: 2 1
fn rot(v: inout Vec<i64>, gpa: Gpa) { var n: Vec<i64> = Vec::new_in(gpa); n.push(v[1]); n.push(v[0]); v = n; }
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); v.push(1); v.push(2); rot(&v, gpa); println(f"{v[0]} {v[1]}"); }
