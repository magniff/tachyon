// x as i8 is negative for 200.
// EXIT: 101
// STDERR: index out of bounds: index -56, length 128
static var Z: i64 = 0;

#[inline(never)]
fn f(a: [i64; 128], x: i64) -> i64 { a[x as i8] }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(big, 200 + Z));
    0
}
