// The example in README.md.
// EXPECT: 10.14 2
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

enum Shape { Circle(f64), Rect(f64, f64), Empty }

impl Shape {
    fn area(self: Shape) -> f64 {
        match self {
            Shape::Circle(r) => 3.14159 * r * r,
            Shape::Rect(w, h) => w * h,
            Shape::Empty => 0.0,
        }
    }
}

fn main() -> i32 {
    let shapes: [Shape; 3] = [Shape::Circle(1.0), Shape::Rect(2.0, 3.5), Shape::Empty];
    let mut total = 0.0;
    for i in 0..3 {
        total += shapes[i].area();
    }
    let middle = shapes[1..];
    unsafe { printf(c"%.2f %lu\n", total, middle.len); }
    0
}
