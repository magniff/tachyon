// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 2
// EXPECT: 2
struct P { q: inout Vec<i64> }
impl P { fn add(inout self, x: i64) { self.q.push(x); } }
fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    var p = P { q: &v };
    p.add(1);
    p.add(2);
    println(v.len());
    0
}
