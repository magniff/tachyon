// collect_in of an iterator of owned items: the Vec owns them; every R dropped once
// FLAGS: --check-alloc
// EXPECT: 2
// EXPECT: drop 1
// EXPECT: drop 0
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;

    fn next(inout self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        Some(R { id: self.n })
    }
}

fn main(gpa: Gpa) {
    let v = Gen { n: 2 }.collect_in(gpa);
    println(f"{v.len()}");
}
