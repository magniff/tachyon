// A closure that makes and calls another closure.
// ERROR: 'quiet' is #[no_io], but it does io
#[no_io]
fn quiet(x: i64) -> i64 {
    let outer = |y: i64| {
        let inner = |z: i64| { println("io"); z };
        inner(y)
    };
    outer(x)
}

fn main() -> i32 {
    println(quiet(3));
    0
}
