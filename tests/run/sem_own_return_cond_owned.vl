// sem-own: returning one of two owned locals: the other dropped in the callee.
// EXPECT: drop 2
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: got 2
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
fn f(c: bool, gpa: Gpa) -> D { let a = mk(1, gpa); let b = mk(2, gpa); if c { a } else { b } }

fn main(gpa: Gpa) {
    { let d = f(true, gpa); println(f"got {d.id}"); }
    { let d = f(false, gpa); println(f"got {d.id}"); }
}
