// Bodies and branches that end in return, break or an endless loop need no
// tail value.
// EXPECT: -1 0 1 64 11 1000 27
extern fn printf(format: *u8, ...) -> i64;

fn sign(x: i64) -> i64 {
    if x < 0 { return 0 - 1; } else if x == 0 { return 0; } else { return 1; }
}

fn first_square_above(n: i64) -> i64 {
    let mut i = 0;
    loop {
        if i * i > n { return i * i; }
        i += 1;
    }
}

fn classify(x: i64) -> i64 {
    let r: i64 = if x > 100 { return 1000; } else { x * 2 };
    r + 1
}

fn main() -> i64 {
    let mut i = 0;
    let mut found: i64 = 0;
    loop {
        let v: i64 = if i < 10 { i * 3 } else { break; };
        if v > 20 { found = v; }
        i += 1;
    }
    printf(c"%ld %ld %ld %ld %ld %ld %ld\n", sign(0 - 9), sign(0), sign(9), first_square_above(50), classify(5), classify(500), found);
    0
}
