// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: abcd (a trait default method returning a view of self)
// EXPECT: abcd 7
struct E { name: [u8; 4], len: i64 }

trait N {
    fn raw(self) -> [u8];
    fn nm(self) -> [u8] { self.raw() }
}

impl N for E { fn raw(self) -> [u8] { self.name[..self.len] } }
fn clobber() -> i64 { let z = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: ['a', 'b', 'c', 'd'], len: 4 };
    let n = e.nm();
    let k = clobber();
    println(f"{n} {k}");
    0
}
