// sem-own: `inout r = &x; let y = r;` moves out of an access: own.move_out.
// Accepted: the binding is a borrow (the let-as-borrow rule), dropped once by its owner.
// EXPECT: drop 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var x = mk(1, gpa);
    inout r = &x;
    let y = r;
}
