// 0.16: std's containers on an allocator, Gpa (C's malloc) by default; a
// program's Gpa is the one its main takes, passed down. A Vec on Gpa is
// three words; growth and frees go through the allocator.
// EXPECT: 24 40 24 0
// EXPECT: 4950 99 hello 42
// EXPECT: [1, 2, 3] 3
fn total(v: Vec<i64>) -> i64 {
    var t = 0;
    for x in v.iter() {
        t += x;
    }
    t
}

fn fill(gpa: Gpa) -> Vec<i64, Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 {
        v.push(i);
    }
    v
}

fn main(gpa: Gpa) {
    println(
        f"{size_of(Vec<i64>)} {size_of(std::HashMap<i64, i64>)} {size_of(std::Buf)} {size_of(Gpa)}");
    var v = fill(gpa);
    var m: std::HashMap<i64, i64> = std::HashMap::new_in(gpa);
    for i in 0..100 {
        m.insert(i, i * i);
    }
    var b: std::Buf = std::Buf::new_in(gpa);
    b.push_str("hello ");
    b.push_int(42);
    var w: Vec<i64> = Vec::with_capacity_in(2, gpa);
    w.extend_from_slice([1, 2, 3][0..3]);
    var c = w.clone();
    println(f"{total(v)} {m.len() - 1} {b.as_slice()}");
    println(f"{c:?} {c.len()}");
    let p = gpa.alloc(64, 64);
    unsafe {
        p[63] = 7;
        gpa.free(p, 64, 64);
    }
    v.free();
    m.free();
    b.free();
    w.free();
    c.free();
}
