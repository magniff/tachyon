// i + 1 < len with i == -1: s[i] is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index -1, length 8
static var Z: i64 = 0;

#[inline(never)]
fn f(s: [i64], i: i64) -> i64 { let j = i + 1; if j < s.len() { s[i] } else { 0 } }

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let a = [0, 1, 2, 3, 4, 5, 6, 7];
    let s = a[..];
    let big = [0; 128];
    println(f(s, -1 + Z));
    0
}
