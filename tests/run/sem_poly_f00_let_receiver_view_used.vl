// the let-receiver bug with a view used after: h views s.v, s.grow() on a let s, then h read
// ERROR: [own.conflict]: 's.grow()' may change 's.v' while 'h'
struct S { v: Vec<i64> }
impl S { fn grow(inout self) { for i in 0..1000 { self.v.push(i); } } }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(7);
    let s = S { v: v };
    let h = s.v.as_slice();
    s.grow();
    println(f"{h[0]} {s.v.len()}");
}
