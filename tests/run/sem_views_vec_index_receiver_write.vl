// (0.25 semantics audit, views) An inout method called on a Vec's
// element through its index place (`owners[0].push_str(..)`,
// `vv[0].push(i)`) changes the element, so it conflicts with a view into
// that element. `grow(&owners[0])`, `owners[0] = ..` and an array's
// `a[0].push_str(..)` are caught; the method receiver through a Vec index
// is not.
// XFAIL: SOUNDNESS an inout receiver through a Vec index place ignores views of the element: use after free
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var owners: Vec<String> = Vec::new_in(gpa);
    owners.push(String::from_in("hello", gpa));
    let w = owners[0].as_str();
    owners[0].push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(w);
    0
}
