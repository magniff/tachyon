// EXPECT: 5 abs
// EXPECT: from io 12
// EXPECT: strlen 3
// `import "h.h" as c;` (0.5): the C declarations through a name; an
// import in another module.
mod io;

import "stdlib.h" as c;

fn abs(x: i64) -> i64 {
    if x < 0 { -x } else { x }
}

fn main() -> i32 {
    unsafe {
        io::say(abs(-5) as i32, c::abs(-12));
        io::say_len(c"abc");
    }
    0
}
