// a trait's function without self, called through a type parameter
// FLAGS: --check-alloc
// EXPECT: 9 4
trait Mk { fn make() -> Self; }
struct P { x: i64 }
impl Mk for P { fn make() -> P { P { x: 9 } } }
impl Mk for i64 { fn make() -> i64 { 4 } }
fn build<T: Mk>() -> T { T::make() }
fn main() { let p: P = build(); let n: i64 = build(); println(f"{p.x} {n}"); }
