// requires on a method, checked at a method call.
// EXPECT: 3
// EXIT: 101
// STDERR: requires failed: 'k <= self.n' of 'S::take'
static var Z: i64 = 0;
struct S { n: i64 }
impl S {
    fn take(self, k: i64) -> i64
        requires k <= self.n
    {
        self.n - k
    }
}

fn main() -> i32 {
    Z = std::env::args().len() - 1;
    let s = S { n: 5 };
    println(s.take(2 + Z));
    println(s.take(9 + Z));
    0
}
