// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a user iterator struct holding a slice, owner pushed
// ERROR: error[own.conflict]
struct It { s: [i64], i: i64 }

impl Iterator for It {
    type Item = i64;

    fn next(inout self) -> Option<i64> {
        if self.i < self.s.len() { self.i += 1; Some(self.s[self.i - 1]) } else { None }
    }
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    var it = It { s: v.as_slice(), i: 0 };
    for i in 0..100 { v.push(i); }
    println(it.next().unwrap());
    0
}
