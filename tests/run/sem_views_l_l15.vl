// ERROR: error[own.escape]
struct E { name: [u8; 8], len: i64 }
fn nm(e: E) -> [u8] { let c = e.name; c[..e.len] }
fn main() -> i32 {
    let e = E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 };
    println(nm(e));
    0
}
