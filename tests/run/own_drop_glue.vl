// 0.17 (value semantics, T1): drop glue. A struct's fields drop in
// declaration order after its own Drop; an enum drops the payload of its
// variant (a match); an array its elements; a tuple its elements; a move
// closure its captures. A value moved on some paths only drops under a
// flag; an owned assignment drops the old value; a temporary drops at the
// end of its statement; drop(x) drops, forget(x) does not; needs_drop folds.
// FLAGS: --values=error
// EXPECT: consume 1
// EXPECT: drop 1
// EXPECT: maybe end
// EXPECT: maybe end
// EXPECT: drop 1
// EXPECT: drop 10
// EXPECT: after first assign
// EXPECT: consume 11
// EXPECT: drop 11
// EXPECT: reassign end
// EXPECT: drop 12
// EXPECT: partial moved a
// EXPECT: consume 20
// EXPECT: drop 20
// EXPECT: drop 21
// EXPECT: enums end
// EXPECT: drop 31
// EXPECT: drop 30
// EXPECT: arrays end
// EXPECT: drop 40
// EXPECT: drop 41
// EXPECT: drop 50
// EXPECT: temps after
// EXPECT: circle 60 2
// EXPECT: drop 60
// EXPECT: match end
// EXPECT: tuple end
// EXPECT: drop 73
// EXPECT: drop 72
// EXPECT: drop 70
// EXPECT: drop 71
// EXPECT: closure 80
// EXPECT: drop 80
// EXPECT: true false true true
// EXPECT: drop 91
// EXPECT: main end
struct Noisy { id: i64 }

impl Drop for Noisy {
    fn drop(inout self) { println(f"drop {self.id}"); }
}

enum Shape { Circle(Noisy, i64), Square { side: Noisy }, Empty }
struct Holder { a: Noisy, b: Noisy }
fn make(id: i64) -> Noisy { Noisy { id: id } }
fn consume(n: sink Noisy) { println(f"consume {n.id}"); }

fn maybe(flag: bool) {
    let x = make(1);
    if flag { consume(x); }
    println("maybe end");
}

fn reassign() {
    var x = make(10);
    x = make(11);
    println("after first assign");
    consume(x);
    x = make(12);
    println("reassign end");
}

fn partial() {
    let h = Holder { a: make(20), b: make(21) };
    let a = h.a;
    println("partial moved a");
    consume(a);
}

fn enums() {
    let s = Shape::Circle(make(30), 1);
    let q = Shape::Square { side: make(31) };
    let e = Shape::Empty;
    println("enums end");
}

fn arrays() {
    let arr = [make(40), make(41)];
    println("arrays end");
}

fn temps() {
    make(50);
    println("temps after");
}

fn matching() {
    let s = Shape::Circle(make(60), 2);
    match s {
        Shape::Circle(n, k) => { println(f"circle {n.id} {k}"); }
        _ => {}
    }
    println("match end");
}

fn tuple() {
    let t = (make(70), 3, make(71));
    let (a, b, c) = (make(72), 4, make(73));
    println("tuple end");
}

fn closure() {
    let n = make(80);
    let c = sink || n.id;
    println(f"closure {c()}");
}

fn main() {
    maybe(true);
    maybe(false);
    reassign();
    partial();
    enums();
    arrays();
    temps();
    matching();
    tuple();
    closure();
    println(
        f"{needs_drop::<Noisy>()} {needs_drop::<i64>()} {needs_drop::<Holder>()} {needs_drop::<Shape>()}");
    let f = make(90);
    forget(f);
    drop(make(91));
    println("main end");
}
