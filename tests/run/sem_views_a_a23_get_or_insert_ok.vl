// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 2 1
// EXPECT: 2 1
fn main(gpa: Gpa) -> i32 {
    var m: HashMap<[u8], i64> = HashMap::new_in(gpa);
    for w in ["a", "b", "a"] { m.get_or_insert(w, 0)[0] += 1; }
    println(f"{m.get("a").unwrap()} {m.get("b").unwrap()}");
    0
}
