// a method with inout self on a static, which writes the static by name.
// FLAGS: -O2
// XFAIL: SOUNDNESS G.bump() (inout self) with bump writing G by name: -O0 99, -O1/-O2 5
// EXPECT: 99
struct Big { a: i64, b: i64, c: i64, d: i64 }

static var G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

impl Big {
    #[inline(never)]
    fn bump(inout self) -> i64 { self.a = 5; G.a = 99; self.a }
}

fn main() -> i32 { println(G.bump()); 0 }
