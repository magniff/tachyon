// EXPECT: helper in root 1
// EXPECT: helper in util 2
// EXPECT: area 12
// EXPECT: circle 3
// EXPECT: perimeter 14
// EXPECT: counter 3
// EXPECT: limit 100
// EXPECT: max 9
// EXPECT: biggest 7
// EXPECT: id 5
// EXPECT: oblong
// A program of several modules (0.5): `mod`, `pub`, paths, `use` (with
// `as` and braces), `self`, `super` and `crate`, items of the same name in
// different modules.
mod util;
mod geometry;

use geometry::shapes::{Shape, area};
use geometry::shapes::Rect as Box;
use util::{LIMIT, bump};

extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn helper() -> i64 {
    1
}

fn main() -> i32 {
    unsafe {
        printf(c"helper in root %ld\n", helper());
        printf(c"helper in util %ld\n", util::helper());
    }
    let r = Box { w: 3, h: 4 };
    unsafe {
        printf(c"area %ld\n", area(Shape::Rect(r)));
        printf(c"circle %ld\n", area(Shape::Circle(1)));
        printf(c"perimeter %ld\n", geometry::perimeter(r));
    }
    bump();
    bump();
    bump();
    unsafe {
        printf(c"counter %ld\n", util::count());
        printf(c"limit %ld\n", LIMIT);
        printf(c"max %ld\n", util::max(9, 2));
        printf(c"biggest %ld\n", crate::geometry::shapes::biggest([3, 7, 5]));
        printf(c"id %ld\n", geometry::id::<i64>(5));
    }
    match geometry::classify(r) {
        geometry::Kind::Square => unsafe { printf(c"square\n") },
        geometry::Kind::Oblong => unsafe { printf(c"oblong\n") },
    };
    0
}
