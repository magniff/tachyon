// A grandchild module: it reaches its parent with `super` and the root
// with `crate`.

pub struct Rect { pub w: i64, pub h: i64 }

pub enum Shape { Rect(Rect), Circle(i64) }

pub fn area(s: Shape) -> i64 {
    match s {
        Shape::Rect(r) => r.w * r.h,
        Shape::Circle(r) => 3 * r * r,
    }
}

pub fn biggest(xs: [i64; 3]) -> i64 {
    let mut best = xs[0];
    for x in xs {
        best = super::super::util::max(best, x);
    }
    best
}

fn unused() -> super::Kind {
    super::Kind::Square
}
