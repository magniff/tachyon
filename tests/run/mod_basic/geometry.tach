// A module with a child module (geometry/shapes.tach).
pub mod shapes;

use self::shapes::Rect;

pub enum Kind { Square, Oblong }

pub fn perimeter(r: Rect) -> i64 {
    2 * (r.w + r.h) - double_square_side(r)
}

fn double_square_side(r: Rect) -> i64 {
    if r.w == r.h { 0 } else { 0 }
}

pub fn classify(r: Rect) -> Kind {
    if r.w == r.h { Kind::Square } else { Kind::Oblong }
}

pub fn id<T>(x: T) -> T {
    x
}
