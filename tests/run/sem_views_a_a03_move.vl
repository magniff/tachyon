// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: v moved while sl used
// ERROR: error[own.conflict]
fn eat(v: sink Vec<i64>) { println(v.len()); }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let sl = v.as_slice();
    eat(v);
    println(sl[0]);
    0
}
