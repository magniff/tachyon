// (0.19) Every 0.10 vector operation on the new 64-bit vector types (unsigned
// lanes, 64-bit and 256-bit vectors: docs/design/arch.md §2.2), every lane
// printed: the same answers at every level (-O0 computes lane by lane).
// (A 64-bit vector is the low half of a 128-bit register.)
// CROSS: x86_64-linux
fn main() {
    let V8i8a = v8i8(0, 127, 5, 1, -128, 100, -1, -3);
    let V8i8b = v8i8(-3, 0, 127, 5, 1, -128, 100, -1);
    { let r = V8i8a + V8i8b; print("v8i8 +:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8i8a - V8i8b; print("v8i8 -:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8i8a * V8i8b; print("v8i8 *:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8i8a & V8i8b; print("v8i8 &:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8i8a | V8i8b; print("v8i8 |:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8i8a ^ V8i8b; print("v8i8 ^:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8i8a == V8i8b); print("v8i8 ==:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8i8a != V8i8b); print("v8i8 !=:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8i8a < V8i8b); print("v8i8 <:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8i8a <= V8i8b); print("v8i8 <=:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8i8a > V8i8b); print("v8i8 >:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8i8a >= V8i8b); print("v8i8 >=:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V8i8a; print("v8i8 neg:"); for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V8i8a < V8i8b).select(V8i8a, V8i8b); print("v8i8 sel:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    println(f"v8i8 sum {V8i8a.sum()} {V8i8b.sum()} lane {V8i8a.lane(7)} {V8i8a.lane(0)}");
    { let r = v8i8::splat(V8i8b.lane(7)); print("v8i8 splat:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V8i8a.with_lane(7, V8i8b.lane(0)); print("v8i8 with:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { var k = 0; var s = 0 as i8;
        while k < 8 { s = s + V8i8b.lane(k); k += 1; } let w = V8i8a.with_lane(k - 1, s);
        print("v8i8 var:"); for i in 0..8 { print(f" {w.lane(i)}"); } println(""); }
    { var arr: [i8; 10] = [0 as i8; 10]; V8i8a.store(arr, 1);
        let r = v8i8::load(arr, 1) + v8i8::load(arr[0..10], 2); print("v8i8 mem:");
        for i in 0..8 { print(f" {r.lane(i)}"); } println(""); }
    { var c = V8i8a; c += V8i8b; c *= V8i8b; print("v8i8 acc:");
        for i in 0..8 { print(f" {c.lane(i)}"); } println(""); }
    let V4i16a = v4i16(0, 32767, 5, 1);
    let V4i16b = v4i16(-3, 0, 32767, 5);
    { let r = V4i16a + V4i16b; print("v4i16 +:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4i16a - V4i16b; print("v4i16 -:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4i16a * V4i16b; print("v4i16 *:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4i16a & V4i16b; print("v4i16 &:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4i16a | V4i16b; print("v4i16 |:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4i16a ^ V4i16b; print("v4i16 ^:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4i16a == V4i16b); print("v4i16 ==:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4i16a != V4i16b); print("v4i16 !=:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4i16a < V4i16b); print("v4i16 <:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4i16a <= V4i16b); print("v4i16 <=:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4i16a > V4i16b); print("v4i16 >:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4i16a >= V4i16b); print("v4i16 >=:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V4i16a; print("v4i16 neg:"); for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V4i16a < V4i16b).select(V4i16a, V4i16b); print("v4i16 sel:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    println(f"v4i16 sum {V4i16a.sum()} {V4i16b.sum()} lane {V4i16a.lane(3)} {V4i16a.lane(0)}");
    { let r = v4i16::splat(V4i16b.lane(3)); print("v4i16 splat:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V4i16a.with_lane(3, V4i16b.lane(0)); print("v4i16 with:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { var k = 0; var s = 0 as i16;
        while k < 4 { s = s + V4i16b.lane(k); k += 1; } let w = V4i16a.with_lane(k - 1, s);
        print("v4i16 var:"); for i in 0..4 { print(f" {w.lane(i)}"); } println(""); }
    { var arr: [i16; 6] = [0 as i16; 6]; V4i16a.store(arr, 1);
        let r = v4i16::load(arr, 1) + v4i16::load(arr[0..6], 2); print("v4i16 mem:");
        for i in 0..4 { print(f" {r.lane(i)}"); } println(""); }
    { var c = V4i16a; c += V4i16b; c *= V4i16b; print("v4i16 acc:");
        for i in 0..4 { print(f" {c.lane(i)}"); } println(""); }
    let V2i32a = v2i32(0, 2147483647);
    let V2i32b = v2i32(-3, 0);
    { let r = V2i32a + V2i32b; print("v2i32 +:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2i32a - V2i32b; print("v2i32 -:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2i32a * V2i32b; print("v2i32 *:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2i32a & V2i32b; print("v2i32 &:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2i32a | V2i32b; print("v2i32 |:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2i32a ^ V2i32b; print("v2i32 ^:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2i32a == V2i32b); print("v2i32 ==:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2i32a != V2i32b); print("v2i32 !=:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2i32a < V2i32b); print("v2i32 <:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2i32a <= V2i32b); print("v2i32 <=:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2i32a > V2i32b); print("v2i32 >:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2i32a >= V2i32b); print("v2i32 >=:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V2i32a; print("v2i32 neg:"); for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V2i32a < V2i32b).select(V2i32a, V2i32b); print("v2i32 sel:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    println(f"v2i32 sum {V2i32a.sum()} {V2i32b.sum()} lane {V2i32a.lane(1)} {V2i32a.lane(0)}");
    { let r = v2i32::splat(V2i32b.lane(1)); print("v2i32 splat:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V2i32a.with_lane(1, V2i32b.lane(0)); print("v2i32 with:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { var k = 0; var s = 0 as i32;
        while k < 2 { s = s + V2i32b.lane(k); k += 1; } let w = V2i32a.with_lane(k - 1, s);
        print("v2i32 var:"); for i in 0..2 { print(f" {w.lane(i)}"); } println(""); }
    { var arr: [i32; 4] = [0 as i32; 4]; V2i32a.store(arr, 1);
        let r = v2i32::load(arr, 1) + v2i32::load(arr[0..4], 2); print("v2i32 mem:");
        for i in 0..2 { print(f" {r.lane(i)}"); } println(""); }
    { var c = V2i32a; c += V2i32b; c *= V2i32b; print("v2i32 acc:");
        for i in 0..2 { print(f" {c.lane(i)}"); } println(""); }
    let V1i64a = v1i64(0);
    let V1i64b = v1i64(-3);
    { let r = V1i64a + V1i64b; print("v1i64 +:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V1i64a - V1i64b; print("v1i64 -:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V1i64a * V1i64b; print("v1i64 *:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V1i64a & V1i64b; print("v1i64 &:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V1i64a | V1i64b; print("v1i64 |:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = V1i64a ^ V1i64b; print("v1i64 ^:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V1i64a == V1i64b); print("v1i64 ==:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V1i64a != V1i64b); print("v1i64 !=:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V1i64a < V1i64b); print("v1i64 <:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V1i64a <= V1i64b); print("v1i64 <=:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V1i64a > V1i64b); print("v1i64 >:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V1i64a >= V1i64b); print("v1i64 >=:");
        for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = -V1i64a; print("v1i64 neg:"); for i in 0..1 { print(f" {r.lane(i)}"); } println(""); }
    { let r = (V1i64a < V1i64b).select(V1i64a, V1i64b); print("v1i64 sel:");
