// a trait inout-self method on a let binding of an owned type: the let Vec grows
// ERROR: [own.readonly]
// XFAIL: WRONG an inout-self method on a let binding of an owned type is accepted (the let Vec grows)
trait B { fn grow(inout self); }
struct S { v: Vec<i64> }
impl B for S { fn grow(inout self) { self.v.push(1); } }

fn main(gpa: Gpa) {
    let s = S { v: Vec::new_in(gpa) };
    s.grow();
    s.grow();
    println(f"{s.v.len()}");
}
