// 0.17: `p.0` through a pointer to a tuple is `(*p).0`, as `p.x` is for
// a struct: read and assign, in a closure's parameters too.
// EXPECT: 3 40
// EXPECT: b1 a2
fn sum(p: *(i64, i64)) -> i64 { p.0 + p.1 }

fn set(p: *(i64, i64), x: i64) { p.1 = x; }

fn main(gpa: Gpa) -> i32 {
    let mut t = (1, 2);
    let s = sum(&t);
    set(&t, 40);
    println(f"{s} {t.1}");
    let mut v: Vec<([u8], i64)> = Vec::new_in(gpa);
    defer v.free();
    v.push(("a", 2));
    v.push(("b", 1));
    sort_by(v.as_slice(), |a, b| a.1 - b.1);
    println(f"{v[0].0}{v[0].1} {v[1].0}{v[1].1}");
    0
}
