// scoped threads return owned values through join: each dropped once
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: 3
use std::thread;
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }

fn main() {
    let t = thread::scope(|s| {
        let a = s.spawn(|| R { id: 1 });
        let b = s.spawn(|| R { id: 2 });
        let x = a.join();
        let y = b.join();
        x.id + y.id
    });
    println(f"{t}");
}
