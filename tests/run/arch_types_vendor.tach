// EXPECT: alias 513 2 3 4
// EXPECT: tuple 1 17 33
// EXPECT: raw 7 7 37
// EXPECT: intel 4 2
// EXPECT: 64 3.5 254 65535
// (0.19) The vendor types of std::arch: ACLE's are aliases of the portable
// vectors (their `from_bits`, `splat` and `load` through the alias), with
// their tuples (`uint8x16x2_t`); Intel's are opaque, converted with
// `from_bits` both ways; the raw:: pointer forms of the memory intrinsics,
// unsafe, at every level.
// CROSS: x86_64-linux
use std::arch::aarch64::{
    float32x2_t, raw, uint16x4_t, uint16x8_t, uint8x16_t, uint8x16x2_t, uint8x8_t, vaddq_u8,
    vld1q_u8,
};
use std::arch::x86_64::__m128i;

fn pair(s: [u8], i: i64) -> uint8x16x2_t {
    (vld1q_u8(s, i), vld1q_u8(s, i + 16))
}

fn main() {
    let mut s: [u8; 48] = [0; 48];
    for k in 0..48 {
        s[k] = k as u8 + 1;
    }
    let a: uint8x16_t = vld1q_u8(s[..], 0);
    let wide = uint16x8_t::from_bits(a);
    let three = uint8x16_t::splat(3);
    let loaded = uint8x16_t::load(s[..], 1);
    println(f"alias {wide.lane(0)} {(three - a).lane(0)} {three.lane(15)} {loaded.lane(2)}");
    let (x, y): uint8x16x2_t = pair(s[..], 0);
    let t: uint8x16x2_t = pair(s[..], 16);
    println(f"tuple {x.lane(0)} {y.lane(0)} {t.1.lane(0)}");
    let c = unsafe { raw::vld1q_u8(&s[7]) };
    let d = vaddq_u8(a - v16u8::splat(1), c - v16u8::splat(1));
    unsafe { raw::vst1q_u8(&mut s[16], d); }
    println(f"raw {c.lane(0) - 1} {s[16]} {s[31]}");
    let m: __m128i = __m128i::from_bits(a + a);
    let back = v4u32::from_bits(m);
    println(f"intel {v16u8::from_bits(m).lane(1)} {back.lane(0) & 255}");
    let f: float32x2_t = v2f32(1.5, 2.0);
    let b: uint8x8_t = uint8x8_t::splat(254);
    let h = uint16x4_t::from_bits(v8u8::splat(255));
    println(f"64 {f.sum()} {b.lane(7)} {h.lane(3)}");
}
