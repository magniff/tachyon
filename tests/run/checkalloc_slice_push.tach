// FLAGS: --check-alloc --values=off
// EXIT: 101
// EXPECT: 0 1 2 3
// STDERR: use after free: block #1 (32 bytes), allocated at
// STDERR: checkalloc_slice_push.tach:12:9, freed at
// STDERR: checkalloc_slice_push.tach:16:5
// 0.16 (0.17 rejects this code: --values=off, 0.16's semantics): --check-alloc: every resize moves the block, so a slice taken
// before a push that grows the Vec reads freed pages, and faults.
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..4 {
        v.push(i);
    }
    let s = v.as_slice();
    println(f"{s[0]} {s[1]} {s[2]} {s[3]}");
    v.push(4);
    println(f"{s[0]}");
}
