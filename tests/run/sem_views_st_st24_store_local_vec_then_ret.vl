// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a local Vec<str> of views of s, s grows, an element returned
// ERROR: error[own.conflict]
fn f(s: inout String, gpa: Gpa) -> str {
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    v.get(0)
}
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    println(f(&s, gpa));
    0
}
