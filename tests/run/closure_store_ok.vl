// ok: a closure stores views of what outlives it into a capture
// EXPECT: 3 3
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(3);
    var out: Vec<[i64]> = Vec::new_in(gpa);
    let s = v.as_slice();
    let f = |x: i64| out.push(s);
    f(1);
    (0..2).for_each(|i| out.push(s));
    println(f"{out.len()} {out[0][0]}");
}
