// A binding that borrows (a match through a reference, `match *e`; a copy
// `v.get(i)` reads; a `for` loop's element) is a bitwise copy of an owned
// value it does not own: changing it (a push that moves the elements, an
// assignment that drops the old value) would free memory the original
// still points to (0.18.0 let it: a use after free). 0.18.1: own.readonly,
// and `match e` binds `&mut` references that change the original.
// ERROR: changes 'v' (Vec<i64>), a copy the match on '*e'
// ERROR: changes 'w' (Vec<i64>), a copy of an element 'vv.get(0)' reads
// ERROR: changes 'w' (Vec<i64>), a copy of a loop's element
// ERROR: changes 'v' (Vec<i64>), a copy the match on '*e'
enum E { A(i64), B(Vec<i64>), C }

fn g(e: inout E) {
    match e {
        E::B(v) => { for i in 0..1000 { v.push(i); } }
        _ => {}
    }
}

fn g2(vv: inout Vec<Vec<i64>>) {
    var w = vv.get(0);
    w.push(1);
}

fn g3(vv: inout Vec<Vec<i64>>) {
    for w in vv { w.push(1); }
}

fn g4(e: inout E, gpa: Gpa) {
    match e {
        E::B(var v) => { v = Vec::new_in(gpa); }
        _ => {}
    }
}

// (what is fine: reading the copies, and changing through references)
fn ok(e: inout E, vv: inout Vec<Vec<i64>>) -> i64 {
    match e {
        E::B(v) => { for i in 0..10 { v.push(i); } }
        _ => {}
    }
    vv[0].push(1);
    match e { E::B(v) => v.len(), E::A(x) => x, E::C => 0 }
}

fn main(gpa: Gpa) {}
