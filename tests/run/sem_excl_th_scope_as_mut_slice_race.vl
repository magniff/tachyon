// ERROR: sync
use std::thread;
fn bump(s: inout [i64]) { for i in 0..1000000 { s[0] += 1; } }
fn main(gpa: Gpa) { var v: Vec<i64> = Vec::new_in(gpa); v.push(0); thread::scope(|sc| { let x = sc.spawn(|| { bump(v.as_mut_slice()); 0 }); let y = sc.spawn(|| { bump(v.as_mut_slice()); 0 }); x.join() + y.join() }); println(f"{v[0]}"); }
