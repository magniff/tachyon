// EXPECT: 4950 2070
// CHECK: = intr.vqsubq_u8 v
// CHECK-NOT: vqsubq_u8
// CHECK: = vbin.add v
// CHECK: = intr.vmaxvq_u8 v
// (0.19 Phase 0) The optimizer sees std::arch's intrinsics: two equal
// calls are one (GVN: the add's operands are the same value), loop-
// invariant ones leave the loop (LICM, into the unrolled loop's
// preheaders), generic forms are 0.10's vector operations (vbin).
use std::arch::aarch64::{vaddq_u8, vdupq_n_u8, vld1q_u8, vmaxvq_u8, vqsubq_u8};

#[inline(never)]
fn work(s: [u8], n: i64, c: u8) -> u64 {
    let a = vld1q_u8(s, 0);
    let k = vdupq_n_u8(c);
    var acc: u64 = 0;
    var i = 0;
    while i < n {
        let t = vqsubq_u8(a, k);
        let u = vqsubq_u8(a, k);
        acc += vmaxvq_u8(vaddq_u8(t, u)) as u64 + i as u64;
        i += 1;
    }
    acc
}

fn main() {
    if !std::arch::has("neon") {
        println("4950 2070");
        return;
    }
    var buf: [u8; 16] = [0; 16];
    for i in 0..16 {
        buf[i] = i as u8;
    }
    // max of 2 * (s[k] - 3) is 24: 100 * 24 + 4950 - 2400 ... printed apart
    println(f"{work(buf[..], 100, 3) - 2400} {work(buf[..], 45, 3)}");
}
