// a default let-self method calling an inout-self method, on an owned type viewed meanwhile
// ERROR: [own.readonly]: writes through 'self', a 'let S', which is read-only
// ERROR: [own.readonly]: writes through 'self', a 'let S', which is read-only
trait C {
    fn grow(inout self);
    fn twice(self) { self.grow(); self.grow(); }
}

struct S { v: Vec<i64> }
impl C for S { fn grow(inout self) { for i in 0..1000 { self.v.push(i); } } }

fn main(gpa: Gpa) {
    var s = S { v: Vec::new_in(gpa) };
    s.v.push(7);
    let h = s.v.as_slice();
    s.twice();
    println(f"{h[0]} {s.v.len()}");
}
