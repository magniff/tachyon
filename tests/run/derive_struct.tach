// EXPECT: P { x: 0, y: 9 } P { x: 1, y: 2 } P { x: 1, y: 3 }
// EXPECT: lt true eq true cmp -1 1 0
// EXPECT: map 20 10 none len 2
// EXPECT: same hash true
// EXPECT: Named { id: 7, name: "seven", at: P { x: 1, y: 2 } }
// EXPECT: Empty
// EXPECT: deep 3 1
// EXPECT: buf ab a
// 0.15: #[derive(Eq, Ord, Hash, Debug, Clone)] on structs: Ord is
// lexicographic over the fields in their order (so `<` and std::sort use
// it), Hash keys a HashMap, Debug is Rust's text, Clone of a Vec field is
// deep, Eq is the structural ==.
use std::{Buf, Fmt, HashMap, sort};

#[derive(Eq, Ord, Hash, Debug, Clone)]
struct P { x: i64, y: i64 }

#[derive(Debug, Ord, Eq, Hash)]
struct Named { id: i64, name: [u8], at: P }

#[derive(Debug, Clone, Ord, Hash)]
struct Empty {}

#[derive(Clone)]
struct Bag { items: Vec<i64>, label: Buf, n: i64 }

fn show<T: std::Debug>(x: *T) {
    let mut f = Fmt::to_fd(1);
    f.debug(x);
}

fn main() {
    let a = P { x: 1, y: 2 };
    let b = P { x: 1, y: 3 };
    let mut v: Vec<P> = Vec::new();
    defer v.free();
    v.push(b);
    v.push(a);
    v.push(P { x: 0, y: 9 });
    sort(v.as_slice());
    for i in 0..v.len() {
        if i > 0 {
            print(" ");
        }
        show(&v.as_slice()[i]);
    }
    println("");

    print("lt ");
    print(if a < b { "true" } else { "false" });
    print(" eq ");
    let a2 = P { x: 1, y: 2 };
    print(if a == a2 { "true" } else { "false" });
    print(" cmp ");
    std::print_int(a.cmp(&b));
    print(" ");
    std::print_int(b.cmp(&a));
    print(" ");
    std::print_int(a.cmp(&a));
    println("");

    let mut m: HashMap<P, i64> = HashMap::new();
    defer m.free();
    m.insert(a, 10);
    m.insert(b, 20);
    m.insert(P { x: 1, y: 2 }, 10);
    print("map ");
    std::print_int(m.get(P { x: 1, y: 3 }).unwrap());
    print(" ");
    std::print_int(m.get(a).unwrap());
    print(if m.get(P { x: 2, y: 1 }).is_none() { " none" } else { " some" });
    print(" len ");
    std::print_int(m.len());
    println("");

    let n1 = Named { id: 7, name: "seven", at: a };
    let n2 = Named { id: 7, name: "seven", at: P { x: 1, y: 2 } };
    print("same hash ");
    println(if n1.hash() == n2.hash() && n1 == n2 && n1.cmp(&n2) == 0 { "true" } else { "false" });
    show(&n1);
    println("");
    let e = Empty {};
    let e2 = e.clone();
    show(&e2);
    println("");

    let mut items: Vec<i64> = Vec::new();
    items.push(1);
    items.push(2);
    let mut label = Buf::new();
    label.push('a');
    let bag = Bag { items: items, label: label, n: 1 };
    let mut copy = bag.clone();
    copy.items.push(3);
    copy.label.push('b');
    print("deep ");
    std::print_int(copy.items.len() + bag.items.len() - 2);
    print(" ");
    std::print_int(bag.n);
    println("");
    print("buf ");
    print(copy.label.as_slice());
    print(" ");
    println(bag.label.as_slice());
}
