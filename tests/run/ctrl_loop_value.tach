// `loop` is an expression: `break value` gives its value.
// EXPECT: 14 8 64 500 200
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

struct P { x: i64, y: i64 }

fn first_multiple(n: i64, of: i64) -> i64 {
    var i = n;
    loop {
        if i % of == 0 { break i; }
        i += 1;
    }
}

fn main() -> i64 {
    let a = first_multiple(10, 7);
    var k = 0;
    let p = loop {
        k += 1;
        if k * k > 50 { break P { x: k, y: k * k }; }
    };
    let found: i64 = outer: loop {
        var j = 0;
        loop {
            j += 1;
            if j == 5 { break :outer j * 100; }
        }
    };
    let b: u8 = loop { break 200; };
    let _unit = loop { break; };
    unsafe { printf(c"%ld %ld %ld %ld %d\n", a, p.x, p.y, found, b as i32); }
    0
}
