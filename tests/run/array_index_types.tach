// Indices of every integer type, including narrowed values whose high bits
// must be ignored.
// EXPECT: 30 40 50 60
// EXPECT: 440 70
// EXPECT: 10
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: [i64; 64] = [0; 64];
    let k = 0;
    loop {
        if k == 64 { break; };
        a[k] = k * 10;
        k += 1;
    }
    let i8i: i8 = 3;
    let u16i: u16 = 4;
    let i32i: i32 = 5;
    let u32i: u32 = 6;
    let big: i64 = 300;
    let wide: u64 = 0x100000007;
    printf("%ld %ld %ld %ld\n".0, a[i8i], a[u16i], a[i32i], a[u32i]);
    printf("%ld %ld\n".0, a[(big as u8) % 64], a[wide as u32]);
    let n: u8 = 44;
    printf("%ld\n".0, a[(big as u8) - n + 1]);
    0
}
