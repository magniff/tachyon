// The C library's sqrt, fabs, floor, ceil, trunc and round (and their f32
// forms) become instructions where that is exact (50_isel.tach): the
// results must be C's, at every level, -O0 calling the library. Halfway
// cases round away from zero, negative zero keeps its sign, NaN and the
// infinities pass through.
// EXPECT: 1.4142135623730951 3 0 inf
// EXPECT: 2.5 0 inf 1.5
// EXPECT: -3 2 -2 -3 3 -2
// EXPECT: -2 3 -3 2 -0 -0
// EXPECT: 1.41421354 2.5 -3 3 -2 -3
// EXPECT: 1 1
// ASM(aarch64-macos): fsqrt d
// ASM(aarch64-macos): fabs d
// ASM(aarch64-macos): frintm d
// ASM(aarch64-macos): frintp d
// ASM(aarch64-macos): frintz d
// ASM(aarch64-macos): frinta d
// ASM(aarch64-macos): fsqrt s
// ASM(x86_64-macos): sqrtsd
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn sqrt(x: f64) -> f64;
    fn fabs(x: f64) -> f64;
    fn floor(x: f64) -> f64;
    fn ceil(x: f64) -> f64;
    fn trunc(x: f64) -> f64;
    fn round(x: f64) -> f64;
    fn sqrtf(x: f32) -> f32;
    fn fabsf(x: f32) -> f32;
    fn floorf(x: f32) -> f32;
    fn ceilf(x: f32) -> f32;
    fn truncf(x: f32) -> f32;
    fn roundf(x: f32) -> f32;
}

fn s(x: f64) -> f64 { sqrt(x) }
fn a(x: f64) -> f64 { fabs(x) }
fn fl(x: f64) -> f64 { floor(x) }
fn ce(x: f64) -> f64 { ceil(x) }
fn tr(x: f64) -> f64 { trunc(x) }
fn ro(x: f64) -> f64 { round(x) }

fn main() -> i32 {
    // Through function values: each compiled on its own.
    let sq = s;
    let ab = a;
    let f = fl;
    let c = ce;
    let t = tr;
    let r = ro;
    let inf = 1.0 / 0.0;
    printf(c"%.17g %g %g %g\n", sq(2.0), sq(9.0), sq(0.0), sq(inf));
    printf(c"%g %g %g %g\n", ab(-2.5), ab(-0.0), ab(0.0 - inf), ab(1.5));
    printf(c"%g %g %g %g %g %g\n", f(-2.5), f(2.5), c(-2.5), r(-2.5), r(2.5), t(-2.5));
    printf(c"%g %g %g %g %g %g\n", r(-1.5), c(2.5), f(-2.0001), t(2.9), t(-0.5), c(-0.5));
    let x: f32 = 2.0;
    printf(c"%.9g %g %g %g %g %g\n", sqrtf(x) as f64, fabsf(-2.5) as f64, floorf(-2.5) as f64,
        ceilf(2.5) as f64, truncf(-2.5) as f64, roundf(-2.5) as f64);
    let n1 = sq(-1.0);
    let n2 = r(0.0 / 0.0);
    printf(c"%d %d\n", (n1 != n1) as i32, (n2 != n2) as i32);
    0
}
