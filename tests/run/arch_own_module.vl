// EXPECT: 7 3 x86_64
// (0.25) A program's own `arch` (a module, `crate::arch::..`, a variable,
// a field) is not std::arch: the intrinsic tables are not loaded for it
// (arch/virtual.vl, load_arch_modules), and the program builds as before.
mod arch {
    pub fn f() -> i64 { 7 }

    pub mod table {
        pub fn g() -> i64 { 3 }
    }
}

struct Target { arch: [u8] }

fn main() {
    let arch = crate::arch::f();
    let t = Target { arch: "x86_64" };
    std::println(f"{arch} {crate::arch::table::g()} {t.arch}");
}
