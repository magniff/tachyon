// sem-own: moving a field out of a struct with Drop is own.partial.
// ERROR: own.partial
struct D { id: i64, v: Vec<i64> }
struct P { a: D, b: D }
impl Drop for P { fn drop(inout self) {} }

fn main(gpa: Gpa) {
    let p = P { a: D { id: 1, v: Vec::new_in(gpa) }, b: D { id: 2, v: Vec::new_in(gpa) } };
    let x = p.b;
}
