// 0.20 T1: `inout self` in an impl for a slice is the exclusive slice
// (`self[i] += 1` writes the caller's elements); a closure captures a sink
// parameter by value until it writes it (`k += 1`: by reference, the
// change is the parameter's), and a method that changes it (`v.push`)
// takes it by reference.
// FLAGS: --syntax=0.20
// EXPECT: 2 3 2
// EXPECT: 25
trait Bump { fn bump(inout self); fn first(self) -> i64; }
impl Bump for [i64] {
    fn bump(inout self) { for i in 0..self.len() { self[i] += 1; } }
    fn first(self) -> i64 { self[0] }
}
fn twice(v: sink Vec<i64>, k: sink i64) -> i64 {
    let f = || v.len();
    let g = || { k += 1; k };
    let h = || v.push(9);
    h();
    let r = g();
    f() as i64 + r + k
}
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v[..].bump();
    println(f"{v[0]} {v[1]} {v[..].first()}");
    println(twice(v, 10));
}
