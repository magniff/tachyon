// 0.17 (value semantics, from tests/values-proto of the prototype): the
// gaps G1, G2 and G4 of docs/design/value-semantics.md §1 as errors under
// --values=error, one per rule.
// FLAGS: --values=error
// ERROR: own.moved
// ERROR: own.conflict
// ERROR: own.conflict
// ERROR: own.conflict
// ERROR: own.conflict
// ERROR: own.moved
fn consume(v: Vec<i64>) -> i64 { v.len() }
fn grow(v: &mut Vec<i64>) -> i64 { v.push(1); 0 }
fn take(s: [i64], k: i64) -> i64 { s[0] + k }

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let w = v;
    println(f"{v.len()}");
    let mut u: Vec<i64> = Vec::new_in(gpa);
    u.push(3);
    let t = u.as_slice();
    u.push(4);
    println(f"{t[0]}");
    for x in u { if x > 0 { u.push(x); } }
    take(u.as_slice(), grow(&mut u));
    u.extend_from_slice(u.as_slice());
    let k = consume(w);
    println(f"{w.len()} {k}");
}
