// (0.25 semantics audit, views) A temporary Vec, Buf or String used as
// the receiver of a std method (`v.clone().len()`,
// `String::from_in(..).as_str()`) is never dropped: it leaks, whether the
// method returns a view or a plain value. A temporary of a user type
// (`mk().len()`, `H::new().view()`) is dropped, at the end of the
// statement or, when a view of it is kept, of the block.
// The leak shows under --check-alloc; the count below makes it visible
// in every build: a Drop type held in a Vec, cloned as a temporary.
// XFAIL: SOUNDNESS a temporary Vec/Buf/String receiver of a std method is never dropped (leak)
// EXPECT: 1
// EXPECT: drops 2
#[derive(Clone)]
struct D { n: i64 }
static var DROPS: i64 = 0;
impl Drop for D { fn drop(inout self) { DROPS += 1; } }
fn main(gpa: Gpa) -> i32 {
    {
        var v: Vec<D> = Vec::new_in(gpa);
        v.push(D { n: 1 });
        println(v.clone().len());
    }
    println(f"drops {DROPS}");
    0
}
