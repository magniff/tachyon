// f32 <-> f64 conversions round correctly.
// EXPECT: 0.10000000149011612 0.10000000149011612
// EXPECT: inf 0
extern fn printf(format: *u8, ...) -> i32;

fn main() -> i64 {
    let a: f64 = 0.1;
    let b = a as f32;
    let c = b as f64;
    printf("%.17g %.17g\n".0, b, c);
    let d: f64 = 1e40;
    let e: f64 = 1e-50;
    printf("%f %.17g\n".0, d as f32, e as f32);
    0
}
