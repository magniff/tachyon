// 0.16: formatting allocates nothing. A Fmt to a Buf writes into the room
// the Buf has and counts what does not fit; push_fmt then grows the Buf to
// the count and runs the Display again (twice only then). format_in
// formats into 256 bytes on the stack first. Padding, precision and
// right-alignment come out the same whether the text fit or not; a long
// precision of a float needs no heap either.
// EXPECT: runs 1: [x=     5|ab|   -7|00ff]
// EXPECT: runs 2: true [x=     5|ab|   -7|00ff] 24
// EXPECT: long: 300 300 [         a]
// EXPECT: 1.50000000000000000000 1107 true
// EXPECT: Ok(()) runs 4
// EXPECT:     3 3 1.500
use std::{AllocError, Buf, Fmt, format_in};

static mut RUNS: i64 = 0;

struct Counted { n: i64 }

impl Display for Counted {
    fn fmt(self: &Counted, f: &mut Fmt) {
        RUNS += 1;
        f.write(f"x={self.n:>6}|{"abcdef":.2}|{-7:>5}|{255:04x}");
    }
}

#[no_alloc]
fn show(x: i64) {
    println(f"{x:>5} {x:x} {1.5:.3}");
}

fn main(gpa: Gpa) {
    let mut b: Buf = Buf::with_capacity_in(64, gpa);
    b.push_str("[");
    b.push_fmt(Counted { n: 5 });
    b.push_str("]");
    println(f"runs {RUNS}: {b}");
    // a Buf with less room than the text: two runs, the same text
    RUNS = 0;
    let mut a = Arena::new_in(gpa);
    let mut c: Buf<Arena> = Buf::with_capacity_in(4, a);
    c.push_str("[");
    c.push_fmt(Counted { n: 5 });
    c.push_str("]");
    println(f"runs {RUNS}: {c.capacity() > 4} {c} {c.len()}");
    // longer than format_in's 256 bytes on the stack
    let long = format_in(f"{"a":>300}", a);
    let text = long.as_slice();
    println(f"long: {long.len()} {text.len} [{text[290..300]}]");
    // a precision past a double's digits
    let p = format_in(f"{1.5:.1105}", gpa);
    let q = p.as_slice();
    println(f"{q[0..22]} {q.len} {q[1100..1107] == "0000000"}");
    RUNS = 0;
    let mut d: Buf<Arena> = Buf::new_in(a);
    for i in 0..2 {
        d.push_fmt(Counted { n: i });
    }
    let r: Result<(), AllocError> = Ok(());
    println(f"{r:?} runs {RUNS}");
    show(3);
}
