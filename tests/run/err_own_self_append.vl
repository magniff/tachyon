// 0.17: appending a view of a Buf or Vec to itself is a conflict (the
// receiver is borrowed mutably while the argument views it);
// std_self_append keeps 0.16's run-time behaviour under --values=off.
// ERROR: 'b' has an inout access, 'b', and a view, 'b.as_slice()', in the same call
// ERROR: 'v' has an inout access, 'v', and a view, 'v.as_slice()', in the same call
// ERROR-COUNT: 2
fn main(gpa: Gpa) -> i32 {
    var b = Buf::new_in(gpa);
    b.push_str("abc");
    b.push_str(b.as_slice());
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.extend_from_slice(v.as_slice());
    let w = b.as_slice().len + v.len();
    w as i32
}
