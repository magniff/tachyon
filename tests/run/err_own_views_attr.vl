// 0.17: #[views(...)] and #[stores(...)] name the function's parameters
// (`p`) or what their views point into (`*p`).
// ERROR: 'f' has no parameter 'q'
// ERROR: 'g' has no parameter 'w'
#[views(q)]
fn f(s: [u8]) -> [u8] { s }
#[stores(*w)]
fn g(v: inout Vec<[u8]>, s: [u8]) { v.push(s); }
fn main(gpa: Gpa) { var v: Vec<[u8]> = Vec::new_in(gpa); g(&v, f("a")); }
