// XFAIL: SOUNDNESS two scoped threads each take &a[0..2] as an inout slice: a data race accepted
// a scoped thread given an inout slice (exclusive) of v: writes through it
// ERROR: sync
use std::thread;
fn fill(s: inout [i64]) { for i in 0..s.len() { s[i] = 7; } }
fn main() { var a = [0, 0, 0, 0]; thread::scope(|sc| { let x = sc.spawn(|| { fill(&a[0..2]); 0 }); let y = sc.spawn(|| { fill(&a[0..2]); 0 }); x.join() + y.join() }); println(f"{a[0]}"); }
