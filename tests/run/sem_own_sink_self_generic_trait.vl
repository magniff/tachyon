// sem-own: a trait method with `sink self`, called through a generic: consumes, dropped once.
// EXPECT: fin 1
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
trait Fin { fn fin(sink self) -> i64; }
impl Fin for D { fn fin(sink self) -> i64 { println(f"fin {self.id}"); self.id } }
fn run<T: Fin>(x: sink T) -> i64 { x.fin() }

fn main(gpa: Gpa) {
    run(mk(1, gpa));
    println("end");
}
