// 0.20 T1: the call markers and `*` on an access in a file read in 0.20's
// spelling: an inout argument without `&` (conv.marker), `&` where the
// callee only reads or takes the value (conv.marker_extra), `*x` on an
// access (conv.rust), and an assignment to a let parameter.
// FLAGS: --syntax=0.20
// ERROR: '*n' is Rust's spelling; 'n' is an access, used as its value
// ERROR: help: a parameter is read-only (let); to change the caller's value take it `n: inout i64`
// ERROR: 'v' is lent inout here (the callee may change it): mark it '&v'
// ERROR: '&' marks an argument the callee may change; 'v' is taken let or sink here
fn grow(v: inout Vec<i64>) { v.push(1); }

fn size(v: Vec<i64>) -> i64 { v.len() }

fn bump(n: inout i64) { *n += 1; }

fn setp(n: i64) { n = 3; }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    grow(v);
    println(size(&v));
}
