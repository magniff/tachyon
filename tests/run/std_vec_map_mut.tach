// EXPECT: vec: 1 10 30 2 3 4, last 4, removed 0, len 6
// EXPECT: empty last none, truncate 2: 1 10
// EXPECT: counts: a=3 b=1 c=1, contains_key b true z false
// EXPECT: get_mut: alice 110 2, bob missing
// EXPECT: grown: 1000 keys, sum 499500
// 0.14: changing values in place: Vec's last, swap, insert, remove,
// truncate; HashMap's get_mut and get_or_insert (one-element views of the
// value), contains_key; a view taken again after the map grows.
use std::{HashMap, print_int};

struct Account { balance: i64, txns: i64 }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..5 {
        v.push(i);
    }
    v.insert(0, 10);
    v.insert(6, 20);
    v.insert(3, 30);
    let removed = v.remove(1);
    v.swap(0, 1);
    v.truncate(6);
    v.truncate(100);
    print("vec:");
    for x in v.as_slice() {
        print(" ");
        print_int(x);
    }
    print(", last ");
    print_int(v.last().unwrap());
    print(", removed ");
    print_int(removed);
    print(", len ");
    print_int(v.len());
    println("");
    var e: Vec<i64> = Vec::new_in(gpa);
    print(if e.last().is_none() { "empty last none" } else { "empty last some" });
    v.truncate(2);
    print(", truncate 2: ");
    print_int(v.get(0));
    print(" ");
    print_int(v.get(1));
    println("");

    var counts: HashMap<[u8], i64> = HashMap::new_in(gpa);
    for w in ["a", "b", "a", "c", "a"] {
        counts.get_or_insert(w, 0)[0] += 1;
    }
    print("counts:");
    for w in ["a", "b", "c"] {
        print(" ");
        print(w);
        print("=");
        print_int(counts.get(w).unwrap());
    }
    print(", contains_key b ");
    print(if counts.contains_key("b") { "true" } else { "false" });
    print(" z ");
    println(if counts.contains_key("z") { "true" } else { "false" });

    var accounts: HashMap<[u8], Account> = HashMap::new_in(gpa);
    accounts.insert("alice", Account { balance: 100, txns: 1 });
    if let Some(a) = accounts.get_mut("alice") {
        a[0].balance += 10;
        a[0].txns += 1;
    }
    let a = accounts.get("alice").unwrap();
    print("get_mut: alice ");
    print_int(a.balance);
    print(" ");
    print_int(a.txns);
    println(if accounts.get_mut("bob").is_none() { ", bob missing" } else { ", bob found" });

    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    for i in 0..1000 {
        m.get_or_insert(i, 0)[0] += i;
        m.get_or_insert(0, 0)[0] += 0;
    }
    var sum = 0;
    for i in 0..m.slots() {
        if let Some(x) = m.value_at(i) {
            sum += x;
        }
    }
    print("grown: ");
    print_int(m.len());
    print(" keys, sum ");
    print_int(sum);
    println("");
    0
}
