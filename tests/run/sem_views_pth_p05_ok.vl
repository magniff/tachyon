// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: local / usr/local / txt / x
// EXPECT: local
// EXPECT: usr/local
// EXPECT: txt
// EXPECT: x
use std::path::{Path, PathBuf};

fn main(gpa: Gpa) -> i32 {
    let p = PathBuf::from_in("/usr/local", gpa);
    println(p.as_path().file_name().unwrap());
    let q = Path::new("usr/local/x.txt");
    println(q.parent().unwrap());
    println(q.extension().unwrap());
    println(q.file_stem().unwrap());
    0
}
