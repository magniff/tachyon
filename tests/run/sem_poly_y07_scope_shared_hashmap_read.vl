// two scoped threads reading one HashMap by let: accepted
// FLAGS: --check-alloc
// EXPECT: 9900
use std::thread;

fn main(gpa: Gpa) {
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    for i in 0..100 { m.insert(i, i * 2); }
    let t = thread::scope(|s| {
        let a = s.spawn(|| { var t = 0; for i in 0..50 { t += m.get(i).unwrap(); } t });
        let b = s.spawn(|| { var t = 0; for i in 50..100 { t += m.get(i).unwrap(); } t });
        a.join() + b.join()
    });
    println(f"{t}");
}
