// 0.17: in unsafe code, a raw pointer to a Vec or a slice (a local holding
// one, a static) still indexes memory: `p[i]` is the i-th Vec (slice)
// from p, as before; only a borrow indexes its pointee.
// EXPECT: 1 3
// EXPECT: 2 lo
static mut WORDS: *[u8] = 0 as *[u8];

fn main(gpa: Gpa) -> i32 {
    let mut a: Vec<i64> = Vec::new_in(gpa);
    defer a.free();
    let mut b: Vec<i64> = Vec::new_in(gpa);
    defer b.free();
    a.push(1);
    b.push(2);
    b.push(3);
    b.push(4);
    let vs = [a, b];
    let p: *Vec<i64> = &vs[0];
    let n = unsafe { p[1] }.len();
    println(f"{unsafe { p[0] }.len()} {n}");
    let words = ["hi", "lo"];
    unsafe {
        WORDS = &words[0];
        println(f"{WORDS[1].len} {WORDS[1]}");
    }
    0
}
