// Character literals with escapes: the quote `'\''`, the backslash
// `'\\'`, the double quote `'"'` (no escape needed), `'\n'`, `'\t'`,
// `'\r'`, `'\0'`, `'\x41'`; and the same in strings and patterns.
// EXPECT: 39 92 34 10 9 13 0 65
// EXPECT: it's "q" \ ' 12
// EXPECT: 1 2 3
fn kind(c: u8) -> i64 {
    match c {
        '\'' => 1,
        '"' => 2,
        '\\' => 3,
        _ => 0,
    }
}

fn main() {
    let a = '\'';
    let b = '\\';
    let c = '"';
    println(f"{a} {b} {c} {'\n'} {'\t'} {'\r'} {'\0'} {'\x41'}");
    let s = "it's \"q\" \\ \'";
    println(f"{s} {s.len()}");
    println(f"{kind('\'')} {kind('"')} {kind('\\')}");
}
