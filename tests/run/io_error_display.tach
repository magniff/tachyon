// The errors of reading and parsing (0.15) have Display (a sentence) and
// Debug (as Rust's derived Debug writes them).
// EXPECT: invalid digit at byte 3 | InvalidDigit(3)
// EXPECT: cannot parse an integer from an empty text | Empty
// EXPECT: the number does not fit in an i64 | Parse(Overflow)
// EXPECT: no number left: the end of the input | End
// EXPECT: cannot read the input | Read
use std::{Fmt, IoError, ParseIntError, ScanError};

fn line<T: Display + Debug>(x: sink T) {
    var f = Fmt::to_fd(1);
    f.display(x);
    f.str(" | ");
    f.debug(x);
    f.str("\n");
    f.flush(); // a Fmt to a file descriptor writes on flush
}

fn main() {
    line(ParseIntError::InvalidDigit(3));
    line(ParseIntError::Empty);
    line(ScanError::Parse(ParseIntError::Overflow));
    line(ScanError::End);
    line(IoError::Read);
}
