// Patterns on references (0.18.1) stay sound: a reference a pattern binds
// into the value is a loan of its field, so changing the value (through
// the matched reference, or another one) while it is used is
// own.conflict, as `&mut (*e).f` would be; moving out of one is
// own.move_out. `&v[i]` of a Vec views v (it did not).
// ERROR: '*e' uses '*e' while 'v'
// ERROR: 'e' uses '*e' while 'x'
// ERROR: 'es.push(E::C)' may change 'es' while 'x'
// ERROR: cannot move '*v' (Vec<i64>) out of a reference
// ERROR: '&mut *e' borrows mutably 'r.0' while 'x'
// ERROR: '*e' uses '*e' while 'w'
// ERROR: 'vs.push(1)' may change 'vs' while 'r'
enum E { A(i64), C, D(Vec<i64>, i64) }

fn reset(e: &mut E) { *e = E::C; }

fn take(v: Vec<i64>) -> i64 { v.len() }

fn s1(e: &mut E) -> i64 {
    match e {
        E::D(v, _) => {
            *e = E::C;
            v.len()
        }
        _ => 0,
    }
}

fn s2(e: &mut E) -> i64 {
    match e {
        E::A(x) => {
            reset(e);
            *x
        }
        _ => 0,
    }
}

fn s3(es: &mut Vec<E>) -> i64 {
    match &es[0] {
        E::A(x) => {
            es.push(E::C);
            *x
        }
        _ => 0,
    }
}

fn s4(e: &E) -> i64 { match e { E::D(v, _) => take(*v), _ => 0 } }

fn s5(e: &mut E) -> i64 {
    let r = &mut *e;
    match r {
        E::A(x) => {
            let y = &mut *e;
            *x + 1
        }
        _ => 0,
    }
}

fn s6(e: &mut E) -> i64 {
    if let E::D(v, k) = e {
        let w = v;
        *e = E::C;
        w.len() + *k
    } else {
        0
    }
}

fn s7(vs: &mut Vec<i64>) -> i64 {
    let r = &vs[0];
    vs.push(1);
    *r
}

fn main(gpa: Gpa) {}
