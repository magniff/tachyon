// the same owned value passed twice to a fn(sink R, sink R): own.moved
// ERROR: [own.moved]: 'r' is used here after it moved
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn two(a: sink R, b: sink R) -> i64 { a.id + b.id }

fn main() {
    let f: fn(sink R, sink R) -> i64 = two;
    let r = R { id: 1 };
    println(f"{f(r, r)}");
}
