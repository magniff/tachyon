// sem-own: moving one field out (a partial move) of a struct without Drop:
// the moved field is dropped by its new owner, the rest at scope end, each once.
// EXPECT: took 11
// EXPECT: drop 11
// EXPECT: still 10
// EXPECT: end
// EXPECT: drop 10
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
struct P { a: D, b: D }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let p = P { a: mk(10, gpa), b: mk(11, gpa) };
    {
        let x = p.b;
        println(f"took {x.id}");
    }
    println(f"still {p.a.id}");
    println("end");
}
