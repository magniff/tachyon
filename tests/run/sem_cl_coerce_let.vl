// (0.25) A captured Vec, Buf or String given where its slice or text goes,
// inside a closure: the same as written `v[..]`, `s.as_str()` (it read
// garbage: the coercion lost the captured name's rewrite to the env).
// EXPECT: 7 7 2 2 3 3 3 9
// EXPECT: 7 7 2 2
fn first(s: [i64]) -> i64 { s[0] }
fn n(s: [u8]) -> i64 { s.len() }
fn tl(s: str) -> i64 { s.len() }
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(7);
    var b = Buf::new_in(gpa);
    b.push_str("ab");
    var s = String::from_in("abc", gpa);
    var a = [9, 8];
    let f1 = || first(v);
    let g1 = || first(v[..]);
    let f2 = || n(b);
    let g2 = || n(b[..]);
    let f3 = || tl(s);
    let g3 = || tl(s.as_str());
    let f4 = || n(s);
    let f5 = || first(a);
    println(f"{f1()} {g1()} {f2()} {g2()} {f3()} {g3()} {f4()} {f5()}");
    // let-bound (captured by value)
    let w = v.clone();
    let c = b.clone();
    let h1 = || first(w);
    let k1 = || first(w[..]);
    let h2 = || n(c);
    let k2 = || n(c[..]);
    println(f"{h1()} {k1()} {h2()} {k2()}");
}
