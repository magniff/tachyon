struct Order { id: i64, items: Vec<i64> }

fn total(list: Vec<Order>) -> i64 {
    var t = 0;
    for i in 0..list.len() {
        let o = list.get(i);
        t += o.id + o.items.len();
    }
    match list.last() {
        Some(o) => t += o.id,
        None => {}
    }
    if let Some(o) = list.last() { t += o.items.len(); }
    let first = list.get(0);
    t + first.id
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<Order> = Vec::new_in(gpa);
    var it: Vec<i64> = Vec::new_in(gpa);
    it.push(5);
    v.push(Order { id: 1, items: it });
    var names: Vec<Buf> = Vec::new_in(gpa);
    names.push(Buf::from_in("x", gpa));
    let n = names.get(0);
    let m: HashMap<i64, Buf> = HashMap::new_in(gpa);
    let k = m.get(3);
    std::print_int(total(v) + n.len() as i64);
    println("");
    0
}
// (0.17, T7) A copy of an element a collection keeps (`list.get(i)`,
// `list.last()`, `m.get(k)`, through `if let` and `match` too) is borrowed:
// it is not dropped, so --check-alloc sees no double free.
// FLAGS: --check-alloc
// EXPECT: 6
