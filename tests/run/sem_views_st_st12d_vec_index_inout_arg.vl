// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: &owners[0] passed inout while a view into it is used
// ERROR: error[own.conflict]
fn grow(s: inout String) { s.push_str(
    "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"); }

fn main(gpa: Gpa) -> i32 {
    var owners: Vec<String> = Vec::new_in(gpa);
    owners.push(String::from_in("hello", gpa));
    let w = owners[0].as_str();
    grow(&owners[0]);
    println(w);
    0
}
