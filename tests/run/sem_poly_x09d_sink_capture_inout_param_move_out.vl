// a sink closure capturing an inout parameter moves it out: the caller's Vec would be freed twice
// ERROR: [own.move_out]: cannot move 'v'
fn eat(v: sink Vec<i64>) -> i64 { v.len() }

fn f(v: inout Vec<i64>) -> i64 {
    let c = sink || eat(v);
    c()
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    println(f"{f(&v)} {v.len()}");
}
