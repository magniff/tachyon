// sem-own: an or-pattern binding an owned payload in either variant: dropped once.
// EXPECT: got 3
// EXPECT: drop 3
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
enum E { A(D), B(D), N }

fn main(gpa: Gpa) {
    let e = E::B(mk(3, gpa));
    match e { E::A(d) | E::B(d) => println(f"got {d.id}"), E::N => {} }
    println("end");
}
