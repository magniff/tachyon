// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: n read while a closure changing n is live (or accept 1 2 per design)
// XFAIL: WRONG a closure's mutating capture is not exclusive (v read, or a second mutating closure, while it is live)
// ERROR: error[own.conflict]
fn main() -> i32 {
    var n = 0;
    var inc = || n += 1;
    inc();
    println(n);
    inc();
    println(n);
    0
}
