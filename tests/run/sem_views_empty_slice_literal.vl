// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md)
// An empty array literal where a slice is annotated (`var sl: [i64] =
// [];`) is an empty view of static data. It is "cannot infer the type of
// an empty array; annotate it", though it is annotated.
// XFAIL: OVERSTRICT an empty literal for an annotated [i64] local: 'cannot infer the type of an empty array'
// EXPECT: 0
fn main() -> i32 {
    var sl: [i64] = [];
    println(sl.len());
    0
}
