// a generic struct holding a view, the viewed Vec grown while it lives
// ERROR: [own.conflict]: 'v.push(i)' may change 'v' while 'b'
struct Box1<T> { x: T }
fn mk<T>(x: sink T) -> Box1<T> { Box1 { x: x } }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let b = mk(v.as_slice());
    for i in 0..100 { v.push(i); }
    println(f"{b.x[0]}");
}
