// a sink closure capturing a let parameter (a borrow of the caller's Vec) moved into a detached thread
// ERROR: [sync.borrow_escapes]: 'thread::spawn' moves 'v'
use std::thread;

fn start(v: Vec<i64>) -> thread::JoinHandle<i64> {
    thread::spawn(sink || { var t = 0; for _ in 0..200 { t += v[0]; thread::yield_now(); } t })
}

fn main(gpa: Gpa) {
    var h = {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(1);
        start(v)
    };
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i + 50); }
    println(f"{h.join()}");
}
