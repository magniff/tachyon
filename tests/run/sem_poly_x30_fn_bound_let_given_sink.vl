// F: FnMut(R) given a closure taking sink R: rejected (the caller would drop R twice)
// ERROR: does not satisfy the bound
// XFAIL: OVERSTRICT a sink closure parameter is conv.sink_type; it should be rejected for the bound instead
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println(f"drop {self.id}"); } }
fn feed<F: FnMut(R) -> i64>(f: sink F) -> i64 { let r = R { id: 1 }; f(r) + r.id }
fn main() { println(f"{feed(|r: sink R| r.id)}"); }
