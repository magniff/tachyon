// Calling libc functions with pointer, integer and narrow arguments.
// EXPECT: 12 -1234 7 9000000000 Q
// EXPECT: pi=3/3.14
// EXPECT: 9
extern fn printf(format: *u8, ...) -> i32;
extern fn strlen(s: *u8) -> u64;
extern fn atoi(s: *u8) -> i32;
extern fn abs(x: i32) -> i32;
extern fn labs(x: i64) -> i64;
extern fn toupper(c: i32) -> i32;
extern fn snprintf(buf: *u8, n: u64, format: *u8, ...) -> i32;
extern fn puts(s: *u8) -> i32;

fn main() -> i64 {
    printf("%lu %d %d %ld %c\n".0, strlen("hello, world".0), atoi("-1234".0), abs((0 - 7) as i32), labs(0 - 9000000000), toupper(113));
    let buf: [u8; 64] = [0; 64];
    let n = snprintf(&buf as *u8, 64, "%s=%d/%.2f".0, "pi".0, 3, 3.14159);
    puts(&buf as *u8);
    printf("%d\n".0, n);
    0
}
