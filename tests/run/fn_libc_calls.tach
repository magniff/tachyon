// Calling libc functions with pointer, integer and narrow arguments.
// EXPECT: 12 -1234 7 9000000000 Q
// EXPECT: pi=3/3.14
// EXPECT: 9
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn strlen(s: *u8) -> u64;
    fn atoi(s: *u8) -> i32;
    fn abs(x: i32) -> i32;
    fn labs(x: i64) -> i64;
    fn toupper(c: i32) -> i32;
    fn snprintf(buf: *u8, n: u64, format: *u8, ...) -> i32;
    fn puts(s: *u8) -> i32;
}

fn main() -> i64 {
    unsafe {
        printf(c"%lu %d %d %ld %c\n", strlen(c"hello, world"), atoi(c"-1234"), abs((0 - 7) as i32), labs(0 - 9000000000), toupper(113));
    }
    let buf: [u8; 64] = [0; 64];
    let n = unsafe { snprintf(&buf as *u8, 64, c"%s=%d/%.2f", c"pi", 3, 3.14159) };
    unsafe {
        puts(&buf as *u8);
        printf(c"%d\n", n);
    }
    0
}
