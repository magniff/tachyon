// A block expression with its own `let`s used as a value.
// EXPECT: 2 7 12
// EXIT: 2
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}
struct P { x: i64, y: i64 }
fn main() -> i64 {
    let x = { let y = 2; y };
    let p = { let a = 3; let b = 4; P { x: a, y: a + b } };
    let z: i64 = { let q = p; q.x + q.y + { let w = 2; w } };
    printf(c"%ld %ld %ld\n", x, p.y, z);
    x
}
