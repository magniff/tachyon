// EXPECT: 10 6
// EXPECT: 7
// EXPECT: 42
// 0.14: constraints on associated types, `I: Iterator<Item = T>`: checked
// when an instance is made, and binding T in inference (T appears in no
// argument); `F::Output`, the result type of a fn type.
use std::print_int;

struct Upto { n: i64, end: i64 }

impl Iterator for Upto {
    type Item = i64;

    fn next(self: &mut Upto) -> Option<i64> {
        if self.n >= self.end {
            return None;
        }
        self.n += 1;
        Some(self.n - 1)
    }
}

struct Small { n: u8 }

impl Iterator for Small {
    type Item = u8;

    fn next(self: &mut Small) -> Option<u8> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        Some(self.n)
    }
}

fn sum_i64<I: Iterator<Item = i64>>(it: I) -> i64 {
    it.sum()
}

// T is bound from I's Item.
fn last<I: Iterator<Item = T>, T>(it: I) -> T {
    let mut it = it;
    let mut best = it.next().unwrap();
    while let Some(x) = it.next() {
        best = x;
    }
    best
}

fn double(x: i64) -> i64 {
    x * 2
}

fn call<F>(f: F, x: i64) -> F::Output {
    f(x)
}

fn main() -> i32 {
    print_int(sum_i64(Upto { n: 0, end: 5 }));
    print(" ");
    print_int(last(Small { n: 7 }) as i64 + 6);
    println("");
    print_int(last(Upto { n: 3, end: 8 }));
    println("");
    let f: fn(i64) -> i64 = double;
    let r: i64 = call(f, 21);
    print_int(r);
    println("");
    0
}
