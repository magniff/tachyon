// EXPECT: (4, 6)
// EXPECT: (-2, -2)
// EXPECT: (3, 6)
// EXPECT: (1, 2)
// EXPECT: (-1, -2)
// EXPECT: equal true false
// EXPECT: less true false true
// EXPECT: sum (10, 20)
// EXPECT: sorted 1 2 3 5 8
// EXPECT: points (0, 1) (1, 0) (2, 2)
// 0.9: operator overloading through std's traits (Add, Sub, Mul, Div, Neg,
// Eq, Ord), and generic code over them, which builtin types satisfy
// without impls.
use std::{print_int, sort};

struct Vec2 { x: i64, y: i64 }

impl Add for Vec2 {
    fn add(self: Vec2, other: Vec2) -> Vec2 { Vec2 { x: self.x + other.x, y: self.y + other.y } }
}

impl Sub for Vec2 {
    fn sub(self: Vec2, other: Vec2) -> Vec2 { Vec2 { x: self.x - other.x, y: self.y - other.y } }
}

impl Mul for Vec2 {
    fn mul(self: Vec2, other: Vec2) -> Vec2 { Vec2 { x: self.x * other.x, y: self.y * other.y } }
}

impl Div for Vec2 {
    fn div(self: Vec2, other: Vec2) -> Vec2 { Vec2 { x: self.x / other.x, y: self.y / other.y } }
}

impl Neg for Vec2 {
    fn neg(self: Vec2) -> Vec2 { Vec2 { x: -self.x, y: -self.y } }
}

// Equal when x is: the impl wins over the structural ==.
impl Eq for Vec2 {
    fn eq(self: &Vec2, other: &Vec2) -> bool { self.x == other.x }
}

// By x, then y.
impl Ord for Vec2 {
    fn cmp(self: &Vec2, other: &Vec2) -> i64 {
        if self.x != other.x { self.x - other.x } else { self.y - other.y }
    }
}

fn show(v: Vec2) {
    print("(");
    print_int(v.x);
    print(", ");
    print_int(v.y);
    println(")");
}

fn sum<T: Add>(items: [T], zero: T) -> T {
    let mut total = zero;
    for x in items {
        total = total + x;
    }
    total
}

fn print_bool(b: bool) {
    print(if b { "true" } else { "false" });
}

fn main() -> i32 {
    let a = Vec2 { x: 1, y: 2 };
    let b = Vec2 { x: 3, y: 4 };
    show(a + b);
    show(a - b);
    show(a * Vec2 { x: 3, y: 3 });
    show(b / Vec2 { x: 3, y: 2 });
    show(-a);
    print("equal ");
    print_bool(a == Vec2 { x: 1, y: 99 });
    print(" ");
    print_bool(a != Vec2 { x: 1, y: 0 });
    println("");
    print("less ");
    print_bool(a < b);
    print(" ");
    print_bool(b <= a);
    print(" ");
    print_bool(a >= Vec2 { x: 1, y: 2 });
    println("");
    let vs = [Vec2 { x: 1, y: 2 }, Vec2 { x: 4, y: 8 }, Vec2 { x: 5, y: 10 }];
    print("sum ");
    show(sum(vs[..], Vec2 { x: 0, y: 0 }));
    let mut ns = [5, 3, 8, 1, 2];
    sort(ns[..]);
    print("sorted");
    for n in ns {
        print(" ");
        print_int(n);
    }
    println("");
    let mut ps = [Vec2 { x: 2, y: 2 }, Vec2 { x: 1, y: 0 }, Vec2 { x: 0, y: 1 }];
    sort(ps[..]);
    print("points");
    for p in ps {
        print(" (");
        print_int(p.x);
        print(", ");
        print_int(p.y);
        print(")");
    }
    println("");
    if sum([1, 2, 3][..], 0) != 6 {
        return 1;
    }
    0
}
