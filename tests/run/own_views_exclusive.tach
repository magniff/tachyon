// 0.17 (value semantics, T2): views and exclusivity that check clean.
// FLAGS: --values=error
// EXPECT: 3 4 7
// EXPECT: 10 2
// EXPECT: 11
struct Stack { items: [i64; 8], n: i64 }

impl Stack {
    fn len(self: &Stack) -> i64 { self.n }
    fn push(self: &mut Stack, x: i64) { self.items[self.n] = x; self.n += 1; }
    fn top(self: &Stack) -> i64 { self.items[self.n - 1] }
}

struct Pair { x: i64, y: i64 }

fn bump(p: &mut i64) { *p += 1; }
fn add(to: &mut i64, from: &i64) { *to += *from; }
fn fill(s: &mut Stack, n: i64) { for i in 0..n { s.push(i); } }

fn main() {
    // two-phase receivers: the receiver is read by its own arguments
    let mut s = Stack { items: [0; 8], n: 0 };
    s.push(s.len());
    s.push(s.len() + 1);
    s.push(s.top() + 5);
    // a `&mut` local passed to several calls: implicit reborrows
    let mut a = 1;
    let r = &mut a;
    bump(r);
    bump(r);
    // disjoint fields
    let mut p = Pair { x: 3, y: 4 };
    add(&mut p.x, &p.y);
    println(f"{s.top() - 4} {a + 1} {p.x}");
    // a plain read of a place an earlier `&mut` argument borrows
    let mut t = Stack { items: [0; 8], n: 0 };
    fill(&mut t, t.n + 5);
    let q = &mut t;
    q.push(10);
    println(f"{q.top()} {t.n - 4}");
    // a reborrow written through, then its parent used
    let mut arr = [1, 2, 3];
    let whole = &mut arr[..];
    let part = &mut whole[1..];
    part[0] = 10;
    println(f"{whole[0] + whole[1]}");
}
