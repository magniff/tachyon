// 0.17 (value semantics, T2): views and exclusivity that check clean.
// FLAGS: --values=error
// EXPECT: 3 4 7
// EXPECT: 10 2
// EXPECT: 11
struct Stack { items: [i64; 8], n: i64 }

impl Stack {
    fn len(self) -> i64 { self.n }
    fn push(inout self, x: i64) { self.items[self.n] = x; self.n += 1; }
    fn top(self) -> i64 { self.items[self.n - 1] }
}

struct Pair { x: i64, y: i64 }

fn bump(p: inout i64) { p += 1; }
fn add(to: inout i64, from: i64) { to += from; }
fn fill(s: inout Stack, n: i64) { for i in 0..n { s.push(i); } }

fn main() {
    // two-phase receivers: the receiver is read by its own arguments
    var s = Stack { items: [0; 8], n: 0 };
    s.push(s.len());
    s.push(s.len() + 1);
    s.push(s.top() + 5);
    // a `&mut` local passed to several calls: implicit reborrows
    var a = 1;
    inout r = &a;
    bump(&r);
    bump(&r);
    // disjoint fields
    var p = Pair { x: 3, y: 4 };
    add(&p.x, p.y);
    println(f"{s.top() - 4} {a + 1} {p.x}");
    // a plain read of a place an earlier `&mut` argument borrows
    var t = Stack { items: [0; 8], n: 0 };
    fill(&t, t.n + 5);
    inout q = &t;
    q.push(10);
    println(f"{q.top()} {t.n - 4}");
    // a reborrow written through, then its parent used
    var arr = [1, 2, 3];
    let whole = &arr[..];
    let part = &whole[1..];
    part[0] = 10;
    println(f"{whole[0] + whole[1]}");
}
