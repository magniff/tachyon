// 0.20 T1: the conventions' semantics in a file read in 0.20's spelling
// (docs/design/conventions.md §2–§5): accesses used as the values they
// designate (no `*`), `&x` marks inout, `inout r = &x; f(&r)` reborrows,
// let parameters copy plain values and borrow owned ones, sink parameters
// consume, receivers `self` / `inout self` / `sink self`, an operator
// impl taking its operands let, closure parameters `inout`.
// FLAGS: --syntax=0.20
// EXPECT: 106 1 212
// EXPECT: 11 6 7
// EXPECT: 3 4 1 3
// EXPECT: 8 3
// EXPECT: 6
use std::Add;

struct Acc { balance: i64, log: Vec<i64> }

fn transfer(from: inout Acc, to: inout Acc, amount: i64) -> bool {
    if from.balance < amount {
        return false;
    }
    from.balance -= amount;
    to.balance += amount;
    from.log.push(-amount);
    to.log.push(amount);
    true
}

fn report(a: Acc, out: inout i64) { out += a.balance; }

fn bump(n: inout i64) { n = n + 1; }

fn twice(n: i64) -> i64 { n * 2 }

fn total(v: Vec<i64>) -> i64 {
    var s = 0;
    for x in v {
        s += x;
    }
    s
}

fn fill(v: inout Vec<i64>, k: i64) {
    for i in 0..k {
        v.push(i);
    }
}

fn pass_on(v: inout Vec<i64>) { fill(&v, 2); }

fn take(v: sink Vec<i64>) -> i64 {
    v.push(100);
    v.len()
}

struct Big { d: Vec<i64> }

impl Add for Big {
    fn add(self, other: Self) -> Self {
        var d = self.d.clone();
        for i in 0..self.d.len() {
            d[i] = self.d[i] + other.d[i];
        }
        Big { d: d }
    }
}

struct P { x: i64 }

impl Add for P {
    fn add(self, other: Self) -> Self { P { x: self.x + other.x } }
}

struct Inv { items: Vec<i64> }

impl Inv {
    fn add(inout self, q: i64) { self.items.push(q); }
    fn total(self) -> i64 { total(self.items) }
    fn into_count(sink self) -> i64 { self.items.len() }
}

fn main(gpa: Gpa) {
    var a = Acc { balance: 100, log: Vec::new_in(gpa) };
    var b = Acc { balance: 5, log: Vec::new_in(gpa) };
    transfer(&a, &b, 30);
    var sum = 0;
    report(a, &sum);
    report(b, &sum);
    bump(&sum);
    println(f"{sum} {a.log.len()} {twice(sum)}");
    var v: Vec<i64> = Vec::new_in(gpa);
    inout r = &v;
    fill(&r, 3);
    r.push(7);
    pass_on(&r);
    println(f"{total(v)} {v.len()} {take(v)}");
    var x = Big { d: Vec::new_in(gpa) };
    x.d.push(1);
    var y = Big { d: Vec::new_in(gpa) };
    y.d.push(2);
    let c = x + y;
    let e = x + c;
    let p = P { x: 1 } + P { x: 2 };
    println(f"{c.d[0]} {e.d[0]} {y.d.len()} {p.x}");
    var inv = Inv { items: Vec::new_in(gpa) };
    inv.add(3);
    inv.add(5);
    println(f"{inv.total()} {inv.into_count() + 1}");
    var acc = 0;
    let add_to = |s: inout i64, k: i64| s += k;
    add_to(&acc, 2);
    add_to(&acc, 4);
    println(acc);
}
