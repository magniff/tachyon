// `if` as an expression: in let, in arguments, in arithmetic, with
// statements before the tail, and producing floats and bools.
// EXPECT: 10 210 3.0 0 7
// EXPECT: 255
extern "C" {
    fn printf(format: *u8, ...) -> i32;
}

fn main() -> i64 {
    let c = true;
    let a = if c { 10 } else { 20 };
    let b = (if !c { 1 } else { 2 }) * 100 + a;
    let f: f64 = if a > 5 { let t: f64 = 1.5; t * 2.0 } else { 0.0 };
    let flag = if b > 200 { false } else { true };
    unsafe { printf(c"%ld %ld %.1f %d %ld\n", a, b, f, flag, if c { 7 } else { 8 }); }
    let x: u8 = if c { 255 } else { 0 };
    unsafe { printf(c"%d\n", x); }
    0
}
