// (0.25 semantics audit, views) Two levels of owned containers, read
// with std's accessors in one function: `vv.get(0).get(0)` of a
// Vec<Vec<str>>, `m.get(1).unwrap().get(0)` of a HashMap<i64, Vec<str>>,
// `o.unwrap().get(0)` of an Option<Vec<str>>, `l.get(0)[1]` of a
// Vec<[str; 2]>, `mk(w).get(0)` of a returned Vec<str> all view s. One
// level (`v.get(0)`, `m.get(1).unwrap()`) is caught.
// ERROR: error[own.conflict]
fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    var v: Vec<str> = Vec::new_in(gpa);
    v.push(s.as_str());
    var vv: Vec<Vec<str>> = Vec::new_in(gpa);
    vv.push(v);
    let r = vv.get(0).get(0);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
