// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text stored with `?`; s grows while it is used
// XFAIL: SOUNDNESS a view stored through an index place, an access or a projection is not recorded: use after free
// ERROR: error[own.conflict]
struct D { t: str }
struct B { l: Vec<str> }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    let w = s.as_str();
    var o: Option<Vec<str>> = Some(Vec::new_in(gpa)); match &o { Some(l) => l.push(w), None => {} }
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(o.unwrap().get(0));
    0
}
