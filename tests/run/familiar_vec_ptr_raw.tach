// 0.17: `p[i]` on any pointer to a Vec, a Buf or a slice indexes the one
// it points to, checked: through a raw pointer (a local holding one, a
// field, a static, a `mut` parameter) as through a borrow. Raw, it is
// unsafe code; its meaning is the same. Other pointers (*i64) still index
// memory from p.
// EXPECT: 1 2 4
// EXPECT: 10 2
// EXPECT: 20 30
// EXPECT: 110 5
// EXPECT: lo o 2
// EXPECT: 1 2
// EXPECT: 7 8
// EXPECT: 9 9
static mut WORDS: *[u8] = 0 as *[u8];

struct H { vp: *Vec<i64> }

// the same body through a borrow and through a `mut` parameter
fn get_b(v: &Vec<i64>, i: i64) -> i64 { v[i] }

fn get_m(mut v: *Vec<i64>, i: i64) -> i64 { unsafe { v[i] } }

fn bump_m(mut v: *Vec<i64>) {
    unsafe {
        v[0] += 100;
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut a: Vec<i64> = Vec::new_in(gpa);
    a.push(1);
    a.push(2);
    a.push(4);
    // a local holding a pointer: the Vec's elements, not the Vec after it
    let p = &a;
    println(f"{unsafe { p[0] }} {unsafe { p[1] }} {unsafe { p[2] }}");
    unsafe {
        p[0] = 10;
        println(f"{a[0]} {p[1..3].len()}");
    }
    let h = H { vp: &a };
    unsafe {
        h.vp[1] = 20;
        let e = &mut h.vp[2];
        *e = 30;
    }
    println(f"{a[1]} {a[2]}");
    bump_m(&a);
    println(f"{get_b(&a, 0)} {get_b(&a, 0) - get_m(&a, 0) + 5}");
    // a static pointer to a slice indexes the slice
    let word = "lo";
    unsafe {
        WORDS = &word;
        println(f"{WORDS[0..2]} {WORDS[1..2]} {WORDS[0..2].len()}");
    }
    // a Buf
    let mut b = Buf::new_in(gpa);
    b.push_str("12");
    let bp = &b;
    println(f"{unsafe { bp[0] - '0' }} {unsafe { bp[1] - '0' }}");
    // pointer arithmetic on other pointers, unchanged
    let xs = [7, 8, 9];
    let q = &xs[0];
    println(f"{unsafe { q[0] }} {unsafe { q[1] }}");
    let r = &xs[2];
    println(f"{unsafe { r[0] }} {unsafe { q[2] }}");
    0
}
