// Recursion through a fn value may not end: diverge.
// ERROR: 'calm' is #[effects(panic)], but it may not terminate (diverge)
fn tramp(f: fn(i64) -> i64, n: i64) -> i64 { f(n) }

fn count(n: i64) -> i64 { if n <= 0 { 0 } else { tramp(count, n - 1) + 1 } }

#[effects(panic)]
fn calm(n: i64) -> i64 { count(n) }

fn main() -> i32 {
    println(calm(3));
    0
}
