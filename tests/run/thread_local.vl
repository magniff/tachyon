// (0.21) #[thread_local] statics: each thread starts from the initial
// value and changes only its own copy (an integer, an array, a struct, a
// zeroed one, one reached through its address); the main thread's copy is
// untouched by the others'.
// EXPECT: main 10 [1, 2, 3] 7 0
// EXPECT: threads 6
// EXPECT: main after 11 [1, 2, 3] 7 0

use std::thread;

struct P { x: i64, y: i64 }

#[thread_local]
static var COUNT: i64 = 10;
#[thread_local]
static var ARR: [i64; 3] = [1, 2, 3];
#[thread_local]
static var PT: P = P { x: 7, y: 0 };
#[thread_local]
static var ZERO: i64 = 0;

fn bump(p: *i64, by: i64) {
    unsafe { *p += by; }
}

fn work(k: i64) -> i64 {
    var ok = 0;
    if COUNT == 10 && ARR[1] == 2 && PT.x == 7 && ZERO == 0 { ok += 1; }
    for _ in 0..1000 {
        COUNT += k;
        ARR[0] += 1;
        PT.y += 2;
        bump(&ZERO as *i64, 3);
        thread::yield_now();
    }
    if COUNT == 10 + 1000 * k && ARR[0] == 1001 && PT.y == 2000 && ZERO == 3000 { ok += 1; }
    ok
}

fn main(gpa: Gpa) {
    println(f"main {COUNT} [{ARR[0]}, {ARR[1]}, {ARR[2]}] {PT.x} {ZERO}");
    var hs: Vec<thread::JoinHandle<i64>> = Vec::new_in(gpa);
    for k in 1..4 {
        hs.push(thread::spawn(sink || work(k)));
    }
    var total = 0;
    while hs.len() > 0 { total += hs.pop().unwrap().join(); }
    println(f"threads {total}");
    COUNT += 1;
    println(f"main after {COUNT} [{ARR[0]}, {ARR[1]}, {ARR[2]}] {PT.x} {ZERO}");
}
