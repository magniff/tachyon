// A loop that runs zero times with an unguarded index.
// FLAGS: -O2
// EXPECT: 0
static var Z: i64 = 0;



fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() - 1;
    let i = -1099511627776 + Z;
    let a = [1, 2, 3];
    var t = 0;
    var k = 0;
    while k < Z { t += a[i]; k += 1; }
    println(t);
    0
}
