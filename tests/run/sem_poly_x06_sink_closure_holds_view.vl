// a sink closure holding a view of v, v grown before the call
// ERROR: [own.conflict]: 'v.push(i)' may change 'v' while 'c'
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    let s = v.as_slice();
    let c = sink || s[0];
    for i in 0..1000 { v.push(i); }
    println(f"{c()}");
}
