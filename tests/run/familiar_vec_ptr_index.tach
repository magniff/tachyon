// 0.17: through a borrow of a Vec, a Buf or a slice (a pointer parameter,
// `&v`), `p[i]` indexes the pointee: `p.as_slice()[i]`, `(*p)[i]` for a
// slice; read, assign, compound-assign, slicing, generic; checked, safe.
// EXPECT: true false 7
// EXPECT: 1 9 7 -1
// EXPECT: azc z
// EXPECT: 16 16
// EXPECT: 2 9 3
// EXPECT: 9 7
fn relax(dist: &mut Vec<i64>, u: i64, nd: i64) -> bool {
    if dist[u] < 0 || nd < dist[u] {
        dist[u] = nd;
        return true;
    }
    false
}

fn bump(b: &mut Buf, i: i64) -> &mut [u8] {
    b[i] += 1;
    &mut b[i..i + 1]
}

fn total(s: *[i64]) -> i64 {
    let mut t = 0;
    for i in 0..(*s).len {
        t += s[i];
    }
    s[0] = t;
    t
}

fn mid(v: &Vec<i64>) -> [i64] { v[1..3] }

fn tail(s: *[i64]) -> [i64] { s[1..] }

fn at<T>(v: &Vec<T>, i: i64) -> T { v[i] }

fn main(gpa: Gpa) -> i32 {
    let mut d: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..4 {
        d.push(-1);
    }
    let a = relax(&mut d, 2, 7);
    let b = relax(&mut d, 2, 9);
    println(f"{a} {b} {d[2]}");
    d[0] = 1;
    d[1] += 10;
    println(f"{d[0]} {d[1]} {d[2]} {d[3]}");
    let mut buf = Buf::new_in(gpa);
    buf.push_str("abc");
    let one = bump(&mut buf, 1);
    one[0] = 'z';
    let one: [u8] = one;
    print(buf.as_slice());
    println(f" {one}");
    let s = d.as_slice();
    let t = total(&s);
    println(f"{t} {d[0]}");
    let m = mid(&d);
    println(f"{m.len} {m[0]} {tail(&s).len}");
    println(f"{at(&d, 1)} {(&d)[2]}");
    0
}
