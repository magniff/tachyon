// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: self is borrowed (the result views it) and o aliases it
// ERROR: error[own.conflict]
struct E { name: [u8; 4], len: i64 }
impl E { fn mix(self, o: inout E) -> [u8] { o.name[0] = 'J'; self.name[..self.len] } }

fn main() -> i32 {
    var e = E { name: ['a', 'b', 'c', 'd'], len: 4 };
    let n = e.mix(&e);
    println(n);
    0
}
