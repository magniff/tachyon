// scoped handles in a Vec returned out of thread::scope
// ERROR: [sync.scope_escape]: the closure given to thread::scope returns Vec<ScopedJoinHandle<i64>>
use std::thread;

fn main(gpa: Gpa) {
    let hs = thread::scope(|sc| {
        var hs: Vec<thread::ScopedJoinHandle<i64>> = Vec::new_in(gpa); hs.push(sc.spawn(|| 1)); hs
    });
    println(f"{hs.len()}");
}
