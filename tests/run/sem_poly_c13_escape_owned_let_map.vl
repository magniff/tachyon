// an owned let captured by access (Vec), the iterator adapter escapes the block that drops it
// ERROR: [type error]: this value holds a closure that borrows 'w2', which does not
fn main(gpa: Gpa) {
    let m = {
        var w: Vec<i64> = Vec::new_in(gpa);
        w.push(1); w.push(2); w.push(3);
        let w2 = w;
        (0..3).map(|i| w2[i] * 10)
    };
    println(f"{m.sum()}");
}
