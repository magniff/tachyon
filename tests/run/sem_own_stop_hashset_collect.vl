// sem-own (iterator stopgap): HashSet::iter of owned elements, collected.
// XFAIL: SOUNDNESS accepted: HashSet::iter().collect_in of owned elements frees them twice
// ERROR: own.
use std::HashMap;
struct K { id: i64, v: Vec<i64> }
impl Drop for K { fn drop(inout self) { println(f"drop {self.id}"); } }
impl Eq for K { fn eq(self, other: K) -> bool { self.id == other.id } }
impl Hash for K { fn hash(self) -> u64 { self.id as u64 } }
fn mk(id: i64, gpa: Gpa) -> K { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); K { id: id, v: v } }
impl Ord for K { fn cmp(self, other: K) -> i64 { self.id - other.id } }

fn main(gpa: Gpa) {
    var s: std::HashSet<K> = std::HashSet::new_in(gpa);
    s.insert(mk(1, gpa));
    let c: Vec<K> = s.iter().collect_in(gpa);
}
