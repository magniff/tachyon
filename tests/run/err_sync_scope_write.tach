// (0.21) The scope's closure may not change what its threads may read.
// ERROR: the closure given to 'thread::scope' changes 'v', which its threads may read at the same time

use std::thread;

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let n = thread::scope(|s| {
        let h = s.spawn(|| v.len());
        v.push(2);
        h.join()
    });
    println(f"{n}");
}
