// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello / 5
// EXPECT: hello
// EXPECT: 5
struct E { name: [u8; 8], len: i64 }
impl E { fn name(self) -> [u8] { self.name[..self.len] } }
fn mk() -> E { E { name: ['h', 'e', 'l', 'l', 'o', 0, 0, 0], len: 5 } }

fn main() -> i32 {
    let e = mk();
    let n = e.name();
    println(n);
    println(n.len());
    0
}
