// -g (0.11): line tables. The program behaves the same; the assembly has
// a `.file` per source file, `.loc`s of both, and the debug sections
// (tests/debug.sh runs a debugger on such a program; tests/objcheck.sh
// compares the line tables with the system assemblers'). (0.18) The
// files are named by their absolute paths (the root's directory, the
// compile unit's DW_AT_comp_dir, and the name relative to it), whatever
// the current directory.
// FLAGS: -g
// EXPECT: 30 7
// EXPECT: odd 3
// ASM(aarch64-macos): debug_lines/main.tach"
// ASM(aarch64-macos): .cfi_startproc
// ASM(aarch64-macos): .loc 1
// ASM(aarch64-macos): debug_lines/sums.tach"
// ASM(aarch64-macos): .loc 2
// ASM(aarch64-macos): __debug_info
// ASM(aarch64-macos): __debug_line
// ASM(x86_64-linux): debug_lines/main.tach"
// ASM(x86_64-linux): .loc 1
// ASM(x86_64-linux): debug_lines/sums.tach"
// ASM(x86_64-linux): .loc 2
// ASM(x86_64-linux): .debug_info
// ASM-NOT(x86_64-linux): .cfi_
// ASM(x86_64-linux): .debug_line
// ASM(aarch64-linux): debug_lines/main.tach"
// ASM(aarch64-linux): .loc 1
// ASM(aarch64-linux): debug_lines/sums.tach"
// ASM(aarch64-linux): .loc 2
// ASM(aarch64-linux): .debug_info
// ASM(aarch64-linux): .debug_line
extern "C" {
    fn printf(fmt: *u8, ...) -> i32;
}

use crate::sums::{Kind, squares};

mod sums;

fn main() {
    let total = squares(4);
    let mut odd = 0;
    for i in 0..total {
        match sums::kind(i) {
            Kind::Odd => odd += 1,
            Kind::Even => {}
        }
        if i > 5 {
            break;
        }
    }
    unsafe {
        printf(c"%lld %lld\n", total, squares(1) + 6);
        printf(c"odd %lld\n", odd);
    }
}
