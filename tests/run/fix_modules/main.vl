// FIXIMPORTS: every file of a program of several modules is rewritten (0.8)
// FIXED: use util::{LIMIT, twice};
// FIXED: import "stdio.h" as c;
// FIXED:     c::printf(c"put %ld\n", x);
// FIXED:     use super::{c, put};
// FIXED:         c::printf(c"hello\n");
// EXPECT: put 42
// EXPECT: hello
// EXPECT: put 1
// A plain header import in a module, seen by its inline module through
// `use super::*`: the inline module imports the C module's name.
mod util;
mod show;
use util::*;

fn main() -> i32 {
    show::put(twice(LIMIT));
    show::nested::hello();
    0
}
