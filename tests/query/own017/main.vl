struct Tok { text: [u8], kind: i64 }

fn total(v: Vec<i64>) -> i64 {
    var s = 0;
    for x in v { s += x; }
    s
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let first = v.as_slice();
    let t = Tok { text: "word", kind: 1 };
    let n = total(v);
    if n > 0 {
        let k = first[0] + t.kind;
        println(f"{k}");
    }
}
