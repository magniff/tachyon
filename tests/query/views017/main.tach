// `query views` (0.17 T3): declared summaries, the parametric floor of
// std's generic results, the type filter, stores, and what def and show
// print after the effects.
struct Tok { text: [u8], k: i64 }

// A declaration, as callers see it: `p` means every level from p, `*p`
// what p's views point into.
#[views(s)]
fn first_word(s: [u8]) -> [u8] {
    s[0..1]
}

// The type filter: a [Tok] view can point into 'toks' but not into
// 'counts', which holds no Tok and no text.
#[views(toks, counts)]
fn pick(toks: &Vec<Tok>, counts: &Vec<i64>) -> [Tok] {
    toks.as_slice()
}

// A view of what the tokens view (the text), not of the tokens.
#[views(*toks)]
fn text_of(toks: &Vec<Tok>, i: i64) -> [u8] {
    toks.get(i).text
}

#[stores(word)]
fn intern(names: &mut Vec<[u8]>, word: [u8]) {
    names.push(word);
}

fn count(toks: &Vec<Tok>) -> i64 {
    toks.len()
}

fn main(gpa: Gpa) {
    let mut toks: Vec<Tok> = Vec::new_in(gpa);
    toks.push(Tok { text: "ab", k: 1 });
    let counts: Vec<i64> = Vec::new_in(gpa);
    let mut seen: Vec<[u8]> = Vec::new_in(gpa);
    intern(&mut seen, text_of(&toks, 0));
    println(f"{first_word("xy")} {pick(&toks, &counts).len} {count(&toks)}");
}
