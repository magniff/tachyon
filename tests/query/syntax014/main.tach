// The syntax of 0.14 (phase 0): what the parser takes, before the checking
// is implemented. Closures with patterns and types in their parameters,
// `Fn` bounds, associated types and constraints.

trait Source {
    type Item;
    fn get(self: *Self) -> Self::Item;
}

struct C { n: i64 }

impl Source for C {
    type Item = i64;
    fn get(self: *C) -> i64 {
        self.n
    }
}

fn apply<F: Fn(i64) -> i64, I: Source<Item = i64>>(f: F, it: I) -> I::Item {
    f(it.get())
}

fn main() -> i64 {
    let k = 3;
    let add = |x: i64| x + k;
    let pair = move |(a, b): (i64, i64), _, mut c| -> i64 { a + b + c };
    let none = || k;
    apply(|x| x + 1, C { n: k })
}
