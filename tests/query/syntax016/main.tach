// The syntax of 0.16: effect declarations, effects bounds, default type
// parameters, #[sealed] and #[scoped].

extern "C" {
    #[link_name = "write"]
    #[effects(io)]
    fn out_write(fd: i32, data: *u8, count: u64) -> i64;
    #[pure]
    fn labs(x: i64) -> i64;
}

trait Shape {
    #[pure]
    fn area(self: &Self) -> i64;
}

#[sealed]
struct Square { side: i64 }

impl Shape for Square {
    #[effects()]
    fn area(self: &Square) -> i64 { self.side * self.side }
}

#[sealed]
#[scoped]
struct Handle { id: i64 }

struct Pair<T, U = i64> { a: T, b: U }

#[no_alloc]
#[no_io]
fn apply<F: Fn(i64) -> i64 + effects(panic)>(f: F, x: i64) -> i64 {
    f(x)
}

#[effects(alloc(Gpa), panic)]
fn grow(v: &mut Vec<i64>) {
    v.push(1);
}

fn main(gpa: Gpa) {
    let s = Square { side: 3 };
    let p: Pair<i64> = Pair { a: s.area(), b: unsafe { labs(-2) } };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    grow(&mut v);
    let h = Handle { id: apply(|x| x + 1, p.a) };
    println(h.id + p.b + v.len());
    v.free();
}
