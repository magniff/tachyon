// `query similar` (0.17): the items like one, nearest first.
mod shapes;

use crate::shapes::{Circle, Square, area_circle, area_square};

fn twice(x: i64) -> i64 {
    x * 2
}

fn thrice(x: i64) -> i64 {
    x * 3
}

fn main() {
    let c = Circle { r: 2 };
    let s = Square { side: 3 };
    let total = area_circle(c) + area_square(s) + twice(1) + thrice(1) + c.diameter() + s.perimeter();
    if total != 12 + 9 + 2 + 3 + 4 + 12 {
        unsafe { exit(1) };
    }
}

extern "C" {
    fn exit(code: i32);
}
