// Shapes, their areas and their methods.

pub struct Circle {
    pub r: i64,
}

pub struct Square {
    pub side: i64,
}

impl Circle {
    // Twice the radius.
    pub fn diameter(self) -> i64 {
        2 * self.r
    }

    // Four times the radius.
    pub fn double_diameter(self) -> i64 {
        4 * self.r
    }
}

impl Square {
    pub fn perimeter(self) -> i64 {
        4 * self.side
    }
}

// 3 r^2, near enough.
pub fn area_circle(c: Circle) -> i64 {
    3 * c.r * c.r
}

// side^2.
pub fn area_square(s: Square) -> i64 {
    s.side * s.side
}
