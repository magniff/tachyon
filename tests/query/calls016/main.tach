mod table;

use table::{grow, peek};

// Adds x to the table, then sums it.
fn add_and_sum(x: i64) -> i64 {
    grow(x);
    sum()
}

fn sum() -> i64 {
    let mut total = 0;
    let n = peek();
    for i in 0..n {
        total += i;
    }
    total = total * 2;
    total
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn twice(x: i64) -> i64 {
    x * 2
}

fn main() {
    let t = add_and_sum(3);
    let u = apply(twice, t);
    let mut total = u;
    total += 1;
    let total = total + sum();
    std::print_int(total);
}
