pub struct Table { pub data: [i64; 8], pub count: i64 }

pub static mut TABLE: Table = Table { data: [0; 8], count: 0 };

// One more item: the table grows.
pub fn grow(x: i64) {
    unsafe {
        put(&TABLE, x);
    }
}

fn put(t: *Table, x: i64) {
    unsafe {
        (*t).data[(*t).count] = x;
        (*t).count += 1;
    }
}

pub fn peek() -> i64 {
    unsafe { TABLE.count }
}

pub fn reset() {
    unsafe {
        TABLE.count = 0;
    }
}
