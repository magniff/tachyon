// query type and refs on 0.15's checked syntax: `?`, widening, f-strings, derive.
#[derive(Eq, Ord, Debug, Clone)]
struct P { x: i64, y: i64 }

fn half(v: i64) -> Option<i64> {
    if v % 2 == 0 { Some(v / 2) } else { None }
}

fn quarter(v: i64) -> Option<i64> {
    let h = half(v)?;
    half(h)
}

fn wide(n: i32) -> i64 {
    let m: i64 = n;
    m + n
}

fn main() -> i32 {
    let p = P { x: 1, y: 2 };
    let q = p.clone();
    let n: i32 = 7;
    println(f"p = {p:?}, sum = {p.x + q.y:>4}, n = {n}");
    match quarter(8) { Some(2) => (wide(n) - 14) as i32, _ => 1 }
}
