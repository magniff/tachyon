// A user type named like std's Vec, with push, len and an inherent add.
pub struct Vec {
    pub n: i64,
}

impl Vec {
    pub fn push(self: *Vec, x: i64) {
        (*self).n += x;
    }

    pub fn len(self: *Vec) -> i64 {
        (*self).n
    }

    pub fn add(self: *Vec, k: i64) {
        (*self).n += k;
    }
}
