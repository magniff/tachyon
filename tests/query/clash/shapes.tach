pub trait Area {
    fn area(self: &Self) -> i64;
    // A default.
    fn twice(self: &Self) -> i64 {
        self.area() * 2
    }
}

pub struct Square {
    pub side: i64,
}

impl Area for Square {
    fn area(self: &Square) -> i64 {
        self.side * self.side
    }
}

pub enum Shape {
    Circle(i64),
    Dot,
}

pub const UNIT: i64 = 1;
pub static mut COUNT: i64 = 0;
pub type Side = i64;
