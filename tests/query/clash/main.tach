// A program for tests/query/run.sh: names that clash across modules,
// types, traits, std and the C headers.
mod a;
mod b;
mod geom;
mod shapes;
mod myvec;

mod sys {
    pub struct SockaddrIn { pub port: i64 }
}

import "stdio.h" as c;

use a::helper as a_helper;
use geom::{Point, V2};
use shapes::{Area, Shape, Square};
use myvec::Vec as MyVec;

/// The user's own printf (the C one is c::printf).
fn printf(x: i64) -> i64 {
    x + 1
}

// Generic: its body is checked once per instance.
fn twice_generic<T: Area>(x: &T) -> i64 {
    x.area() + x.area()
}

fn main(gpa: Gpa) -> i32 {
    let helper = 3;
    let n = a_helper() + b::helper() + helper;
    let p = a::Point { x: Point(n) };
    let s = sys::SockaddrIn { port: p.x };
    let v = V2 { x: 1, y: 2 } + V2 { x: 3, y: 4 };
    let sq = Square { side: 2 };
    let mut std_vec: Vec<i64> = Vec::new_in(gpa);
    std_vec.push(s.port);
    let mut mine = MyVec { n: 0 };
    mine.push(v.len());
    mine.add(1);
    let shape = Shape::Circle(2);
    let r = match shape {
        Shape::Circle(k) => k,
        Shape::Dot => 0,
    };
    let total = twice_generic(&sq) + twice_generic(&v) + sq.twice() + mine.len() + printf(r);
    unsafe {
        c::printf(c"%d\n", total as i32);
    }
    0
}
