use crate::shapes::Area;

// A function named like a::Point.
pub fn Point(x: i64) -> i64 {
    x * 2
}

pub struct V2 {
    pub x: i64,
    pub y: i64,
}

impl V2 {
    /// Its squared length.
    pub fn len(self: *V2) -> i64 {
        self.x * self.x + self.y * self.y
    }
}

impl Add for V2 {
    fn add(self: V2, o: V2) -> V2 {
        V2 { x: self.x + o.x, y: self.y + o.y }
    }
}

impl Area for V2 {
    fn area(self: *V2) -> i64 {
        self.x * self.y
    }
}
