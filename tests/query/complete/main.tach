// A program for the queries of 0.13 (tests/query/complete.q): banners and
// comments between items, text in code, comments and strings, references
// of every kind, `Self`, an import alias, a generic function nobody
// instantiates.

mod shapes;

use shapes::{Shape, area_of as area};

// ---- State ----

static var COUNT: i64 = 0;

// A counter: how many shapes were made.
pub struct Counter {
    n: i64,
}

impl Counter {
    pub fn new() -> Self {
        Self { n: 0 }
    }

    pub fn bump(inout self) -> i64 {
        self.n += 1;
        self.n
    }
}

// ---- Shapes ----

// (the shapes come from shapes.tach)

fn make(k: i64) -> Shape {
    unsafe {
        COUNT = COUNT + 1;
    }
    if k == 0 { Shape::Square(2) } else { Shape::Circle(1) }
}

// Never instantiated: its references are found all the same.
fn twice_area<T>(x: sink T, s: Shape) -> i64 {
    let c = Counter::new();
    area(s) + area(s) + unsafe { COUNT }
}

fn main() -> i32 {
    var c = Counter::new();
    let s = make(0);
    let label = "area of the shape";
    let r = match s {
        Shape::Square(n) => c.bump() + n,
        Shape::Circle(_) => area(s),
    };
    r as i32
}
