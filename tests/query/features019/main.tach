// `query features` (0.19): what each function needs beyond the build's
// features, and why.
use std::arch::aarch64::__crc32cd;
use std::arch::detect;

fn hw(c: u32, x: u64) -> u32 {
    __crc32cd(c, x)
}

fn twice(c: u32) -> u32 {
    hw(hw(c, 1), 2)
}

#[target_feature(enable = "crc")]
fn declared(c: u32) -> u32 {
    hw(c, 3)
}

fn guarded(c: u32) -> u32 {
    if detect("crc") { twice(c) } else { c }
}

fn main() {
    println(f"{guarded(1)}");
}
