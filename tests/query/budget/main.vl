// The output budget (tests/query/budget.q): `bump` is called 70 times
// in two files (more than refs prints in full: 60), six modules have a
// `size` (more than show prints: 5), and a line is longer than 100 bytes.
mod util;

mod m1 { pub fn size() -> i64 { 1 } }
mod m2 { pub fn size() -> i64 { 2 } }
mod m3 { pub fn size() -> i64 { 3 } }
mod m4 { pub fn size() -> i64 { 4 } }
mod m5 { pub fn size() -> i64 { 5 } }
mod m6 { pub fn size() -> i64 { 6 } }

fn many() -> i64 {
    var t = 0;
    t += util::bump(0);
    t += util::bump(1);
    t += util::bump(2);
    t += util::bump(3);
    t += util::bump(4);
    t += util::bump(5);
    t += util::bump(6);
    t += util::bump(7);
    t += util::bump(8);
    t += util::bump(9);
    t += util::bump(10);
    t += util::bump(11);
    t += util::bump(12);
    t += util::bump(13);
    t += util::bump(14);
    t += util::bump(15);
    t += util::bump(16);
    t += util::bump(17);
    t += util::bump(18);
    t += util::bump(19);
    t += util::bump(20);
    t += util::bump(21);
    t += util::bump(22);
    t += util::bump(23);
    t += util::bump(24);
    t += util::bump(25);
    t += util::bump(26);
    t += util::bump(27);
    t += util::bump(28);
    t += util::bump(29);
    t += util::bump(30);
    t += util::bump(31);
    t += util::bump(32);
    t += util::bump(33);
    t += util::bump(34);
    t += util::bump(35);
    t += util::bump(36);
    t += util::bump(37);
    t += util::bump(38);
    t += util::bump(39);
    t
}

fn long_line() -> i64 {
    util::bump(1) + util::bump(2) + util::bump(3) + util::bump(4) + util::bump(5) + util::bump(6) + util::bump(7)
}

fn main() -> i32 {
    (many() + long_line() + m1::size()) as i32
}
