pub fn bump(x: i64) -> i64 {
    x + 1
}

pub fn more() -> i64 {
    var t = 0;
    t += bump(0);
    t += bump(1);
    t += bump(2);
    t += bump(3);
    t += bump(4);
    t += bump(5);
    t += bump(6);
    t += bump(7);
    t += bump(8);
    t += bump(9);
    t += bump(10);
    t += bump(11);
    t += bump(12);
    t += bump(13);
    t += bump(14);
    t += bump(15);
    t += bump(16);
    t += bump(17);
    t += bump(18);
    t += bump(19);
    t += bump(20);
    t += bump(21);
    t += bump(22);
    t
}
