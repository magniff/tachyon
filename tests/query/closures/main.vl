// Closures for the queries of 0.14 (tests/query/closures.q): a closure's
// type, references inside closure bodies, no item for a closure's
// function or environment.

fn double(x: i64) -> i64 {
    x * 2
}

fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
    f(x)
}

fn main() -> i32 {
    let k = 3;
    let add = |x: i64| double(x) + k;
    let n = apply(add, 1) + apply(|y| double(y), 2);
    (n - 9) as i32
}
