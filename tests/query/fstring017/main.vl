use std::{Buf, Display, Gpa, format_in, println};

fn show<T: Display>(x: sink T) {
    println(x);
}

fn main(gpa: Gpa) {
    let n = 4;
    println(f"n = {n}");
    show(f"n = {n}");
    var b: Buf<Gpa> = Buf::new_in(gpa);
    b.push_fmt(f"[{n}]");
    var t = format_in(f"{n}!", gpa);
    println(t.as_slice());
    b.free();
    t.free();
}
