// The run-time checks left after the optimizer, and the ones it removed
// (0.18): a requires the loop's bounds prove, an index that stays.
fn get(s: [i64], i: i64) -> i64
    requires 0 <= i && i < s.len()
{
    s[i]
}

#[inline(never)]
fn sum(s: [i64]) -> i64 {
    var t = 0;
    for i in 0..s.len() {
        t += get(s, i);
    }
    t
}

#[inline(never)]
fn pick(s: [i64], k: i64) -> i64 {
    get(s, k)
}

fn main() -> i32 {
    let a = [1, 2, 3];
    let k = sum(a[..]) % 4;
    std::print_int(pick(a[..], k));
    0
}
