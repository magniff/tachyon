use std::Buf;

pub enum Shape {
    Circle(i64),
    Square(i64),
}

impl Shape {
    pub fn area(self: &Shape) -> i64 {
        match *self {
            Shape::Circle(r) => 3 * r * r,
            Shape::Square(s) => s * s,
        }
    }

    pub fn name(self: &Shape) -> [u8] {
        "shape"
    }
}

fn main(gpa: Gpa) -> i32 {
    let s = Shape::Square(2);
    let mut b = Buf::new_in(gpa);
    b.push_str(s.name());
    s.area() as i32
}
