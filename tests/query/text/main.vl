// A program for query text, show FILE, the named regions and
// --with-comments (tests/query/text.q).
//
// Its header comment ends here.

mod util;

use util::{
    twice,
};
use util::half;

extern "C" {
    fn abs(x: i32) -> i32;
}

// ---- Arithmetic ----

// Four times x.
fn quad(x: i64) -> i64 {
    twice(twice(x))
}

fn main() -> i32 {
    let a = unsafe { abs(-2) } as i64;
    if quad(a) + half(4) == 10 { 0 } else { 1 }
}
