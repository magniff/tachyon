// A program with errors, for tests/query/run.sh: a syntax error, a type
// error, an unknown name and a missing module file; the queries answer
// with what the front end got to.
mod util;
mod missing;

fn good(x: i64) -> i64 {
    util::twice(x) + 1
}

fn bad_types() -> i64 {
    let b: bool = 3;
    good(2)
}

fn bad_syntax() -> i64 {
    let x = (1 + ;
    good(x)
}

fn unknown() -> i64 {
    nowhere(1) + good(3)
}

fn main() -> i32 {
    good(1) as i32
}
