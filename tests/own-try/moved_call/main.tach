// §2.9 situation 1: a value used after it moved into a call that only
// reads it.
// OWN: own.moved
// TRY: total(v.clone())
fn total(v: Vec<i64>) -> i64 { let mut s = 0; for x in v { s += x; } s }

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let n = total(v);
    v.push(n);
    println(f"{v.len()}");
}
