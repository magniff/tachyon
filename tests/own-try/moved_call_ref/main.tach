// §2.9 situation 1, its first try: the callee only reads the value, so
// the parameter becomes a reference.
// OWN: own.moved
// TRY: refactor signature total --type v '&Vec<i64>' --default '&$v'
// XFAIL: §2.9's first try: (the callee only reads its parameter: take it
// by reference) is not in own.moved's lines yet
fn total(v: sink Vec<i64>) -> i64 { var s = 0; for x in v { s += x; } s }

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let n = total(v);
    v.push(n);
    println(f"{v.len()}");
}
