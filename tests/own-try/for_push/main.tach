// §2.9 situation 4: changing a collection while iterating over it.
// OWN: own.conflict
// TRY: --new 'for i in 0..v.len() { let x = v[i];'
fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(8);
    for x in v { if x % 2 == 0 { v.push(x / 2); } }
    println(f"{v.len()}");
}
