// §2.9 situation 6, the rejection that remains: a lexer that owns its
// text hands out views of it while it is still changed.
// OWN: own.conflict
// TRY: refactor field Lexer --type src '[u8]' --default '$src.as_slice()'
// TRY: --old 'lx.word()' --new 'Buf::from(lx.word())'
// XFAIL: T2 (views), T3 (summaries)
struct Lexer { src: Buf, pos: i64 }

impl Lexer {
    fn word(inout self) -> [u8] {
        let a = self.pos;
        while self.pos < self.src.len() && self.src.as_slice()[self.pos] != ' ' {
            self.pos += 1;
        }
        let b = self.pos;
        self.pos += 1;
        self.src.as_slice()[a..b]
    }
}

fn main(gpa: Gpa) {
    var text = Buf::new_in(gpa);
    text.push_str("ab cd");
    var lx = Lexer { src: text, pos: 0 };
    let a = lx.word();
    let b = lx.word();
    println(f"{a} {b}");
}
