// "Pending: eval findings", situation 7: a reference kept in a local and
// passed to several helpers, and one kept in a field, check clean; `&x` to
// a legacy `*T` parameter too.
// OWN: none
struct Query { nodes: Vec<i64> }
struct Parser { q: &mut Query, pos: i64 }
struct State { pos: i64 }

fn bump(s: &mut State) { s.pos += 1; }
fn peek(s: &State) -> i64 { s.pos }
fn old(s: &mut State) { s.pos += 2; }

impl Parser {
    fn add(self: &mut Parser, n: i64) { self.q.nodes.push(n); self.pos += 1; }
}

fn main(gpa: Gpa) {
    let mut ps = State { pos: 0 };
    let p = &mut ps;
    bump(p);
    bump(p);
    let k = peek(p);
    old(&mut ps);
    let mut q = Query { nodes: Vec::new_in(gpa) };
    let mut parser = Parser { q: &mut q, pos: 0 };
    parser.add(5);
    parser.add(6);
    println(f"{k} {ps.pos} {q.nodes.len()}");
}
