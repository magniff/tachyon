// "Pending: eval findings", situation 7: a reference kept in a local and
// passed to several helpers, and one kept in a field, check clean; `&x` to
// a legacy `*T` parameter too.
// OWN: none
struct Query { nodes: Vec<i64> }
struct Parser { q: inout Query, pos: i64 }
struct State { pos: i64 }

fn bump(s: inout State) { s.pos += 1; }
fn peek(s: State) -> i64 { s.pos }
fn old(s: inout State) { s.pos += 2; }

impl Parser {
    fn add(inout self, n: i64) { self.q.nodes.push(n); self.pos += 1; }
}

fn main(gpa: Gpa) {
    var ps = State { pos: 0 };
    inout p = &ps;
    bump(&p);
    bump(&p);
    let k = peek(p);
    old(&ps);
    var q = Query { nodes: Vec::new_in(gpa) };
    var parser = Parser { q: &q, pos: 0 };
    parser.add(5);
    parser.add(6);
    println(f"{k} {ps.pos} {q.nodes.len()}");
}
