// §2.9 situation 3: a view used after its owner changed (G1).
// OWN: own.conflict
// TRY: --old 'v.as_slice()' --new 'v.clone()'
// TRY: query own main.tach:
// XFAIL: T2 (views)
fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let first = v.as_slice();
    v.push(4);
    println(f"{first[0]}");
}
