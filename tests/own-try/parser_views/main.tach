// §2.9 situation 6: a parser that keeps views of its input checks clean
// (the evals' pattern: views(*self)).
// OWN: none
struct Tok { text: [u8], kind: i64 }
struct Parser { toks: Vec<Tok>, pos: i64 }

impl Parser {
    fn name(self: &mut Parser) -> [u8] {
        let t = self.toks[self.pos];
        self.pos += 1;
        t.text
    }

    fn accept(self: &mut Parser, kind: i64) -> bool {
        if self.pos < self.toks.len() && self.toks[self.pos].kind == kind {
            self.pos += 1;
            return true;
        }
        false
    }

    fn item(self: &mut Parser) -> Result<[u8], [u8]> {
        let col = self.name();
        if !self.accept(1) { return Err("expected ','"); }
        Ok(col)
    }
}

fn main(gpa: Gpa) {
    let mut p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: "a", kind: 0 });
    p.toks.push(Tok { text: ",", kind: 1 });
    match p.item() {
        Ok(c) => println(c),
        Err(e) => println(e),
    }
}
