// One call borrows `a` mutably and reads it in another argument.
// OWN: own.conflict
fn add_into(dst: &mut Vec<i64>, src: &Vec<i64>) {
    for x in src { dst.push(x); }
}

fn main(gpa: Gpa) {
    let mut a: Vec<i64> = Vec::new_in(gpa);
    a.push(1);
    add_into(&mut a, &a);
    println(f"{a.len()}");
}
