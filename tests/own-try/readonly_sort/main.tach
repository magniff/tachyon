// (0.19.1) A read-only view given to a parameter that writes through it:
// own.readonly, whose try: lines make it exclusive.
// OWN: own.readonly
// TRY: fix --suggested
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(2);
    v.push(1);
    sort(v.as_slice());
    println(f"{v[0]}");
}
