// §2.9 situation 5: returning a view of something the function owns.
// OWN: own.escape
// TRY: edit patch greet --old '-> [u8]' --new '-> Buf' --old 'b.as_slice()' --new 'b'
// XFAIL: T2 (escapes)
fn greet(name: [u8], gpa: Gpa) -> [u8] {
    let b = format_in(f"hello {name}", gpa);
    b.as_slice()
}

fn main(gpa: Gpa) {
    let g = greet("you", gpa);
    println(g);
}
