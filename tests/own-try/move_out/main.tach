// §2.9 situation 2: moving out of a borrowed place.
// OWN: own.move_out
// TRY: self.keys.take()
struct Table { keys: Vec<i64>, count: i64 }

impl Table {
    fn insert(self: &mut Table, k: i64) { self.count += k; }

    fn rehash(self: &mut Table) {
        let old = self.keys;
        for k in old { self.insert(k); }
    }
}

fn main(gpa: Gpa) {
    let mut t = Table { keys: Vec::new_in(gpa), count: 0 };
    t.keys.push(3);
    t.rehash();
    println(f"{t.count}");
}
