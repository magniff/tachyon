// "Pending: eval findings": `&x` to a `&mut T` parameter was one error,
// whose fix wrote `&mut x`; from 0.20 it is the inout marker
// (conventions.md D7), and the program checks clean.
// OWN: none
struct P { x: i64 }

fn bump(p: &mut P) { p.x += 1; }

fn main() {
    let mut q = P { x: 1 };
    bump(&q);
    println(f"{q.x}");
}
