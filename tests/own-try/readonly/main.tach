// A write through a let parameter (U2; 0.20: a let P that owns a Vec is
// borrowed read-only, as a `&P` was).
// OWN: own.readonly
// TRY: refactor signature reset --type p 'inout P'
struct P { x: i64, log: Vec<i64> }

fn reset(p: P) { p.x = 0; }

fn main(gpa: Gpa) {
    var q = P { x: 3, log: Vec::new_in(gpa) };
    reset(q);
    println(f"{q.x}");
}
