// A mutable receiver changed by its own argument (§2.4): the try: hoists
// the argument into a let.
// OWN: own.conflict
struct Rng { s: u64 }

impl Rng {
    fn next(self: &mut Rng) -> u64 { self.s = self.s * 6364136223846793005 + 1; self.s >> 33 }
    fn big(self: &mut Rng, n: u64) -> u64 { self.next() % n }
}

fn main() {
    let mut rng = Rng { s: 7 };
    let x = rng.big(1 + rng.next() % 600);
    println(f"{x}");
}
