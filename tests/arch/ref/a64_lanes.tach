// References of the AArch64 lane intrinsics whose semantics column is
// prose (tests/arch/gen.sh): the 64-bit saturating and rounding ones, and
// the bit counts. Each takes the intrinsic's parameters (vectors as their
// lanes) and lane k, and returns that lane.

// i64's ends.
fn a64_min() -> i64 { -9223372036854775807 - 1 }
fn a64_max() -> i64 { 9223372036854775807 }

fn a64_qadd(a: i64, b: i64) -> i64 {
    let s = a + b;
    if a >= 0 && b >= 0 && s < 0 { return a64_max(); }
    if a < 0 && b < 0 && s >= 0 { return a64_min(); }
    s
}

fn a64_qsub(a: i64, b: i64) -> i64 {
    let s = a - b;
    if a >= 0 && b < 0 && s < 0 { return a64_max(); }
    if a < 0 && b >= 0 && s >= 0 { return a64_min(); }
    s
}

// a >> n for n up to 64 (arithmetic, logical).
fn a64_sar(a: i64, n: i64) -> i64 { if n >= 64 { (a >> 63) >> 1 } else { a >> n } }
fn a64_shr(a: u64, n: i64) -> u64 { if n >= 64 { 0 } else { a >> (n as u64) } }

// (a + 2^(n - 1)) >> n without overflow.
fn a64_rshr_s(a: i64, n: i64) -> i64 { a64_sar(a, n) + ((a >> (n - 1)) & 1) }
fn a64_rshr_u(a: u64, n: i64) -> u64 { a64_shr(a, n) + ((a >> ((n - 1) as u64)) & 1u64) }

// b >> n (logical) with a's high n bits kept.
fn a64_sri(a: u64, b: u64, n: i64) -> u64 {
    a64_shr(b, n) | (a & ~a64_shr(0xffffffffffffffffu64, n))
}

fn a64_qshl_s(a: i64, n: i64) -> i64 {
    let s = a << n;
    if (s >> n) == a { s } else if a < 0 { a64_min() } else { a64_max() }
}

fn a64_qshl_u(a: u64, n: i64) -> u64 {
    if n == 0 { return a; }
    if (a >> ((64 - n) as u64)) != 0 { 0xffffffffffffffffu64 } else { a << (n as u64) }
}

// The bit counts of the low `w` bits of x.
fn a64_cnt(x: i64, w: i64) -> i64 {
    let mut c = 0;
    for j in 0..w { c += (x >> j) & 1; }
    c
}

fn a64_rbit(x: i64, w: i64) -> i64 {
    let mut r = 0;
    for j in 0..w { r = r | (((x >> j) & 1) << (w - 1 - j)); }
    r
}

fn a64_clz(x: i64, w: i64) -> i64 {
    let mut c = 0;
    let mut j = w - 1;
    while j >= 0 && ((x >> j) & 1) == 0 {
        c += 1;
        j -= 1;
    }
    c
}

// The bits below the top one equal to it (x sign-extended).
fn a64_cls(x: i64, w: i64) -> i64 {
    a64_clz((x ^ (x >> 1)) & ((1 << (w - 1)) - 1), w - 1)
}

fn ref_vqaddq_s64(a: [i64], b: [i64], k: i64) -> i64 { a64_qadd(a[k], b[k]) }
fn ref_vqsubq_s64(a: [i64], b: [i64], k: i64) -> i64 { a64_qsub(a[k], b[k]) }

fn ref_vqabsq_s64(a: [i64], k: i64) -> i64 {
    if a[k] == a64_min() { a64_max() } else if a[k] < 0 { -a[k] } else { a[k] }
}

fn ref_vqnegq_s64(a: [i64], k: i64) -> i64 { if a[k] == a64_min() { a64_max() } else { -a[k] } }
fn ref_vrshrq_n_s64(a: [i64], n: i64, k: i64) -> i64 { a64_rshr_s(a[k], n) }
fn ref_vrshrq_n_u64(a: [u64], n: i64, k: i64) -> u64 { a64_rshr_u(a[k], n) }

fn ref_vsriq_n_s64(a: [i64], b: [i64], n: i64, k: i64) -> i64 {
    a64_sri(a[k] as u64, b[k] as u64, n) as i64
}

fn ref_vsriq_n_u64(a: [u64], b: [u64], n: i64, k: i64) -> u64 { a64_sri(a[k], b[k], n) }
fn ref_vqshlq_n_s64(a: [i64], n: i64, k: i64) -> i64 { a64_qshl_s(a[k], n) }
fn ref_vqshlq_n_u64(a: [u64], n: i64, k: i64) -> u64 { a64_qshl_u(a[k], n) }
fn ref_vqadd_s64(a: [i64], b: [i64], k: i64) -> i64 { a64_qadd(a[k], b[k]) }
fn ref_vqsub_s64(a: [i64], b: [i64], k: i64) -> i64 { a64_qsub(a[k], b[k]) }

fn ref_vqabs_s64(a: [i64], k: i64) -> i64 {
    if a[k] == a64_min() { a64_max() } else if a[k] < 0 { -a[k] } else { a[k] }
}

fn ref_vqneg_s64(a: [i64], k: i64) -> i64 { if a[k] == a64_min() { a64_max() } else { -a[k] } }
fn ref_vrshr_n_s64(a: [i64], n: i64, k: i64) -> i64 { a64_rshr_s(a[k], n) }
fn ref_vrshr_n_u64(a: [u64], n: i64, k: i64) -> u64 { a64_rshr_u(a[k], n) }

fn ref_vsri_n_s64(a: [i64], b: [i64], n: i64, k: i64) -> i64 {
    a64_sri(a[k] as u64, b[k] as u64, n) as i64
}

fn ref_vsri_n_u64(a: [u64], b: [u64], n: i64, k: i64) -> u64 { a64_sri(a[k], b[k], n) }
fn ref_vqshl_n_s64(a: [i64], n: i64, k: i64) -> i64 { a64_qshl_s(a[k], n) }
fn ref_vqshl_n_u64(a: [u64], n: i64, k: i64) -> u64 { a64_qshl_u(a[k], n) }
fn ref_vrshrn_n_u64(a: [u64], n: i64, k: i64) -> i64 { a64_rshr_u(a[k], n) as i64 }
fn ref_vcntq_u8(a: [i64], k: i64) -> i64 { a64_cnt(a[k], 8) }
fn ref_vcntq_s8(a: [i64], k: i64) -> i64 { a64_cnt(a[k], 8) }
fn ref_vcntq_p8(a: [i64], k: i64) -> i64 { a64_cnt(a[k], 8) }
fn ref_vrbitq_u8(a: [i64], k: i64) -> i64 { a64_rbit(a[k], 8) }
fn ref_vrbitq_s8(a: [i64], k: i64) -> i64 { a64_rbit(a[k], 8) }
fn ref_vrbitq_p8(a: [i64], k: i64) -> i64 { a64_rbit(a[k], 8) }
fn ref_vclzq_s8(a: [i64], k: i64) -> i64 { a64_clz(a[k], 8) }
fn ref_vclzq_u8(a: [i64], k: i64) -> i64 { a64_clz(a[k], 8) }
fn ref_vclzq_s16(a: [i64], k: i64) -> i64 { a64_clz(a[k], 16) }
fn ref_vclzq_u16(a: [i64], k: i64) -> i64 { a64_clz(a[k], 16) }
fn ref_vclzq_s32(a: [i64], k: i64) -> i64 { a64_clz(a[k], 32) }
fn ref_vclzq_u32(a: [i64], k: i64) -> i64 { a64_clz(a[k], 32) }
fn ref_vclsq_s8(a: [i64], k: i64) -> i64 { a64_cls(a[k], 8) }
fn ref_vclsq_s16(a: [i64], k: i64) -> i64 { a64_cls(a[k], 16) }
fn ref_vclsq_s32(a: [i64], k: i64) -> i64 { a64_cls(a[k], 32) }
fn ref_vcnt_u8(a: [i64], k: i64) -> i64 { a64_cnt(a[k], 8) }
fn ref_vcnt_s8(a: [i64], k: i64) -> i64 { a64_cnt(a[k], 8) }
fn ref_vcnt_p8(a: [i64], k: i64) -> i64 { a64_cnt(a[k], 8) }
fn ref_vrbit_u8(a: [i64], k: i64) -> i64 { a64_rbit(a[k], 8) }
fn ref_vrbit_s8(a: [i64], k: i64) -> i64 { a64_rbit(a[k], 8) }
fn ref_vrbit_p8(a: [i64], k: i64) -> i64 { a64_rbit(a[k], 8) }
fn ref_vclz_s8(a: [i64], k: i64) -> i64 { a64_clz(a[k], 8) }
fn ref_vclz_u8(a: [i64], k: i64) -> i64 { a64_clz(a[k], 8) }
fn ref_vclz_s16(a: [i64], k: i64) -> i64 { a64_clz(a[k], 16) }
fn ref_vclz_u16(a: [i64], k: i64) -> i64 { a64_clz(a[k], 16) }
fn ref_vclz_s32(a: [i64], k: i64) -> i64 { a64_clz(a[k], 32) }
fn ref_vclz_u32(a: [i64], k: i64) -> i64 { a64_clz(a[k], 32) }
fn ref_vcls_s8(a: [i64], k: i64) -> i64 { a64_cls(a[k], 8) }
fn ref_vcls_s16(a: [i64], k: i64) -> i64 { a64_cls(a[k], 16) }
fn ref_vcls_s32(a: [i64], k: i64) -> i64 { a64_cls(a[k], 32) }

// ---- Shifts by vector (vshlq): by the signed low byte of b ----

fn a64_shift_amount(b: i64) -> i64 {
    ((b & 255) ^ 128) - 128
}

// a (sign-extended when signed) of `w` bits shifted by b's low byte.
fn a64_shlv_s(a: i64, b: i64, w: i64) -> i64 {
    let s = a64_shift_amount(b);
    if s >= w { return 0; }
    if s >= 0 { return a << s; }
    if -s >= w { return if a < 0 { -1 } else { 0 }; }
    a >> (-s)
}

fn a64_shlv_u(a: u64, b: i64, w: i64) -> u64 {
    let s = a64_shift_amount(b);
    if s >= w || -s >= w { return 0; }
    if s >= 0 { a << (s as u64) } else { a >> ((-s) as u64) }
}

fn ref_vshlq_s8(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_s(a[k], b[k], 8) }
fn ref_vshlq_u8(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_u(a[k] as u64, b[k], 8) as i64 }
fn ref_vshlq_s16(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_s(a[k], b[k], 16) }
fn ref_vshlq_u16(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_u(a[k] as u64, b[k], 16) as i64 }
fn ref_vshlq_s32(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_s(a[k], b[k], 32) }
fn ref_vshlq_u32(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_u(a[k] as u64, b[k], 32) as i64 }
fn ref_vshlq_s64(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_s(a[k], b[k], 64) }
fn ref_vshlq_u64(a: [u64], b: [i64], k: i64) -> u64 { a64_shlv_u(a[k], b[k], 64) }
fn ref_vshl_s8(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_s(a[k], b[k], 8) }
fn ref_vshl_u8(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_u(a[k] as u64, b[k], 8) as i64 }
fn ref_vshl_s16(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_s(a[k], b[k], 16) }
fn ref_vshl_u16(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_u(a[k] as u64, b[k], 16) as i64 }
fn ref_vshl_s32(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_s(a[k], b[k], 32) }
fn ref_vshl_u32(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_u(a[k] as u64, b[k], 32) as i64 }
fn ref_vshl_s64(a: [i64], b: [i64], k: i64) -> i64 { a64_shlv_s(a[k], b[k], 64) }
fn ref_vshl_u64(a: [u64], b: [i64], k: i64) -> u64 { a64_shlv_u(a[k], b[k], 64) }
