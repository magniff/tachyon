// References of the CRC-32 intrinsics (tests/arch/gen.sh): a bit at a
// time, reflected, with neither the initial nor the final inversion (the
// instructions' own definition; a CRC of a message inverts around them).

// The CRC of `n` bytes of `data` (low byte first) from `crc`, polynomial
// `poly` (reflected).
fn crc_ref_bytes(crc: u64, data: u64, n: i64, poly: u64) -> u64 {
    let mut c = crc & 0xffffffffu64;
    for j in 0..n {
        c = c ^ ((data >> (8 * j)) & 0xffu64);
        for b in 0..8 {
            if c & 1 != 0 { c = (c >> 1) ^ poly; } else { c = c >> 1; }
        }
    }
    c
}

fn ref___crc32cd(crc: i64, data: u64) -> i64 {
    crc_ref_bytes(crc as u64, data, 8, 0x82f63b78u64) as i64
}

fn ref__mm_crc32_u64(crc: u64, v: u64) -> u64 {
    crc_ref_bytes(crc, v, 8, 0x82f63b78u64)
}

// (0.19 T4) The other AArch64 steps: CRC-32 (gzip's polynomial) and
// CRC-32C over 1, 2, 4 and 8 bytes.
fn ref___crc32b(crc: i64, data: i64) -> i64 {
    crc_ref_bytes(crc as u64, data as u64, 1, 0xedb88320u64) as i64
}

fn ref___crc32h(crc: i64, data: i64) -> i64 {
    crc_ref_bytes(crc as u64, data as u64, 2, 0xedb88320u64) as i64
}

fn ref___crc32w(crc: i64, data: i64) -> i64 {
    crc_ref_bytes(crc as u64, data as u64, 4, 0xedb88320u64) as i64
}

fn ref___crc32d(crc: i64, data: u64) -> i64 {
    crc_ref_bytes(crc as u64, data, 8, 0xedb88320u64) as i64
}

fn ref___crc32cb(crc: i64, data: i64) -> i64 {
    crc_ref_bytes(crc as u64, data as u64, 1, 0x82f63b78u64) as i64
}

fn ref___crc32ch(crc: i64, data: i64) -> i64 {
    crc_ref_bytes(crc as u64, data as u64, 2, 0x82f63b78u64) as i64
}

fn ref___crc32cw(crc: i64, data: i64) -> i64 {
    crc_ref_bytes(crc as u64, data as u64, 4, 0x82f63b78u64) as i64
}
