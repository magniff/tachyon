// References of x86-64's carry-less multiply, AES-NI and SHA intrinsics
// (tests/arch/gen.sh), written from Intel's definitions (the SDM's
// pseudo-code for PCLMULQDQ, AESENC..AESKEYGENASSIST, SHA1RNDS4..SHA256MSG2).
// AES's state is the 16 bytes as columns of four (byte 4c + r is row r of
// column c); SHA's words are the u32 lanes, lane 3 the SDM's [127:96].
// x86-64 is compiled, not run, in 0.19: these run once x86 testing
// returns.

// PCLMULQDQ: the 128-bit carry-less product of a's lane imm8 & 1 and b's
// lane (imm8 >> 4) & 1; lane k (0 low, 1 high) of it.
fn ref__mm_clmulepi64_si128(a: [u64], b: [u64], imm8: i64, k: i64) -> u64 {
    let x = a[imm8 & 1];
    let y = b[(imm8 >> 4) & 1];
    var lo: u64 = 0;
    var hi: u64 = 0;
    for i in 0..64 {
        if (y >> i) & 1 != 0 {
            lo = lo ^ (x << i);
            if i > 0 { hi = hi ^ (x >> (64 - i)); }
        }
    }
    if k == 0 { lo } else { hi }
}

