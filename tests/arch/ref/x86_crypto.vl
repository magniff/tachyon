// x * y in GF(2^8) mod x^8 + x^4 + x^3 + x + 1.
fn x86_gmul(x: i64, y: i64) -> i64 {
    var a = x & 255;
    var b = y & 255;
    var r: i64 = 0;
    while b != 0 {
        if b & 1 != 0 { r = r ^ a; }
        a = if a & 0x80 != 0 { ((a << 1) ^ 0x11b) & 255 } else { a << 1 };
        b = b >> 1;
    }
    r
}

// Byte i of (Inv)ShiftRows(s): row r of column c comes from column c + r
// (c - r inverted).
fn x86_shift_rows(s: [i64], i: i64, inverse: bool) -> i64 {
    let r = i % 4;
    let c = i / 4;
    let from = if inverse { (c + 4 - r) % 4 } else { (c + r) % 4 };
    s[4 * from + r]
}

// Byte i of (Inv)MixColumns(s).
fn x86_mix(s: [i64], i: i64, inverse: bool) -> i64 {
    let r = i % 4;
    let c = i / 4;
    let fwd: [i64; 4] = [2, 3, 1, 1];
    let inv: [i64; 4] = [14, 11, 13, 9];
    var v: i64 = 0;
    for j in 0..4 {
        let m = if inverse { inv[(j + 4 - r) % 4] } else { fwd[(j + 4 - r) % 4] };
        v = v ^ x86_gmul(m, s[4 * c + j]);
    }
    v
}

// One AES round on a: (Inv)ShiftRows, (Inv)SubBytes, (Inv)MixColumns
// unless `last`, then ^ key; byte k of it.
fn x86_aes_round(a: [i64], key: [i64], k: i64, decrypt: bool, last: bool) -> i64 {
    var s: [i64; 16] = [0; 16];
    for i in 0..16 {
        let b = x86_shift_rows(a, i, decrypt);
        s[i] = if decrypt { x86_inv_sbox(b) } else { x86_sbox(b) };
    }
    let v = if last { s[k] } else { x86_mix(s[..], k, decrypt) };
    v ^ key[k]
}

fn ref__mm_aesenc_si128(a: [i64], round_key: [i64], k: i64) -> i64 {
    x86_aes_round(a, round_key, k, false, false)
}

fn ref__mm_aesenclast_si128(a: [i64], round_key: [i64], k: i64) -> i64 {
    x86_aes_round(a, round_key, k, false, true)
}

fn ref__mm_aesdec_si128(a: [i64], round_key: [i64], k: i64) -> i64 {
    x86_aes_round(a, round_key, k, true, false)
}

fn ref__mm_aesdeclast_si128(a: [i64], round_key: [i64], k: i64) -> i64 {
    x86_aes_round(a, round_key, k, true, true)
}

fn ref__mm_aesimc_si128(a: [i64], k: i64) -> i64 { x86_mix(a, k, true) }

// AESKEYGENASSIST: words SubWord(X1), RotWord(SubWord(X1)) ^ imm8,
// SubWord(X3), RotWord(SubWord(X3)) ^ imm8 of a's words X1, X3; byte k.
fn ref__mm_aeskeygenassist_si128(a: [i64], imm8: i64, k: i64) -> i64 {
    let w = k / 4;
    let j = k % 4;
    let src = if w < 2 { 1 } else { 3 };
    if w % 2 == 0 {
        return x86_sbox(a[4 * src + j]);
    }
    let v = x86_sbox(a[4 * src + (j + 1) % 4]);
    if j == 0 { v ^ (imm8 & 255) } else { v }
}

fn x86_rol(x: i64, n: i64) -> i64 {
    ((x << n) | (x >> (32 - n))) & 0xffffffff
}

fn x86_ror(x: i64, n: i64) -> i64 {
    ((x >> n) | (x << (32 - n))) & 0xffffffff
}

// SHA1RNDS4: four rounds from A B C D (a's lanes 3..0) with W0 + E, W1, W2,
// W3 (b's lanes 3..0); the new A B C D in lanes 3..0.
fn ref__mm_sha1rnds4_epu32(a: [i64], b: [i64], func: i64, k: i64) -> i64 {
    let ks: [i64; 4] = [0x5a827999, 0x6ed9eba1, 0x8f1bbcdc, 0xca62c1d6];
    var va = a[3];
    var vb = a[2];
    var vc = a[1];
    var vd = a[0];
    var ve: i64 = 0;
    for i in 0..4 {
        let f = if func == 0 { (vb & vc) ^ ((vb ^ 0xffffffff) & vd) }
            else if func == 2 { (vb & vc) ^ (vb & vd) ^ (vc & vd) }
            else { vb ^ vc ^ vd };
        let t = (f + x86_rol(va, 5) + b[3 - i] + ve + ks[func]) & 0xffffffff;
        ve = vd;
        vd = vc;
        vc = x86_rol(vb, 30);
        vb = va;
        va = t;
    }
    if k == 3 { va } else if k == 2 { vb } else if k == 1 { vc } else { vd }
}

fn ref__mm_sha1nexte_epu32(a: [i64], b: [i64], k: i64) -> i64 {
    if k == 3 { (b[3] + x86_rol(a[3], 30)) & 0xffffffff } else { b[k] }
}

fn ref__mm_sha1msg1_epu32(a: [i64], b: [i64], k: i64) -> i64 {
    // (W0..W3 are a's lanes 3..0, W4 W5 b's lanes 3 and 2)
    if k == 3 { a[1] ^ a[3] } else if k == 2 { a[0] ^ a[2] } else if k == 1 { b[3] ^ a[1] }
    else { b[2] ^ a[0] }
}

fn ref__mm_sha1msg2_epu32(a: [i64], b: [i64], k: i64) -> i64 {
    let w16 = x86_rol(a[3] ^ b[2], 1);
    let w17 = x86_rol(a[2] ^ b[1], 1);
    let w18 = x86_rol(a[1] ^ b[0], 1);
    let w19 = x86_rol(a[0] ^ w16, 1);
    if k == 3 { w16 } else if k == 2 { w17 } else if k == 1 { w18 } else { w19 }
}

// SHA256RNDS2: two rounds; a holds C D G H (lanes 3..0), b A B E F, wk's
// lanes 0 and 1 the two rounds' message words plus constants; the new A B
// E F in lanes 3..0.
fn ref__mm_sha256rnds2_epu32(a: [i64], b: [i64], wk: [i64], k: i64) -> i64 {
    var va = b[3];
    var vb = b[2];
    var vc = a[3];
    var vd = a[2];
    var ve = b[1];
    var vf = b[0];
    var vg = a[1];
    var vh = a[0];
    for i in 0..2 {
        let s1 = x86_ror(ve, 6) ^ x86_ror(ve, 11) ^ x86_ror(ve, 25);
        let ch = (ve & vf) ^ ((ve ^ 0xffffffff) & vg);
        let t1 = (vh + s1 + ch + wk[i]) & 0xffffffff;
        let s0 = x86_ror(va, 2) ^ x86_ror(va, 13) ^ x86_ror(va, 22);
        let maj = (va & vb) ^ (va & vc) ^ (vb & vc);
        let t2 = (s0 + maj) & 0xffffffff;
        vh = vg;
        vg = vf;
        vf = ve;
        ve = (vd + t1) & 0xffffffff;
        vd = vc;
        vc = vb;
        vb = va;
        va = (t1 + t2) & 0xffffffff;
    }
    if k == 3 { va } else if k == 2 { vb } else if k == 1 { ve } else { vf }
}

fn x86_sigma0(x: i64) -> i64 { x86_ror(x, 7) ^ x86_ror(x, 18) ^ (x >> 3) }

fn x86_sigma1(x: i64) -> i64 { x86_ror(x, 17) ^ x86_ror(x, 19) ^ (x >> 10) }

fn ref__mm_sha256msg1_epu32(a: [i64], b: [i64], k: i64) -> i64 {
    // (lane k + 1 of a, or b's lane 0 past a's top)
    let next = if k == 3 { b[0] } else { a[k + 1] };
    (a[k] + x86_sigma0(next)) & 0xffffffff
}

fn ref__mm_sha256msg2_epu32(a: [i64], b: [i64], k: i64) -> i64 {
    let w16 = (a[0] + x86_sigma1(b[2])) & 0xffffffff;
    let w17 = (a[1] + x86_sigma1(b[3])) & 0xffffffff;
    let w18 = (a[2] + x86_sigma1(w16)) & 0xffffffff;
    let w19 = (a[3] + x86_sigma1(w17)) & 0xffffffff;
    if k == 0 { w16 } else if k == 1 { w17 } else if k == 2 { w18 } else { w19 }
}
