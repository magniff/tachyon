// References of the AArch64 float intrinsics whose semantics column is
// prose (tests/arch/gen.sh): IEEE-754 as the instructions define it, NaN
// for any NaN, the sign of zero kept. Lanes come as f64 (an f32 lane is
// exact in it).

fn a64f_nan(x: f64) -> bool {
    x != x
}

fn a64f_negz(x: f64) -> bool {
    x == 0.0 && 1.0 / x < 0.0
}

fn a64f_abs(x: f64) -> f64 {
    if a64f_nan(x) { return x; }
    if x < 0.0 || a64f_negz(x) { -x } else { x }
}

fn a64f_max(a: f64, b: f64) -> f64 {
    if a64f_nan(a) || a64f_nan(b) { return a + b; }
    if a == 0.0 && b == 0.0 { return if a64f_negz(a) && a64f_negz(b) { a } else { 0.0 }; }
    if a > b { a } else { b }
}

fn a64f_min(a: f64, b: f64) -> f64 {
    if a64f_nan(a) || a64f_nan(b) { return a + b; }
    if a == 0.0 && b == 0.0 { return if a64f_negz(a) { a } else { b }; }
    if a < b { a } else { b }
}

// x rounded toward zero, as an integral value (x itself when it already
// is one: large, infinite or NaN).
fn a64f_trunc(x: f64) -> f64 {
    if a64f_nan(x) || x >= 4503599627370496.0 || x <= -4503599627370496.0 { return x; }
    (x as i64) as f64
}

// The integral value r of x, with x's sign when it is zero.
fn a64f_signed(r: f64, x: f64) -> f64 {
    if r == 0.0 && (x < 0.0 || a64f_negz(x)) { -0.0 } else { r }
}

// mode: 0 nearest-even, 1 floor, 2 ceil, 3 trunc, 4 nearest-away.
fn a64f_round(x: f64, mode: i64) -> f64 {
    if a64f_nan(x) || x >= 4503599627370496.0 || x <= -4503599627370496.0 { return x; }
    let t = a64f_trunc(x);
    let fl = if t > x { t - 1.0 } else { t };
    let ce = if t < x { t + 1.0 } else { t };
    let mut r = t;
    if mode == 1 {
        r = fl;
    } else if mode == 2 {
        r = ce;
    } else if mode == 0 || mode == 4 {
        let d = x - fl;
        if d > 0.5 {
            r = ce;
        } else if d < 0.5 {
            r = fl;
        } else if mode == 4 {
            r = if x > 0.0 { ce } else { fl };
        } else {
            r = if a64f_trunc(fl / 2.0) * 2.0 == fl { fl } else { ce };
        }
    }
    a64f_signed(r, x)
}

fn ref_vabsq_f32(a: [f64], k: i64) -> f64 { a64f_abs(a[k]) }
fn ref_vmaxq_f32(a: [f64], b: [f64], k: i64) -> f64 { a64f_max(a[k], b[k]) }
fn ref_vminq_f32(a: [f64], b: [f64], k: i64) -> f64 { a64f_min(a[k], b[k]) }
fn ref_vabdq_f32(a: [f64], b: [f64], k: i64) -> f64 { a64f_abs(((a[k] - b[k]) as f32) as f64) }

fn ref_vpmaxq_f32(a: [f64], b: [f64], k: i64) -> f64 {
    if k < 2 { a64f_max(a[2 * k], a[2 * k + 1]) } else { a64f_max(b[2 * k - 4], b[2 * k - 3]) }
}

fn ref_vpminq_f32(a: [f64], b: [f64], k: i64) -> f64 {
    if k < 2 { a64f_min(a[2 * k], a[2 * k + 1]) } else { a64f_min(b[2 * k - 4], b[2 * k - 3]) }
}

fn ref_vrndnq_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 0) }
fn ref_vrndmq_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 1) }
fn ref_vrndpq_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 2) }
fn ref_vrndq_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 3) }
fn ref_vrndaq_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 4) }
fn ref_vmaxvq_f32(a: [f64]) -> f64 { a64f_max(a64f_max(a[0], a[1]), a64f_max(a[2], a[3])) }
fn ref_vminvq_f32(a: [f64]) -> f64 { a64f_min(a64f_min(a[0], a[1]), a64f_min(a[2], a[3])) }

fn ref_vaddvq_f32(a: [f64]) -> f64 { (((a[0] + a[1]) as f32) as f64) + (
    ((a[2] + a[3]) as f32) as f64) }

fn ref_vabsq_f64(a: [f64], k: i64) -> f64 { a64f_abs(a[k]) }
fn ref_vmaxq_f64(a: [f64], b: [f64], k: i64) -> f64 { a64f_max(a[k], b[k]) }
fn ref_vminq_f64(a: [f64], b: [f64], k: i64) -> f64 { a64f_min(a[k], b[k]) }
fn ref_vabdq_f64(a: [f64], b: [f64], k: i64) -> f64 { a64f_abs(a[k] - b[k]) }

fn ref_vpmaxq_f64(a: [f64], b: [f64], k: i64) -> f64 {
    if k < 1 { a64f_max(a[2 * k], a[2 * k + 1]) } else { a64f_max(b[2 * k - 2], b[2 * k - 1]) }
}

fn ref_vpminq_f64(a: [f64], b: [f64], k: i64) -> f64 {
    if k < 1 { a64f_min(a[2 * k], a[2 * k + 1]) } else { a64f_min(b[2 * k - 2], b[2 * k - 1]) }
}

fn ref_vrndnq_f64(a: [f64], k: i64) -> f64 { a64f_round(a[k], 0) }
fn ref_vrndmq_f64(a: [f64], k: i64) -> f64 { a64f_round(a[k], 1) }
fn ref_vrndpq_f64(a: [f64], k: i64) -> f64 { a64f_round(a[k], 2) }
fn ref_vrndq_f64(a: [f64], k: i64) -> f64 { a64f_round(a[k], 3) }
fn ref_vrndaq_f64(a: [f64], k: i64) -> f64 { a64f_round(a[k], 4) }
fn ref_vmaxvq_f64(a: [f64]) -> f64 { a64f_max(a[0], a[1]) }
fn ref_vminvq_f64(a: [f64]) -> f64 { a64f_min(a[0], a[1]) }
fn ref_vaddvq_f64(a: [f64]) -> f64 { a[0] + a[1] }
fn ref_vabs_f32(a: [f64], k: i64) -> f64 { a64f_abs(a[k]) }
fn ref_vmax_f32(a: [f64], b: [f64], k: i64) -> f64 { a64f_max(a[k], b[k]) }
fn ref_vmin_f32(a: [f64], b: [f64], k: i64) -> f64 { a64f_min(a[k], b[k]) }
fn ref_vabd_f32(a: [f64], b: [f64], k: i64) -> f64 { a64f_abs(((a[k] - b[k]) as f32) as f64) }

fn ref_vpmax_f32(a: [f64], b: [f64], k: i64) -> f64 {
    if k < 1 { a64f_max(a[2 * k], a[2 * k + 1]) } else { a64f_max(b[2 * k - 2], b[2 * k - 1]) }
}

fn ref_vpmin_f32(a: [f64], b: [f64], k: i64) -> f64 {
    if k < 1 { a64f_min(a[2 * k], a[2 * k + 1]) } else { a64f_min(b[2 * k - 2], b[2 * k - 1]) }
}

fn ref_vrndn_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 0) }
fn ref_vrndm_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 1) }
fn ref_vrndp_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 2) }
fn ref_vrnd_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 3) }
fn ref_vrnda_f32(a: [f64], k: i64) -> f64 { a64f_round(a[k], 4) }
fn ref_vmaxv_f32(a: [f64]) -> f64 { a64f_max(a[0], a[1]) }
fn ref_vminv_f32(a: [f64]) -> f64 { a64f_min(a[0], a[1]) }
fn ref_vaddv_f32(a: [f64]) -> f64 { a[0] + a[1] }

// ---- Fused multiply-add of f32 lanes: b * c is exact in f64; a + b * c
// is summed exactly (two-sum), rounded to f64 by round-to-odd, then to
// f32: one rounding in all ----

fn a64f_bits(x: f64) -> i64 {
    v2i64::from_bits(v2f64::splat(x)).lane(0)
}

fn a64f_of_bits(b: i64) -> f64 {
    v2f64::from_bits(v2i64::splat(b)).lane(0)
}

fn a64f_fma32(a: f64, b: f64, c: f64) -> f64 {
    let p = b * c;
    let s = a + p;
    let bb = s - a;
    let e = (a - (s - bb)) + (p - bb);
    if e != e || s != s || e == 0.0 || s - s != 0.0 {
        return ((s as f32) as f64);
    }
    let mut bits = a64f_bits(s);
    if (bits & 1) == 0 {
        bits = if (e > 0.0) == (s > 0.0) { bits + 1 } else { bits - 1 };
    }
    ((a64f_of_bits(bits) as f32) as f64)
}

fn ref_vfmaq_f32(a: [f64], b: [f64], c: [f64], k: i64) -> f64 { a64f_fma32(a[k], b[k], c[k]) }
fn ref_vfmsq_f32(a: [f64], b: [f64], c: [f64], k: i64) -> f64 { a64f_fma32(a[k], -b[k], c[k]) }
fn ref_vfma_f32(a: [f64], b: [f64], c: [f64], k: i64) -> f64 { a64f_fma32(a[k], b[k], c[k]) }
fn ref_vfms_f32(a: [f64], b: [f64], c: [f64], k: i64) -> f64 { a64f_fma32(a[k], -b[k], c[k]) }
