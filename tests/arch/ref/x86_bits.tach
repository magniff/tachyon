// References of the x86-64 bit and lane intrinsics whose semantics is
// prose (tests/arch/gen.sh): CRC-32C, the bit counts, BMI's fields and
// deposits, minpos, testnzc. Integers narrower than 64 bits come and go as
// i64 (u32 lanes as 0..2^32 - 1), 64-bit ones in their own type. x86-64 is
// compiled, not run, in 0.19: these run once x86 testing returns.

// CRC-32C of the `n` low bytes of `data` (low byte first) from `crc`:
// reflected, no inversion (the crc32 instruction's own definition).
fn x86_crc32c(crc: i64, data: i64, n: i64) -> i64 {
    var c = crc & 0xffffffff;
    for j in 0..n {
        c = c ^ ((data >> (8 * j)) & 0xff);
        for b in 0..8 {
            if c & 1 != 0 { c = (c >> 1) ^ 0x82f63b78; } else { c = c >> 1; }
        }
    }
    c
}

fn ref__mm_crc32_u8(crc: i64, v: i64) -> i64 { x86_crc32c(crc, v, 1) }

fn ref__mm_crc32_u16(crc: i64, v: i64) -> i64 { x86_crc32c(crc, v, 2) }

fn ref__mm_crc32_u32(crc: i64, v: i64) -> i64 { x86_crc32c(crc, v, 4) }

// The bit counts of the `w` low bits of x.
fn x86_ones(x: u64, w: i64) -> i64 {
    var n: i64 = 0;
    for b in 0..w { if (x >> b) & 1 != 0 { n += 1; } }
    n
}

fn x86_leading(x: u64, w: i64) -> i64 {
    var n: i64 = 0;
    var b = w - 1;
    while b >= 0 && (x >> b) & 1 == 0 { n += 1; b -= 1; }
    n
}

fn x86_trailing(x: u64, w: i64) -> i64 {
    var n: i64 = 0;
    while n < w && (x >> n) & 1 == 0 { n += 1; }
    n
}

fn ref__popcnt32(a: i64) -> i64 { x86_ones(a as u64, 32) }

fn ref__popcnt64(a: i64) -> i64 { x86_ones(a as u64, 64) }

fn ref__lzcnt_u32(a: i64) -> i64 { x86_leading(a as u64, 32) }

fn ref__lzcnt_u64(a: u64) -> u64 { x86_leading(a, 64) as u64 }

fn ref__tzcnt_u32(a: i64) -> i64 { x86_trailing(a as u64, 32) }

fn ref__tzcnt_u64(a: u64) -> u64 { x86_trailing(a, 64) as u64 }

// BEXTR: `len` bits of the w-bit a from bit `start` (both bytes of
// control), zero-extended.
fn x86_bextr(a: u64, control: u64, w: i64) -> u64 {
    let start = (control & 255) as i64;
    let len = ((control >> 8) & 255) as i64;
    var r: u64 = 0;
    for i in 0..len {
        if start + i < w && i < w && (a >> (start + i)) & 1 != 0 {
            r = r | (1u64 << i);
        }
    }
    r
}

fn ref__bextr2_u32(a: i64, control: i64) -> i64 { x86_bextr(a as u64, control as u64, 32) as i64 }

fn ref__bextr2_u64(a: u64, control: u64) -> u64 { x86_bextr(a, control, 64) }

// BZHI: a's bits below index & 255 (all of them from w up).
fn x86_bzhi(a: u64, index: u64, w: i64) -> u64 {
    let n = (index & 255) as i64;
    var r: u64 = 0;
    for i in 0..w {
        if i < n && (a >> i) & 1 != 0 { r = r | (1u64 << i); }
    }
    r
}

fn ref__bzhi_u32(a: i64, index: i64) -> i64 { x86_bzhi(a as u64, index as u64, 32) as i64 }

fn ref__bzhi_u64(a: u64, index: u64) -> u64 { x86_bzhi(a, index, 64) }

// PDEP: a's low bits, in order, at mask's set bits.
fn x86_pdep(a: u64, mask: u64, w: i64) -> u64 {
    var r: u64 = 0;
    var k: i64 = 0;
    for i in 0..w {
        if (mask >> i) & 1 != 0 {
            if (a >> k) & 1 != 0 { r = r | (1u64 << i); }
            k += 1;
        }
    }
    r
}

// PEXT: a's bits at mask's set bits, in order, into the low bits.
fn x86_pext(a: u64, mask: u64, w: i64) -> u64 {
    var r: u64 = 0;
    var k: i64 = 0;
    for i in 0..w {
        if (mask >> i) & 1 != 0 {
            if (a >> i) & 1 != 0 { r = r | (1u64 << k); }
            k += 1;
        }
    }
    r
}

fn ref__pdep_u32(a: i64, mask: i64) -> i64 { x86_pdep(a as u64, mask as u64, 32) as i64 }

fn ref__pdep_u64(a: u64, mask: u64) -> u64 { x86_pdep(a, mask, 64) }

fn ref__pext_u32(a: i64, mask: i64) -> i64 { x86_pext(a as u64, mask as u64, 32) as i64 }

fn ref__pext_u64(a: u64, mask: u64) -> u64 { x86_pext(a, mask, 64) }

// PHMINPOSUW: the least u16 lane (the first of equal ones) in lane 0, its
// index in lane 1, zeros above.
fn ref__mm_minpos_epu16(a: [i64], k: i64) -> i64 {
    var at: i64 = 0;
    for i in 1..8 {
        if a[i] < a[at] { at = i; }
    }
    if k == 0 { a[at] } else if k == 1 { at } else { 0 }
}

// PTEST: 1 when neither a & b nor !a & b is all zeros.
fn ref__mm_testnzc_si128(a: [i64], b: [i64]) -> i64 {
    var zf = true;
    var cf = true;
    for i in 0..16 {
        if a[i] & b[i] != 0 { zf = false; }
        if (a[i] ^ 255) & b[i] != 0 { cf = false; }
    }
    if !zf && !cf { 1 } else { 0 }
}
