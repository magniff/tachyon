// The reference images of the render tests, drawn on the CPU from the
// scenes of tests/gpu/support.vl (never by the GPU under test).
//
//     volec tests/gpu/refgen.vl tests/gpu/support.vl lib/root.vl -o refgen.o
//     cc refgen.o -o refgen -framework Metal -framework Foundation -lobjc
//     ./refgen tests/gpu/ref
//
// tests/gpu/run.sh regenerates them and fails when they differ from the
// checked-in ones.

fn write(dir: [u8], name: [u8], img: sink std::Buf, gpa: Gpa) -> bool {
    let path = format_in(f"{dir}/{name}", gpa);
    let ok = write_ppm(path.as_slice(), img.as_slice(), SIZE, SIZE, SIZE * 4, gpa);
    if !ok { eprintln(f"refgen: cannot write {path.as_slice()}"); }
    ok
}

fn main(argc: i32, argv: **u8, gpa: Gpa) -> i32 {
    if argc != 2 {
        eprintln("usage: refgen DIR");
        return 2;
    }
    // argv[1] is a NUL-terminated string that lives as long as main
    let dir = unsafe { argv[1][0..c::strlen(argv[1]) as i64] };
    let rects = scene_rects();
    let inst = scene_instanced();
    let depth = scene_depth();
    let blend = scene_blend();
    var ok = true;
    ok = write(dir, "rects.ppm", raster_rects(rects[..], false, false, gpa), gpa) && ok;
    ok = write(dir, "instanced.ppm", raster_rects(inst[..], false, false, gpa), gpa) && ok;
    ok = write(dir, "depth.ppm", raster_rects(depth[..], false, true, gpa), gpa) && ok;
    ok = write(dir, "blend.ppm", raster_rects(blend[..], true, false, gpa), gpa) && ok;
    ok = write(dir, "textured.ppm", raster_textured(gpa), gpa) && ok;
    ok = write(dir, "triangle.ppm", raster_triangle(gpa), gpa) && ok;
    if ok { 0 } else { 1 }
}
