// An Objective-C exception through tachyon frames ends the process (no
// tachyon frame catches it: a crash, not undefined behaviour), after
// objc::init's handler printed its name and reason.
// EXIT: 134
// STDERR: objc: uncaught exception NSRangeException

use objc::foundation::NSArrayMethods;

extern "C" {
    fn MTLCopyAllDevices() -> *u8;
}

fn main(gpa: Gpa) -> i32 {
    objc::init();
    // a +1 NSArray of the system's devices
    let mut all = unsafe { objc::Id::<objc::foundation::NSArray>::from_owned_or_nil(
        MTLCopyAllDevices()) };
    let n = all.r().count();
    let x = all.r().object_at_index(n + 5);
    println(f"not reached {x.is_nil()}");
    all.free();
    0
}
