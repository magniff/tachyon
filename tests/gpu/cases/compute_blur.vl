// Compute on textures: a 3x3 box blur of an R32Uint texture (sampled,
// then written as a storage texture), copied to a buffer, checked
// against the CPU exactly.
// EXPECT: blur ok

use std::gpu::{BindingType, BufferUsage, Format, Reflection, ShaderSource, TextureUsage};

const MSL: [[u8]; 16] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "kernel void blur(texture2d<uint, access::read> src [[texture(0)]],",
    "                 texture2d<uint, access::write> dst [[texture(1)]],",
    "                 uint2 p [[thread_position_in_grid]]) {",
    "    uint w = src.get_width(), h = src.get_height();",
    "    if (p.x >= w || p.y >= h) { return; }",
    "    uint sum = 0;",
    "    for (int dy = -1; dy <= 1; dy++) {",
    "        for (int dx = -1; dx <= 1; dx++) {",
    "            int x = clamp(int(p.x) + dx, 0, int(w) - 1), y = clamp(int(p.y) + dy, 0, int(h) - 1);",
    "            sum += src.read(uint2(x, y)).r;",
    "        }",
    "    }",
    "    dst.write(uint4(sum / 9, 0, 0, 0), p);",
    "}",
];

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    var text = lines(MSL[..], gpa);
    var refl = Reflection::new_in(gpa);
    refl.compute("main", "blur", 8, 8);
    refl.bind(0, 0, BindingType::Texture, compute: 0);
    refl.bind(0, 1, BindingType::StorageTexture, compute: 1);
    let src = ShaderSource::msl(text.as_slice(), refl);
    var shader = dev.shader(src).unwrap();
    var pipe = dev.compute_pipeline(shader, "main").unwrap();

    let w = 64;
    let h = 48;
    var img: Vec<u32> = Vec::new_in(gpa);
    for i in 0..w * h {
        img.push(((i * 2654435761) % 1000) as u32);
    }
    var a = dev.texture(w, h, Format::R32Uint,
        usage: TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_DST);
    var b = dev.texture(w, h, Format::R32Uint,
        usage: TextureUsage::STORAGE_BINDING | TextureUsage::COPY_SRC);
    queue.write_texture(a, std::gpu::bytes_of_u32(img.as_slice()), w * 4);
    var av = a.view();
    var bv = b.view();
    var group = dev.bind_group(pipe.bind_layout(0),
        [std::gpu::bind_texture(0, av), std::gpu::bind_texture(1, bv)][..]);
    var out = dev.buffer(256 * h, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.dispatch(w / 8, h / 8);
    });
    enc.copy_texture_to_buffer(b, out, 256);
    queue.submit(enc.finish());
    let got = std::gpu::u32s(out.map_read(dev));
    let px = img.as_slice();
    var bad = 0;
    for y in 0..h {
        for x in 0..w {
            var sum: u32 = 0;
            for dy in -1..2 {
                for dx in -1..2 {
                    let xx = if x + dx < 0 { 0 } else if x + dx >= w { w - 1 } else { x + dx };
                    let yy = if y + dy < 0 { 0 } else if y + dy >= h { h - 1 } else { y + dy };
                    sum += px[yy * w + xx];
                }
            }
            if got[y * 64 + x] != sum / 9 { bad += 1; }
        }
    }
    if bad == 0 { println("blur ok"); } else { println(f"blur: {bad} pixels differ"); }
    0
}
