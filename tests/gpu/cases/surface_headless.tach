// A surface without a window (RawSurface::Headless: an unattached
// CAMetalLayer): configured, three frames taken, each cleared to its own
// color, read back before it is presented.
// EXPECT: frame 0: 255 0 0 255
// EXPECT: frame 1: 0 255 0 255
// EXPECT: frame 2: 0 0 255 255

use std::gpu::{BufferUsage, Color, Format, PassDesc, RawSurface};

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, mut queue) = adapter.device().unwrap();
    let mut surf = inst.surface(&dev, RawSurface::Headless).unwrap();
    surf.configure(&dev, 32, 16, format: Format::Bgra8Unorm, vsync: false);
    let colors = [Color::rgba(1.0, 0.0, 0.0, 1.0), Color::rgba(0.0, 1.0, 0.0, 1.0),
        Color::rgba(0.0, 0.0, 1.0, 1.0)];
    for k in 0..3 {
        let frame = surf.frame().unwrap();
        let view = frame.texture.view();
        let mut rb = dev.buffer(256 * 16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
        let mut enc = dev.encoder();
        enc.render_pass(PassDesc::color(&view, clear: colors[k]), |pass| {});
        enc.copy_texture_to_buffer(&frame.texture, &rb, 256);
        queue.submit(enc.finish());
        let px = rb.map_read(&dev);
        // BGRA in memory
        println(f"frame {k}: {px[2]} {px[1]} {px[0]} {px[3]}");
        frame.present(&mut queue);
    }
    queue.wait_idle().unwrap();
    0
}
