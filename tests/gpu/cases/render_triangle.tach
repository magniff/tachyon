// One triangle with a color per vertex, interpolated: compared with the
// CPU rasterizer within 2 per channel, edge pixels aside.
// EXPECT: triangle ok

use gpu::{Format, PassDesc};

fn main(gpa: Gpa) -> i32 {
    let inst = gpu::Instance::new_in(gpa);
    let mut adapter = inst.adapter().unwrap();
    defer adapter.free();
    let (mut dev, mut queue) = adapter.device().unwrap();
    defer dev.free();
    defer queue.free();
    let mut shader = rect_shader(&dev, gpa);
    defer shader.free();
    let mut desc = gpu::RenderDesc::new(&shader, "vs", "fs", Format::Rgba8Unorm);
    desc.vertex_buffer(rect_layout());
    let mut pipe = dev.render_pipeline(&desc).unwrap();
    defer pipe.free();

    let mut verts = std::Buf::new_in(gpa);
    for k in 0..3 {
        push_f32(&verts, TRI[2 * k] as f32);
        push_f32(&verts, TRI[2 * k + 1] as f32);
        verts.push(TRI_COLORS[3 * k]);
        verts.push(TRI_COLORS[3 * k + 1]);
        verts.push(TRI_COLORS[3 * k + 2]);
        verts.push(255);
        push_f32(&verts, 0.5);
    }
    defer verts.free();
    let mut vb = dev.buffer_init(verts.as_slice(), gpu::BufferUsage::VERTEX);
    defer vb.free();
    let mut g = globals(&dev);
    defer g.free();
    let mut group = dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, &g)][..]);
    defer group.free();

    let mut tex = target(&dev);
    defer tex.free();
    let mut view = tex.view();
    defer view.free();
    let mut rb = readback(&dev);
    defer rb.free();
    let n = 3;
    let mut enc = dev.encoder();
    enc.render_pass(PassDesc::color(&view, clear: clear_color()), |pass| {
        pass.set_pipeline(&pipe);
        pass.set_bind_group(0, &group);
        pass.set_vertex_buffer(0, &vb);
        pass.draw(0..n, 0..1);
    });
    enc.copy_texture_to_buffer(&tex, &rb, 256);
    queue.submit(enc.finish());
    let px = rb.map_read(&dev).unwrap();
    if check_image(px, SIZE, SIZE, 256, "tests/gpu/ref/triangle.ppm", 2, 48, gpa) { println(
        "triangle ok"); }
    0
}
