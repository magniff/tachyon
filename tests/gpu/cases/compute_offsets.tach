// Bind groups over ranges of one buffer (256-byte aligned offsets), two
// pipelines in one pass, queue.write_buffer before and while work is in
// flight (the staging path), map_write, a buffer-to-buffer copy.
// EXPECT: offsets ok

use std::gpu::{BindingType, BufferUsage, Reflection, ShaderSource};

const MSL: [[u8]; 11] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "struct P { uint add; };",
    "kernel void add(device uint* xs [[buffer(0)]], constant P& p [[buffer(1)]], uint i [[thread_position_in_grid]]) {",
    "    xs[i] += p.add;",
    "}",
    "kernel void twice(device uint* xs [[buffer(0)]], uint i [[thread_position_in_grid]]) {",
    "    xs[i] *= 2;",
    "}",
    "",
    "",
];

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, mut queue) = adapter.device().unwrap();
    let mut text = lines(MSL[..], gpa);
    let mut refl = Reflection::new_in(gpa);
    refl.compute("add", "add", 64);
    refl.compute("twice", "twice", 64);
    refl.bind(0, 0, BindingType::Storage, compute: 0);
    refl.bind(1, 0, BindingType::Uniform, compute: 1);
    let src = ShaderSource::msl(text.as_slice(), refl);
    let mut shader = dev.shader(&src).unwrap();
    let mut add = dev.compute_pipeline(&shader, "add").unwrap();
    let mut twice = dev.compute_pipeline(&shader, "twice").unwrap();

    // four regions of 64 u32s, 256 bytes apart
    let mut data = dev.buffer(4 * 256,
        BufferUsage::STORAGE | BufferUsage::COPY_DST | BufferUsage::COPY_SRC);
    let mut init: Vec<u32> = Vec::new_in(gpa);
    for i in 0..256 { init.push(i as u32); }
    queue.write_buffer(&data, 0, std::gpu::bytes_of_u32(init.as_slice()));
    let mut params = dev.buffer(4 * 256, BufferUsage::UNIFORM | BufferUsage::MAP_WRITE);
    let p = std::gpu::u32s_mut(params.map_write(&dev));
    for k in 0..4 { p[k * 64] = (k + 1) as u32 * 1000; }
    params.unmap(&dev);

    let mut groups: Vec<std::gpu::BindGroup> = Vec::new_in(gpa);
    let mut pgroups: Vec<std::gpu::BindGroup> = Vec::new_in(gpa);
    for k in 0..4 {
        groups.push(dev.bind_group(add.bind_layout(0),
            [std::gpu::bind_range(0, &data, k * 256, 256)][..]));
        pgroups.push(dev.bind_group(add.bind_layout(1),
            [std::gpu::bind_range(0, &params, k * 256, 16)][..]));
    }
    let mut enc = dev.encoder();
    enc.compute_pass(|pass| {
        for k in 0..4 {
            pass.set_pipeline(&add);
            pass.set_bind_group(0, &groups[k]);
            pass.set_bind_group(1, &pgroups[k]);
            pass.dispatch(1);
            if k % 2 == 1 {
                pass.set_pipeline(&twice);
                pass.dispatch(1);
            }
        }
    });
    queue.submit(enc.finish());
    // in flight or not, this lands after the submission above
    let mut extra: Vec<u32> = Vec::new_in(gpa);
    for _ in 0..64 { extra.push(7); }
    queue.write_buffer(&data, 3 * 256, std::gpu::bytes_of_u32(extra.as_slice()));
    let mut out = dev.buffer(4 * 256, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let mut enc2 = dev.encoder();
    enc2.copy_buffer(&data, 0, &out, 0, 4 * 256);
    queue.submit(enc2.finish());
    queue.wait_idle().unwrap();
    let got = std::gpu::u32s(out.map_read(&dev));
    let mut bad = 0;
    for i in 0..256 {
        let k = i / 64;
        let mut want = i as u32 + (k + 1) as u32 * 1000;
        if k % 2 == 1 { want = want * 2; }
        if k == 3 { want = 7; }
        if got[i] != want { bad += 1; }
    }
    if bad == 0 { println("offsets ok"); } else { println(f"offsets: {bad} wrong"); }
    0
}
