// A texture (written by queue.write_texture) sampled with a nearest
// sampler over the whole target; no vertex buffer (vertex_id); compared
// exactly.
// EXPECT: textured ok

use std::gpu::{BindingType, Format, PassDesc, SamplerDesc, TextureUsage};

const MSL: [[u8]; 15] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "struct VOut { float4 pos [[position]]; float2 uv; };",
    "vertex VOut vs_tex(uint vid [[vertex_id]]) {",
    "    const float2 c[6] = { float2(0, 0), float2(1, 0), float2(0, 1), float2(1, 0), float2(1, 1), float2(0, 1) };",
    "    VOut o;",
    "    float2 p = c[vid];",
    "    o.pos = float4(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.5, 1.0);",
    "    o.uv = p;",
    "    return o;",
    "}",
    "fragment float4 fs_tex(VOut in [[stage_in]], texture2d<float> t [[texture(0)]], sampler s [[sampler(0)]]) {",
    "    return t.sample(s, in.uv);",
    "}",
    "",
];

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();

    var text = lines(MSL[..], gpa);
    var refl = std::gpu::Reflection::new_in(gpa);
    refl.vertex("vs", "vs_tex");
    refl.fragment("fs", "fs_tex");
    refl.bind(0, 0, BindingType::Texture, fragment: 0);
    refl.bind(0, 1, BindingType::Sampler, fragment: 0);
    let src = std::gpu::ShaderSource::msl(text.as_slice(), refl);
    var shader = dev.shader(src).unwrap();
    let desc = std::gpu::RenderDesc::new(shader, "vs", "fs", Format::Rgba8Unorm);
    var pipe = dev.render_pipeline(desc).unwrap();

    var image = dev.texture(8, 8, Format::Rgba8Unorm);
    var texels = texture_8x8(gpa);
    queue.write_texture(image, texels.as_slice(), 32);
    var iview = image.view();
    let sdesc = SamplerDesc::nearest();
    var sampler = dev.sampler(sdesc);
    var group = dev.bind_group(pipe.bind_layout(0),
        [std::gpu::bind_texture(0, iview), std::gpu::bind_sampler(1, sampler)][..]);

    var tex = target(dev);
    var view = tex.view();
    var rb = readback(dev);
    var enc = dev.encoder();
    enc.render_pass(PassDesc::color(view), |pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.draw(0..6, 0..1);
    });
    enc.copy_texture_to_buffer(tex, rb, 256);
    queue.submit(enc.finish());
    let px = rb.map_read(dev);
    if check_image(px, SIZE, SIZE, 256, "tests/gpu/ref/textured.ppm", 0, 0, gpa) { println(
        "textured ok"); }
    0
}
