// Two render passes into one texture: the second keeps (Load::Keep) what
// the first drew, at a vertex buffer offset; the image is render_rects'.
// EXPECT: two passes ok

use std::gpu::{Format, PassDesc};

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    var shader = rect_shader(dev, gpa);
    var desc = std::gpu::RenderDesc::new(shader, "vs", "fs", Format::Rgba8Unorm);
    desc.vertex_buffer(rect_layout());
    var pipe = dev.render_pipeline(desc).unwrap();

    let rects = scene_rects();
    var verts = rect_vertices(rects[..], gpa);
    var vb = dev.buffer_init(verts.as_slice(), std::gpu::BufferUsage::VERTEX);
    var g = globals(dev);
    var group = dev.bind_group(pipe.bind_layout(0), [std::gpu::bind(0, g)][..]);

    var tex = target(dev);
    var view = tex.view();
    var rb = readback(dev);
    let n = 6 * 6;
    var enc0 = dev.encoder();
    enc0.render_pass(PassDesc::color(view, clear: clear_color()), |pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.set_vertex_buffer(0, vb);
        pass.draw(0..18, 0..1);
    });
    queue.submit(enc0.finish());
    var enc = dev.encoder();
    enc.render_pass(PassDesc::color(view, load: std::gpu::Load::Keep), |pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.set_vertex_buffer(0, vb, offset: 18 * 16);
        pass.draw(0..n - 18, 0..1);
    });
    enc.copy_texture_to_buffer(tex, rb, 256);
    queue.submit(enc.finish());
    let px = rb.map_read(dev);
    if check_image(px, SIZE, SIZE, 256, "tests/gpu/ref/rects.ppm", 0, 0, gpa) { println(
        "two passes ok"); }
    0
}
