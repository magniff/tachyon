// MSL that does not compile: dev.shader returns Error::Shader with
// Metal's message; nothing leaks.
// EXPECT: shader error ok

use gpu::{Reflection, ShaderSource};

fn main(gpa: Gpa) -> i32 {
    let inst = gpu::Instance::new_in(gpa);
    let mut adapter = inst.adapter().unwrap();
    defer adapter.free();
    let (mut dev, mut queue) = adapter.device().unwrap();
    defer dev.free();
    defer queue.free();
    let mut refl = Reflection::new_in(gpa);
    defer refl.free();
    refl.compute("main", "k", 64);
    let src = ShaderSource {
        msl: "kernel void k(device uint* xs [[buffer(0)]]) { xs[0] = undefined_name; }",
        reflection: refl
    };
    match dev.shader(&src) {
        Ok(s) => {
            let mut s2 = s;
            s2.free();
            println("compiled?");
        }
        Err(e) => {
            let mut err = e;
            let mut text = format_in(f"{err}", gpa);
            let msg = text.as_slice();
            let mut found = false;
            for i in 0..msg.len {
                if i + 14 <= msg.len && msg[i..i + 14] == "undefined_name" { found = true; }
            }
            if found { println("shader error ok"); } else { println(f"unexpected: {msg}"); }
            text.free();
            err.free();
        }
    }
    0
}
