// A pipeline drawing Bgra8Unorm in a pass whose target is Rgba8Unorm: the
// gpu.format contract.
// EXIT: 101
// STDERR: gpu.format:

use std::gpu::{Format, PassDesc};

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    var shader = rect_shader(dev, gpa);
    var desc = std::gpu::RenderDesc::new(shader, "vs", "fs", Format::Bgra8Unorm);
    desc.vertex_buffer(rect_layout());
    var pipe = dev.render_pipeline(desc).unwrap();
    var tex = target(dev);
    var view = tex.view();
    var enc = dev.encoder();
    enc.render_pass(PassDesc::color(view), |pass| {
        pass.set_pipeline(pipe);
    });
    println("not reached");
    0
}
