// std::objc: Id and Ref retain counts through clone, retain and drop, an
// autorelease pool; an NSString round trip.
// EXPECT: hello, métal 12
// EXPECT: 1 2 1
// EXPECT: pool ok

use std::objc;
use std::objc::foundation::{NSObjectMethods, NSStringMethods};

fn main(gpa: Gpa) -> i32 {
    objc::init();
    let s = objc::ns_string("hello, métal");
    println(f"{objc::ns_bytes(s.r())} {s.r().length()}");
    let a = s.retain_count();
    let t = s.clone();
    let b = s.retain_count();
    drop(t);
    println(f"{a} {b} {s.retain_count()}");
    // description is +0 (autoreleased): retained, it outlives the pool
    let d = objc::pool(|| s.r().object().description().retain());
    if objc::ns_bytes(d.r()) == objc::ns_bytes(s.r())
        && d.retain_count() >= 1 { println("pool ok"); }
    0
}
