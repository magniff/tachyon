// std::objc: Id and Ref retain counts through clone, retain, free and an
// autorelease pool; NSString round trip.
// EXPECT: hello, métal 12
// EXPECT: 1 2 1
// EXPECT: pool ok

use objc::foundation::{NSObjectMethods, NSStringMethods};

fn main(gpa: Gpa) -> i32 {
    objc::init();
    let mut s = objc::ns_string("hello, métal");
    println(f"{objc::ns_bytes(s.r())} {s.r().length()}");
    let a = s.retain_count();
    let mut t = s.clone();
    let b = s.retain_count();
    t.free();
    t.free();
    println(f"{a} {b} {s.retain_count()}");
    // description is +0 (autoreleased): retained it outlives the pool
    let mut d = objc::pool(|| s.r().object().description().retain());
    if objc::ns_bytes(d.r()) == objc::ns_bytes(s.r())
        && d.retain_count() >= 1 { println("pool ok"); }
    d.free();
    s.free();
    0
}
