// The adapters: the list (found through a scratch arena), the low-power
// pick, a name, the device's capabilities.
// EXPECT: adapters ok
// EXPECT: compute true render true surfaces true shader Msl

use std::gpu;
use std::gpu::Power;

fn main(gpa: Gpa) -> i32 {
    let inst = gpu::Instance::new_in(gpa);
    let all = inst.adapters();
    let low = inst.adapter(Power::Low).unwrap();
    var name = Buf::new_in(gpa);
    low.name_in(&name);
    if all.len() >= 1 && name.len() > 0 { println("adapters ok"); }
    let (dev, _queue) = low.device().unwrap();
    let c = dev.caps();
    println(
        f"compute {c.compute} render {c.render} surfaces {c.surfaces} shader {c.shader_kind:?}");
    0
}
