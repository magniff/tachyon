// A dispatch before its bind group is set: the gpu.pipeline contract.
// EXIT: 101
// STDERR: gpu.pipeline:

use std::gpu::{BindingType, BufferUsage, Reflection, ShaderSource};

const MSL: [[u8]; 3] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "kernel void k(device uint* xs [[buffer(0)]], uint i [[thread_position_in_grid]]) { xs[i] = i; }",
];

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, mut queue) = adapter.device().unwrap();
    let mut text = lines(MSL[..], gpa);
    let mut refl = Reflection::new_in(gpa);
    refl.compute("main", "k", 64);
    refl.bind(0, 0, BindingType::Storage, compute: 0);
    let src = ShaderSource::msl(text.as_slice(), refl);
    let mut shader = dev.shader(&src).unwrap();
    let mut pipe = dev.compute_pipeline(&shader, "main").unwrap();
    let mut buf = dev.buffer(256, BufferUsage::STORAGE);
    let mut group = dev.bind_group(pipe.bind_layout(0), [std::gpu::bind(0, &buf)][..]);
    let mut enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(&pipe);
        pass.dispatch(1);
    });
    println("not reached");
    0
}
