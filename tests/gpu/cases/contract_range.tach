// A copy past the end of a buffer: the gpu.range contract.
// EXIT: 101
// STDERR: gpu.range:

use std::gpu::{BindingType, BufferUsage, Reflection, ShaderSource};

const MSL: [[u8]; 3] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "kernel void k(device uint* xs [[buffer(0)]], uint i [[thread_position_in_grid]]) { xs[i] = i; }",
];

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    var text = lines(MSL[..], gpa);
    var refl = Reflection::new_in(gpa);
    refl.compute("main", "k", 64);
    refl.bind(0, 0, BindingType::Storage, compute: 0);
    let src = ShaderSource::msl(text.as_slice(), refl);
    var shader = dev.shader(src).unwrap();
    var pipe = dev.compute_pipeline(shader, "main").unwrap();
    var buf = dev.buffer(256, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var other = dev.buffer(128, BufferUsage::COPY_SRC);
    var enc = dev.encoder();
    enc.copy_buffer(other, 0, buf, 0, 256);
    println("not reached");
    0
}
