// The sizes buffer (docs/design/gpu.md, "The sizes buffer"): an entry
// point with a sizes_slot reads, at that slot, the bytes bound at each
// (group, binding) of Reflection::sizes; std::gpu gives them before each
// dispatch. The kernel copies its two words out.
// EXPECT: sizes 1024 512

use std::gpu::{BindingType, BufferUsage, Reflection, ShaderSource, ShaderStage};

const MSL: [[u8]; 9] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "kernel void k(device uint* out [[buffer(0)]],",
    "              device uint* data [[buffer(1)]],",
    "              constant uint* sizes [[buffer(2)]],",
    "              uint i [[thread_position_in_grid]]) {",
    "    if (i == 0) { out[0] = sizes[0]; out[1] = sizes[1]; }",
    "}",
    "",
];

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();

    var refl = Reflection::new_in(gpa);
    refl.compute("main", "k", 1);
    refl.bind(0, 0, BindingType::Storage, compute: 0);
    refl.bind(0, 1, BindingType::Storage, compute: 1);
    // the words: the bytes at (0, 0), then at (0, 1); at buffer(2)
    refl.size_binding(0, 0);
    refl.size_binding(0, 1);
    refl.sizes_slot("main", ShaderStage::COMPUTE, 2);
    var text = lines(MSL[..], gpa);
    let src = ShaderSource::msl(text.as_slice(), refl);
    var shader = dev.shader(src).unwrap();
    var pipe = dev.compute_pipeline(shader, "main").unwrap();

    var obuf = dev.buffer(1024, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    var dbuf = dev.buffer(1024, BufferUsage::STORAGE);
    var out = dev.buffer(8, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    // (0, 0): the whole buffer; (0, 1): 512 bytes from offset 256
    var group = dev.bind_group(pipe.bind_layout(0),
        [std::gpu::bind(0, obuf), std::gpu::bind_range(1, dbuf, 256, 512)][..]);

    var enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.dispatch(1);
    });
    enc.copy_buffer(obuf, 0, out, 0, 8);
    queue.submit(enc.finish());

    let got = std::gpu::u32s(out.map_read(dev));
    println(f"sizes {got[0]} {got[1]}");
    0
}
