// Render with a depth test (Depth32Float, Less): the nearer rectangle
// wins whatever the drawing order; compared exactly.
// EXPECT: depth ok

use std::gpu::{Format, PassDesc};

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, mut queue) = adapter.device().unwrap();
    let mut shader = rect_shader(&dev, gpa);
    let mut desc = std::gpu::RenderDesc::new(&shader, "vs", "fs", Format::Rgba8Unorm);
    desc.vertex_buffer(rect_layout());
    desc.depth();
    let mut pipe = dev.render_pipeline(&desc).unwrap();

    let rects = scene_depth();
    let mut verts = rect_vertices(rects[..], gpa);
    let mut vb = dev.buffer_init(verts.as_slice(), std::gpu::BufferUsage::VERTEX);
    let mut g = globals(&dev);
    let mut group = dev.bind_group(pipe.bind_layout(0), [std::gpu::bind(0, &g)][..]);

    let mut tex = target(&dev);
    let mut view = tex.view();
    let mut rb = readback(&dev);
    let n = 6 * 4;
    let mut dtex = dev.texture(SIZE, SIZE, Format::Depth32Float,
        usage: std::gpu::TextureUsage::RENDER_ATTACHMENT);
    let mut dview = dtex.view();
    let mut enc = dev.encoder();
    enc.render_pass(PassDesc::color(&view, clear: clear_color()).with_depth(&dview), |pass| {
        pass.set_pipeline(&pipe);
        pass.set_bind_group(0, &group);
        pass.set_vertex_buffer(0, &vb);
        pass.draw(0..n, 0..1);
    });
    enc.copy_texture_to_buffer(&tex, &rb, 256);
    queue.submit(enc.finish());
    let px = rb.map_read(&dev);
    if check_image(px, SIZE, SIZE, 256, "tests/gpu/ref/depth.ppm", 0, 0, gpa) { println(
        "depth ok"); }
    0
}
