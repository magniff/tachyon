// A storage binding at an offset not aligned to 256: the gpu.align contract.
// EXIT: 101
// STDERR: contract gpu.align failed

use gpu::{BindingType, BufferUsage, Reflection, ShaderSource};

const MSL: [[u8]; 3] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "kernel void k(device uint* xs [[buffer(0)]], uint i [[thread_position_in_grid]]) { xs[i] = i; }",
];

fn main(gpa: Gpa) -> i32 {
    let inst = gpu::Instance::new_in(gpa);
    let mut adapter = inst.adapter().unwrap();
    let (mut dev, mut queue) = adapter.device().unwrap();
    let mut text = lines(MSL[..], gpa);
    let mut refl = Reflection::new_in(gpa);
    refl.compute("main", "k", 64);
    refl.bind(0, 0, BindingType::Storage, compute: 0);
    let src = ShaderSource { msl: text.as_slice(), reflection: refl };
    let mut shader = dev.shader(&src).unwrap();
    let mut pipe = dev.compute_pipeline(&shader, "main").unwrap();
    let mut buf = dev.buffer(256, BufferUsage::STORAGE);
    let mut group = dev.bind_group(pipe.bind_layout(0), [gpu::bind_range(0, &buf, 16, 64)][..]);
    println("not reached");
    0
}
