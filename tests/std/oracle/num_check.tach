use std::num::{
    FloatFmt, f32_from_bits, f32_to_bits, f64_from_bits, f64_shortest, f64_to_bits, fmt_i64,
    fmt_u64, parse_f32, parse_f64, write_f32, write_f64,
};

// The tachyon side of tests/std/oracle/num_oracle.rs (0.20): the same
// lines from std's number conversion (compiler/std/num.tach), plus checks
// that need no oracle: every text parses back to its value, and parsing
// agrees with C's strtod and strtof. A failed check prints a line starting
// with `FAIL`. The modes and the value generators are the oracle's.
//
//   num_check f32 LO HI | f64 SEED N | parse SEED N | text SEED N | ints SEED N

extern "C" {
    fn strtod(s: *u8, end: **u8) -> f64;
    fn strtof(s: *u8, end: **u8) -> f32;
}

const CHUNK: u64 = 1048576;

struct Fnv { h: u64 }

fn fnv_bytes(f: inout Fnv, s: [u8]) {
    var h = f.h;
    for b in s {
        h = (h ^ b as u64) * 0x100000001b3;
    }
    f.h = (h ^ 10) * 0x100000001b3;
}

fn fnv_u64(f: inout Fnv, x: u64) {
    var out: [u8; 20] = [0; 20];
    let at = fmt_u64(x, &out);
    fnv_bytes(&f, out[at..20]);
}

struct Rng { s: u64 }

fn rng_next(r: inout Rng) -> u64 {
    var x = r.s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    r.s = x;
    x
}

fn rng_below(r: inout Rng, n: u64) -> u64 {
    rng_next(&r) % n
}

const POW10: [f64; 21] = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12,
    1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20];

fn num_value(r: inout Rng) -> f64 {
    let kind = rng_below(&r, 4);
    if kind == 0 {
        loop {
            let v = f64_from_bits(rng_next(&r));
            if v - v == 0.0 {
                return v;
            }
        }
    }
    if kind == 1 {
        let m = rng_next(&r) & 0xfffffffffffff;
        let e = 1023 - 70 + rng_below(&r, 140);
        return f64_from_bits((rng_next(&r) & (1 << 63)) | (e << 52) | m);
    }
    if kind == 2 {
        let bits = rng_below(&r, 64);
        return (rng_next(&r) >> bits) as f64;
    }
    let digits = 1 + rng_below(&r, 17);
    var d: u64 = 0;
    for _ in 0..digits {
        d = d * 10 + rng_below(&r, 10);
    }
    let k = rng_below(&r, 41) as i64 - 20;
    let p = POW10[if k < 0 { -k } else { k }];
    if k < 0 { d as f64 / p } else { d as f64 * p }
}

fn num_text(r: inout Rng, out: inout [u8; 128]) -> i64 {
    var n = 0;
    let sign = rng_below(&r, 4);
    if sign == 0 {
        out[n] = '-';
        n += 1;
    } else if sign == 1 {
        out[n] = '+';
        n += 1;
    }
    let digits = if rng_below(&r, 8) == 0 { 1 + rng_below(&r, 40) } else { 1 + rng_below(&r, 19) };
    let point = rng_below(&r, digits + 2);
    let zeros = rng_below(&r, 3);
    for i in 0..digits {
        if i == point && i > 0 {
            out[n] = '.';
            n += 1;
        }
        let d = if zeros == 0 && rng_below(&r, 3) == 0 { 0 } else { rng_below(&r, 10) };
        out[n] = '0' + d as u8;
        n += 1;
    }
    if point == digits {
        out[n] = '.';
        n += 1;
    }
    if rng_below(&r, 3) != 0 {
        out[n] = if rng_below(&r, 2) == 0 { 'e' } else { 'E' };
        n += 1;
        let es = rng_below(&r, 3);
        if es == 0 {
            out[n] = '-';
            n += 1;
        } else if es == 1 {
            out[n] = '+';
            n += 1;
        }
        let e = if rng_below(&r, 2) == 0 { rng_below(&r, 30) } else { rng_below(&r, 400) };
        var ds: [u8; 20] = [0; 20];
        let at = fmt_u64(e, &ds);
        for c in ds[at..20] {
            out[n] = c;
            n += 1;
        }
    }
    n
}

fn arg_u64(argv: **u8, i: i64) -> u64 {
    let p = unsafe { argv[i] };
    var v: u64 = 0;
    var k = 0;
    loop {
        let c = unsafe { p[k] };
        if c == 0 {
            break;
        }
        v = v * 10 + (c - '0') as u64;
        k += 1;
    }
    v
}

fn hex16(x: u64) {
    let digits = "0123456789abcdef";
    for i in 0..16 {
        let d = (x >> (60 - 4 * i) as u64) & 15;
        print(digits[d as i64..d as i64 + 1]);
    }
}

fn fail_line(what: [u8], s: [u8], bits: u64) {
    print("FAIL ");
    print(what);
    print(" ");
    print(s);
    print(" ");
    hex16(bits);
    println("");
}

fn f32_mode(lo: u64, hi: u64) -> i32 {
    var out: [u8; 400] = [0; 400];
    var c = lo / CHUNK;
    var failures = 0;
    while c * CHUNK < hi {
        var h = Fnv { h: 0xcbf29ce484222325 };
        let start = if c * CHUNK > lo { c * CHUNK } else { lo };
        let end = if (c + 1) * CHUNK < hi { (c + 1) * CHUNK } else { hi };
        for bits in start..end {
            let v = f32_from_bits(bits as u32);
            if v - v != 0.0 {
                continue;
            }
            let n = write_f32(v, FloatFmt::Display, out[..]);
            fnv_bytes(&h, out[0..n]);
            match parse_f32(out[0..n]) {
                Result::Ok(x) => {
                    if f32_to_bits(x) as u64 != bits && failures < 20 {
                        fail_line("f32 roundtrip", out[0..n], bits);
                        failures += 1;
                    }
                }
                Result::Err(_) => fail_line("f32 parse", out[0..n], bits),
            }
            let n2 = write_f32(v, FloatFmt::Debug, out[..]);
            fnv_bytes(&h, out[0..n2]);
            let n3 = write_f32(v, FloatFmt::LowerExp, out[..]);
            fnv_bytes(&h, out[0..n3]);
            match parse_f32(out[0..n3]) {
                Result::Ok(x) => {
                    if f32_to_bits(x) as u64 != bits && failures < 20 {
                        fail_line("f32 roundtrip e", out[0..n3], bits);
                        failures += 1;
                    }
                }
                Result::Err(_) => fail_line("f32 parse e", out[0..n3], bits),
            }
        }
        print(f"{c} ");
        hex16(h.h);
        println("");
        c += 1;
    }
    0
}

// One digit fewer does not read back: the shortest (d's last digit
// dropped, rounded either way).
fn check_shortest(v: f64) -> bool {
    let (d, k) = f64_shortest(v);
    if d < 10 {
        return true;
    }
    var out: [u8; 64] = [0; 64];
    for up in 0..2 {
        let d2 = d / 10 + up as u64;
        var ds: [u8; 20] = [0; 20];
        let at = fmt_u64(d2, &ds);
        var n = 0;
        for c in ds[at..20] {
            out[n] = c;
            n += 1;
        }
        out[n] = 'e';
        n += 1;
        let e = k as i64 + 1;
        var es: [u8; 20] = [0; 20];
        let at2 = fmt_i64(e, &es);
        for c in es[at2..20] {
            out[n] = c;
            n += 1;
        }
        match parse_f64(out[0..n]) {
            Result::Ok(x) => {
                if f64_to_bits(x) == f64_to_bits(if v < 0.0 { -v } else { v }) {
                    return false;
                }
            }
            Result::Err(_) => return false,
        }
    }
    true
}

fn f64_mode(seed: u64, count: u64) -> i32 {
    var out: [u8; 400] = [0; 400];
    var r = Rng { s: seed };
    var h = Fnv { h: 0xcbf29ce484222325 };
    var failures = 0;
    for i in 0..count {
        let v = num_value(&r);
        let bits = f64_to_bits(v);
        let n = write_f64(v, FloatFmt::Display, out[..]);
        fnv_bytes(&h, out[0..n]);
        match parse_f64(out[0..n]) {
            Result::Ok(x) => {
                if f64_to_bits(x) != bits && failures < 20 {
                    fail_line("f64 roundtrip", out[0..n], bits);
                    failures += 1;
                }
            }
            Result::Err(_) => fail_line("f64 parse", out[0..n], bits),
        }
        let n2 = write_f64(v, FloatFmt::Debug, out[..]);
        fnv_bytes(&h, out[0..n2]);
        let n3 = write_f64(v, FloatFmt::LowerExp, out[..]);
        fnv_bytes(&h, out[0..n3]);
        if !check_shortest(v) && failures < 20 {
            fail_line("f64 not shortest", out[0..n3], bits);
            failures += 1;
        }
        if (i + 1) % CHUNK == 0 || i + 1 == count {
            print(f"{i / CHUNK} ");
            hex16(h.h);
            println("");
            h.h = 0xcbf29ce484222325;
        }
    }
    0
}

fn parse_mode(seed: u64, count: u64, text: bool) -> i32 {
    var t: [u8; 128] = [0; 128];
    var r = Rng { s: seed };
    var h = Fnv { h: 0xcbf29ce484222325 };
    var failures = 0;
    for i in 0..count {
        let n = num_text(&r, &t);
        let s = t[0..n];
        let x = parse_f64(s).unwrap();
        let y = parse_f32(s).unwrap();
        if text {
            print(s);
            print(" ");
            hex16(f64_to_bits(x));
            print(" ");
            hex16(f32_to_bits(y) as u64);
            println("");
            continue;
        }
        fnv_u64(&h, f64_to_bits(x));
        fnv_u64(&h, f32_to_bits(y) as u64);
        // (C's, from a NUL-terminated copy)
        t[n] = 0;
        let cx = unsafe { strtod(&t[0], 0 as **u8) };
        let cy = unsafe { strtof(&t[0], 0 as **u8) };
        if (f64_to_bits(cx) != f64_to_bits(x) || f32_to_bits(cy) != f32_to_bits(y))
            && failures < 20 {
            fail_line("parse differs from strtod", t[0..n], f64_to_bits(x));
            failures += 1;
        }
        if (i + 1) % CHUNK == 0 || i + 1 == count {
            print(f"{i / CHUNK} ");
            hex16(h.h);
            println("");
            h.h = 0xcbf29ce484222325;
        }
    }
    0
}

fn ints_mode(seed: u64, count: u64) -> i32 {
    var r = Rng { s: seed };
    var h = Fnv { h: 0xcbf29ce484222325 };
    var out: [u8; 20] = [0; 20];
    for i in 0..count {
        let x = rng_next(&r);
        let v0 = (x >> rng_below(&r, 64)) as i64;
        let v = if rng_below(&r, 2) == 0 { v0 } else { 0 - v0 };
        let at = fmt_i64(v, &out);
        fnv_bytes(&h, out[at..20]);
        let back = parse_int(out[at..20]).unwrap();
        fnv_u64(&h, back as u64);
        if back != v {
            fail_line("int roundtrip", out[at..20], v as u64);
        }
        if (i + 1) % CHUNK == 0 || i + 1 == count {
            print(f"{i / CHUNK} ");
            hex16(h.h);
            println("");
            h.h = 0xcbf29ce484222325;
        }
    }
    0
}

fn main(argc: i32, argv: **u8) -> i32 {
    if argc < 4 {
        eprintln(
            "usage: num_check f32 LO HI | f64 SEED N | parse SEED N | text SEED N | ints SEED N");
        return 2;
    }
    let mode = unsafe { argv[1][0..2] };
    let a = arg_u64(argv, 2);
    let b = arg_u64(argv, 3);
    if mode == "f3" {
        return f32_mode(a, b);
    }
    if mode == "f6" {
        return f64_mode(a, b);
    }
    if mode == "ft" {
        return ftext_mode(a, b);
    }
    if mode == "pa" {
        return parse_mode(a, b, false);
    }
    if mode == "te" {
        return parse_mode(a, b, true);
    }
    ints_mode(a, b)
}

fn ftext_mode(seed: u64, count: u64) -> i32 {
    var out: [u8; 400] = [0; 400];
    var r = Rng { s: seed };
    for _ in 0..count {
        let v = num_value(&r);
        hex16(f64_to_bits(v));
        let n = write_f64(v, FloatFmt::Display, out[..]);
        print(" ");
        print(out[0..n]);
        let n2 = write_f64(v, FloatFmt::Debug, out[..]);
        print(" ");
        print(out[0..n2]);
        let n3 = write_f64(v, FloatFmt::LowerExp, out[..]);
        print(" ");
        println(out[0..n3]);
    }
    0
}
