// A program for the tools' fixes of 0.14 (tests/refactor/shortfalls.t).
mod catalog;
mod shapes;
mod table;

use catalog::{price, summary};
use crate::catalog::Item;
use shapes::{Shape, area};

fn main() -> i32 {
    let s = Shape::Square(2);
    let total = price(Item { cost: 3 }) + area(s) + summary(1) + table::fourth();
    if total == 16 { 0 } else { 1 }
}
