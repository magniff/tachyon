// (0.18) A program whose binary names its files: the checks' positions,
// a contract's, --trace's frames, --check-alloc's sites, -g's line table.
mod util;

fn median(s: [i64]) -> i64
    requires s.len() > 0
{
    s[s.len() / 2]
}

fn main(argc: i64, argv: **u8, gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..argc - 1 {
        v.push(i * 3);
    }
    let f = |x: i64| x + util::bump(x);
    println(f"{f(2)}");
    println(f"{median(v.as_slice())}");
    println(f"{util::pick(v.as_slice(), 5)}");
}
