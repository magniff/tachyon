mod util;

#[pure]
#[no_io]
fn mid(a: i64, b: i64) -> i64 {
    a + (b - a) / 2
}

#[effects(alloc(Gpa), panic)]
fn grow(v: &mut Vec<i64>) {
    v.push(1);
}

#[inline]
#[pure]
fn twice(x: i64) -> i64 {
    x * 2
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    grow(&mut v);
    println(mid(2, 10) + twice(v.len()) + util::one());
}
