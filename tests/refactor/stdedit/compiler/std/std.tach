// A small std (tests/refactor/stdedit.t): the core.

pub enum Option<T> {
    None,
    Some(T),
}

impl<T> Option<T> {
    // x's value, or other.
    pub fn unwrap_or(self: Option<T>, other: T) -> T {
        match self {
            Option::Some(x) => x,
            Option::None => other,
        }
    }
}
