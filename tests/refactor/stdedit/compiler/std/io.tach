// ---- Text (0.14) ----

// ' ' or '\n'.
pub fn is_space(b: u8) -> bool {
    b == ' ' || b == '\n'
}

// s without the spaces at its start and end.
pub fn trim(s: [u8]) -> [u8] {
    let mut a = 0;
    let mut b = s.len;
    while a < b && is_space(s[a]) {
        a += 1;
    }
    while b > a && is_space(s[b - 1]) {
        b -= 1;
    }
    s[a..b]
}
