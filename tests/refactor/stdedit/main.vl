// A program in a copy of the vole repository whose std
// (compiler/std/) is a small one: std's items are edited by name there
// (stdedit.t).
use std::trim;

fn main() {
    let s = trim(" a ");
    let n = s.len;
    if n != 1 {
        unsafe { exit(1) };
    }
}

extern "C" {
    fn exit(code: i32);
}
