// The tools' fixes of 0.17 (tests/refactor/tools017.t).
mod calc;
mod report;
mod geo;

use calc::{empties, percent, twice};
use std::Buf;

const GREETING: *u8 = c"hello";
const TITLE: [u8] = "totals";
static A: i64 = 1;
static B: i64 = 2;

extern "C" {
    fn puts(s: *u8) -> i32;
}

fn main(gpa: Gpa) -> i32 {
    let a = 3;
    let b = 4;
    println(f"{TITLE}: share {percent(a, b)}%, twice {twice(a)}");
    unsafe {
        puts(GREETING);
    }
    println(f"{geo::area(2)} {A + B} {twice(b)} {calc::header()}");
    let words: Vec<[u8]> = Vec::new_in(gpa);
    var text = Buf::new_in(gpa);
    defer text.free();
    println(f"{empties(words, text)}");
    0
}
