// Arithmetic. `calc::header` is the function below; `MODULE::header`
// and `main::header` name regions of a module, not it.

use crate::geo::area;
use std::Buf;

pub fn percent(part: i64, whole: i64) -> i64 {
    if whole == 0 {
        0
    } else {
        part * 100 / whole
    }
}

pub fn twice(x: i64) -> i64 {
    x * 2
}

pub fn header() -> i64 {
    1
}

// How many of the two are empty.
pub fn empties(words: *Vec<[u8]>, text: *Buf) -> i64 {
    let mut k = 0;
    if words.len() == 0 {
        k += 1;
    }
    if text.len() == 0 {
        k += 1;
    }
    k
}
