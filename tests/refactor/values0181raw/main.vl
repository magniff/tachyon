extern "C" {
    fn strlen(s: *u8) -> u64;
    fn memcmp(a: *u8, b: *u8, n: u64) -> i32;
}

struct Stats { count: i64, sum: i64 }
struct Block { preds: Vec<i64> }
struct Table { blocks: *Block }

// Kept raw: C strings (passed to C, given `c"..."`, compared with null,
// indexed, stored), and what is passed on to them.
fn streq(a: *u8, b: *u8) -> bool {
    unsafe {
        let n = strlen(a);
        n == strlen(b) && memcmp(a, b, n) == 0
    }
}

fn is_help(s: *u8) -> bool { unsafe { streq(s, c"help") } }

fn or_default(s: *u8) -> *u8 {
    if s == 0 as *u8 { c"none" } else { s }
}

fn byte_at(s: *u8, i: i64) -> u8 {
    unsafe { s[i] }
}

fn second(s: *u8) -> *u8 {
    unsafe { &s[1] }
}

fn pair(a: *u8, b: *u8) -> [*u8; 2] { [a, b] }

// A reference: written, or only read; a slice shown in an f-string is
// read.
fn add(s: *Stats, x: i64) { s.count += 1; s.sum += x; }
fn mean(s: *Stats) -> i64 { if s.count == 0 { 0 } else { s.sum / s.count } }
fn npreds(v: *Vec<i64>) -> i64 { v.len() }
fn show(t: [u8], gpa: Gpa) -> Buf {
    let mut b = Buf::new_in(gpa);
    b.push_fmt(f"<{t[1..t.len]}>");
    b
}

fn main(gpa: Gpa) {
    let mut st = Stats { count: 0, sum: 0 };
    add(&st, 4);
    add(&st, 6);
    let mut blocks = [Block { preds: Vec::new_in(gpa) }];
    blocks[0].preds.push(7);
    let t = Table { blocks: &blocks[0] };
    let n = unsafe { npreds(&t.blocks[0].preds) };
    let b = show("abc", gpa);
    unsafe {
        let p = pair(c"x", c"y");
        println(f"{is_help(c"help")} {streq(or_default(0 as *u8), c"none")} {byte_at(c"az", 1)} \
            {streq(second(c"xyz"), c"yz")} {streq(p[1], c"y")} {mean(&st)} {n} {b}");
    }
}
