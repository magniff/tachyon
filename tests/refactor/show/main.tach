// A program for edit --show, query diff and fix --only unsafe
// (tests/refactor/show.t).

extern "C" {
    fn abs(x: i32) -> i32;
}

// Two C calls: the whole body goes in one unsafe block.
fn spread(a: i32, b: i32) -> i64 {
    let x = abs(a) as i64;
    let y = abs(b) as i64;

    x + y
}

// One: only it is wrapped.
fn one(a: i32) -> i64 {
    let k = 2;
    k * abs(a) as i64
}

fn main() -> i32 {
    let s = spread(-2, 3) + one(-1);
    if s == 7 { 0 } else { 1 }
}
