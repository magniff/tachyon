// A program of four modules to reorganize (tests/refactor/modules.t).
mod geom;
mod shapes;
mod util;

use geom::{Point, area};
use util::twice;

fn main() -> i32 {
    let p = Point { x: 2, y: 3 };
    let n = twice(area(p)) + shapes::perimeter(p) + util::LIMIT + p.sum();
    if n == 127 { 0 } else { 1 }
}
