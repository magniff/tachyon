mod shapes;
use crate::shapes::Point;
use std::{println, print};

use std::Vec;
use shapes::area;
pub fn twice(x: i64) -> i64 { x * 2 }
fn pair(a: i64, b: i64) -> (i64, i64) { (a, b,) }
fn main(gpa: Gpa) {
    let p = Point { x: 1, y: 2, };
    let q = Point {
        x: 3,
        y: 4
    };
    let one = (p.x,);
    let t = pair(
        p.x,
        p.y
    );
    let v = [
        1, 2,
        3
    ];
    let w = area(
        q
    );
    let r = match t.0 {
        1 => 10,
        _ => 20
    };
    var xs: Vec<i64, Gpa> = Vec::new_in(gpa);
    xs.push(one.0 + r + w + v[0]);
    print(f"{t.1} ");
    println(xs.len());
}
