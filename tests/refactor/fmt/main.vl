// A program laid out by hand, for `volec fmt`.
mod util;
use util::{twice, Pair};
use util::sum;
use util::Kind;



struct Point { x: i64, y: i64 }
fn area(p: Point)->i64{
  let w=p.x*2;   // the width
      let h = -p.y ;
  if w>0&&h<0 { return w*(0-h); }
  else if w == 0 { return 0; }
  0
}
fn describe(k: Kind) -> i64 {
    match k { Kind::Small => 1, Kind::Large(n) => n * 1000 + twice(n) * 100 + sum(n, n + 1) * 10 + n }
}
fn main() -> i32 {
    let p = Point { x: 3, y: -4 };
    let pair: Pair<i64> = Pair { first: area(p), second: describe(Kind::Large(2)) + describe(Kind::Small) };

    /* a block comment
       on two lines */
    let total = pair.first + pair.second + twice(twice(twice(1))) + sum(sum(1, 2), sum(3, 4)) - 2;
    let s = "a string \
        continued";
    if total != 2469 || s.len != 18 { return 1; }
    0
}
