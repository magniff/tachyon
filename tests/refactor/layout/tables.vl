// Weights, and statics written apart.

use crate::util::twice;

pub const LIMIT: i64 = 9;

pub static var HITS: i64 = 0;

pub static var MISSES: i64 = 0;

pub static var TOTAL: i64 = 0;

// ---- Weights ----

pub const W_LOW: i64 = 1;
pub const W_MID: i64 = 2;
pub const W_HIGH: i64 = 4;

// The weight of kind k.
pub fn weight(k: i64) -> i64 {
    if k == 0 { W_LOW } else if k == 1 { W_MID } else { W_HIGH }
}

pub fn scaled(k: i64) -> i64 {
    twice(k) * W_MID
}
