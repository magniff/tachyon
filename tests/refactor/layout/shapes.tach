// Points and what is measured of them.

use crate::util::{clamp, twice};

pub const SIDES: i64 = 4;
pub const CORNERS: i64 = 4;
pub const EDGES: i64 = SIDES;

// A point of the plane.
pub struct Point {
    pub x: i64,
    pub y: i64,
}

impl Point {
    // x + y.
    pub fn sum(self) -> i64 {
        self.x + self.y
    }
}

// ---- Measures ----

// The area of the rectangle from the origin to p.
#[inline]
pub fn area(p: Point) -> i64 {
    p.x * p.y
}

pub fn perimeter(p: Point) -> i64 {
    twice(p.x + p.y) + SIDES - CORNERS
}

// The sum of the sides, at most 10 edges.
pub fn diagonal(p: Point) -> i64 {
    clamp(p.x + p.y, 0, EDGES * 10)
}

// ---- Points ----

pub fn origin() -> Point {
    Point { x: 0, y: 0 }
}

pub fn unit() -> Point {
    Point { x: 1, y: 1 }
}
