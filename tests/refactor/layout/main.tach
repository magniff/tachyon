// A program whose items move back and forth (tests/refactor/layout.t,
// tests/refactor/roundtrip.sh): comments, attributes, banners, runs of
// constants and statics, blank lines as they are written.
mod shapes;
mod tables;
mod util;

use crate::shapes::{Point, area, origin, perimeter};
use crate::tables::{LIMIT, scaled, weight};
use crate::util::clamp;

fn main() -> i32 {
    let p = Point { x: 3, y: 4 };
    let total = area(p) + perimeter(p) + scaled(2) + weight(1) + clamp(origin().x, 0, LIMIT);
    if total == 36 { 0 } else { 1 }
}
