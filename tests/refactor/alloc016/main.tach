// What `fix --only alloc016` cannot thread an allocator to
// (tests/refactor/alloc016.t).
use std::{Buf, Display, Fmt};

struct Name {
    text: [u8],
}

// An impl of std's trait: its signature is fixed.
impl Display for Name {
    fn fmt(self: *Name, f: *Fmt) {
        let b: Buf = format(self.text);
        f.str(b.as_slice());
    }
}

// Used as a value: its type would change.
fn make(n: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::filled(n, 1);
    v
}

fn apply(f: fn(i64) -> Vec<i64>) -> i64 {
    f(3).len
}

// Called by apply's caller only: threaded.
fn count(n: i64) -> i64 {
    let v: Vec<i64> = Vec::filled(n, 0);
    v.len
}

// A default cannot allocate.
fn with(x: i64, v: Vec<i64> = Vec::new()) -> i64 {
    x + v.len
}

// A write of a sealed field (0.16): left.
fn shrink(v: *Vec<i64>) {
    v.len = 0;
}

fn main() {
    let n = Name { text: "ann" };
    println(f"{n}");
    println(apply(make));
    println(count(2));
    println(with(1));
}
