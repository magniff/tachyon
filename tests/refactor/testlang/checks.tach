// The tests: this module sees main.tach's items without an import.

#[test]
fn gap_of_three() {
    if max_gap([1, 5, 6][..]) != 4 {
        panic("max_gap");
    }
}

#[test]
fn gap_needs_two() {
    let v = [7];
    let i = 2;
    if v[i - 1] != 7 {
        panic("one element");
    }
}

#[test]
fn keeps_a_buffer(gpa: Gpa) {
    let mut b = Buf::new_in(gpa);
    b.push_str("left allocated");
}

#[test]
fn span_snapshot() {
    std::assert_snapshot(span([3, -2, 9][..]));
}

#[test]
fn parses() -> Result<(), std::ParseIntError> {
    let n = std::parse_int("12")?;
    if n != 12 {
        panic("12");
    }
    Ok(())
}

#[property]
fn bubble_sorts(v: Vec<i64>) {
    let mut w = v;
    bubble(w.as_slice());
    for i in 1..w.len() {
        if w.get(i - 1) > w.get(i) {
            panic("not sorted");
        }
    }
}

#[property]
fn clamp_in_range(x: i64, r: Range) {
    if r.lo <= r.hi {
        let c = clamp(x, r.lo, r.hi);
        if c < r.lo || c > r.hi {
            panic("out of range");
        }
    }
}
