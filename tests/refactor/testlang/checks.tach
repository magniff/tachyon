// The tests: this module sees main.tach's items without an import.

#[test]
fn gap_of_three() {
    if max_gap([1, 5, 6][..]) != 4 {
        panic("max_gap");
    }
}

#[test]
fn gap_needs_two() {
    let v = [7];
    let i = 2;
    if v[i - 1] != 7 {
        panic("one element");
    }
}

#[test]
fn keeps_a_buffer(gpa: Gpa) {
    let mut b = Buf::new_in(gpa);
    b.push_str("left allocated");
    forget(b);
}

#[test]
fn span_snapshot() {
    std::assert_snapshot(span([3, -2, 9][..]));
}

#[test]
fn parses() -> Result<(), std::ParseIntError> {
    let n = std::parse_int("12")?;
    if n != 12 {
        panic("12");
    }
    Ok(())
}

#[property]
fn bubble_sorts(v: Vec<i64>) {
    let mut w = v;
    bubble(w.as_mut_slice());
    for i in 1..w.len() {
        if w.get(i - 1) > w.get(i) {
            panic("not sorted");
        }
    }
}

#[property]
fn clamp_in_range(x: i64, r: Range) {
    if r.lo <= r.hi {
        let c = clamp(x, r.lo, r.hi);
        if c < r.lo || c > r.hi {
            panic("out of range");
        }
    }
}

// (0.18 with 0.17) A generator of its own takes `&mut Gen`.
struct Small { n: i64 }

impl std::Arbitrary for Small {
    fn arbitrary(g: &mut std::Gen) -> Small {
        Small { n: g.int_in(0, 9) }
    }
}

#[property]
fn small_stays_small(s: Small) {
    if s.n < 0 || s.n > 9 {
        panic("not small");
    }
}

// (0.18 with 0.17's drops) A case's values are dropped after it: a block
// it leaves allocated is a leak (test builds use --check-alloc).
#[property]
fn forgets_its_input(v: Vec<i64>) {
    forget(v);
}
