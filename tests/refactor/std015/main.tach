// A 0.14 program reading numbers, for `fix --only std015`.
mod mine;

use std::{Buf, Scanner, parse_int, read_line, read_stdin};

fn first_int(text: [u8]) -> Option<i64> {
    parse_int(text)
}

fn twice<T>(x: T, s: [u8]) -> Option<i64> {
    match parse_int(s) {
        Some(v) => Some(2 * v),
        None => None,
    }
}

fn main() -> i32 {
    let input = read_stdin();
    let mut sc = Scanner::new(input.as_slice());
    let mut total = 0;
    while let Some(v) = sc.next_int() {
        total += v;
    }
    let mut line = Buf::new();
    while read_line(&line) {
        line.clear();
    }
    let a = parse_int("12").unwrap_or(0);
    let b = parse_int("x").is_none();
    let c: Result<i64, i64> = parse_int("3");
    let d = match parse_int("4") { Ok(v) => v, Err(_) => 0 };
    let e = parse_int("5").ok();
    let f = mine::parse_int("6");
    let g = twice(1, "7");
    let h = std::parse_int("8");
    let k = Scanner::next_int(&sc);
    print_int(total + a + f);
    0
}
