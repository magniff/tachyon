// A parser with a crash behind a 4-byte magic.
fn parse(data: [u8]) -> i64 {
    if data.len >= 4 && data[0] == 'F' {
        if data[1] == 'U' {
            if data[2] == 'Z' {
                if data[3] == 'Z' {
                    let empty = [0; 2];
                    let i = data.len;
                    return empty[i];
                }
            }
        }
    }
    data.len
}

fn main() -> i32 {
    println(f"{parse("hello")}");
    0
}

#[fuzz]
fn parse_never_crashes(data: [u8]) {
    let _ = parse(data);
}
