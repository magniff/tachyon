// Points.

pub struct Point {
    pub x: i64,
    pub y: i64,
}

// The area of the rectangle from the origin to p.
pub fn area(p: Point) -> i64 {
    p.x * p.y
}

pub fn scale(p: Point, k: i64) -> Point {
    Point { x: p.x * k, y: p.y * k }
}

impl Point {
    // x + y.
    pub fn sum(self) -> i64 {
        self.x + self.y
    }
}

pub enum Corner { Low, High }
