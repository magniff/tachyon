// A program to edit (tests/refactor/edits.t).
mod geom;
mod shapes;

use geom::{Point, area, scale};

// The sum of the areas of two points.
fn total(a: Point, b: Point) -> i64 {
    area(a) + area(b)
}

fn main() -> i32 {
    let p = Point { x: 2, y: 3 };
    let q = scale(Point { x: 1, y: 1 }, 2);
    let n = total(p, q) + shapes::area(1);
    if n == 11 { 0 } else { 1 }
}
