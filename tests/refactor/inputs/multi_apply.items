// crate::shapes::area	shapes.vl:13-16
// The area of r, in square units.
pub fn area(r: Rect) -> i64 {
    r.w * r.h
}
@@ shapes::perimeter
// The perimeter of r.
pub fn perimeter(r: Rect) -> i64 {
    2 * (r.w + r.h)
}
@@ new after describe
fn twice(n: i64) -> i64 {
    n + n
}
// crate::main	main.vl:13-16
fn main() -> i32 {
    let r = scale(Rect { w: 2, h: 3 }, 2);
    if area(r) + describe(kind(r)) + twice(perimeter(r)) == 66 { 0 } else { 1 }
}
