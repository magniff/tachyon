// Areas, in a module of their own.
use std::Vec;

pub fn area_sum(n: i64) -> i64 {
    let sides = sides(n);
    let mut t = 0;
    for s in sides.iter() {
        t += s * s;
    }
    t
}

fn sides(n: i64) -> Vec<i64> {
    let mut v: Vec<i64> = Vec::new();
    for i in 1..n + 1 {
        v.push(i);
    }
    v
}
