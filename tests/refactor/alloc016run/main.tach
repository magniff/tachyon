// A program written against 0.15's std, whose containers took their
// memory from an ambient allocator (tests/refactor/alloc016run.t).
use std::{Buf, HashMap, read_stdin, sort_stable, split_whitespace};

mod shapes;

struct Counter {
    seen: Vec<i64>,
}

impl Counter {
    fn new() -> Counter {
        Counter { seen: Vec::new() }
    }

    fn add(self: *Counter, x: i64) {
        self.seen.push(x);
    }

    // A copy, sorted: allocates.
    fn sorted(self: *Counter) -> Vec<i64> {
        let mut v: Vec<i64> = Vec::with_capacity(self.seen.len);
        for x in self.seen.iter() {
            v.push(x);
        }
        sort_stable(v.as_slice());
        v
    }
}

trait Render {
    fn render(self: *Self) -> Buf;
}

struct Point {
    x: i64,
    y: i64,
}

impl Render for Point {
    fn render(self: *Point) -> Buf {
        format(f"({self.x}, {self.y})")
    }
}

fn show<T: Render>(t: *T) {
    let b = t.render();
    println(b.as_slice());
}

fn squares(n: i64) -> Vec<i64> {
    (0..n).map(|i| i * i).collect()
}

fn lengths(words: [[u8]]) -> Vec<i64> {
    let mut out: Vec<i64> = Vec::new();
    let mut each = |w: [u8]| out.push(w.len);
    for w in words {
        each(w);
    }
    out
}

// A parameter with a default: the allocator goes before it.
fn padded(n: i64, fill: i64 = 0) -> Vec<i64> {
    Vec::filled(n, fill)
}

fn main() {
    let input = read_stdin().unwrap();
    let words = split_whitespace(input.as_slice());
    let lens = lengths(words.as_slice());
    let mut c = Counter::new();
    for l in lens.iter() {
        c.add(l);
    }
    let s = c.sorted();
    println(f"{s.len} words, shortest {s.get(0)}, longest {s.get(s.len - 1)}");
    if s.cap < s.len {
        println("impossible");
    }
    let sq = squares(5);
    println(f"squares {sq.get(4)}");
    let p = Point { x: 1, y: 2 };
    show(&p);
    let total = shapes::area_sum(3);
    println(f"area {total}");
    let grid: Vec<i64> = Vec::filled(3, 7);
    let m: HashMap<i64, i64> = HashMap::new();
    println(f"{grid.get(2)} {m.len()}");
    let p0 = padded(2);
    let p1 = padded(3, 4);
    let p2 = padded(1, fill: 9);
    println(f"padded {p0.get(1)} {p1.get(2)} {p2.get(0)}");
}
