// A small program with two bugs, for the debugging tools (0.17): a key
// whose values are all negative crashes `best`; WIDTH 0 never ends.
mod stats;

use std::{Vec, read_stdin_in};

fn main(gpa: Gpa) -> i32 {
    let mut keys: Vec<[u8]> = Vec::new_in(gpa);
    let mut values: Vec<i64> = Vec::new_in(gpa);
    let mut width = 8;
    let input = read_stdin_in(gpa).unwrap();
    let lines = stats::split(gpa, input.as_slice(), '\n');
    for l in 0..lines.len() {
        let words = stats::split(gpa, lines.get(l), ' ');
        if words.len() == 2 && words.get(0) == "WIDTH" {
            width = stats::number(words.get(1));
        } else if words.len() == 2 {
            keys.push(words.get(0));
            values.push(stats::number(words.get(1)));
        }
    }
    let mut i = 0;
    while i < keys.len() {
        let v = stats::positive(gpa, values.as_slice(), keys.as_slice(), keys.get(i));
        println(f"{keys.get(i)} best {stats::best(v.as_slice())}");
        i += 1;
    }
    stats::bar(width, values.len());
    0
}
