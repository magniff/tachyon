use std::Vec;

// The pieces of `line` between the `sep` bytes, empty ones left out.
pub fn split(gpa: Gpa, line: [u8], sep: u8) -> Vec<[u8]> {
    var out: Vec<[u8]> = Vec::new_in(gpa);
    var start = 0;
    for i in 0..line.len + 1 {
        if i == line.len || line[i] == sep {
            if i > start {
                out.push(line[start..i]);
            }
            start = i + 1;
        }
    }
    out
}

pub fn number(w: [u8]) -> i64 {
    var n = 0;
    var sign = 1;
    for i in 0..w.len {
        if w[i] == '-' {
            sign = -1;
        } else {
            n = n * 10 + (w[i] - '0') as i64;
        }
    }
    sign * n
}

// The positive values of `key`.
pub fn positive(gpa: Gpa, values: [i64], keys: [[u8]], key: [u8]) -> Vec<i64> {
    var out: Vec<i64> = Vec::new_in(gpa);
    for i in 0..values.len {
        if keys[i] == key && values[i] > 0 {
            out.push(values[i]);
        }
    }
    out
}

// The largest of `v`.
pub fn best(v: [i64]) -> i64 {
    var m = v[0];
    for i in 1..v.len {
        if v[i] > m {
            m = v[i];
        }
    }
    m
}

// A bar of `n` marks, `width` to a line.
pub fn bar(width: i64, n: i64) {
    var left = n;
    while left > 0 {
        let k = if left < width { left } else { width };
        if k > 0 {
            for _ in 0..k {
                print("#");
            }
            println("");
        }
        left -= k;
    }
}
