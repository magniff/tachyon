// A table of kinds.

pub const KINDS: i64 = 3;

// ---- Weights ----

const W_LOW: i64 = 1;
const W_MID: i64 = 2;
const W_HIGH: i64 = 4;

// The weight of kind k.
pub fn weight(k: i64) -> i64 {
    if k == 0 { W_LOW } else if k == 1 { W_MID } else { W_HIGH }
}

// ---- Names ----

pub fn describe(k: i64) -> i64 {
    k + weight(k) + spare()
}

fn spare() -> i64 {
    0
}
