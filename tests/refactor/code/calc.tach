// Sums and means: code to extract functions from, and to inline.

pub struct Acc {
    pub total: i64,
    pub count: i64,
}

impl Acc {
    // Adds x.
    pub fn add(self: *Acc, x: i64) {
        self.total = self.total + x;
        self.count = self.count + 1;
    }

    pub fn mean(self: *Acc) -> i64 {
        let n = if self.count == 0 { 1 } else { self.count };
        let m = self.total / n;
        m
    }
}

// 1 + 2 + ... + n, plus the squares.
pub fn sum_to(n: i64) -> i64 {
    let mut total = 0;
    let mut squares = 0;
    let mut i = 1;
    while i <= n {
        total += i;
        squares += i * i;
        i += 1;
    }
    let both = total + squares;
    both
}

// The mean of 1, 2, ... n.
pub fn mean_to(n: i64) -> i64 {
    let mut acc = Acc { total: 0, count: 0 };
    let mut i = 1;
    while i <= n {
        acc.add(i);
        i += 1;
    }
    acc.mean()
}

// The first of 1, 2, ... n whose square is over limit; -1.
pub fn first_big(n: i64, limit: i64) -> i64 {
    let mut i = 1;
    while i <= n {
        let sq = i * i;
        if sq > limit {
            return i;
        }
        i += 1;
    }
    -1
}

fn twice(x: i64) -> i64 {
    x + x
}

fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo {
        return lo;
    }
    if x > hi { hi } else { x }
}

fn square_plus(x: i64, k: i64) -> i64 {
    let s = x * x;
    s + k
}

pub fn quad(x: i64) -> i64 {
    let y = twice(x);
    twice(y) + twice(1) * square_plus(x + 1, 2) + clamp(x, 0, 9)
}

// The low byte of each of the first n values, summed through a pointer.
pub fn bytes(n: i64) -> i64 {
    let mut buf = [0 as u8; 8];
    let mut i = 0;
    while i < n && i < 8 {
        buf[i] = (i * 3) as u8;
        i += 1;
    }
    let mut t = 0;
    unsafe {
        let p = &buf[0] as *u8;
        for k in 0..8 {
            t += p[k] as i64;
        }
    }
    t
}
