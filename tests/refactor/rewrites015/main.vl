// Loops for volec rewrite's `$s...` (tests/refactor/rewrites015.t).
fn total(s: [i64]) -> i64 {
    var t = 0;
    for i in 0..s.len {
        let x = s[i];
        // a comment
        t += x;
        if x > 10 {
            t += 1;
        }
    }
    t
}

fn weighted(s: [i64]) -> i64 {
    var t = 0;
    for i in 0..s.len {
        let x = s[i];
        t += x * i;
    }
    t
}

fn tails(s: [i64]) -> i64 {
    var t = 0;
    for k in 0..s.len {
        let x = s[k];
        t = t + x
    }
    for k in 0..s.len {
        let x = s[k];
    }
    for k in 0..s.len { let x = s[k]; t -= x; }
    t
}

fn pick(o: Option<i64>) -> i64 {
    match o {
        Option::Some(v) => v + 1,
        Option::None => 0,
    }
}

fn main() -> i32 {
    let v = [1, 2, 3, 20];
    (total(v[0..4]) + weighted(v[0..4]) + tails(v[0..4]) + pick(Option::Some(2))) as i32
}
