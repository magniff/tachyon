// Small functions to patch.

// v, kept within [lo, hi].
pub fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    v
}

// 1 + 2 + ... + n.
pub fn sum_to(n: i64) -> i64 {
    var total = 0;
    var i = 1;
    while i <= n {
        total += i;
        i += 1;
    }
    total
}
