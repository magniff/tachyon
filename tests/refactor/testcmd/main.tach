use std::{Buf, Gpa, println, read_line};

fn main(gpa: Gpa) -> i32 {
    var n = 0;
    var l = Buf::new_in(gpa);
    while read_line(&l).unwrap_or(false) {
        if l.as_slice() == "crash" {
            return 3;
        }
        if l.as_slice() == "hang" {
            var k = 0;
            while k >= 0 {
                k = (k + 1) % 7;
            }
        }
        n += 1;
        println(f"line {n}: {l.as_slice()}");
    }
    0
}
