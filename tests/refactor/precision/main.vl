// A program for the edit precision tools of 0.13 (tests/refactor/precision.t).
mod calc;
mod lib;

use calc::{clamp, first, scale, sum_to};

fn main() -> i32 {
    let a = clamp(15, 0, 10);
    let b = sum_to(4);
    let n: i32 = 1;
    let c = scale(a, 2) + scale(b, n + 1);
    let v = [7, 8];
    let d = first(&v[0]);
    if a + b + c + d + lib::twice(1) == 69 { 0 } else { 1 }
}
