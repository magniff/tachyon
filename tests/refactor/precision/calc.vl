// Small functions to edit.

// v, kept within [lo, hi].
pub fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    v
}

// 1 + 2 + ... + n.
pub fn sum_to(n: i64) -> i64 {
    var total = 0;
    var i = 1;
    while i <= n {
        total += i;
        i += 1;
    }
    total
}

// v times k.
pub fn scale(v: i64, k: i32) -> i64 {
    v * k as i64
}

// The value p points to.
pub fn first(p: *i64) -> i64 {
    let a = p[0];
    a + 0
}
