// A lexer and a parser that share nothing.
use crate::util::cube;

pub struct Token {
    pub kind: i64,
    pub value: i64,
}

fn lex_digit(c: i64) -> Token {
    Token { kind: 1, value: c }
}

fn lex(c: i64) -> Token {
    lex_digit(c)
}

// The parser: a token's value, through the lexer.
pub fn parse(c: i64) -> Token {
    let t = lex(c);
    check(t)
}

fn check(t: Token) -> Token {
    if t.kind == 1 { t } else { Token { kind: 0, value: 0 } }
}

fn report(t: Token) -> i64 {
    describe(t) + 1
}

fn describe(t: Token) -> i64 {
    t.value
}

fn summary(t: Token) -> i64 {
    report(t) + describe(t)
}
