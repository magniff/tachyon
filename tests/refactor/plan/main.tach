// A program for the planning queries (tests/refactor/plan.t).
mod util;
mod lang;

use util::{square, Shape};
use lang::{parse, Token};

fn main() -> i32 {
    let t = parse(3);
    let s = Shape::Circle(t.value);
    let n = match s {
        Shape::Circle(r) => square(r),
        _ => 0,
    };
    if n == 9 { 0 } else { 1 }
}
