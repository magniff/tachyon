// Points; `area` is the one function.
pub struct Point {
    pub x: i64,
    pub y: i64,
}

// The `area` of p: x times y.
pub fn area(p: Point) -> i64 {
    p.x * p.y
}

// Scales a point by `area` (a parameter of that name).
pub fn by(p: Point, area: i64) -> Point {
    Point { x: p.x * area, y: p.y * area }
}
