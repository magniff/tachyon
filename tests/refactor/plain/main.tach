mod catalog;
mod geom;

use catalog::Catalog;
use geom::{Point, area};

// Sum of the areas; `total` counts them.
fn total(points: *Vec<Point>) -> i64 {
    let mut total = 0;
    let mut i = 0;
    while i < points.len() {
        let p = points.get(i);
        total = total + area(p);
        i = i + 1;
    }
    total
}

// `a` twice; `s` is the sum.
fn twice<T: Add>(a: T) -> T {
    let s = a + a;
    s
}

fn main(gpa: Gpa) {
    let mut v: Vec<Point> = Vec::new_in(gpa);
    v.push(Point { x: 2, y: 3 });
    let x = total(&v);
    {
        let x = x + 1;
        std::print_int(x);
    }
    std::print_int(twice(x));
    let mut c = Catalog { items: Vec::new_in(gpa) };
    c.add(1, 3);
    std::print_int(c.add(1, 2));
}
