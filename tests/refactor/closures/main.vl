// Closures for the refactorings of 0.14 (tests/refactor/closures.t).

fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
    f(x)
}

fn double(x: i64) -> i64 {
    x * 2
}

fn scaled(k: i64, x: i64) -> i64 {
    let by = |y: i64| y * k;
    apply(by, x)
}

fn main() -> i32 {
    let k = 3;
    var total = 0;
    let add = |x: i64| double(x) + k;
    total += apply(add, 1);
    total += apply(|y| {
        let z = y + k;
        double(z)
    }, 2);
    total += scaled(2, 5);
    std::print_int(total);
    println("");
    0
}
