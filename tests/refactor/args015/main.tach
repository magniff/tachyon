// Named and default arguments (0.15) under the refactorings.
fn area(w: i64, h: i64 = 1, depth: i64 = 1) -> i64 {
    w * h * depth
}

fn label(n: i64, unused: i64 = 0, wide: bool = false) -> i64 {
    if wide { n * 10 } else { n }
}

fn twice(x: i64, k: i64 = 2) -> i64 {
    x * k
}

struct Box { w: i64 }

impl Box {
    fn grow(self: &mut Box, by: i64, times: i64 = 1) {
        self.w += by * times;
    }
}

fn main() -> i32 {
    let a = area(2);
    let b = area(2, h: 3);
    let c = area(2, 3, depth: 4);
    let d = area(2, depth: 5);
    let e = twice(3) + twice(4, k: 5);
    let f = label(1, wide: true) + label(2, 0) + label(3);
    let mut x = Box { w: 1 };
    x.grow(2, times: 3);
    x.grow(1);
    (a + b + c + d + e + f + x.w - 2 - 6 - 24 - 10 - 26 - 15 - 8) as i32
}
