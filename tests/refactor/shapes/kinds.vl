pub enum Kind {
    Circle(i64),
    Square(i64),
    Dot,
    Empty,
}

pub fn weight(k: Kind) -> i64 {
    match k {
        Kind::Circle(r) => 3 * r * r,
        // (a square of side s)
        Kind::Square(s) => s * s,
        Kind::Dot => 1,
        Kind::Empty => 0,
    }
}

pub fn describe(k: Kind) -> i64 {
    match k {
        Kind::Empty => 0,
        _ => 1,
    }
}

pub fn is_dot(k: Kind) -> bool {
    if let Kind::Dot = k {
        return true;
    }
    false
}

pub fn sides(k: Kind) -> i64 {
    match k { Kind::Circle(_) => 0, Kind::Dot | Kind::Square(_) => 4, Kind::Empty => 0 }
}
