// Points.

pub struct Point {
    pub x: i64,
    // The height.
    pub y: i64,
}

#[repr(C)]
pub struct Pair { pub a: i32, pub b: i32 }

pub fn origin() -> Point {
    Point { x: 0, y: 0 }
}

// The area of the rectangle from the origin to p.
pub fn area(p: Point) -> i64 {
    p.x * p.y
}

pub fn twice(x: i64) -> i64 {
    x + x
}

pub fn offset(base: i64, pad: i64) -> i64 {
    base + 1
}

pub struct Label {
    pub text: i64,
    pub hint: i64,
}

pub fn label() -> Label {
    Label {
        text: 1,
        hint: 2,
    }
}

pub fn pair() -> Pair {
    Pair { a: 1, b: 2 }
}

impl Point {
    pub fn scale(self: &mut Point, k: i64) {
        self.x = self.x * k;
        self.y = self.y * k;
    }
}

pub trait Shape {
    fn size(self: &Self, unit: i64) -> i64;
}

impl Shape for Point {
    fn size(self: &Point, unit: i64) -> i64 {
        (self.x + self.y) * unit
    }
}

impl Shape for Pair {
    fn size(self: &Pair, unit: i64) -> i64 {
        (self.a + self.b) as i64 * unit
    }
}

pub fn total<T: Shape>(s: &T) -> i64 {
    s.size(1) + s.size(2)
}
