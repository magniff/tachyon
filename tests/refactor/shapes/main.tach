mod geom;
mod kinds;

use crate::geom::{Pair, Point, Shape, area, label, offset, origin, pair, total, twice};
use crate::kinds::{Kind, describe, weight};

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn main() -> i32 {
    var p = Point { x: 2, y: 3 };
    let q = origin();
    p.scale(2);
    Point::scale(&p, 3);
    let a = area(p) + area(q);
    let k = Kind::Circle(a);
    let w = weight(k) + describe(Kind::Empty);
    let r = pair();
    let s = total(p) + total(r) + p.size(3);
    let o = offset(label().text, twice(1));
    let t = apply(twice, w + s + o);
    (t % 7) as i32
}
