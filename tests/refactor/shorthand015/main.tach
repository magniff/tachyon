// Field shorthand (0.15) under the renamings.
const LIMIT: i64 = 10;

struct P { x: i64, y: i64 }

struct Cap { LIMIT: i64 }

fn make(x: i64, k: i64) -> P {
    let y = k * 2;
    P { x, y }
}

fn cap() -> Cap {
    Cap { LIMIT }
}

fn shift(p: P, x: i64) -> P {
    P { x, y: p.y }
}

fn main() -> i32 {
    let p = make(1, 2);
    let q = shift(p, 3);
    let c = cap();
    (q.x + q.y + c.LIMIT - 17) as i32
}

fn half(x: Option<i64>) -> Option<i64> {
    let a = 1;
    let v = x?;
    Some(v / 2 + a)
}
