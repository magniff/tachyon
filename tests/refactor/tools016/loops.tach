pub struct IntVec { pub data: [i64; 4], pub count: i64 }

pub static var V: IntVec = IntVec { data: [1, 2, 3, 4], count: 4 };

pub fn total() -> i64 {
    let w = unsafe { V };
    var t = 0;
    for i in 0..w.count {
        t += w.data[i] * 2;
        if w.data[i] > 2 {
            t += w.data[i];
        }
    }
    let x = 1;
    for i in 0..w.count {
        t += w.data[i] + x + i;
    }
    for j in 0..w.count { t -= w.data[j]; }
    let v_two = 2;
    let other = 3;
    t + v_two * other
}
