pub struct IntVec {
    pub len: i64,
    pub cap: i64,
}

pub struct ByteVec {
    pub len: i64,
    pub cap: i64,
}

impl IntVec {
    pub fn reserve(inout self, n: i64) {
        self.cap = self.cap + n;
    }
}

pub fn grow(v: inout IntVec, n: i64) {
    v.reserve(n);
}

pub fn grow_bytes(v: inout ByteVec, n: i64) {
    v.cap = v.cap + n;
}
