mod vecs;
mod util;

use crate::vecs::{ByteVec, IntVec, grow, grow_bytes};
use crate::util::{double, log, square, trace, twice};

fn main() -> i32 {
    let mut v = IntVec { len: 0, cap: 0 };
    let mut b = ByteVec { len: 0, cap: 0 };
    grow(&mut v, 10);
    more(&mut v, 2 + 3);
    grow_bytes(&mut b, 4);
    let n = 3;
    if n as i64 < v.len {
        v.len = 1;
    }
    let total = twice(n + 1) * twice(n + 1) + twice(n) * twice(n + 1);
    let k = 3 * double(n + 1) + double(double(n));
    log(1, 2);
    grow_twice(&mut v, 7);
    (v.cap + total + k + b.len) as i32
}

fn more(p: &mut IntVec, n: i64) {
    grow(p, n);
    grow(p, n * 2);
}

// (generic: its instances are checked, its body as written is not)
fn grow_twice<T>(v: &mut IntVec, n: T) {
    grow(v, 2);
    grow(v, 2);
}
