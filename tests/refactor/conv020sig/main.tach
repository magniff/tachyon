struct Acc { n: i64 }

impl Acc {
    fn show(inout self) -> i64 { self.n }
    fn add(inout self, k: i64) { self.n += k; }
}

fn bump(a: inout Acc, k: i64) { a.n += k; }

fn peek(a: let Acc) -> i64 { a.n }

fn eat(v: sink Vec<i64>) -> i64 { v.len() }

fn main(gpa: Gpa) {
    var a = Acc { n: 1 };
    bump(&a, 2);
    println(peek(&a));
    println(a.show());
    Acc::add(&a, 3);
    let v: Vec<i64> = Vec::new_in(gpa);
    println(eat(v));
}
