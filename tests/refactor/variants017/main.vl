enum Cmd {
    Move { x: i64, y: i64 },
    Quit,
}

fn run(c: Cmd) -> i64 {
    match c {
        Cmd::Move { x, y } => x + y,
        Cmd::Quit => 0,
    }
}

fn main() -> i32 {
    let c = Cmd::Move { y: 2, x: 1 };
    if let Cmd::Move { x, .. } = c {
        println(f"{x}");
    }
    run(c) as i32
}
