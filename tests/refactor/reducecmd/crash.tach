// A program that fails a check deep inside, among other work.
fn sum(v: [i64]) -> i64 {
    let mut t = 0;
    for i in 0..v.len {
        t += v[i];
    }
    t
}

fn last(v: [i64]) -> i64 {
    v[v.len]
}

fn main() -> i32 {
    let a = [1, 2, 3];
    println(f"{sum(a[..])}");
    let b = [4, 5];
    println(f"{sum(b[..])}");
    println(f"{last(b[..])}");
    0
}
