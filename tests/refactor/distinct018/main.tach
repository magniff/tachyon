// 0.18: the mistakes agents make with distinct types, each error with
// the conversion to write (`fix --suggested` makes them): a distinct
// type mixed with its underlying type in an operation, in a `let`, in a
// call; a method of the underlying type.
type Meters = distinct f64;
type Point = distinct Pos;

struct Pos { x: i64, y: i64 }

impl Pos {
    fn sum(self: Pos) -> i64 { self.x + self.y }
}

fn scale(x: f64) -> f64 { x * 2.0 }

fn main() {
    let d: Meters = 2.5;
    let x: f64 = 1.5;
    let total = d + x;
    let back = x * d;
    let plain: f64 = d;
    let twice = scale(d);
    let p = Pos { x: 1, y: 2 } as Point;
    let s = p.sum();
    println(f"{total} {back} {plain} {twice} {s}");
}
