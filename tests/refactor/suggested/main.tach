// fix --suggested (0.18): the errors whose fix the compiler knows
// exactly, one of each kind.
mod lib;
mod table;
mod text;

fn total(v: &Vec<i64>) -> i64 {
    let mut s = 0;
    for i in 0..v.len() {
        s += v.as_slice()[i];
    }
    s
}

fn count(xs: [i64]) -> i64 {
    xs.len
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64> = Vec::new_in(gpa);
    v.push(2);
    let t = totl(&v);
    let small: u8 = t;
    let n = count([1, 2, 3]);
    if n {
        println(f"{n}");
    }
    let s = "  x ".trim();
    let w = format(f"{t}");
    let low = I64_MIN;
    let d = text::describe(n);
    let r = table::make(3);
    let mut b = Buf::new_in(gpa);
    b.push_string(wrap(s));
    let cat = 1;
    let cot = 2;
    let both = cut + 1;
    println(f"{small} {w.as_slice()} {low} {d} {r.width} {b.as_slice()} {both}");
}
