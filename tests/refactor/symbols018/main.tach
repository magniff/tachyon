// (0.18) Every symbol the compiler makes: a contract's companions, drop
// glue, closures, derive, tests, properties, fuzz targets, coverage.
struct Acc { items: Vec<i64> }

impl Acc {
    fn get(self: &Acc, i: i64) -> i64
        requires i < self.items.len()
        ensures result >= 0
    {
        self.items[i]
    }
}

#[derive(Debug, Clone, Eq)]
enum Shape { Dot, Line(i64) }

fn total(v: &Vec<i64>) -> i64 {
    v.iter().map(|x| x * 2).fold(0, |a, b| a + b)
}

#[test]
fn adds() {
    assert_eq(1 + 1, 2);
}

#[property]
fn commutes(a: i64, b: i64) {
    assert(a + b == b + a);
}

#[fuzz]
fn never(data: [u8]) {
    if data.len() > 3 && data[0] == 'F' { assert(data[1] != 'U'); }
}

fn main(gpa: Gpa) {
    let mut a = Acc { items: Vec::new_in(gpa) };
    a.items.push(3);
    let s = Shape::Line(4);
    println(f"{a.get(0)} {total(&a.items)} {s:?}");
    assert(a.get(0) == 3);
}
