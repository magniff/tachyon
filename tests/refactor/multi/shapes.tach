// Shapes, changed in several places at once (tests/refactor/multi.t).

pub struct Rect {
    w: i64,
    h: i64,
}

pub enum Kind {
    Square,
    Wide,
}

// The area of r.
pub fn area(r: Rect) -> i64 {
    r.w * r.h
}

pub fn kind(r: Rect) -> Kind {
    if r.w == r.h { Kind::Square } else { Kind::Wide }
}

pub fn scale(r: Rect, k: i64) -> Rect {
    Rect { w: r.w * k, h: r.h * k }
}

// Not used.
pub fn spare() -> i64 {
    0
}
