// A program changed in several places at once (tests/refactor/multi.t).
mod shapes;

use shapes::{Kind, Rect, area, kind, scale};

fn describe(k: Kind) -> i64 {
    match k {
        Kind::Square => 1,
        Kind::Wide => 2,
    }
}

fn main() -> i32 {
    let k = 2;
    let r = scale(Rect { w: 2, h: 3 }, k);
    if area(r) + describe(kind(r)) == 26 { 0 } else { 1 }
}
