struct P { n: i64 }
struct Q { r: let P }

impl P {
    fn a(self: inout Self, k: i64) { self.n += k; }
    fn b(self: let Self) -> i64 { self.n }
    fn c(self: sink Self) -> i64 { self.n }
}

fn d(x: let P) -> i64 { x.n }

fn main() {
    var p = P { n: 1 };
    p.a(2);
    println(p.b() + d(&p));
    println(p.c());
}
