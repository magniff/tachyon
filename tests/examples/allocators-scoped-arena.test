// SOURCE: examples/allocators/scoped-arena/main.tach
// STDIN: SET apples 3
// STDIN: SET Pears 5
// STDIN: ADD apples 4
// STDIN: GET APPLES
// STDIN: GET plums
// STDIN: SUM apples pears plums
// STDIN: ADD pears lots
// STDIN: FLY away
// EXPECT: SET apples 3             -> apples = 3
// EXPECT: SET Pears 5              -> pears = 5
// EXPECT: ADD apples 4             -> apples = 7
// EXPECT: GET APPLES               -> apples = 7
// EXPECT: GET plums                -> plums is not set
// EXPECT: SUM apples pears plums   -> sum = 12 (not set: plums)
// EXPECT: ADD pears lots           -> not a number: lots
// EXPECT: FLY away                 -> unknown request: FLY away
// EXPECT: 8 requests, 2 keys; scratch per request at most 104 bytes
// EXPECT: the keys' arena holds 11 bytes
