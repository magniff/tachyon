// SOURCE: examples/voltty/core/main.vl
// The input encoders (input/mod.vl): keys with modifiers in the cursor
// and keypad modes, mouse reports in each mode and encoding, the wheel,
// pastes, focus. Each event, then its bytes.
// ARGS: --keys
// STDIN: key Up
// STDIN: key Up app_cursor
// STDIN: key Up shift
// STDIN: key Up ctrl app_cursor
// STDIN: key Home
// STDIN: key End app_cursor
// STDIN: key F1
// STDIN: key F1 ctrl
// STDIN: key F4 alt
// STDIN: key F5
// STDIN: key F12 shift
// STDIN: key F20
// STDIN: key PageUp alt
// STDIN: key Insert
// STDIN: key Delete ctrl
// STDIN: key Backspace
// STDIN: key Backspace alt
// STDIN: key Backspace ctrl
// STDIN: key Tab
// STDIN: key Tab shift
// STDIN: key Enter
// STDIN: key Enter alt
// STDIN: key Escape
// STDIN: key a ctrl
// STDIN: key A ctrl
// STDIN: key [ ctrl
// STDIN: key ] ctrl
// STDIN: key space ctrl
// STDIN: key ? ctrl
// STDIN: key 2 ctrl
// STDIN: key x alt
// STDIN: key é alt
// STDIN: key é alt nometa
// STDIN: key 5 keypad
// STDIN: key 5 keypad app_keypad
// STDIN: key + keypad app_keypad
// STDIN: key Enter keypad
// STDIN: key Enter keypad app_keypad
// STDIN: mouse 0 press 3 4 click
// STDIN: mouse 0 release 3 4 click
// STDIN: mouse 2 press 0 0 click alt ctrl
// STDIN: mouse 0 press 3 4 click sgr
// STDIN: mouse 0 release 3 4 click sgr ctrl
// STDIN: mouse 0 motion 1 1 click
// STDIN: mouse 0 motion 1 1 drag
// STDIN: mouse -1 motion 1 1 drag
// STDIN: mouse -1 motion 1 1 anymotion sgr
// STDIN: mouse 0 press 300 120 click utf8
// STDIN: mouse 0 press 300 120 click
// STDIN: mouse 0 press 3 4 click shift
// STDIN: mouse 0 press 3 4
// STDIN: wheel up 2 click sgr
// STDIN: wheel down 2 alt_screen
// STDIN: wheel down 2 alt_screen shift
// STDIN: wheel down 2
// STDIN: paste a\nb\r\nc
// STDIN: paste a\eb\xc2\x9bc\x9bd bracketed
// STDIN: focus in focus
// STDIN: focus out focus
// STDIN: focus out
// EXPECT: key Up
// EXPECT:   \x1b[A
// EXPECT: key Up app_cursor
