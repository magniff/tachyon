// EXPECT:   \x1b[<0;5;4M
// EXPECT: mouse 0 release 3 4 click sgr ctrl
// EXPECT:   \x1b[<16;5;4m
// EXPECT: mouse 0 motion 1 1 click
// EXPECT:   (not reported)
// EXPECT: mouse 0 motion 1 1 drag
// EXPECT:   \x1b[M@""
// EXPECT: mouse -1 motion 1 1 drag
// EXPECT:   (not reported)
// EXPECT: mouse -1 motion 1 1 anymotion sgr
// EXPECT:   \x1b[<35;2;2M
// EXPECT: mouse 0 press 300 120 click utf8
// EXPECT:   \x1b[M \xc2\x99\xc5\x8d
// EXPECT: mouse 0 press 300 120 click
// EXPECT:   (not reported)
// EXPECT: mouse 0 press 3 4 click shift
// EXPECT:   (not reported)
// EXPECT: mouse 0 press 3 4
// EXPECT:   (not reported)
// EXPECT: wheel up 2 click sgr
// EXPECT:   \x1b[<64;1;1M\x1b[<64;1;1M
// EXPECT: wheel down 2 alt_screen
// EXPECT:   \x1bOB\x1bOB
// EXPECT: wheel down 2 alt_screen shift
// EXPECT:   (not reported)
// EXPECT: wheel down 2
// EXPECT:   (not reported)
// EXPECT: paste a\nb\r\nc
// EXPECT:   a\x0db\x0dc
// EXPECT: paste a\eb\xc2\x9bc\x9bd bracketed
// EXPECT:   \x1b[200~abcd\x1b[201~
// EXPECT: focus in focus
// EXPECT:   \x1b[I
// EXPECT: focus out focus
