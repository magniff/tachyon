// EXPECT: key F4 alt
// EXPECT:   \x1b[1;3S
// EXPECT: key F5
// EXPECT:   \x1b[15~
// EXPECT: key F12 shift
// EXPECT:   \x1b[24;2~
// EXPECT: key F20
// EXPECT:   \x1b[34~
// EXPECT: key PageUp alt
// EXPECT:   \x1b[5;3~
// EXPECT: key Insert
// EXPECT:   \x1b[2~
// EXPECT: key Delete ctrl
// EXPECT:   \x1b[3;5~
