// SOURCE: examples/formatting/main.tach
// EXPECT: == format specs
// EXPECT: {n}           [42]         Display
// EXPECT: {n:>8}        [      42]   right-aligned: the default for numbers
// EXPECT: {n:<8}        [42      ]   left-aligned
// EXPECT: {n:08}        [00000042]   zero-padded
// EXPECT: {n:x} {n:X}   [2a 2A]      hex
// EXPECT: {n:08b}       [00101010]   binary, zero-padded
// EXPECT: {x}           [3.14159]    the shortest text that reads back
// EXPECT: {x:.2}        [3.14]       two decimals
// EXPECT: {x:>9.3}      [    3.142]  width and precision
// EXPECT: {name:>9}     [  tachyon]  text goes left by default
// EXPECT: {name:?}      ["tachyon"]  Debug: quoted and escaped
// EXPECT: {'A':c}       [A]          a u8 as a character
// EXPECT: {n * 2 + 1}   [85]         any expression
// EXPECT: {{ and }} in an f-string are literal braces: {n}
// EXPECT: == inventory
// EXPECT: sku    item               qty      price        value
// EXPECT: -----------------------------------------------------
// EXPECT: #7     hammer              12     $15.99      $191.88
// EXPECT: #42    socket set           3     $89.50      $268.50
// EXPECT: #108   coffee beans        40     $12.75      $510.00
// EXPECT: #9     rubber duck        250      $1.99      $497.50
// EXPECT: #1500  workbench            2    $649.00    $1,298.00
// EXPECT: -----------------------------------------------------
// EXPECT: total                                       $2,765.88
// EXPECT: == debug
// EXPECT: Item { sku: SKU-0007, name: "hammer", category: Tools, qty: 12, price: Money(1599) }
// EXPECT: Food(180) SKU-0108 Money(1275)
// EXPECT: [12, 3, 40, 250, 2] Some(2) "tab\there"
// EXPECT: == hex dump
// EXPECT: 0000  74 61 63 68 79 6f 6e 20  |tachyon |
// EXPECT: 0008  66 6f 72 6d 61 74 73 09  |formats.|
// EXPECT: 0010  62 79 74 65 73 0a        |bytes.|
// STDERR: warning: socket set (SKU-0042) is low: 3 left
// STDERR: warning: workbench (SKU-1500) is low: 2 left
