// SOURCE: examples/voltty/core/main.tach
// The script format of the oracle (oracle/FORMAT.md): text that wraps,
// a resize narrower and wider (reflow), the alternate screen (1049) and a
// resize while on it.
// ARGS: --escaped --script
// STDIN: T 3 8 10
// STDIN: D 24
// STDIN: abcdefghijklmnopqrst\r\nuv
// STDIN: R 3 5
// STDIN: P
// STDIN: R 3 12
// STDIN: P
// STDIN: D 14
// STDIN: \e[?1049hALT\e[H
// STDIN: R 2 6
// STDIN: P
// STDIN: D 8
// STDIN: \e[?1049l
// STDIN: P
// EXPECT: size 3 5
// EXPECT: cursor 2 2 0
// EXPECT: style block 0
// EXPECT: mode 28081
// EXPECT: title -
// EXPECT: tmpl n256 n257 0 - -
// EXPECT: charsets aaaa
// EXPECT: saved 0 0 0 n256 n257 0 - - aaaa
// EXPECT: history 2
// EXPECT: row -2 abcde
// EXPECT: attr -2 4-4 n256 n257 10 - -
// EXPECT: row -1 fghij
// EXPECT: attr -1 4-4 n256 n257 10 - -
